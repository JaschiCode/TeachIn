<?xml version="1.0" encoding="UTF-8"?>
<hdevelop file_version="1.2" halcon_version="25.11.0.0">
<procedure name="ColorMean">
<interface>
<io>
<par name="Image" base_type="iconic" dimension="0"/>
<par name="Region" base_type="iconic" dimension="0"/>
</io>
<oc>
<par name="Mean_Red" base_type="ctrl" dimension="0"/>
<par name="Mean_Green" base_type="ctrl" dimension="0"/>
<par name="Mean_Blue" base_type="ctrl" dimension="0"/>
</oc>
</interface>
<body>
<c>* ColorMean</c>
<c>* -----------------------------------------</c>
<c></c>
<l>decompose3 (Image, Red, Green, Blue)</l>
<l>intensity (Region, Red, Mean_Red, _)</l>
<l>intensity (Region, Green, Mean_Green, Deviation)</l>
<l>intensity (Region, Blue, Mean_Blue, Deviation)</l>
<c></c>
<l>return ()</l>
</body>
<docu id="ColorMean">
<parameters>

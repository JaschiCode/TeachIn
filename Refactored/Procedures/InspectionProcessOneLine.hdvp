<?xml version="1.0" encoding="UTF-8"?>
<hdevelop file_version="1.2" halcon_version="25.11.0.0">
<procedure name="InspectionProcessOneLine">
<interface>
<io>
<par name="Image" base_type="iconic" dimension="0"/>
</io>
<ic>
<par name="ProcessingThreadID" base_type="ctrl" dimension="0"/>
<par name="ChannelSelector" base_type="ctrl" dimension="0"/>
</ic>
</interface>
<body>
<c>* InspectionProcessOneLine</c>
<c>* ---------------------------------------------------------------</c>
<c></c>
<l>global tuple App</l>
<c></c>
<l>gen_empty_obj (EmptyObject)</l>
<c></c>
<l>* global tuple gGrabSequencer_Active</l>
<l>* global tuple dict_InspectionVisualization </l>
<l>* global tuple dict_Shiftregister</l>
<l>* global tuple dict_TabletInspection</l>
<l>* global tuple dict_Calibration</l>
<l>global tuple gThread_Middle_Active</l>
<c></c>
<l>count_seconds (TimeStart)</l>
<c>* ******************************************</c>
<c></c>
<c></c>
<c>* Use thread specific dictionary and fill up with information for inspection</c>
<c></c>
<c></c>
<l>App.Inspection.Threads.[ProcessingThreadID].Status := dict{}</l>
<l>App.Inspection.Threads.[ProcessingThreadID].Status.TabletSegmentationDone := 0</l>
<c></c>
<c></c>
<c>* Set the used images</c>
<l>App.Inspection.Threads.[ProcessingThreadID].Images := dict{}</l>
<l>App.Inspection.Threads.[ProcessingThreadID].Images.MultiChannel := Image</l>
<c></c>
<c>* Set the regions for lanes and eject to work on</c>
<l>IndexLanesAndEjects := App.ThreadManagement.Threads.[ProcessingThreadID]</l>
<l>select_obj (App.ROIs.Lanes.[App.Status.Camera.ID], LaneROIs, IndexLanesAndEjects)</l>
<l>union1 (LaneROIs, LaneROIsUnion)</l>
<l>select_obj (App.ROIs.Ejects.[App.Status.Camera.ID], EjectROIs, IndexLanesAndEjects)</l>
<l>union1 (EjectROIs, EjectROIsUnion)</l>
<c></c>
<l>App.Inspection.Threads.[ProcessingThreadID].Regions := dict{}</l>
<l>App.Inspection.Threads.[ProcessingThreadID].Regions.Lanes   := dict{} </l>
<l>App.Inspection.Threads.[ProcessingThreadID].Regions.Ejects  := dict{}</l>
<l>App.Inspection.Threads.[ProcessingThreadID].Regions.Rolls   := dict{}</l>
<l>App.Inspection.Threads.[ProcessingThreadID].Regions.Tablets := dict{}</l>
<c></c>
<l>App.Inspection.Threads.[ProcessingThreadID].Regions.Lanes.ROIs      := LaneROIs</l>
<l>App.Inspection.Threads.[ProcessingThreadID].Regions.Lanes.ROIsUnion := LaneROIsUnion</l>
<c></c>
<l>App.Inspection.Threads.[ProcessingThreadID].Regions.Ejects.ROIs      := EjectROIs</l>
<l>App.Inspection.Threads.[ProcessingThreadID].Regions.Ejects.ROIsUnion := EjectROIsUnion</l>
<c></c>
<l>App.Inspection.Threads.[ProcessingThreadID].Regions.Tablets.ROIs           := EmptyObject</l>
<l>App.Inspection.Threads.[ProcessingThreadID].Regions.Tablets.ROIsUnion      := EmptyObject</l>
<l>App.Inspection.Threads.[ProcessingThreadID].Regions.Tablets.Segmented      := EmptyObject</l>
<l>App.Inspection.Threads.[ProcessingThreadID].Regions.Tablets.SegmentedUnion := EmptyObject</l>
<c></c>
<l>* App.Inspection.Threads.[ProcessingThreadID].Regions.TabletsPreprocessed := EmptyObject</l>
<l>* App.Inspection.Threads.[ProcessingThreadID].Regions.TabletsLineSpecific := EmptyObject</l>
<c></c>
<l>App.Inspection.Threads.[ProcessingThreadID].Segmentation := dict{}</l>
<c></c>
<l>App.Inspection.Threads.[ProcessingThreadID].Segmentation.Parameters := dict{}</l>
<l>App.Inspection.Threads.[ProcessingThreadID].Segmentation.Lanes := dict{}</l>
<c></c>
<l>App.Inspection.Threads.[ProcessingThreadID].Segmentation.Parameters.ChannelSelector    := 1</l>
<l>App.Inspection.Threads.[ProcessingThreadID].Segmentation.Parameters.UseRGBThreshold    := 1</l>
<l>App.Inspection.Threads.[ProcessingThreadID].Segmentation.Parameters.DynThresholdActive := 1</l>
<c></c>
<c>* Settings for shiftregister</c>
<l>* Shiftregister_SaveMeasureFeatureValuesAtRuntime := App.Format.Shiftregister.V_SaveMeasureFeatureValuesAtRuntime.Value</l>
<l>* Shiftregister_SaveMeasureFeatureRegionsAtRuntime := App.Format.Shiftregister.V_SaveMeasureFeatureRegionsAtRuntime.Value</l>
<c></c>
<c></c>
<c></c>
<c>* Settings for calibration</c>
<l>* Calibration_FeatureActive                    := App.Format.CalibrationLocal.General.V_FeatureActive.Value</l>
<l>* Calibration_GlobalMeasurementOffset_Micron_Y := App.Format.CalibrationLocal.General.['V_Calib_GlobalMeasurementOffset_µm_Y'].Value</l>
<l>* Calibration_GlobalMeasurementOffset_Micron_X := App.Format.CalibrationLocal.General.['V_Calib_GlobalMeasurementOffset_µm_X'].Value</l>
<c></c>
<c></c>
<c>* ******************************************</c>
<l>* Shiftregister_VLane_IImagePartsPerObject_Out := Shiftregister_VLane_IImagePartsPerObject</l>
<l>* Shiftregister_VLane_VImagePartsOffset_TRow_TColumn_Out := Shiftregister_VLane_VImagePartsOffset_TRow_TColumn</l>
<l>* Products_IMeasuredRegionsPerFeature.at(0) :=EmptyObject</l>
<c></c>
<c>* General assignments</c>
<l>* tempSequencer := []</l>
<c></c>
<c></c>
<c></c>
<c>* **********************************************************************************************************</c>
<c>* start the processing here</c>
<l>TimeNeeded_CFA_To_RGB := 0</l>
<c></c>
<l>if (gThread_Middle_Active )</l>
<c>    * map results from upstream middle tread</c>
<l>    gMiddleThread_ResultsMappingInDonwstreamThreads (VIThreadUpstreamProcessingResult, ImageOrig, Tablet_Individual, ColourClassifiedTablets_LineSpecific, ImageOrig_HSV, ImageOrig_Monochrome1, Rollmeasurement360, ProcessingThreadNumber)</l>
<l>else</l>
<l>*     gen_empty_obj (Rollmeasurement360)</l>
<l>*     gen_empty_obj (Preprocessed_SegmentedTablets)</l>
<l>*     Preprocessed_SegmentedTablets_WasPrecalculated := 0</l>
<c>    </c>
<l>*     IgnoreObjectsInEjectboxesForTeachIn := App.Format.TabletInspection.TeachIn.V_IgnoreObjectsInEjectboxesForTeachIn.Value</l>
<l>*     TabletSpot_FeatureActive            := App.Format.TabletInspection.TeachIn.Measure_ProductSpot.V_FeatureActive.Value</l>
<c>    </c>
<c>    </c>
<c>    </c>
<l>    UseColorClassification := 1</l>
<l>    InspectionSegmentationColorClassificationThresholding (ProcessingThreadID, ChannelSelector, UseColorClassification)</l>
<c>       </c>
<l>*     TabletLength_InMovementDirection := dict_TeachIn.V_ProductLength_InMovementDirection.Value</l>
<l>    SplitIntoSingleTabletActive := 1</l>
<l>    InspectionSplitIntoSingleTablets (ProcessingThreadID, SplitIntoSingleTabletActive, TimeNeeded)</l>
<l>    SplitIntoSingleTablets_Active := 1      </l>
<l>    gSplitIntoSingleTablets (ImageOrig_HSV, RinnenROIs, SegmentedTablets_LineSpecific, Tablet_Individual, ObjectsCrossingROIBorder_Concat, SplitIntoSingleTablets_Active, TabletLength_InMovementDirection, SegmentationThreshold, 'horizontal', IndexRinnenUndEjects, ProductSplittingMode, PreprocessingOpeningWidth, PreprocessingOpeningHeight, PreprocessingMinAreaFilter, ProductSplittingMode1_SeperationThreshold, TimeNeeded_SplittingTablets)</l>
<l>    gSegmentation_Backgroundcheck_AddFoundObjects (ImageOrig_HSV, RinnenROIs, Tablet_Individual, ObjectsCrossingROIBorder_Concat, Tablet_Individual, dict_Backgroundcheck)</l>
<c>    </c>
<c>    * method to illiminate printed objects having impact onto object hull</c>
<l>    closing_circle (Tablet_Individual, Tablet_Individual, 3.5)</l>
<l>    select_shape (Tablet_Individual, Tablet_Individual, 'area', 'and', 1, 999999999)</l>
<c>    </c>
<l>    get_dict_param (GrabImageMetaData, 'key_exists', 'RollSpeed360_Mean', RollSpeed_exists)</l>
<l>    if (not(RollSpeed_exists))</l>
<l>        GrabImageMetaData.RollSpeed360_Mean := []</l>
<l>    endif</l>
<l>endif</l>
<l>Sequencer_MovedDistanceInBetweenGrabbedImages := GrabImageMetaData.Sequencer_MovedDistanceInBetweenGrabbedImages  // ???</l>
<c>* </c>
<c>* Todo- could be nice to calculate Regions touching the border in upfront. Currently run in multiple calculate_featue loops</c>
<l>Products_VT_MeasureResult_MeasureValues := {{[]}}</l>
<l>Indices_BadObjects := []</l>
<c></c>
<c></c>
<c>*********************************************************************************************************</c>
<c>* Select images for feature calculation </c>
<l>gSelectImageForMeasurement (ImageOrig_HSV, ImageOrig, Tablet_Individual, Image_ForGeometricalMeasurement, Image_ForGeometricalMeasurement_Length, Image_ForGeometricalMeasurement_PRV, Tablet_Individual, Tablet_Individual_PositionCorrected_GeometricMeasure, Tablet_Individual_PositionCorrected_LengthMeasure, GrabImageMetaData, Segmentation_SelectSegmentationImage_BottomLight0_TopLight1_UVLight2, Sequencer_MovedDistanceInBetweenGrabbedImages)</l>
<c>*********************************************************************************************************</c>
<c></c>
<c></c>
<c>********************************************************************************************************* </c>
<c>* calculate features</c>
<c>*********************************************************************************************************</c>
<c></c>
<c>*********************************************************************************************************</c>
<c>* colour features: take care that for colours: hsv values are used</c>
<c>*********************************************************************************************************</c>
<c>* feature colour 1/hue(visu red)</c>
<l>dict_Feature := dict_TabletInspection.Measure_ProductColour1</l>
<l>FeatureActive := dict_Feature.V_FeatureActive.Value</l>
<l>gCalculate_Feature (ImageOrig_HSV, Tablet_Individual, RinnenROIs, ColourClassifiedTablets_LineSpecific, Region_GoodColourRed, Region_BadColourRed, AllObjects_MeasuredRegions, dict_Feature, 'Measure_ProductColour1', 0, Calculation_ColourRed, TabletColourRed_BadObjects_Values, Indices_BadObjects_ColourRed, Indices_Objects_IfGood0Bad1_ColourRed, TimeNeeded_ColourRed)</l>
<l>if (FeatureActive)</l>
<l>    gCalculate_IndexToStoreDataTo (Products_VT_MeasureResult_MeasureValues, CurrentVectorLength)</l>
<l>    tuple_concat (Indices_BadObjects, Indices_BadObjects_ColourRed, Indices_BadObjects)</l>
<l>    if (Shiftregister_SaveMeasureFeatureValuesAtRuntime)</l>
<l>        Products_VT_MeasureResult_MeasureValues.at(CurrentVectorLength) := {Indices_Objects_IfGood0Bad1_ColourRed,Calculation_ColourRed, ['Calculation_Colour_Red', dict_Feature.V_Colour1_Min.Value, dict_Feature.V_Colour1_Max.Value]}</l>
<l>    endif</l>
<l>    Products_VGoodObjects_VBadObjects.at(CurrentVectorLength) := {Region_GoodColourRed,Region_BadColourRed}</l>
<l>    if (Shiftregister_SaveMeasureFeatureRegionsAtRuntime)</l>
<l>        Products_IMeasuredRegionsPerFeature.at(CurrentVectorLength) := AllObjects_MeasuredRegions</l>
<l>    endif  </l>
<l>endif</l>
<c></c>
<c>********************************************************************************************************* </c>
<c>* feature colour2/saturation (visu green)</c>
<l>dict_Feature := dict_TabletInspection.Measure_ProductColour2</l>
<l>FeatureActive := dict_Feature.V_FeatureActive.Value</l>
<l>gCalculate_Feature (ImageOrig_HSV, Tablet_Individual, RinnenROIs, ColourClassifiedTablets_LineSpecific, Region_GoodColourGreen, Region_BadColourGreen, AllObjects_MeasuredRegions, dict_Feature, 'Measure_ProductColour2', 0, Calculation_ColourGreen, TabletColourGreen_BadObjects_Values, Indices_BadObjects_ColourGreen, Indices_Objects_IfGood0Bad1_ColourGreen, TimeNeeded_ColourGreen)</l>
<l>if (FeatureActive)</l>
<l>    gCalculate_IndexToStoreDataTo (Products_VT_MeasureResult_MeasureValues, CurrentVectorLength)</l>
<l>    tuple_concat (Indices_BadObjects, Indices_BadObjects_ColourGreen, Indices_BadObjects)</l>
<l>    if (Shiftregister_SaveMeasureFeatureValuesAtRuntime)</l>
<l>        Products_VT_MeasureResult_MeasureValues.at(CurrentVectorLength) := {Indices_Objects_IfGood0Bad1_ColourGreen,Calculation_ColourGreen, ['Calculation_Colour_Green', dict_Feature.V_Colour2_Min.Value, dict_Feature.V_Colour2_Max.Value]}</l>
<l>    endif</l>
<l>    Products_VGoodObjects_VBadObjects.at(CurrentVectorLength) := {Region_GoodColourGreen,Region_BadColourGreen}</l>
<l>    if (Shiftregister_SaveMeasureFeatureRegionsAtRuntime)</l>
<l>        Products_IMeasuredRegionsPerFeature.at(CurrentVectorLength) := AllObjects_MeasuredRegions</l>
<l>    endif   </l>
<l>endif</l>
<c></c>
<c>********************************************************************************************************* </c>
<c>* feature colour3/value (visu blue)</c>
<l>dict_Feature := dict_TabletInspection.Measure_ProductColour3</l>
<l>FeatureActive := dict_Feature.V_FeatureActive.Value</l>
<l>gCalculate_Feature (ImageOrig_HSV, Tablet_Individual, RinnenROIs, ColourClassifiedTablets_LineSpecific, Region_GoodColourBlue, Region_BadColourBlue, AllObjects_MeasuredRegions, dict_Feature, 'Measure_ProductColour3', 0, Calculation_ColourBlue, TabletColourBlue_BadObjects_Values, Indices_BadObjects_ColourBlue, Indices_Objects_IfGood0Bad1_ColourBlue, TimeNeeded_ColourBlue)</l>
<l>if (FeatureActive)</l>
<l>    gCalculate_IndexToStoreDataTo (Products_VT_MeasureResult_MeasureValues, CurrentVectorLength)</l>
<l>    tuple_concat (Indices_BadObjects, Indices_BadObjects_ColourBlue, Indices_BadObjects)</l>
<l>    if (Shiftregister_SaveMeasureFeatureValuesAtRuntime)</l>
<l>        Products_VT_MeasureResult_MeasureValues.at(CurrentVectorLength) := {Indices_Objects_IfGood0Bad1_ColourBlue,Calculation_ColourBlue, ['Calculation_Colour_Blue', dict_Feature.V_Colour3_Min.Value, dict_Feature.V_Colour3_Max.Value]}</l>
<l>    endif</l>
<l>    Products_VGoodObjects_VBadObjects.at(CurrentVectorLength) := {Region_GoodColourBlue,Region_BadColourBlue}</l>
<l>    if (Shiftregister_SaveMeasureFeatureRegionsAtRuntime)</l>
<l>        Products_IMeasuredRegionsPerFeature.at(CurrentVectorLength) := AllObjects_MeasuredRegions</l>
<l>    endif</l>
<l>endif</l>
<c></c>
<c>********************************************************************************************************* </c>
<c>* feature length</c>
<l>ProcessingThread := 0</l>
<c></c>
<l>copy_dict (dict_TabletInspection.Measure_ProductLength, [], [], dict_Feature)</l>
<l>FeatureActive := dict_Feature.V_FeatureActive.Value</l>
<l>if (FeatureActive)</l>
<l>    gCalculate_Length_PrepareData (dict_Feature, Segmentation_SelectSegmentationImage_BottomLight0_TopLight1_UVLight2, Sequencer_MovedDistanceInBetweenGrabbedImages, Calibration_FeatureActive, Calibration_VTLane_VTPixToMM_XY, ProcessingThread, Calibration_GlobalMeasurementOffset_Micron_Y)</l>
<l>endif</l>
<c>* if colour support is active for segmentation, the contrast in v-channel is probably very bad. </c>
<c>* So we use s-channel instead.</c>
<l>if ( Segmentation_ColourSupport_Active )</l>
<l>    access_channel (ImageOrig_HSV, Image_ForGeometricalMeasurement, 2)</l>
<l>endif</l>
<l>gCalculate_Feature (Image_ForGeometricalMeasurement, Tablet_Individual_PositionCorrected_LengthMeasure, RinnenROIs, ColourClassifiedTablets_LineSpecific, Region_GoodLength, Region_BadLength, AllObjects_MeasuredRegions, dict_Feature, 'Measure_ProductLength', 1, Calculation_Length, TabletLength_BadObjects_Values, Indices_BadObjects_Length, Indices_Objects_IfGood0Bad1_Length, TimeNeeded_Length)</l>
<l>if (FeatureActive)</l>
<l>    gCalculate_IndexToStoreDataTo (Products_VT_MeasureResult_MeasureValues, CurrentVectorLength)</l>
<l>    tuple_concat (Indices_BadObjects, Indices_BadObjects_Length, Indices_BadObjects)</l>
<l>    if (Shiftregister_SaveMeasureFeatureValuesAtRuntime)</l>
<l>        Products_VT_MeasureResult_MeasureValues.at(CurrentVectorLength) := {Indices_Objects_IfGood0Bad1_Length, Calculation_Length, ['Calculation_Length', dict_Feature.V_Length_Min.Value, dict_Feature.V_Length_Max.Value]}        </l>
<l>    endif</l>
<l>    Products_VGoodObjects_VBadObjects.at(CurrentVectorLength) := {Region_GoodLength,Region_BadLength}</l>
<l>    if (Shiftregister_SaveMeasureFeatureRegionsAtRuntime)</l>
<l>        Products_IMeasuredRegionsPerFeature.at(CurrentVectorLength) := AllObjects_MeasuredRegions   </l>
<l>        AllObjects_MeasuredRegions_Length := AllObjects_MeasuredRegions</l>
<l>    endif</l>
<l>endif</l>
<c></c>
<c>*********************************************************************************************************</c>
<c>* feature width</c>
<l>copy_dict (dict_TabletInspection.Measure_ProductWidth, [], [], dict_Feature)</l>
<l>FeatureActive := dict_Feature.V_FeatureActive.Value</l>
<l>if (FeatureActive)</l>
<l>    gCalculate_Width_PrepareData (dict_Feature, Segmentation_SelectSegmentationImage_BottomLight0_TopLight1_UVLight2, Sequencer_MovedDistanceInBetweenGrabbedImages, Segmentation_DarkOnBright0_BrightOnDark_1, Calibration_FeatureActive, Calibration_GlobalMeasurementOffset_Micron_X, Calibration_VTLane_VTPixToMM_XY, ProcessingThread)</l>
<l>endif</l>
<l>gCalculate_Feature (Image_ForGeometricalMeasurement, Tablet_Individual_PositionCorrected_GeometricMeasure, RinnenROIs, ColourClassifiedTablets_LineSpecific, Region_GoodWidth, Region_BadWidth, AllObjects_MeasuredRegions, dict_Feature, 'width in transport direction', 1, Calculation_Width, TabletWidth_BadObjects_Values, Indices_BadObjects_Width, Indices_Objects_IfGood0Bad1_Width, TimeNeeded_Width)</l>
<l>if (FeatureActive)</l>
<l>    gCalculate_IndexToStoreDataTo (Products_VT_MeasureResult_MeasureValues, CurrentVectorLength)</l>
<l>    tuple_concat (Indices_BadObjects, Indices_BadObjects_Width, Indices_BadObjects)</l>
<l>    if (Shiftregister_SaveMeasureFeatureValuesAtRuntime)</l>
<l>        Products_VT_MeasureResult_MeasureValues.at(CurrentVectorLength) := {Indices_Objects_IfGood0Bad1_Width, Calculation_Width, ['Calculation_Width', dict_Feature.V_Width_Min.Value, dict_Feature.V_Width_Max.Value]}     </l>
<l>    endif</l>
<l>    Products_VGoodObjects_VBadObjects.at(CurrentVectorLength) := {Region_GoodWidth,Region_BadWidth}</l>
<l>    if (Shiftregister_SaveMeasureFeatureRegionsAtRuntime)</l>
<l>        Products_IMeasuredRegionsPerFeature.at(CurrentVectorLength) := AllObjects_MeasuredRegions   </l>
<l>        AllObjects_MeasuredRegions_Width := AllObjects_MeasuredRegions</l>
<l>    endif </l>
<l>endif</l>
<c></c>
<c>********************************************************************************************************* </c>
<c>* feature area</c>
<l>dict_Feature := dict_TabletInspection.Measure_ProductArea</l>
<l>FeatureActive := dict_Feature.V_FeatureActive.Value</l>
<l>gCalculate_Feature (Image_ForGeometricalMeasurement, Tablet_Individual_PositionCorrected_GeometricMeasure, RinnenROIs, ColourClassifiedTablets_LineSpecific, Region_GoodArea, Region_BadArea, AllObjects_MeasuredRegions, dict_Feature, 'area', 1, Calculation_Area, TabletArea_BadObjects_Values, Indices_BadObjects_Area, Indices_Objects_IfGood0Bad1_Area, TimeNeeded_Area)</l>
<l>if (FeatureActive)</l>
<l>    gCalculate_IndexToStoreDataTo (Products_VT_MeasureResult_MeasureValues, CurrentVectorLength)</l>
<l>    tuple_concat (Indices_BadObjects, Indices_BadObjects_Area, Indices_BadObjects)</l>
<l>    if (Shiftregister_SaveMeasureFeatureValuesAtRuntime)</l>
<l>        Products_VT_MeasureResult_MeasureValues.at(CurrentVectorLength) := {Indices_Objects_IfGood0Bad1_Area, Calculation_Area, ['Calculation_Area', dict_Feature.V_Area_Min.Value, dict_Feature.V_Area_Max.Value]}</l>
<l>    endif</l>
<l>    Products_VGoodObjects_VBadObjects.at(CurrentVectorLength) := {Region_GoodArea,Region_BadArea}</l>
<l>    if (Shiftregister_SaveMeasureFeatureRegionsAtRuntime)</l>
<l>        Products_IMeasuredRegionsPerFeature.at(CurrentVectorLength) := AllObjects_MeasuredRegions</l>
<l>    endif   </l>
<l>endif</l>
<c></c>
<c>********************************************************************************************************* </c>
<c>* feature spot</c>
<l>copy_dict (dict_TabletInspection.Measure_ProductSpot, [], [], dict_Feature)</l>
<l>FeatureActive := dict_TabletInspection.Measure_ProductSpot.V_FeatureActive.Value</l>
<l>if (FeatureActive)</l>
<c>    * prepare data for gCalculate_Feature</c>
<l>    if (ProductSplittingMode = 1) // is a mirror removal was done before do not do it again</l>
<l>        dict_Feature.V_MirrorRemoveActive.Value := 0</l>
<l>    endif</l>
<l>    dict_Feature.TabletWidth_Min := dict_TabletInspection.Measure_ProductWidth.V_Width_Min.Value</l>
<c>    </c>
<c>    * Use UV-Channel for spot inspection if UV is activated</c>
<l>    if (Segmentation_SelectSegmentationImage_BottomLight0_TopLight1_UVLight2 = 2)</l>
<l>        Image_SpotDetection := Image_ForGeometricalMeasurement_PRV</l>
<l>    else</l>
<l>        Image_SpotDetection := ImageOrig_HSV</l>
<l>    endif </l>
<l>else</l>
<l>    gen_empty_obj (Image_SpotDetection)</l>
<l>endif</l>
<c></c>
<l>gCalculate_Feature (Image_SpotDetection, Tablet_Individual, RinnenROIs, ColourClassifiedTablets_LineSpecific, Region_GoodSpots, Region_BadSpots, AllObjects_MeasuredRegions, dict_Feature, 'spots', 1, Calculation_Spots, TabletSpots_BadObjects_Values, Indices_BadObjects_Spots, Indices_Objects_IfGood0Bad1_Spots, TimeNeeded_Spots)</l>
<l>if (FeatureActive)</l>
<l>    gCalculate_IndexToStoreDataTo (Products_VT_MeasureResult_MeasureValues, CurrentVectorLength)</l>
<l>    tuple_concat (Indices_BadObjects, Indices_BadObjects_Spots, Indices_BadObjects)</l>
<l>    if (Shiftregister_SaveMeasureFeatureValuesAtRuntime)</l>
<l>        Products_VT_MeasureResult_MeasureValues.at(CurrentVectorLength) := {Indices_Objects_IfGood0Bad1_Spots, Calculation_Spots, ['Calculation_Spots', dict_Feature.V_Spot_Min.Value, dict_Feature.V_Spot_Max.Value]}</l>
<l>    endif</l>
<l>    Products_VGoodObjects_VBadObjects.at(CurrentVectorLength) := {Region_GoodSpots,Region_BadSpots}</l>
<l>    if (Shiftregister_SaveMeasureFeatureRegionsAtRuntime)</l>
<l>        Products_IMeasuredRegionsPerFeature.at(CurrentVectorLength) := AllObjects_MeasuredRegions   </l>
<l>    endif    </l>
<l>endif</l>
<c></c>
<c>*********************************************************************************************************</c>
<c>* feature prv</c>
<l>dict_Feature := dict_TabletInspection.Measure_ProductPRV</l>
<l>FeatureActive := dict_Feature.V_FeatureActive.Value</l>
<c></c>
<c>* The product region 'Tablet_Individual' is positioned correctly only for the second image (HSV). </c>
<c>* For PRV we have to use the region moved by a (previously calculated) Value.</c>
<l>Sequencer_MovedDistanceInBetweenGrabbedImages := GrabImageMetaData.Sequencer_MovedDistanceInBetweenGrabbedImages</l>
<c></c>
<l>if(Sequencer_MovedDistanceInBetweenGrabbedImages # [] )</l>
<l>    move_region (Tablet_Individual, Tablet_Individual_PositionCorrected_UVMeasure, Sequencer_MovedDistanceInBetweenGrabbedImages[0], 0)</l>
<l>    tempSequencer:=Sequencer_MovedDistanceInBetweenGrabbedImages</l>
<l>else</l>
<l>    if (tempSequencer # [])</l>
<l>        move_region (Tablet_Individual, Tablet_Individual_PositionCorrected_UVMeasure, tempSequencer, 0)</l>
<l>    else</l>
<c>        *it may happen that no MoveDistance is available in that case use the original position</c>
<l>        Tablet_Individual_PositionCorrected_UVMeasure := Tablet_Individual  </l>
<l>    endif</l>
<c>    </c>
<l>endif</l>
<c></c>
<l>gCalculate_Feature (Image_ForGeometricalMeasurement_PRV, Tablet_Individual_PositionCorrected_UVMeasure, RinnenROIs, ColourClassifiedTablets_LineSpecific, Region_GoodPRV, Region_BadPRV, AllObjects_MeasuredRegions, dict_Feature, 'prv', 1, Calculation_PRV, TabletPRV_BadObjects_Values, Indices_BadObjects_PRV, Indices_Objects_IfGood0Bad1_PRV, TimeNeeded_PRV)</l>
<l>if (FeatureActive)      </l>
<l>    gCalculate_IndexToStoreDataTo (Products_VT_MeasureResult_MeasureValues, CurrentVectorLength)</l>
<l>    tuple_concat (Indices_BadObjects, Indices_BadObjects_PRV, Indices_BadObjects)</l>
<l>    if (Shiftregister_SaveMeasureFeatureValuesAtRuntime)</l>
<c>        *apply Fake Threshold here</c>
<l>        Products_VT_MeasureResult_MeasureValues.at(CurrentVectorLength) := {Indices_Objects_IfGood0Bad1_PRV, Calculation_PRV, ['Calculation_PRV', 1, 1]}</l>
<l>    endif</l>
<l>    Products_VGoodObjects_VBadObjects.at(CurrentVectorLength) := {Region_GoodPRV,Region_BadPRV}</l>
<l>    if (Shiftregister_SaveMeasureFeatureRegionsAtRuntime)</l>
<l>        Products_IMeasuredRegionsPerFeature.at(CurrentVectorLength) := AllObjects_MeasuredRegions</l>
<l>    endif   </l>
<l>endif</l>
<c></c>
<c>*********************************************************************************************************</c>
<c>* feature pcc</c>
<l>dict_Feature := dict_TabletInspection.Measure_ProductPCC</l>
<l>FeatureActive := dict_Feature.V_FeatureActive.Value</l>
<l>gCalculate_Feature (Image_ForGeometricalMeasurement_PRV, Tablet_Individual_PositionCorrected_UVMeasure, RinnenROIs, ColourClassifiedTablets_LineSpecific, Region_GoodPCC, Region_BadPCC, AllObjects_MeasuredRegions, dict_Feature, 'pcc', 1, Calculation_PCC, TabletPCC_BadObjects_Values, Indices_BadObjects_PCC, Indices_Objects_IfGood0Bad1_PCC, TimeNeeded_PCC)</l>
<l>if (FeatureActive)</l>
<l>    gCalculate_IndexToStoreDataTo (Products_VT_MeasureResult_MeasureValues, CurrentVectorLength)</l>
<l>    tuple_concat (Indices_BadObjects, Indices_BadObjects_PCC, Indices_BadObjects)</l>
<l>    if (Shiftregister_SaveMeasureFeatureValuesAtRuntime)</l>
<c>        *apply Fake Threshold here</c>
<l>        Products_VT_MeasureResult_MeasureValues.at(CurrentVectorLength) := {Indices_Objects_IfGood0Bad1_PCC, Calculation_PCC, ['Calculation_PCC', 1, 1]}</l>
<l>    endif</l>
<l>    Products_VGoodObjects_VBadObjects.at(CurrentVectorLength) := {Region_GoodPCC,Region_BadPCC}</l>
<l>    if (Shiftregister_SaveMeasureFeatureRegionsAtRuntime)</l>
<l>        Products_IMeasuredRegionsPerFeature.at(CurrentVectorLength) := AllObjects_MeasuredRegions</l>
<l>    endif   </l>
<l>endif</l>
<c></c>
<c>*********************************************************************************************************</c>
<c>* feature ocr</c>
<l>dict_Feature := dict_TabletInspection.Measure_ProductOCR</l>
<l>FeatureActive := dict_Feature.V_FeatureActive.Value</l>
<l>gCalculate_Feature (ImageOrig_HSV, Tablet_Individual, RinnenROIs, ColourClassifiedTablets_LineSpecific, Region_GoodOCR, Region_BadOCR, AllObjects_MeasuredRegions, dict_Feature, 'ocr', 0, Calculation_OCR, TabletOCR_BadObjects_Values, Indices_BadObjects_OCR, Indices_Objects_IfGood0Bad1_OCR, TimeNeeded_OCR)</l>
<l>if (FeatureActive)</l>
<l>    gCalculate_IndexToStoreDataTo (Products_VT_MeasureResult_MeasureValues, CurrentVectorLength)</l>
<l>    tuple_concat (Indices_BadObjects, Indices_BadObjects_OCR, Indices_BadObjects)</l>
<l>    if (Shiftregister_SaveMeasureFeatureValuesAtRuntime = 1)</l>
<c>        *apply Fake Threshold here</c>
<l>        Products_VT_MeasureResult_MeasureValues.at(CurrentVectorLength) := {Indices_Objects_IfGood0Bad1_OCR, Calculation_OCR, ['Calculation_OCR', 1, 1]}</l>
<l>    endif</l>
<l>    Products_VGoodObjects_VBadObjects.at(CurrentVectorLength) := {Region_GoodOCR,Region_BadOCR}</l>
<l>    if (Shiftregister_SaveMeasureFeatureRegionsAtRuntime = 1)</l>
<l>        Products_IMeasuredRegionsPerFeature.at(CurrentVectorLength) := AllObjects_MeasuredRegions</l>
<l>    endif   </l>
<l>endif</l>
<c></c>
<c>*********************************************************************************************************</c>
<c>* feature calculation end</c>
<c>*********************************************************************************************************</c>
<c></c>
<c></c>
<c></c>
<c>* check if necessary - maybe tracking is relative to only first measured feature</c>
<l>gCorrectResultIndexForProductTracking (Products_VT_MeasureResult_MeasureValues, Products_VT_MeasureResult_MeasureValues) </l>
<c></c>
<c></c>
<c>*********************************************************************************************************</c>
<c>* Shift Register </c>
<c>*********************************************************************************************************</c>
<l>union2 (Region_BadColourRed, Region_BadColourGreen, Region_BadColour)</l>
<l>union2 (Region_BadColour, Region_BadColourBlue, Region_BadColour)</l>
<c></c>
<l>ImageForShiftregister := ImageOrig_HSV</l>
<l>ImageForShiftregister_Sequencer := Image_ForGeometricalMeasurement</l>
<c></c>
<l>RollSpeed360_Mean := GrabImageMetaData.RollSpeed360_Mean</l>
<l>GrabLoopCounter := GrabImageMetaData.GrabLoopCounter</l>
<c></c>
<l>gShiftRegisterAndEject (Region_BadLength, Region_BadWidth, Region_BadColour, Region_BadColourRed, Region_BadColourGreen, Region_BadColourBlue, Region_BadSpots, Region_BadArea, Region_BadPRV, Region_BadPCC, Region_BadOCR, EjectROIs, RinnenROIs, ImageForShiftregister, ImageForShiftregister_Sequencer, Tablet_Individual, ShiftRegisterVector_Good_Bad_ObjectsLastFrame, Shiftregister_Iconic_Lanes_Data, Products_VGoodObjects_VBadObjects, Products_IMeasuredRegionsPerFeature, Shiftregister_VLane_IImagePartsPerObject, Shiftregister_VLane_VMeasuredFeatures_IRegionPerFeature, Rollmeasurement360, ShiftRegisterVector_Good_Bad_ObjectsLastFrame_Out, ErrorObjectVector_Colour_Width_Diameter_Spots_Area_Length, GoodObjectVector_TabletIndividual_WidthGood, Shiftregister_VLane_IImagePartsPerObject_Out, Shiftregister_VLane_VMeasuredFeatures_IRegionPerFeature_Out, ErrorObjectDataToStore_VLane_IImagePartsPerObject, ErrorObjectDataToStore_VLane_IRegionPerFeature, Shiftregister_VEjectROI_Adapted, IndexRinnenUndEjects, ShiftregisterVector_ObjectMovement, Shiftregister_RemoveBadRegionsInEjectBox, Shiftregister_Rebuild_Kill, Shiftregister_Tuple_Lanes_Data, Products_VT_MeasureResult_MeasureValues, Indices_BadObjects, Shiftregister_VLane_VMeasureFeature_TResult_TValue, Shiftregister_VLane_VImagePartsOffset_TRow_TColumn, RollSpeed360_Mean, GrabLoopCounter, Shiftregister_EjectFoundPerLine, Shiftregister_EjectGoodFoundPerLine, Shiftregister_EjectFoundPerLine_MovementUncompensated, Shiftregister_EjectObjectInMovementUncompensatedEjectFound, Shiftregister_CriticalInspectionResultFoundPerLine, ShiftregisterVector_ObjectMovement_Out, ShiftregisterVector_EjectPositionMovementCompensation, Shiftregister_VLane_VMeasureFeature_TResult_TValue_Out, Shiftregister_VLane_VImagePartsOffset_TRow_TColumn_Out, ErrorObjectDataToStore_VLane_VMeasureFeature_TResult_TValue, ErrorObjectDataToStore_VLane_VImagePartsOffset_TRow_TColumn, Shiftregister_VLane_IndicesInEjectBoxFound, Result_VLane_ForEverySingleFeature_0Good_1Bad, TimeNeeded_ShiftRegister)</l>
<c>* todo: Generate one Error Object with tuple, region and image information</c>
<c></c>
<l>count_seconds (Seconds_End)</l>
<l>TimeNeeded_CompleteProcessing := (Seconds_End-TimeStart) * 1000</l>
<c>* *********************************************************************************************************</c>
<l>ImageOrig_Toplight := ImageForShiftregister</l>
<l>ImageOrig_Sequencer := ImageForShiftregister_Sequencer</l>
<c></c>
<l>return ()</l>
<c></c>
<l>return ()</l>
</body>
<docu id="InspectionProcessOneLine">
<parameters>
<parameter id="ChannelSelector"/>
<parameter id="Image"/>
<parameter id="ProcessingThreadID"/>
</parameters>
</docu>
</procedure>
</hdevelop>

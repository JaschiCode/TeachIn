<par name="Shiftregister_CriticalInspectionResultFoundPerLine" base_type="ctrl" dimension="0"/>
<par name="ShiftregisterVector_ObjectMovement_Out" base_type="ctrl" dimension="1"/>
<par name="ShiftregisterVector_EjectPositionMovementCompensation" base_type="ctrl" dimension="1"/>
<par name="Shiftregister_VLane_VMeasureFeature_TResult_TValue_Out" base_type="ctrl" dimension="3"/>
<par name="Shiftregister_VLane_VImagePartsOffset_TRow_TColumn_Out" base_type="ctrl" dimension="2"/>
<par name="ErrorObjectDataToStore_VLane_VMeasureFeature_TResult_TValue" base_type="ctrl" dimension="3"/>
<par name="ErrorObjectDataToStore_VLane_VImagePartsOffset_TRow_TColumn" base_type="ctrl" dimension="2"/>
<par name="Shiftregister_VLane_IndicesInEjectBoxFound" base_type="ctrl" dimension="1"/>
<par name="Result_VLane_ForEverySingleFeature_0Good_1Bad" base_type="ctrl" dimension="1"/>
<par name="Time_Needed" base_type="ctrl" dimension="0"/>
</oc>
</interface>
<body>
<l>global tuple dict_Shiftregister</l>
<c></c>
<l>QuickReference_Shiftregister := []</l>
<l>Shiftregister_SaveMeasureFeatureGoodBadAtRuntime := 1</l>
<c>* </c>
<l>count_seconds (Seconds_Start)</l>
<l>count_obj (RinnenROIs, RinnenROIs_Number)</l>
<c>* </c>
<l>gen_empty_obj (Shiftregister_VEjectROI_Adapted.at(0))</l>
<c></c>
<l>gCalculate_ShiftregisterValues (Shiftregister_NumberOfObjetsLeadToEjectPerLine, Shiftregister_NumberOfDetectionsLeadToEject_PerLinePerFeature, Shiftregister_CriticalDefectActive_PerLinePerFeature, Shiftregister_EjectPositionMovementCompensationActive, Shiftregister_EjectPositionMovementCompensation_UpperMax, Shiftregister_EjectPositionMovementCompensation_LowerMax, Shiftregister_EjectPositionMovementCompensation_SpeedMax, Shiftregister_FixedEjectPosition_RelativeToROI, Shiftregister_FixedStopPositionForFastProducts_RelativeToROI, Shiftregister_SaveMeasureFeatureValuesAtRuntime, Shiftregister_SaveMeasureFeatureRegionsAtRuntime, Shiftregister_SaveMeasureFeaturePartImagesAtRuntime, Shiftregister_CheckForGoodProductDetectionActive, Shiftregister_ObjectsPerTrack_LimitMax, Shiftregister_ObjectMovement_MinSpeedToRegisterObjects)</l>
<c></c>
<c></c>
<c>* Picture, ColourRed, ColourGreen, ColourBlue, Width, Diameter, Spots</c>
<l>ObjectCount := 0</l>
<l>ShiftRegisterVector_HistoryIconic.at(ObjectCount) := {ImageOrig_RGB,ImageOrig_RGB}</l>
<c>* </c>
<l>Shiftregister_EjectFoundPerLine := []</l>
<l>Shiftregister_EjectGoodFoundPerLine := []</l>
<l>Shiftregister_EjectFoundPerLine_MovementUncompensated := []</l>
<l>Shiftregister_EjectFoundPerLine_ForFastProducts := []</l>
<c></c>
<l>Shiftregister_CriticalInspectionResultFoundPerLine := []</l>
<l>Shiftregister_EjectPositionMovementCompensation.at(0) := []</l>
<l>ErrorObjectDataToStore_VLane_VMeasureFeature_TResult_TValue.at(0).at(0).at(0) := []</l>
<c>* </c>
<l>Shiftregister_VLane_VMeasureFeature_TResult_TValue_Out := Shiftregister_VLane_VMeasureFeature_TResult_TValue</l>
<l>Shiftregister_VLane_IImagePartsPerObject_Out := Shiftregister_VLane_IImagePartsPerObject</l>
<l>Shiftregister_VLane_VImagePartsOffset_TRow_TColumn_Out := Shiftregister_VLane_VImagePartsOffset_TRow_TColumn</l>
<l>Shiftregister_VLane_VMeasuredFeatures_IRegionPerFeature_Out := Shiftregister_VLane_VMeasuredFeatures_IRegionPerFeature</l>
<l>Shiftregister_VLane_IndicesInEjectBoxFound.at(0) := []</l>
<l>Result_VLane_ForEverySingleFeature_0Good_1Bad.at(0) := []</l>
<c></c>
<c>* basic calculations for shiftregister, needed to get object relations faster than via regions</c>
<l>smallest_rectangle1 (Tablet_Individual, Tablet_Individual_RowHighest, Tablet_Individual_Column1, Tablet_Individual_RowLowest, Tablet_Individual_Column2)</l>
<l>Tablet_Individual_ColumnMiddle := (Tablet_Individual_Column2-Tablet_Individual_Column1)/2+Tablet_Individual_Column1</l>
<l>smallest_rectangle1 (EjectROIs, _, EjectROIs_Column1, _, EjectROIs_Column2)</l>
<c>* </c>
<l>gSelect_GoodAndBadObjectsViaIndex (Tablet_Individual, BadObjects, GoodObjects, Indices_BadObjects, Shiftregister_SaveMeasureFeatureGoodBadAtRuntime, Indices_GoodObjects, Indices_BadObjects)</l>
<c>* </c>
<c>* turn off good bad - obly go via all objects into tracking</c>
<l>DisableGoodBadObjects := 0</l>
<l>if (DisableGoodBadObjects = 1)</l>
<l>    gen_empty_obj (GoodObjects)</l>
<l>    gen_empty_obj (BadObjects)</l>
<l>endif</l>
<l>count_obj (BadObjects, BadObjects_Number)</l>
<c></c>
<l>for IndexLine := 0 to RinnenROIs_Number-1 by 1</l>
<c>    * select line specific data. Reformat measured data with row (low and high) information</c>
<l>    gSelect_LinespecificData_V2 (RinnenROIs, EjectROIs, Tablet_Individual, GoodObjects, BadObjects, ImageOrig_RGB, ImageOrig_Sequencer_RGB, Products_IMeasuredRegionsPerFeature, RinnenROI_Selected, EjectROI_Selected, Tablet_Individual_OneLine, GoodObjects_OneLine, BadObjects_OneLine, Products_IMeasuredRegionsPerFeature_OneLine, Products_IImagePartsPerObject_OneLine, IndexLine, Products_VT_MeasureResult_MeasureValues, Shiftregister_SaveMeasureFeatureGoodBadAtRuntime, Shiftregister_SaveMeasureFeatureValuesAtRuntime, Shiftregister_SaveMeasureFeatureRegionsAtRuntime, Shiftregister_SaveMeasureFeaturePartImagesAtRuntime, EjectROIs_Column1, EjectROIs_Column2, Tablet_Individual_ColumnMiddle, Tablet_Individual_RowLowest, Tablet_Individual_RowHighest, 1, ['C ' , GrabLoopCounter, ', I '], Tablet_Individual_OneLine_IndicesInFullSet, GoodObjects_OneLine_IndicesInFullSet, BadObjects_OneLine_IndicesInFullSet, Products_VT_MeasureResult_MeasureValues_OneLine, Products_VImagePartsOffset_TRow_TColumn_OneLine)</l>
<c>    * </c>
<l>    Shiftregister_GoodObjects := ShiftRegisterVector_Good_Bad_ObjectsLastFrame.at((IndexLine)).at(0)</l>
<l>    Shiftregister_BadObjects := ShiftRegisterVector_Good_Bad_ObjectsLastFrame.at((IndexLine)).at(1)</l>
<l>    ShiftRegister_ObjectsInLastFrame := ShiftRegisterVector_Good_Bad_ObjectsLastFrame.at((IndexLine)).at(2)</l>
<l>    Shiftregister_AllObjectsMovementAdapted := ShiftRegisterVector_Good_Bad_ObjectsLastFrame.at((IndexLine)).at(3)</l>
<c>    </c>
<l>    Shiftregister_ObjectMovement_LastFrame := ShiftregisterVector_ObjectMovement.at(IndexLine)</l>
<c>    * </c>
<l>*     intersection (Tablet_Individual, RinnenROI_Selected, Tablet_Individual_OneLine)</l>
<l>    Shiftregister_RemoveBadRegionsInEjectBox_Selected := Shiftregister_RemoveBadRegionsInEjectBox</l>
<l>    Shiftregister_VLane_VMeasureFeature_TResult_TValue_OneLine := Shiftregister_VLane_VMeasureFeature_TResult_TValue.at(IndexLine)</l>
<c>    *** Janine - Exception Topic</c>
<c>    * Here occurs an error if length of vector is smaller the IndexLine</c>
<l>    if (Shiftregister_VLane_IImagePartsPerObject.length() &gt; IndexLine)</l>
<l>        Shiftregister_IImagePartsPerObject := Shiftregister_VLane_IImagePartsPerObject.at(IndexLine)</l>
<l>        Shiftregister_VImagePartsOffset_TRow_TColumn := Shiftregister_VLane_VImagePartsOffset_TRow_TColumn.at(IndexLine)</l>
<l>        Shiftregister_VMeasuredFeatures_IRegionPerFeature := Shiftregister_VLane_VMeasuredFeatures_IRegionPerFeature.at(IndexLine)</l>
<l>    else</l>
<l>        gen_empty_obj (EmptyObject)</l>
<l>        Shiftregister_IImagePartsPerObject := {EmptyObject}</l>
<l>        Shiftregister_VImagePartsOffset_TRow_TColumn := {}</l>
<l>        Shiftregister_VImagePartsOffset_TRow_TColumn.clear()</l>
<l>        Shiftregister_VMeasuredFeatures_IRegionPerFeature := {EmptyObject}</l>
<l>    endif</l>
<c>    </c>
<l>    gShiftRegister_OneLine (Shiftregister_GoodObjects, Shiftregister_BadObjects, ShiftRegister_ObjectsInLastFrame, Shiftregister_AllObjectsMovementAdapted, Shiftregister_IImagePartsPerObject, Shiftregister_VMeasuredFeatures_IRegionPerFeature, Tablet_Individual_OneLine, ImageOrig_RGB, RinnenROI_Selected, EjectROI_Selected, BadObjects_OneLine, GoodObjects_OneLine, Products_IMeasuredRegionsPerFeature_OneLine, Products_IImagePartsPerObject_OneLine, Rollmeasurement360, Shiftregister_GoodObjects, Shiftregister_BadObjects, ShiftRegister_ObjectsInLastFrame, Shiftregister_AllObjectsMovementAdapted, Shiftregister_IImagePartsPerObject, Shiftregister_VMeasuredFeatures_IRegionPerFeature, Shiftregister_GoodObjects_FoundInThisCycle, Shiftregister_BadObjectsFor_FoundInThisCycle, ErrorObjectDataToStore_IImagePartsPerObject, ErrorObjectDataToStore_IRegionPerFeature, Shiftregister_VEjectROI_Adapted.at(IndexLine), IndexRinnenUndEjects, Shiftregister_NumberOfObjetsLeadToEjectPerLine, Shiftregister_NumberOfDetectionsLeadToEject_PerLinePerFeature, Shiftregister_CriticalDefectActive_PerLinePerFeature, Shiftregister_RemoveBadRegionsInEjectBox_Selected, Shiftregister_Rebuild_Kill, Shiftregister_Tuple_Lanes_Data.at(IndexLine), Shiftregister_VLane_VMeasureFeature_TResult_TValue_OneLine, Products_VT_MeasureResult_MeasureValues_OneLine, Products_VImagePartsOffset_TRow_TColumn_OneLine, Shiftregister_EjectPositionMovementCompensationActive, Shiftregister_EjectPositionMovementCompensation_LowerMax, Shiftregister_EjectPositionMovementCompensation_UpperMax, Shiftregister_EjectPositionMovementCompensation_SpeedMax, Shiftregister_FixedEjectPosition_RelativeToROI, Shiftregister_FixedStopPositionForFastProducts_RelativeToROI, Shiftregister_VImagePartsOffset_TRow_TColumn, Shiftregister_SaveMeasureFeatureValuesAtRuntime, Shiftregister_SaveMeasureFeatureGoodBadAtRuntime, Shiftregister_SaveMeasureFeatureRegionsAtRuntime, Shiftregister_SaveMeasureFeaturePartImagesAtRuntime, Shiftregister_CheckForGoodProductDetectionActive, Shiftregister_ObjectsPerTrack_LimitMax, Shiftregister_ObjectMovement_MinSpeedToRegisterObjects, RollSpeed360_Mean, Shiftregister_EjectFoundPerLine_out, Shiftregister_EjectGoodFoundPerLine_out, Shiftregister_EjectFoundPerLine_MovementUncompensated_out, Shiftregister_EjectFoundPerLine_ForFastProducts_out, Shiftregister_EjectPositionMovementCompensation_out, Shiftregister_ObjectMovement, Shiftregister_IndicesInEjectBoxFound, ObjectMovement, EjectROIs_Number, NumberOfFailedClassificationsInEjectBin, NumberOfGoodClassificationsInEjectBin, IndexOfAllRegionsWithPartlyIntersection, CriticalInspectionResultFound, Shiftregister_Tuple_Lanes_Data.at(IndexLine), Shiftregister_VLane_VMeasureFeature_TResult_TValue_OneLine_Out, Shiftregister_VImagePartsOffset_TRow_TColumn_Out, ErrorObjectDataToStore_VMeasureFeature_TResult_TValue, ErrorObjectDataToStore_VImagePartsOffset_TRow_TColumn, Result_ForEverySingleFeature_0Good_1Bad, TimeNeeded)</l>
<c>    * </c>
<l>    Shiftregister_VLane_IndicesInEjectBoxFound.at(IndexLine) := Shiftregister_IndicesInEjectBoxFound</l>
<l>    Shiftregister_VLane_VMeasuredFeatures_IRegionPerFeature_Out.at(IndexLine) := Shiftregister_VMeasuredFeatures_IRegionPerFeature</l>
<l>    Shiftregister_VLane_VImagePartsOffset_TRow_TColumn_Out.at(IndexLine) := Shiftregister_VImagePartsOffset_TRow_TColumn_Out</l>
<l>    Shiftregister_VLane_IImagePartsPerObject_Out.at(IndexLine) := Shiftregister_IImagePartsPerObject</l>
<l>    Shiftregister_VLane_VMeasureFeature_TResult_TValue_Out.at(IndexLine) := Shiftregister_VLane_VMeasureFeature_TResult_TValue_OneLine_Out</l>
<l>*     Shiftregister_VLane_IObjectsMovementAdapted.at(IndexLine) := Shiftregister_IObjectsMovementAdapted_Out</l>
<c>    * add data to vector for later error visualisation</c>
<l>    ErrorObjectDataToStore_VLane_VMeasureFeature_TResult_TValue.at(IndexLine) := ErrorObjectDataToStore_VMeasureFeature_TResult_TValue</l>
<l>    ErrorObjectDataToStore_VLane_VImagePartsOffset_TRow_TColumn.at(IndexLine) := ErrorObjectDataToStore_VImagePartsOffset_TRow_TColumn</l>
<l>    ErrorObjectDataToStore_VLane_IImagePartsPerObject.at(IndexLine) := ErrorObjectDataToStore_IImagePartsPerObject</l>
<l>    ErrorObjectDataToStore_VLane_IRegionPerFeature.at(IndexLine) := ErrorObjectDataToStore_IRegionPerFeature</l>
<c>    </c>
<l>*     stop() </l>
<c>    </c>
<l>*     tuple_concat (Shiftregister_EjectFoundPerLine, Shiftregister_EjectFoundPerLine_out, Shiftregister_EjectFoundPerLine)</l>
<l>*     tuple_concat (Shiftregister_EjectGoodFoundPerLine, Shiftregister_EjectGoodFoundPerLine_out, Shiftregister_EjectGoodFoundPerLine)</l>
<l>    tuple_concat (Shiftregister_EjectFoundPerLine, NumberOfFailedClassificationsInEjectBin, Shiftregister_EjectFoundPerLine)</l>
<l>    tuple_concat (Shiftregister_EjectGoodFoundPerLine, NumberOfGoodClassificationsInEjectBin, Shiftregister_EjectGoodFoundPerLine)</l>
<l>    tuple_concat (Shiftregister_EjectFoundPerLine_MovementUncompensated, Shiftregister_EjectFoundPerLine_MovementUncompensated_out, Shiftregister_EjectFoundPerLine_MovementUncompensated)</l>
<l>    tuple_concat (Shiftregister_EjectFoundPerLine_ForFastProducts, Shiftregister_EjectFoundPerLine_ForFastProducts_out, Shiftregister_EjectFoundPerLine_ForFastProducts)</l>
<l>    tuple_concat (Shiftregister_CriticalInspectionResultFoundPerLine, CriticalInspectionResultFound, Shiftregister_CriticalInspectionResultFoundPerLine)</l>
<l>    ShiftregisterVector_EjectPositionMovementCompensation.at(IndexLine) := Shiftregister_EjectPositionMovementCompensation_out</l>
<c>    * </c>
<c></c>
<l>    ShiftRegisterVector_Good_Bad_ObjectsLastFrame_Out.at((IndexLine)).at(0) := Shiftregister_GoodObjects</l>
<l>    ShiftRegisterVector_Good_Bad_ObjectsLastFrame_Out.at((IndexLine)).at(1) := Shiftregister_BadObjects</l>
<l>    ShiftRegisterVector_Good_Bad_ObjectsLastFrame_Out.at((IndexLine)).at(2) := ShiftRegister_ObjectsInLastFrame</l>
<l>    ShiftRegisterVector_Good_Bad_ObjectsLastFrame_Out.at((IndexLine)).at(3) := Shiftregister_AllObjectsMovementAdapted</l>
<c>    </c>
<l>*     stop ()</l>
<l>*     ShiftRegisterVector_Good_Bad_ObjectsLastFrame_Out.at((Index)).at(3) := Shiftregister_BadObjectsVisualisationImages</l>
<l>    ShiftregisterVector_ObjectMovement_Out.at(IndexLine) := Shiftregister_ObjectMovement</l>
<c>    * Build vector for error objects</c>
<l>    intersection (ErrorObject_WrongColour, RinnenROI_Selected, ErrorObject_WrongColour_OneLine)</l>
<l>*     intersection (ErrorObject_WrongColour_Red, RinnenROI_Selected, ErrorObject_WrongColourRed_OneLine)</l>
<l>*     intersection (ErrorObject_WrongColour_Green, RinnenROI_Selected, ErrorObject_WrongColourGreen_OneLine)</l>
<l>*     intersection (ErrorObject_WrongColour_Blue, RinnenROI_Selected, ErrorObject_WrongColourBlue_OneLine)</l>
<l>    intersection (ErrorObject_Spots, RinnenROI_Selected, ErrorObject_Spots_OneLine)</l>
<l>    intersection (ErrorObject_WrongWidth, RinnenROI_Selected, ErrorObject_WrongWidth_OneLine)</l>
<l>    intersection (ErrorObject_WrongLength, RinnenROI_Selected, ErrorObject_WrongLength_OneLine)</l>
<l>    intersection (ErrorObject_Area, RinnenROI_Selected, ErrorObject_Area_OneLine)</l>
<l>    intersection (ErrorObject_WrongPRV, RinnenROI_Selected, ErrorObject_WrongPRV_OneLine)</l>
<l>    intersection (ErrorObject_WrongPCC, RinnenROI_Selected, ErrorObject_WrongPCC_OneLine)</l>
<l>    intersection (ErrorObject_WrongOCR, RinnenROI_Selected, ErrorObject_WrongOCR_OneLine)</l>
<c>    </c>
<l>    ErrorObjectVector_Colour_Width_Diameter_Spots_Area_Length.at((IndexLine)).at(0) := ErrorObject_WrongColour_OneLine</l>
<l>    ErrorObjectVector_Colour_Width_Diameter_Spots_Area_Length.at((IndexLine)).at(1) := ErrorObject_WrongWidth_OneLine</l>
<l>    ErrorObjectVector_Colour_Width_Diameter_Spots_Area_Length.at((IndexLine)).at(2) := ErrorObject_Spots_OneLine</l>
<l>    ErrorObjectVector_Colour_Width_Diameter_Spots_Area_Length.at((IndexLine)).at(3) := ErrorObject_Area_OneLine</l>
<l>    ErrorObjectVector_Colour_Width_Diameter_Spots_Area_Length.at((IndexLine)).at(4) := ErrorObject_WrongLength_OneLine</l>
<l>    ErrorObjectVector_Colour_Width_Diameter_Spots_Area_Length.at((IndexLine)).at(5) := ErrorObject_WrongPRV_OneLine</l>
<l>    ErrorObjectVector_Colour_Width_Diameter_Spots_Area_Length.at((IndexLine)).at(6) := ErrorObject_WrongPCC_OneLine</l>
<l>    ErrorObjectVector_Colour_Width_Diameter_Spots_Area_Length.at((IndexLine)).at(7) := ErrorObject_WrongOCR_OneLine</l>
<c></c>
<c>    * </c>
<c>    * Build vector for good objects</c>
<l>    GoodObjectVector_TabletIndividual_WidthGood.at((IndexLine)).at(0) := Tablet_Individual_OneLine</l>
<l>    GoodObjectVector_TabletIndividual_WidthGood.at((IndexLine)).at(1) := Shiftregister_GoodObjects_FoundInThisCycle</l>
<c>    * </c>
<l>    Result_VLane_ForEverySingleFeature_0Good_1Bad.at(IndexLine) := Result_ForEverySingleFeature_0Good_1Bad</l>
<c>    * </c>
<l>endfor</l>
<c></c>
<c>* concat the found entries of fast products and movement uncomenspated together, indicates slow startup later</c>
<l>* Shiftregister_EjectFoundPerLine_MovementUncompensated := [Shiftregister_EjectFoundPerLine_MovementUncompensated, Shiftregister_EjectFoundPerLine_ForFastProducts]</l>
<l>tuple_add (Shiftregister_EjectFoundPerLine_MovementUncompensated, Shiftregister_EjectFoundPerLine_ForFastProducts, Shiftregister_EjectFoundPerLine_MovementUncompensated)</l>
<c></c>
<c>* check that only valid ejects uncompensated are used</c>
<l>* tuple_greater_equal_elem (Shiftregister_EjectFoundPerLine_MovementUncompensated, Shiftregister_NumberOfObjetsLeadToEjectPerLine, Shiftregister_EjectFoundPerLine_MovementUncompensated)</l>
<c>* </c>
<c>* calculate if eject Object is in uncompensated eject boxes available - needed for start of product conveying</c>
<l>tuple_greater_equal_elem (Shiftregister_EjectFoundPerLine_MovementUncompensated, 1, Greatereq)</l>
<l>tuple_sum (Greatereq, Sum)</l>
<l>if (Sum &gt;= 1)</l>
<l>    Shiftregister_EjectObjectInMovementUncompensatedEjectFound := 1</l>
<l>else</l>
<l>    Shiftregister_EjectObjectInMovementUncompensatedEjectFound := 0</l>
<l>endif</l>
<c>* </c>
<c>* </c>
<l>count_seconds (Seconds_End)</l>
<l>Time_Needed := (Seconds_End - Seconds_Start) * 1000</l>
<c>* </c>
<l>return ()</l>
</body>
<docu id="gShiftRegisterAndEject">
<parameters>
<parameter id="EjectROIs"/>
<parameter id="ErrorObjectDataToStore_VLane_IImagePartsPerObject"/>
<parameter id="ErrorObjectDataToStore_VLane_IRegionPerFeature"/>
<parameter id="ErrorObjectDataToStore_VLane_VImagePartsOffset_TRow_TColumn"/>
<parameter id="ErrorObjectDataToStore_VLane_VMeasureFeature_TResult_TValue"/>
<parameter id="ErrorObjectVector_Colour_Width_Diameter_Spots_Area_Length"/>
<parameter id="ErrorObject_Area"/>
<parameter id="ErrorObject_Spots"/>
<parameter id="ErrorObject_WrongColour"/>
<parameter id="ErrorObject_WrongColour_Blue"/>
<parameter id="ErrorObject_WrongColour_Green"/>
<parameter id="ErrorObject_WrongColour_Red"/>
<parameter id="ErrorObject_WrongLength"/>
<parameter id="ErrorObject_WrongOCR"/>
<parameter id="ErrorObject_WrongPCC"/>
<parameter id="ErrorObject_WrongPRV"/>
<parameter id="ErrorObject_WrongWidth"/>
<parameter id="GoodObjectVector_TabletIndividual_WidthGood"/>
<parameter id="GrabLoopCounter"/>
<parameter id="ImageOrig_RGB"/>
<parameter id="ImageOrig_Sequencer_RGB"/>
<parameter id="IndexRinnenUndEjects"/>
<parameter id="Indices_BadObjects"/>
<parameter id="Products_IMeasuredRegionsPerFeature"/>
<parameter id="Products_VGoodObjects_VBadObjects"/>
<parameter id="Products_VT_MeasureResult_MeasureValues"/>
<parameter id="Result_VLane_ForEverySingleFeature_0Good_1Bad"/>
<parameter id="RinnenROIs"/>
<parameter id="RollSpeed360_Mean"/>
<parameter id="Rollmeasurement360"/>
<parameter id="ShiftRegisterVector_Good_Bad_ObjectsLastFrame"/>
<parameter id="ShiftRegisterVector_Good_Bad_ObjectsLastFrame_Out"/>
<parameter id="ShiftregisterVector_EjectPositionMovementCompensation"/>
<parameter id="ShiftregisterVector_ObjectMovement"/>
<parameter id="ShiftregisterVector_ObjectMovement_Out"/>
<parameter id="Shiftregister_CriticalInspectionResultFoundPerLine"/>
<parameter id="Shiftregister_EjectFoundPerLine"/>
<parameter id="Shiftregister_EjectFoundPerLine_MovementUncompensated"/>
<parameter id="Shiftregister_EjectGoodFoundPerLine"/>
<parameter id="Shiftregister_EjectObjectInMovementUncompensatedEjectFound"/>
<parameter id="Shiftregister_Iconic_Lanes_Data"/>
<parameter id="Shiftregister_Rebuild_Kill"/>
<parameter id="Shiftregister_RemoveBadRegionsInEjectBox"/>
<parameter id="Shiftregister_Tuple_Lanes_Data"/>
<parameter id="Shiftregister_VEjectROI_Adapted"/>
<parameter id="Shiftregister_VLane_IImagePartsPerObject"/>
<parameter id="Shiftregister_VLane_IImagePartsPerObject_Out"/>
<parameter id="Shiftregister_VLane_IndicesInEjectBoxFound"/>
<parameter id="Shiftregister_VLane_VImagePartsOffset_TRow_TColumn"/>
<parameter id="Shiftregister_VLane_VImagePartsOffset_TRow_TColumn_Out"/>
<parameter id="Shiftregister_VLane_VMeasureFeature_TResult_TValue"/>
<parameter id="Shiftregister_VLane_VMeasureFeature_TResult_TValue_Out"/>
<parameter id="Shiftregister_VLane_VMeasuredFeatures_IRegionPerFeature"/>
<parameter id="Shiftregister_VLane_VMeasuredFeatures_IRegionPerFeature_Out"/>
<parameter id="Tablet_Individual"/>
<parameter id="Time_Needed"/>
</parameters>
</docu>
</procedure>
<procedure name="gSplitIntoSingleTablets">
<interface>
<io>
<par name="ImageOrig" base_type="iconic" dimension="0"/>
<par name="RinnenROIs" base_type="iconic" dimension="0"/>
<par name="SegmentedTablets_LineSpecific" base_type="iconic" dimension="0"/>
</io>
<oo>
<par name="Tablet_Individual_Concat" base_type="iconic" dimension="0"/>
<par name="ObjectsCrossingROIBorder_Concat" base_type="iconic" dimension="0"/>
</oo>
<ic>
<par name="Feature_Active" base_type="ctrl" dimension="0"/>
<par name="TabletLength_Average" base_type="ctrl" dimension="0"/>
<par name="SegmentationThreshold" base_type="ctrl" dimension="0"/>
<par name="TransportDirectionHorizontalOrVertical" base_type="ctrl" dimension="0"/>
<par name="IndexRinnenUndEjects" base_type="ctrl" dimension="0"/>
<par name="ProductSplittingMode" base_type="ctrl" dimension="0"/>
<par name="PreprocessingOpeningWidth" base_type="ctrl" dimension="0"/>
<par name="PreprocessingOpeningHeight" base_type="ctrl" dimension="0"/>
<par name="PreprocessingMinAreaFilter" base_type="ctrl" dimension="0"/>
<par name="ProductSplittingMode1_SeperationThreshold" base_type="ctrl" dimension="0"/>
</ic>
<oc>
<par name="TimeNeeded" base_type="ctrl" dimension="0"/>
</oc>
</interface>
<body>
<l>count_seconds (Seconds_Start)</l>
<l>gen_empty_obj (Tablet_Individual_Concat)</l>
<l>gen_empty_obj (OutputRegion)</l>
<l>gen_empty_obj (ObjectsCrossingROIBorder_Concat)</l>
<c></c>
<c>* </c>
<l>RemoveObjectsOnBorder_Aggregated := 0</l>
<c></c>
<c></c>
<l>if (Feature_Active)</l>
<l>    count_obj (RinnenROIs, NumberOfObjectsToProcessParallel)</l>
<l>    for Index := 0 to NumberOfObjectsToProcessParallel-1 by 1</l>
<c>        * there is at least one object for the processing</c>
<l>        select_obj (RinnenROIs, RinnenROI_Selected, Index+1)</l>
<l>        intersection (RinnenROI_Selected, SegmentedTablets_LineSpecific, Tablets_OneLine)</l>
<l>        gSplitSegmentedObjectsIntoSingleTablets (Tablets_OneLine, ImageOrig, Tablet_Individual_Concat, RinnenROI_Selected, OutputRegion1, ObjectsCrossingROIBorder, TransportDirectionHorizontalOrVertical, TabletLength_Average, ProductSplittingMode, PreprocessingOpeningWidth, PreprocessingOpeningHeight, PreprocessingMinAreaFilter, ProductSplittingMode1_SeperationThreshold, RemoveObjectsOnBorder_Aggregated, Time_Needed_SplittingTablets_PerROI)</l>
<l>        concat_obj (OutputRegion, OutputRegion1, OutputRegion)</l>
<l>        concat_obj (ObjectsCrossingROIBorder_Concat, ObjectsCrossingROIBorder, ObjectsCrossingROIBorder_Concat)</l>
<l>    endfor</l>
<c>    </c>
<l>    if (RemoveObjectsOnBorder_Aggregated) // remove border objects here or in gSplitSegmentedObjectsIntoSingleTablets</l>
<l>        gRemoveRegionsThatCrossTheBorder_1 (RinnenROIs, OutputRegion, ImageOrig, OutputRegion, ObjectsCrossingROIBorder_Concat, TabletLength_Average, 1)</l>
<l>    endif</l>
<l>else</l>
<l>    OutputRegion := SegmentedTablets_LineSpecific</l>
<l>endif</l>
<c>* remove empty regions</c>
<l>select_shape (OutputRegion, Tablet_Individual_Concat, 'area', 'and', 1, 99999999)</l>
<l>count_seconds (Seconds_End)</l>
<l>TimeNeeded := (Seconds_End - Seconds_Start) * 1000</l>
<c></c>
<l>return ()</l>
</body>
<docu id="gSplitIntoSingleTablets">
<parameters>
<parameter id="Feature_Active"/>
<parameter id="ImageOrig"/>
<parameter id="IndexRinnenUndEjects"/>
<parameter id="ObjectsCrossingROIBorder_Concat"/>
<parameter id="PreprocessingMinAreaFilter"/>
<parameter id="PreprocessingOpeningHeight"/>
<parameter id="PreprocessingOpeningWidth"/>
<parameter id="ProductSplittingMode"/>
<parameter id="ProductSplittingMode1_SeperationThreshold"/>
<parameter id="RinnenROIs"/>
<parameter id="SegmentationThreshold"/>
<parameter id="SegmentedTablets_LineSpecific"/>
<parameter id="TabletLength_Average"/>
<parameter id="Tablet_Individual_Concat"/>
<parameter id="TimeNeeded"/>
<parameter id="TransportDirectionHorizontalOrVertical"/>
</parameters>
</docu>
</procedure>
<procedure name="gSplitSegmentedObjectsIntoSingleTablets">
<interface>
<io>
<par name="Tablet_Segmentation" base_type="iconic" dimension="0"/>
<par name="ImageOrig" base_type="iconic" dimension="0"/>
<par name="Tablet_Individual_Concat" base_type="iconic" dimension="0"/>
<par name="RinnenROIs_Union" base_type="iconic" dimension="0"/>
</io>
<oo>
<par name="Tablet_Individual_ConcatOut" base_type="iconic" dimension="0"/>
<par name="ObjectsCrossingROIBorder" base_type="iconic" dimension="0"/>
</oo>
<ic>
<par name="TransportDirectionHorizontalOrVertical" base_type="ctrl" dimension="0"/>
<par name="TabletLength_Average" base_type="ctrl" dimension="0"/>
<par name="ProductSplittingMode" base_type="ctrl" dimension="0"/>
<par name="PreprocessingOpeningWidth" base_type="ctrl" dimension="0"/>
<par name="PreprocessingOpeningHeight" base_type="ctrl" dimension="0"/>
<par name="PreprocessingMinAreaFilter" base_type="ctrl" dimension="0"/>
<par name="ProductSplittingMode1_SeperationThreshold" base_type="ctrl" dimension="0"/>
<par name="RemoveObjectsOnBorder_Aggregated" base_type="ctrl" dimension="0"/>
</ic>
<oc>
<par name="Time_Needed" base_type="ctrl" dimension="0"/>
</oc>
</interface>
<body>
<c>* There are 3 Splitting mode levels:</c>
<c>* "1" uses distance transform and remove objects on border directly</c>
<c>* "0" uses partitioning and cut objects on border based on projection</c>
<c>* "-1" uses no partitioning and removes objects on border directly</c>
<l>count_seconds (Seconds_Start)</l>
<c></c>
<l>Tablet_Individual_ConcatOut := Tablet_Individual_Concat</l>
<l>Tablet_SegmentationOut := Tablet_Segmentation</l>
<c></c>
<c>* do some morphological filtering</c>
<l>if ((PreprocessingOpeningWidth &gt; 0) and (PreprocessingOpeningHeight # 0))</l>
<l>    opening_rectangle1 (Tablet_SegmentationOut, Tablet_SegmentationOut, PreprocessingOpeningWidth, PreprocessingOpeningHeight)</l>
<l>endif</l>
<c></c>
<l>PreprocessingClosingWidth := 22</l>
<l>if(PreprocessingClosingWidth &gt; 0)</l>
<l>    closing_circle (Tablet_SegmentationOut, Tablet_SegmentationOut, 4)</l>
<l>*     closing_rectangle1 (Tablet_SegmentationOut, Tablet_SegmentationOut, PreprocessingClosingWidth, PreprocessingClosingWidth)</l>
<l>endif</l>
<c></c>
<l>PreprocessingFillUpArea := 600</l>
<l>if(PreprocessingFillUpArea &gt; 0)</l>
<l>    fill_up_shape (Tablet_SegmentationOut, Tablet_SegmentationOut, 'area', 1, PreprocessingFillUpArea)</l>
<l>endif</l>
<c></c>
<l>connection (Tablet_SegmentationOut, Tablet_SegmentationOut)</l>
<l>select_shape (Tablet_SegmentationOut, Tablet_SegmentationOut, 'area', 'and', PreprocessingMinAreaFilter, 99999999)</l>
<c></c>
<l>if (ProductSplittingMode = -1) // * "-1" uses no partitioning and removes objects on border directly</l>
<c>    * do nothing and go directly to removal of border objects</c>
<l>    Tablet_Individual_ConcatOut := Tablet_SegmentationOut</l>
<l>else</l>
<l>    if (ProductSplittingMode&gt;=1) // * "1" uses distance transform and remove objects on border directly</l>
<l>        gDistanceTransformRegionSeperation (Tablet_SegmentationOut, ImageOrig, Tablet_Individual_ConcatOut, ProductSplittingMode1_SeperationThreshold, ContinueOutside, Time_Needed)</l>
<l>        select_shape (Tablet_Individual_ConcatOut, Tablet_Individual_ConcatOut, 'area', 'and', PreprocessingMinAreaFilter, 99999999)</l>
<l>        gHorizontalRelationOfRegions (Tablet_Individual_ConcatOut, Tablet_Individual_ConcatOut, RegionsInRelation_Vector)</l>
<l>    else //* "0" uses partitioning and cut objects on border based on projection</l>
<c>        * Mode via partition dynamic</c>
<c>        * Try to Segment every individual Tablet if product stream is horizontal</c>
<l>        if (TransportDirectionHorizontalOrVertical = 'horizontal')</l>
<l>            set_system ('clip_region', 'false')</l>
<l>            get_image_size (ImageOrig, Width, Height)</l>
<l>            hom_mat2d_identity (HomMat)</l>
<l>            hom_mat2d_identity (HomMat2DIdentity)</l>
<l>            hom_mat2d_rotate (HomMat2DIdentity, rad(90), Height/2, Width/2, HomMat2DRotate)</l>
<l>            affine_trans_region (Tablet_SegmentationOut, Tablet_SegmentationOut, HomMat2DRotate, 'nearest_neighbor')</l>
<l>        endif  </l>
<l>        partition_dynamic (Tablet_SegmentationOut, Tablet_Individual, TabletLength_Average, 30) // worked before with good results</l>
<l>*         partition_dynamic (Tablet_SegmentationOut, Tablet_Individual, TabletLength_Average, 55)</l>
<c>        </c>
<l>        if (TransportDirectionHorizontalOrVertical = 'horizontal')</l>
<l>            hom_mat2d_identity (HomMat2DIdentity)</l>
<l>            hom_mat2d_rotate (HomMat2DIdentity, rad(-90), Height/2, Width/2, HomMat2DRotate)</l>
<l>            affine_trans_region (Tablet_Individual, Tablet_Individual, HomMat2DRotate, 'nearest_neighbor')</l>
<l>            set_system ('clip_region', 'true')</l>
<l>        endif</l>
<c>        * </c>
<l>        fill_up (Tablet_Individual, Tablet_Individual)</l>
<l>        concat_obj (Tablet_Individual_ConcatOut, Tablet_Individual, Tablet_Individual_ConcatOut)</l>
<c>        </c>
<c>        *ToDo - reuniting can only reunite thre parts to one by running it two times in a row. this is not effective. It could be better to have a table to check what comnpnents should be merged and select it</c>
<l>*         gReuniteObjectsThatHaveBeenDevidedInSegmentation (Tablet_Individual_ConcatOut, Tablet_Individual_ConcatOut, FurtherReunionStepNecessary)</l>
<l>        gReuniteObjectsThatHaveBeenDevidedInSegmentation (Tablet_Individual_ConcatOut, Tablet_Individual_ConcatOut, FurtherReunionStepNecessary)</l>
<l>    endif</l>
<l>endif</l>
<c>* </c>
<l>if (RemoveObjectsOnBorder_Aggregated = 0)</l>
<l>    gRemoveRegionsThatCrossTheBorder_1 (RinnenROIs_Union, Tablet_Individual_ConcatOut, ImageOrig, Tablet_Individual_ConcatOut, ObjectsCrossingROIBorder, TabletLength_Average, 1)</l>
<l>else</l>
<l>    gen_empty_obj (ObjectsCrossingROIBorder)</l>
<l>endif</l>
<c></c>
<l>count_seconds (Seconds_End)</l>
<l>Time_Needed := (Seconds_End- Seconds_Start) * 1000</l>
<l>return ()</l>
</body>
<docu id="gSplitSegmentedObjectsIntoSingleTablets">
<parameters>
<parameter id="ImageOrig"/>
<parameter id="ObjectsCrossingROIBorder"/>
<parameter id="PreprocessingMinAreaFilter"/>
<parameter id="PreprocessingOpeningHeight"/>
<parameter id="PreprocessingOpeningWidth"/>
<parameter id="ProductSplittingMode"/>
<parameter id="ProductSplittingMode1_SeperationThreshold"/>
<parameter id="RemoveObjectsOnBorder_Aggregated"/>
<parameter id="RinnenROIs_Union"/>
<parameter id="TabletLength_Average"/>
<parameter id="Tablet_Individual_Concat"/>
<parameter id="Tablet_Individual_ConcatOut"/>
<parameter id="Tablet_Segmentation"/>
<parameter id="Time_Needed"/>
<parameter id="TransportDirectionHorizontalOrVertical"/>
</parameters>
</docu>
</procedure>
<procedure name="gSpotDetection_ShrinkRegion">
<interface>
<io>
<par name="Tablet_Individual" base_type="iconic" dimension="0"/>
</io>
<oo>
<par name="Tablet_Individual_Out" base_type="iconic" dimension="0"/>
</oo>
<ic>
<par name="DetectionOffsetFromProductSide_Horizontal" base_type="ctrl" dimension="0"/>
<par name="TabletSpot_ErosionFilterSegmentedProductOuterHull" base_type="ctrl" dimension="0"/>
</ic>
</interface>
<body>
<l>Tablet_Individual_Out := Tablet_Individual</l>
<c>* crop the sides- useful in case of non stable product sides or irritating reflections on transparent products </c>
<l>if (DetectionOffsetFromProductSide_Horizontal &gt; 0) </l>
<l>    gen_empty_obj (Tablet_Individual_Out)</l>
<l>    count_obj (Tablet_Individual, Tablet_Individual_Number)</l>
<l>    for IndexCnt := 0 to Tablet_Individual_Number-1 by 1        // iterate through all regions. If the products are too close and e.g. round the rectangles that should only cut the sides will poentially cut areas of nearby other products</l>
<l>        select_obj (Tablet_Individual, Tablet_Individual_Selected, IndexCnt+1)</l>
<l>        smallest_rectangle1 (Tablet_Individual_Selected, Tablet_Individual_Selected_Row1, Tablet_Individual_Selected_Column1, Tablet_Individual_Selected_Row2, Tablet_Individual_Selected_Column2)</l>
<l>        gen_rectangle1 (CutOffRect, [Tablet_Individual_Selected_Row1, Tablet_Individual_Selected_Row1], [Tablet_Individual_Selected_Column1, (Tablet_Individual_Selected_Column2 - DetectionOffsetFromProductSide_Horizontal)], [Tablet_Individual_Selected_Row2, Tablet_Individual_Selected_Row2], [(Tablet_Individual_Selected_Column1 + DetectionOffsetFromProductSide_Horizontal), Tablet_Individual_Selected_Column2])</l>
<l>        difference (Tablet_Individual_Selected, CutOffRect, Tablet_Individual_Selected_CutOff)</l>
<l>        concat_obj (Tablet_Individual_Out, Tablet_Individual_Selected_CutOff, Tablet_Individual_Out)   </l>
<l>    endfor   </l>
<l>endif</l>
<c>* thin the product - in case the outer areas are a bit fuzzy inspect closer to the inside of the product</c>
<l>if (TabletSpot_ErosionFilterSegmentedProductOuterHull &gt; 0) </l>
<l>    erosion_rectangle1 (Tablet_Individual_Out, Tablet_Individual_Out, 1, TabletSpot_ErosionFilterSegmentedProductOuterHull)</l>
<l>endif</l>
<l>return ()</l>
</body>
<docu id="gSpotDetection_ShrinkRegion">
<parameters>
<parameter id="DetectionOffsetFromProductSide_Horizontal"/>
<parameter id="TabletSpot_ErosionFilterSegmentedProductOuterHull"/>
<parameter id="Tablet_Individual"/>
<parameter id="Tablet_Individual_Out"/>
</parameters>
</docu>
</procedure>
<procedure name="gSwitchOptionEjectToMachineSignal">
<interface>
<ic>
<par name="VTShiftregister_In" base_type="ctrl" dimension="1"/>
<par name="VTCamera_In" base_type="ctrl" dimension="1"/>
</ic>
<oc>
<par name="VTShiftregister_Out" base_type="ctrl" dimension="1"/>
<par name="ROIOffset" base_type="ctrl" dimension="0"/>
</oc>
</interface>
<body>
<c>* additional logic to have mode eject and signal to external machine switchable</c>
<c></c>
<l>VTShiftregister_Out := VTShiftregister_In</l>
<l>ROIOffset := 0</l>
<l>gGetSubObjectVariables (VTCamera_In, '/General/V_Camera_UseCameraIOsAsDirectEjectSignals/Value', temp)</l>
<l>Camera_UseCameraIOsAsDirectEjectSignals := temp.at(0)[1]</l>
<l>if(Camera_UseCameraIOsAsDirectEjectSignals = 1)</l>
<c>    * debug - just to check current value</c>
<l>*     gGetSubObjectVariables (VTShiftregister_In, '/MovementCompensation/V_Active/Value', temp)</l>
<l>*     MovementCompensation := temp.at(0)[1]</l>
<c>    * switch movement compensation off</c>
<l>    VTShiftregister_Out.at(0)[1] := 0</l>
<c>    **********************</c>
<l>    gGetSubObjectVariables (VTShiftregister_In, '/V_Eject_FixedStopPositionForFastProducts_RelativeToROI/Value', temp)</l>
<l>    ROIOffset := temp.at(0)[1]</l>
<l>endif</l>
<l>return ()</l>
</body>
<docu id="gSwitchOptionEjectToMachineSignal">
<parameters>
<parameter id="ROIOffset"/>
<parameter id="VTCamera_In"/>
<parameter id="VTShiftregister_In"/>
<parameter id="VTShiftregister_Out"/>
</parameters>
</docu>
</procedure>
<procedure name="gTabletRegion_RemoveMirror">
<interface>
<io>
<par name="TabletRegionWithMirrors" base_type="iconic" dimension="0"/>
<par name="ColourImage" base_type="iconic" dimension="0"/>
</io>
<oo>
<par name="WatershedSegmentedObjects" base_type="iconic" dimension="0"/>
</oo>
<oc>
<par name="ContinueOutside" base_type="ctrl" dimension="0"/>
<par name="Seconds_Needed" base_type="ctrl" dimension="0"/>
</oc>
</interface>
<body>
<l>count_seconds (Seconds_Start)</l>
<c></c>
<c></c>
<c>* set up finer processing for small objects. low res processing is faster in watershed/distance transform</c>
<l>smallest_rectangle1 (TabletRegionWithMirrors, TabletRegionWithMirrors_Row1, _, TabletRegionWithMirrors_Row2, _)</l>
<l>ProductWidth := TabletRegionWithMirrors_Row2 - TabletRegionWithMirrors_Row1</l>
<l>if (ProductWidth &lt; 90)</l>
<l>    HighResolutionProcessingActive := 1</l>
<l>    ScaleFactor := 1</l>
<l>else</l>
<l>    HighResolutionProcessingActive := 0</l>
<l>    ScaleFactor := 0.5</l>
<l>endif</l>
<c></c>
<l>ContinueOutside := 0</l>
<c></c>
<l>gen_empty_obj (WatershedSegmentedObjects)</l>
<c>* </c>
<c>* close small fine holes </c>
<l>closing_circle (TabletRegionWithMirrors, TabletRegionWithMirrors, 2.5)</l>
<c></c>
<c>* prefiltering for a better segmentation of the middle tablet</c>
<l>erosion_circle (TabletRegionWithMirrors, TabletRegionWithMirrors_Processed, 2.0)</l>
<c></c>
<l>if (HighResolutionProcessingActive = 1) // supports better splitting of fine structures in mirror</l>
<l>    erosion_rectangle1 (TabletRegionWithMirrors_Processed, TabletRegionWithMirrors_Processed, 1, 11)</l>
<l>else</l>
<l>    erosion_rectangle1 (TabletRegionWithMirrors_Processed, TabletRegionWithMirrors_Processed, 1, 5)</l>
<l>endif</l>
<c></c>
<c>* For speeding up the process the regin can be scaled</c>
<l>if (ScaleFactor # 1)</l>
<l>    zoom_region (TabletRegionWithMirrors_Processed, TabletRegionWithMirrors_Processed, ScaleFactor, ScaleFactor)</l>
<l>endif</l>
<c>* </c>
<c>* </c>
<l>area_center (TabletRegionWithMirrors_Processed, Area, _, _)</l>
<l>if (Area = [] or Area = 0)</l>
<l>    ContinueOutside := 1</l>
<l>else</l>
<l>    smallest_rectangle1 (TabletRegionWithMirrors_Processed, Row1, Column1, Row2, Column2)</l>
<c>    * </c>
<l>    move_region (TabletRegionWithMirrors_Processed, TabletRegionWithMirrors_Moved, -Row1 +5, -Column1 +5)</l>
<l>    copy_obj (TabletRegionWithMirrors_Moved, WithoutFillUp, 1, -1)</l>
<l>    fill_up (TabletRegionWithMirrors_Moved, TabletRegionWithMirrors_Moved)</l>
<l>    HeightRegion := Row2-Row1</l>
<l>    WidthRegion := Column2-Column1</l>
<l>    distance_transform (TabletRegionWithMirrors_Moved, DistanceImage, 'octagonal', 'true', WidthRegion +10, HeightRegion +10)</l>
<l>    convert_image_type (DistanceImage, DistanceImageByte, 'byte')</l>
<l>    invert_image (DistanceImageByte, DistanceImageInv)</l>
<l>    scale_image_max (DistanceImageInv, DistanceImageInvScaled)</l>
<c>    </c>
<c>    * set watershed threshold smaller for small objects. necessary due to the gap between object and mirroring is not so distinct</c>
<l>    if (HighResolutionProcessingActive = 1)</l>
<l>        watersheds_threshold (DistanceImageInv, Basins, 4)</l>
<l>    else</l>
<l>        watersheds_threshold (DistanceImageInv, Basins, 7)</l>
<l>    endif</l>
<c>    </c>
<l>    intersection (Basins, WithoutFillUp, WatershedSegmentedObjects)</l>
<l>    move_region (WatershedSegmentedObjects, WatershedSegmentedObjects, Row1 -5, Column1 -5)</l>
<c>    * </c>
<l>    area_center (WatershedSegmentedObjects, AreaConnectedIndividualTablet, _, _)</l>
<l>    tuple_sort_index (-AreaConnectedIndividualTablet, Indices)</l>
<l>    if (AreaConnectedIndividualTablet = 0 or AreaConnectedIndividualTablet = [])</l>
<l>        ContinueOutside := 1</l>
<l>    else</l>
<l>        ToChoose := Indices[0]</l>
<l>        select_obj (WatershedSegmentedObjects, WatershedSegmentedObjects, ToChoose+1)</l>
<l>    endif</l>
<l>endif</l>
<c>* </c>
<c>* For speeding up the process the scaling was done- here the inversion to get original szed regions again</c>
<l>if (ScaleFactor # 1)</l>
<l>    zoom_region (WatershedSegmentedObjects, WatershedSegmentedObjects, 1/ScaleFactor, 1/ScaleFactor)</l>
<l>endif</l>
<c>* </c>
<l>UnitingObjects := 0</l>
<l>if (UnitingObjects = 1)</l>
<c>    * reunite the middle parts in case a tablet has a stripe through it</c>
<l>    smallest_rectangle1 (TabletRegionWithMirrors, RegionWithAllMirrors_Row1, RegionWithAllMirrors_Column1, RegionWithAllMirrors_Row2, RegionWithAllMirrors_Column2)</l>
<l>    smallest_rectangle1 (WatershedSegmentedObjects, WatershedSegmentedObjects_Row1, WatershedSegmentedObjects_Column1, WatershedSegmentedObjects_Row2, WatershedSegmentedObjects_Column2)</l>
<l>    MiddlePoint_Row := (RegionWithAllMirrors_Row2 -RegionWithAllMirrors_Row1)/2 + RegionWithAllMirrors_Row1</l>
<l>    MiddlePoint_Column := (WatershedSegmentedObjects_Column2-WatershedSegmentedObjects_Column1)/2 + WatershedSegmentedObjects_Column1</l>
<l>    RadiusOffset := 15</l>
<l>    Radius2 := ((RegionWithAllMirrors_Row2 -RegionWithAllMirrors_Row1)/2)-RadiusOffset</l>
<l>    Radius1 := ((WatershedSegmentedObjects_Column2-WatershedSegmentedObjects_Column1)/2) -RadiusOffset</l>
<l>    if (Radius1 &gt; 0 and Radius2 &gt; 0)</l>
<l>        gen_ellipse (UnitingRegion, MiddlePoint_Row, MiddlePoint_Column, 0, Radius1, Radius2)</l>
<l>        intersection (WatershedSegmentedObjects, UnitingRegion, RegionIntersection)</l>
<l>        gElementwiseComparisonTestRegionIndex_3 (UnitingRegion, WatershedSegmentedObjects, WatershedSegmentedObjects, IndexOfAllRegionsWithPartlyIntersection, NumberOfObjects)</l>
<l>        union1 (WatershedSegmentedObjects, WatershedSegmentedObjects)</l>
<l>    endif</l>
<l>endif</l>
<c>* </c>
<c>* </c>
<c>* reconstruction with a bit of filtering</c>
<l>* dilation_rectangle1 (WatershedSegmentedObjects, WatershedSegmentedObjects, 1, 5)</l>
<l>* dilation_circle (WatershedSegmentedObjects, WatershedSegmentedObjects, 2.5)</l>
<c>* </c>
<l>connection (WatershedSegmentedObjects, WatershedSegmentedObjects)</l>
<l>select_shape (WatershedSegmentedObjects, WatershedSegmentedObjects, 'area', 'and', 10, 99999999)</l>
<l>union1 (WatershedSegmentedObjects, WatershedSegmentedObjects)</l>
<l>count_seconds (Seconds_End)</l>
<l>Seconds_Needed := (Seconds_End- Seconds_Start) * 1000</l>
<l>return ()</l>
</body>
<docu id="gTabletRegion_RemoveMirror">
<parameters>
<parameter id="ColourImage"/>
<parameter id="ContinueOutside"/>
<parameter id="Seconds_Needed"/>
<parameter id="TabletRegionWithMirrors"/>
<parameter id="WatershedSegmentedObjects"/>
</parameters>
</docu>
</procedure>
<procedure name="gTeachIn_PrepareTupleDataForStringExportWithComma">
<interface>
<ic>
<par name="capsuleVerticalExtension" base_type="ctrl" dimension="0"/>
</ic>
<oc>
<par name="capsuleVerticalExtensionKomma" base_type="ctrl" dimension="0"/>
</oc>
</interface>
<body>
<l>tuple_string(capsuleVerticalExtension, '10.3f', capsuleVerticalExtensionString)</l>
<l>tuple_regexp_replace (capsuleVerticalExtensionString, '(.*)\\.(.*)$', '$1,$2', capsuleVerticalExtensionKomma)</l>
<l>return ()</l>
</body>
<docu id="gTeachIn_PrepareTupleDataForStringExportWithComma">
<parameters>
<parameter id="capsuleVerticalExtension"/>
<parameter id="capsuleVerticalExtensionKomma"/>
</parameters>
</docu>
</procedure>
<procedure name="gTeachIn_WriteMSA_Data">
<interface>
<ic>
<par name="Calibration_AllDataCollected" base_type="ctrl" dimension="0"/>
<par name="FilenameForDataExport" base_type="ctrl" dimension="0"/>
</ic>
</interface>
<body>
<c></c>
<l>gTeachIn_PrepareTupleDataForStringExportWithComma (Calibration_AllDataCollected, Calibration_AllDataCollected_Comma)</l>
<l>tuple_insert (Calibration_AllDataCollected_Comma, 0, FilenameForDataExport, Calibration_AllDataCollected_Comma)</l>
<l>Calibration_AllDataCollected_Comma := Calibration_AllDataCollected_Comma + '\n'</l>
<l>open_file (FilenameForDataExport, 'output', FileHandle)</l>
<l>fwrite_string (FileHandle, Calibration_AllDataCollected_Comma)    </l>
<l>close_file (FileHandle)</l>
<l>return ()</l>
</body>
<docu id="gTeachIn_WriteMSA_Data">
<parameters>
<parameter id="Calibration_AllDataCollected"/>
<parameter id="FilenameForDataExport"/>
</parameters>
</docu>
</procedure>
<procedure name="gThresholdForThreading">
<interface>
<io>
<par name="ImageOneChannel" base_type="iconic" dimension="0"/>
<par name="RegionToOperatorOn" base_type="iconic" dimension="0"/>
</io>
<oo>
<par name="ThresholdRegion" base_type="iconic" dimension="0"/>
</oo>
<ic>
<par name="MinGray" base_type="ctrl" dimension="0"/>
</ic>
</interface>
<body>
<l>reduce_domain (ImageOneChannel, RegionToOperatorOn, Red_Reduced)</l>
<l>fast_threshold (Red_Reduced, ThresholdRegion, MinGray, 255, 5)</l>
<l>return ()</l>
</body>
<docu id="gThresholdForThreading">
<parameters>
<parameter id="ImageOneChannel"/>
<parameter id="MinGray"/>
<parameter id="RegionToOperatorOn"/>
<parameter id="ThresholdRegion"/>
</parameters>
</docu>
</procedure>
<procedure name="gTilePartimagesToOneVisuimage">
<interface>
<io>
<par name="PartimagesVector" base_type="iconic" dimension="1"/>
</io>
<oo>
<par name="OneImage" base_type="iconic" dimension="0"/>
</oo>
</interface>
<body>
<c>* </c>
<l>NumberOfPartimagesInVector := PartimagesVector.length()</l>
<l>gen_empty_obj (PartimagesROIs)</l>
<l>gen_empty_obj (PartimagesConcat)</l>
<c>* </c>
<l>for Index := 0 to NumberOfPartimagesInVector-1 by 1</l>
<l>    get_domain (PartimagesVector.at(Index), Domain)</l>
<l>    concat_obj (PartimagesROIs, Domain, PartimagesROIs)</l>
<c>    * </c>
<l>    crop_domain (PartimagesVector.at(Index), ImagePart)</l>
<l>    concat_obj (PartimagesConcat, ImagePart, PartimagesConcat)</l>
<l>endfor</l>
<l>smallest_rectangle1 (PartimagesROIs, Row1, Column1, Row2, Column2)</l>
<l>tuple_length (Row1, Length)</l>
<l>tuple_gen_const (Length, -1, TupleZero)</l>
<l>get_image_size (PartimagesVector.at(0), Width, Height)</l>
<c>* </c>
<l>tile_images_offset (PartimagesConcat, OneImage, Row1, Column1, TupleZero, TupleZero, TupleZero, TupleZero, Width, Height)</l>
<c>* </c>
<l>return ()</l>
</body>
<docu id="gTilePartimagesToOneVisuimage">
<parameters>
<parameter id="OneImage"/>
<parameter id="PartimagesVector"/>
</parameters>
</docu>
</procedure>
<procedure name="gtuple_remove_doubletts">
<interface>
<ic>
<par name="Inputtuple" base_type="ctrl" dimension="0"/>
<par name="ShouldCalculateMax" base_type="ctrl" dimension="0"/>
</ic>
<oc>
<par name="Outputtuple" base_type="ctrl" dimension="0"/>
<par name="FoundMaxvalue" base_type="ctrl" dimension="0"/>
</oc>
</interface>
<body>
<c>* remove doubles in tuple and determine max value</c>
<l>tuple_sort (Inputtuple, Inputtuple)</l>
<l>tuple_uniq (Inputtuple, Outputtuple)</l>
<c></c>
<l>FoundMaxvalue:=[]</l>
<c></c>
<l>if (Outputtuple # [] and ShouldCalculateMax = 1)</l>
<l>    tuple_max (Outputtuple, FoundMaxvalue)</l>
<l>endif</l>
<c></c>
<c></c>
<c>* old code doing roughly the same but slower</c>
<l>* tuple_length (Inputtuple, Length)</l>
<l>* tuple_sort (Inputtuple, Sorted)</l>
<c></c>
<l>* Outputtuple := []</l>
<l>* WasAlreadySetToOutput := []</l>
<l>* for Index := 0 to Length-1 by 1   </l>
<l>*     ValueToCheck := Sorted[Index]</l>
<l>*     if (ValueToCheck # WasAlreadySetToOutput)</l>
<l>*         tuple_concat (Outputtuple, ValueToCheck, Outputtuple)</l>
<l>*         WasAlreadySetToOutput := ValueToCheck</l>
<l>*     endif</l>
<l>* endfor</l>
<l>return ()</l>
</body>
<docu id="gtuple_remove_doubletts">
<parameters>
<parameter id="FoundMaxvalue"/>
<parameter id="Inputtuple"/>
<parameter id="Outputtuple"/>
<parameter id="ShouldCalculateMax"/>
</parameters>
</docu>
</procedure>
<procedure name="gTupleAdd_IfParameterActive">
<interface>
<ic>
<par name="Activate_Add" base_type="ctrl" dimension="0"/>
<par name="ValueToAdd" base_type="ctrl" dimension="0"/>
<par name="TupleToAddTo" base_type="ctrl" dimension="0"/>
</ic>
<oc>
<par name="TupleToAddTo_Out" base_type="ctrl" dimension="0"/>
</oc>
</interface>
<body>
<l>TupleToAddTo_Out := TupleToAddTo</l>
<c></c>
<l>if (Activate_Add = 1)</l>
<l>    TupleToAddTo_Out := [TupleToAddTo_Out,ValueToAdd]</l>
<l>endif</l>
<l>return ()</l>
</body>
<docu id="gTupleAdd_IfParameterActive">
<parameters>
<parameter id="Activate_Add"/>
<parameter id="TupleToAddTo"/>
<parameter id="TupleToAddTo_Out"/>
<parameter id="ValueToAdd"/>
</parameters>
</docu>
</procedure>
<procedure name="gVisu_Error_SpecificToFeature">
<interface>
<io>
<par name="ErrorObject" base_type="iconic" dimension="0"/>
</io>
<oo>
<par name="ErrorVisualization" base_type="iconic" dimension="0"/>
</oo>
<ic>
<par name="FeatureToVisualize" base_type="ctrl" dimension="0"/>
</ic>
</interface>
<body>
<l>gen_empty_obj (ErrorVisualization)</l>
<c> </c>
<c>**** feature width</c>
<l>if (FeatureToVisualize = 'Width')</l>
<l>    smallest_rectangle1 (ErrorObject, ErrorObject_Row1, ErrorObject_Column1, ErrorObject_Row2, ErrorObject_Column2)</l>
<l>    if (ErrorObject_Row1 # []) // something to visualize</l>
<l>        VisuExtension := 10  </l>
<l>        tuple_length (ErrorObject_Row1, ErrorObject_Length)  </l>
<l>        for Index_Length := 0 to ErrorObject_Length-1 by 1</l>
<l>            Row1 := ErrorObject_Row1[Index_Length]</l>
<l>            Row2 := ErrorObject_Row2[Index_Length]</l>
<l>            Column1 := ErrorObject_Column1[Index_Length]</l>
<l>            Column2 := ErrorObject_Column2[Index_Length]</l>
<l>            gen_empty_obj (TempVisu_MeasuredRegions)</l>
<c>            * snippet to have the visu created in 3 steps</c>
<l>            gen_region_line (RegionLines, [Row1,Row2], [Column1,Column1], [Row1,Row2], [Column2,Column2])</l>
<l>            concat_obj (TempVisu_MeasuredRegions, RegionLines, TempVisu_MeasuredRegions)</l>
<l>            gen_region_line (RegionLines, [Row1,Row1], [Column1,Column2], [Row1+VisuExtension,Row1+VisuExtension], [Column1,Column2])</l>
<l>            concat_obj (TempVisu_MeasuredRegions, RegionLines, TempVisu_MeasuredRegions)</l>
<l>            gen_region_line (RegionLines, [Row2,Row2], [Column1,Column2], [Row2-VisuExtension,Row2-VisuExtension], [Column1,Column2])</l>
<l>            concat_obj (TempVisu_MeasuredRegions, RegionLines, TempVisu_MeasuredRegions)</l>
<l>            union1 (TempVisu_MeasuredRegions, TempVisu_MeasuredRegions)   </l>
<l>            concat_obj (ErrorVisualization, TempVisu_MeasuredRegions, ErrorVisualization)</l>
<l>        endfor  </l>
<l>    endif</l>
<l>endif</l>
<c></c>
<c></c>
<c>**** feature length</c>
<l>if (FeatureToVisualize = 'Length')</l>
<l>    smallest_rectangle1 (ErrorObject, ErrorObject_Row1, ErrorObject_Column1, ErrorObject_Row2, ErrorObject_Column2)</l>
<l>    if (ErrorObject_Row1 # []) // something to visualize</l>
<l>        VisuExtension := 10  </l>
<l>        tuple_length (ErrorObject_Row1, ErrorObject_Length)  </l>
<l>        for Index_Length := 0 to ErrorObject_Length-1 by 1</l>
<l>            Row1 := ErrorObject_Row1[Index_Length]</l>
<l>            Row2 := ErrorObject_Row2[Index_Length]</l>
<l>            Column1 := ErrorObject_Column1[Index_Length]</l>
<l>            Column2 := ErrorObject_Column2[Index_Length]</l>
<l>            gen_empty_obj (TempVisu_MeasuredRegions)</l>
<l>            gen_region_line (RegionLines, [Row1,Row1], [Column1,Column2], [Row2,Row2], [Column1,Column2])</l>
<l>            concat_obj (TempVisu_MeasuredRegions, RegionLines, TempVisu_MeasuredRegions)</l>
<l>            gen_region_line (RegionLines, [Row1,Row2], [Column1,Column1], [Row1,Row2], [Column1+VisuExtension,Column1+VisuExtension])</l>
<l>            concat_obj (TempVisu_MeasuredRegions, RegionLines, TempVisu_MeasuredRegions)</l>
<l>            gen_region_line (RegionLines, [Row1,Row2], [Column2,Column2], [Row1,Row2], [Column2-VisuExtension,Column2-VisuExtension])</l>
<l>            concat_obj (TempVisu_MeasuredRegions, RegionLines, TempVisu_MeasuredRegions)</l>
<l>            union1 (TempVisu_MeasuredRegions, TempVisu_MeasuredRegions)     </l>
<l>            concat_obj (ErrorVisualization, TempVisu_MeasuredRegions, ErrorVisualization)</l>
<l>        endfor  </l>
<l>    endif</l>
<l>endif</l>
<c></c>
<c>**** feature diameter</c>
<l>if (FeatureToVisualize = 'Diameter')</l>
<l>    smallest_rectangle2 (ErrorObject, ErrorObject_Row1, ErrorObject_Column1, ErrorObject_Phi, ErrorObject_Length1, ErrorObject_Length2)</l>
<l>    if (ErrorObject_Row1 # []) // something to visualize</l>
<l>        tuple_length (ErrorObject_Row1, Length)  </l>
<l>        tuple_gen_const (Length, 0.785398, Phi)</l>
<l>        tuple_gen_const (Length, 40, Length1)            </l>
<l>        tuple_gen_const (Length, 1, Length2)</l>
<l>        gen_rectangle2 (ErrorVisualization, ErrorObject_Row1, ErrorObject_Column1, Phi, Length1, Length2)</l>
<l>    endif</l>
<l>endif</l>
<c></c>
<c></c>
<c>**** feature area</c>
<l>if (FeatureToVisualize = 'Area')</l>
<l>    smallest_rectangle2 (ErrorObject, ErrorObject_Row1, ErrorObject_Column1, ErrorObject_Phi, ErrorObject_Length1, ErrorObject_Length2)</l>
<l>    if (ErrorObject_Row1 # []) // something to visualize</l>
<l>        gen_ellipse (ErrorVisualization, ErrorObject_Row1, ErrorObject_Column1 - (ErrorObject_Length2) - ErrorObject_Length2/2 -5, ErrorObject_Phi, ErrorObject_Length1, ErrorObject_Length2/2)</l>
<l>    endif</l>
<l>endif</l>
<c></c>
<c>**** feature spots</c>
<l>if (FeatureToVisualize = 'Spots')</l>
<l>    ErrorVisualization := ErrorObject</l>
<l>endif</l>
<c></c>
<c></c>
<c>**** feature symmetry</c>
<l>if (FeatureToVisualize = 'Symmetry')</l>
<l>    ErrorVisualization := ErrorObject</l>
<l>endif</l>
<c></c>
<l>return ()</l>
</body>
<docu id="gVisu_Error_SpecificToFeature">
<parameters>
<parameter id="ErrorObject"/>
<parameter id="ErrorVisualization"/>
<parameter id="FeatureToVisualize"/>
</parameters>
</docu>
</procedure>
<procedure name="gVisualisation_AddStringToVisu">
<interface>
<ic>
<par name="ValueToAddIfExists" base_type="ctrl" dimension="0"/>
<par name="HumanReadableStringToAdd" base_type="ctrl" dimension="0"/>
<par name="WindowHandle" base_type="ctrl" dimension="0"/>
</ic>
</interface>
<body>
<c></c>
<l>if (ValueToAddIfExists # [])</l>
<l>    if(HumanReadableStringToAdd # [])</l>
<l>        write_string (WindowHandle, ' ' + HumanReadableStringToAdd + ': ')</l>
<l>    endif</l>
<l>    write_string (WindowHandle, ValueToAddIfExists)</l>
<l>    if(HumanReadableStringToAdd # [])</l>
<l>        new_line (WindowHandle)</l>
<l>    endif</l>
<l>endif</l>
<c></c>
<l>return ()</l>
</body>
<docu id="gVisualisation_AddStringToVisu">
<parameters>
<parameter id="HumanReadableStringToAdd"/>
<parameter id="ValueToAddIfExists"/>
<parameter id="WindowHandle"/>
</parameters>
</docu>
</procedure>
<procedure name="gVisualisationOfResults">
<interface>
<io>
<par name="ImageOrig" base_type="iconic" dimension="0"/>
<par name="ImageOrig_Sequencer_RGB" base_type="iconic" dimension="0"/>
<par name="RinnenROIs" base_type="iconic" dimension="0"/>
<par name="EjectROIs" base_type="iconic" dimension="0"/>
<par name="GoodObjectVector_TabletIndividual_WidthGood_ThreadVector" base_type="iconic" dimension="3"/>
<par name="ErrorObjectVector_Colour_Width_Diameter_Spots_Area_Length_ThreadVector" base_type="iconic" dimension="3"/>
</io>
<ic>
<par name="WindowHandle" base_type="ctrl" dimension="0"/>
<par name="Shiftregister_EjectFoundPerLine_Vector" base_type="ctrl" dimension="1"/>
<par name="Shiftregister_EjectGoodFoundPerLine_Vector" base_type="ctrl" dimension="1"/>
<par name="DevWindow0_NonDevWindow1" base_type="ctrl" dimension="0"/>
<par name="Shiftregister_EjectPositionMovementCompensationVector" base_type="ctrl" dimension="2"/>
<par name="ExternalHardware_ConveyorDriveSlowly" base_type="ctrl" dimension="0"/>
<par name="ShowSequencerImage" base_type="ctrl" dimension="0"/>
</ic>
<oc>
<par name="Time_Needed" base_type="ctrl" dimension="0"/>
</oc>
</interface>
<body>
<l>global tuple dict_InspectionVisualization</l>
<c></c>
<l>count_seconds (Seconds_Start)</l>
<c></c>
<c></c>
<c></c>
<l>SuppressBadProductVisualisationInEjectBox := dict_InspectionVisualization.V_SuppressBadProductVisualisationInEjectBox.Value</l>
<c></c>
<l>get_image_size (ImageOrig_Sequencer_RGB, ImageOrig_Sequencer_RGB_Width, _)</l>
<l>if ((ImageOrig_Sequencer_RGB_Width = [] or ImageOrig_Sequencer_RGB_Width = 0) or ShowSequencerImage = 0)</l>
<l>    decompose3 (ImageOrig, ImageHSV_H, ImageHSV_S, ImageHSV_V)</l>
<l>    trans_to_rgb (ImageHSV_H, ImageHSV_S, ImageHSV_V, ImageRGB_R, ImageRGB_G, ImageRGB_B, 'hsv')</l>
<l>    compose3 (ImageRGB_R, ImageRGB_G, ImageRGB_B, ImageOrig)</l>
<l>    ImageToDisplay := ImageOrig</l>
<l>else</l>
<l>    ImageToDisplay := ImageOrig_Sequencer_RGB</l>
<l>endif</l>
<c></c>
<l>gDisplayImageAndRegions_Local (ImageToDisplay, RinnenROIs, EjectROIs, DevWindow0_NonDevWindow1, WindowHandle)</l>
<c>* </c>
<c>* Visu of good and bad objects</c>
<l>gen_empty_obj (ErrorObject_Colour)</l>
<l>gen_empty_obj (ErrorObject_Width)</l>
<l>gen_empty_obj (ErrorObject_Length)</l>
<l>gen_empty_obj (ErrorObject_Spots)</l>
<l>gen_empty_obj (ErrorObject_Area)</l>
<l>gen_empty_obj (ErrorObject_Symmetry)</l>
<c></c>
<l>gen_empty_obj (TabletIndividual)</l>
<l>gen_empty_obj (GoodObject_Width)</l>
<c></c>
<c>* </c>
<c>* Have two loops for object reconstruction. The outer one loops through the processes data, the inner one through the lanes data</c>
<l>ThreadingVectorLength := ErrorObjectVector_Colour_Width_Diameter_Spots_Area_Length_ThreadVector.length()</l>
<l>for VectorIndex := 0 to ThreadingVectorLength-1 by 1</l>
<l>    ErrorObjectVector_Colour_Width_Diameter_Spots_Area_Length := ErrorObjectVector_Colour_Width_Diameter_Spots_Area_Length_ThreadVector.at(VectorIndex)</l>
<l>    GoodObjectVector_TabletIndividual_WidthGood := GoodObjectVector_TabletIndividual_WidthGood_ThreadVector.at(VectorIndex)</l>
<c>    * inner loop throug lanes data</c>
<l>    LanesVectorLength := ErrorObjectVector_Colour_Width_Diameter_Spots_Area_Length_ThreadVector.at(VectorIndex).length()</l>
<l>    for Index := 0 to LanesVectorLength-1 by 1</l>
<l>        concat_obj (ErrorObject_Colour, ErrorObjectVector_Colour_Width_Diameter_Spots_Area_Length.at(Index).at(0), ErrorObject_Colour)</l>
<l>        concat_obj (ErrorObject_Width, ErrorObjectVector_Colour_Width_Diameter_Spots_Area_Length.at(Index).at(1), ErrorObject_Width)</l>
<l>*         concat_obj (ErrorObject_Diameter, ErrorObjectVector_Colour_Width_Diameter_Spots_Area_Length.at(Index).at(2), ErrorObject_Diameter)</l>
<l>        concat_obj (ErrorObject_Spots, ErrorObjectVector_Colour_Width_Diameter_Spots_Area_Length.at(Index).at(3), ErrorObject_Spots)</l>
<l>        concat_obj (ErrorObject_Area, ErrorObjectVector_Colour_Width_Diameter_Spots_Area_Length.at(Index).at(4), ErrorObject_Area)</l>
<l>        concat_obj (ErrorObject_Length, ErrorObjectVector_Colour_Width_Diameter_Spots_Area_Length.at(Index).at(5), ErrorObject_Length)</l>
<l>        concat_obj (ErrorObject_Symmetry, ErrorObjectVector_Colour_Width_Diameter_Spots_Area_Length.at(Index).at(6), ErrorObject_Symmetry)</l>
<c></c>
<l>        concat_obj (TabletIndividual, GoodObjectVector_TabletIndividual_WidthGood.at(Index).at(0), TabletIndividual)</l>
<l>        concat_obj (GoodObject_Width, GoodObjectVector_TabletIndividual_WidthGood.at(Index).at(1), GoodObject_Width)</l>
<l>    endfor</l>
<l>endfor</l>
<c>* </c>
<c>* </c>
<c>* temporary helper visu</c>
<l>if (DevWindow0_NonDevWindow1 = 0)</l>
<l>    dev_set_color ('light gray')</l>
<l>    dev_display (TabletIndividual)</l>
<l>else</l>
<l>    set_color (WindowHandle, 'dim gray')</l>
<l>    disp_region (TabletIndividual, WindowHandle)</l>
<l>endif</l>
<c>* width error visu</c>
<l>gVisu_Error_SpecificToFeature (ErrorObject_Width, ErrorObject_Width, 'Width')</l>
<c>* length error visu</c>
<l>gVisu_Error_SpecificToFeature (ErrorObject_Length, ErrorObject_Length, 'Length')</l>
<c>* area error visu</c>
<l>gVisu_Error_SpecificToFeature (ErrorObject_Area, ErrorObject_Area, 'Area')</l>
<c>* spots error visu</c>
<l>gVisu_Error_SpecificToFeature (ErrorObject_Spots, ErrorObject_Spots, 'Spots')</l>
<c>* symmetry error visu</c>
<l>gVisu_Error_SpecificToFeature (ErrorObject_Symmetry, ErrorObject_Symmetry, 'Symmetry')</l>
<c></c>
<l>concat_obj (ErrorObject_Colour, ErrorObject_Length, ErrorObjectsConcat)</l>
<l>concat_obj (ErrorObjectsConcat, ErrorObject_Spots, ErrorObjectsConcat)</l>
<l>concat_obj (ErrorObjectsConcat, ErrorObject_Area, ErrorObjectsConcat)</l>
<l>concat_obj (ErrorObjectsConcat, ErrorObject_Width, ErrorObjectsConcat)</l>
<l>concat_obj (ErrorObjectsConcat, ErrorObject_Symmetry, ErrorObjectsConcat)</l>
<c></c>
<l>select_shape (ErrorObjectsConcat, ErrorObjectsConcat, 'area', 'and', 1, 9999999999)</l>
<c>* </c>
<c>* only display if objects are avalable- speeds up process</c>
<c>* </c>
<l>union1 (ErrorObjectsConcat, ErrorObjectsConcat_Union)</l>
<c></c>
<l>count_obj (GoodObject_Width, Number)</l>
<l>if (Number # 0)</l>
<l>    if (SuppressBadProductVisualisationInEjectBox = 1)</l>
<l>        intersection (EjectROIs, GoodObject_Width, GoodObjectsInEjectboxes)             </l>
<l>    else</l>
<l>        gen_empty_obj (GoodObjectsInEjectboxes)</l>
<l>    endif</l>
<c>    </c>
<l>    if (DevWindow0_NonDevWindow1 = 0)</l>
<l>        dev_set_color ('green')</l>
<l>        dev_display (GoodObject_Width)</l>
<l>        dev_set_color ('dim gray')</l>
<l>        dev_display (GoodObjectsInEjectboxes)</l>
<l>    else</l>
<l>        set_color (WindowHandle, 'green')</l>
<l>        disp_region (GoodObject_Width, WindowHandle)</l>
<l>        set_color (WindowHandle, 'dim gray')</l>
<l>        disp_region (GoodObjectsInEjectboxes, WindowHandle)</l>
<l>    endif</l>
<l>endif</l>
<c>* </c>
<c>* </c>
<c>*      </c>
<l>count_obj (ErrorObjectsConcat, Number)</l>
<l>if (Number # 0)</l>
<l>    if (SuppressBadProductVisualisationInEjectBox = 1)</l>
<l>        intersection (EjectROIs, ErrorObjectsConcat_Union, ErrorObjectsInEjectboxes)             </l>
<l>    else</l>
<l>        gen_empty_obj (ErrorObjectsInEjectboxes)</l>
<l>    endif</l>
<l>    if (DevWindow0_NonDevWindow1 = 0)           </l>
<l>        dev_set_color ('red')</l>
<l>        dev_display (ErrorObjectsConcat_Union)</l>
<l>        dev_set_color ('dim gray')</l>
<l>        dev_display (ErrorObjectsInEjectboxes)</l>
<l>    else</l>
<l>        set_color (WindowHandle, 'red')</l>
<l>        disp_region (ErrorObjectsConcat_Union, WindowHandle)</l>
<l>        set_color (WindowHandle, 'dim gray')</l>
<l>        disp_region (ErrorObjectsInEjectboxes, WindowHandle)</l>
<l>    endif</l>
<l>endif</l>
<c>* </c>
<c>* </c>
<c>* </c>
<l>ShiftregisterVectorLength := Shiftregister_EjectFoundPerLine_Vector.length()</l>
<c>* the offset is necessary for working with mutiple threadresults</c>
<l>Eject_ROI_Offset := 0</l>
<l>for VectorIndex := 0 to ShiftregisterVectorLength-1 by 1</l>
<l>    Shiftregister_EjectFoundPerLine := Shiftregister_EjectFoundPerLine_Vector.at(VectorIndex)</l>
<l>    Shiftregister_EjectGoodFoundPerLine := Shiftregister_EjectGoodFoundPerLine_Vector.at(VectorIndex)</l>
<c>    * first check for bad object</c>
<l>    tuple_greater_elem (Shiftregister_EjectFoundPerLine, 1, Greater)</l>
<l>    tuple_sum (Greater, NumberToSelect)</l>
<l>    tuple_sort_index (-Greater, Indices_ToSelect)</l>
<c>    * if no bad object, then try for good object</c>
<l>    if (NumberToSelect = 0)</l>
<l>            tuple_greater_elem (Shiftregister_EjectGoodFoundPerLine, 1, Greater)</l>
<l>            tuple_sum (Greater, NumberToSelect)</l>
<l>            tuple_sort_index (-Greater, Indices_ToSelect)</l>
<l>    endif</l>
<c></c>
<l>    if (NumberToSelect&gt;=1)</l>
<l>        tuple_select_range (Indices_ToSelect, 0, NumberToSelect-1, Selected)</l>
<l>        select_obj (EjectROIs, ObjectsSelected, Selected+Eject_ROI_Offset+1)</l>
<l>        if (DevWindow0_NonDevWindow1 = 0)</l>
<l>            dev_set_color ('red')</l>
<l>            dev_display (ObjectsSelected)</l>
<l>        else</l>
<l>            set_color (WindowHandle, 'red')</l>
<l>            disp_obj (ObjectsSelected, WindowHandle)</l>
<l>        endif</l>
<c>        * write the number of ejects to it</c>
<l>        for Index := 0 to NumberToSelect-1 by 1</l>
<l>            select_obj (ObjectsSelected, SingleBox, Index+1)</l>
<l>            area_center (SingleBox, _, Row, Column)</l>
<l>            set_tposition (WindowHandle, Row-14, Column-14)</l>
<l>            SelectedEjectNumberElement := Selected[Index]</l>
<c>            *ToDo - to check if stable</c>
<l>*             NumberErrorsInEjectBox := Shiftregister_EjectFoundPerLine[SelectedEjectNumberElement]</l>
<l>            NumberErrorsInEjectBox := 0</l>
<l>            if (DevWindow0_NonDevWindow1 = 0)</l>
<l>                dev_set_color ('red')</l>
<l>            else</l>
<l>                set_color (WindowHandle, 'red')</l>
<l>            endif</l>
<c>            * write the absolute value out</c>
<l>            write_string (WindowHandle, NumberErrorsInEjectBox + ' ')   </l>
<c>               *ToDo - to check if stable</c>
<l>*             NumberGoodInEjectBox := Shiftregister_EjectGoodFoundPerLine[SelectedEjectNumberElement]</l>
<l>            NumberGoodInEjectBox := 0</l>
<c>            </c>
<l>            if (DevWindow0_NonDevWindow1 = 0)</l>
<l>                dev_set_color ('green')</l>
<l>            else</l>
<l>                set_color (WindowHandle, 'green')</l>
<l>            endif</l>
<c>            </c>
<l>            GoodCounterVisuActive := 0</l>
<l>            if(GoodCounterVisuActive = 1)</l>
<c>                * write the absolute value out</c>
<l>                write_string (WindowHandle, '/ ' +NumberGoodInEjectBox)</l>
<l>            endif</l>
<c></c>
<l>            if (DevWindow0_NonDevWindow1 = 0)</l>
<l>                dev_set_color ('dim gray')</l>
<l>            else</l>
<l>                set_color (WindowHandle, 'dim gray')</l>
<l>            endif</l>
<c>            * write the absolute value out</c>
<l>            NumberOfOverallInspectionsPerObject := NumberErrorsInEjectBox +NumberGoodInEjectBox</l>
<c>            </c>
<l>            OverallCounterVisuActive := 0</l>
<l>            if(OverallCounterVisuActive = 1)</l>
<c>                * write the absolute value out</c>
<l>                write_string (WindowHandle, ' ('+(NumberOfOverallInspectionsPerObject) + ')')</l>
<l>            endif</l>
<l>        endfor</l>
<l>    endif</l>
<l>    tuple_length (Shiftregister_EjectFoundPerLine, Offset_Temp)</l>
<l>    Eject_ROI_Offset := Eject_ROI_Offset + Offset_Temp</l>
<l>endfor</l>
<c>* Display eject roi visualization </c>
<l>gDisplay_EjectMovementCompensationLines (EjectROIs, DevWindow0_NonDevWindow1, WindowHandle, Shiftregister_EjectPositionMovementCompensationVector, ExternalHardware_ConveyorDriveSlowly)</l>
<c>* </c>
<l>count_seconds (Seconds_End)</l>
<c></c>
<l>Time_Needed := (Seconds_End - Seconds_Start)*1000</l>
<c>* </c>
<l>return ()</l>
</body>
<docu id="gVisualisationOfResults">
<parameters>
<parameter id="DevWindow0_NonDevWindow1"/>
<parameter id="EjectROIs"/>
<parameter id="ErrorObjectVector_Colour_Width_Diameter_Spots_Area_Length_ThreadVector"/>
<parameter id="ExternalHardware_ConveyorDriveSlowly"/>
<parameter id="GoodObjectVector_TabletIndividual_WidthGood_ThreadVector"/>
<parameter id="ImageOrig"/>
<parameter id="ImageOrig_Sequencer_RGB"/>
<parameter id="RinnenROIs"/>
<parameter id="Shiftregister_EjectFoundPerLine_Vector"/>
<parameter id="Shiftregister_EjectGoodFoundPerLine_Vector"/>
<parameter id="Shiftregister_EjectPositionMovementCompensationVector"/>
<parameter id="ShowSequencerImage"/>
<parameter id="Time_Needed"/>
<parameter id="WindowHandle"/>
</parameters>
</docu>
</procedure>
<procedure name="gVisualisationOfResultsCollection">
<interface>
<io>
<par name="Optional_ImageToVisualize" base_type="iconic" dimension="0"/>
</io>
<oo>
<par name="VisuImage_WithOverlays" base_type="iconic" dimension="0"/>
</oo>
<ic>
<par name="CameraId" base_type="ctrl" dimension="0"/>
<par name="Optional_StringToVizualize" base_type="ctrl" dimension="0"/>
<par name="CalculationTimeToVisualize" base_type="ctrl" dimension="0"/>
<par name="WindowHandle" base_type="ctrl" dimension="0"/>
<par name="DevWindow0_NonDevWindow1" base_type="ctrl" dimension="0"/>
<par name="ProductionLoopCounter" base_type="ctrl" dimension="0"/>
<par name="ShiftregisterVector_ObjectMovement_Thread_CameraVector" base_type="ctrl" dimension="3"/>
<par name="Calculation_Colour_Mean_Red_Vector" base_type="ctrl" dimension="1"/>
<par name="Calculation_Colour_Mean_Green_Vector" base_type="ctrl" dimension="1"/>
<par name="Calculation_Colour_Mean_Blue_Vector" base_type="ctrl" dimension="1"/>
<par name="Calculation_Length_Vector" base_type="ctrl" dimension="1"/>
<par name="Calculation_Width_Vector" base_type="ctrl" dimension="1"/>
<par name="Calculation_Area_Vector" base_type="ctrl" dimension="1"/>
<par name="LocalCameraNumberUsed" base_type="ctrl" dimension="0"/>
<par name="PauseAfterVisualisationInMS" base_type="ctrl" dimension="0"/>
<par name="ExternalHardware_ConveyorDriveSlowly" base_type="ctrl" dimension="0"/>
<par name="GrabImageMetaData" base_type="ctrl" dimension="0"/>
</ic>
<oc>
<par name="VisualisationTime" base_type="ctrl" dimension="0"/>
</oc>
</interface>
<body>
<l>global tuple gVisuDevWindowOrNonDevWindow</l>
<l>global tuple gLocalCameraNumberUsed</l>
<l>global tuple gProductCounterGood</l>
<l>global tuple gProductCounterBad</l>
<l>global tuple gProductSpeed_Mean</l>
<l>global object vector(1) gRinnenROIs</l>
<l>global object vector(1) gEjectROIs</l>
<l>* global tuple vector(1) gProcessingTime</l>
<l>global tuple vector(1) gWindowVector</l>
<l>global tuple vector(1) gShiftregister_EjectFoundPerLine_Vector</l>
<l>global tuple vector(1) gShiftregister_EjectGoodFoundPerLine_Vector</l>
<l>global tuple vector(1) gWindowHandleVisuBuffer</l>
<l>global tuple vector(1) gVisuImageGernarationMode</l>
<l>global object vector(2) gImageOrigGrabbed_LastFrame</l>
<l>global tuple vector(2) gProcessingTime_VCamera_VThread_TTime</l>
<l>global object vector(3) gGoodObjectVector_TabletIndividual_WidthGood_ThreadVector</l>
<l>global object vector(3) gErrorObjectVector_Colour_Width_Diameter_Spots_Area_Length_ThreadVector</l>
<l>global tuple vector(3) gShiftregister_EjectPositionMovementCompensationVector</l>
<c>* </c>
<c></c>
<l>count_seconds (Seconds_Start)</l>
<c></c>
<c></c>
<c>* gVisualizationOptions_Vector eliminieren</c>
<c>* hint do not use dev_set operators like dev_set_color here. these will block execution in engine environment in halcon 13 in threaded environment.</c>
<l>get_image_size (Optional_ImageToVisualize, Width, _)</l>
<l>if (Width # [])</l>
<l>    OneImage:= Optional_ImageToVisualize</l>
<l>else</l>
<l>    gTilePartimagesToOneVisuimage (gImageOrigGrabbed_LastFrame.at(CameraId), OneImage)</l>
<l>endif</l>
<c></c>
<l>WindowHandleForVisualisationBuffer := gWindowHandleVisuBuffer.at(CameraId)</l>
<c>* </c>
<l>set_window_param (gWindowVector.at(CameraId), 'flush', 'false')</l>
<c></c>
<l>gVisualisationOfResults (OneImage, OneImage, gRinnenROIs.at((gLocalCameraNumberUsed)), gEjectROIs.at((gLocalCameraNumberUsed)), gGoodObjectVector_TabletIndividual_WidthGood_ThreadVector, gErrorObjectVector_Colour_Width_Diameter_Spots_Area_Length_ThreadVector, WindowHandleForVisualisationBuffer, gShiftregister_EjectFoundPerLine_Vector, gShiftregister_EjectGoodFoundPerLine_Vector, 1, gShiftregister_EjectPositionMovementCompensationVector.at(CameraId), ExternalHardware_ConveyorDriveSlowly, 0, Time_Needed)</l>
<l>if (Optional_StringToVizualize # [])</l>
<l>    set_color (WindowHandleForVisualisationBuffer, 'red')</l>
<l>    set_tposition (WindowHandleForVisualisationBuffer, 200, 24)</l>
<l>    write_string (WindowHandleForVisualisationBuffer, Optional_StringToVizualize)</l>
<l>endif</l>
<c></c>
<c></c>
<c>* get time of the slowest processing thread</c>
<l>convert_vector_to_tuple (gProcessingTime_VCamera_VThread_TTime, TimeNeededThreads)</l>
<l>tuple_max (TimeNeededThreads, TimeNeeded)</l>
<l>gVisualisationOfStrings (0, TimeNeeded, WindowHandleForVisualisationBuffer, gVisuDevWindowOrNonDevWindow, ShiftregisterVector_ObjectMovement_Thread_CameraVector, Calculation_Colour_Mean_Red_Vector, Calculation_Colour_Mean_Green_Vector, Calculation_Colour_Mean_Blue_Vector, Calculation_Length_Vector, Calculation_Width_Vector, Calculation_Area_Vector, LocalCameraNumberUsed, gProductCounterGood, gProductCounterBad, GrabImageMetaData)</l>
<l>flush_buffer (gWindowVector.at(CameraId))</l>
<l>dump_window_image (VisuImage_WithOverlays, WindowHandleForVisualisationBuffer)</l>
<l>clear_window (WindowHandleForVisualisationBuffer)</l>
<l>set_window_param (gWindowVector.at(CameraId), 'flush', 'true')</l>
<c></c>
<c>* </c>
<c>* the pause should be used in fast systems or systems with heavy load</c>
<l>wait_seconds (PauseAfterVisualisationInMS / 1000.0)</l>
<l>gVisuImageVector.at(CameraId) := VisuImage_WithOverlays</l>
<l>count_seconds (Seconds_End)</l>
<l>VisualisationTime := (Seconds_End - Seconds_Start)*1000</l>
<c>* set flag that visualisation image is ready</c>
<l>gVisuImageGernarationMode.at(CameraId) := 1</l>
<c>* </c>
<l>return ()</l>
</body>
<docu id="gVisualisationOfResultsCollection">
<parameters>
<parameter id="CalculationTimeToVisualize"/>
<parameter id="Calculation_Area_Vector"/>
<parameter id="Calculation_Colour_Mean_Blue_Vector"/>
<parameter id="Calculation_Colour_Mean_Green_Vector"/>
<parameter id="Calculation_Colour_Mean_Red_Vector"/>
<parameter id="Calculation_Length_Vector"/>
<parameter id="Calculation_Width_Vector"/>
<parameter id="CameraId"/>
<parameter id="DevWindow0_NonDevWindow1"/>
<parameter id="ExternalHardware_ConveyorDriveSlowly"/>
<parameter id="GrabImageMetaData"/>
<parameter id="LocalCameraNumberUsed"/>
<parameter id="Optional_ImageToVisualize"/>
<parameter id="Optional_StringToVizualize"/>
<parameter id="PauseAfterVisualisationInMS"/>
<parameter id="ProductionLoopCounter"/>
<parameter id="ShiftregisterVector_ObjectMovement_Thread_CameraVector"/>
<parameter id="VisuImage_WithOverlays"/>
<parameter id="VisualisationTime"/>
<parameter id="WindowHandle"/>
</parameters>
</docu>
</procedure>
<procedure name="gVisualisationOfStrings">
<interface>
<ic>
<par name="VisualisationTime" base_type="ctrl" dimension="0"/>
<par name="CalculationTimeToVisualize" base_type="ctrl" dimension="0"/>
<par name="WindowHandle" base_type="ctrl" dimension="0"/>
<par name="DevWindow0_NonDevWindow1" base_type="ctrl" dimension="0"/>
<par name="ShiftregisterVector_ObjectMovement_Thread_CameraVector" base_type="ctrl" dimension="3"/>
<par name="Calculation_Colour_Mean_Red_Vector" base_type="ctrl" dimension="1"/>
<par name="Calculation_Colour_Mean_Green_Vector" base_type="ctrl" dimension="1"/>
<par name="Calculation_Colour_Mean_Blue_Vector" base_type="ctrl" dimension="1"/>
<par name="Calculation_Length_Vector" base_type="ctrl" dimension="1"/>
<par name="Calculation_Width_Vector" base_type="ctrl" dimension="1"/>
<par name="Calculation_Area_Vector" base_type="ctrl" dimension="1"/>
<par name="LocalCameraNumberUsed" base_type="ctrl" dimension="0"/>
<par name="ProductCounterGood" base_type="ctrl" dimension="0"/>
<par name="ProductCounterBad" base_type="ctrl" dimension="0"/>
<par name="GrabImageMetaData" base_type="ctrl" dimension="0"/>
</ic>
</interface>
<body>
<l>* global tuple vector(1) gVTMessagesInLocalLanguage</l>
<l>global tuple dict_MessagesInLocalLanguage</l>
<c></c>
<l>* global tuple gInProcessControl_ActiveRequest</l>
<l>* global tuple gInProcessControl_ActiveROILine</l>
<l>global tuple dict_InspectionVisualization</l>
<c></c>
<l>global tuple gProductSpeed_Mean</l>
<c></c>
<c></c>
<c></c>
<l>if (DevWindow0_NonDevWindow1 = 0)</l>
<l>    dev_set_color ('red')</l>
<l>else</l>
<l>    set_color (WindowHandle, 'red')</l>
<l>endif</l>
<l>TextPosition_Column := 0</l>
<l>TextPosition_Row := 0</l>
<l>set_tposition (WindowHandle, TextPosition_Row, TextPosition_Column)</l>
<c></c>
<c></c>
<l>if( dict_InspectionVisualization.V_ShowProcessingTime.Value)</l>
<l>    write_string (WindowHandle, dict_MessagesInLocalLanguage.HDEV_ShowProcessingTime)</l>
<l>    write_string (WindowHandle, CalculationTimeToVisualize $'6.1f') </l>
<l>    new_line (WindowHandle)</l>
<l>endif</l>
<c>******************************************************</c>
<l>if( dict_InspectionVisualization.V_ShowVisualisationTime.Value)</l>
<l>    write_string (WindowHandle, dict_MessagesInLocalLanguage.HDEV_ShowVisualisationTime)</l>
<l>    write_string (WindowHandle, (VisualisationTime) $'6.1f')</l>
<l>    new_line (WindowHandle)</l>
<l>endif</l>
<c>******************************************************</c>
<l>if( dict_InspectionVisualization.V_ShowPictureNumber.Value )</l>
<l>    write_string (WindowHandle, dict_MessagesInLocalLanguage.HDEV_ShowPictureNumber)</l>
<l>    write_string (WindowHandle, GrabImageMetaData.GrabLoopCounter)</l>
<l>    new_line (WindowHandle)</l>
<l>endif</l>
<c>******************************************************</c>
<l>if( dict_InspectionVisualization.V_ShowColour_1.Value) </l>
<l>    convert_vector_to_tuple (Calculation_Colour_Mean_Red_Vector, TupleToVisu)</l>
<l>    write_string (WindowHandle, dict_MessagesInLocalLanguage.HDEV_ShowColour_1)</l>
<l>    tuple_round (TupleToVisu, TupleToVisu)</l>
<l>    write_string (WindowHandle, TupleToVisu + ', ')</l>
<l>    new_line (WindowHandle)</l>
<l>endif</l>
<c>******************************************************</c>
<l>if( dict_InspectionVisualization.V_ShowColour_2.Value)</l>
<l>    convert_vector_to_tuple (Calculation_Colour_Mean_Green_Vector, TupleToVisu)</l>
<l>    write_string (WindowHandle, dict_MessagesInLocalLanguage.HDEV_ShowColour_2)</l>
<l>    tuple_round (TupleToVisu, TupleToVisu)</l>
<l>    write_string (WindowHandle, TupleToVisu + ', ')</l>
<l>    new_line (WindowHandle)</l>
<l>endif</l>
<c>******************************************************</c>
<l>if( dict_InspectionVisualization.V_ShowColour_3.Value)</l>
<l>    convert_vector_to_tuple (Calculation_Colour_Mean_Blue_Vector, TupleToVisu)</l>
<l>    write_string (WindowHandle, dict_MessagesInLocalLanguage.HDEV_ShowColour_3)</l>
<l>    tuple_round (TupleToVisu, TupleToVisu)</l>
<l>    write_string (WindowHandle, TupleToVisu + ', ')</l>
<l>    new_line (WindowHandle)</l>
<l>endif</l>
<c>******************************************************</c>
<l>if( dict_InspectionVisualization.V_ShowLength.Value)</l>
<l>    convert_vector_to_tuple (Calculation_Length_Vector, TupleToVisu)</l>
<l>    write_string (WindowHandle, dict_MessagesInLocalLanguage.HDEV_ShowLength)</l>
<l>    tuple_round (TupleToVisu, TupleToVisu)</l>
<l>    write_string (WindowHandle, TupleToVisu + ', ')</l>
<l>    new_line (WindowHandle)</l>
<l>endif</l>
<c>******************************************************</c>
<l>if( dict_InspectionVisualization.V_ShowWidth.Value)</l>
<l>    convert_vector_to_tuple (Calculation_Width_Vector, TupleToVisu)</l>
<l>    write_string (WindowHandle, dict_MessagesInLocalLanguage.HDEV_ShowWidth)</l>
<l>    tuple_round (TupleToVisu, TupleToVisu)</l>
<l>    write_string (WindowHandle, TupleToVisu + ', ')</l>
<l>    new_line (WindowHandle)</l>
<l>endif</l>
<c>******************************************************</c>
<l>if( dict_InspectionVisualization.V_ShowArea.Value)</l>
<l>    convert_vector_to_tuple (Calculation_Area_Vector, TupleToVisu)</l>
<l>    write_string (WindowHandle, dict_MessagesInLocalLanguage.HDEV_ShowArea)</l>
<l>    tuple_round (TupleToVisu, TupleToVisu)</l>
<l>    write_string (WindowHandle, TupleToVisu + ', ')</l>
<l>    new_line (WindowHandle)</l>
<l>endif</l>
<c>******************************************************</c>
<l>if( dict_InspectionVisualization.V_ShowProductSpeed.Value)</l>
<l>    convert_vector_to_tuple (ShiftregisterVector_ObjectMovement_Thread_CameraVector, ObjectMovementPerLine)</l>
<l>    write_string (WindowHandle, dict_MessagesInLocalLanguage.HDEV_ShowProductSpeed)</l>
<l>    write_string (WindowHandle, ObjectMovementPerLine + ', ')</l>
<l>    new_line (WindowHandle)</l>
<c>******************************************************</c>
<l>endif</l>
<l>if( dict_InspectionVisualization.V_ShowCameraNumberUsed.Value)</l>
<l>    write_string (WindowHandle, dict_MessagesInLocalLanguage.HDEV_ShowCameraNumberUsed)</l>
<l>    write_string (WindowHandle, LocalCameraNumberUsed)</l>
<l>    new_line (WindowHandle)</l>
<l>endif</l>
<c>******************************************************</c>
<l>if( dict_InspectionVisualization.V_ShowCounterGood.Value)</l>
<l>    write_string (WindowHandle, dict_MessagesInLocalLanguage.HDEV_ShowCounterGood)</l>
<l>    write_string (WindowHandle, ProductCounterGood)</l>
<l>    new_line (WindowHandle)</l>
<l>endif</l>
<c>******************************************************</c>
<l>if( dict_InspectionVisualization.V_ShowCounterBad.Value)</l>
<l>    write_string (WindowHandle, dict_MessagesInLocalLanguage.HDEV_ShowCounterBad)</l>
<l>    write_string (WindowHandle, ProductCounterBad)</l>
<l>    new_line (WindowHandle)</l>
<l>endif</l>
<c>    ******************************************************</c>
<l>if( dict_InspectionVisualization.V_ShowProductSpeedMean.Value)</l>
<l>    write_string (WindowHandle, dict_MessagesInLocalLanguage.HDEV_ShowProductSpeedMean)</l>
<l>    write_string (WindowHandle, gProductSpeed_Mean)</l>
<l>    new_line (WindowHandle)</l>
<l>endif  </l>
<c>******************************************************</c>
<l>if( dict_InspectionVisualization.V_ShowMachineShiftregister_Index.Value)       </l>
<l>    gSelectVariableValueFromTupleString(GrabImageMetaData, 'MachineShiftregister_Index', MachineShiftregister_Index)</l>
<l>    gVisualisation_AddStringToVisu (MachineShiftregister_Index, 'MachineShiftregister_Index', WindowHandle)        </l>
<l>endif </l>
<c>******************************************************</c>
<l>if( dict_InspectionVisualization.V_ShowThreadQueue_Bufferlength.Value)</l>
<l>    gSelectVariableValueFromTupleString(GrabImageMetaData, 'Queue_AquisitionThread_Msg', Queue_AquisitionThread)</l>
<l>    gVisualisation_AddStringToVisu (Queue_AquisitionThread, 'Queue_Aquisition', WindowHandle)</l>
<l>    gSelectVariableValueFromTupleString(GrabImageMetaData, 'TimeNeeded_AquisitionThread', TimeNeeded_Aquisition)</l>
<l>    gVisualisation_AddStringToVisu (TimeNeeded_Aquisition $'6.1f', 'TimeNeeded_Aquisition', WindowHandle)</l>
<c></c>
<c>    </c>
<l>    gSelectVariableValueFromTupleString(GrabImageMetaData, 'Queue_ImageRotation_Msg', Queue_ImageRotation)</l>
<l>    gVisualisation_AddStringToVisu (Queue_ImageRotation, 'Queue_ImageRotation', WindowHandle)</l>
<l>    gSelectVariableValueFromTupleString(GrabImageMetaData, 'TimeNeeded_Thread_ImageRotation', TimeNeeded_ImageRotation)</l>
<l>    gVisualisation_AddStringToVisu (TimeNeeded_ImageRotation $'6.1f', 'TimeNeeded_ImageRotation', WindowHandle)</l>
<c></c>
<c></c>
<l>    gSelectVariableValueFromTupleString(GrabImageMetaData, 'Queue_PostGrab_Msg', Queue_PostGrab)</l>
<l>    gVisualisation_AddStringToVisu (Queue_PostGrab, 'Queue_PostGrab', WindowHandle)</l>
<l>    gSelectVariableValueFromTupleString(GrabImageMetaData, 'TimeNeeded_Thread_PostGrab', TimeNeeded_PostGrab)</l>
<l>    gVisualisation_AddStringToVisu (TimeNeeded_PostGrab $'6.1f', 'TimeNeeded_PostGrab', WindowHandle)</l>
<c></c>
<l>    gSelectVariableValueFromTupleString(GrabImageMetaData, 'Queue_RGB_Threshold_Msg', Queue_RGB_Threshold)</l>
<l>    gVisualisation_AddStringToVisu (Queue_RGB_Threshold, 'Queue_RGB_Threshold', WindowHandle)</l>
<l>    gSelectVariableValueFromTupleString(GrabImageMetaData, 'TimeNeeded_Thread_RGB_Threshold', TimeNeeded_RGB_Threshold)</l>
<l>    gVisualisation_AddStringToVisu (TimeNeeded_RGB_Threshold $'6.1f', 'TimeNeeded_RGB_Threshold', WindowHandle)</l>
<c></c>
<c></c>
<l>    gSelectVariableValueFromTupleString(GrabImageMetaData, 'Queue_MiddleThread_Msg', Queue_MiddleThread)</l>
<l>    gVisualisation_AddStringToVisu (Queue_MiddleThread, 'Queue_MiddleThread', WindowHandle)</l>
<l>    gSelectVariableValueFromTupleString(GrabImageMetaData, 'TimeNeeded_MiddleThread', TimeNeeded_Middle)</l>
<l>    gVisualisation_AddStringToVisu (TimeNeeded_Middle $'6.1f', 'TimeNeeded_Middle', WindowHandle)</l>
<l>endif </l>
<c>******************************************************</c>
<c></c>
<l>return ()</l>
</body>
<docu id="gVisualisationOfStrings">
<parameters>
<parameter id="CalculationTimeToVisualize"/>
<parameter id="Calculation_Area_Vector"/>
<parameter id="Calculation_Colour_Mean_Blue_Vector"/>
<parameter id="Calculation_Colour_Mean_Green_Vector"/>
<parameter id="Calculation_Colour_Mean_Red_Vector"/>
<parameter id="Calculation_Length_Vector"/>
<parameter id="Calculation_Width_Vector"/>
<parameter id="DevWindow0_NonDevWindow1"/>
<parameter id="GrabImageMetaData"/>
<parameter id="LocalCameraNumberUsed"/>
<parameter id="ProductCounterBad"/>
<parameter id="ProductCounterGood"/>
<parameter id="ShiftregisterVector_ObjectMovement_Thread_CameraVector"/>
<parameter id="VisualisationTime"/>
<parameter id="WindowHandle"/>
</parameters>
</docu>
</procedure>
<procedure name="gWathershedStep">
<interface>
<io>
<par name="TabletRegionWithMirrors_Processed" base_type="iconic" dimension="0"/>
</io>
<oo>
<par name="SplitProductsOut" base_type="iconic" dimension="0"/>
</oo>
<ic>
<par name="WatershedSingleProduct0_AllinOne1" base_type="ctrl" dimension="0"/>
<par name="SeperationThreshold" base_type="ctrl" dimension="0"/>
</ic>
<oc>
<par name="ContinueOutside" base_type="ctrl" dimension="0"/>
<par name="Time_Needed" base_type="ctrl" dimension="0"/>
</oc>
</interface>
<body>
<l>count_seconds (Seconds_Start)</l>
<c></c>
<l>gen_empty_obj (SplitProductsOut)</l>
<c>* </c>
<l>area_center (TabletRegionWithMirrors_Processed, Area, _, _)</l>
<l>if (Area = [] or Area = 0)</l>
<l>    ContinueOutside := 1</l>
<l>else</l>
<l>    smallest_rectangle1 (TabletRegionWithMirrors_Processed, Row1, Column1, Row2, Column2)</l>
<c>    *  </c>
<l>    tuple_length (Row1, NumberOfRegionsToSplit)</l>
<l>    for Index := 0 to NumberOfRegionsToSplit-1 by 1</l>
<l>        select_obj (TabletRegionWithMirrors_Processed, TabletRegionWithMirrors_Processed_Selected, Index+1)</l>
<l>        if (WatershedSingleProduct0_AllinOne1 = 1)</l>
<c>            * test to do the watershed in one move</c>
<l>            union1 (TabletRegionWithMirrors_Processed, TabletRegionWithMirrors_Processed_Selected)</l>
<l>            smallest_rectangle1 (TabletRegionWithMirrors_Processed_Selected, Row1, Column1, Row2, Column2)</l>
<l>        endif</l>
<c></c>
<l>        move_region (TabletRegionWithMirrors_Processed_Selected, TabletRegionWithMirrors_Moved, -Row1[Index] +5, -Column1[Index] +5)</l>
<l>        copy_obj (TabletRegionWithMirrors_Moved, WithoutFillUp, 1, -1)</l>
<l>        fill_up (TabletRegionWithMirrors_Moved, TabletRegionWithMirrors_Moved)</l>
<l>        HeightRegion := Row2[Index]-Row1[Index]</l>
<l>        WidthRegion := Column2[Index]-Column1[Index]</l>
<l>        distance_transform (TabletRegionWithMirrors_Moved, DistanceImage, 'octagonal', 'true', WidthRegion +10, HeightRegion +10)</l>
<l>        convert_image_type (DistanceImage, DistanceImageByte, 'byte')</l>
<l>        invert_image (DistanceImageByte, DistanceImageInv)</l>
<l>        scale_image_max (DistanceImageInv, DistanceImageInvScaled)</l>
<l>        watersheds_threshold (DistanceImageInv, Basins, SeperationThreshold)</l>
<l>*         watersheds_threshold (DistanceImageInv, Basins, 7)</l>
<l>        intersection (Basins, WithoutFillUp, WatershedSegmentedObjects)</l>
<l>        move_region (WatershedSegmentedObjects, WatershedSegmentedObjects, Row1[Index] -5, Column1[Index] -5)</l>
<c>        * </c>
<c>        *</c>
<l>        area_center (WatershedSegmentedObjects, AreaConnectedIndividualTablet, _, _)</l>
<l>        tuple_sort_index (-AreaConnectedIndividualTablet, Indices)</l>
<l>        if (AreaConnectedIndividualTablet = 0 or AreaConnectedIndividualTablet = [])</l>
<l>            ContinueOutside := 1</l>
<l>        else</l>
<l>            ToChoose := Indices</l>
<l>            tuple_length (Indices, Length)</l>
<l>            tuple_gen_const (Length, 1, Const1Tuple)</l>
<l>            tuple_add (Const1Tuple, ToChoose, SelectionIndices)</l>
<l>            select_obj (WatershedSegmentedObjects, WatershedSegmentedObjects_Selected, SelectionIndices)</l>
<l>        endif</l>
<l>        concat_obj (SplitProductsOut, WatershedSegmentedObjects_Selected, SplitProductsOut)</l>
<l>        if (WatershedSingleProduct0_AllinOne1 = 1)</l>
<l>            break</l>
<l>        endif</l>
<l>    endfor</l>
<l>endif</l>
<l>* if(0)</l>
<l>*     stop()    </l>
<l>* endif</l>
<l>count_seconds (Seconds_End)</l>
<l>Time_Needed := (Seconds_End- Seconds_Start) * 1000</l>
<l>return ()</l>
</body>
<docu id="gWathershedStep">
<parameters>
<parameter id="ContinueOutside"/>
<parameter id="SeperationThreshold"/>
<parameter id="SplitProductsOut"/>
<parameter id="TabletRegionWithMirrors_Processed"/>
<parameter id="Time_Needed"/>
<parameter id="WatershedSingleProduct0_AllinOne1"/>
</parameters>
</docu>
</procedure>
<procedure name="hidden_features_calculate_feature">
<interface>
<io>
<par name="Tablet_Individual" base_type="iconic" dimension="0"/>
<par name="ImageOrig" base_type="iconic" dimension="0"/>
<par name="Tablet_Individual_ColourClassified" base_type="iconic" dimension="0"/>
</io>
<oo>
<par name="Tablet_IndividualOut" base_type="iconic" dimension="0"/>
<par name="AllObjects_MeasuredRegions" base_type="iconic" dimension="0"/>
<par name="Tablet_Individual_Selected" base_type="iconic" dimension="0"/>
</oo>
<ic>
<par name="FeatureToAnalyzeIn" base_type="ctrl" dimension="0"/>
</ic>
<oc>
<par name="AllObjects_MeasuredValues" base_type="ctrl" dimension="0"/>
<par name="Row1" base_type="ctrl" dimension="0"/>
<par name="Row2" base_type="ctrl" dimension="0"/>
<par name="Tablet_Individual_Number" base_type="ctrl" dimension="0"/>
</oc>
</interface>
<body>
<l>Tablet_IndividualOut := Tablet_Individual</l>
<c></c>
<c></c>
<c></c>
<c></c>
<c>* </c>
<c>* *** feature diagonal</c>
<l>* if (FeatureToAnalyzeIn = 'diameter')</l>
<l>* CheckFormInsteadofDiagonal := 0</l>
<l>* if (CheckFormInsteadofDiagonal = 1)</l>
<c>* test approach for symmetry to discriminate rectangular from oblong tablets</c>
<l>*         gCalculate_OblongToRectDifference (Tablet_IndividualOut, ImageOrig, AllObjects_MeasuredValues, TimeNeeded_FormMEasurement)</l>
<l>* else</l>
<c>* fast approach for computing the diameter</c>
<l>*         closing_rectangle1 (Tablet_IndividualOut, Tablet_IndividualOut, 15, 15)</l>
<l>*         diameter_region (Tablet_IndividualOut, Row1, Column1, Row2, Column2, AllObjects_MeasuredValues)</l>
<l>* endif</l>
<l>*     AllObjects_MeasuredRegions := Tablet_IndividualOut</l>
<l>* endif</l>
<c>* </c>
<c></c>
<c>* </c>
<c>*   </c>
<c>* *** feature subpixel width</c>
<l>* if (FeatureToAnalyzeIn[0] = 'subpixel width')</l>
<l>*     count_obj (Tablet_IndividualOut, Tablet_Individual_Number)</l>
<l>* if (Tablet_Individual_Number&gt;0)</l>
<l>* for IndexCnt := 1 to Tablet_Individual_Number by 1</l>
<l>*             select_obj (Tablet_IndividualOut, Tablet_Individual_Selected, IndexCnt)</l>
<l>* gMeasureXLD_LengthOrWidth (Tablet_Individual_Selected, ImageOrig, MeasuredVisuWidth, 0, 25, 25, SubpixelWidth)</l>
<l>* tuple_concat (AllObjects_MeasuredValues, SubpixelWidth, AllObjects_MeasuredValues)                </l>
<l>* concat_obj (AllObjects_MeasuredRegions, MeasuredVisuWidth, AllObjects_MeasuredRegions)</l>
<c>* debug visu</c>
<l>* dev_get_window (WindowHandle)</l>
<l>* disp_cross (WindowHandle, [MiddleRow,MiddleRow], [LeftPosition,RightPosition], 16, 0)</l>
<l>* endfor</l>
<l>* endif</l>
<l>* endif</l>
<c></c>
<c>* *** feature subpixel height</c>
<l>* if (FeatureToAnalyzeIn[0] = 'subpixel height')</l>
<l>*     count_obj (Tablet_IndividualOut, Tablet_Individual_Number)</l>
<l>* if (Tablet_Individual_Number&gt;0)</l>
<l>* for IndexCnt := 1 to Tablet_Individual_Number by 1</l>
<l>*             select_obj (Tablet_IndividualOut, Tablet_Individual_Selected, IndexCnt)</l>
<l>* gMeasureXLD_LengthOrWidth (Tablet_Individual_Selected, ImageOrig, MeasuredVisuHeight, 1, 25, 25, SubpixelHeight)</l>
<l>* tuple_concat (AllObjects_MeasuredValues, SubpixelHeight, AllObjects_MeasuredValues)    </l>
<l>* concat_obj (AllObjects_MeasuredRegions, MeasuredVisuHeight, AllObjects_MeasuredRegions)</l>
<c>* debug visu</c>
<l>* dev_get_window (WindowHandle)</l>
<l>* disp_cross (WindowHandle, [MiddleRow,MiddleRow], [LeftPosition,RightPosition], 16, 0)</l>
<l>* endfor</l>
<l>* endif</l>
<l>* endif</l>
<c>* *** feature Gravity deviation X</c>
<l>* if (FeatureToAnalyzeIn = 'MidGravityX')</l>
<c>* fast approach for computing the deviation middle of object to center of gravity</c>
<l>*     gCalculateFeature_MidToGravityDeviation (Tablet_IndividualOut, 0, AllObjects_MeasuredValues)</l>
<l>*     AllObjects_MeasuredRegions := Tablet_IndividualOut</l>
<l>* endif</l>
<c>* *** feature Gravity deviation Y</c>
<l>* if (FeatureToAnalyzeIn = 'MidGravityY')</l>
<c>* fast approach for computing the deviation middle of object to center of gravity</c>
<l>*     gCalculateFeature_MidToGravityDeviation (Tablet_IndividualOut, 1, AllObjects_MeasuredValues)</l>
<l>*     AllObjects_MeasuredRegions := Tablet_IndividualOut</l>
<l>* endif</l>
<c>*</c>
<c>* *** feature Symmetry left to right half of product</c>
<l>* if (FeatureToAnalyzeIn = 'Symmetry')</l>
<c>* fast approach for computing the deviation middle of object to center of gravity</c>
<l>*     gCalculateFeature_Symmetry (ImageOrig, Tablet_IndividualOut, MeasuredVisuSymmetry, 0, AllObjects_MeasuredValues)</l>
<l>* AllObjects_MeasuredRegions := MeasuredVisuSymmetry</l>
<l>* endif</l>
<c></c>
<c>* *** feature Concavity around hull of product</c>
<l>* if (FeatureToAnalyzeIn = 'Concavity')</l>
<c>* fast approach for computing the deviation middle of object to center of gravity</c>
<l>*     gCalculateFeature_Concavity (ImageOrig, Tablet_IndividualOut, MeasuredVisuConcavity, 0, AllObjects_MeasuredValues)</l>
<l>* AllObjects_MeasuredRegions := MeasuredVisuConcavity</l>
<l>* endif</l>
<c></c>
<c></c>
<c>* *** feature Symmetry lower to upper half of product</c>
<l>* if (FeatureToAnalyzeIn = 'Symmetry_AxisHorizontal')</l>
<l>*     gCalculateFeature_Symmetry_AxisHorizontal (ImageOrig, Tablet_IndividualOut, MeasuredVisuSymmetry_AxisHorizontal, AllObjects_MeasuredValues)</l>
<l>* AllObjects_MeasuredRegions := MeasuredVisuSymmetry_AxisHorizontal</l>
<l>* endif</l>
<c></c>
<c>* *** feature PrintInspection</c>
<l>* if (FeatureToAnalyzeIn[0] = 'Calculation_PrintInspection')</l>
<c>    * some thresholds for color segmentation of print</c>
<l>*     gSelectVariableValueFromTupleString (FeatureToAnalyzeIn, 'TabletPrintInspection_SegmentColorHueMin', TabletPrintInspection_SegmentColorHueMin)</l>
<l>*     gSelectVariableValueFromTupleString (FeatureToAnalyzeIn, 'TabletPrintInspection_SegmentColorHueMax', TabletPrintInspection_SegmentColorHueMax)</l>
<l>*     gSelectVariableValueFromTupleString (FeatureToAnalyzeIn, 'TabletPrintInspection_SegmentColorSaturationMin', TabletPrintInspection_SegmentColorSaturationMin)</l>
<l>*     gSelectVariableValueFromTupleString (FeatureToAnalyzeIn, 'TabletPrintInspection_SegmentColorSaturationMax', TabletPrintInspection_SegmentColorSaturationMax)</l>
<c>    </c>
<c>*     gCalculateFeature_PrintInspection (ImageOrig, Tablet_IndividualOut, Tablet_Individual_ColourClassified, MeasuredVisuPrintInspection, TabletPrintInspection_SegmentColorHueMin, TabletPrintInspection_SegmentColorHueMax, TabletPrintInspection_SegmentColorSaturationMin, TabletPrintInspection_SegmentColorSaturationMax, AllObjects_MeasuredValues, TimeNeeded_FeatureCalculation)</c>
<l>*     AllObjects_MeasuredRegions := MeasuredVisuPrintInspection</l>
<c>    </c>
<l>*     count_obj (MeasuredVisuPrintInspection, Number)</l>
<l>* endif</l>
<c></c>
<l>return ()</l>
</body>
<docu id="hidden_features_calculate_feature">
<parameters>
<parameter id="AllObjects_MeasuredRegions"/>
<parameter id="AllObjects_MeasuredValues"/>
<parameter id="FeatureToAnalyzeIn"/>
<parameter id="ImageOrig"/>
<parameter id="Row1"/>
<parameter id="Row2"/>
<parameter id="Tablet_Individual"/>
<parameter id="Tablet_IndividualOut"/>
<parameter id="Tablet_Individual_ColourClassified"/>
<parameter id="Tablet_Individual_Number"/>
<parameter id="Tablet_Individual_Selected"/>
</parameters>
</docu>
</procedure>
<procedure name="LogProcessingResults">
<interface>
<ic>
<par name="Calculation_Colour_Mean_Red_Vector" base_type="ctrl" dimension="1"/>
<par name="Calculation_Colour_Mean_Green_Vector" base_type="ctrl" dimension="1"/>
<par name="Calculation_Colour_Mean_Blue_Vector" base_type="ctrl" dimension="1"/>
<par name="Calculation_Width_Vector" base_type="ctrl" dimension="1"/>
<par name="Calculation_Area_Vector" base_type="ctrl" dimension="1"/>
</ic>
</interface>
<body>
<l>global tuple gLogProcessingResults </l>
<l>global def tuple vector(1) gCalculation_Colour_Mean_Red_Vector_Concat</l>
<l>global def tuple vector(1) gCalculation_Colour_Mean_Green_Vector_Concat</l>
<l>global def tuple vector(1) gCalculation_Colour_Mean_Blue_Vector_Concat</l>
<l>global def tuple vector(1) gCalculation_Width_Vector_Concat</l>
<l>global def tuple vector(1) gCalculation_Diameter_Vector_Concat</l>
<l>global def tuple vector(1) gCalculation_Area_Vector_Concat</l>
<c></c>
<l>if (gLogProcessingResults)</l>
<l>    convert_vector_to_tuple (Calculation_Colour_Mean_Red_Vector, Red)</l>
<l>    Length_Vector := gCalculation_Colour_Mean_Red_Vector_Concat.length()</l>
<l>    gCalculation_Colour_Mean_Red_Vector_Concat.at(Length_Vector) := Red</l>
<c>    </c>
<l>    convert_vector_to_tuple (Calculation_Colour_Mean_Green_Vector, Green)</l>
<l>    Length_Vector := gCalculation_Colour_Mean_Green_Vector_Concat.length()</l>
<l>    gCalculation_Colour_Mean_Green_Vector_Concat.at(Length_Vector) := Green</l>
<c>    </c>
<l>    convert_vector_to_tuple (Calculation_Colour_Mean_Blue_Vector, Blue)</l>
<l>    Length_Vector := gCalculation_Colour_Mean_Blue_Vector_Concat.length()</l>
<l>    gCalculation_Colour_Mean_Blue_Vector_Concat.at(Length_Vector) := Blue</l>
<c>    </c>
<l>    convert_vector_to_tuple (Calculation_Width_Vector, Width)</l>
<l>    Length_Vector := gCalculation_Width_Vector_Concat.length()</l>
<l>    gCalculation_Width_Vector_Concat.at(Length_Vector) := Width</l>
<c>    </c>
<l>    convert_vector_to_tuple (Calculation_Diameter_Vector, Diameter)    </l>
<l>    Length_Vector := gCalculation_Diameter_Vector_Concat.length()</l>
<l>    gCalculation_Diameter_Vector_Concat.at(Length_Vector) := Diameter</l>
<c>    </c>
<l>    convert_vector_to_tuple (Calculation_Area_Vector, Area)</l>
<l>    Length_Vector := gCalculation_Area_Vector_Concat.length()</l>
<l>    gCalculation_Area_Vector_Concat.at(Length_Vector) := Area</l>
<c>    </c>
<l>    if (Length_Vector = 999)</l>
<l>        Prefix := 'Kapsel2-GutMitFremdprodukt'</l>
<l>        Write_TupleTestData_ToFile (Prefix+ 'FarbeEins.reg', gCalculation_Colour_Mean_Red_Vector_Concat)</l>
<l>        Write_TupleTestData_ToFile (Prefix+'FarbeZwei.reg', gCalculation_Colour_Mean_Green_Vector_Concat)</l>
<l>        Write_TupleTestData_ToFile (Prefix+'FarbeDrei.reg', gCalculation_Colour_Mean_Blue_Vector_Concat)</l>
<l>        Write_TupleTestData_ToFile (Prefix+'Laenge.reg', gCalculation_Width_Vector_Concat)  </l>
<l>        Write_TupleTestData_ToFile (Prefix+'Diagonale.reg', gCalculation_Diameter_Vector_Concat)</l>
<l>        Write_TupleTestData_ToFile (Prefix+'Flaeche.reg', gCalculation_Area_Vector_Concat)</l>
<l>        dev_get_window (WindowHandle)</l>
<l>        dump_window (WindowHandle, 'jpeg', 'C:/Catalent/' + Prefix + 'MessBild.jpg')</l>
<l>*         stop()</l>
<l>    endif</l>
<l>endifreturn ()</l>
</body>
<docu id="LogProcessingResults">
<parameters>
<parameter id="Calculation_Area_Vector"/>
<parameter id="Calculation_Colour_Mean_Blue_Vector"/>
<parameter id="Calculation_Colour_Mean_Green_Vector"/>
<parameter id="Calculation_Colour_Mean_Red_Vector"/>
<parameter id="Calculation_Width_Vector"/>
</parameters>
</docu>
</procedure>
<procedure name="MergeMultipleEjectsInSlowDownPhase">
<interface>
<ic>
<par name="EjectQueue_In" base_type="ctrl" dimension="0"/>
</ic>
<oc>
<par name="EjectQueue_Out" base_type="ctrl" dimension="0"/>
</oc>
</interface>
<body>
<l>EjectQueue_Out := []</l>
<c>* Check if in eject queu multiple ejects were generated - typically in slow down phase- and merge same eject events to one</c>
<l>tuple_length (EjectQueue_In, EjectQueue_In_Length)</l>
<l>MarkerToSeachFor := -1</l>
<l>tuple_sort (EjectQueue_In, EjectQueue_In)</l>
<l>for Index := 0 to EjectQueue_In_Length-1 by 1</l>
<l>    QueueValue := EjectQueue_In[Index]</l>
<l>    if (MarkerToSeachFor # QueueValue)</l>
<l>        MarkerToSeachFor := QueueValue</l>
<l>        tuple_concat (EjectQueue_Out, MarkerToSeachFor, EjectQueue_Out)</l>
<l>    endif</l>
<l>endfor</l>
<l>return ()</l>
</body>
<docu id="MergeMultipleEjectsInSlowDownPhase">
<parameters>
<parameter id="EjectQueue_In"/>
<parameter id="EjectQueue_Out"/>
</parameters>
</docu>
</procedure>
<procedure name="ProcessCountercheck">
<interface>
<io>
<par name="ImageOrig" base_type="iconic" dimension="0"/>
<par name="RinnenROIs" base_type="iconic" dimension="0"/>
<par name="EjectROIs" base_type="iconic" dimension="0"/>
<par name="ShiftRegisterVector_Good_Bad_ObjectsLastFrame" base_type="iconic" dimension="3"/>
<par name="ThreadUpstreamResults" base_type="iconic" dimension="1"/>
<par name="Shiftregister_VThread_VEjectROI_Adapted" base_type="iconic" dimension="2"/>
</io>
<oo>
<par name="ImageOrig_RGB" base_type="iconic" dimension="0"/>
</oo>
<ic>
<par name="IndexRinnenUndEjects" base_type="ctrl" dimension="0"/>
<par name="ColourClassificationHandle" base_type="ctrl" dimension="0"/>
<par name="ProcessingThreadNumber" base_type="ctrl" dimension="0"/>
<par name="WindowHandle" base_type="ctrl" dimension="0"/>
<par name="EjectToCountercheck" base_type="ctrl" dimension="0"/>
<par name="LanesPerThreadsVector" base_type="ctrl" dimension="1"/>
<par name="TeachInMode" base_type="ctrl" dimension="0"/>
</ic>
<oc>
<par name="TimeNeeded_CompleteProcessing" base_type="ctrl" dimension="0"/>
<par name="EjectOK" base_type="ctrl" dimension="0"/>
</oc>
</interface>
<body>
<l>global tuple dict_TabletInspection</l>
<l>global tuple dict_Calibration</l>
<l>global tuple vector(3) gCalibration_VTCamera_VTLane_VTPixToMM_XY</l>
<c></c>
<l>count_seconds (Seconds_Start)</l>
<c>* general assignments</c>
<c>* </c>
<c>* selection of objects to work on</c>
<l>select_obj (EjectROIs, EjectROI_ToCheck, EjectToCountercheck+1)</l>
<c>* </c>
<c>* **********************************************************************************************************</c>
<c>* start the processing here</c>
<c>*****************************************************************************</c>
<c></c>
<l>dict_TeachIn := dict_TabletInspection.TeachIn</l>
<l>IgnoreObjectsInEjectboxesForTeachIn := dict_TeachIn.V_IgnoreObjectsInEjectboxesForTeachIn.Value</l>
<l>TabletSpot_FeatureActive := dict_TabletInspection.Measure_ProductSpot.V_FeatureActive.Value  </l>
<c></c>
<l>Calibration_FeatureActive := dict_Calibration.V_FeatureActive.Value</l>
<l>Camera_DeviceNumberUsedForGrabbing :=GrabImageMetaData.Camera_DeviceNumberUsedForGrabbing</l>
<l>if (Camera_DeviceNumberUsedForGrabbing = 'ProductImage0000.tif')</l>
<l>    Camera_DeviceNumberUsedForGrabbing := 0</l>
<l>endif</l>
<l>Calibration_VTLane_VTPixToMM_XY := gCalibration_VTCamera_VTLane_VTPixToMM_XY.at(Camera_DeviceNumberUsedForGrabbing) // todo muss da eine Spur dazu?</l>
<c></c>
<l>gen_empty_obj (Preprocessed_SegmentedTablets)</l>
<l>Preprocessed_SegmentedTablets_WasPrecalculated := 0</l>
<l>gCalculate_SegmentationValues (dict_TabletInspection.Segmentation, SegmentationThreshold, PreprocessingOpeningWidth, PreprocessingOpeningHeight, PreprocessingMinAreaFilter, ProductSplittingMode, ProductSplittingMode1_SeperationThreshold, Segmentation_ColourSupport_Active, Segmentation_ColourSupport_Threshold_Min, Segmentation_ColourSupport_Threshold_Max, Segmentation_ColourSupport_OpeningAfterSegmentation_MaskSize, Segmentation_ColourSupport_AreaToSelect_MinSize, Segmentation_ColourSupport_Threshold_RedMin, Segmentation_ColourSupport_Threshold_RedMax, Segmentation_SmallestSingleObjectFilter_Area_Min, Segmentation_DarkOnBright0_BrightOnDark_1, Segmentation_DynThreshold_Active, Segmentation_SelectSegmentationImage_BottomLight0_TopLight1_UVLight2)</l>
<l>gSegmentation_Thresholding_ColourClassification (RinnenROIs, EjectROIs, ImageOrig, Preprocessed_SegmentedTablets, SegmentedTablets_LineSpecific, ColourClassifiedTablets_LineSpecific, ImageOrig_Monochrome, ImageOrig_HSV, Lines_ROIsUnion, ImageOrig, GetShiftInBetweenImages_Rollmeasurement_StartpointRegions, WindowHandle, GrabImageMetaData, SegmentationThreshold, Segmentation_ColourSupport_Active, Segmentation_ColourSupport_Threshold_Min, Segmentation_ColourSupport_Threshold_Max, Segmentation_ColourSupport_OpeningAfterSegmentation_MaskSize, Segmentation_ColourSupport_AreaToSelect_MinSize, Segmentation_ColourSupport_Threshold_RedMin, Segmentation_ColourSupport_Threshold_RedMax, Segmentation_SmallestSingleObjectFilter_Area_Min, Segmentation_DarkOnBright0_BrightOnDark_1, Segmentation_DynThreshold_Active, Segmentation_SelectSegmentationImage_BottomLight0_TopLight1_UVLight2, IgnoreObjectsInEjectboxesForTeachIn, 1, ColourClassificationHandle, 1, Preprocessed_SegmentedTablets_WasPrecalculated, TabletSpot_FeatureActive, Calibration_VTLane_VTPixToMM_XY, Calibration_FeatureActive, TimeNeeded_Segmentation_Thresholding_ColourClassification, GrabImageMetaData, Preprocessed_ProductMeasureWidth_SubPix_LineSpecific)</l>
<c></c>
<c>* use max space for countercheck</c>
<l>gen_empty_obj (ObjectsCrossingROIBorder_Concat)</l>
<l>gen_empty_obj (Tablet_Individual)</l>
<c></c>
<l>dict_Backgroundcheck := dict_TabletInspection.Backgroundcheck</l>
<l>gSegmentation_Backgroundcheck_AddFoundObjects (ImageOrig_HSV, RinnenROIs, Tablet_Individual, ObjectsCrossingROIBorder_Concat, Tablet_Individual_InBackground, dict_Backgroundcheck)</l>
<l>union2 (SegmentedTablets_LineSpecific, Tablet_Individual_InBackground, Tablet_Individual)</l>
<c></c>
<l>if(EjectToCountercheck # [])</l>
<l>    select_obj (EjectROIs, EjectROIs_Selected, EjectToCountercheck[0]+1)</l>
<c>    * reduce size of EjectROI to prevent deadlock</c>
<l>    smallest_rectangle1 (EjectROIs_Selected, EjectROIs_Selected_Row1, EjectROIs_Selected_Column1, EjectROIs_Selected_Row2, EjectROIs_Selected_Column2)</l>
<l>*     gen_rectangle1 (EjectROIs_Selected, (Row2-Row1)/3 + Row1, Column1, Row2-40, Column2)</l>
<c>    *reduce eject roi by one 5th from top as well from botton. </c>
<l>    gen_rectangle1 (EjectROIs_Selected, (EjectROIs_Selected_Row2 - EjectROIs_Selected_Row1)/5 + EjectROIs_Selected_Row1, EjectROIs_Selected_Column1, EjectROIs_Selected_Row2 - (EjectROIs_Selected_Row2 - EjectROIs_Selected_Row1)/5, EjectROIs_Selected_Column2)</l>
<c>    * </c>
<l>    gFindTupleValuePositionsInVector (LanesPerThreadsVector, EjectToCountercheck[0], FoundVectorIndex, FoundTupleIndex)</l>
<c>    </c>
<l>    EjectCounterCheckRegionAdapted := 0</l>
<l>*     stop()</l>
<c>    * if adapted eject was found use it a countercheck region</c>
<l>    if ((FoundVectorIndex # -1 and FoundTupleIndex # -1) and EjectCounterCheckRegionAdapted == 1)</l>
<l>        EjectROIs_Selected := Shiftregister_VThread_VEjectROI_Adapted.at(FoundVectorIndex).at(FoundTupleIndex)</l>
<c>        * when ejectroi adapted is too far away from eject box it has to be moved back to it- otherwise eject mechanism can not reject product and counter check control will fail </c>
<c></c>
<c>******** ToDo Activate for Abbott</c>
<l>        smallest_rectangle1 (EjectROIs_Selected, EjectROIs_Adapted_Row1, EjectROIs_Adapted_Column1, EjectROIs_Adapted_Row2, EjectROIs_Adapted_Column2)</l>
<l>        Delta_Adapted_To_Reduced_EjectROI := EjectROIs_Adapted_Row2 - EjectROIs_Selected_Row2</l>
<l>        tuple_abs (Delta_Adapted_To_Reduced_EjectROI, Abs)</l>
<l>        if(Abs &gt; 80) // todo: Wert vergrößern?</l>
<l>            gen_rectangle1 (EjectROIs_Selected, ((EjectROIs_Adapted_Row2 - EjectROIs_Adapted_Row1)/5 + EjectROIs_Adapted_Row1) -  Delta_Adapted_To_Reduced_EjectROI, EjectROIs_Adapted_Column1, (EjectROIs_Adapted_Row2 - (EjectROIs_Adapted_Row2 - EjectROIs_Adapted_Row1)/5) -  Delta_Adapted_To_Reduced_EjectROI, EjectROIs_Adapted_Column2)</l>
<l>        endif</l>
<l>    endif</l>
<c></c>
<l>endif</l>
<c>* </c>
<l>intersection (EjectROIs_Selected, Tablet_Individual, TabletsStillInEjectPosition)</l>
<l>erosion_circle (TabletsStillInEjectPosition, TabletsStillInEjectPosition, 12.5)</l>
<l>area_center (TabletsStillInEjectPosition, Area, _, _)</l>
<c></c>
<l>if (Area = 0 or Area = [])</l>
<c>    * OK, no product in ejectposition found</c>
<l>    EjectOK := 1</l>
<l>else</l>
<c>    * NOK, there is still something</c>
<l>    EjectOK := 0</l>
<l>endif</l>
<c>* </c>
<l>count_seconds (Seconds_End)</l>
<l>TimeNeeded_CompleteProcessing := (Seconds_End-Seconds_Start) * 1000</l>
<l>return ()</l>
</body>
<docu id="ProcessCountercheck">
<parameters>
<parameter id="ColourClassificationHandle"/>
<parameter id="EjectOK"/>
<parameter id="EjectROIs"/>
<parameter id="EjectToCountercheck"/>
<parameter id="ImageOrig"/>
<parameter id="ImageOrig_RGB"/>
<parameter id="IndexRinnenUndEjects"/>
<parameter id="LanesPerThreadsVector"/>
<parameter id="ProcessingThreadNumber"/>
<parameter id="RinnenROIs"/>
<parameter id="ShiftRegisterVector_Good_Bad_ObjectsLastFrame"/>
<parameter id="Shiftregister_VThread_VEjectROI_Adapted"/>
<parameter id="TeachInMode"/>
<parameter id="ThreadUpstreamResults"/>
<parameter id="TimeNeeded_CompleteProcessing"/>
<parameter id="WindowHandle"/>
</parameters>
</docu>
</procedure>
<procedure name="ProcessMiddle">
<interface>
<io>
<par name="ImageOrig" base_type="iconic" dimension="0"/>
<par name="RinnenROIs" base_type="iconic" dimension="0"/>
<par name="EjectROIs" base_type="iconic" dimension="0"/>
<par name="Preprocessed_SegmentedTablets" base_type="iconic" dimension="0"/>
</io>
<oo>
<par name="Tablet_Individual" base_type="iconic" dimension="0"/>
<par name="SegmentedTablets_LineSpecific" base_type="iconic" dimension="0"/>
</oo>
<ic>
<par name="GrabImageMetaData" base_type="ctrl" dimension="0"/>
<par name="IndexRinnenUndEjects" base_type="ctrl" dimension="0"/>
<par name="ColourClassificationHandle" base_type="ctrl" dimension="0"/>
<par name="ProcessingThreadNumber" base_type="ctrl" dimension="0"/>
<par name="WindowHandle" base_type="ctrl" dimension="0"/>
</ic>
<oc>
<par name="TimeNeeded_CompleteProcessing" base_type="ctrl" dimension="0"/>
</oc>
</interface>
<body>
<l>global tuple gThread_RGB_Threshold_Active</l>
<l>global tuple vector(3) gCalibration_VTCamera_VTLane_VTPixToMM_XY</l>
<l>global tuple dict_TabletInspection</l>
<l>global tuple dict_Calibration</l>
<c></c>
<c></c>
<l>count_seconds (Seconds_Start)</l>
<c>* ******************************************</c>
<c></c>
<c>* Segmentation Settings</c>
<l>dict_Backgroundcheck := dict_TabletInspection.Backgroundcheck</l>
<l>dict_TeachIn := dict_TabletInspection.TeachIn</l>
<l>IgnoreObjectsInEjectboxesForTeachIn := dict_TeachIn.V_IgnoreObjectsInEjectboxesForTeachIn.Value</l>
<l>gCalculate_SegmentationValues (dict_TabletInspection.Segmentation, SegmentationThreshold, PreprocessingOpeningWidth, PreprocessingOpeningHeight, PreprocessingMinAreaFilter, ProductSplittingMode, ProductSplittingMode1_SeperationThreshold, Segmentation_ColourSupport_Active, Segmentation_ColourSupport_Threshold_Min, Segmentation_ColourSupport_Threshold_Max, Segmentation_ColourSupport_OpeningAfterSegmentation_MaskSize, Segmentation_ColourSupport_AreaToSelect_MinSize, Segmentation_ColourSupport_Threshold_RedMin, Segmentation_ColourSupport_Threshold_RedMax, Segmentation_SmallestSingleObjectFilter_Area_Min, Segmentation_DarkOnBright0_BrightOnDark_1, Segmentation_DynThreshold_Active, Segmentation_SelectSegmentationImage_BottomLight0_TopLight1_UVLight2)</l>
<c></c>
<c></c>
<c>* ******************************************</c>
<l>gen_empty_obj (EmptyObject)</l>
<l>Products_IMeasuredRegionsPerFeature.at(0) := EmptyObject</l>
<c></c>
<c>* set flag that segmentation was precalculated in upstream thread</c>
<l>Preprocessed_SegmentedTablets_WasPrecalculated := gThread_RGB_Threshold_Active</l>
<c>* get camera device that was used for image generation. important for camera calibration</c>
<l>Camera_DeviceNumberUsedForGrabbing := GrabImageMetaData.Camera_DeviceNumberUsedForGrabbing</l>
<l>Calibration_VTLane_VTPixToMM_XY := gCalibration_VTCamera_VTLane_VTPixToMM_XY.at(Camera_DeviceNumberUsedForGrabbing)</l>
<c></c>
<l>TabletSpot_FeatureActive := dict_TabletInspection.Measure_ProductSpot.V_FeatureActive.Value</l>
<l>Calibration_FeatureActive := dict_Calibration.V_FeatureActive.Value</l>
<c>* </c>
<c>* selection of objects to work on</c>
<l>select_obj (RinnenROIs, RinnenROIs, IndexRinnenUndEjects[ProcessingThreadNumber])</l>
<l>select_obj (EjectROIs, EjectROIs, IndexRinnenUndEjects[ProcessingThreadNumber])</l>
<c>* </c>
<c>* **********************************************************************************************************</c>
<c>* start the processing here</c>
<c>* </c>
<l>gSegmentation_Thresholding_ColourClassification (RinnenROIs, EjectROIs, ImageOrig, Preprocessed_SegmentedTablets, SegmentedTablets_LineSpecific, ColourClassifiedTablets_LineSpecific, ImageOrig_Monochrome, ImageOrig_HSV, EjectROIs_Union, ImageOrig, GetShiftInBetweenImages_Rollmeasurement_StartpointRegions, WindowHandle, GrabImageMetaData, SegmentationThreshold, Segmentation_ColourSupport_Active, Segmentation_ColourSupport_Threshold_Min, Segmentation_ColourSupport_Threshold_Max, Segmentation_ColourSupport_OpeningAfterSegmentation_MaskSize, Segmentation_ColourSupport_AreaToSelect_MinSize, Segmentation_ColourSupport_Threshold_RedMin, Segmentation_ColourSupport_Threshold_RedMax, Segmentation_SmallestSingleObjectFilter_Area_Min, Segmentation_DarkOnBright0_BrightOnDark_1, Segmentation_DynThreshold_Active, Segmentation_SelectSegmentationImage_BottomLight0_TopLight1_UVLight2, IgnoreObjectsInEjectboxesForTeachIn, 1, ColourClassificationHandle, 1, Preprocessed_SegmentedTablets_WasPrecalculated, TabletSpot_FeatureActive, Calibration_VTLane_VTPixToMM_XY, Calibration_FeatureActive, TimeNeeded_Segmentation_Thresholding_ColourClassification, GrabImageMetaData, Preprocessed_ProductMeasureWidth_SubPix_LineSpecific)</l>
<c></c>
<l>gDebug_StopOptions_Counterbased ([], [], [], [], DebugProcessingCounter) </l>
<c></c>
<l>TabletLength_InMovementDirection := dict_TeachIn.V_ProductLength_InMovementDirection.Value</l>
<c>* </c>
<l>SplitIntoSingleTablets_Active := 1</l>
<l>gSplitIntoSingleTablets (ImageOrig_HSV, RinnenROIs, SegmentedTablets_LineSpecific, Tablet_Individual, ObjectsCrossingROIBorder_Concat, SplitIntoSingleTablets_Active, TabletLength_InMovementDirection, SegmentationThreshold, 'horizontal', IndexRinnenUndEjects, ProductSplittingMode, PreprocessingOpeningWidth, PreprocessingOpeningHeight, PreprocessingMinAreaFilter, ProductSplittingMode1_SeperationThreshold, TimeNeeded_SplittingTablets)</l>
<l>gSegmentation_Backgroundcheck_AddFoundObjects (ImageOrig_HSV, RinnenROIs, Tablet_Individual, ObjectsCrossingROIBorder_Concat, Tablet_Individual, dict_Backgroundcheck)</l>
<c></c>
<c>* method to illiminate printed objects having impact onto object hull</c>
<l>closing_circle (Tablet_Individual, Tablet_Individual, 3.5)</l>
<l>select_shape (Tablet_Individual, Tablet_Individual, 'area', 'and', 1, 999999999)</l>
<c></c>
<l>count_seconds (Seconds_End)</l>
<l>TimeNeeded_CompleteProcessing := (Seconds_End-Seconds_Start) * 1000</l>
<l>return ()</l>
</body>
<docu id="ProcessMiddle">
<parameters>
<parameter id="ColourClassificationHandle"/>
<parameter id="EjectROIs"/>
<parameter id="GrabImageMetaData"/>
<parameter id="ImageOrig"/>
<parameter id="IndexRinnenUndEjects"/>
<parameter id="Preprocessed_SegmentedTablets"/>
<parameter id="ProcessingThreadNumber"/>
<parameter id="RinnenROIs"/>
<parameter id="SegmentedTablets_LineSpecific"/>
<parameter id="Tablet_Individual"/>
<parameter id="TimeNeeded_CompleteProcessing"/>
<parameter id="WindowHandle"/>
</parameters>
</docu>
</procedure>
<procedure name="ProcessMovementDetectionAtEject">
<interface>
<io>
<par name="ImageOrig" base_type="iconic" dimension="0"/>
<par name="RinnenROIs" base_type="iconic" dimension="0"/>
<par name="EjectROIs" base_type="iconic" dimension="0"/>
<par name="ShiftRegisterVector_Good_Bad_ObjectsLastFrame" base_type="iconic" dimension="2"/>
<par name="ProductsToTrackInLastFrame" base_type="iconic" dimension="0"/>
<par name="ThreadUpstreamResults" base_type="iconic" dimension="1"/>
</io>
<oo>
<par name="ImageOrig_RGB" base_type="iconic" dimension="0"/>
<par name="ProductsToTrack" base_type="iconic" dimension="0"/>
</oo>
<ic>
<par name="GrabImageMetaData" base_type="ctrl" dimension="0"/>
<par name="IndexRinnenUndEjects" base_type="ctrl" dimension="0"/>
<par name="ColourClassificationHandle" base_type="ctrl" dimension="0"/>
<par name="ProcessingThreadNumber" base_type="ctrl" dimension="0"/>
<par name="WindowHandle" base_type="ctrl" dimension="0"/>
<par name="EjectToCountercheck" base_type="ctrl" dimension="0"/>
<par name="WorkOnFramegrabber_Enable" base_type="ctrl" dimension="0"/>
<par name="IO_EjectLengthExtensionNecessary_In" base_type="ctrl" dimension="0"/>
<par name="TeachInMode" base_type="ctrl" dimension="0"/>
</ic>
<oc>
<par name="TimeNeeded_CompleteProcessing" base_type="ctrl" dimension="0"/>
<par name="IO_EjectLengthExtensionNecessary" base_type="ctrl" dimension="0"/>
</oc>
</interface>
<body>
<l>global tuple dict_TabletInspection</l>
<l>global tuple dict_Calibration</l>
<c></c>
<l>global tuple gThread_Middle_Active     </l>
<l>global tuple vector(3) gCalibration_VTCamera_VTLane_VTPixToMM_XY</l>
<c>      </c>
<c>      </c>
<c></c>
<c></c>
<l>IO_EjectLengthExtensionNecessary := IO_EjectLengthExtensionNecessary_In</l>
<c>* </c>
<l>count_seconds (Seconds_Start)</l>
<c>* general assignments</c>
<c>* </c>
<c>* selection of objects to work on</c>
<l>select_obj (RinnenROIs, RinnenROIs, EjectToCountercheck[0]+1)</l>
<l>select_obj (EjectROIs, EjectROIs, EjectToCountercheck[0]+1)</l>
<c>* </c>
<c>* **********************************************************************************************************</c>
<c>* start the processing here</c>
<l>TimeNeeded_CFA_To_RGB := 0</l>
<l>if (gThread_Middle_Active)</l>
<c>    </c>
<l>    Tablet_Individual := ThreadUpstreamResults.at(0)</l>
<l>    ColourClassifiedTablets_LineSpecific := ThreadUpstreamResults.at(1)</l>
<l>*     count_channels (ImageOrig, Channels)</l>
<c>    * </c>
<l>*     if (Channels &gt;= 6)</l>
<l>*         decompose6 (ImageOrig, Red, Green, Blue, Hue, Saturation, Value)</l>
<l>*         compose3 (Red, Green, Blue, ImageOrig_RGB)</l>
<l>*         compose3 (Hue, Saturation, Value, ImageOrig_HSV)</l>
<l>*     endif</l>
<l>else</l>
<c>    </c>
<l>    dict_TeachIn := dict_TabletInspection.TeachIn</l>
<l>    IgnoreObjectsInEjectboxesForTeachIn := dict_TeachIn.V_IgnoreObjectsInEjectboxesForTeachIn.Value</l>
<l>    TabletSpot_FeatureActive := dict_TabletInspection.Measure_ProductSpot.V_FeatureActive.Value  </l>
<c>    </c>
<l>    Calibration_FeatureActive := dict_Calibration.V_FeatureActive.Value</l>
<l>    Camera_DeviceNumberUsedForGrabbing :=GrabImageMetaData.Camera_DeviceNumberUsedForGrabbing</l>
<l>    if (Camera_DeviceNumberUsedForGrabbing = 'ProductImage0000.tif')</l>
<l>        Camera_DeviceNumberUsedForGrabbing := 0</l>
<l>    endif</l>
<l>    Calibration_VTLane_VTPixToMM_XY := gCalibration_VTCamera_VTLane_VTPixToMM_XY.at(Camera_DeviceNumberUsedForGrabbing) // todo muss da eine Spur dazu?</l>
<c>    </c>
<l>    gen_empty_obj (Preprocessed_SegmentedTablets)</l>
<l>    Preprocessed_SegmentedTablets_WasPrecalculated := 0</l>
<l>    gCalculate_SegmentationValues (dict_TabletInspection.Segmentation, SegmentationThreshold, PreprocessingOpeningWidth, PreprocessingOpeningHeight, PreprocessingMinAreaFilter, ProductSplittingMode, ProductSplittingMode1_SeperationThreshold, Segmentation_ColourSupport_Active, Segmentation_ColourSupport_Threshold_Min, Segmentation_ColourSupport_Threshold_Max, Segmentation_ColourSupport_OpeningAfterSegmentation_MaskSize, Segmentation_ColourSupport_AreaToSelect_MinSize, Segmentation_ColourSupport_Threshold_RedMin, Segmentation_ColourSupport_Threshold_RedMax, Segmentation_SmallestSingleObjectFilter_Area_Min, Segmentation_DarkOnBright0_BrightOnDark_1, Segmentation_DynThreshold_Active, Segmentation_SelectSegmentationImage_BottomLight0_TopLight1_UVLight2)</l>
<l>    gSegmentation_Thresholding_ColourClassification (RinnenROIs, EjectROIs, ImageOrig, Preprocessed_SegmentedTablets, SegmentedTablets_LineSpecific, ColourClassifiedTablets_LineSpecific, ImageOrig_Monochrome, ImageOrig_HSV, Lines_ROIsUnion, ImageOrig, GetShiftInBetweenImages_Rollmeasurement_StartpointRegions, WindowHandle, GrabImageMetaData, SegmentationThreshold, Segmentation_ColourSupport_Active, Segmentation_ColourSupport_Threshold_Min, Segmentation_ColourSupport_Threshold_Max, Segmentation_ColourSupport_OpeningAfterSegmentation_MaskSize, Segmentation_ColourSupport_AreaToSelect_MinSize, Segmentation_ColourSupport_Threshold_RedMin, Segmentation_ColourSupport_Threshold_RedMax, Segmentation_SmallestSingleObjectFilter_Area_Min, Segmentation_DarkOnBright0_BrightOnDark_1, Segmentation_DynThreshold_Active, Segmentation_SelectSegmentationImage_BottomLight0_TopLight1_UVLight2, IgnoreObjectsInEjectboxesForTeachIn, 1, ColourClassificationHandle, 1, Preprocessed_SegmentedTablets_WasPrecalculated, TabletSpot_FeatureActive, Calibration_VTLane_VTPixToMM_XY, Calibration_FeatureActive, TimeNeeded_Segmentation_Thresholding_ColourClassification, GrabImageMetaData, Preprocessed_ProductMeasureWidth_SubPix_LineSpecific)</l>
<c>    </c>
<l>    Feature_Active := 1</l>
<l>    TabletLength_InMovementDirection := dict_TeachIn.V_ProductLength_InMovementDirection.Value</l>
<l>    gSplitIntoSingleTablets (ImageOrig_HSV, RinnenROIs, SegmentedTablets_LineSpecific, Tablet_Individual, ObjectsCrossingROIBorder_Concat, Feature_Active, TabletLength_InMovementDirection, SegmentationThreshold, 'horizontal', IndexRinnenUndEjects, ProductSplittingMode, PreprocessingOpeningWidth, PreprocessingOpeningHeight, PreprocessingMinAreaFilter, ProductSplittingMode1_SeperationThreshold, TimeNeeded_SplittingTablets)</l>
<c>    </c>
<l>    dict_Backgroundcheck := dict_TabletInspection.Backgroundcheck</l>
<l>    gSegmentation_Backgroundcheck_AddFoundObjects (ImageOrig_HSV, RinnenROIs, Tablet_Individual, ObjectsCrossingROIBorder_Concat, Tablet_Individual, dict_Backgroundcheck)</l>
<c></c>
<c>    * method to illiminate printed objects having impact onto object hull</c>
<l>    closing_circle (Tablet_Individual, Tablet_Individual, 3.5)</l>
<l>    select_shape (Tablet_Individual, Tablet_Individual, 'area', 'and', 1, 999999999)</l>
<c>    </c>
<c>    * the following 4 lines are not part of the original Sort Secure code but might be usefull to replace the part after endif</c>
<l>*     get_dict_param (dict_GrabImageMetaData, 'key_exists', 'RollSpeed360_Mean', RollSpeed_exists)</l>
<l>*     if (not(RollSpeed_exists))</l>
<l>*         dict_GrabImageMetaData.RollSpeed360_Mean := []</l>
<l>*     endif</l>
<c></c>
<l>endif</l>
<c></c>
<c></c>
<c>* todo: wofür ist dieser Teil? Sieht Count Secure-spezifisch aus (wegen unterschiedlich schneller Objekte?). Wird das gebraucht?</c>
<l>closing_circle (Tablet_Individual, Tablet_Individual, 15.5)</l>
<l>smallest_rectangle1 (EjectROIs, Row1, Column1, Row2, Column2)</l>
<l>gen_rectangle1 (ExtensionSpeedDetection, Row1-300, (Column2-Column1)/2 + Column1 -30, Row1 -80, (Column2-Column1)/2 + Column1 +30)</l>
<c>* select the tablets to track- done via region runs due to these are shure a part of the object region</c>
<l>intersection (Tablet_Individual, ExtensionSpeedDetection, TabletsCandidates)</l>
<l>select_shape (TabletsCandidates, TabletsCandidates, 'area', 'and', 1, 99999999)</l>
<l>count_obj (TabletsCandidates, TabletsCandidates_Number)</l>
<l>gen_empty_obj (ProductsToTrack)</l>
<l>for IndexLoop := 1 to TabletsCandidates_Number by 1</l>
<l>    select_obj (TabletsCandidates, TabletPartSelected, IndexLoop)</l>
<l>    get_region_runs (TabletPartSelected, Row, ColumnBegin, ColumnEnd)</l>
<l>    get_region_index (Tablet_Individual, Row[0], ColumnBegin[0], Index)</l>
<l>    select_obj (Tablet_Individual, Tablet_Selected, Index)</l>
<c>    * only use the upper half to track due to the lower hals could be affected by eject handling in the picture</c>
<l>    smallest_rectangle1 (Tablet_Selected, Row11, Column11, Row21, Column21)</l>
<l>    gen_rectangle1 (Tablet_Selected_UpperHalf, Row11, Column11, (Row21-Row11)/1.6 + Row11, Column21)</l>
<l>    intersection (Tablet_Selected_UpperHalf, Tablet_Selected, Tablet_Selected_UpperHalf)</l>
<c>    * </c>
<l>    concat_obj (ProductsToTrack, Tablet_Selected_UpperHalf, ProductsToTrack)</l>
<l>endfor</l>
<c></c>
<c>* multiple products to track may lead to a deadlock- the following line avoids this</c>
<l>union1 (ProductsToTrack, ProductsToTrack)</l>
<c></c>
<c>* </c>
<l>gObjectMovementEstimation_V4 (ProductsToTrack, ProductsToTrackInLastFrame, ImageOrig, 0, ObjectMovement, ObjectMovement_PerProduct)</l>
<c></c>
<c>* ObjectMovementEstimation_V2 (ProductsToTrack, ProductsToTrackInLastFrame, ImageOrig, 0, ObjectMovement, ObjectMovement_PerProduct)</c>
<c>* use the individual ObjectMovement_PerProduct due to the tablet close to the physical eject could have a higher speed than other products around</c>
<l>tuple_greater_equal_elem (ObjectMovement_PerProduct, 20, Greatereq)</l>
<l>tuple_sum (Greatereq, ExtendTheEjects)</l>
<c>* special treatment if fast products were sucked in alread</c>
<l>count_obj (ProductsToTrack, ProductsToTrack_Number)</l>
<l>count_obj (ProductsToTrackInLastFrame, ProductsToTrackInLastFrame_Number)</l>
<l>if (ProductsToTrack_Number = 0 and ProductsToTrackInLastFrame_Number &gt; 0)</l>
<l>    IO_EjectLengthExtensionNecessary := 1</l>
<l>endif</l>
<c></c>
<c></c>
<l>if (ExtendTheEjects &gt;= 1)</l>
<l>    IO_EjectLengthExtensionNecessary := 1</l>
<l>endif</l>
<c>* </c>
<l>* Debug := 0</l>
<l>* if(Debug = 1)</l>
<l>*     dev_display (ImageOrig_RGB)</l>
<l>*     dev_display (EjectROIs)</l>
<l>*     dev_display (ExtensionSpeedDetection)</l>
<c>    </c>
<l>*     dev_set_color ('green')</l>
<l>*     dev_display (ProductsToTrack)</l>
<l>*     dev_set_color ('cyan')</l>
<c></c>
<l>*     dev_display (ProductsToTrackInLastFrame)</l>
<l>* endif</l>
<c></c>
<l>count_seconds (Seconds_End)</l>
<l>TimeNeeded_CompleteProcessing := (Seconds_End-Seconds_Start) * 1000</l>
<c>    </c>
<l>return ()</l>
</body>
<docu id="ProcessMovementDetectionAtEject">
<parameters>
<parameter id="ColourClassificationHandle"/>
<parameter id="EjectROIs"/>
<parameter id="EjectToCountercheck"/>
<parameter id="GrabImageMetaData"/>
<parameter id="IO_EjectLengthExtensionNecessary"/>
<parameter id="IO_EjectLengthExtensionNecessary_In"/>
<parameter id="ImageOrig"/>
<parameter id="ImageOrig_RGB"/>
<parameter id="IndexRinnenUndEjects"/>
<parameter id="ProcessingThreadNumber"/>
<parameter id="ProductsToTrack"/>
<parameter id="ProductsToTrackInLastFrame"/>
<parameter id="RinnenROIs"/>
<parameter id="ShiftRegisterVector_Good_Bad_ObjectsLastFrame"/>
<parameter id="TeachInMode"/>
<parameter id="ThreadUpstreamResults"/>
<parameter id="TimeNeeded_CompleteProcessing"/>
<parameter id="WindowHandle"/>
<parameter id="WorkOnFramegrabber_Enable"/>
</parameters>
</docu>
</procedure>
<procedure name="RecognitionPostprocessing">
<interface>
<ic>
<par name="DeepOcrHandle" base_type="ctrl" dimension="0"/>
<par name="DeepOcrResultRecognition" base_type="ctrl" dimension="0"/>
<par name="TargetString" base_type="ctrl" dimension="0"/>
</ic>
<oc>
<par name="IndicesCorrected" base_type="ctrl" dimension="0"/>
<par name="IndicesMissing" base_type="ctrl" dimension="0"/>
<par name="Confidences" base_type="ctrl" dimension="0"/>
<par name="ResultString" base_type="ctrl" dimension="0"/>
<par name="ResultID" base_type="ctrl" dimension="0"/>
</oc>
</interface>
<body>
<c>* RecognitionPostprocessing</c>
<c>* --------------------------------------------------------------------------------------------------</c>
<c></c>
<c></c>
<l>ResultString := DeepOcrResultRecognition.word</l>
<l>ResultID     := -1</l>
<l>IndicesCorrected := []</l>
<l>IndicesMissing   := []</l>
<l>Confidences  := []</l>
<c></c>
<c></c>
<l>try</l>
<c>    </c>
<l>    get_deep_ocr_param (DeepOcrHandle, 'recognition_num_char_candidates', NumCharCandidates)</l>
<c>    </c>
<c>    * Check if targetstring is correct with candidates</c>
<l>    for IdxCharTarget := 0 to strlen(TargetString)-1 by 1</l>
<c>        </c>
<l>*         if (strlen(ResultString) &lt;= IdxCharTarget)</l>
<l>*         return()</l>
<l>*         endif</l>
<l>        if (strlen(ResultString) == 0)</l>
<l>            break</l>
<l>        endif</l>
<c>        </c>
<l>        ResultStringTemp := ResultString</l>
<c>        </c>
<l>        if (|DeepOcrResultRecognition.char_candidates| &gt; IdxCharTarget-|IndicesMissing|)</l>
<l>            Candidates := DeepOcrResultRecognition.char_candidates[IdxCharTarget-|IndicesMissing|]</l>
<l>            Confidence := Candidates.confidence[0]</l>
<l>        endif</l>
<c>        </c>
<c>        </c>
<l>        if (ResultString{IdxCharTarget} != TargetString{IdxCharTarget})</l>
<l>            IndexCorrected := []</l>
<l>            for IdxCandidate := 1 to NumCharCandidates-1 by 1</l>
<l>                if (|DeepOcrResultRecognition.char_candidates| &lt;= IdxCharTarget-|IndicesMissing|)</l>
<l>                    break</l>
<l>                endif</l>
<c>                </c>
<c>                </c>
<l>                Candidate  := Candidates.candidate[IdxCandidate]</l>
<c>                </c>
<l>                if (IdxCharTarget == 0)</l>
<l>                    if(strlen(ResultStringTemp)&gt;1)</l>
<l>                        ResultStringTemp := Candidate + ResultStringTemp{IdxCharTarget+1:strlen(ResultStringTemp)-1}</l>
<l>                    else</l>
<l>                        ResultStringTemp := Candidate</l>
<l>                    endif  </l>
<l>                elseif (strlen(ResultStringTemp) &gt; IdxCharTarget+1)</l>
<l>                    ResultStringTemp := ResultStringTemp{0:IdxCharTarget-1} + Candidate + ResultStringTemp{IdxCharTarget+1:strlen(ResultStringTemp)-1} </l>
<l>                else</l>
<l>                    ResultStringTemp := ResultStringTemp{0:IdxCharTarget-1} + Candidate</l>
<l>                endif </l>
<c>                </c>
<c>                </c>
<l>                if (ResultStringTemp{IdxCharTarget} == TargetString{IdxCharTarget})</l>
<l>                    IndexCorrected := IdxCharTarget</l>
<l>                    Confidence := Candidates.confidence[IdxCandidate]</l>
<l>                    break</l>
<l>                endif</l>
<l>            endfor</l>
<c>            </c>
<c>            </c>
<c>            </c>
<l>            if (|IndicesCorrected| &gt; 0)</l>
<l>                IndicesCorrected := [IndicesCorrected, IndexCorrected]</l>
<l>            else</l>
<l>                IndicesMissing := [IndicesMissing, IdxCharTarget]</l>
<l>                Confidence := -1</l>
<c>                </c>
<l>                ResultStringTemp := ResultString</l>
<l>                Candidate := '_'</l>
<l>                if (IdxCharTarget == 0)</l>
<l>                    if(strlen(ResultStringTemp)&gt;1)</l>
<l>                        ResultStringTemp := Candidate + ResultStringTemp{IdxCharTarget:strlen(ResultStringTemp)-1}</l>
<l>                    else</l>
<l>                        ResultStringTemp := Candidate</l>
<l>                    endif  </l>
<l>                elseif (strlen(ResultStringTemp) &gt; IdxCharTarget+1)</l>
<l>                    ResultStringTemp := ResultStringTemp{0:IdxCharTarget-1} + Candidate + ResultStringTemp{IdxCharTarget+1:strlen(ResultStringTemp)-1} </l>
<l>                else</l>
<l>                    ResultStringTemp := ResultStringTemp{0:IdxCharTarget-1} + Candidate</l>
<l>                endif </l>
<l>            endif</l>
<c>            </c>
<l>        endif</l>
<c>        </c>
<l>        Confidences  := [Confidences, Confidence]</l>
<l>        ResultString := ResultStringTemp</l>
<c>        </c>
<l>    endfor</l>
<c>    </c>
<c></c>
<l>catch (Exception)</l>
<l>    stop()</l>
<l>endtry</l>
<c></c>
<c></c>
<l>NumMatches := regexp_match(TargetString, regexp_replace(ResultString, '_', ''))</l>
<l>if (strlen(ResultString) == 0)</l>
<l>    ResultID := 0</l>
<l>elseif (ResultString == regexp_replace(TargetString, ['.', 'replace_all'], '_'))</l>
<l>    ResultID := 0</l>
<l>elseif (strlen(NumMatches) == strlen(TargetString))</l>
<l>    ResultID := 1</l>
<l>elseif (strlen(NumMatches) == min([2, strlen(TargetString)]))</l>
<l>    ResultID := 3</l>
<c></c>
<l>else</l>
<l>    ResultID := 4</l>
<l>endif   </l>
<c></c>
<c></c>
<c></c>
<l>return ()</l>
</body>
<docu id="RecognitionPostprocessing">
<parameters>
<parameter id="Confidences"/>
<parameter id="DeepOcrHandle"/>
<parameter id="DeepOcrResultRecognition"/>
<parameter id="IndicesCorrected"/>
<parameter id="IndicesMissing"/>
<parameter id="ResultID"/>
<parameter id="ResultString"/>
<parameter id="TargetString"/>
</parameters>
</docu>
</procedure>
<procedure name="ReduceEjectQueueInCaseOfEject">
<interface>
<ic>
<par name="EjectQueuIn" base_type="ctrl" dimension="0"/>
</ic>
<oc>
<par name="EjectQueuOut" base_type="ctrl" dimension="0"/>
</oc>
</interface>
<body>
<l>EjectQueuOut := EjectQueuIn</l>
<l>tuple_length (EjectQueuIn, Length)</l>
<l>if (Length &gt; 0)</l>
<l>    tuple_remove (EjectQueuIn, 0, EjectQueuOut)</l>
<l>endif</l>
<c>* </c>
<l>return ()</l>
</body>
<docu id="ReduceEjectQueueInCaseOfEject">
<parameters>
<parameter id="EjectQueuIn"/>
<parameter id="EjectQueuOut"/>
</parameters>
</docu>
</procedure>
<procedure name="SetIOForEject">
<interface>
<io>
<par name="RinnenROIs" base_type="iconic" dimension="0"/>
<par name="EjectROIs" base_type="iconic" dimension="0"/>
<par name="ImageOrig" base_type="iconic" dimension="0"/>
</io>
<ic>
<par name="WindowHandle" base_type="ctrl" dimension="0"/>
<par name="AcqHandle" base_type="ctrl" dimension="0"/>
<par name="Shiftregister_EjectFoundPerLine_Vector" base_type="ctrl" dimension="1"/>
<par name="Shiftregister_EjectGoodFoundPerLine_Vector" base_type="ctrl" dimension="1"/>
<par name="Shiftregister_CriticalInspectionResultFoundPerLine_Vector" base_type="ctrl" dimension="1"/>
<par name="PLC_CommunicationSocket" base_type="ctrl" dimension="0"/>
<par name="ActivateEjectDirectly" base_type="ctrl" dimension="0"/>
<par name="EjectQueue" base_type="ctrl" dimension="0"/>
<par name="UseCameraIOsAsDirectEjectSignals" base_type="ctrl" dimension="0"/>
<par name="ProductionLoopCounter" base_type="ctrl" dimension="0"/>
<par name="PLCWatchdogSignal" base_type="ctrl" dimension="0"/>
<par name="MachineEnableInspectionSignal_RunProductionDirectly" base_type="ctrl" dimension="0"/>
<par name="PLC_PulsingmodeConveyorDrive" base_type="ctrl" dimension="0"/>
<par name="LineNumberToSignal" base_type="ctrl" dimension="0"/>
</ic>
<oc>
<par name="Shiftregister_EjectFoundPerLineDigital" base_type="ctrl" dimension="0"/>
<par name="PLCWatchdogSignal_Out" base_type="ctrl" dimension="0"/>
<par name="Shiftregister_CriticalInspectionResultFound" base_type="ctrl" dimension="0"/>
<par name="EjectWasActive" base_type="ctrl" dimension="0"/>
<par name="EjectQueue_Out" base_type="ctrl" dimension="0"/>
<par name="EjectQueueGood" base_type="ctrl" dimension="0"/>
</oc>
</interface>
<body>
<l>global tuple gEjectQueueRecentlyResetted</l>
<l>global tuple dict_Shiftregister</l>
<l>global tuple dict_MachineState</l>
<c></c>
<l>Shiftregister_NumberOfErrorsForEjectMin := dict_Shiftregister.V_NumberOfErrorsForEjectMin.Value</l>
<c></c>
<l>LigghtOnOrOff := 1</l>
<l>CamReady := 1</l>
<l>VibratorReady := 1</l>
<c></c>
<c></c>
<c>* default output</c>
<l>Shiftregister_EjectFoundPerLineDigital := -1</l>
<l>PLCWatchdogSignal_Out := PLCWatchdogSignal</l>
<l>EjectWasActive := 0</l>
<l>EjectQueueGood := []</l>
<c></c>
<c>* check if enough errors were found for ejection</c>
<l>convert_vector_to_tuple (Shiftregister_EjectFoundPerLine_Vector, Shiftregister_EjectFoundPerLine)</l>
<l>tuple_greater_equal_elem (Shiftregister_EjectFoundPerLine, Shiftregister_NumberOfErrorsForEjectMin, Shiftregister_EjectFoundPerLineDigital)</l>
<l>tuple_sum (Shiftregister_EjectFoundPerLineDigital, NumberOfEjectsNecessary)</l>
<c></c>
<c>* check if good products are at eject position and should be transmitted</c>
<l>convert_vector_to_tuple (Shiftregister_EjectGoodFoundPerLine_Vector, Shiftregister_EjectGoodFoundPerLine)</l>
<l>tuple_greater_equal_elem (Shiftregister_EjectGoodFoundPerLine, Shiftregister_NumberOfErrorsForEjectMin, Shiftregister_EjectGoodFoundPerLineDigital)</l>
<l>tuple_sum (Shiftregister_EjectGoodFoundPerLineDigital, SingalGoodObjectsAtEjectPosition)</l>
<c></c>
<c></c>
<c>* </c>
<c>* implementation of eject queue</c>
<l>tuple_find (Shiftregister_EjectFoundPerLineDigital, 1, Indices)</l>
<l>if (Indices # -1)</l>
<l>    tuple_concat (EjectQueue, Indices, EjectQueue)</l>
<l>endif</l>
<c></c>
<c>* implementation of eject queue good</c>
<l>tuple_find (Shiftregister_EjectGoodFoundPerLineDigital, 1, Indices)</l>
<l>if (Indices # -1)</l>
<l>    EjectQueueGood := Indices</l>
<l>endif</l>
<l>MergeMultipleEjectsInSlowDownPhase (EjectQueue, EjectQueue)</l>
<l>EjectQueue_Out := EjectQueue</l>
<l>tuple_length (EjectQueue, EjectNecessary)</l>
<c>* check if critical inspection result was found. e.g. wrong colour</c>
<l>CriticalInspectionResultFound_Check (Shiftregister_CriticalInspectionResultFoundPerLine_Vector, Shiftregister_CriticalInspectionResultFound)</l>
<c>* </c>
<c>* </c>
<l>if ((EjectNecessary &gt;= 1) or Shiftregister_CriticalInspectionResultFound or (SingalGoodObjectsAtEjectPosition &gt;=1))   </l>
<c></c>
<c>    * set an specific signal via plc for each eject</c>
<l>    Shiftregister_SpecifyEjectPort := [0,0,0,0,0,0,0,0] // represents first byte with 8 io's</l>
<l>    Shiftregister_SpecifyGoodPort := [0,0,0,0,0,0,0,0] // represents second byte with 8 io's</l>
<c></c>
<c>    * set eject queue first signal in plc communication or all in one</c>
<l>    if (EjectQueue # [])</l>
<l>        if (UseCameraIOsAsDirectEjectSignals = 0)</l>
<l>            Shiftregister_SpecifyEjectPort[EjectQueue[0]] := 1 // set only first eject signal available in queue</l>
<l>        else</l>
<l>            Shiftregister_SpecifyEjectPort[EjectQueue] := 1 // set all eject signals available in queue at once</l>
<l>        endif</l>
<l>    endif</l>
<l>    if (SingalGoodObjectsAtEjectPosition &gt;=1)</l>
<l>        Shiftregister_SpecifyGoodPort[EjectQueueGood] := 1 // set all eject signals available in queue at once      </l>
<l>    endif</l>
<c>    </c>
<c>    * a line can be good or bad- but never both at once. If good and bad parallel set to bad</c>
<l>    for IndexCnt := 0 to |Shiftregister_SpecifyEjectPort| -1 by 1</l>
<l>        if (Shiftregister_SpecifyEjectPort[IndexCnt] = Shiftregister_SpecifyGoodPort[IndexCnt])</l>
<l>            Shiftregister_SpecifyGoodPort[IndexCnt] := 0</l>
<l>        endif</l>
<l>    endfor</l>
<c>    </c>
<l>    if (1) </l>
<l>* Shiftregister_SpecifyEjectPort := [1, 1, 0, 0, 0, 0, 0, 0]</l>
<c>        * ToDo- Shift of eject signal by 1 lane- both for good and bad signals. Should be fixed on plc side</c>
<l>        tuple_remove (Shiftregister_SpecifyEjectPort, 7, Shiftregister_SpecifyEjectPort)</l>
<l>        tuple_insert (Shiftregister_SpecifyEjectPort, 0, 0, Shiftregister_SpecifyEjectPort)</l>
<l>        tuple_remove (Shiftregister_SpecifyGoodPort, 7, Shiftregister_SpecifyGoodPort)    </l>
<l>        tuple_insert (Shiftregister_SpecifyGoodPort, 0, 0, Shiftregister_SpecifyGoodPort)</l>
<c>        * ToDo- currently signal is for prototype one lane on one plc- signal independand</c>
<l>        for Index_Cnt_IO := 0 to |Shiftregister_SpecifyEjectPort|-1 by 1</l>
<l>            if (Shiftregister_SpecifyEjectPort[Index_Cnt_IO] &gt; 0 or Shiftregister_SpecifyGoodPort[Index_Cnt_IO] &gt; 0)</l>
<l>                tuple_gen_const (|Shiftregister_SpecifyEjectPort|, 0, Shiftregister_SpecifyEjectPort_SingleLineToPLC)</l>
<l>                tuple_gen_const (|Shiftregister_SpecifyGoodPort|, 0, Shiftregister_SpecifyGoodPort_SingleLineToPLC)</l>
<c>                * extract one single signal to plc</c>
<l>                if (Shiftregister_SpecifyEjectPort[Index_Cnt_IO] &gt; 0) </l>
<l>                    Shiftregister_SpecifyEjectPort_SingleLineToPLC[1] := Shiftregister_SpecifyEjectPort[Index_Cnt_IO]</l>
<l>                endif</l>
<l>                if (Shiftregister_SpecifyGoodPort[Index_Cnt_IO] &gt; 0)</l>
<l>                    Shiftregister_SpecifyGoodPort_SingleLineToPLC[1] := Shiftregister_SpecifyGoodPort[Index_Cnt_IO]</l>
<l>                endif</l>
<c>                </c>
<c>                </c>
<c>                * Hint: Index_Cnt_IO-1 is decreased due to eject is shifted by one to the right</c>
<c>                *  </c>
<c>                * Info counter to debug</c>
<l>                global tuple vector(1) gProductCounterGood_LocalThread</l>
<l>                global tuple vector(1) gProductCounterBad_LocalThread</l>
<l>                ProcessingThread := LineNumberToSignal</l>
<l>                tuple_sum (Shiftregister_SpecifyGoodPort_SingleLineToPLC, Sum)  </l>
<l>                gProductCounterGood_LocalThread.at(ProcessingThread) := gProductCounterGood_LocalThread.at(ProcessingThread) + Sum</l>
<l>                tuple_sum (Shiftregister_SpecifyEjectPort_SingleLineToPLC, Sum)</l>
<l>                gProductCounterBad_LocalThread.at(ProcessingThread) := gProductCounterBad_LocalThread.at(ProcessingThread) + Sum</l>
<c>                * todo: wird Bildzahl gebraucht</c>
<l>                gPLC_CommunicationCycle (1, LigghtOnOrOff, PLC_CommunicationSocket[Index_Cnt_IO-1], CamReady, VibratorReady, 0, PLCWatchdogSignal, 0, Shiftregister_CriticalInspectionResultFound, Shiftregister_SpecifyEjectPort_SingleLineToPLC, Shiftregister_SpecifyGoodPort_SingleLineToPLC, 1, PLC_PulsingmodeConveyorDrive, ProductionLoopCounter, 0, LineNumberToSignal, PLCWatchdogSignal_Out)</l>
<l>                Shiftregister_EjectFoundPerLineDigital := [1,0]</l>
<l>            endif</l>
<l>        endfor     </l>
<c></c>
<l>        EjectWasActive := 1</l>
<l>    else</l>
<c></c>
<l>        if (UseCameraIOsAsDirectEjectSignals = 0) // if eject is available</l>
<l>            VibratorReady := 0</l>
<l>        endif  </l>
<l>        gPLC_CommunicationCycle (1, LigghtOnOrOff, PLC_CommunicationSocket, CamReady, VibratorReady, 0, PLCWatchdogSignal, 0, Shiftregister_CriticalInspectionResultFound, Shiftregister_SpecifyEjectPort, Shiftregister_SpecifyGoodPort, 1, PLC_PulsingmodeConveyorDrive, ProductionLoopCounter, 0, LineNumberToSignal, PLCWatchdogSignal_Out)</l>
<l>    endif</l>
<l>    EjectWasActive := 1</l>
<l>    Eject_WaitFramesBeforeEjectPipeCounterOut := 0</l>
<l>else        </l>
<c>    * todo: schauen, ob es gebraucht wird. (Wird bisher in</c>
<l>*     if(dict_MachineState.CurrentMachineState[0] = 1 or dict_MachineState.CurrentMachineState[0] = 5)</l>
<c>        * if started, starting up</c>
<l>*         VibratorReady := 1</l>
<l>*     else</l>
<l>*         VibratorReady := 0</l>
<l>*     endif</l>
<l>*     gPLC_ToggleHeartbeat (PLC_CommunicationSocket, ProductionLoopCounter, 0, PLCWatchdogSignal, VibratorReady, PLCWatchdogSignal_Out)</l>
<l>endif</l>
<c></c>
<c>* </c>
<l>if (EjectQueue = [] and gEjectQueueRecentlyResetted &gt;= 1)</l>
<l>    CurrentMachineAction := dict_MachineState.CurrentMachineState</l>
<l>    if (CurrentMachineState[0] = 4)</l>
<l>        ExternalHardware_MachineState_dict ([], [1, 2], CurrentMachineState, CurrentMachineAction)</l>
<l>    endif</l>
<l>    gEjectQueueRecentlyResetted := gEjectQueueRecentlyResetted +1</l>
<l>endif</l>
<c></c>
<l>return ()</l>
</body>
<docu id="SetIOForEject">
<parameters>
<parameter id="AcqHandle"/>
<parameter id="ActivateEjectDirectly"/>
<parameter id="EjectQueue"/>
<parameter id="EjectQueueGood"/>
<parameter id="EjectQueue_Out"/>
<parameter id="EjectROIs"/>
<parameter id="EjectWasActive"/>
<parameter id="ImageOrig"/>
<parameter id="LineNumberToSignal"/>
<parameter id="MachineEnableInspectionSignal_RunProductionDirectly"/>
<parameter id="PLCWatchdogSignal"/>
<parameter id="PLCWatchdogSignal_Out"/>
<parameter id="PLC_CommunicationSocket"/>
<parameter id="PLC_PulsingmodeConveyorDrive"/>
<parameter id="ProductionLoopCounter"/>
<parameter id="RinnenROIs"/>
<parameter id="Shiftregister_CriticalInspectionResultFound"/>
<parameter id="Shiftregister_CriticalInspectionResultFoundPerLine_Vector"/>
<parameter id="Shiftregister_EjectFoundPerLineDigital"/>
<parameter id="Shiftregister_EjectFoundPerLine_Vector"/>
<parameter id="Shiftregister_EjectGoodFoundPerLine_Vector"/>
<parameter id="UseCameraIOsAsDirectEjectSignals"/>
<parameter id="WindowHandle"/>
</parameters>
</docu>
</procedure>
<procedure name="SetIOForEjectDirectly">
<interface>
<ic>
<par name="PLC_CommunicationSocket" base_type="ctrl" dimension="0"/>
<par name="EjectQueue" base_type="ctrl" dimension="0"/>
<par name="PLCWatchdogSignal" base_type="ctrl" dimension="0"/>
<par name="MachineEnableInspectionSignal_RunProductionDirectly" base_type="ctrl" dimension="0"/>
<par name="ProductionLoopCounter" base_type="ctrl" dimension="0"/>
</ic>
<oc>
<par name="PLCWatchdogSignal_Out" base_type="ctrl" dimension="0"/>
</oc>
</interface>
<body>
<l>global tuple gPLC_ErrorEjectCountercheck</l>
<c></c>
<c>* procedure simply sets io for eject directly- by setting camera singnal and plc signal.</c>
<c>* </c>
<l>PLCWatchdogSignal_Out := PLCWatchdogSignal</l>
<c></c>
<l>LigghtOnOrOff := 1</l>
<l>* TeachIn := MachineEnableInspectionSignal_RunProductionDirectly</l>
<l>TeachIn := 0</l>
<l>CamReady := 1</l>
<l>VibratorReady := 0</l>
<c>* set an specific signal via plc for each eject</c>
<l>Shiftregister_SpecifyEjectPort := [0,0,0,0,0,0,0,0]</l>
<l>Shiftregister_SpecifyEjectPort[EjectQueue[0]] := 1</l>
<l>OptionalTupleToSendInPLCCommunicationQueue := []</l>
<c></c>
<l>gPLC_CommunicationCycle (1, LigghtOnOrOff, PLC_CommunicationSocket, CamReady, VibratorReady, TeachIn, PLCWatchdogSignal, gPLC_ErrorEjectCountercheck, 0, Shiftregister_SpecifyEjectPort, [], 1, 0, OptionalTupleToSendInPLCCommunicationQueue, ProductionLoopCounter, 0, PLCWatchdogSignal_Out)</l>
<c></c>
<c></c>
<l>return ()</l>
</body>
<docu id="SetIOForEjectDirectly">
<parameters>
<parameter id="EjectQueue"/>
<parameter id="MachineEnableInspectionSignal_RunProductionDirectly"/>
<parameter id="PLCWatchdogSignal"/>
<parameter id="PLCWatchdogSignal_Out"/>
<parameter id="PLC_CommunicationSocket"/>
<parameter id="ProductionLoopCounter"/>
</parameters>
</docu>
</procedure>
<procedure name="Shiftregister_RebuildCalc">
<interface>
<ic>
<par name="ControlShiftregister_TriggerRebuild" base_type="ctrl" dimension="0"/>
<par name="ControlShiftregister_TriggerKill" base_type="ctrl" dimension="0"/>
<par name="ProcessingLoopcounter" base_type="ctrl" dimension="0"/>
<par name="Shiftregister_RebuildDataVectorIn" base_type="ctrl" dimension="1"/>
<par name="StepWidth_NumberOfFramesToRebuild" base_type="ctrl" dimension="0"/>
</ic>
<oc>
<par name="Shiftregister_RebuildDataVectorOut" base_type="ctrl" dimension="1"/>
</oc>
</interface>
<body>
<c>* Preperations for BuildingShiftregister</c>
<c>* In the vector data is - first element:</c>
<c>* first tuple element is startcount of rebuildingstep</c>
<c>* -1 is just initialized</c>
<c>* 0 is normal operation - do nothing in shiftregister</c>
<c>* 1 is rebuild shiftregister</c>
<c>* &gt;1 new request for building shiftregister</c>
<c>* second tuple element is kill shiftregister when 1, else 0</c>
<c></c>
<c>* In the vector data is - second element:</c>
<c>* first tuple element is startcount of rebuildingstep</c>
<c>* second tuple element is endcount of rebuildingstep</c>
<l>if(ProcessingLoopcounter = 0)</l>
<c>    * init at startup</c>
<l>    Shiftregister_RebuildDataVectorOut := {[1,ControlShiftregister_TriggerKill],[0,StepWidth_NumberOfFramesToRebuild]}</l>
<l>else</l>
<l>    if (ControlShiftregister_TriggerRebuild = 2)</l>
<c>        * if rebuild it set data</c>
<l>        Shiftregister_RebuildDataVectorOut := {[1,ControlShiftregister_TriggerKill],[ProcessingLoopcounter , ProcessingLoopcounter + StepWidth_NumberOfFramesToRebuild]}</l>
<l>    else</l>
<c>        * if normal operation check if still active (count) or do nothing</c>
<l>        if(Shiftregister_RebuildDataVectorIn.at(0)[0] = 1)</l>
<l>            SecondElementOfVector := Shiftregister_RebuildDataVectorIn.at(1)</l>
<l>            if(SecondElementOfVector[1] = ProcessingLoopcounter)</l>
<c>                * reset to no rebuilding mode</c>
<l>                Shiftregister_RebuildDataVectorOut := {[0,ControlShiftregister_TriggerKill],[-1 , -1]}</l>
<l>            else</l>
<c>                * is still in rebuilding mode</c>
<l>                Shiftregister_RebuildDataVectorOut := Shiftregister_RebuildDataVectorIn</l>
<l>            endif</l>
<l>        else</l>
<l>            Shiftregister_RebuildDataVectorOut := {[0,ControlShiftregister_TriggerKill],[-1 , -1]}</l>
<l>        endif</l>
<l>    endif</l>
<l>endif</l>
<l>return ()</l>
</body>
<docu id="Shiftregister_RebuildCalc">
<parameters>
<parameter id="ControlShiftregister_TriggerKill"/>
<parameter id="ControlShiftregister_TriggerRebuild"/>
<parameter id="ProcessingLoopcounter"/>
<parameter id="Shiftregister_RebuildDataVectorIn"/>
<parameter id="Shiftregister_RebuildDataVectorOut"/>
<parameter id="StepWidth_NumberOfFramesToRebuild"/>
</parameters>
</docu>
</procedure>
<procedure name="Test_Grab_Chunkdata">
<interface/>
<body>
<l>InterfaceType := 'USB3Vision' // 'USB3Vision' 'GigEVision2'</l>
<l>ShowValue := false</l>
<l>Parameter_List := {[]}</l>
<c></c>
<l>info_framegrabber( InterfaceType, 'device', _, htCamList)</l>
<l>GrabBuffer_SizeInFrames := 50</l>
<l>* open_framegrabber (InterfaceType, 0, 0, 0, 0, 0, 0, 'default', -1, 'rgb', [('num_buffers=' + GrabBuffer_SizeInFrames)], 'false', 'default', htCamList[0], 0, -1, AcqHandle)</l>
<l>open_framegrabber (InterfaceType, 0, 0, 0, 0, 0, 0, 'default', -1, 'default', [('num_buffers=' + GrabBuffer_SizeInFrames)], 'false', 'default', htCamList[0], 0, -1, AcqHandle)</l>
<c></c>
<l>grab_image_start (AcqHandle, -1)</l>
<l>dev_set_check ('~give_error')</l>
<l>gen_empty_obj (EmptyObject)</l>
<l>Loopcounter := 0</l>
<l>tpl_cam := []</l>
<l>tpl_chunk := []</l>
<l>tpl_machine := []</l>
<l>Chunk_Missing_Cnt := 0</l>
<c></c>
<l>Framegrabber_Chunkdata_IOState_Current := 0</l>
<l>Framegrabber_Chunkdata_IOState_Last := 0</l>
<l>MachineShiftregister_Index := 0</l>
<l>while(1)</l>
<l>    ImageOrig := EmptyObject</l>
<l>    grab_image_async (ImageOrig, AcqHandle, -1)</l>
<c>    </c>
<l>    get_image_size (ImageOrig, Width, _)</l>
<l>    if(Width # [])</l>
<l>        tpl_cam := [tpl_cam, Loopcounter]</l>
<l>    else</l>
<l>    endif</l>
<l>    get_framegrabber_param(AcqHandle, 'ChunkLineStatusAll', Framegrabber_ChunkData)</l>
<c>    </c>
<l>    if (Framegrabber_ChunkData = [])</l>
<l>        tpl_chunk := [tpl_chunk, '**************Missing Chunk!**************']</l>
<l>        Chunk_Missing_Cnt := Chunk_Missing_Cnt +1</l>
<l>    else</l>
<c></c>
<l>         LineNumber := 3</l>
<l>         Framegrabber_Chunkdata_IOState_Current := (rsh(Framegrabber_ChunkData, LineNumber-1) band 1 ) != 0</l>
<l>         if(Framegrabber_Chunkdata_IOState_Current = 0)</l>
<l>*              stop()</l>
<l>         endif</l>
<l>*          tuple_mod (Loopcounter, 2, Mod)</l>
<l>*         if(Mod = 1)</l>
<l>            tpl_chunk := [tpl_chunk , (' Dat: '+ Framegrabber_Chunkdata_IOState_Current)] // tpl_chunk, Loopcounter, </l>
<l>*         endif</l>
<l>*          tpl_chunk := [tpl_chunk , (' Dat: '+ Framegrabber_ChunkData)] // tpl_chunk, Loopcounter, </l>
<l>    endif</l>
<c>    **************</c>
<l>*     LineNumber := 3</l>
<l>*     Framegrabber_Chunkdata_IOState_Current := (rsh(Framegrabber_Chunkdata_IOState_Current, LineNumber-1) band 1 ) != 0</l>
<l>*     if(Framegrabber_Chunkdata_IOState_Current = 1)</l>
<l>*     stop()</l>
<l>*     endif</l>
<l>    if(Framegrabber_Chunkdata_IOState_Last = 0 and Framegrabber_Chunkdata_IOState_Current = 1)</l>
<l>        Framegrabber_Chunkdata_IOState_Last := 1</l>
<l>        tpl_machine := [tpl_machine , (' MachineShiftregister_Index '+ MachineShiftregister_Index), Loopcounter] // tpl_chunk, Loopcounter, </l>
<c></c>
<l>        MachineShiftregister_Index := MachineShiftregister_Index +1</l>
<l>        if(MachineShiftregister_Index = 256) // MachineShiftregister_Index allowed range is 1-255</l>
<l>            MachineShiftregister_Index := 1</l>
<l>        endif</l>
<l>    endif</l>
<l>    Framegrabber_Chunkdata_IOState_Last := Framegrabber_Chunkdata_IOState_Current</l>
<c>    </c>
<l>    Loopcounter := Loopcounter +1</l>
<l>    if(Loopcounter = 50)</l>
<l>        stop()</l>
<l>    break</l>
<l>endif</l>
<l>endwhile</l>
<l>* set_framegrabber_param (AcqHandle, 'DeviceReset', 1)</l>
<c></c>
<l>close_framegrabber (AcqHandle)</l>
<c></c>
<c></c>
<l>return ()</l>
</body>
<docu id="Test_Grab_Chunkdata">
<parameters/>
</docu>
</procedure>
<procedure name="TestWriteImages">
<interface>
<io>
<par name="ImageOrig" base_type="iconic" dimension="0"/>
</io>
</interface>
<body>
<l>global tuple gCameraNumberUsed</l>
<l>global tuple gProductionLoopCounter</l>
<l>global tuple gStopCounterWrong</l>
<c></c>
<l>DirTest := 'TestImages_'+gCameraNumberUsed</l>
<l>file_exists (DirTest, FileExists1)</l>
<l>if (not FileExists1)</l>
<l>    make_dir (DirTest)</l>
<l>endif</l>
<l>list_image_files (DirTest, 'default', [], ImageFiles)</l>
<l>gen_empty_obj (EmptyObject)</l>
<l>test_equal_obj (ImageOrig, EmptyObject, IsEqual)</l>
<l>if (IsEqual)</l>
<l>    return()</l>
<l>endif</l>
<l>try</l>
<l>    gGrab_Convert_Long_To_MultichannelImage (ImageOrig, ImageOrig)</l>
<l>    access_channel (ImageOrig, Image, 3)</l>
<l>    write_image (Image, 'jpg', 0, DirTest+'/ProductImageCam' + gCameraNumberUsed + '_' +|gProductionLoopCounter|$'.4d' )</l>
<c>    </c>
<l>    if (gStopCounterWrong)</l>
<l>        write_image (ImageOrig, 'tiff', 0, DirTest+'/ProductImageCam' + gCameraNumberUsed + '_' +|gProductionLoopCounter|$'.4d' )</l>
<l>    endif</l>
<c>    </c>
<l>catch (Exception)</l>
<l>endtry</l>
<c></c>
<l>return ()</l>
</body>
<docu id="TestWriteImages">
<parameters>
<parameter id="ImageOrig"/>
</parameters>
</docu>
</procedure>
<procedure name="WriteDumpImage">
<interface>
<io>
<par name="Image" base_type="iconic" dimension="0"/>
<par name="Rollmeasurement" base_type="iconic" dimension="0"/>
<par name="Ejectbox" base_type="iconic" dimension="0"/>
<par name="Shiftregister_Objects_InEjectBox" base_type="iconic" dimension="0"/>
</io>
<ic>
<par name="DirTest" base_type="ctrl" dimension="0"/>
<par name="gRollClock" base_type="ctrl" dimension="0"/>
<par name="gGrabNumber" base_type="ctrl" dimension="0"/>
<par name="GrabImageMetaData" base_type="ctrl" dimension="0"/>
</ic>
</interface>
<body>
<l>global tuple gCameraNumberUsed</l>
<l>global tuple gMachineShiftregister_Index</l>
<l>global object vector(1) gRinnenROIs</l>
<l>global object vector(1) gEjectROIs</l>
<c></c>
<l>gen_empty_obj (EmptyObject)</l>
<l>test_equal_obj (Image, EmptyObject, IsEqual)</l>
<l>if (IsEqual)</l>
<l>    return ()</l>
<l>endif</l>
<c></c>
<l>if (|gCameraNumberUsed|==0)</l>
<l>    return()</l>
<l>endif</l>
<c></c>
<c></c>
<l>try</l>
<l>    access_channel (Image, Image1, 3)</l>
<c>    </c>
<l>    grayval := [255, 0, 0, 255, 0, 0, 255, 0, 0]</l>
<l>    copy_image (Image1, Image2)</l>
<l>    copy_image (Image1, Image3)</l>
<l>    compose3 (Image1, Image2, Image3, Image)</l>
<l>    count_obj (Rollmeasurement, Number)</l>
<l>    ImageResult := Image</l>
<l>    for Idx := 0 to Number-1 by 1</l>
<l>        select_obj (Rollmeasurement, ObjectSelected, Idx+1)</l>
<l>        dilation_rectangle1 (ObjectSelected, RegionDilation, 1, 12)</l>
<l>        paint_region (RegionDilation, ImageResult, ImageResult, grayval, 'fill')</l>
<l>    endfor</l>
<c>    </c>
<l>*     grayval := [0, 200, 0, 255, 200, 100]</l>
<l>*     for Idx := 0 to gRinnenROIs.length()-1 by 1</l>
<l>*     paint_region (gRinnenROIs.at(Idx), ImageResult, ImageResult, grayval, 'margin')</l>
<l>*     paint_region (gEjectROIs.at(Idx), ImageResult, ImageResult, grayval, 'margin')</l>
<l>*     endfor</l>
<l>    grayval := [0,0,255,0,0,255,0,0,255]</l>
<l>    dev_get_window (WindowHandle)</l>
<l>    set_line_width (WindowHandle, 5)</l>
<l>    paint_region (Ejectbox, ImageResult, ImageResult, grayval, 'fill')</l>
<c>    </c>
<l>    count_obj (Shiftregister_Objects_InEjectBox, Number1)</l>
<l>    grayval := [0,255,0,0,255,0,0,255,0]</l>
<l>    for Idx := 0 to Number1-1 by 1</l>
<l>        select_obj (Shiftregister_Objects_InEjectBox, ObjectSelected, Idx+1)</l>
<l>        paint_region (ObjectSelected, ImageResult, ImageResult, grayval, 'fill')</l>
<l>    endfor</l>
<c>    </c>
<l>    get_image_size (ImageResult, Width, Height)</l>
<l>    gen_rectangle1 (Rectangle, 0, 0, Height-1, 20)</l>
<l>    intersection (Rectangle, Ejectbox, RegionIntersection)</l>
<c>    </c>
<l>    area_center (RegionIntersection, Area, Row, Column)</l>
<l>    if (|Area| &gt; 0 )</l>
<l>        EjectROINumber := '01'</l>
<l>    else</l>
<l>        EjectROINumber := '02'</l>
<l>    endif</l>
<c>    </c>
<l>    get_system_time (MSecond, Second, Minute, Hour, Day, YDay, Month, Year)</l>
<l>    Timestamp := Hour+'-'+Minute+'-'+Second+'-'+MSecond</l>
<c>    </c>
<l>    zoom_image_size (ImageResult, ImageResult, 100, 100, 'constant')</l>
<l>*     write_image (ImageResult, 'jpg', 0, DirTest+'/ProductImageCam' + gCameraNumberUsed + '_' +gRollClock$'.4d' + '_' + gGrabNumber$'.4d'+ '_' + EjectROINumber + '_' + Timestamp)</l>
<c>    </c>
<l>    MachineShift := number(split(GrabImageMetaData[2], '=')[1])</l>
<l>    ImageCreationDate := split(GrabImageMetaData[1], '=')[1]</l>
<l>    ImageCreationDate := split(ImageCreationDate, '.')</l>
<l>    ImageCreationDate := ImageCreationDate[0] + '-' + ImageCreationDate[1]</l>
<l>    ImageLoopCounter := number(split(GrabImageMetaData[0], '=')[1])</l>
<l>    write_image (ImageResult, 'jpg', 0, DirTest+'/ProductImageCam' + gCameraNumberUsed + '_' + ImageLoopCounter$'.4d' + '_' + MachineShift$'.4d' + '_' + EjectROINumber)</l>
<c>    </c>
<c>    </c>
<l>catch (Exception)</l>
<l>endtry</l>
<c></c>
<l>return ()</l>
</body>
<docu id="WriteDumpImage">
<parameters>
<parameter id="DirTest"/>
<parameter id="Ejectbox"/>
<parameter id="GrabImageMetaData"/>
<parameter id="Image"/>
<parameter id="Rollmeasurement"/>
<parameter id="Shiftregister_Objects_InEjectBox"/>
<parameter id="gGrabNumber"/>
<parameter id="gRollClock"/>
</parameters>
</docu>
</procedure>
<procedure name="WriteInVectorBufferedImagesToDisk">
<interface>
<ic>
<par name="CameraId" base_type="ctrl" dimension="0"/>
</ic>
</interface>
<body>
<c>* Procedure writes collected images to harddisk</c>
<c></c>
<l>global tuple gWriteProcessImages</l>
<l>global tuple gFilenameProductimage</l>
<l>global tuple gPathnameForImageFile</l>
<l>global object vector(2) gCountercheckimages</l>
<l>* global tuple dict_Camera</l>
<c></c>
<l>if (gWriteProcessImages)</l>
<l>    NumberofCountercheckimages := gCountercheckimages.at(CameraId).length()</l>
<c>    * Procedure implementing/simulating the acquisition thread.</c>
<c></c>
<l>    for Index := 0 to NumberofCountercheckimages-1 by 1</l>
<l>        ImageToWrite := gCountercheckimages.at(CameraId).at(Index)</l>
<l>        get_domain (ImageToWrite, DomainToReduceTo)</l>
<l>        count_channels (ImageToWrite, Channels)</l>
<l>        gDebayer_GrabbedImage_AndColourConversion (ImageToWrite, DomainToReduceTo, ImageToWrite, YUV, ImageOrig_Sequencer, MultiChannel_Image, TimeNeeded, MultiChannelImage_ColourSpaceDescriptor)</l>
<l>        if (Channels # [])// prevent to save empty object</l>
<l>            Filename := gPathnameForImageFile + gFilenameProductimage + Index $'.4d' + '.tif'</l>
<l>            write_image (ImageToWrite, 'tiff', 0, Filename)</l>
<l>        endif</l>
<l>        wait_seconds(0.05)</l>
<l>    endfor</l>
<l>    gCountercheckimages.at(CameraId).clear()</l>
<l>    gWriteProcessImages := 0</l>
<l>endif</l>
<c>* </c>
<l>return ()</l>
</body>
<docu id="WriteInVectorBufferedImagesToDisk">
<parameters>
<parameter id="CameraId"/>
</parameters>
</docu>
</procedure>
</hdevelop>

</oo>
<ic>
<par name="IndexRinnenUndEjects" base_type="ctrl" dimension="0"/>
<par name="ShiftregisterVector_ObjectMovement" base_type="ctrl" dimension="1"/>
<par name="Shiftregister_RemoveBadRegionsInEjectBox" base_type="ctrl" dimension="0"/>
<par name="Shiftregister_Rebuild_Kill" base_type="ctrl" dimension="0"/>
<par name="Shiftregister_Tuple_Lanes_Data" base_type="ctrl" dimension="3"/>
<par name="Products_VT_MeasureResult_MeasureValues" base_type="ctrl" dimension="2"/>
<par name="Indices_BadObjects" base_type="ctrl" dimension="0"/>
<par name="Shiftregister_VLane_VMeasureFeature_TResult_TValue" base_type="ctrl" dimension="3"/>
<par name="Shiftregister_VLane_VImagePartsOffset_TRow_TColumn" base_type="ctrl" dimension="2"/>
<par name="RollSpeed360_Mean" base_type="ctrl" dimension="0"/>
<par name="GrabLoopCounter" base_type="ctrl" dimension="0"/>
</ic>
<oc>
<par name="Shiftregister_EjectFoundPerLine" base_type="ctrl" dimension="0"/>

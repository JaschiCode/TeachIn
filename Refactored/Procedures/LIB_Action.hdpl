<procedure name="gQueuBufferDataTuple">
<interface>
<ic>
<par name="ProcessingThread" base_type="ctrl" dimension="0"/>
<par name="DataToAddVector2Dim" base_type="ctrl" dimension="2"/>
<par name="Result_VLane_ForEverySingleFeature_0Good_1Bad" base_type="ctrl" dimension="1"/>
</ic>
</interface>
<body>
<l>global tuple vector(1) gVTQueue_DataBuffer_ProcessingResults</l>
<l>global tuple vector(1) gVTMessage_DataBuffer_ProcessingResults</l>
<c>* </c>
<c>* buffer processing result data in message/queue. this is faster than cocenating tuples or vectors</c>
<c>*- specially if tuple/vectors are big the time adds up- message/que concept stays constant in time</c>
<c></c>
<c></c>
<c>*send measurement value if available</c>
<l>* if(DataToAddVector2Dim.at(0).at(0) # [])</l>
<l>*     DataToSerializeTuple := {{}}</l>
<c>    * reduce data content</c>
<l>*     for Index_Cnt := 0 to DataToAddVector2Dim.length()-1 by 1</l>
<l>*         DataToAddVector2Dim.at(Index_Cnt).remove(0)</l>
<l>*     endfor</l>
<l>*     DataToSerializeTuple := DataToAddVector2Dim</l>
<l>*     gSerialize2DimVectorTpl (DataToSerializeTuple, 'Products_VT_MeasureResult_MeasureValues', gVTMessage_DataBuffer_ProcessingResults.at(ProcessingThread), 0, TimeNeeded0)</l>
<l>*     enqueue_message (gVTQueue_DataBuffer_ProcessingResults.at(ProcessingThread), gVTMessage_DataBuffer_ProcessingResults.at(ProcessingThread), [], [])</l>
<l>* endif</l>
<c></c>
<c>*send result data if available</c>
<l>tuple_sum (Result_VLane_ForEverySingleFeature_0Good_1Bad.at(0), Result_VLane_ForEverySingleFeature_0Good_1Bad_Sum)</l>
<l>if(Result_VLane_ForEverySingleFeature_0Good_1Bad.at(0) # [] and Result_VLane_ForEverySingleFeature_0Good_1Bad_Sum # 0)</l>
<l>    DataToSerializeTuple := {{}}</l>
<c>    * reduce data content</c>
<l>*     for Index_Cnt := 0 to DataToAddVector2Dim.length()-1 by 1</l>
<l>*         DataToAddVector2Dim.at(Index_Cnt).remove(0)</l>
<l>*     endfor</l>
<l>    DataToSerializeTuple.at(0) := Result_VLane_ForEverySingleFeature_0Good_1Bad</l>
<l>    gSerialize2DimVectorTpl (DataToSerializeTuple, 'Result_VLane_ForEverySingleFeature_0Good_1Bad', gVTMessage_DataBuffer_ProcessingResults.at(ProcessingThread), 0, TimeNeeded0)</l>
<l>    enqueue_message (gVTQueue_DataBuffer_ProcessingResults.at(ProcessingThread), gVTMessage_DataBuffer_ProcessingResults.at(ProcessingThread), [], [])</l>
<l>endif</l>
<c></c>
<c></c>
<l>return ()</l>
</body>
<docu id="gQueuBufferDataTuple">
<parameters>
<parameter id="DataToAddVector2Dim"/>
<parameter id="ProcessingThread"/>
<parameter id="Result_VLane_ForEverySingleFeature_0Good_1Bad"/>
</parameters>
</docu>
</procedure>
<procedure name="gQueueBufferDataTuple_StoreToFile">
<interface>
<ic>
<par name="ProcessingThread" base_type="ctrl" dimension="0"/>
</ic>
</interface>
<body>
<l>global tuple gLocalCameraNumberUsed</l>
<l>global tuple vector(1) gVTQueue_DataBuffer_ProcessingResults</l>
<l>global tuple vector(1) gVTMessage_DataBuffer_ProcessingResults</l>
<l>* global tuple vector(1) gVTPathdefinitions</l>
<l>global tuple dict_Pathdefinitions</l>
<c>* </c>
<l>BufferDataVector_MeasureFeature_TValue.at(0).at(0) := []</l>
<l>Products_VT_MeasureValues.at(0).at(0) := []</l>
<l>ProductsVector_Length := 0</l>
<c></c>
<c>* Initialize a vector filled with empty tuples to alocate memory for Good/Bad Data</c>
<l>InitVecLength:=200000</l>
<l>VecLength:=InitVecLength</l>
<l>Result_VLane_ForEverySingleFeature_0Good_1Bad.at(InitVecLength-1):=[]</l>
<l>LoopCount:=0</l>
<c></c>
<l>clear_message (gVTMessage_DataBuffer_ProcessingResults.at(ProcessingThread))</l>
<c>* </c>
<c>* When finished with the acquisition, process all the data from the queue.</c>
<c>* In this example processing means simply to display the images...</c>
<l>* Counter := 0</l>
<l>* dev_open_window (0, 0, 512, 512, 'black', WindowHandle)</l>
<c>* test ND</c>
<l>* for Index1 := 1 to 30 by 1</l>
<l>* wait_seconds (1)</l>
<l>* endfor</l>
<l>* stop()</l>
<c></c>
<c>****** test nd end</c>
<c></c>
<c>* 1. umstellen auf Bildmaterial - ohna anlage reproduzieren</c>
<c>* 2. waiter testen </c>
<c>*     ersten</c>
<c>*     zweiten</c>
<c>* 3. message num abfragen ob weniger wird</c>
<c>* Beobachtung- an dieser Stelle können noch Daten in die queu kommen? Abfrage der Process Queue länge?</c>
<c>* check ob queue-länge über eine sek konstant bleibt- wnn ja dann queue leeren, ansonsten noch warten</c>
<l>wait_seconds(3)</l>
<c>****************************************************</c>
<l>get_message_queue_param (gVTQueue_DataBuffer_ProcessingResults.at(ProcessingThread), 'message_num', QueueMessageNum)</l>
<c></c>
<l>while (1)</l>
<c>    </c>
<l>    get_message_queue_param (gVTQueue_DataBuffer_ProcessingResults.at(ProcessingThread), 'is_empty', QueueIsEmpty)</l>
<l>    get_message_queue_param (gVTQueue_DataBuffer_ProcessingResults.at(ProcessingThread), 'message_num', QueueMessageNum)</l>
<c>    </c>
<c>    </c>
<l>    if (QueueIsEmpty)</l>
<l>        break</l>
<l>    endif</l>
<c>    </c>
<c>    </c>
<l>    dequeue_message (gVTQueue_DataBuffer_ProcessingResults.at(ProcessingThread), 'timeout', 'infinite', MessageIn)</l>
<c>    </c>
<l>    MessagePart_ID := 0</l>
<l>    gDeSerialize2DimTpl (MessageIn, MessagePart_ID, VariableName, Products_VT_MeasureValues)</l>
<l>    clear_message (MessageIn)</l>
<l>    ResultForEveryFeature := Products_VT_MeasureValues.at(0).at(0)</l>
<c>    </c>
<c>    *Wenn die Anzahl der Loops beginnt die Anzahl der Leertuple im Vector zu übersteigen werden neue Leere Tupel angehängt</c>
<l>    if (VecLength == LoopCount)</l>
<l>        Result_VLane_ForEverySingleFeature_0Good_1Bad.at(VecLength+InitVecLength):=[]</l>
<l>        VecLength:=Result_VLane_ForEverySingleFeature_0Good_1Bad.length()</l>
<l>    endif</l>
<c>    </c>
<c>     * write the current tuple into the current empty vector tuple</c>
<l>    Result_VLane_ForEverySingleFeature_0Good_1Bad.at(LoopCount) := ResultForEveryFeature</l>
<c></c>
<l>    LoopCount:=LoopCount+1</l>
<l>endwhile</l>
<c></c>
<c>* Cleanup</c>
<l>if (LoopCount == 0)</l>
<c>    *if Vector is empty make it real empty</c>
<l>    Result_VLane_ForEverySingleFeature_0Good_1Bad := {[]}</l>
<l>else</l>
<c>    * if Vector has data stored, delete all the remaining empty tuples</c>
<l>    *convert_vector_to_tuple (Result_VLane_ForEverySingleFeature_0Good_1Bad, ResultTup)</l>
<c>    *convert_tuple_to_vector_1d (ResultTup, 8!!!!!, Result_VLane_ForEverySingleFeature_0Good_1Bad)</c>
<c>    </c>
<l>    VecLength:= Result_VLane_ForEverySingleFeature_0Good_1Bad.length()</l>
<l>    for IndexLen := VecLength-1 to LoopCount by -1</l>
<l>        Result_VLane_ForEverySingleFeature_0Good_1Bad.remove(IndexLen)</l>
<l>    endfor</l>
<l>endif</l>
<c></c>
<c>*delete the queue</c>
<l>clear_message_queue (gVTQueue_DataBuffer_ProcessingResults.at(ProcessingThread))</l>
<c></c>
<c>* write the data to harddisk</c>
<c>*****************************************</c>
<c>* for All results</c>
<c>* add function to get MeasurementCycle count here</c>
<l>MeasurementCycle := 0</l>
<l>ErrorimagesPath := dict_Pathdefinitions.ErrorImagesPath</l>
<l>* gGetSubObjectVariables_SingleValue (gVTPathdefinitions, 'ErrorimagesPath', ErrorimagesPath)</l>
<c></c>
<c>* for eject reason</c>
<c>* for All results</c>
<c>* add function to get MeasurementCycle count here</c>
<c></c>
<l>if(Result_VLane_ForEverySingleFeature_0Good_1Bad.at(0) # [])</l>
<l>    MeasurementCycle := 0</l>
<l>    MeasureFeature_Name := 'ResultForEverySingleFeature_0Good1Bad' </l>
<l>    while (1)</l>
<l>        FileName := ErrorimagesPath + 'Cam' + gLocalCameraNumberUsed + '_Lane' + ProcessingThread + '_' + 'Cycle' + MeasurementCycle + '_' + MeasureFeature_Name + '.tpl'</l>
<l>        file_exists (FileName, FileExists)</l>
<l>        if (FileExists = 0)</l>
<l>            break</l>
<l>        else</l>
<l>            MeasurementCycle := MeasurementCycle +1</l>
<l>        endif</l>
<l>    endwhile  </l>
<c>    * create a head line describing all measured features</c>
<l>    read_tuple (ErrorimagesPath+'ActiveFeatures.tpl', ActiveFeatures)</l>
<l>    HeadLine := []</l>
<l>    tuple_length (ActiveFeatures, ActiveFeatures_length)</l>
<l>    for Index := 0 to ActiveFeatures_length-1 by 1</l>
<l>        MeasureFeature_Name := ActiveFeatures[Index]</l>
<l>        HeadLine := [HeadLine, MeasureFeature_Name, ', ']</l>
<l>    endfor</l>
<c>    * write data to file</c>
<l>    open_file (FileName, 'output', FileHandle)  </l>
<l>    fwrite_string (FileHandle, HeadLine)</l>
<l>    fwrite_string (FileHandle, '\n')</l>
<l>    for Index := 0 to Result_VLane_ForEverySingleFeature_0Good_1Bad.length()-1 by 1</l>
<l>        fwrite_string (FileHandle, Result_VLane_ForEverySingleFeature_0Good_1Bad.at(Index))</l>
<l>        fwrite_string (FileHandle, '\n')</l>
<l>    endfor</l>
<l>    close_file (FileHandle)</l>
<l>endif</l>
<c></c>
<c></c>
<l>return ()</l>
</body>
<docu id="gQueueBufferDataTuple_StoreToFile">
<parameters>
<parameter id="ProcessingThread"/>
</parameters>
</docu>
</procedure>
<procedure name="gRemove_FirstAndLast_NValues_FromTuple">
<interface>
<ic>
<par name="Tuple_Input" base_type="ctrl" dimension="0"/>
<par name="PercentageToRemove" base_type="ctrl" dimension="0"/>
</ic>
<oc>
<par name="Tuple_Output" base_type="ctrl" dimension="0"/>
<par name="IndicesRemoved" base_type="ctrl" dimension="0"/>
</oc>
</interface>
<body>
<c>* Remove smallest and biggest n values from tuple</c>
<c></c>
<l>Tuple_Output := Tuple_Input</l>
<l>IndicesRemoved := []</l>
<c></c>
<l>Tuple_Output_Length := |Tuple_Output|</l>
<l>* PercentageToRemove := 20</l>
<c></c>
<l>NumberToRemove := Tuple_Output_Length * (0.01 *PercentageToRemove)</l>
<l>NumberToRemove := NumberToRemove /2</l>
<l>tuple_round (NumberToRemove, NumberToRemove)</l>
<c></c>
<c></c>
<l>if ( Tuple_Output &gt; (2*NumberToRemove))</l>
<c>    * remove lower part</c>
<l>    tuple_sort_index (Tuple_Output, Indices_Sorted)</l>
<l>    tuple_select_range (Indices_Sorted, 0, NumberToRemove -1, Selected_ToRemove)</l>
<l>    tuple_remove (Tuple_Output, Selected_ToRemove, Tuple_Output)</l>
<l>    IndicesRemoved := [IndicesRemoved, Selected_ToRemove]</l>
<c>    * remove upper part</c>
<l>    tuple_sort_index (-Tuple_Output, Indices_Sorted)</l>
<l>    tuple_select_range (Indices_Sorted, 0, NumberToRemove -1, Selected_ToRemove)</l>
<l>    tuple_remove (Tuple_Output, Selected_ToRemove, Tuple_Output)</l>
<l>    IndicesRemoved := [IndicesRemoved, Selected_ToRemove]</l>
<l>endif</l>
<c></c>
<c>* reemoval with data sorting</c>
<l>* tuple_sort (Tuple_Output, Tuple_Output)</l>
<c></c>
<l>* tuple_gen_sequence (0, NumberToRemove-1, 1, SequenceToRemoveIndex)</l>
<l>* tuple_remove (Tuple_Output, SequenceToRemoveIndex, Tuple_Output)</l>
<c></c>
<l>* tuple_gen_sequence (|Tuple_Output| - (NumberToRemove -1) -1, |Tuple_Output| -1, 1, SequenceToRemoveIndex)</l>
<l>* tuple_remove (Tuple_Output, SequenceToRemoveIndex, Tuple_Output)</l>
<c></c>
<l>return ()</l>
</body>
<docu id="gRemove_FirstAndLast_NValues_FromTuple">
<parameters>
<parameter id="IndicesRemoved"/>
<parameter id="PercentageToRemove"/>
<parameter id="Tuple_Input"/>
<parameter id="Tuple_Output"/>
</parameters>
</docu>
</procedure>
<procedure name="gRemoveFromTupleVector_GivenIndices">
<interface>
<ic>
<par name="IndicesToRemove" base_type="ctrl" dimension="0"/>
<par name="VectorTuple" base_type="ctrl" dimension="1"/>
</ic>
<oc>
<par name="VectorTuple_Out" base_type="ctrl" dimension="1"/>
</oc>
</interface>
<body>
<c>* Procedure removes Indices from a vector. It is done by removing beginning from the end in direction to the beginning of the vector</c>
<c></c>
<c>* ToDo- early prototype - to debug Nils</c>
<c></c>
<l>VectorTuple_Out := VectorTuple</l>
<c></c>
<l>AlreadyRemovedValues := 0</l>
<l>FoundEntries := 0</l>
<l>tuple_sort (IndicesToRemove, IndicesToRemove)</l>
<c></c>
<l>for IndexCnt := |IndicesToRemove|-1 to 0 by -1</l>
<l>    IndexToRemove_Current := IndicesToRemove[IndexCnt]</l>
<l>    for Index_Vect := VectorTuple_Out.length()-1 to 0 by -1</l>
<l>        TupleInVect := VectorTuple_Out.at(Index_Vect)</l>
<l>        if (|TupleInVect| # 0)</l>
<l>            for Index_Tpl := |TupleInVect| to 0 by -1</l>
<l>                FoundEntries := FoundEntries +1</l>
<l>                if(FoundEntries = IndexToRemove_Current)</l>
<l>                    tuple_remove (TupleInVect, IndexToRemove_Current-1, TupleInVect)</l>
<l>                    AlreadyRemovedValues := AlreadyRemovedValues +1</l>
<l>*                     stop()                                                                    /////////////</l>
<l>                endif</l>
<l>            endfor</l>
<l>        endif</l>
<l>        VectorTuple_Out.at(Index_Vect) := TupleInVect // entry with removed position</l>
<l>*         stop()                                                                                /////////////</l>
<l>    endfor</l>
<l>endfor</l>
<l>if(IndicesToRemove # [])</l>
<l>*     stop()</l>
<l>endif</l>
<l>return ()</l>
</body>
<docu id="gRemoveFromTupleVector_GivenIndices">
<parameters>
<parameter id="IndicesToRemove"/>
<parameter id="VectorTuple"/>
<parameter id="VectorTuple_Out"/>
</parameters>
</docu>
</procedure>
<procedure name="gRemoveRegionsThatCrossTheBorder_1">
<interface>
<io>
<par name="RinnenROIs_Union" base_type="iconic" dimension="0"/>
<par name="Tablet_Individual_Concat" base_type="iconic" dimension="0"/>
<par name="ImageOrig" base_type="iconic" dimension="0"/>
</io>
<oo>
<par name="Tablet_Individual_ConcatOut" base_type="iconic" dimension="0"/>
<par name="ObjectsOnBorder_Output" base_type="iconic" dimension="0"/>
</oo>
<ic>
<par name="TabletWidth_Average" base_type="ctrl" dimension="0"/>
<par name="BorderObject_DirectRemoval_Or_CuttingBasedOnProjectionActive" base_type="ctrl" dimension="0"/>
</ic>
</interface>
<body>
<l>Tablet_Individual_ConcatOut := Tablet_Individual_Concat</l>
<c></c>
<c></c>
<l>ModeGettingBorderObjects := 2 // get objects all oround</l>
<c></c>
<c></c>
<l>gGetObjectsTouchingROI_UpperLower_Or_LeftRight (RinnenROIs_Union, Tablet_Individual_Concat, ImageOrig, ObjectsOnBorder, ModeGettingBorderObjects, ObjectsOnBorder_Index)</l>
<l>if (BorderObject_DirectRemoval_Or_CuttingBasedOnProjectionActive &gt;= 1 or BorderObject_DirectRemoval_Or_CuttingBasedOnProjectionActive = -1)</l>
<l>    PartToRemove := ObjectsOnBorder</l>
<l>else</l>
<c>    * select objects that are in the range of partition_dynamic</c>
<l>    select_shape (ObjectsOnBorder, ObjectsOnBorder_ForCutting, 'height', 'and', (TabletWidth_Average* 0.7), 99999999)</l>
<l>    gSegmentedObjectsCutting_BasedOnProjection (ImageOrig, RinnenROIs_Union, ObjectsOnBorder_ForCutting, RemainingObject, PartToRemove, TabletWidth_Average)</l>
<l>endif</l>
<l>difference (Tablet_Individual_ConcatOut, PartToRemove, Tablet_Individual_ConcatOut)</l>
<c>* select objects that are too small and delete them</c>
<l>select_shape (ObjectsOnBorder, ObjectsOnBorder_Output, 'height', 'and', 0, (TabletWidth_Average* 0.7))</l>
<l>difference (Tablet_Individual_ConcatOut, ObjectsOnBorder_Output, Tablet_Individual_ConcatOut)</l>
<l>select_shape (Tablet_Individual_ConcatOut, Tablet_Individual_ConcatOut, 'area', 'and', 1, 9999999999)</l>
<c></c>
<l>concat_obj (ObjectsOnBorder_Output, PartToRemove, ObjectsOnBorder_Output)</l>
<c></c>
<c>* </c>
<l>return ()</l>
</body>
<docu id="gRemoveRegionsThatCrossTheBorder_1">
<parameters>
<parameter id="BorderObject_DirectRemoval_Or_CuttingBasedOnProjectionActive"/>
<parameter id="ImageOrig"/>
<parameter id="ObjectsOnBorder_Output"/>
<parameter id="RinnenROIs_Union"/>
<parameter id="TabletWidth_Average"/>
<parameter id="Tablet_Individual_Concat"/>
<parameter id="Tablet_Individual_ConcatOut"/>
</parameters>
</docu>
</procedure>
<procedure name="gRemoveSmallTupleValues">
<interface>
<ic>
<par name="Tuple_FullDataSet" base_type="ctrl" dimension="0"/>
<par name="ThresholdToReduceBelow" base_type="ctrl" dimension="0"/>
</ic>
<oc>
<par name="Tuple_Reduced" base_type="ctrl" dimension="0"/>
</oc>
</interface>
<body>
<l>Tuple_Reduced := Tuple_FullDataSet</l>
<c>* Get rid of values smaller than threshold</c>
<l>tuple_greater_equal_elem (Tuple_Reduced, ThresholdToReduceBelow, Greater)</l>
<l>tuple_find (Greater, 0, IndicesToReduce)</l>
<l>tuple_remove (Tuple_Reduced, IndicesToReduce, Tuple_Reduced)</l>
<l>return ()</l>
</body>
<docu id="gRemoveSmallTupleValues">
<parameters>
<parameter id="ThresholdToReduceBelow"/>
<parameter id="Tuple_FullDataSet"/>
<parameter id="Tuple_Reduced"/>
</parameters>
</docu>
</procedure>
<procedure name="gRepositioning">
<interface>
<io>
<par name="ReferenceRegion" base_type="iconic" dimension="0"/>
<par name="TestRegion" base_type="iconic" dimension="0"/>
<par name="ImageOrig" base_type="iconic" dimension="0"/>
<par name="MiddleLine" base_type="iconic" dimension="0"/>
</io>
<oo>
<par name="ReferenceRegion_Out" base_type="iconic" dimension="0"/>
</oo>
<ic>
<par name="ReferenceRegion_DilationCircleSize" base_type="ctrl" dimension="0"/>
</ic>
<oc>
<par name="TimeNeeded" base_type="ctrl" dimension="0"/>
</oc>
</interface>
<body>
<l>ReferenceRegion_Out := ReferenceRegion</l>
<c></c>
<l>dilation_rectangle1 (MiddleLine, MiddleLine, 3, 3)</l>
<c></c>
<c></c>
<c>* erase middle line from reference object</c>
<l>difference (ReferenceRegion, MiddleLine, ReferenceRegion)</l>
<l>difference (TestRegion, MiddleLine, TestRegion)</l>
<c></c>
<l>erosion_circle (ReferenceRegion, ReferenceRegion, ReferenceRegion_DilationCircleSize)</l>
<l>* difference (ReferenceRegion, TestRegion, DifferencesReferenceToTestObject)</l>
<c></c>
<l>gBestMatch_BasedOnMovedRegionDiff (ReferenceRegion, TestRegion, ImageOrig, ReferenceRegion_Out, 1, 3, 3, 1, 0, 0, TimeNeeded, Matching_FoundOffsetRow, Matching_FoundOffsetColumn)</l>
<c></c>
<c></c>
<l>* difference (ReferenceRegion_Out, TestRegion, DifferencesReferenceToTestObject)</l>
<c></c>
<l>return ()</l>
</body>
<docu id="gRepositioning">
<parameters>
<parameter id="ImageOrig"/>
<parameter id="MiddleLine"/>
<parameter id="ReferenceRegion"/>
<parameter id="ReferenceRegion_DilationCircleSize"/>
<parameter id="ReferenceRegion_Out"/>
<parameter id="TestRegion"/>
<parameter id="TimeNeeded"/>
</parameters>
</docu>
</procedure>
<procedure name="gReuniteObjectsThatHaveBeenDevidedInSegmentation">
<interface>
<io>
<par name="Tablet_Individual" base_type="iconic" dimension="0"/>
</io>
<oo>
<par name="Tablet_Individual_Out" base_type="iconic" dimension="0"/>
</oo>
<oc>
<par name="FurtherReunionStepNecessary" base_type="ctrl" dimension="0"/>
</oc>
</interface>
<body>
<c></c>
<c>* check if segmented objects have been fallen in parts and reunite them</c>
<c>* </c>
<l>gen_empty_obj (Tablet_Individual_Out)</l>
<c>* start with a erosion due to tablet regions may overlap. A simple smaller gen rectangle may cause irritations.</c>
<l>erosion_rectangle1 (Tablet_Individual, Tablet_Individual_eroded, 1, 9)</l>
<c></c>
<l>* erosion_rectangle1 (Tablet_Individual, Tablet_Individual_eroded, 1, 17)</l>
<l>smallest_rectangle1 (Tablet_Individual_eroded, Row1, Column1, Row2, Column2)</l>
<l>count_obj (Tablet_Individual_eroded, Number_Tablet_Individual_eroded)</l>
<c>* </c>
<c>* just do the routine if there is content</c>
<l>if (Number_Tablet_Individual_eroded &gt; 0)</l>
<l>    RowOffset := 0</l>
<l>    ColOffset := 15</l>
<l>    gen_rectangle1 (Rectangle, Row1-RowOffset, Column1 -ColOffset, Row2+RowOffset, Column2 +ColOffset)</l>
<l>    area_center (Rectangle, Area, Center_Row, Center_Column)</l>
<c>    * </c>
<c>    * </c>
<c>    * test for all objects if there is a need for reuniting</c>
<l>    gen_empty_obj (RegionsToRemove_Concat)</l>
<l>    gen_empty_obj (RegionsReunitedToAdd_Concat)</l>
<l>    IndexesObjectsThatWereAlreadyReunited := []</l>
<l>    count_obj (Tablet_Individual_eroded, Number_Tablet_Individual_eroded)</l>
<l>    for Index := 1 to Number_Tablet_Individual_eroded by 1</l>
<c>        * if certain elements have been reunited - skip loop for them</c>
<l>        tuple_equal_elem (IndexesObjectsThatWereAlreadyReunited, Index, Equal1)</l>
<l>        tuple_sum (Equal1, Sum)</l>
<l>        if (Sum &gt; 0)</l>
<l>            continue</l>
<l>        endif</l>
<c>        * </c>
<l>        select_obj (Rectangle, Rectange_Selected, Index)</l>
<l>        intersection (Rectangle, Rectange_Selected, RegionIntersection)</l>
<l>        select_shape (RegionIntersection, SelectedRegions, 'area', 'and', 2, 99999999)</l>
<l>        count_obj (SelectedRegions, Number_SelectedRegions)</l>
<c>        * if more than one region is in the intersection than we have an object that has to be merged/ reunited</c>
<l>        if (Number_SelectedRegions &gt; 1)</l>
<l>            area_center (SelectedRegions, Area1, IntersectedRegions_Row, IntersectedRegions_Column)</l>
<l>            tuple_round (IntersectedRegions_Row, IntersectedRegions_Row)</l>
<l>            tuple_round (IntersectedRegions_Column, IntersectedRegions_Column)</l>
<l>            for Index1 := 1 to Number_SelectedRegions -1 by 1</l>
<l>                get_region_index (Rectangle, IntersectedRegions_Row[Index1], IntersectedRegions_Column[Index1], Index2)</l>
<l>                tuple_concat (IndexesObjectsThatWereAlreadyReunited, Index2, IndexesObjectsThatWereAlreadyReunited)</l>
<l>                select_obj (Tablet_Individual, RegionsForReunion, Index2)</l>
<l>                concat_obj (RegionsToRemove_Concat, RegionsForReunion, RegionsToRemove_Concat)</l>
<l>                union1 (RegionsForReunion, RegionsForReunion)</l>
<l>                concat_obj (RegionsReunitedToAdd_Concat, RegionsForReunion, RegionsReunitedToAdd_Concat)</l>
<l>            endfor</l>
<l>        endif</l>
<c>        * </c>
<l>    endfor</l>
<l>    select_obj (Tablet_Individual, RegionsToRemove_Concat, IndexesObjectsThatWereAlreadyReunited)</l>
<l>    difference (Tablet_Individual, RegionsToRemove_Concat, Tablet_Individual)</l>
<l>    concat_obj (Tablet_Individual, RegionsReunitedToAdd_Concat, Tablet_Individual)</l>
<l>    select_shape (Tablet_Individual, Tablet_Individual_Out, 'area', 'and', 1, 99999999)</l>
<l>endif</l>
<c>* </c>
<l>return ()</l>
<c></c>
<c></c>
<c></c>
<c>* check if segmented objects have been fallen in parts and reunite them</c>
<c>* </c>
<l>gen_empty_obj (Tablet_Individual_Out)</l>
<c>* start with a erosion due to tablet regions may overlap. A simple smaller gen rectangle may cause irritations.</c>
<l>erosion_rectangle1 (Tablet_Individual, Tablet_Individual_eroded, 1, 9)</l>
<c></c>
<l>* erosion_rectangle1 (Tablet_Individual, Tablet_Individual_eroded, 1, 17)</l>
<l>smallest_rectangle1 (Tablet_Individual_eroded, Row1, Column1, Row2, Column2)</l>
<l>count_obj (Tablet_Individual_eroded, Number_Tablet_Individual_eroded)</l>
<c>* </c>
<c>* just do the routine if there is content</c>
<l>if (Number_Tablet_Individual_eroded &gt; 0)</l>
<l>    RowOffset := 0</l>
<l>    ColOffset := 15</l>
<l>    gen_rectangle1 (Rectangle, Row1-RowOffset, Column1 -ColOffset, Row2+RowOffset, Column2 +ColOffset)</l>
<l>    area_center (Rectangle, Area, Center_Row, Center_Column)</l>
<c>    * </c>
<c>    * </c>
<c>    * test for all objects if there is a need for reuniting</c>
<l>    gen_empty_obj (RegionsToRemove_Concat)</l>
<l>    gen_empty_obj (RegionsReunitedToAdd_Concat)</l>
<l>    IndexesObjectsThatWereAlreadyReunited := []</l>
<l>    count_obj (Tablet_Individual_eroded, Number_Tablet_Individual_eroded)</l>
<l>    for Index := 1 to Number_Tablet_Individual_eroded by 1</l>
<c>        * if certain elements have been reunited - skip loop for them</c>
<l>        tuple_equal_elem (IndexesObjectsThatWereAlreadyReunited, Index, Equal1)</l>
<l>        tuple_sum (Equal1, Sum)</l>
<l>        if (Sum &gt; 0)</l>
<l>            continue</l>
<l>        endif</l>
<c>        * </c>
<l>        select_obj (Rectangle, Rectange_Selected, Index)</l>
<l>        intersection (Rectangle, Rectange_Selected, RegionIntersection)</l>
<l>        select_shape (RegionIntersection, SelectedRegions, 'area', 'and', 2, 99999999)</l>
<l>        count_obj (SelectedRegions, Number_SelectedRegions)</l>
<c>        * if more than one region is in the intersection than we have an object that has to be merged/ reunited</c>
<l>        if (Number_SelectedRegions &gt; 1)</l>
<l>            area_center (SelectedRegions, Area1, IntersectedRegions_Row, IntersectedRegions_Column)</l>
<l>            tuple_round (IntersectedRegions_Row, IntersectedRegions_Row)</l>
<l>            tuple_round (IntersectedRegions_Column, IntersectedRegions_Column)</l>
<l>            for Index1 := 1 to Number_SelectedRegions -1 by 1</l>
<l>                get_region_index (Rectangle, IntersectedRegions_Row[Index1], IntersectedRegions_Column[Index1], Index2)</l>
<l>                tuple_concat (IndexesObjectsThatWereAlreadyReunited, Index2, IndexesObjectsThatWereAlreadyReunited)</l>
<l>                select_obj (Tablet_Individual, RegionsForReunion, Index2)</l>
<l>                concat_obj (RegionsToRemove_Concat, RegionsForReunion, RegionsToRemove_Concat)</l>
<l>                union1 (RegionsForReunion, RegionsForReunion)</l>
<l>                concat_obj (RegionsReunitedToAdd_Concat, RegionsForReunion, RegionsReunitedToAdd_Concat)</l>
<l>            endfor</l>
<l>        endif</l>
<c>        * </c>
<l>    endfor</l>
<l>    select_obj (Tablet_Individual, RegionsToRemove_Concat, IndexesObjectsThatWereAlreadyReunited)</l>
<l>    difference (Tablet_Individual, RegionsToRemove_Concat, Tablet_Individual)</l>
<l>    concat_obj (Tablet_Individual, RegionsReunitedToAdd_Concat, Tablet_Individual)</l>
<l>    select_shape (Tablet_Individual, Tablet_Individual_Out, 'area', 'and', 1, 99999999)</l>
<l>endif</l>
</body>
<docu id="gReuniteObjectsThatHaveBeenDevidedInSegmentation">
<parameters>
<parameter id="FurtherReunionStepNecessary"/>
<parameter id="Tablet_Individual"/>
<parameter id="Tablet_Individual_Out"/>
</parameters>
</docu>
</procedure>
<procedure name="gRGB_ThresholdThreaded">
<interface>
<io>
<par name="ImageOrig" base_type="iconic" dimension="0"/>
<par name="Lines_ROIs" base_type="iconic" dimension="0"/>
<par name="Lines_ROIsUnion" base_type="iconic" dimension="0"/>
<par name="ImageOrig_YUV" base_type="iconic" dimension="0"/>
<par name="ImageOrig_HSV" base_type="iconic" dimension="0"/>
<par name="BottomLight_HSV_V" base_type="iconic" dimension="0"/>
<par name="Toplight_UV_CH" base_type="iconic" dimension="0"/>
<par name="GetShiftInBetweenImages_Rollmeasurement_StartpointRegions" base_type="iconic" dimension="0"/>
</io>
<oo>
<par name="ConnectedRegions" base_type="iconic" dimension="0"/>
</oo>
<ic>
<par name="Threshold_RedMin" base_type="ctrl" dimension="0"/>
<par name="Threshold_RedMax" base_type="ctrl" dimension="0"/>
<par name="Threshold_GreenMin" base_type="ctrl" dimension="0"/>
<par name="Threshold_GreenMax" base_type="ctrl" dimension="0"/>
<par name="Threshold_BlueMin" base_type="ctrl" dimension="0"/>
<par name="Threshold_BlueMax" base_type="ctrl" dimension="0"/>
<par name="Threaded1Serial0" base_type="ctrl" dimension="0"/>
<par name="SmallestSingleObjectFilter" base_type="ctrl" dimension="0"/>
<par name="Segmentation_ColourSupport_Active" base_type="ctrl" dimension="0"/>
<par name="Segmentation_ColourSupport_Threshold_Min" base_type="ctrl" dimension="0"/>
<par name="Segmentation_ColourSupport_Threshold_Max" base_type="ctrl" dimension="0"/>
<par name="Segmentation_ColourSupport_OpeningAfterSegmentation_MaskSize" base_type="ctrl" dimension="0"/>
<par name="Segmentation_ColourSupport_AreaToSelect_MinSize" base_type="ctrl" dimension="0"/>
<par name="Segmentation_ColourSupport_Threshold_RedMin" base_type="ctrl" dimension="0"/>
<par name="Segmentation_ColourSupport_Threshold_RedMax" base_type="ctrl" dimension="0"/>
<par name="Segmentation_DarkOnBright0_BrightOnDark_1" base_type="ctrl" dimension="0"/>
<par name="Segmentation_DynThreshold_Active" base_type="ctrl" dimension="0"/>
<par name="Segmentation_SmallestSingleObjectFilter_Area_Min" base_type="ctrl" dimension="0"/>
<par name="ROI_Pos" base_type="ctrl" dimension="0"/>
<par name="ROI_Height" base_type="ctrl" dimension="0"/>
<par name="Segmentation_SelectSegmentationImage_BottomLight0_TopLight1_UVLight2" base_type="ctrl" dimension="0"/>
<par name="Calibration_VTLane_VTPixToMM_XY" base_type="ctrl" dimension="2"/>
<par name="Calibration_FeatureActive" base_type="ctrl" dimension="0"/>
<par name="Sequencer_MovedDistanceInBetweenGrabbedImages" base_type="ctrl" dimension="0"/>
</ic>
<oc>
<par name="Preprocessed_VTProductMeasureWidth_SubPix" base_type="ctrl" dimension="0"/>
</oc>
</interface>
<body>
<l>gen_empty_obj (SegmentedRegion_Backgroundcheck)</l>
<l>access_channel (ImageOrig_HSV, ImageOrig_HSV_Value, 3)</l>
<l>* Preprocessed_VTProductMeasureWidth_SubPix.at(0) := []</l>
<l>Preprocessed_VTProductMeasureWidth_SubPix := dict{}</l>
<c></c>
<l>get_image_size (ImageOrig_HSV_Value, ImageOrig_HSV_Value_Width, _)</l>
<l>if (ImageOrig_HSV_Value_Width # [])</l>
<l>    reduce_domain (ImageOrig_HSV_Value, Lines_ROIsUnion, Value_Reduced)</l>
<c></c>
<l>    switch (Segmentation_SelectSegmentationImage_BottomLight0_TopLight1_UVLight2)</l>
<l>    case 0: // BottomLight</l>
<l>        ImageForProductOnRollMeasurement := BottomLight_HSV_V</l>
<l>        break</l>
<l>    case 1: // TopLight white</l>
<l>        ImageForProductOnRollMeasurement := BottomLight_HSV_V</l>
<l>        break</l>
<l>    case 2: // UVLight top </l>
<l>        if (Sequencer_MovedDistanceInBetweenGrabbedImages = [])</l>
<l>            Sequencer_MovedDistanceInBetweenGrabbedImages := 0</l>
<l>        endif</l>
<l>        move_region (GetShiftInBetweenImages_Rollmeasurement_StartpointRegions, GetShiftInBetweenImages_Rollmeasurement_StartpointRegions, Sequencer_MovedDistanceInBetweenGrabbedImages * 2, 0)</l>
<l>        ROI_Pos := ROI_Pos + Sequencer_MovedDistanceInBetweenGrabbedImages * 2</l>
<l>        ImageForProductOnRollMeasurement := Toplight_UV_CH</l>
<l>        break       </l>
<l>    endswitch</l>
<c>    </c>
<c>    </c>
<l>    if(Segmentation_DynThreshold_Active)</l>
<l>        ROI_IncreaseWithBy_Factor := .05</l>
<l>    else</l>
<l>        ROI_IncreaseWithBy_Factor := 0</l>
<l>    endif</l>
<c>    </c>
<c>    * find product on roll via measure pairs - subpixel accurate </c>
<l>    gen_empty_obj (hrRect_ROI)</l>
<l>    gen_empty_obj (ProductMeasureDistInRoll)</l>
<l>    gen_empty_obj (GetShiftInBetweenImages_Rollmeasurement_StartpointRegions_Corrected)</l>
<c>    </c>
<l>    count_obj (Lines_ROIs, Lines_ROIs_Number) </l>
<l>    for Index_Cnt := 1 to Lines_ROIs_Number by 1</l>
<l>        select_obj (Lines_ROIs, Lines_ROIs_Selected, Index_Cnt) </l>
<c>        * todo: replace by ROIs given by FPGA</c>
<l>        gSegmentation_FindProductOnRoll (GetShiftInBetweenImages_Rollmeasurement_StartpointRegions, ImageForProductOnRollMeasurement, Lines_ROIs_Selected, hrRect_ROI_SingleLine, ProductMeasureDistInRoll_SingleLine, GetShiftInBetweenImages_Rollmeasurement_StartpointRegions_Corrected, ROI_Pos, ROI_Height, ROI_IncreaseWithBy_Factor, Segmentation_SelectSegmentationImage_BottomLight0_TopLight1_UVLight2, ProductMeasureWidth_SingleLine, ROI_Pos)</l>
<c>        </c>
<l>        if(Calibration_FeatureActive)</l>
<l>            Calibration_X := Calibration_VTLane_VTPixToMM_XY.at(Index_Cnt-1).at(0)</l>
<l>            ProductMeasureWidth_SingleLine := ProductMeasureWidth_SingleLine / Calibration_X</l>
<l>        endif</l>
<l>        concat_obj (hrRect_ROI, hrRect_ROI_SingleLine, hrRect_ROI)</l>
<l>        concat_obj (ProductMeasureDistInRoll, ProductMeasureDistInRoll_SingleLine, ProductMeasureDistInRoll)</l>
<l>        Preprocessed_VTProductMeasureWidth_SubPix.['Roi_' + (Index_Cnt-1)] := ProductMeasureWidth_SingleLine</l>
<l>    endfor</l>
<c>    </c>
<l>    union1 (hrRect_ROI, hrRect_ROI_Union)</l>
<c>    </c>
<l>    if(Segmentation_DynThreshold_Active)</l>
<c>        * ImageOrig_HSV_Value || ImageOrig</c>
<l>        ImageForMeasurement := ImageOrig_HSV_Value</l>
<l>        gSegmentation_Dynthresh (GetShiftInBetweenImages_Rollmeasurement_StartpointRegions_Corrected, ImageForMeasurement, hrRect_ROI_Union, SegmentedRegion, Segmentation_SmallestSingleObjectFilter_Area_Min, ROI_Pos, ROI_Height, Time_Needed_Segmentation_Dyn)</l>
<l>    else</l>
<c>        * if product is available select measureing channel</c>
<l>        get_dict_param (Preprocessed_VTProductMeasureWidth_SubPix, 'keys', [], ProductIsAvailable)</l>
<l>*         convert_vector_to_tuple (Preprocessed_VTProductMeasureWidth_SubPix, ProductIsAvailable)</l>
<c></c>
<l>        if (ProductIsAvailable # [])</l>
<l>            switch (Segmentation_SelectSegmentationImage_BottomLight0_TopLight1_UVLight2)</l>
<l>            case 0: // BottomLight</l>
<l>                reduce_domain (BottomLight_HSV_V, hrRect_ROI_Union, Value_Reduced)</l>
<l>                break</l>
<l>            case 1: // TopLight white</l>
<l>                reduce_domain (ImageOrig_HSV_Value, hrRect_ROI_Union, Value_Reduced)</l>
<l>                break</l>
<l>            case 2: // UVLight top</l>
<l>                reduce_domain (Toplight_UV_CH, hrRect_ROI_Union, Value_Reduced)</l>
<l>                break      </l>
<l>            endswitch</l>
<l>        endif</l>
<l>        mean_image (Value_Reduced, Value_Reduced, 7, 7)</l>
<l>        if(Segmentation_DarkOnBright0_BrightOnDark_1 = 0)</l>
<l>            threshold (Value_Reduced, SegmentedRegion, 0, Threshold_RedMin)</l>
<l>        else</l>
<l>            threshold (Value_Reduced, SegmentedRegion, Threshold_RedMin, Threshold_RedMax)</l>
<l>        endif</l>
<c>        * in case there is a wrong or too excessive segmentation avaiod that. Protect from oversegmentation in spot step</c>
<l>        area_center (Lines_ROIsUnion, Lines_ROIsUnion_Area, _, _)</l>
<l>        SegmentationMaxSelection := Lines_ROIsUnion_Area *0.5        </l>
<l>        tuple_round (SegmentationMaxSelection, SegmentationMaxSelection)</l>
<c>        </c>
<l>        connection (SegmentedRegion, SegmentedRegion_Connected)</l>
<l>        select_shape (SegmentedRegion_Connected, SegmentedRegion, 'area', 'and', Segmentation_SmallestSingleObjectFilter_Area_Min, SegmentationMaxSelection)    </l>
<l>    endif</l>
<c>    </c>
<l>    union1 (SegmentedRegion, SegmentedRegion)</l>
<l>    gSegmentation_ColourSupport (ImageOrig_YUV, ImageOrig, Lines_ROIsUnion, SegmentedRegion, ImageOrig_HSV, SupportThreshold_V_SegmentedRegion, SupportThreshold_U_SegmentedRegion, ColourSupportSegmentation, SegmentedRegion, Segmentation_ColourSupport_Active, Segmentation_ColourSupport_Threshold_Max, Segmentation_ColourSupport_Threshold_Min, Segmentation_ColourSupport_OpeningAfterSegmentation_MaskSize, Segmentation_ColourSupport_AreaToSelect_MinSize, Segmentation_ColourSupport_Threshold_RedMin, Segmentation_ColourSupport_Threshold_RedMax)</l>
<l>else</l>
<c>    * rgb threshold based product segmentation</c>
<l>    decompose3 (ImageOrig, Red, Green, Blue)</l>
<c>    * </c>
<l>    if (Threaded1Serial0 = 1)</l>
<l>        par_start&lt;ThreadID1&gt; : gThresholdForThreading (Red, Lines_ROIsUnion, Red_Region, Threshold_RedMin)</l>
<l>        par_start&lt;ThreadID2&gt; : gThresholdForThreading (Green, Lines_ROIsUnion, Green_Region, Threshold_GreenMin)</l>
<l>        par_start&lt;ThreadID3&gt; : gThresholdForThreading (Blue, Lines_ROIsUnion, Blue_Region, Threshold_BlueMin)</l>
<l>        par_join ([ThreadID1,ThreadID2,ThreadID3])</l>
<l>    else</l>
<l>        reduce_domain (Red, Lines_ROIsUnion, Red_Reduced)</l>
<l>        threshold (Red_Reduced, Red_Region, Threshold_RedMin, Threshold_RedMax)</l>
<c>        * </c>
<l>        reduce_domain (Green, Lines_ROIsUnion, Green_Reduced)</l>
<l>        threshold (Green_Reduced, Green_Region, Threshold_GreenMin, Threshold_GreenMax)</l>
<c>        * </c>
<l>        reduce_domain (Blue, Lines_ROIsUnion, Blue_Reduced)</l>
<l>        threshold (Blue_Reduced, Blue_Region, Threshold_BlueMin, Threshold_BlueMax)</l>
<l>    endif</l>
<c>    * </c>
<l>    union2 (Red_Region, Green_Region, RegionUnion)</l>
<l>    union2 (RegionUnion, Blue_Region, SegmentedRegion)</l>
<l>endif</l>
<c>* </c>
<l>connection (SegmentedRegion, ConnectedRegions)</l>
<l>select_shape (ConnectedRegions, ConnectedRegions, 'area', 'and', SmallestSingleObjectFilter, 99999999)</l>
<c>* </c>
<c></c>
<l>return ()</l>
<c></c>
</body>
<docu id="gRGB_ThresholdThreaded">
<parameters>
<parameter id="BottomLight_HSV_V"/>
<parameter id="Calibration_FeatureActive"/>
<parameter id="Calibration_VTLane_VTPixToMM_XY"/>
<parameter id="ConnectedRegions"/>
<parameter id="GetShiftInBetweenImages_Rollmeasurement_StartpointRegions"/>
<parameter id="ImageOrig"/>
<parameter id="ImageOrig_HSV"/>
<parameter id="ImageOrig_YUV"/>
<parameter id="Lines_ROIs"/>
<parameter id="Lines_ROIsUnion"/>
<parameter id="Preprocessed_VTProductMeasureWidth_SubPix"/>
<parameter id="ROI_Height"/>
<parameter id="ROI_Pos"/>
<parameter id="Segmentation_ColourSupport_Active"/>
<parameter id="Segmentation_ColourSupport_AreaToSelect_MinSize"/>
<parameter id="Segmentation_ColourSupport_OpeningAfterSegmentation_MaskSize"/>
<parameter id="Segmentation_ColourSupport_Threshold_Max"/>
<parameter id="Segmentation_ColourSupport_Threshold_Min"/>
<parameter id="Segmentation_ColourSupport_Threshold_RedMax"/>
<parameter id="Segmentation_ColourSupport_Threshold_RedMin"/>
<parameter id="Segmentation_DarkOnBright0_BrightOnDark_1"/>
<parameter id="Segmentation_DynThreshold_Active"/>
<parameter id="Segmentation_SelectSegmentationImage_BottomLight0_TopLight1_UVLight2"/>
<parameter id="Segmentation_SmallestSingleObjectFilter_Area_Min"/>
<parameter id="Sequencer_MovedDistanceInBetweenGrabbedImages"/>
<parameter id="SmallestSingleObjectFilter"/>
<parameter id="Threaded1Serial0"/>
<parameter id="Threshold_BlueMax"/>
<parameter id="Threshold_BlueMin"/>
<parameter id="Threshold_GreenMax"/>
<parameter id="Threshold_GreenMin"/>
<parameter id="Threshold_RedMax"/>
<parameter id="Threshold_RedMin"/>
<parameter id="Toplight_UV_CH"/>
</parameters>
</docu>
</procedure>
<procedure name="gSegmentation_Backgroundcheck_AddFoundObjects">
<interface>
<io>
<par name="ImageOrig_HSV" base_type="iconic" dimension="0"/>
<par name="RinnenROIs" base_type="iconic" dimension="0"/>
<par name="AlreadyFoundProducts" base_type="iconic" dimension="0"/>
<par name="ObjectsCrossingROIBorder_Concat" base_type="iconic" dimension="0"/>
</io>
<oo>
<par name="AlreadyFoundProducts_AddedWithBackgroundObjects" base_type="iconic" dimension="0"/>
</oo>
<ic>
<par name="dict_Backgroundcheck" base_type="ctrl" dimension="0"/>
</ic>
</interface>
<body>
<c>* for checking the backgroud of the conveyor for foreign objects</c>
<c>* segment colours - to avoid white dust making trouble</c>
<c></c>
<l>Segmentation_Backgroundcheck_FeatureActive := dict_Backgroundcheck.V_FeatureActive.Value</l>
<l>Segmentation_Backgroundcheck_HueMin := dict_Backgroundcheck.V_Segmentation_HueMin.Value</l>
<l>Segmentation_Backgroundcheck_HueMax := dict_Backgroundcheck.V_Segmentation_HueMax.Value</l>
<l>Segmentation_Backgroundcheck_SaturationMin := dict_Backgroundcheck.V_Segmentation_SaturationMin.Value</l>
<l>Segmentation_Backgroundcheck_SaturationMax := dict_Backgroundcheck.V_Segmentation_SaturationMax.Value</l>
<c></c>
<c></c>
<l>AlreadyFoundProducts_AddedWithBackgroundObjects := AlreadyFoundProducts</l>
<l>if (Segmentation_Backgroundcheck_FeatureActive = 1)</l>
<c>    </c>
<l>    union1 (RinnenROIs, RinnenROIs_Union)</l>
<l>    smallest_rectangle1 (RinnenROIs, _, RinnenROIs_Column1, _, RinnenROIs_Column2)</l>
<c>    * exclude already segmented objects from background detection</c>
<c>    </c>
<l>    gen_empty_obj (SegmentationBackground_ExclusionArea)</l>
<l>    count_obj (RinnenROIs, EjectROIs_Number)</l>
<c></c>
<l>*     union1 (ObjectsCrossingROIBorder_Concat, ObjectsCrossingROIBorder_Concat)</l>
<l>    concat_obj (AlreadyFoundProducts, ObjectsCrossingROIBorder_Concat, AlreadyFoundProducts)</l>
<c>    </c>
<l>    for Index_Cnt_ROI := 1 to EjectROIs_Number by 1</l>
<l>        select_obj (RinnenROIs, RinnenROI_Selected, Index_Cnt_ROI)</l>
<l>        intersection (RinnenROI_Selected, AlreadyFoundProducts, AlreadyFoundProducts_RinnenROI_Selected)</l>
<c>        </c>
<l>        connection (AlreadyFoundProducts_RinnenROI_Selected, AlreadyFoundProducts_RinnenROI_Selected)</l>
<l>        smallest_rectangle1 (AlreadyFoundProducts_RinnenROI_Selected, Row1, Column1, Row2, Column2)</l>
<c>        </c>
<l>        OffsetHeigth := 20</l>
<c>        </c>
<l>        tuple_gen_const (|Row2|, RinnenROIs_Column1[Index_Cnt_ROI-1], RinnenROIs_Column1_Const)</l>
<l>        tuple_gen_const (|Row2|, RinnenROIs_Column2[Index_Cnt_ROI-1], RinnenROIs_Column2_Const)</l>
<c>        </c>
<l>        if (Row1 # [])</l>
<l>            gen_rectangle1 (SegmentedObjects_Rects, Row1-OffsetHeigth, RinnenROIs_Column1_Const, Row2+OffsetHeigth, RinnenROIs_Column2_Const)</l>
<l>            concat_obj (SegmentationBackground_ExclusionArea, SegmentedObjects_Rects, SegmentationBackground_ExclusionArea)</l>
<l>        endif</l>
<l>     endfor</l>
<c>    </c>
<c>     * Get rid of Exclusion areas in Segmentation</c>
<l>    union1 (SegmentationBackground_ExclusionArea, SegmentationBackground_ExclusionArea)</l>
<l>    difference (RinnenROIs_Union, SegmentationBackground_ExclusionArea, RinnenROIs_Union)</l>
<c></c>
<c>    </c>
<l>    decompose3 (ImageOrig_HSV, HSV_H, HSV_S, HSV_V)</l>
<c>    </c>
<c>    * exclude a slice of upper and lower portion as well- my be not segmented as ObjectsCrossingROIBorder_Concat </c>
<l>    union1 (RinnenROIs, RinnenROIs_Union_ToPRepareUopperAndLower)</l>
<c></c>
<l>    smallest_rectangle1 (RinnenROIs_Union_ToPRepareUopperAndLower, RinnenROIs_Union_Row1, RinnenROIs_Union_Column1, RinnenROIs_Union_Row2, RinnenROIs_Union_Column2)</l>
<l>    gen_rectangle1 (UpperExclusion, RinnenROIs_Union_Row1, RinnenROIs_Union_Column1, RinnenROIs_Union_Row1 + 30, RinnenROIs_Union_Column2)</l>
<l>    gen_rectangle1 (LowerExclusion, RinnenROIs_Union_Row2 -30, RinnenROIs_Union_Column1, RinnenROIs_Union_Row2, RinnenROIs_Union_Column2)</l>
<l>    union2 (UpperExclusion, LowerExclusion, UpperLower_ToExcludeAsWell)</l>
<l>    difference (RinnenROIs_Union, UpperLower_ToExcludeAsWell, RinnenROIs_Union)</l>
<c></c>
<c>        </c>
<l>    reduce_domain (HSV_H, RinnenROIs_Union, HSV_H_Reduced)</l>
<l>    threshold (HSV_H_Reduced, HSV_H_Reduced_Segmented, Segmentation_Backgroundcheck_HueMin, Segmentation_Backgroundcheck_HueMax)</l>
<c>      </c>
<l>    reduce_domain (HSV_S, RinnenROIs_Union, HSV_S_Reduced)</l>
<l>    threshold (HSV_S_Reduced, HSV_S_Reduced_Segmented, Segmentation_Backgroundcheck_SaturationMin, Segmentation_Backgroundcheck_SaturationMax)</l>
<c>    </c>
<l>    union2 (HSV_H_Reduced_Segmented, HSV_S_Reduced_Segmented, BackgroundCheck_Segmentation)</l>
<c>    </c>
<l>    erosion_rectangle1 (BackgroundCheck_Segmentation, RegionErosion, 24, 24)</l>
<l>    closing_rectangle1 (RegionErosion, SegmentedRegion_Backgroundcheck, 25, 15)</l>
<c>    </c>
<c>    *** check for really dark objects like steel with mser approach</c>
<l>    Segmentation_Backgroundcheck_DarkObjects_FeatureActive := 0</l>
<l>    if (Segmentation_Backgroundcheck_DarkObjects_FeatureActive = 1)</l>
<l>        reduce_domain (HSV_V, RinnenROIs_Union, HSV_V_Reduced)</l>
<l>        gMSER_SegmentationOfDarkObjects (HSV_V_Reduced, SegmentedRegions_DarkObjects, 0.25, 50, [], 2, 20, 30)</l>
<l>        concat_obj (SegmentedRegion_Backgroundcheck, SegmentedRegions_DarkObjects, SegmentedRegion_Backgroundcheck)</l>
<l>    endif</l>
<c>    </c>
<c>    **************</c>
<c>    * generate block like representation for found foreign objects - per Eject ROI</c>
<l>    for Index_Cnt_ROI := 1 to EjectROIs_Number by 1</l>
<l>        select_obj (RinnenROIs, RinnenROI_Selected, Index_Cnt_ROI)</l>
<c>        </c>
<l>        intersection (RinnenROI_Selected, SegmentedRegion_Backgroundcheck, SegmentedRegion_Backgroundcheck_Selected)</l>
<c>        </c>
<l>        connection (SegmentedRegion_Backgroundcheck_Selected, SegmentedRegion_Backgroundcheck_Selected)</l>
<l>        smallest_rectangle1 (SegmentedRegion_Backgroundcheck_Selected, Row1, Column1, Row2, Column2)</l>
<c>        </c>
<l>        if (Row1 = [] or (Row1 = 0 and Row2 = 0))</l>
<l>            continue</l>
<l>        endif</l>
<c>        </c>
<l>        gen_rectangle1 (Rectangle, Row1, Column1, Row2, Column2)</l>
<l>        OffsetHeigth := 0</l>
<c>        </c>
<l>        tuple_gen_const (|Row2|, RinnenROIs_Column1[Index_Cnt_ROI-1], RinnenROIs_Column1_Const)</l>
<l>        tuple_gen_const (|Row2|, RinnenROIs_Column2[Index_Cnt_ROI-1], RinnenROIs_Column2_Const)</l>
<l>        gen_rectangle1 (SegmentedObjects_Rects, Row1-OffsetHeigth, RinnenROIs_Column1_Const, Row2+OffsetHeigth, RinnenROIs_Column2_Const)</l>
<c>        </c>
<l>        union1 (SegmentedObjects_Rects, SegmentedObjects_Rects) </l>
<l>        connection (SegmentedObjects_Rects, SegmentedObjects_Rects)</l>
<l>        concat_obj (AlreadyFoundProducts_AddedWithBackgroundObjects, SegmentedObjects_Rects, AlreadyFoundProducts_AddedWithBackgroundObjects)</l>
<c></c>
<l>    endfor</l>
<l>endif</l>
<c>* get rid of upper or lower sideeffects</c>
<l>* difference (AlreadyFoundProducts_AddedWithBackgroundObjects, UpperLower_ToExcludeAsWell, AlreadyFoundProducts_AddedWithBackgroundObjects)</l>
<c></c>
<l>return ()</l>
</body>
<docu id="gSegmentation_Backgroundcheck_AddFoundObjects">
<parameters>
<parameter id="AlreadyFoundProducts"/>
<parameter id="AlreadyFoundProducts_AddedWithBackgroundObjects"/>
<parameter id="ImageOrig_HSV"/>
<parameter id="ObjectsCrossingROIBorder_Concat"/>
<parameter id="RinnenROIs"/>
<parameter id="dict_Backgroundcheck"/>
</parameters>
</docu>
</procedure>
<procedure name="gSegmentation_ColourSupport">
<interface>
<io>
<par name="ImageOrig_YUV" base_type="iconic" dimension="0"/>
<par name="ImageOrig" base_type="iconic" dimension="0"/>
<par name="Lines_ROIsUnion" base_type="iconic" dimension="0"/>
<par name="SegmentedRegion" base_type="iconic" dimension="0"/>
<par name="ImageOrig_HSV" base_type="iconic" dimension="0"/>
</io>
<oo>
<par name="SupportThreshold_V_SegmentedRegion" base_type="iconic" dimension="0"/>
<par name="SupportThreshold_U_SegmentedRegion" base_type="iconic" dimension="0"/>
<par name="ColourSupportSegmentation" base_type="iconic" dimension="0"/>
<par name="SegmentedRegionOut" base_type="iconic" dimension="0"/>
</oo>
<ic>
<par name="Segmentation_ColourSupport_Active" base_type="ctrl" dimension="0"/>
<par name="Segmentation_ColourSupport_Threshold_Max" base_type="ctrl" dimension="0"/>
<par name="Segmentation_ColourSupport_Threshold_Min" base_type="ctrl" dimension="0"/>
<par name="Segmentation_ColourSupport_OpeningAfterSegmentation_MaskSize" base_type="ctrl" dimension="0"/>
<par name="Segmentation_ColourSupport_AreaToSelect_MinSize" base_type="ctrl" dimension="0"/>
<par name="Segmentation_ColourSupport_Threshold_RedMin" base_type="ctrl" dimension="0"/>
<par name="Segmentation_ColourSupport_Threshold_RedMax" base_type="ctrl" dimension="0"/>
</ic>
</interface>
<body>
<l>SegmentedRegionOut := SegmentedRegion</l>
<l>if (Segmentation_ColourSupport_Active = 1)</l>
<c>    * todo: test if colour supported segmentation still works</c>
<l>    get_image_size (ImageOrig_HSV, ImageOrig_HSV_Width, _)</l>
<l>    if(ImageOrig_HSV_Width # [])  // side for HSV color support segmentation</l>
<l>        decompose3 (ImageOrig_HSV, ImageOrig_HSV_H, ImageOrig_HSV_S, ImageOrig_HSV_V)</l>
<c>        * H-Channel</c>
<l>        gSegmentation_ColourSupport_SegmentAndFilterOneChannel (ImageOrig_HSV_H, Lines_ROIsUnion, SupportThreshold_SegmentedRegion_HSV_H, Segmentation_ColourSupport_Threshold_RedMin, Segmentation_ColourSupport_Threshold_RedMax, Segmentation_ColourSupport_OpeningAfterSegmentation_MaskSize, Segmentation_ColourSupport_AreaToSelect_MinSize)</l>
<c>        * S-Channel</c>
<l>        gSegmentation_ColourSupport_SegmentAndFilterOneChannel (ImageOrig_HSV_S, Lines_ROIsUnion, SupportThreshold_SegmentedRegion_HSV_S, [Segmentation_ColourSupport_Threshold_Min], [Segmentation_ColourSupport_Threshold_Max], Segmentation_ColourSupport_OpeningAfterSegmentation_MaskSize, Segmentation_ColourSupport_AreaToSelect_MinSize)</l>
<c>        * merge data from prior segmentations</c>
<l>        union2 (SupportThreshold_SegmentedRegion_HSV_H, SupportThreshold_SegmentedRegion_HSV_S, Segmented_HSV)</l>
<l>        union2 (SegmentedRegionOut, Segmented_HSV, SegmentedRegionOut)</l>
<c>        * morphological operation can be useful if there is a small gap within segementations</c>
<l>        dilation_rectangle1 (SegmentedRegionOut, SegmentedRegionOut, 3, 3)</l>
<l>        erosion_rectangle1 (SegmentedRegionOut, SegmentedRegionOut, 3, 3)</l>
<l>        *return()</l>
<l>    endif</l>
<c>    </c>
<l>    get_image_size (ImageOrig_YUV, ImageOrig_YUV_Width, _)</l>
<l>    if (ImageOrig_YUV_Width = [])</l>
<l>        decompose3 (ImageOrig, Red, Green, Blue)</l>
<l>        trans_from_rgb (Red, Green, Blue, YUV_Y, YUV_U, YUV_V, 'yuv')</l>
<l>    else</l>
<l>        decompose3 (ImageOrig_YUV, YUV_Y, YUV_U, YUV_V)</l>
<l>    endif</l>
<c>    </c>
<l>    decompose3 (ImageOrig, Red, Green, Blue)</l>
<l>    gSegmentation_ColourSupport_SegmentAndFilterOneChannel (Red, Lines_ROIsUnion, SupportThreshold_Red_SegmentedRegion, Segmentation_ColourSupport_Threshold_RedMin, Segmentation_ColourSupport_Threshold_RedMax, Segmentation_ColourSupport_OpeningAfterSegmentation_MaskSize, Segmentation_ColourSupport_AreaToSelect_MinSize)</l>
<l>    union2 (SegmentedRegionOut, SupportThreshold_Red_SegmentedRegion, SegmentedRegionOut)</l>
<c></c>
<c>    * V-Channel</c>
<l>    gSegmentation_ColourSupport_SegmentAndFilterOneChannel (YUV_V, Lines_ROIsUnion, SupportThreshold_V_SegmentedRegion, [Segmentation_ColourSupport_Threshold_Min, 255], [0,Segmentation_ColourSupport_Threshold_Max], Segmentation_ColourSupport_OpeningAfterSegmentation_MaskSize, Segmentation_ColourSupport_AreaToSelect_MinSize)</l>
<c>    * U-Channel</c>
<l>    gSegmentation_ColourSupport_SegmentAndFilterOneChannel (YUV_U, Lines_ROIsUnion, SupportThreshold_U_SegmentedRegion, [Segmentation_ColourSupport_Threshold_Min, 255], [0,Segmentation_ColourSupport_Threshold_Max], Segmentation_ColourSupport_OpeningAfterSegmentation_MaskSize, Segmentation_ColourSupport_AreaToSelect_MinSize)</l>
<c></c>
<c>    * merge data from prior segmentations</c>
<l>    union2 (SupportThreshold_V_SegmentedRegion, SupportThreshold_U_SegmentedRegion, ColourSupportSegmentation)</l>
<l>    union2 (SegmentedRegionOut, ColourSupportSegmentation, SegmentedRegionOut)</l>
<c>    * morphological operation can be useful if there is a small gap within segementations</c>
<l>    dilation_rectangle1 (SegmentedRegionOut, SegmentedRegionOut, 3, 3)</l>
<l>    erosion_rectangle1 (SegmentedRegionOut, SegmentedRegionOut, 3, 3)</l>
<l>endif</l>
<l>return ()</l>
</body>
<docu id="gSegmentation_ColourSupport">
<parameters>
<parameter id="ColourSupportSegmentation"/>
<parameter id="ImageOrig"/>
<parameter id="ImageOrig_HSV"/>
<parameter id="ImageOrig_YUV"/>
<parameter id="Lines_ROIsUnion"/>
<parameter id="Segmentation_ColourSupport_Active"/>
<parameter id="Segmentation_ColourSupport_AreaToSelect_MinSize"/>
<parameter id="Segmentation_ColourSupport_OpeningAfterSegmentation_MaskSize"/>
<parameter id="Segmentation_ColourSupport_Threshold_Max"/>
<parameter id="Segmentation_ColourSupport_Threshold_Min"/>
<parameter id="Segmentation_ColourSupport_Threshold_RedMax"/>
<parameter id="Segmentation_ColourSupport_Threshold_RedMin"/>
<parameter id="SegmentedRegion"/>
<parameter id="SegmentedRegionOut"/>
<parameter id="SupportThreshold_U_SegmentedRegion"/>
<parameter id="SupportThreshold_V_SegmentedRegion"/>
</parameters>
</docu>
</procedure>
<procedure name="gSegmentation_ColourSupport_SegmentAndFilterOneChannel">
<interface>
<io>
<par name="ImageToSegment" base_type="iconic" dimension="0"/>
<par name="RegionToReduceTo" base_type="iconic" dimension="0"/>
</io>
<oo>
<par name="SegmentedRegion" base_type="iconic" dimension="0"/>
</oo>
<ic>
<par name="Segmentation_ColourSupport_Threshold_Min" base_type="ctrl" dimension="0"/>
<par name="Segmentation_ColourSupport_Threshold_Max" base_type="ctrl" dimension="0"/>
<par name="Segmentation_ColourSupport_OpeningAfterSegmentation_MaskSize" base_type="ctrl" dimension="0"/>
<par name="Segmentation_ColourSupport_AreaToSelect_MinSize" base_type="ctrl" dimension="0"/>
</ic>
</interface>
<body>
<c>* do a threshold if activated </c>
<l>gen_empty_obj (SegmentedRegion)</l>
<c></c>
<c>* Segment regions on a image and filter for stable results</c>
<l>if( Segmentation_ColourSupport_Threshold_Max &gt; 0)</l>
<l>    reduce_domain (ImageToSegment, RegionToReduceTo, YUV_V_Reduced)</l>
<l>    tuple_length (Segmentation_ColourSupport_Threshold_Max, Length)</l>
<c>    </c>
<l>    if( Length = 1)</l>
<l>        threshold (YUV_V_Reduced, SegmentedRegion, Segmentation_ColourSupport_Threshold_Min, Segmentation_ColourSupport_Threshold_Max)</l>
<l>    else</l>
<l>        threshold (YUV_V_Reduced, SegmentedRegion, Segmentation_ColourSupport_Threshold_Max, Segmentation_ColourSupport_Threshold_Min)</l>
<l>    endif</l>
<c>    * add some light filtering to reduce irritations from conveying plate</c>
<l>    if (Segmentation_ColourSupport_OpeningAfterSegmentation_MaskSize &gt;0)</l>
<l>        opening_rectangle1 (SegmentedRegion, SegmentedRegion, Segmentation_ColourSupport_OpeningAfterSegmentation_MaskSize, Segmentation_ColourSupport_OpeningAfterSegmentation_MaskSize)</l>
<l>        connection (SegmentedRegion, SupportThreshold_V_SegmentedRegion_Connected)</l>
<l>        select_shape (SupportThreshold_V_SegmentedRegion_Connected, SelectedRegions, 'area', 'and', Segmentation_ColourSupport_AreaToSelect_MinSize, 99999999)</l>
<l>        union1 (SelectedRegions, SegmentedRegion)</l>
<l>    endif</l>
<l>endif</l>
<c></c>
<l>* stop()</l>
<l>return ()</l>
</body>
<docu id="gSegmentation_ColourSupport_SegmentAndFilterOneChannel">
<parameters>
<parameter id="ImageToSegment"/>
<parameter id="RegionToReduceTo"/>
<parameter id="Segmentation_ColourSupport_AreaToSelect_MinSize"/>
<parameter id="Segmentation_ColourSupport_OpeningAfterSegmentation_MaskSize"/>
<parameter id="Segmentation_ColourSupport_Threshold_Max"/>
<parameter id="Segmentation_ColourSupport_Threshold_Min"/>
<parameter id="SegmentedRegion"/>
</parameters>
</docu>
</procedure>
<procedure name="gSegmentation_Dynthresh">
<interface>
<io>
<par name="GetShiftInBetweenImages_Rollmeasurement_StartpointRegions" base_type="iconic" dimension="0"/>
<par name="ImageForMeasurement" base_type="iconic" dimension="0"/>
<par name="hrRect_ROI" base_type="iconic" dimension="0"/>
</io>
<oo>
<par name="hrSeg" base_type="iconic" dimension="0"/>
</oo>
<ic>
<par name="iArea" base_type="ctrl" dimension="0"/>
<par name="ROI_Pos" base_type="ctrl" dimension="0"/>
<par name="ROI_Height" base_type="ctrl" dimension="0"/>
</ic>
<oc>
<par name="time_needed" base_type="ctrl" dimension="0"/>
</oc>
</interface>
<body>
<c>*********************************************************************************************************************************</c>
<c>* This procedure receives positions of spaces between the rolls (assembly line)</c>
<c>* For every position, a line is placed to search for edges ([0, 1] or [1, 0] transitions)</c>
<c>* The edge positions are used to create rectangles around capsules</c>
<c>*********************************************************************************************************************************</c>
<c>* possible errors:</c>
<c>*        caps are connected due to dark roll borders -&gt; bigger capsules which are detected as 1; solution: erosion_rectangle1(hrReg, hrReg, 1, HorizHeight) where HorizHeight is large (10+)</c>
<c>*        no caps found - erosion too strong</c>
<c>**********************</c>
<l>count_seconds(start)</l>
<c>*************</c>
<c></c>
<c>* Parameters for image processing</c>
<l>DynThreshold := 8      // threshold for dynamic threshold</l>
<l>MeanSize := 32          // size for mean image</l>
<l>* DilationSize := 3       // size for dilation rectangle (square) - value MaFr</l>
<l>DilationSize := 15       // size for dilation rectangle (square) - Value ND 2019_11_02</l>
<c></c>
<l>ErosionSize := 1        // size for dilation rectangle (square)</l>
<l>HorizHeight := 60       // height to remove horizontal connections and restore shape(erosion + dilation)</l>
<l>MaxSize := 9999999      // maximum value for shape select (size + height) </l>
<l>HeightSelect1 := 20     // smaller height for shape select</l>
<l>HeightSelect2 := 70     // larger height for shape select (also used for width)</l>
<c></c>
<c>******************************************</c>
<c>* Image Processing</c>
<c>******************************************</c>
<c>* bin for dark areas because of incident light</c>
<l>reduce_domain (ImageForMeasurement, hrRect_ROI, ImageForMeasurement_Reduced)</l>
<l>mean_image (ImageForMeasurement_Reduced, ImageForMeasurement_Reduced_Mean, MeanSize, MeanSize)</l>
<c></c>
<c></c>
<l>dyn_threshold (ImageForMeasurement_Reduced, ImageForMeasurement_Reduced_Mean, hrReg, DynThreshold, 'dark')</l>
<l>union1 (hrReg, hrReg)</l>
<l>connection (hrReg, hrReg)</l>
<l>select_shape (hrReg, hrReg, ['height'], 'and', [HeightSelect1], [MaxSize]) // remove small particles</l>
<c>** erosion_rectangle1(hrReg, hrReg, ErosionSize, ErosionSize) // suppress small noise</c>
<l>dilation_rectangle1(hrReg, hrReg, DilationSize,DilationSize) // close capsules to avoid getting removed while eroding with line later</l>
<c>* remove small areas</c>
<l>fill_up(hrReg, hrReg) // fill caps to make sure not to break rois with erosion</l>
<l>select_shape (hrReg, hrReg, ['area', 'height'], 'and', [iArea, HeightSelect2], [MaxSize, MaxSize])</l>
<c>* remove horizontal connections</c>
<l>erosion_rectangle1(hrReg, hrReg, 1, HorizHeight) // remove connections with roll gaps</l>
<l>union1 (hrReg, hrReg)</l>
<l>connection (hrReg, hrReg)</l>
<l>select_shape (hrReg, hrReg, ['height'], 'and', [HeightSelect1], [MaxSize]) // remove gap parts</l>
<l>dilation_rectangle1(hrReg, hrReg, 1, HorizHeight) // restore size by erosion with line</l>
<l>dilation_rectangle1(hrReg, hrReg, 10, 1) // restore size by erosion with line</l>
<c>* unite connected regions</c>
<l>union1 (hrReg, hrReg_Union)</l>
<l>connection (hrReg_Union, hrReg_Con)</l>
<c>* convex fill</c>
<l>shape_trans (hrReg_Con, hrReg_Filled, 'convex') // fill up</l>
<l>erosion_rectangle1(hrReg_Filled, hrReg_Filled, DilationSize,DilationSize) // restore size which has been blown up by dilation</l>
<c>* unite connected regions</c>
<l>union1 (hrReg_Filled, hrReg_Union)</l>
<l>connection (hrReg_Union, hrSeg)</l>
<l>select_shape (hrSeg, hrSeg, ['area', 'height', 'width'], 'and', [iArea, HeightSelect2, HeightSelect2], [MaxSize, MaxSize, MaxSize]) // last clean up</l>
<c>********************</c>
<l>count_seconds(end)</l>
<l>time_needed := (end-start)</l>
<c></c>
<c></c>
<l>return ()</l>
<c></c>
</body>
<docu id="gSegmentation_Dynthresh">
<parameters>
<parameter id="GetShiftInBetweenImages_Rollmeasurement_StartpointRegions"/>
<parameter id="ImageForMeasurement"/>
<parameter id="ROI_Height"/>
<parameter id="ROI_Pos"/>
<parameter id="hrRect_ROI"/>
<parameter id="hrSeg"/>
<parameter id="iArea"/>
<parameter id="time_needed"/>
</parameters>
</docu>
</procedure>
<procedure name="gSegmentation_FindProductOnRoll">
<interface>
<io>
<par name="GetShiftInBetweenImages_Rollmeasurement_StartpointRegions" base_type="iconic" dimension="0"/>
<par name="ImageForMeasurement" base_type="iconic" dimension="0"/>
<par name="Lines_ROIs_Selected" base_type="iconic" dimension="0"/>
</io>
<oo>
<par name="hrRect_ROI" base_type="iconic" dimension="0"/>
<par name="ProductMeasureDistInRoll" base_type="iconic" dimension="0"/>
<par name="GetShiftInBetweenImages_Rollmeasurement_StartpointRegions_Corrected" base_type="iconic" dimension="0"/>
</oo>
<ic>
<par name="ROI_Pos" base_type="ctrl" dimension="0"/>
<par name="ROI_Height" base_type="ctrl" dimension="0"/>
<par name="ROI_IncreaseWithBy_Factor" base_type="ctrl" dimension="0"/>
<par name="Segmentation_SelectSegmentationImage_BottomLight0_TopLight1_UVLight2" base_type="ctrl" dimension="0"/>
</ic>
<oc>
<par name="ProductMeasureWidth" base_type="ctrl" dimension="0"/>
<par name="ROI_Pos_Corrected" base_type="ctrl" dimension="0"/>
</oc>
</interface>
<body>
<l>* stop()</l>
<c></c>
<c>* Parameters for 'profile'</c>
<l>* Measure_Length := 10 // thickness of measure</l>
<c>* changed for Cola (Chic-Kles), 16.6.25 - LS</c>
<l>HeightFactor := .55     // height factor for ROI rect</l>
<l>* HeightFactor := .45     // height factor for ROI rect</l>
<l>WidthFactor := .53     // width factor for ROI rect</l>
<c>* Parameters for 'measure'</c>
<l>* Debug := 1             // 1 for drawing rectangles</l>
<l>* MeasureThreshold := 15 // threshold for MeasureHandle/edges</l>
<l>* MeasureSigma := 2.0 // was set to 2 for solid products before</l>
<l>* MeasureSigma := 1.5 // was set to 2 for solid products before</l>
<l>* MeasureThreshold := 15 // threshold for MeasureHandle/edges</l>
<c></c>
<c>* setup measure in relation to image ilumination type</c>
<l>switch (Segmentation_SelectSegmentationImage_BottomLight0_TopLight1_UVLight2)</l>
<l>case 0:</l>
<l>    MeasureThreshold := 15 // threshold for MeasureHandle/edges</l>
<l>    Measure_Length := 10 // thickness of measure</l>
<l>    MeasureSigma := 1.5 // was set to 2 for solid products before</l>
<l>    Measure_Transition := 'negative_strongest'</l>
<l>    Measure_Transition_Pos := 'negative'</l>
<l>    FindProductOnRoll_ContrastNegative := 1</l>
<l>    break</l>
<l>case 1:</l>
<l>    MeasureThreshold := 15 // threshold for MeasureHandle/edges</l>
<l>    Measure_Length := 10 // thickness of measure</l>
<l>    MeasureSigma := 1.5 // was set to 2 for solid products before</l>
<l>    Measure_Transition := 'negative_strongest'</l>
<l>    Measure_Transition_Pos := 'negative'</l>
<l>    FindProductOnRoll_ContrastNegative := 1</l>
<l>    break</l>
<l>case 2:</l>
<l>    MeasureThreshold := 30 // threshold for MeasureHandle/edges</l>
<l>    Measure_Length := 30 // thickness of measure</l>
<l>    MeasureSigma := 2.0 // was set to 2 for solid products before</l>
<l>    Measure_Transition := 'positive_strongest'</l>
<l>    Measure_Transition_Pos := 'positive'</l>
<l>    FindProductOnRoll_ContrastNegative := 0</l>
<l>    break</l>
<l>endswitch</l>
<c></c>
<l>* ROI_IncreaseWithBy_Factor := .05</l>
<l>* ROI_IncreaseWithBy_Factor := 0</l>
<l>reduce_domain (ImageForMeasurement, Lines_ROIs_Selected, ImageForProductOnRollMeasurement_Reduced)</l>
<l>intersection (GetShiftInBetweenImages_Rollmeasurement_StartpointRegions, Lines_ROIs_Selected, GetShiftInBetweenImages_Rollmeasurement_StartpointRegions)</l>
<l>select_shape (GetShiftInBetweenImages_Rollmeasurement_StartpointRegions, GetShiftInBetweenImages_Rollmeasurement_StartpointRegions, 'area', 'and', 1, 99999999) // in case an reion part is outside image due cutting with reduced roi upstream</l>
<c>* through movement the GetShiftInBetweenImages_Rollmeasurement_StartpointRegions could have been moved slightly outside the image.</c>
<c>* in this case outside regions are filtered out, outside values ROI_Pos have to be filteres as well</c>
<l>smallest_rectangle1 (Lines_ROIs_Selected, _, _, Lines_ROIs_Selected_LowestRow, _)</l>
<l>tuple_greater_equal_elem (ROI_Pos, Lines_ROIs_Selected_LowestRow, Greatereq)</l>
<l>tuple_find (Greatereq, 1, Indices_ToFilterOut)</l>
<l>if(Indices_ToFilterOut # -1)</l>
<l>    tuple_remove (ROI_Pos, Indices_ToFilterOut, ROI_Pos)</l>
<l>endif</l>
<c></c>
<c>* determine the size of image</c>
<c>* todo: why is get_image_pointer1 used instead of get_image_size?</c>
<l>* get_image_pointer1 (ImageForMeasurement, Pointer, Type, MeasureImage_Width, MeasureImage_Height)</l>
<l>get_image_size (ImageForMeasurement, MeasureImage_Width, MeasureImage_Height)</l>
<l>Start_ROI := []</l>
<l>End_ROI := []</l>
<c></c>
<l>gen_empty_region(hrUnitedRects)</l>
<l>gen_empty_region(ProductMeasureDistInRoll)</l>
<l>gen_empty_region(hrRect_ROI)</l>
<l>ProductMeasureWidth := []</l>
<c></c>
<l>get_domain(ImageForMeasurement, ImageForMeasurement_Domain)</l>
<l>smallest_rectangle1 (ImageForMeasurement_Domain, RectRow1, RectColumn1, RectRow2, RectColumn2)</l>
<l>RectWidth := RectColumn2 - RectColumn1</l>
<c>* for proper starting conditions on the sides do not use the ROI_Pos, use The Regions (GetShiftInBetweenImages_Rollmeasurement_StartpointRegions) instead</c>
<l>smallest_rectangle2 (GetShiftInBetweenImages_Rollmeasurement_StartpointRegions, Row, Column, Phi, Length1, Length2)</l>
<l>smallest_rectangle2 (Lines_ROIs_Selected, Lines_ROIs_Selected_Row, Lines_ROIs_Selected_Column, _, Lines_ROIs_Selected_Length1, Lines_ROIs_Selected_Length2)</l>
<c></c>
<l>for p := 0 to |Row|-1 by 1   </l>
<l>*     gen_rectangle2(hrSingleRect, Row[p]+2, Column[p], Phi[p], Length1[p], Measure_Length / 2)</l>
<l>    gen_rectangle2(hrSingleRect, Row[p]+2, Lines_ROIs_Selected_Column, 0, Lines_ROIs_Selected_Length2, Measure_Length / 2)</l>
<l>    intersection (ImageForMeasurement_Domain, hrSingleRect, RegionIntersection)</l>
<c>    * make shure that rect is in image</c>
<l>    smallest_rectangle2 (RegionIntersection, Row_Adapt, Column_Adapt, Phi1, Length1_Adapt, Length2_Adapt)</l>
<l>    Length1_Adapt := Length1_Adapt -4</l>
<c></c>
<l>    Use_Measure_Pos := 1</l>
<l>    if(Use_Measure_Pos = 1)</l>
<l>*         gen_rectangle2(Check_MeasureRect_Right, Row[p]+2, Lines_ROIs_Selected_Column, 0, Lines_ROIs_Selected_Length2, Measure_Length / 2)</l>
<l>*         gen_measure_rectangle2 (Row[p]+2, Lines_ROIs_Selected_Column, 0, Lines_ROIs_Selected_Length2, Measure_Length / 2, MeasureImage_Width, MeasureImage_Height, 'nearest_neighbor', MeasureHandle_Right) </l>
<l>*         gen_rectangle2(Check_MeasureRect_Left, Row[p]+2, Lines_ROIs_Selected_Column, 3.14159, Lines_ROIs_Selected_Length2, Measure_Length / 2)</l>
<l>*         gen_measure_rectangle2 (Row[p]+2, Lines_ROIs_Selected_Column, 3.14159, Lines_ROIs_Selected_Length2, Measure_Length / 2, MeasureImage_Width, MeasureImage_Height, 'nearest_neighbor', MeasureHandle_Left) </l>
<c></c>
<l>        gen_rectangle2(Check_MeasureRect_Right, Row_Adapt +2, Column_Adapt, 0, Length1_Adapt, Length2_Adapt)</l>
<l>        gen_measure_rectangle2 (Row_Adapt +2, Column_Adapt, 0, Length1_Adapt, Length2_Adapt, MeasureImage_Width, MeasureImage_Height, 'nearest_neighbor', MeasureHandle_Right) </l>
<l>        gen_rectangle2(Check_MeasureRect_Left, Row_Adapt +2, Column_Adapt, 3.14159, Length1_Adapt, Length2_Adapt)</l>
<l>        gen_measure_rectangle2 (Row_Adapt +2, Column_Adapt, 3.14159, Length1_Adapt, Length2_Adapt, MeasureImage_Width, MeasureImage_Height, 'nearest_neighbor', MeasureHandle_Left) </l>
<c></c>
<l>*         gen_measure_rectangle2 (Row[p]+2, Column[p], 0, Length1[p], Measure_Length / 2, MeasureImage_Width, MeasureImage_Height, 'nearest_neighbor', MeasureHandle_Right) </l>
<l>*         gen_measure_rectangle2 (Row[p]+2, Column[p], 3.14159, Length1[p], Measure_Length / 2, MeasureImage_Width, MeasureImage_Height, 'nearest_neighbor', MeasureHandle_Left) </l>
<l>        measure_pos (ImageForProductOnRollMeasurement_Reduced, MeasureHandle_Left, MeasureSigma, MeasureThreshold, Measure_Transition_Pos, 'first', Right_RowEdge, RightColEdge, _, _)</l>
<l>        measure_pos (ImageForProductOnRollMeasurement_Reduced, MeasureHandle_Right, MeasureSigma, MeasureThreshold, Measure_Transition_Pos, 'first', Left_RowEdge, LeftColEdge, _, _)</l>
<c>       </c>
<c>        *** Janine - Debug</c>
<c>        * Problem if tablets get out of inspection region and measurement rectangle can not find both edges of tablet</c>
<l>*         dev_clear_window ()</l>
<l>*         dev_display (ImageForMeasurement)</l>
<l>*         gen_cross_contour_xld (Cross1, Right_RowEdge, RightColEdge, 31, 0.78)</l>
<l>*         gen_cross_contour_xld (Cross2, Left_RowEdge, LeftColEdge, 31, 0.78)</l>
<l>*         dev_display (Cross1)</l>
<l>*         dev_display (Cross2)</l>
<l>*         dev_get_window (WindowHandle)</l>
<l>*         flush_buffer (WindowHandle)</l>
<l>*         stop()</l>
<c>        *** End Janine - Debug</c>
<l>        close_measure (MeasureHandle_Left)</l>
<l>        close_measure (MeasureHandle_Right)</l>
<l>*         tuple_rad (180, Rad)</l>
<l>    else</l>
<l>        gen_measure_rectangle2 (Row[p]+2, Column[p], 0, Length1[p], Measure_Length / 2, MeasureImage_Width, MeasureImage_Height, 'nearest_neighbor', MeasureHandle_Left)     </l>
<c>        * measure first (start) and last (end) edge for left ROI and create rectangle </c>
<c>        * for transparent</c>
<l>*         measure_pairs (ImageForMeasurement, Left_MeasureHandle, MeasureSigma, MeasureThreshold, Measure_Transition, 'all', _, LeftColEdge, _, _, RightColEdge, _, _, _)    </l>
<c>        * for solid  </c>
<l>        measure_pairs (ImageForMeasurement, MeasureHandle_Left, MeasureSigma, MeasureThreshold, Measure_Transition, 'all', _, LeftColEdge, _, _, RightColEdge, _, _, _)    </l>
<l>        close_measure (MeasureHandle_Left)</l>
<l>    endif</l>
<c></c>
<c>    * use exact dimensions as above to visualize measurement rectangles</c>
<l>*     gen_rectangle2(hrSingleRect, ROI_Pos[p]+2, RectWidth/2, 0, RectWidth/2, 2)</l>
<c>    * in case mutliple results were measured use most left and most right one    </c>
<l>    if (|LeftColEdge| &gt; 1) </l>
<l>        tuple_sort (LeftColEdge, Sorted)</l>
<l>        LeftColEdge := Sorted[0]</l>
<l>        tuple_sort (RightColEdge, Sorted)</l>
<l>        RightColEdge := Sorted[|RightColEdge|-1]</l>
<l>    endif</l>
<c>    </c>
<c>    * to get accurate measurement  </c>
<c>    </c>
<l>    if (RightColEdge &gt;= LeftColEdge)</l>
<l>        LengthOfMeasurement :=  RightColEdge -  LeftColEdge</l>
<l>    else</l>
<l>        LengthOfMeasurement :=  LeftColEdge - RightColEdge </l>
<l>    endif</l>
<c>    </c>
<l>    Column_Middle :=  LeftColEdge + (LengthOfMeasurement /2)</l>
<l>    if(Column_Middle # [])</l>
<l>        try</l>
<c>            *** Janine (try catch drum gesetzt)</c>
<l>            gen_rectangle2(hrSingleRect, ROI_Pos[p]+2, Column_Middle, 0, LengthOfMeasurement/2, 2)</l>
<l>            concat_obj (ProductMeasureDistInRoll, hrSingleRect, ProductMeasureDistInRoll)</l>
<l>            ProductMeasureWidth := [ProductMeasureWidth, LengthOfMeasurement]</l>
<l>        catch (Exception)</l>
<l>        endtry</l>
<c>        </c>
<l>*         dev_display (ImageForProductOnRollMeasurement_Reduced)</l>
<l>*         dev_display (ProductMeasureDistInRoll)</l>
<l>*         stop()</l>
<c>        </c>
<l>    endif</l>
<l>    Measure_Failed := 0</l>
<c>    * avoid error of finding min/max in empty list</c>
<l>    if (LeftColEdge = [])</l>
<l>        LeftColEdge := 0</l>
<l>        Measure_Failed := 1</l>
<l>    endif</l>
<l>    if (RightColEdge = [])</l>
<l>        RightColEdge := 0</l>
<l>        Measure_Failed := 1</l>
<l>    endif</l>
<c>    * first edge (Start) and last edge (End) (called left because alternative code with 2 rois left + right)</c>
<l>    Start_ROI := [Start_ROI, min(LeftColEdge)]</l>
<l>    End_ROI := [End_ROI, max(RightColEdge)]</l>
<c>    </c>
<l>    try</l>
<c>        * create rectangle around edges</c>
<l>        gen_rectangle1 (hrRect_ROI1, ROI_Pos[p]-ROI_Height*HeightFactor, Start_ROI[p]-(Start_ROI[p]*ROI_IncreaseWithBy_Factor), ROI_Pos[p]+ROI_Height*HeightFactor, End_ROI[p]+End_ROI[p]*ROI_IncreaseWithBy_Factor)</l>
<l>        test := 1</l>
<l>    catch (Exception) // if ROI_Pos is empty</l>
<l>        gen_rectangle1 (hrRect_ROI1, 0, 0, 0, 0)</l>
<l>    endtry</l>
<l>    if (Measure_Failed)</l>
<l>        gen_rectangle1 (hrRect_ROI1, 0, 0, 0, 0)</l>
<l>    endif</l>
<l>    union2 (hrRect_ROI1, hrRect_ROI, hrRect_ROI)</l>
<l>endfor</l>
<l>select_shape (ProductMeasureDistInRoll, ProductMeasureDistInRoll, 'area', 'and', 1, 99999999)</l>
<l>* dev_display (ImageForMeasurement)</l>
<l>* dev_display (ProductMeasureDistInRoll)</l>
<c></c>
<l>ROI_Pos_Corrected := ROI_Pos</l>
<l>GetShiftInBetweenImages_Rollmeasurement_StartpointRegions_Corrected := GetShiftInBetweenImages_Rollmeasurement_StartpointRegions</l>
<l>return ()</l>
</body>
<docu id="gSegmentation_FindProductOnRoll">
<parameters>
<parameter id="GetShiftInBetweenImages_Rollmeasurement_StartpointRegions"/>
<parameter id="GetShiftInBetweenImages_Rollmeasurement_StartpointRegions_Corrected"/>
<parameter id="ImageForMeasurement"/>
<parameter id="Lines_ROIs_Selected"/>
<parameter id="ProductMeasureDistInRoll"/>
<parameter id="ProductMeasureWidth"/>
<parameter id="ROI_Height"/>
<parameter id="ROI_IncreaseWithBy_Factor"/>
<parameter id="ROI_Pos"/>
<parameter id="ROI_Pos_Corrected"/>
<parameter id="Segmentation_SelectSegmentationImage_BottomLight0_TopLight1_UVLight2"/>
<parameter id="hrRect_ROI"/>
</parameters>
</docu>
</procedure>
<procedure name="gSegmentation_PrintSegmentation_DynthreshOrClassification">
<interface>
<io>
<par name="ImageReducedForColourLUT" base_type="iconic" dimension="0"/>
</io>
<oo>
<par name="ColourClassifiedTablets" base_type="iconic" dimension="0"/>
</oo>
<ic>
<par name="ColourClassificationHandle" base_type="ctrl" dimension="0"/>
<par name="TabletSpot_FeatureActive" base_type="ctrl" dimension="0"/>
</ic>
<oc>
<par name="TimeNeeded" base_type="ctrl" dimension="0"/>
</oc>
</interface>
<body>
<l>count_seconds(Seconds_Start)</l>
<c></c>
<c>* print and spots can currently not work in parallel</c>
<l>if(ColourClassificationHandle # [] and TabletSpot_FeatureActive) // in case spot detection is active and colour classification is needed </l>
<c>    </c>
<l>    classify_image_class_lut (ImageReducedForColourLUT, ClassRegions, ColourClassificationHandle)</l>
<l>    select_obj (ClassRegions, ColourClassifiedTablets, 1) </l>
<l>*     select_obj (ClassRegions, Print_Segmented, 2)</l>
<c>    </c>
<c>    * Remove the regions that were detected as background</c>
<l>    select_obj (ClassRegions, ColourClassifiedBackground, 3)</l>
<l>    difference (ColourClassifiedTablets, ColourClassifiedBackground, ColourClassifiedTablets)</l>
<c>    </c>
<l>    count_seconds(Seconds_End)</l>
<l>    TimeNeeded := (Seconds_End-Seconds_Start) * 1000-0</l>
<l>    return()</l>
<l>endif</l>
<c></c>
<l>classify_image_class_lut (ImageReducedForColourLUT, ClassRegions, ColourClassificationHandle)</l>
<l>select_obj (ClassRegions, ColourClassifiedTablets, 1)</l>
<c></c>
<l>count_seconds(Seconds_End)</l>
<l>TimeNeeded := (Seconds_End-Seconds_Start) * 1000-0</l>
<c></c>
<l>return ()</l>
</body>
<docu id="gSegmentation_PrintSegmentation_DynthreshOrClassification">
<parameters>
<parameter id="ColourClassificationHandle"/>
<parameter id="ColourClassifiedTablets"/>
<parameter id="ImageReducedForColourLUT"/>
<parameter id="TabletSpot_FeatureActive"/>
<parameter id="TimeNeeded"/>
</parameters>
</docu>
</procedure>
<procedure name="gSegmentation_SpotAndPrintSegmentation">
<interface>
<io>
<par name="ImageReducedForColourLUT" base_type="iconic" dimension="0"/>
<par name="SegmentedTablets_Union_Moved" base_type="iconic" dimension="0"/>
<par name="Lines_ROIs" base_type="iconic" dimension="0"/>
<par name="ImageOrig" base_type="iconic" dimension="0"/>
</io>
<oo>
<par name="ColourClassifiedTablets_LineSpecific" base_type="iconic" dimension="0"/>
</oo>
<ic>
<par name="ColourClassificationHandle" base_type="ctrl" dimension="0"/>
<par name="TabletSpot_FeatureActive" base_type="ctrl" dimension="0"/>
</ic>
<oc>
<par name="TimeNeeded" base_type="ctrl" dimension="0"/>
</oc>
</interface>
<body>
<l>count_seconds (Seconds_Start)</l>
<c></c>
<l>gSegmentation_PrintSegmentation_DynthreshOrClassification (ImageReducedForColourLUT, ColourClassifiedTablets, ColourClassificationHandle, TabletSpot_FeatureActive, TimeNeeded_PrintSegmentation)</l>
<c></c>
<c>*morphological filtering</c>
<l>* dilation_rectangle1 (ColourClassifiedTablets_Print, ColourClassifiedTablets_Print_Erode, 2, 2)</l>
<c></c>
<c>* select by minsize</c>
<l>* connection (ColourClassifiedTablets_Print_Erode, ColourClassifiedTablets_Print_Erode_Connected)</l>
<l>* union1 (ColourClassifiedTablets_Print_Erode_Connected, ColourClassifiedTablets_Print)</l>
<c></c>
<c></c>
<c>***** geting an reduced product hull - due to there may be effects from print in it</c>
<c>* if a spot is on outer areo of product it may leat to issue</c>
<l>connection (SegmentedTablets_Union_Moved, SegmentedTablets_Union_Moved_Connected)</l>
<l>shape_trans (SegmentedTablets_Union_Moved_Connected, SegmentedTablets_Convex, 'convex')</l>
<l>union1 (SegmentedTablets_Convex, SegmentedTablets_Convex)</l>
<l>erosion_rectangle1 (SegmentedTablets_Convex, RegionErosion, 20, 30)</l>
<c></c>
<c>* in case there are only small fragments left unite them via tablets</c>
<l>* connection (SegmentedTablets_Union_Moved, SegmentedTablets_Union_Moved_Connected)</l>
<l>* intersection (SegmentedTablets_Union_Moved_Connected,RegionErosion , RegionIntersection1)</l>
<c></c>
<l>* shape_trans (RegionIntersection1, RegionTrans, 'convex')</l>
<c></c>
<l>* intersection (RegionTrans, ColourClassifiedTablets_Print, RegionIntersection)</l>
<l>* intersection (Lines_ROIs, RegionIntersection, ColourClassifiedTablets_Print_LineSpecific)</l>
<c>***********************************************************************</c>
<c>* filter out prduct regions that cut roi regions</c>
<l>gen_empty_obj (ColourClassifiedTablets_LineSpecific)</l>
<l>count_obj (Lines_ROIs, Lines_ROIs_Number)</l>
<l>for Index_Cnt_Obj := 1 to Lines_ROIs_Number by 1    </l>
<l>    select_obj (Lines_ROIs, Lines_ROIs_Selected, Index_Cnt_Obj)</l>
<c>    *** Janine - Update for Achema</c>
<c>    *** Update for using the spot on transparent tablets with uv-light</c>
<c>    *** Actually the classified images are not used in further workflow. Why not??? </c>
<c>    *** Classification for spot is not used here!!!</c>
<l>*     intersection (Lines_ROIs_Selected, SegmentedTablets_Union_Moved, ColourClassifiedTablets_LineSpecific_temp)</l>
<l>    if (TabletSpot_FeatureActive)</l>
<l>        intersection (Lines_ROIs_Selected, ColourClassifiedTablets, ColourClassifiedTablets_LineSpecific_temp)</l>
<l>    else</l>
<l>        intersection (Lines_ROIs_Selected, SegmentedTablets_Union_Moved, ColourClassifiedTablets_LineSpecific_temp)</l>
<l>    endif</l>
<c>    *** End Janine - Update for Achema</c>
<l>    gFilterRegionsCuttingROI (Lines_ROIs_Selected, ColourClassifiedTablets_LineSpecific_temp, ImageOrig, ObjectsOnBorder, ColourClassifiedTablets_LineSpecific_SingleROI, 1, Lines_ROIs_Number, ObjectsOnBorder_Index)</l>
<l>    concat_obj (ColourClassifiedTablets_LineSpecific, ColourClassifiedTablets_LineSpecific_SingleROI, ColourClassifiedTablets_LineSpecific)</l>
<l>endfor</l>
<c></c>
<c>************** only done for spot detection - will not work for print - change maybe</c>
<l>* intersection (Lines_ROIs, ColourClassifiedTablets, ColourClassifiedTablets_LineSpecific)</l>
<c></c>
<l>count_seconds (Seconds_End)</l>
<l>TimeNeeded := (Seconds_End-Seconds_Start) * 1000.0</l>
<c></c>
<l>return ()</l>
</body>
<docu id="gSegmentation_SpotAndPrintSegmentation">
<parameters>
<parameter id="ColourClassificationHandle"/>
<parameter id="ColourClassifiedTablets_LineSpecific"/>
<parameter id="ImageOrig"/>
<parameter id="ImageReducedForColourLUT"/>
<parameter id="Lines_ROIs"/>
<parameter id="SegmentedTablets_Union_Moved"/>
<parameter id="TabletSpot_FeatureActive"/>
<parameter id="TimeNeeded"/>
</parameters>
</docu>
</procedure>
<procedure name="gSegmentation_Thresholding_ColourClassification">
<interface>
<io>
<par name="Lines_ROIs" base_type="iconic" dimension="0"/>
<par name="EjectROIs" base_type="iconic" dimension="0"/>
<par name="ImageOrig" base_type="iconic" dimension="0"/>
<par name="Preprocessed_SegmentedTablets" base_type="iconic" dimension="0"/>
</io>
<oo>
<par name="SegmentedTablets_LineSpecific" base_type="iconic" dimension="0"/>
<par name="ColourClassifiedTablets_LineSpecific" base_type="iconic" dimension="0"/>
<par name="ImageOrig_Monochrome" base_type="iconic" dimension="0"/>
<par name="ImageOrig_HSV" base_type="iconic" dimension="0"/>
<par name="Lines_ROIsUnion" base_type="iconic" dimension="0"/>
<par name="ImageOrig_Out" base_type="iconic" dimension="0"/>
<par name="GetShiftInBetweenImages_Rollmeasurement_StartpointRegions" base_type="iconic" dimension="0"/>
</oo>
<ic>
<par name="WindowHandle" base_type="ctrl" dimension="0"/>
<par name="GrabImageMetaData" base_type="ctrl" dimension="0"/>
<par name="SegmentationThreshold" base_type="ctrl" dimension="0"/>
<par name="Segmentation_ColourSupport_Active" base_type="ctrl" dimension="0"/>
<par name="Segmentation_ColourSupport_Threshold_Min" base_type="ctrl" dimension="0"/>
<par name="Segmentation_ColourSupport_Threshold_Max" base_type="ctrl" dimension="0"/>
<par name="Segmentation_ColourSupport_OpeningAfterSegmentation_MaskSize" base_type="ctrl" dimension="0"/>
<par name="Segmentation_ColourSupport_AreaToSelect_MinSize" base_type="ctrl" dimension="0"/>
<par name="Segmentation_ColourSupport_Threshold_RedMin" base_type="ctrl" dimension="0"/>
<par name="Segmentation_ColourSupport_Threshold_RedMax" base_type="ctrl" dimension="0"/>
<par name="Segmentation_SmallestSingleObjectFilter_Area_Min" base_type="ctrl" dimension="0"/>
<par name="Segmentation_DarkOnBright0_BrightOnDark_1" base_type="ctrl" dimension="0"/>
<par name="Segmentation_DynThreshold_Active" base_type="ctrl" dimension="0"/>
<par name="Segmentation_SelectSegmentationImage_BottomLight0_TopLight1_UVLight2" base_type="ctrl" dimension="0"/>
<par name="IgnoreObjectsInEjectboxesForTeachIn" base_type="ctrl" dimension="0"/>
<par name="ColourClassificationOn" base_type="ctrl" dimension="0"/>
<par name="ColourClassificationHandle" base_type="ctrl" dimension="0"/>
<par name="RGB_OR_Gray_Threshold" base_type="ctrl" dimension="0"/>
<par name="Preprocessed_SegmentedTablets_WasPrecalculated" base_type="ctrl" dimension="0"/>
<par name="TabletSpot_FeatureActive" base_type="ctrl" dimension="0"/>
<par name="Calibration_VTLane_VTPixToMM_XY" base_type="ctrl" dimension="2"/>
<par name="Calibration_FeatureActive" base_type="ctrl" dimension="0"/>
</ic>
<oc>
<par name="TimeNeeded" base_type="ctrl" dimension="0"/>
<par name="GrabImageMetaData_Out" base_type="ctrl" dimension="0"/>
<par name="Preprocessed_VTProductMeasureWidth_SubPix" base_type="ctrl" dimension="0"/>
</oc>
</interface>
<body>
<l>* global tuple gGrabSequencer_Active</l>
<c></c>
<l>count_seconds (Seconds_Start)</l>
<l>* gen_empty_obj (ImageOrig_Sequencer_HSV)</l>
<l>gen_empty_obj (ColourClassifiedTablets_LineSpecific)</l>
<l>gen_empty_obj (GetShiftInBetweenImages_Rollmeasurement_StartpointRegions)</l>
<l>gen_empty_obj (EmptyObject)</l>
<c></c>
<l>ImageOrig_Out := ImageOrig</l>
<l>Preprocessed_VTProductMeasureWidth_SubPix := dict{}</l>
<c></c>
<l>union1 (Lines_ROIs, Lines_ROIsUnion)</l>
<c>* ***************************************</c>
<l>ColourimagesAreReady := 0</l>
<c></c>
<l>gMultichanelImage_Select_CorrespondingImages_DescribedInTuple (ImageOrig, ImageOrig_HSV, TopLight_HSV_V, BottomLight_Mono, Toplight_UV_CH, Time_Needed_Mapping)</l>
<c>*</c>
<l>if (Preprocessed_SegmentedTablets_WasPrecalculated = 0)</l>
<c>    ******************************************</c>
<c></c>
<l>    ImageUp_ToGetShiftFrom := TopLight_HSV_V</l>
<l>    ImageDown_ToGetShiftFrom := BottomLight_Mono</l>
<c></c>
<l>    reduce_domain (BottomLight_Mono, Lines_ROIsUnion, BottomLight_Mono)</l>
<l>    reduce_domain (ImageUp_ToGetShiftFrom, Lines_ROIsUnion, ImageUp_ToGetShiftFrom)</l>
<l>    reduce_domain (ImageOrig_HSV, Lines_ROIsUnion, ImageOrig_HSV)</l>
<c>    </c>
<l>*     Contrastbased := 0</l>
<l>*     if(Contrastbased = 0) </l>
<c>        </c>
<l>        gDominik_GetShift (BottomLight_Mono, ImageUp_ToGetShiftFrom, GetShiftInBetweenImages_Rollmeasurement_StartpointRegions, Sequencer_MovedDistanceInBetweenGrabbedImages, ROI_Pos, ROI_Height, TimeNeeded)</l>
<l>*         stop()  </l>
<l>*         dev_set_color ('red')</l>
<l>*         dev_display (BottomLight_Mono)</l>
<l>*         dev_display (Rollmeasurement_StartpointRegions)</l>
<l>*         stop()</l>
<l>*         gSequencer_GetShiftInBetweenImages_NoEdge_ND (BottomLight_Mono, ImageUp_ToGetShiftFrom, GetShiftInBetweenImages_Rollmeasurement_StartpointRegions, 1, 0, Sequencer_MovedDistanceInBetweenGrabbedImages, ROI_Pos, ROI_Height, Time_needed)</l>
<l>*     else</l>
<l>*         gSequencer_GetShiftInBetweenImages (BottomLight_Mono, ImageUp_ToGetShiftFrom, GetShiftInBetweenImages_Rollmeasurement_StartpointRegions, 0, Sequencer_MovedDistanceInBetweenGrabbedImages, ROI_Pos, ROI_Height, Time_needed)    </l>
<l>*     endif</l>
<c></c>
<l>    GrabImageMetaData.Sequencer_MovedDistanceInBetweenGrabbedImages := Sequencer_MovedDistanceInBetweenGrabbedImages</l>
<c>    * todo: nochmal nachvollziehen, ob ROI_Height und ROI_Pos wirklich hier auf 0 gesetzt werden können</c>
<l>*     ROI_Height := 0</l>
<l>*     ROI_Pos := 0</l>
<l>    gSegmentationStep (EmptyObject, Lines_ROIs, Lines_ROIsUnion, EmptyObject, ImageOrig_HSV, ImageOrig, BottomLight_Mono, Toplight_UV_CH, GetShiftInBetweenImages_Rollmeasurement_StartpointRegions, SegmentedTablets, RGB_OR_Gray_Threshold, SegmentationThreshold, Segmentation_ColourSupport_Active, Segmentation_ColourSupport_Threshold_Min, Segmentation_ColourSupport_Threshold_Max, Segmentation_ColourSupport_OpeningAfterSegmentation_MaskSize, Segmentation_ColourSupport_AreaToSelect_MinSize, Segmentation_ColourSupport_Threshold_RedMin, Segmentation_ColourSupport_Threshold_RedMax, Segmentation_SmallestSingleObjectFilter_Area_Min, Segmentation_DarkOnBright0_BrightOnDark_1, Segmentation_DynThreshold_Active, Segmentation_SelectSegmentationImage_BottomLight0_TopLight1_UVLight2, ROI_Height, ROI_Pos, Calibration_VTLane_VTPixToMM_XY, Calibration_FeatureActive, Sequencer_MovedDistanceInBetweenGrabbedImages, TimeNeeded2, Preprocessed_VTProductMeasureWidth_SubPix)</l>
<l>else</l>
<l>    SegmentedTablets := Preprocessed_SegmentedTablets</l>
<l>    Sequencer_MovedDistanceInBetweenGrabbedImages := GrabImageMetaData.Sequencer_MovedDistanceInBetweenGrabbedImages</l>
<l>*     gSelectVariableValueFromTupleString(GrabImageMetaData_Out, 'Sequencer_MovedDistanceInBetweenGrabbedImages', Sequencer_MovedDistanceInBetweenGrabbedImages)</l>
<l>endif</l>
<c>* </c>
<c>* </c>
<c>* Remove objects in eject box while teach in - can be necessary due to tracks may have holes there - ressults in poor measurements</c>
<l>if (IgnoreObjectsInEjectboxesForTeachIn)</l>
<c>    * just for teach in remove objects in ejectboxes</c>
<l>    union1 (EjectROIs, EjectROIs_Union)</l>
<l>    difference (SegmentedTablets, EjectROIs_Union, SegmentedTablets)</l>
<l>    difference (Lines_ROIsUnion, EjectROIs_Union, Lines_ROIsUnion)</l>
<c>    * just for teach in remove objects on border</c>
<l>    gGetObjectsTouchingROI_UpperLower_Or_LeftRight (Lines_ROIsUnion, SegmentedTablets, ImageOrig, ObjectsOnBorder, 0, ObjectsOnBorder_Index)</l>
<l>    difference (SegmentedTablets, ObjectsOnBorder, SegmentedTablets)</l>
<l>endif</l>
<c>* </c>
<c></c>
<l>gFilterRegionsCuttingROI (Lines_ROIs, SegmentedTablets, ImageOrig, ObjectsOnBorder, SegmentedTablets_LineSpecific, 1, Lines_ROIs_Number, ObjectsOnBorder_Index)</l>
<c>* </c>
<c>* Sequencer shift offset calculation inbetween images</c>
<c>****************************************************************</c>
<c>* in case there is no colour segmentation needed</c>
<l>if ((ColourClassificationHandle # []) and ColourClassificationOn)</l>
<c>    * </c>
<l>    union1 (SegmentedTablets, SegmentedTablets_Union)</l>
<c>    * special treatment for empty regions- no classification</c>
<c>    * </c>
<l>    area_center (SegmentedTablets_Union, Area, _, _)</l>
<l>    if (Area = 0 or Area = [])</l>
<l>        gen_empty_obj (ColourClassifiedTablets_LineSpecific)</l>
<l>    else</l>
<c>        * Sequencer shift offset calculation in between images</c>
<c>        ****************************************************************              </c>
<l>        Sequencer_MovedDistanceInBetweenGrabbedImages := Sequencer_MovedDistanceInBetweenGrabbedImages</l>
<l>        SegmentedTablets_Union_Moved := SegmentedTablets_Union</l>
<c>        </c>
<c>        </c>
<c>        *** If UV light is used and spot feature is active then use the uv image for ColourLUT and classification</c>
<c>        *** Attention: Classifier is trained with 3-channel images </c>
<c>        ***            within "MiscTeachIn0.hdev" in procedure "CalculateColourClassification"</c>
<l>        if (Segmentation_SelectSegmentationImage_BottomLight0_TopLight1_UVLight2 = 2 and TabletSpot_FeatureActive )</l>
<l>            reduce_domain (Toplight_UV_CH, SegmentedTablets_Union_Moved, Toplight_UV_CH_Reduced)</l>
<l>            compose3 (Toplight_UV_CH_Reduced, Toplight_UV_CH_Reduced, Toplight_UV_CH_Reduced, ImageReducedForColourLUT)</l>
<l>        else</l>
<l>            reduce_domain (ImageOrig_HSV, SegmentedTablets_Union_Moved, ImageReducedForColourLUT)           </l>
<l>        endif</l>
<c>            </c>
<l>        gSegmentation_SpotAndPrintSegmentation (ImageReducedForColourLUT, SegmentedTablets_Union_Moved, Lines_ROIs, ImageOrig, ColourClassifiedTablets_LineSpecific, ColourClassificationHandle, TabletSpot_FeatureActive, TimeNeeded1)</l>
<l>    endif</l>
<l>endif</l>
<c>* </c>
<l>count_seconds (Seconds_End)</l>
<l>TimeNeeded := (Seconds_End - Seconds_Start) * 1000</l>
<c>* **********************************************</c>
<c></c>
<l>return ()</l>
<c>* </c>
</body>
<docu id="gSegmentation_Thresholding_ColourClassification">
<parameters>
<parameter id="Calibration_FeatureActive"/>
<parameter id="Calibration_VTLane_VTPixToMM_XY"/>
<parameter id="ColourClassificationHandle"/>
<parameter id="ColourClassificationOn"/>
<parameter id="ColourClassifiedTablets_LineSpecific"/>
<parameter id="EjectROIs"/>
<parameter id="GetShiftInBetweenImages_Rollmeasurement_StartpointRegions"/>
<parameter id="GrabImageMetaData"/>
<parameter id="GrabImageMetaData_Out"/>
<parameter id="IgnoreObjectsInEjectboxesForTeachIn"/>
<parameter id="ImageOrig"/>
<parameter id="ImageOrig_HSV"/>
<parameter id="ImageOrig_Monochrome"/>
<parameter id="ImageOrig_Out"/>
<parameter id="Lines_ROIs"/>
<parameter id="Lines_ROIsUnion"/>
<parameter id="Preprocessed_SegmentedTablets"/>
<parameter id="Preprocessed_SegmentedTablets_WasPrecalculated"/>
<parameter id="Preprocessed_VTProductMeasureWidth_SubPix"/>
<parameter id="RGB_OR_Gray_Threshold"/>
<parameter id="SegmentationThreshold"/>
<parameter id="Segmentation_ColourSupport_Active"/>
<parameter id="Segmentation_ColourSupport_AreaToSelect_MinSize"/>
<parameter id="Segmentation_ColourSupport_OpeningAfterSegmentation_MaskSize"/>
<parameter id="Segmentation_ColourSupport_Threshold_Max"/>
<parameter id="Segmentation_ColourSupport_Threshold_Min"/>
<parameter id="Segmentation_ColourSupport_Threshold_RedMax"/>
<parameter id="Segmentation_ColourSupport_Threshold_RedMin"/>
<parameter id="Segmentation_DarkOnBright0_BrightOnDark_1"/>
<parameter id="Segmentation_DynThreshold_Active"/>
<parameter id="Segmentation_SelectSegmentationImage_BottomLight0_TopLight1_UVLight2"/>
<parameter id="Segmentation_SmallestSingleObjectFilter_Area_Min"/>
<parameter id="SegmentedTablets_LineSpecific"/>
<parameter id="TabletSpot_FeatureActive"/>
<parameter id="TimeNeeded"/>
<parameter id="WindowHandle"/>
</parameters>
</docu>
</procedure>
<procedure name="gSegmentationStep">
<interface>
<io>
<par name="ImageOrig_RGB" base_type="iconic" dimension="0"/>
<par name="Lines_ROIs" base_type="iconic" dimension="0"/>
<par name="Lines_ROIsUnion" base_type="iconic" dimension="0"/>
<par name="ImageOrig_YUV" base_type="iconic" dimension="0"/>
<par name="ImageOrig_HSV" base_type="iconic" dimension="0"/>
<par name="ImageOrig" base_type="iconic" dimension="0"/>
<par name="BottomLight_HSV_V" base_type="iconic" dimension="0"/>
<par name="Toplight_UV_CH" base_type="iconic" dimension="0"/>
<par name="GetShiftInBetweenImages_Rollmeasurement_StartpointRegions" base_type="iconic" dimension="0"/>
</io>
<oo>
<par name="SegmentedTablets" base_type="iconic" dimension="0"/>
</oo>
<ic>
<par name="RGB_OR_Gray_Threshold" base_type="ctrl" dimension="0"/>
<par name="SegmentationThreshold" base_type="ctrl" dimension="0"/>
<par name="Segmentation_ColourSupport_Active" base_type="ctrl" dimension="0"/>
<par name="Segmentation_ColourSupport_Threshold_Min" base_type="ctrl" dimension="0"/>
<par name="Segmentation_ColourSupport_Threshold_Max" base_type="ctrl" dimension="0"/>
<par name="Segmentation_ColourSupport_OpeningAfterSegmentation_MaskSize" base_type="ctrl" dimension="0"/>
<par name="Segmentation_ColourSupport_AreaToSelect_MinSize" base_type="ctrl" dimension="0"/>
<par name="Segmentation_ColourSupport_Threshold_RedMin" base_type="ctrl" dimension="0"/>
<par name="Segmentation_ColourSupport_Threshold_RedMax" base_type="ctrl" dimension="0"/>
<par name="Segmentation_SmallestSingleObjectFilter_Area_Min" base_type="ctrl" dimension="0"/>
<par name="Segmentation_DarkOnBright0_BrightOnDark_1" base_type="ctrl" dimension="0"/>
<par name="Segmentation_DynThreshold_Active" base_type="ctrl" dimension="0"/>
<par name="Segmentation_SelectSegmentationImage_BottomLight0_TopLight1_UVLight2" base_type="ctrl" dimension="0"/>
<par name="ROI_Height" base_type="ctrl" dimension="0"/>
<par name="ROI_Pos" base_type="ctrl" dimension="0"/>
<par name="Calibration_VTLane_VTPixToMM_XY" base_type="ctrl" dimension="2"/>
<par name="Calibration_FeatureActive" base_type="ctrl" dimension="0"/>
<par name="Sequencer_MovedDistanceInBetweenGrabbedImages" base_type="ctrl" dimension="0"/>
</ic>
<oc>
<par name="TimeNeeded" base_type="ctrl" dimension="0"/>
<par name="Preprocessed_VTProductMeasureWidth_SubPix" base_type="ctrl" dimension="0"/>
</oc>
</interface>
<body>
<l>count_seconds (Seconds_Start)</l>
<l>Preprocessed_VTProductMeasureWidth_SubPix := dict{}</l>
<c></c>
<l>if (RGB_OR_Gray_Threshold = 1)</l>
<l>    gRGB_ThresholdThreaded (ImageOrig_RGB, Lines_ROIs, Lines_ROIsUnion, ImageOrig_YUV, ImageOrig_HSV, BottomLight_HSV_V, Toplight_UV_CH, GetShiftInBetweenImages_Rollmeasurement_StartpointRegions, SegmentedTablets, SegmentationThreshold, 255, SegmentationThreshold, 255, SegmentationThreshold, 255, 0, Segmentation_SmallestSingleObjectFilter_Area_Min, Segmentation_ColourSupport_Active, Segmentation_ColourSupport_Threshold_Min, Segmentation_ColourSupport_Threshold_Max, Segmentation_ColourSupport_OpeningAfterSegmentation_MaskSize, Segmentation_ColourSupport_AreaToSelect_MinSize, Segmentation_ColourSupport_Threshold_RedMin, Segmentation_ColourSupport_Threshold_RedMax, Segmentation_DarkOnBright0_BrightOnDark_1, Segmentation_DynThreshold_Active, Segmentation_SmallestSingleObjectFilter_Area_Min, ROI_Pos, ROI_Height, Segmentation_SelectSegmentationImage_BottomLight0_TopLight1_UVLight2, Calibration_VTLane_VTPixToMM_XY, Calibration_FeatureActive, Sequencer_MovedDistanceInBetweenGrabbedImages, Preprocessed_VTProductMeasureWidth_SubPix)</l>
<c>    ************ added option for segmentation preprocessing</c>
<c>    * in case backlight was used for segmentation adapt region to toplight position</c>
<l>    switch (Segmentation_SelectSegmentationImage_BottomLight0_TopLight1_UVLight2)</l>
<l>    case 0: // BottomLight</l>
<l>        if(Sequencer_MovedDistanceInBetweenGrabbedImages = [])</l>
<l>            Sequencer_MovedDistanceInBetweenGrabbedImages := 0</l>
<l>        endif</l>
<l>        move_region (SegmentedTablets, SegmentedTablets, Sequencer_MovedDistanceInBetweenGrabbedImages, 0)</l>
<l>        break</l>
<l>    endswitch</l>
<c>    * todo: read opening radius from format</c>
<l>    ToDoParametrize := 1</l>
<l>    if(ToDoParametrize = 1)</l>
<l>        opening_circle (SegmentedTablets, SegmentedTablets, 15.5) // integrated for 360 to compensate for product dirt on rolls </l>
<l>    endif</l>
<l>    select_shape (SegmentedTablets, SegmentedTablets, 'area', 'and', 1, 99999999)</l>
<l>    shape_trans (SegmentedTablets, SegmentedTablets, 'convex')</l>
<l>else</l>
<c>    * gray threshold based product segmentation</c>
<l>    rgb1_to_gray (ImageOrig_RGB, ImageOrig_Monochrome)</l>
<l>    threshold (ImageOrig_Monochrome, SegmentedTablets, SegmentationThreshold, 255)</l>
<l>endif</l>
<c></c>
<l>count_seconds (Seconds_End)</l>
<l>TimeNeeded := (Seconds_End - Seconds_Start) * 1000.0</l>
<l>return ()</l>
</body>
<docu id="gSegmentationStep">
<parameters>
<parameter id="BottomLight_HSV_V"/>
<parameter id="Calibration_FeatureActive"/>
<parameter id="Calibration_VTLane_VTPixToMM_XY"/>
<parameter id="GetShiftInBetweenImages_Rollmeasurement_StartpointRegions"/>
<parameter id="ImageOrig"/>
<parameter id="ImageOrig_HSV"/>
<parameter id="ImageOrig_RGB"/>
<parameter id="ImageOrig_YUV"/>
<parameter id="Lines_ROIs"/>
<parameter id="Lines_ROIsUnion"/>
<parameter id="Preprocessed_VTProductMeasureWidth_SubPix"/>
<parameter id="RGB_OR_Gray_Threshold"/>
<parameter id="ROI_Height"/>
<parameter id="ROI_Pos"/>
<parameter id="SegmentationThreshold"/>
<parameter id="Segmentation_ColourSupport_Active"/>
<parameter id="Segmentation_ColourSupport_AreaToSelect_MinSize"/>
<parameter id="Segmentation_ColourSupport_OpeningAfterSegmentation_MaskSize"/>
<parameter id="Segmentation_ColourSupport_Threshold_Max"/>
<parameter id="Segmentation_ColourSupport_Threshold_Min"/>
<parameter id="Segmentation_ColourSupport_Threshold_RedMax"/>
<parameter id="Segmentation_ColourSupport_Threshold_RedMin"/>
<parameter id="Segmentation_DarkOnBright0_BrightOnDark_1"/>
<parameter id="Segmentation_DynThreshold_Active"/>
<parameter id="Segmentation_SelectSegmentationImage_BottomLight0_TopLight1_UVLight2"/>
<parameter id="Segmentation_SmallestSingleObjectFilter_Area_Min"/>
<parameter id="SegmentedTablets"/>
<parameter id="Sequencer_MovedDistanceInBetweenGrabbedImages"/>
<parameter id="TimeNeeded"/>
<parameter id="Toplight_UV_CH"/>
</parameters>
</docu>
</procedure>
<procedure name="gSegmentedObjectsCutting_BasedOnProjection">
<interface>
<io>
<par name="ImageOrig" base_type="iconic" dimension="0"/>
<par name="RinnenROIs_Union" base_type="iconic" dimension="0"/>
<par name="ObjectsOnBorder" base_type="iconic" dimension="0"/>
</io>
<oo>
<par name="RemainingObject" base_type="iconic" dimension="0"/>
<par name="PartToRemove" base_type="iconic" dimension="0"/>
</oo>
<ic>
<par name="TabletWidth_Average" base_type="ctrl" dimension="0"/>
</ic>
</interface>
<body>
<l>gen_empty_obj (RemainingObject)</l>
<l>gen_empty_obj (PartToRemove)</l>
<c>* </c>
<l>count_obj (ObjectsOnBorder, ObjectsOnBorder_Number)</l>
<l>if (ObjectsOnBorder_Number &gt; 0)</l>
<c>    * </c>
<l>    for Index := 1 to ObjectsOnBorder_Number by 1</l>
<l>        select_obj (ObjectsOnBorder, ObjectsOnBorder_Selected, Index)</l>
<c>        * </c>
<l>        union1 (ObjectsOnBorder_Selected, ObjectsOnBorder_Union)</l>
<l>        smallest_rectangle1 (ObjectsOnBorder_Union, ObjectSmallestRectangle_Row1, ObjectSmallestRectangle_Col1, ObjectSmallestRectangle_Row2, ObjectSmallestRectangle_Col2)</l>
<l>        Object_Width := ObjectSmallestRectangle_Col2-ObjectSmallestRectangle_Col1</l>
<l>        Object_Height := ObjectSmallestRectangle_Row2-ObjectSmallestRectangle_Row1</l>
<c>        * </c>
<l>*         smallest_rectangle1 (ObjectsOnBorder_Union, ObjectSmallestRectangle_Row1, ObjectSmallestRectangle_Col1, ObjectSmallestRectangle_Row2, ObjectSmallestRectangle_Col2)</l>
<l>*         gen_rectangle1 (RectangleForProjection, ObjectSmallestRectangle_Row1, ObjectSmallestRectangle_Col1, ObjectSmallestRectangle_Row2, ObjectSmallestRectangle_Col2)</l>
<l>*         smallest_rectangle2 (ObjectsOnBorder_Union, Row, Column, Phi, Length1, Length2)</l>
<l>*         gen_rectangle2 (Rectangle, Row, Column, Phi, Length1, Length2)</l>
<c>        * </c>
<l>*         dev_display (ImageOrig)</l>
<l>*         dev_display (Rectangle)</l>
<l>*         dev_display (RectangleForProjection)</l>
<c>        * </c>
<c>        * </c>
<c>        * set the region to 0,0 position</c>
<l>        gen_rectangle1 (RectangleForProjection, ObjectSmallestRectangle_Row1, ObjectSmallestRectangle_Col1, ObjectSmallestRectangle_Row2, ObjectSmallestRectangle_Col2)</l>
<l>        move_region (ObjectsOnBorder_Selected, RegionToProject, -ObjectSmallestRectangle_Row1, -ObjectSmallestRectangle_Col1)</l>
<l>        region_to_bin (RegionToProject, BinImage, 255, 0, Object_Width, Object_Height)</l>
<l>        gray_projections (BinImage, BinImage, 'simple', HorProjection, VertProjection)</l>
<l>*         gray_projections (RectangleForProjection, BinImage, 'simple', HorProjection, VertProjection)</l>
<l>        create_funct_1d_array (HorProjection, Function)</l>
<c>        * Show the horizontal projections in a graphical mode</c>
<l>*         gen_empty_obj (HistoRectangles)</l>
<l>*         for i := 0 to |HorProjection| - 1 by 1</l>
<l>*             gen_rectangle1 (Rectangle, Row1 + i, HorProjection[i], Row1 + i +1, HorProjection[i] +1)</l>
<l>*             concat_obj (HistoRectangles, Rectangle, HistoRectangles)</l>
<l>*         endfor</l>
<l>*         dev_display (HistoRectangles)</l>
<c>        * </c>
<l>*         dev_clear_window ()</l>
<l>*         dev_display (ImageOrig)</l>
<l>*         dev_set_draw ('margin')</l>
<l>        funct_1d_to_pairs (Function, XValues_Original, YValues_Original)</l>
<c></c>
<l>        smooth_funct_1d_gauss (Function, 3, SmoothedFunction)</l>
<l>*         Show_FunctionHistogram (SmoothedFunction, 'blue')</l>
<l>        derivate_funct_1d (SmoothedFunction, 'first', FirstDerivative)</l>
<l>*         Show_FunctionHistogram (FirstDerivative, 'red')</l>
<l>        derivate_funct_1d (SmoothedFunction, 'second', SecondDerivative)</l>
<l>*         Show_FunctionHistogram (SecondDerivative, 'green')</l>
<c>        * Determine the positions of the zero crossings of the first derivative, i.e.,</c>
<c>        * the positions at which the (smoothed) gray value profile has minima and maxima.</c>
<l>        zero_crossings_funct_1d (FirstDerivative, ZeroCrossings)</l>
<c>        * </c>
<c>        * Select the positions of those minima (i.e., positions at which the second derivative is positive)</c>
<c>        * where the smoothed gray value profile has a high curvature, i.e., where the second derivative</c>
<c>        *  has a large absolute value. This criterion ensures that only salient lines are selected.</c>
<l>        MinimumMagnitudeOfSecondDerivative := 0.5</l>
<l>        PositionOfSalientLine := []</l>
<l>        CutpositionStart := 0</l>
<l>        gen_empty_obj (PartitioningRectangles)</l>
<c>        * </c>
<c>        * </c>
<l>        if (ZeroCrossings # [])</l>
<l>            get_y_value_funct_1d (SecondDerivative, ZeroCrossings, 'constant', Y)</l>
<l>            tuple_greater_elem (Y, MinimumMagnitudeOfSecondDerivative, Greater)</l>
<l>            tuple_sum (Greater, NumberOfIndicesToSelect)</l>
<l>            tuple_sort_index (-Greater, Indices)</l>
<l>            tuple_select_range (Indices, 0, NumberOfIndicesToSelect-1, Selected)</l>
<c>            * sort due to precise access in next loop</c>
<l>            tuple_sort (Selected, Selected)</l>
<l>            for i := 0 to |Selected| - 1 by 1</l>
<l>                CutpositionEnd := ZeroCrossings[Selected[i]]</l>
<l>                gen_rectangle1 (PartitioningObject, CutpositionStart, 0, CutpositionEnd, 1920)</l>
<l>                concat_obj (PartitioningRectangles, PartitioningObject, PartitioningRectangles)</l>
<l>                CutpositionStart := CutpositionEnd</l>
<l>            endfor</l>
<c>            * </c>
<l>            intersection (ObjectsOnBorder_Selected, PartitioningRectangles, PartToRemove)</l>
<l>            select_shape (PartToRemove, SelectedRegions, 'height', 'and', (TabletWidth_Average* 0.7), 99999999)</l>
<l>        else</l>
<l>            copy_obj (ObjectsOnBorder_Selected, PartToRemove, 1, -1)</l>
<l>        endif</l>
<c>        * </c>
<l>        difference (ObjectsOnBorder, PartToRemove, RemainingObject)</l>
<l>    endfor</l>
<c>    * </c>
<l>endif</l>
<c>* </c>
<l>return ()</l>
</body>
<docu id="gSegmentedObjectsCutting_BasedOnProjection">
<parameters>
<parameter id="ImageOrig"/>
<parameter id="ObjectsOnBorder"/>
<parameter id="PartToRemove"/>
<parameter id="RemainingObject"/>
<parameter id="RinnenROIs_Union"/>
<parameter id="TabletWidth_Average"/>
</parameters>
</docu>
</procedure>
<procedure name="gSelect_GoodAndBadObjectsViaIndex">
<interface>
<io>
<par name="Tablet_Individual" base_type="iconic" dimension="0"/>
</io>
<oo>
<par name="BadObjects" base_type="iconic" dimension="0"/>
<par name="GoodObjects" base_type="iconic" dimension="0"/>
</oo>
<ic>
<par name="Indices_BadObjects" base_type="ctrl" dimension="0"/>
<par name="Shiftregister_SaveMeasureFeatureGoodBadAtRuntime" base_type="ctrl" dimension="0"/>
</ic>
<oc>
<par name="Indices_GoodObjectsOut" base_type="ctrl" dimension="0"/>
<par name="Indices_BadObjectsOut" base_type="ctrl" dimension="0"/>
</oc>
</interface>
<body>
<c>* Select good and bad objects for further handling- if not activated tracking is done via indices</c>
<c></c>
<l>Indices_BadObjectsOut := Indices_BadObjects</l>
<l>Indices_GoodObjectsOut := []</l>
<c></c>
<c></c>
<l>if (Shiftregister_SaveMeasureFeatureGoodBadAtRuntime = 0)</l>
<l>    Indices_BadObjectsOut := []</l>
<l>    Indices_GoodObjectsOut := []</l>
<l>    gen_empty_obj (BadObjects)</l>
<l>    gen_empty_obj (GoodObjects)</l>
<l>else</l>
<c>    * first select good and bad objects</c>
<l>*     tuple_sort (Indices_BadObjectsOut, Sorted)</l>
<l>    Indices_BadObjectsOut_help := Indices_BadObjectsOut</l>
<l>    gtuple_remove_doubletts (Indices_BadObjectsOut_help, 0, Indices_BadObjectsOut, FoundMaxvalue)</l>
<l>    select_obj (Tablet_Individual, BadObjects, (Indices_BadObjectsOut + 1))</l>
<c>    </c>
<l>    count_obj (Tablet_Individual, Tablet_Individual_Number)</l>
<c>    </c>
<l>    tuple_gen_sequence (0, Tablet_Individual_Number-1, 1, Indices_GoodObjectsOut)</l>
<c>    </c>
<l>*     tuple_gen_const (Tablet_Individual_Number, 1, Indices_GoodObjectsOut)</l>
<l>*     tuple_cumul (Indices_GoodObjectsOut, Indices_GoodObjectsOut)</l>
<l>*     Indices_GoodObjectsOut := Indices_GoodObjectsOut-1 //let indices begin with 0</l>
<l>    tuple_remove (Indices_GoodObjectsOut, Indices_BadObjectsOut, Indices_GoodObjectsOut)</l>
<c>    </c>
<c>    * get the good objects</c>
<l>    select_obj (Tablet_Individual, GoodObjects, (Indices_GoodObjectsOut + 1))</l>
<l>endif</l>
<c></c>
<l>return ()</l>
</body>
<docu id="gSelect_GoodAndBadObjectsViaIndex">
<parameters>
<parameter id="BadObjects"/>
<parameter id="GoodObjects"/>
<parameter id="Indices_BadObjects"/>
<parameter id="Indices_BadObjectsOut"/>
<parameter id="Indices_GoodObjectsOut"/>
<parameter id="Shiftregister_SaveMeasureFeatureGoodBadAtRuntime"/>
<parameter id="Tablet_Individual"/>
</parameters>
</docu>
</procedure>
<procedure name="gSelect_LinespecificData_MeasuresDataOnly">
<interface>
<io>
<par name="ImageOrig" base_type="iconic" dimension="0"/>
<par name="RinnenROIs" base_type="iconic" dimension="0"/>
<par name="EjectROIs" base_type="iconic" dimension="0"/>
<par name="Products_IMeasuredRegionsPerFeature" base_type="iconic" dimension="1"/>
</io>
<oo>
<par name="Products_IMeasuredRegionsPerFeature_OneLine" base_type="iconic" dimension="1"/>
</oo>
<ic>
<par name="LineToSelect" base_type="ctrl" dimension="0"/>
<par name="Products_VT_MeasureResult_MeasureValues" base_type="ctrl" dimension="2"/>
</ic>
<oc>
<par name="Products_VT_MeasureResult_MeasureValues_OneLine" base_type="ctrl" dimension="2"/>
</oc>
</interface>
<body>
<c>* select data Products_VT_MeasureResult_MeasureValues_OneLine and the relating region data</c>
<c>* most of the functionality is copied from gSelect_LinespecificData_V2</c>
<c></c>
<l>gen_empty_obj (EmptyObject)</l>
<l>Shiftregister_SaveMeasureFeatureRegionsAtRuntime := 1</l>
<l>Shiftregister_SaveMeasureFeatureValuesAtRuntime := 1</l>
<c></c>
<l>select_obj (RinnenROIs, RinnenROI_Selected, LineToSelect+1)</l>
<l>select_obj (EjectROIs, EjectROI_Selected, LineToSelect+1)</l>
<c>* *check in complete roi and eject box</c>
<l>union2 (RinnenROI_Selected, EjectROI_Selected, LineROISelected)</l>
<c>* index based selection start </c>
<l>Tablet_Individual := Products_IMeasuredRegionsPerFeature.at(0)</l>
<c></c>
<l>intersection (Tablet_Individual, LineROISelected, Tablet_Individual_OneLine)</l>
<l>gGetObjectsTouchingROI_UpperLower_Or_LeftRight (LineROISelected, Tablet_Individual_OneLine, ImageOrig, ObjectsOnBorder, 1, ObjectsOnBorder_Index)</l>
<l>difference (Tablet_Individual_OneLine, ObjectsOnBorder, Tablet_Individual_OneLine)</l>
<c></c>
<c> </c>
<l>gGetRegionIndices_RegionSubsetInRelationToRegions (Tablet_Individual, Tablet_Individual_OneLine, Tablet_Individual_OneLine_IndicesInFullSet, Tablet_Individual_OneLine_NumberOfRegions)</l>
<c></c>
<c></c>
<l>VectorFeatureLength := Products_VT_MeasureResult_MeasureValues.length()</l>
<c></c>
<c>* just use all indices in full set</c>
<l>ObjectsIndicesCopy :=Tablet_Individual_OneLine_IndicesInFullSet</l>
<c></c>
<l>for IndexLoop := 0 to VectorFeatureLength-1 by 1</l>
<l>    if (Shiftregister_SaveMeasureFeatureValuesAtRuntime = 1)</l>
<l>        Products_VT_MeasureResult_MeasureValues_OneLine.at(IndexLoop).at(0) := Products_VT_MeasureResult_MeasureValues.at(IndexLoop).at(0)[ObjectsIndicesCopy-1]</l>
<c></c>
<l>        Products_VT_MeasureResult_MeasureValues_OneLine.at(IndexLoop).at(1) := Products_VT_MeasureResult_MeasureValues.at(IndexLoop).at(1)[ObjectsIndicesCopy-1]</l>
<l>        if ( Products_VT_MeasureResult_MeasureValues.at(IndexLoop).at(1)[ObjectsIndicesCopy-1] = [])</l>
<l>            Products_VT_MeasureResult_MeasureValues_OneLine.at(IndexLoop).at(2) := []</l>
<l>        else</l>
<l>*             NumberOfElementsForTime := |Products_VT_MeasureResult_MeasureValues_OneLine.at(IndexLoop).at(0)|</l>
<l>*             tuple_gen_const (NumberOfElementsForTime, TimeString, TimeStringToStore)</l>
<l>*             Products_VT_MeasureResult_MeasureValues_OneLine.at(IndexLoop).at(2) := TimeStringToStore</l>
<l>        endif</l>
<c>       </c>
<l>    else</l>
<l>        Products_VT_MeasureResult_MeasureValues_OneLine.at(IndexLoop).at(0) := []</l>
<l>        Products_VT_MeasureResult_MeasureValues_OneLine.at(IndexLoop).at(1) := []</l>
<l>        Products_VT_MeasureResult_MeasureValues_OneLine.at(IndexLoop).at(2) := []</l>
<l>        Products_VT_MeasureResult_MeasureValues_OneLine.at(IndexLoop).at(3) := []</l>
<l>        Products_VT_MeasureResult_MeasureValues_OneLine.at(IndexLoop).at(4) := []</l>
<l>    endif</l>
<c>    </c>
<l>    if (Shiftregister_SaveMeasureFeatureRegionsAtRuntime = 1)</l>
<l>        select_obj (Products_IMeasuredRegionsPerFeature.at(IndexLoop), Products_IMeasuredRegionsPerFeature_OneLine.at(IndexLoop), Tablet_Individual_OneLine_IndicesInFullSet)</l>
<l>    else  </l>
<l>        Products_IMeasuredRegionsPerFeature_OneLine.at(IndexLoop) := EmptyObject</l>
<l>    endif</l>
<l>endfor</l>
<c></c>
<c></c>
<l>return ()</l>
</body>
<docu id="gSelect_LinespecificData_MeasuresDataOnly">
<parameters>
<parameter id="EjectROIs"/>
<parameter id="ImageOrig"/>
<parameter id="LineToSelect"/>
<parameter id="Products_IMeasuredRegionsPerFeature"/>
<parameter id="Products_IMeasuredRegionsPerFeature_OneLine"/>
<parameter id="Products_VT_MeasureResult_MeasureValues"/>
<parameter id="Products_VT_MeasureResult_MeasureValues_OneLine"/>
<parameter id="RinnenROIs"/>
</parameters>
</docu>
</procedure>
<procedure name="gSelect_LinespecificData_V2">
<interface>
<io>
<par name="RinnenROIs" base_type="iconic" dimension="0"/>
<par name="EjectROIs" base_type="iconic" dimension="0"/>
<par name="Tablet_Individual" base_type="iconic" dimension="0"/>
<par name="GoodObjects" base_type="iconic" dimension="0"/>
<par name="BadObjects" base_type="iconic" dimension="0"/>
<par name="ImageOrig_RGB" base_type="iconic" dimension="0"/>
<par name="ImageOrig_Sequencer_RGB" base_type="iconic" dimension="0"/>
<par name="Products_IMeasuredRegionsPerFeature" base_type="iconic" dimension="1"/>
</io>
<oo>
<par name="RinnenROI_Selected" base_type="iconic" dimension="0"/>
<par name="EjectROI_Selected" base_type="iconic" dimension="0"/>
<par name="Tablet_Individual_OneLine" base_type="iconic" dimension="0"/>
<par name="GoodObjects_OneLine" base_type="iconic" dimension="0"/>
<par name="BadObjects_OneLine" base_type="iconic" dimension="0"/>
<par name="Products_IMeasuredRegionsPerFeature_OneLine" base_type="iconic" dimension="1"/>
<par name="Products_IImagePartsPerObject_OneLine" base_type="iconic" dimension="1"/>
</oo>
<ic>
<par name="LineToSelect" base_type="ctrl" dimension="0"/>
<par name="Products_VT_MeasureResult_MeasureValues" base_type="ctrl" dimension="2"/>
<par name="Shiftregister_SaveMeasureFeatureGoodBadAtRuntime" base_type="ctrl" dimension="0"/>
<par name="Shiftregister_SaveMeasureFeatureValuesAtRuntime" base_type="ctrl" dimension="0"/>
<par name="Shiftregister_SaveMeasureFeatureRegionsAtRuntime" base_type="ctrl" dimension="0"/>
<par name="Shiftregister_SaveMeasureFeaturePartImagesAtRuntime" base_type="ctrl" dimension="0"/>
<par name="EjectROIs_Column1" base_type="ctrl" dimension="0"/>
<par name="EjectROIs_Column2" base_type="ctrl" dimension="0"/>
<par name="Tablet_Individual_ColumnMiddle" base_type="ctrl" dimension="0"/>
<par name="Tablet_Individual_RowLowest" base_type="ctrl" dimension="0"/>
<par name="Tablet_Individual_RowHighest" base_type="ctrl" dimension="0"/>
<par name="ImageForVizu_Backlight0Toplight1" base_type="ctrl" dimension="0"/>
<par name="Debug_Shiftregister_Partimages_DisplayText" base_type="ctrl" dimension="0"/>
</ic>
<oc>
<par name="Tablet_Individual_OneLine_IndicesInFullSet" base_type="ctrl" dimension="0"/>
<par name="GoodObjects_OneLine_IndicesInFullSet" base_type="ctrl" dimension="0"/>
<par name="BadObjects_OneLine_IndicesInFullSet" base_type="ctrl" dimension="0"/>
<par name="Products_VT_MeasureResult_MeasureValues_OneLine" base_type="ctrl" dimension="2"/>
<par name="Products_VImagePartsOffset_TRow_TColumn_OneLine" base_type="ctrl" dimension="1"/>
</oc>
</interface>
<body>
<l>global tuple dict_InspectionVisualization</l>
<c></c>
<l>gen_empty_obj (EmptyObject)</l>
<l>Products_IImagePartsPerObject_OneLine := {}</l>
<l>Products_VImagePartsOffset_TRow_TColumn_OneLine := {[]}</l>
<c></c>
<c></c>
<l>select_obj (RinnenROIs, RinnenROI_Selected, LineToSelect+1)</l>
<l>select_obj (EjectROIs, EjectROI_Selected, LineToSelect+1)</l>
<c>* *check in complete roi and eject box</c>
<l>union2 (RinnenROI_Selected, EjectROI_Selected, LineROISelected)</l>
<c>* index based selection start </c>
<l>intersection (Tablet_Individual, LineROISelected, Tablet_Individual_OneLine)</l>
<c></c>
<c>************************* Remove objects that cut the sides of ROI´s - if object from other ROI reaches in it will conflict / lead to misleading indices for errorreview data storage</c>
<l>gGetObjectsTouchingROI_UpperLower_Or_LeftRight (RinnenROI_Selected, Tablet_Individual_OneLine, ImageOrig_RGB, ObjectsOnBorder, 1, ObjectsOnBorder_Index)</l>
<l>count_obj (ObjectsOnBorder, ObjectsOnBorder_Number)</l>
<l>if(ObjectsOnBorder_Number &gt; 0)</l>
<l>    difference (Tablet_Individual_OneLine, ObjectsOnBorder, Tablet_Individual_OneLine)</l>
<l>endif</l>
<c>*************************</c>
<c></c>
<l>gGetRegionIndices_RegionSubsetInRelationToRegions (Tablet_Individual, Tablet_Individual_OneLine, Tablet_Individual_OneLine_IndicesInFullSet, Tablet_Individual_OneLine_NumberOfRegions)</l>
<l>intersection (BadObjects, LineROISelected, BadObjects_OneLine)</l>
<l>gGetRegionIndices_RegionSubsetInRelationToRegions (Tablet_Individual, BadObjects_OneLine, BadObjects_OneLine_IndicesInFullSet, BadObjects_OneLine_NumberOfRegions)</l>
<l>intersection (GoodObjects, LineROISelected, GoodObjects_OneLine)</l>
<l>gGetRegionIndices_RegionSubsetInRelationToRegions (Tablet_Individual, GoodObjects_OneLine, GoodObjects_OneLine_IndicesInFullSet, _)</l>
<c></c>
<c>*for 360 rois may be quite wide- filter out side objects that my occure from overlapping roi´s</c>
<c>* remove objects that are on side lines of roi</c>
<c>* Tablet Individual</c>
<l>gGetObjectsTouchingROI_UpperLower_Or_LeftRight (RinnenROI_Selected, Tablet_Individual_OneLine, ImageOrig_RGB, ObjectsOnBorder, 2, ObjectsOnBorder_Index)</l>
<l>difference (Tablet_Individual_OneLine, ObjectsOnBorder, Tablet_Individual_OneLine)</l>
<c>* Bad Objects</c>
<l>gGetObjectsTouchingROI_UpperLower_Or_LeftRight (RinnenROI_Selected, BadObjects_OneLine, ImageOrig_RGB, ObjectsOnBorder, 2, ObjectsOnBorder_Index)</l>
<l>difference (BadObjects_OneLine, ObjectsOnBorder, BadObjects_OneLine)</l>
<c>* Good Objects</c>
<l>gGetObjectsTouchingROI_UpperLower_Or_LeftRight (RinnenROI_Selected, GoodObjects_OneLine, ImageOrig_RGB, ObjectsOnBorder, 2, ObjectsOnBorder_Index)</l>
<l>difference (GoodObjects_OneLine, ObjectsOnBorder, GoodObjects_OneLine)</l>
<c></c>
<c>*****************************************</c>
<c></c>
<c>* get lowest and highest point of region</c>
<l>tuple_select (Tablet_Individual_RowLowest, Tablet_Individual_OneLine_IndicesInFullSet-1, Tablet_Individual_RowLowest_OneLine)</l>
<l>tuple_select (Tablet_Individual_RowHighest, Tablet_Individual_OneLine_IndicesInFullSet-1, Tablet_Individual_RowHighest_OneLine)</l>
<c></c>
<c>* now sort the vector data so output is vector data just for one line- and set time stamp</c>
<l>get_system_time (MSecond, Second, Minute, Hour, Day, YDay, Month, Year)</l>
<l>TimeString := Hour $'.2d' + ':' + Minute $'.2d' + ':' + Second $'.2d' + '.' + MSecond $'.3d'</l>
<c></c>
<l>VectorFeatureLength := Products_VT_MeasureResult_MeasureValues.length()</l>
<l>* tuple_concat (GoodObjects_OneLine_IndicesInFullSet, BadObjects_OneLine_IndicesInFullSet, ObjectsIndicesCopy)</l>
<l>* tuple_sort (ObjectsIndicesCopy, ObjectsIndicesCopy)</l>
<c>* just use all indices in full set</c>
<l>ObjectsIndicesCopy :=Tablet_Individual_OneLine_IndicesInFullSet</l>
<c></c>
<l>for IndexLoop := 0 to VectorFeatureLength-1 by 1</l>
<l>*     if(Products_VT_MeasureResult_MeasureValues.at(IndexLoop).at(0) = []) // in case vector has empty element use give it an initialisation</l>
<l>*     Products_VT_MeasureResult_MeasureValues.at(IndexLoop).at(0)[ObjectsIndicesCopy-1] := -1</l>
<l>*     endif</l>
<l>    if (Shiftregister_SaveMeasureFeatureValuesAtRuntime = 1)</l>
<l>        Products_VT_MeasureResult_MeasureValues_OneLine.at(IndexLoop).at(0) := Products_VT_MeasureResult_MeasureValues.at(IndexLoop).at(0)[ObjectsIndicesCopy-1]</l>
<l>*         if(Products_VT_MeasureResult_MeasureValues.at(IndexLoop).at(1) = []) // in case vector has empty element use give it an initialisation</l>
<l>*         Products_VT_MeasureResult_MeasureValues.at(IndexLoop).at(1)[ObjectsIndicesCopy-1] := -1</l>
<l>*         endif</l>
<l>        Products_VT_MeasureResult_MeasureValues_OneLine.at(IndexLoop).at(1) := Products_VT_MeasureResult_MeasureValues.at(IndexLoop).at(1)[ObjectsIndicesCopy-1]</l>
<l>        if ( Products_VT_MeasureResult_MeasureValues.at(IndexLoop).at(1)[ObjectsIndicesCopy-1] = [])</l>
<l>            Products_VT_MeasureResult_MeasureValues_OneLine.at(IndexLoop).at(2) := []</l>
<l>        else</l>
<l>            NumberOfElementsForTime := |Products_VT_MeasureResult_MeasureValues_OneLine.at(IndexLoop).at(0)|</l>
<l>            tuple_gen_const (NumberOfElementsForTime, TimeString, TimeStringToStore)</l>
<l>            Products_VT_MeasureResult_MeasureValues_OneLine.at(IndexLoop).at(2) := TimeStringToStore</l>
<l>        endif</l>
<l>        Products_VT_MeasureResult_MeasureValues_OneLine.at(IndexLoop).at(3):= Tablet_Individual_RowLowest_OneLine</l>
<l>        Products_VT_MeasureResult_MeasureValues_OneLine.at(IndexLoop).at(4):= Tablet_Individual_RowHighest_OneLine</l>
<l>    else</l>
<l>        Products_VT_MeasureResult_MeasureValues_OneLine.at(IndexLoop).at(0) := []</l>
<l>        Products_VT_MeasureResult_MeasureValues_OneLine.at(IndexLoop).at(1) := []</l>
<l>        Products_VT_MeasureResult_MeasureValues_OneLine.at(IndexLoop).at(2) := []</l>
<l>        Products_VT_MeasureResult_MeasureValues_OneLine.at(IndexLoop).at(3) := []</l>
<l>        Products_VT_MeasureResult_MeasureValues_OneLine.at(IndexLoop).at(4) := []</l>
<c>        *         Products_VT_MeasureResult_MeasureValues_OneLine.at(IndexLoop).at(0) :=</c>
<l>*         Products_VT_MeasureResult_MeasureValues.at(IndexLoop).at(1)[ObjectsIndicesCopy-1] := -1</l>
<l>*         Products_VT_MeasureResult_MeasureValues_OneLine.at(IndexLoop).at(2) := []</l>
<c>        </c>
<l>    endif</l>
<c>    </c>
<l>    if (Shiftregister_SaveMeasureFeatureRegionsAtRuntime = 1)</l>
<l>        select_obj (Products_IMeasuredRegionsPerFeature.at(IndexLoop), Products_IMeasuredRegionsPerFeature_OneLine.at(IndexLoop), Tablet_Individual_OneLine_IndicesInFullSet)</l>
<l>    else  </l>
<l>        Products_IMeasuredRegionsPerFeature_OneLine.at(IndexLoop) := EmptyObject</l>
<l>    endif</l>
<l>endfor</l>
<c></c>
<l>if (Shiftregister_SaveMeasureFeaturePartImagesAtRuntime = 1)</l>
<c>    * crop image parts for every individual tablet and create tuple data crop position and timestamp around it</c>
<l>    CropOffset_X := 30</l>
<l>    CropOffset_Y := 30</l>
<c>    * decide to use rgb image or sequencer image</c>
<l>    get_image_size (ImageOrig_Sequencer_RGB, ImageOrig_Width, ImageOrig_Height)</l>
<l>    if (ImageOrig_Height = 0 or ImageOrig_Height = [])</l>
<l>        get_image_size (ImageOrig_RGB, ImageOrig_Width, ImageOrig_Height)</l>
<l>        ImageToCrop := ImageOrig_RGB</l>
<l>    else</l>
<l>        if (ImageForVizu_Backlight0Toplight1 = 0)</l>
<l>            ImageToCrop := ImageOrig_Sequencer_RGB</l>
<l>        else            </l>
<c>            *** Janine</c>
<c>            *** Show colour image in visualization of analysis</c>
<l>*             access_channel (ImageOrig_RGB, ImageToCrop, 3)</l>
<l>            ImageToCrop := ImageOrig_RGB</l>
<c>            *** End Janine</c>
<l>        endif</l>
<l>    endif</l>
<l>    for IndexLoop := 0 to Tablet_Individual_OneLine_NumberOfRegions-1 by 1     </l>
<c>        *new</c>
<l>*         select_obj (Tablet_Individual_OneLine, ObjectSelected, Tablet_Individual_OneLine_IndicesInFullSet[IndexLoop])</l>
<c>        </c>
<c>        ** old</c>
<l>        select_obj (Tablet_Individual, Tablet_Individual_Selected, Tablet_Individual_OneLine_IndicesInFullSet[IndexLoop])</l>
<l>        smallest_rectangle1 (Tablet_Individual_Selected, Row1, Column1, Row2, Column2)</l>
<l>        gDetermineCropCoordinatesInImage (CropOffset_Y, Row1, ImageOrig_Height, 0, Row1)</l>
<l>        gDetermineCropCoordinatesInImage (CropOffset_Y, Row2, ImageOrig_Height, 1, Row2)</l>
<l>        gDetermineCropCoordinatesInImage (CropOffset_X, Column1, ImageOrig_Width, 0, Column1)</l>
<l>        gDetermineCropCoordinatesInImage (CropOffset_X, Column2, ImageOrig_Width, 1, Column2)</l>
<l>        crop_rectangle1 (ImageToCrop, ImagePart, Row1, Column1, Row2, Column2)</l>
<l>        if (dict_InspectionVisualization.V_ErrorDetailImage_CounterAndIndex_Inpaint.Value)</l>
<l>            get_image_size (ImagePart, ImagePart_Width, ImagePart_Height)     </l>
<l>            open_window (0, 0, ImagePart_Width, ImagePart_Height, 0, 'buffer', '', WindowHandle)</l>
<l>            set_part (WindowHandle, 0, 0, ImagePart_Height, ImagePart_Width)</l>
<l>            disp_image (ImagePart, WindowHandle)</l>
<l>            set_tposition (WindowHandle, 1, 1)</l>
<l>            write_string (WindowHandle, Debug_Shiftregister_Partimages_DisplayText)</l>
<l>            dump_window_image (ImagePart, WindowHandle)</l>
<l>            close_window (WindowHandle)</l>
<l>        endif</l>
<l>        Products_IImagePartsPerObject_OneLine.at(IndexLoop) := ImagePart</l>
<l>        Products_VImagePartsOffset_TRow_TColumn_OneLine.at(IndexLoop) := [Row1,Column1]</l>
<l>    endfor</l>
<l>else </l>
<l>    Products_IImagePartsPerObject_OneLine.at(0) := EmptyObject</l>
<l>    Products_VImagePartsOffset_TRow_TColumn_OneLine.at(0) := []</l>
<l>endif</l>
<c></c>
<c></c>
<l>return ()</l>
</body>
<docu id="gSelect_LinespecificData_V2">
<parameters>
<parameter id="BadObjects"/>
<parameter id="BadObjects_OneLine"/>
<parameter id="BadObjects_OneLine_IndicesInFullSet"/>
<parameter id="Debug_Shiftregister_Partimages_DisplayText"/>
<parameter id="EjectROI_Selected"/>
<parameter id="EjectROIs"/>
<parameter id="EjectROIs_Column1"/>
<parameter id="EjectROIs_Column2"/>
<parameter id="GoodObjects"/>
<parameter id="GoodObjects_OneLine"/>
<parameter id="GoodObjects_OneLine_IndicesInFullSet"/>
<parameter id="ImageForVizu_Backlight0Toplight1"/>
<parameter id="ImageOrig_RGB"/>
<parameter id="ImageOrig_Sequencer_RGB"/>
<parameter id="LineToSelect"/>
<parameter id="Products_IImagePartsPerObject_OneLine"/>
<parameter id="Products_IMeasuredRegionsPerFeature"/>
<parameter id="Products_IMeasuredRegionsPerFeature_OneLine"/>
<parameter id="Products_VImagePartsOffset_TRow_TColumn_OneLine"/>
<parameter id="Products_VT_MeasureResult_MeasureValues"/>
<parameter id="Products_VT_MeasureResult_MeasureValues_OneLine"/>
<parameter id="RinnenROI_Selected"/>
<parameter id="RinnenROIs"/>
<parameter id="Shiftregister_SaveMeasureFeatureGoodBadAtRuntime"/>
<parameter id="Shiftregister_SaveMeasureFeaturePartImagesAtRuntime"/>
<parameter id="Shiftregister_SaveMeasureFeatureRegionsAtRuntime"/>
<parameter id="Shiftregister_SaveMeasureFeatureValuesAtRuntime"/>
<parameter id="Tablet_Individual"/>
<parameter id="Tablet_Individual_ColumnMiddle"/>
<parameter id="Tablet_Individual_OneLine"/>
<parameter id="Tablet_Individual_OneLine_IndicesInFullSet"/>
<parameter id="Tablet_Individual_RowHighest"/>
<parameter id="Tablet_Individual_RowLowest"/>
</parameters>
</docu>
</procedure>
<procedure name="gSelectAndDisplay_MultichannelImage">
<interface>
<io>
<par name="In_Image_Multichannel" base_type="iconic" dimension="0"/>
</io>
<oo>
<par name="Out_Image_SelectedChannel" base_type="iconic" dimension="0"/>
</oo>
<ic>
<par name="SelectVisualizationImage_BottomLight0_TopLight1_UVLight2" base_type="ctrl" dimension="0"/>
<par name="In_DisplayImage_Active" base_type="ctrl" dimension="0"/>
<par name="In_DisplayImage_ColorOfVisuImage_TransformHSVToRGB" base_type="ctrl" dimension="0"/>
</ic>
</interface>
<body>
<l>Out_Image_SelectedChannel := In_Image_Multichannel</l>
<c></c>
<c>* in a input image image two images with different illuminations are stored by added channels. Can be 5 channels or 6 channels- depending on system configuration</c>
<c>* function will select and optional display</c>
<c></c>
<l>count_channels (In_Image_Multichannel, In_Image_Multichannel_ChannelCount)</l>
<l>if (In_Image_Multichannel_ChannelCount = 5) // setting for FPGA preprocessed image. ['HSV_H_CH=1', 'HSV_S_CH=2' ,'HSV_V_CH=3', 'HSV_Sequencer_V_CH=4','HSV_Sequencer_V_Mean_CH=5']</l>
<l>    decompose5 (In_Image_Multichannel, In_Image_Multichannel_Channel1, In_Image_Multichannel_Channel2, In_Image_Multichannel_Channel3, In_Image_Multichannel_Channel4, In_Image_Multichannel_Channel5)</l>
<l>    switch (SelectVisualizationImage_BottomLight0_TopLight1_UVLight2)</l>
<l>    case 0:</l>
<l>        Out_Image_SelectedChannel := In_Image_Multichannel_Channel4 //HSV_Sequencer_V</l>
<l>        break</l>
<l>    case 1:</l>
<l>        compose3 (In_Image_Multichannel_Channel1, In_Image_Multichannel_Channel2, In_Image_Multichannel_Channel3, Out_Image_SelectedChannel)</l>
<l>        break</l>
<l>    case 2:</l>
<l>        Out_Image_SelectedChannel := In_Image_Multichannel_Channel5 // UV-Channel</l>
<l>        break</l>
<l>    endswitch</l>
<l>endif</l>
<c></c>
<c>*******if display is active</c>
<l>if (In_DisplayImage_Active)</l>
<l>    if (In_Image_Multichannel_ChannelCount = 5) // SiSo interface</l>
<l>        switch (SelectVisualizationImage_BottomLight0_TopLight1_UVLight2)        </l>
<l>        case 0:    </l>
<l>            dev_display (Out_Image_SelectedChannel)</l>
<l>            break</l>
<l>        case 1:</l>
<l>            if (In_DisplayImage_ColorOfVisuImage_TransformHSVToRGB = 1)</l>
<c>                * next line is hsv conversion</c>
<l>*                 trans_to_rgb (In_Image_Multichannel_Channel1, In_Image_Multichannel_Channel2, In_Image_Multichannel_Channel3, ImageRed, ImageGreen, ImageBlue, 'hsv')   </l>
<c>                * Silicon Software ueses HSL - so channels are switched accordingly for halcon HLS</c>
<l>                trans_to_rgb (In_Image_Multichannel_Channel1, In_Image_Multichannel_Channel3, In_Image_Multichannel_Channel2, ImageRed, ImageGreen, ImageBlue, 'hls')   </l>
<l>                compose3 (ImageRed, ImageGreen, ImageBlue, VisuImage_RGB) </l>
<l>                dev_display (VisuImage_RGB)</l>
<l>                Out_Image_SelectedChannel := VisuImage_RGB</l>
<l>            else</l>
<l>                dev_display (Out_Image_SelectedChannel)</l>
<l>            endif</l>
<l>            break</l>
<l>        case 2:</l>
<l>            dev_display (In_Image_Multichannel_Channel5) // UV-Image</l>
<l>            break</l>
<l>        endswitch</l>
<l>    else</l>
<l>        dev_display (Out_Image_SelectedChannel) // no SiSo interface</l>
<l>    endif</l>
<l>endif</l>
<c></c>
<c></c>
<l>return ()</l>
</body>
<docu id="gSelectAndDisplay_MultichannelImage">
<parameters>
<parameter id="In_DisplayImage_Active"/>
<parameter id="In_DisplayImage_ColorOfVisuImage_TransformHSVToRGB"/>
<parameter id="In_Image_Multichannel"/>
<parameter id="Out_Image_SelectedChannel"/>
<parameter id="SelectVisualizationImage_BottomLight0_TopLight1_UVLight2"/>
</parameters>
</docu>
</procedure>
<procedure name="gSelectImageForMeasurement">
<interface>
<io>
<par name="ImageOrig_HSV" base_type="iconic" dimension="0"/>
<par name="ImageOrig" base_type="iconic" dimension="0"/>
<par name="Tablet_Individual" base_type="iconic" dimension="0"/>
</io>
<oo>
<par name="Image_ForGeometricalMeasurement" base_type="iconic" dimension="0"/>
<par name="Image_ForGeometricalMeasurement_Length" base_type="iconic" dimension="0"/>
<par name="Image_ForGeometricalMeasurement_PRV" base_type="iconic" dimension="0"/>
<par name="Tablet_Individual_PositionCorrected" base_type="iconic" dimension="0"/>
<par name="Tablet_Individual_PositionCorrected_GeometricMeasure" base_type="iconic" dimension="0"/>
<par name="Tablet_Individual_PositionCorrected_LengthMeasure" base_type="iconic" dimension="0"/>
</oo>
<ic>
<par name="GrabImageMetaData" base_type="ctrl" dimension="0"/>
<par name="Segmentation_SelectSegmentationImage_BottomLight0_TopLight1_UVLight2" base_type="ctrl" dimension="0"/>
<par name="MovedDistanceInBetweenGrabbedImages" base_type="ctrl" dimension="0"/>
</ic>
</interface>
<body>
<l>Tablet_Individual_PositionCorrected := Tablet_Individual</l>
<l>Tablet_Individual_PositionCorrected_GeometricMeasure := Tablet_Individual</l>
<l>Tablet_Individual_PositionCorrected_LengthMeasure := Tablet_Individual</l>
<c></c>
<c></c>
<c></c>
<c>* select image for colour detection - top light</c>
<l>* if(GrabSequencer_Active )// if sequencer is active use second illumination for colour inspection</l>
<l>*     get_image_size (ImageOrig_Sequencer_HSV, ImageOrig_Sequencer_HSV_Width, _)</l>
<l>*     if( ImageOrig_Sequencer_HSV_Width # [])</l>
<l>*         ImageForDetection_Toplight := ImageOrig_Sequencer_HSV</l>
<l>*     else</l>
<l>*         ImageForDetection_Toplight := ImageOrig_HSV</l>
<l>*     endif</l>
<c></c>
<c>    * Selection for geometrial measure image+</c>
<l>    switch (Segmentation_SelectSegmentationImage_BottomLight0_TopLight1_UVLight2)</l>
<l>    case 0: //</l>
<c>        * in case of transparent capsules, backlight can be used for segmentation</c>
<l>        access_channel (ImageOrig, Image_ForGeometricalMeasurement, 4) // backlight for geometrical measurement</l>
<l>        access_channel (ImageOrig, Image_ForGeometricalMeasurement_Length, 4) // backlight for lehgth measurement</l>
<l>        access_channel (ImageOrig, Image_ForGeometricalMeasurement_PRV, 5) // prv/uv image</l>
<c></c>
<c>         </c>
<l>        try // in the move section there was a bug from time to time- try to get hold of data</l>
<c>            * in case segmentation was done on backlight readapt so color measurement can be done on right position</c>
<l>            move_region (Tablet_Individual_PositionCorrected, Tablet_Individual_PositionCorrected_GeometricMeasure, -MovedDistanceInBetweenGrabbedImages, 0)</l>
<l>        catch (Exception)</l>
<c>            * Access specific items of the exception.</c>
<l>            dev_get_exception_data (Exception, 'error_msg', ErrorMsg)</l>
<l>            open_file ('Bug_Report.txt', 'output', FileHandle)</l>
<l>            fwrite_string (FileHandle, Exception + '   ')</l>
<l>            close_file (FileHandle)</l>
<l>            try //write related image</l>
<l>                write_image (ImageOrig, 'tiff', 0, 'Bug_ImageOrig.tiff')</l>
<l>            catch (Exception)</l>
<l>            endtry</l>
<l>            try // write related region        </l>
<l>                write_region (Tablet_Individual_PositionCorrected, 'Bug_Tablet_Individual_PositionCorrected.hobj')</l>
<l>            catch (Exception)</l>
<l>            endtry</l>
<l>*             stop ()</l>
<l>        endtry</l>
<l>        Tablet_Individual_PositionCorrected_LengthMeasure := Tablet_Individual_PositionCorrected_GeometricMeasure // there is a different image used for length and geometrical measurement in uv</l>
<l>        break</l>
<l>    case 1: </l>
<c>        * normal use case: segmentation in toplight</c>
<c>        </c>
<c>        * V-channel for geometrical measurement (width and area)</c>
<c>        * backlight for length measurement</c>
<c>        * prv/uv light</c>
<l>        decompose5 (ImageOrig, Image1, Image2, Image_ForGeometricalMeasurement, Image_ForGeometricalMeasurement_Length, Image_ForGeometricalMeasurement_PRV)</l>
<c>        </c>
<c>        * to check if valid in teach in as well as in production environment</c>
<l>        if(MovedDistanceInBetweenGrabbedImages = [])</l>
<l>            MovedDistanceInBetweenGrabbedImages := 0</l>
<l>        endif</l>
<c>        </c>
<l>        break</l>
<l>    case 2:</l>
<c>        * segmentation in uv light</c>
<l>        access_channel (ImageOrig, Image_ForGeometricalMeasurement, 5) // uv light for geometrical measurement</l>
<l>        access_channel (ImageOrig, Image_ForGeometricalMeasurement_Length, 4) // backlight for length measurement</l>
<l>        access_channel (ImageOrig, Image_ForGeometricalMeasurement_PRV, 5) // uv light       </l>
<c></c>
<l>        Tablet_Individual_PositionCorrected_GeometricMeasure := Tablet_Individual_PositionCorrected</l>
<l>    endswitch</l>
<l>* else</l>
<l>*     ImageForDetection_Toplight := ImageOrig_HSV</l>
<l>*     Image_ForGeometricalMeasurement := ImageOrig_Toplight</l>
<l>*     Image_ForGeometricalMeasurement_Length := ImageOrig_Toplight</l>
<l>* endif</l>
<c></c>
<l>* ImageForDetection_ConsideringSequencer := ImageOrig_HSV</l>
<c></c>
<l>return ()</l>
</body>
<docu id="gSelectImageForMeasurement">
<parameters>
<parameter id="GrabImageMetaData"/>
<parameter id="ImageOrig"/>
<parameter id="ImageOrig_HSV"/>
<parameter id="Image_ForGeometricalMeasurement"/>
<parameter id="Image_ForGeometricalMeasurement_Length"/>
<parameter id="Image_ForGeometricalMeasurement_PRV"/>
<parameter id="MovedDistanceInBetweenGrabbedImages"/>
<parameter id="Segmentation_SelectSegmentationImage_BottomLight0_TopLight1_UVLight2"/>
<parameter id="Tablet_Individual"/>
<parameter id="Tablet_Individual_PositionCorrected"/>
<parameter id="Tablet_Individual_PositionCorrected_GeometricMeasure"/>
<parameter id="Tablet_Individual_PositionCorrected_LengthMeasure"/>
</parameters>
</docu>
</procedure>
<procedure name="gSequencer_GetShiftInBetweenImages">
<interface>
<io>
<par name="ImageDown" base_type="iconic" dimension="0"/>
<par name="ImageUp" base_type="iconic" dimension="0"/>
</io>
<oo>
<par name="Rollmeasurement_StartpointRegions" base_type="iconic" dimension="0"/>
</oo>
<ic>
<par name="Debug" base_type="ctrl" dimension="0"/>
</ic>
<oc>
<par name="MeanShift" base_type="ctrl" dimension="0"/>
<par name="ROI_Pos" base_type="ctrl" dimension="0"/>
<par name="ROI_Height" base_type="ctrl" dimension="0"/>
<par name="TimeNeeded" base_type="ctrl" dimension="0"/>
</oc>
</interface>
<body>
<c></c>
<c>**********************************************************************************************************************************</c>
<c>**********************************************************************************************************************************</c>
<c>* This procedure calculates the spaces between the rolls of the assembly line</c>
<c>* + calculates the shift between the image with top down and bottom light</c>
<c>* using gray projections, second derivative and picking the corresponding maximum/minimum</c>
<c>**********************************************************************************************************************************</c>
<c>* ImageDown - Toplight, ImageUp - Bottomlight</c>
<c>* possible errors:</c>
<c>*        image contrast to low/edges found due to possible gray ramp inside of gap</c>
<c>*        wrong position of gaps due to tilted image</c>
<c>*        image down has to be above/first taken image; otherwise the shift has to be in opposite direction; normally: shift downwards</c>
<c>*        smaller roi for better stripe calculation</c>
<c>**********************</c>
<l>count_seconds(Seconds_Start)</l>
<c>* Parameters</c>
<l>* SmoothSigma := 10 // 12  //12   // sigma for smoothing signals</l>
<l>* StripeWidth := 8   // stripe width grayprofile will be performed at</l>
<l>* Threshold := .15   // values from signal (grayprofile) below (min signal) and above (max signal) will be set to 0</l>
<l>* minShift := 1      // minimum shift of images</l>
<l>* maxShift := 30     // maximum shift of images</l>
<l>* MaxDist := 65      // If distance between extremal points is larger than this value, both points are not corresponding</l>
<c>************* configuration takeda 360</c>
<l>Calculate_LinesBasedOnImageUp := 1</l>
<l>SmoothSigma := 10 // 12  //12   // sigma for smoothing signals</l>
<l>StripeWidth := 8   // stripe width grayprofile will be performed at</l>
<l>Threshold := .15   // values from signal (grayprofile) below (min signal) and above (max signal) will be set to 0</l>
<l>minShift := 1      // minimum shift of images</l>
<l>maxShift := 30     // maximum shift of images</l>
<l>MaxDist := 65      // If distance between extremal points is larger than this value, both points are not corresponding</l>
<c>************* configuration Catalent360</c>
<l>Calculate_LinesBasedOnImageUp := 0</l>
<l>SmoothSigma := 10 // 12  //12   // sigma for smoothing signals</l>
<l>StripeWidth := 8   // stripe width grayprofile will be performed at</l>
<l>Threshold := .15   // values from signal (grayprofile) below (min signal) and above (max signal) will be set to 0</l>
<l>minShift := 1      // minimum shift of images</l>
<l>maxShift := 30     // maximum shift of images</l>
<l>MaxDist := 65     // If distance between extremal points is larger than this value, both points are not corresponding</l>
<c>*************</c>
<c></c>
<c>* check if necessary data for routine is available. In case only top image is available a standard segmentation has to be done later on</c>
<l>count_channels (ImageDown, ImageDown_Channels)</l>
<l>if (ImageDown_Channels = [] and Calculate_LinesBasedOnImageUp = 0)</l>
<l>    time_needed := 0</l>
<l>    MeanShift := -1</l>
<l>    ROI_Pos := []</l>
<l>    ROI_Height := []</l>
<l>    gen_empty_obj (Rollmeasurement_StartpointRegions)</l>
<l>    count_seconds(Seconds_End)</l>
<l>    TimeNeeded := (Seconds_End - Seconds_Start)*1000.0</l>
<l>    return()</l>
<l>endif</l>
<c></c>
<l>if( Calculate_LinesBasedOnImageUp = 1)</l>
<l>    ImageDown :=  ImageUp</l>
<l>endif</l>
<c></c>
<c></c>
<c>* changed size of complete image to actual domain</c>
<l>* get_image_pointer1 (ImageUp, _, _, lImgWidth, lImgHeight)</l>
<l>get_image_size (ImageUp, lImgWidth, lImgHeight)</l>
<c></c>
<c></c>
<c>* calculating grayscale images, maybe replace this with picking channels</c>
<c>* choosing up channel</c>
<l>count_channels (ImageUp, ImageUp_Channels)</l>
<c></c>
<c></c>
<l>if (ImageUp_Channels = 3)</l>
<l>    access_channel(ImageUp, hiGrayUp, 3) // V-Channel from HSV</l>
<l>else</l>
<l>    hiGrayUp := ImageUp</l>
<l>endif</l>
<c>* choosing down channel</c>
<l>count_channels(ImageDown, ChannelCount)</l>
<l>if (ChannelCount == 1)</l>
<l>    hiGrayDown := ImageDown</l>
<l>elseif (ChannelCount == 3)</l>
<l>    access_channel(ImageDown, hiGrayDown, 3)</l>
<l>endif</l>
<c>***************** modification ND 2019_10_20</c>
<l>DynamicMeasurementpath := 1</l>
<l>if(DynamicMeasurementpath = 1)</l>
<l>    gGetShiftInBetweenImages_SelectMeasurementpath (ImageDown, Rollmeasurement_StartpointRegions, lImgHeight, StripeWidth, lImgWidth, TimeNeeded1)</l>
<l>else</l>
<c>   * function was original but had issues when product was covering the measurement lines at the side</c>
<c>    * scaling images for better contrast</c>
<c>    </c>
<l>    get_domain (hiGrayUp, hiGrayUp_Domain)</l>
<c>    </c>
<l>    smallest_rectangle1 (hiGrayUp_Domain, hiGrayUp_Row1, hiGrayUp_Column1, hiGrayUp_Row2, hiGrayUp_Column2)</l>
<l>    gen_rectangle1 (Rollmeasurement_StartpointRegions, hiGrayUp_Row1, hiGrayUp_Column1, hiGrayUp_Row2, hiGrayUp_Column1 + StripeWidth)</l>
<c>    * get second rectangle on right hand side of image for more stability against capsules near image borders</c>
<l>    gen_rectangle1( hrVert2, hiGrayUp_Row1, hiGrayUp_Column2 - StripeWidth, hiGrayUp_Row2, hiGrayUp_Column2)</l>
<c></c>
<l>*     gen_rectangle1 (Rollmeasurement_StartpointRegions, 1, 1, lImgHeight, StripeWidth)</l>
<l>*     gen_rectangle1( hrVert2, 1, lImgWidth-StripeWidth, lImgHeight, lImgWidth)</l>
<l>    union2 (Rollmeasurement_StartpointRegions, hrVert2, Rollmeasurement_StartpointRegions)</l>
<l>endif</l>
<c></c>
<c>****************************</c>
<c>* reduce to lines on both image sides</c>
<c></c>
<l>reduce_domain (hiGrayDown, Rollmeasurement_StartpointRegions, hiGrayDownStrip)</l>
<l>reduce_domain (hiGrayUp, Rollmeasurement_StartpointRegions, hiGrayUpStrip)</l>
<c></c>
<l>if( Calculate_LinesBasedOnImageUp = 1)</l>
<l>    invert_image (hiGrayDownStrip, hiGrayDownStrip)</l>
<l>endif</l>
<c></c>
<c>* get gray projection/profile</c>
<l>gray_projections (Rollmeasurement_StartpointRegions, hiGrayDownStrip, 'simple', vdHorzDown, _)</l>
<l>SumHorzDown :=sum(vdHorzDown)</l>
<l>gray_projections (Rollmeasurement_StartpointRegions, hiGrayUpStrip, 'simple', vdHorzUp, _)</l>
<l>SumHorzUp :=sum(vdHorzUp)</l>
<c>* switch images if input has been switched </c>
<l>if (vdHorzUp &gt; vdHorzDown)</l>
<l>    vdBuffer := vdHorzDown</l>
<l>    vdHorzDown := vdHorzUp</l>
<l>    vdHorzUp := vdBuffer</l>
<l>endif</l>
<c>* create function from line profile</c>
<l>create_funct_1d_array( vdHorzDown, hFDown)</l>
<l>create_funct_1d_array( vdHorzUp, hFUp)</l>
<c>* remove noise // the less smoothing, the better positioning</c>
<l>smooth_funct_1d_gauss(hFDown, SmoothSigma, hFDown)</l>
<l>smooth_funct_1d_gauss(hFUp, SmoothSigma, hFUp)</l>
<c>* derivate - zero-crossing will be used later for correct position between rolls</c>
<l>derivate_funct_1d(hFDown, 'first', hFDownDeriv)</l>
<l>derivate_funct_1d(hFUp, 'first', hFUpDeriv)</l>
<c>* down is following up</c>
<l>funct_1d_to_pairs( hFDownDeriv, _, vdDerivDown)</l>
<l>funct_1d_to_pairs( hFUpDeriv, _, vdDerivUp)</l>
<c>* normalize for better threshold </c>
<c>* enlarge distances between significant extremal points and rest</c>
<l>vdDerivDown := (vdDerivDown - min(vdDerivDown)) / (max(vdDerivDown) - min(vdDerivDown))-0.5</l>
<c>* -1 before vdDerivUp if spaces are black</c>
<l>vdDerivUp   := 1-(vdDerivUp - min(vdDerivUp)) / (max(vdDerivUp) - min(vdDerivUp))-0.5</l>
<c>* drag values down to 0 line - values may be shifted due to asymmetry of extrema while normalizing</c>
<l>vdDerivDown := vdDerivDown - mean(vdDerivDown)</l>
<l>vdDerivUp := vdDerivUp - mean(vdDerivUp)</l>
<c>*********** Calculating Difference</c>
<l>vdDerivUp[find(abs(vdDerivUp) [&lt;] Threshold,1)] := 0</l>
<l>vdDerivDown[find(abs(vdDerivDown) [&lt;] Threshold,1)] := 0</l>
<c></c>
<l>vlShift := []</l>
<l>vdScore := []</l>
<c></c>
<c>* changed vdDerivDown with vdDerivUp</c>
<l>vdBase := vdDerivDown[ [minShift-1:|vdDerivDown|- maxShift-1] ]</l>
<l>for lIdx := minShift to maxShift by 1</l>
<c>    * shift profile from minshift to maxshift by increment</c>
<l>    vdTest := vdDerivUp[ [minShift-1 + lIdx:|vdDerivUp|- maxShift-1 + lIdx] ]</l>
<c>    * calculate sum of elementwise multiplactions</c>
<l>    dCurScore := sum(vdBase * vdTest)</l>
<c>    * store score, largest score is best fit</c>
<l>    vdScore := [vdScore, dCurScore]</l>
<l>endfor</l>
<c></c>
<l>vlShift := [minShift:maxShift]</l>
<l>create_funct_1d_array( vdScore, FScores)</l>
<l>local_min_max_funct_1d( FScores, 'strict_min_max', 'true', vdMin, vdMax)</l>
<c></c>
<l>if(|vdMax| &gt; 1)</l>
<l>    get_y_value_funct_1d( FScores, vdMax, 'constant', dYVals)</l>
<l>    lSortIdx := sort_index(dYVals)</l>
<l>    MeanShift := vlShift[ round(vdMax [ lSortIdx[|vdMax|-1] ] ) ]</l>
<l>else</l>
<l>    MeanShift := vlShift[round(vdMax)]</l>
<l>endif</l>
<l>* stop()</l>
<c>* Image Down used to determine gap positions // Get Roll and Gap Positions</c>
<c>* calculate middle point between min/max from profile as middle of gap</c>
<c>* left and right used as identifier to determine if difference is negative (left peak - right peak) or positive (right peak - left peak)</c>
<l>create_funct_1d_array( vdDerivDown, hFDerivDownZeroed)</l>
<l>local_min_max_funct_1d( hFDerivDownZeroed, 'strict_min_max', 'true', LeftPos, RightPos) // left == min, right == max</l>
<l>RollGapDiff := []</l>
<l>* stop()</l>
<l>res := []</l>
<l>ROI_Pos := []</l>
<l>if (|LeftPos| &lt; |RightPos|) // if more max than min exisiting (due to scratches/oil/...)</l>
<l>    for i := 0 to |LeftPos|-1 by 1 // loop through smaller first</l>
<l>        for j := 0 to |RightPos|-1 by 1 // then compare one element of larger </l>
<l>            Diff := LeftPos[i]-RightPos[j] // calculate differences between min and max position and store them into res</l>
<l>            res := [res, Diff]</l>
<l>        endfor</l>
<l>        PosSign := find(sgn(res) [==] 1,1) // find all positive differences from res (indices)</l>
<l>        if (PosSign == -1) // no value found - no iteration through list possible</l>
<c>            * do nothing/can not iterate through PosSign </c>
<l>        else // only search for positive values</l>
<l>            PosRes := res[PosSign] // only positive differences</l>
<l>            MinRes:= min(PosRes) // smallest positive difference is corresponding min/max</l>
<l>            if (MinRes &lt; MaxDist) // check if min/max distance is not too big</l>
<l>                ROI_Pos := [ROI_Pos, (LeftPos[i]+RightPos[find(res,MinRes)])/2] // store corresponding values in ROI_POS</l>
<l>            endif</l>
<l>        endif</l>
<l>        res := [] // clear res</l>
<l>    endfor       </l>
<l>elseif (|RightPos| &lt; |LeftPos|) // if more min than max exisiting (due to scratches/oil/...)</l>
<l>    for i := 0 to |RightPos|-1 by 1 // loop through smaller first</l>
<l>        for j := 0 to |LeftPos|-1 by 1 // then compare one element of larger  </l>
<l>            Diff := LeftPos[j]-RightPos[i] // calculate differences between min and max position and store them into res</l>
<l>            res := [res, Diff]</l>
<l>        endfor</l>
<l>        PosSign := find(sgn(res) [==] 1,1) // find all positive differences from res (indices)</l>
<l>        if (PosSign == -1) // no value found - no iteration through list possible</l>
<c>            * do nothing/can not iterate through PosSign </c>
<l>        else // only search for positive values</l>
<l>            PosRes := res[PosSign] // only positive differences</l>
<l>            MinRes:= min(PosRes) // smallest positive difference is corresponding min/max</l>
<l>            if (MinRes &lt; MaxDist) // check if min/max distance is not too big</l>
<l>                ROI_Pos := [ROI_Pos, (RightPos[i]+LeftPos[find(res,MinRes)])/2] // store corresponding values in ROI_POS</l>
<l>            endif</l>
<l>        endif</l>
<l>        res := [] // clear res</l>
<l>    endfor   </l>
<l>else // |RightPos| == |LeftPos|</l>
<c>    * changed due to black scatter on roll</c>
<l>    for i := 0 to |RightPos|-1 by 1 // loop through smaller first</l>
<l>        for j := 0 to |LeftPos|-1 by 1 // then compare one element of larger  </l>
<l>            Diff := LeftPos[j]-RightPos[i] // calculate differences between min and max position and store them into res</l>
<l>            res := [res, Diff]</l>
<l>        endfor</l>
<l>        PosSign := find(sgn(res) [==] 1,1) // find ps</l>
<l>        if (PosSign == -1) // no value found, take minimal value</l>
<c>            * do nothing/can not iterate through PosSign </c>
<l>        else // only search for positive values</l>
<l>            PosRes := res[PosSign] // only positive differences</l>
<l>            MinRes:= min(PosRes) // smallest positive difference is corresponding min/max</l>
<l>            if (MinRes &lt; MaxDist) // check if min/max distance is not too big</l>
<l>                ROI_Pos := [ROI_Pos, (RightPos[i]+LeftPos[find(res,MinRes)])/2] // store corresponding values in ROI_POS</l>
<l>            endif        </l>
<l>        endif</l>
<l>        res := [] // clear res</l>
<l>    endfor</l>
<l>endif</l>
<c></c>
<c>* calculating height</c>
<l>ROI_Height := []</l>
<l>if (|ROI_Pos| &gt; 1)</l>
<l>    for i := 0 to |ROI_Pos|-2 by 1</l>
<l>        ROI_Height := [ROI_Height, abs(ROI_Pos[i+1]-ROI_Pos[i])] // calculate height/distance of two rolls</l>
<l>    endfor</l>
<l>    ROI_Height := mean(ROI_Height) // get mean of heights</l>
<l>endif</l>
<c></c>
<c>*</c>
<c>*Cleanup Rollmeasurement_StartpointRegions to create lines that represent the middle position as well as the start and end points</c>
<l>gen_empty_obj (LinesInBetweenRolls_NewOutput)</l>
<l>tuple_round (ROI_Pos, ROI_Pos_Round)</l>
<l>ROI_Pos_Round_Length := |ROI_Pos_Round|</l>
<l>for Index_Cnt := 0 to ROI_Pos_Round_Length-1 by 1</l>
<l>    gen_rectangle1 (Rect_Line, ROI_Pos_Round[Index_Cnt], 0, ROI_Pos_Round[Index_Cnt], lImgWidth-1)</l>
<l>    intersection (Rollmeasurement_StartpointRegions, Rect_Line, RegionIntersection)</l>
<l>    connection (RegionIntersection, RegionIntersection)</l>
<l>    area_center (RegionIntersection, Area, Row, Column)</l>
<l>    gen_rectangle1 (MiddleLineRect, Row[0], Column[0], Row[1], Column[1]) </l>
<l>    concat_obj (LinesInBetweenRolls_NewOutput, MiddleLineRect, LinesInBetweenRolls_NewOutput)</l>
<l>endfor</l>
<l>Rollmeasurement_StartpointRegions := LinesInBetweenRolls_NewOutput</l>
<c></c>
<c></c>
<l>if(Debug = 1)</l>
<c>    * visu of regions in between rolls</c>
<l>    gen_empty_obj (Rectangle_Concat)</l>
<l>    get_image_size (ImageDown, Width, Height)</l>
<l>    for p := 0 to |ROI_Pos|-1 by 1   </l>
<l>        gen_rectangle2 (Rectangle, ROI_Pos[p]+2, Width/2, 0, Width/2, 2)</l>
<l>        concat_obj (Rectangle_Concat, Rectangle, Rectangle_Concat)</l>
<l>    endfor</l>
<l>    dev_display (ImageDown)</l>
<l>    dev_display (LinesInBetweenRolls_NewOutput)</l>
<l>endif</l>
<c></c>
<l>if(Calculate_LinesBasedOnImageUp = 1)</l>
<l>    MeanShift :=  -1</l>
<l>endif</l>
<c></c>
<l>count_seconds(Seconds_End)</l>
<l>TimeNeeded := (Seconds_End - Seconds_Start)*1000.0</l>
<c>*************</c>
<l>* global tuple gProductionLoopCounter</l>
<l>* if(gProductionLoopCounter = 304)</l>
<l>*     stop()</l>
<l>* endif</l>
<c></c>
<l>return()</l>
<c></c>
<c></c>
<c></c>
<c></c>
<c></c>
<c></c>
<c></c>
<c></c>
<c></c>
<c></c>
<c>* code from 360</c>
<c>**********************************************************************************************************************************</c>
<c>**********************************************************************************************************************************</c>
<c>* This procedure calculates the spaces between the rolls of the assembly line</c>
<c>* + calculates the shift between the image with top down and bottom light</c>
<c>* using gray projections, second derivative and picking the corresponding maximum/minimum</c>
<c>**********************************************************************************************************************************</c>
<c>* ImageDown - Durchlicht, ImageUp - Auflicht</c>
<c>* possible errors:</c>
<c>*        image contrast to low/edges found due to possible gray ramp inside of gap</c>
<c>*        wrong position of gaps due to tilted image</c>
<c>*        image down has to be above/first taken image; otherwise the shift has to be in opposite direction; normally: shift downwards</c>
<c>*        smaller roi for better stripe calculation</c>
<c>**********************</c>
<l>count_seconds(Seconds_Start)</l>
<c>************* ND new found parameter - adapted for UV </c>
<c>* Parameters</c>
<l>* SmoothSigma := 9   // sigma for smoothing signals</l>
<l>* StripeWidth := 8   // stripe width grayprofile will be performed at</l>
<l>* Threshold := .15 // 0.15   // values from signal (grayprofile) below (min signal) and above (max signal) will be set to 0</l>
<l>* minShift := 1      // minimum shift of images</l>
<l>* maxShift := 30     // maximum shift of images</l>
<l>* MaxDist := 50      // If distance between extremal points is larger than this value, both points are not corresponding</l>
<c>*************</c>
<c>************* ND new found parameter - adapted MxDist from 50 to 65</c>
<c>* Parameters</c>
<l>SmoothSigma := 10 // 12  //12   // sigma for smoothing signals</l>
<l>StripeWidth := 8   // stripe width grayprofile will be performed at</l>
<l>Threshold := .15   // values from signal (grayprofile) below (min signal) and above (max signal) will be set to 0</l>
<l>minShift := 1      // minimum shift of images</l>
<l>maxShift := 30     // maximum shift of images</l>
<l>MaxDist := 65      // If distance between extremal points is larger than this value, both points are not corresponding</l>
<c>*************</c>
<c>* ND backup</c>
<c>*************</c>
<c>* Parameters</c>
<l>* SmoothSigma := 7   // sigma for smoothing signals</l>
<l>* StripeWidth := 8   // stripe width grayprofile will be performed at</l>
<l>* Threshold := .15   // values from signal (grayprofile) below (min signal) and above (max signal) will be set to 0</l>
<l>* minShift := 1      // minimum shift of images</l>
<l>* maxShift := 50     // maximum shift of images</l>
<l>* MaxDist := 50      // If distance between extremal points is larger than this value, both points are not corresponding</l>
<c>*************</c>
<c></c>
<c>* check if necessary data for routine is available. In case only top image is available a standard segmentation has to be done later on</c>
<l>count_channels (ImageDown, ImageDown_Channels)</l>
<l>if (ImageDown_Channels = [])</l>
<l>    time_needed := 0</l>
<l>    MeanShift := -1</l>
<l>    ROI_Pos := []</l>
<l>    ROI_Height := []</l>
<l>    gen_empty_obj (Rollmeasurement_StartpointRegions)</l>
<l>    count_seconds(Seconds_End)</l>
<l>    TimeNeeded := (Seconds_End - Seconds_Start)*1000.0</l>
<l>    return()</l>
<l>endif</l>
<c></c>
<l>* get_image_pointer1 (ImageUp, _, _, lImgWidth, lImgHeight)</l>
<l>get_image_size (ImageUp, lImgWidth, lImgHeight)</l>
<c></c>
<c>* calculating grayscale images, maybe replace this with picking channels</c>
<c>* choosing up channel</c>
<l>count_channels (ImageUp, ImageUp_Channels)</l>
<c></c>
<c></c>
<l>if (ImageUp_Channels = 3)</l>
<l>    access_channel(ImageUp, hiGrayUp, 3) // V-Channel from HSV</l>
<l>else</l>
<l>    hiGrayUp := ImageUp</l>
<l>endif</l>
<c>* choosing down channel</c>
<l>count_channels(ImageDown, ChannelCount)</l>
<l>if (ChannelCount == 1)</l>
<l>    hiGrayDown := ImageDown</l>
<l>elseif (ChannelCount == 3)</l>
<l>    access_channel(ImageDown, hiGrayDown, 3)</l>
<l>endif</l>
<c>***************** modification ND 2019_10_20</c>
<l>DynamicMeasurementpath := 0</l>
<l>if(DynamicMeasurementpath = 1)</l>
<l>    gGetShiftInBetweenImages_SelectMeasurementpath (ImageDown, Rollmeasurement_StartpointRegions, lImgHeight, StripeWidth, lImgWidth, TimeNeeded2)</l>
<l>else</l>
<c>   * function was original but had issues when product was covering the measurement lines at the side</c>
<c>    * scaling images for better contrast</c>
<l>    gen_rectangle1 (Rollmeasurement_StartpointRegions, 1, 1, lImgHeight, StripeWidth)</l>
<c>    * get second rectangle on right hand side of image for more stability against capsules near image borders</c>
<l>    gen_rectangle1( hrVert2, 1, lImgWidth-StripeWidth, lImgHeight, lImgWidth)</l>
<l>    union2 (Rollmeasurement_StartpointRegions, hrVert2, Rollmeasurement_StartpointRegions)</l>
<l>endif</l>
<c></c>
<c>****************************</c>
<c></c>
<c>* reduce to lines on both image sides</c>
<l>reduce_domain (hiGrayDown, Rollmeasurement_StartpointRegions, hiGrayDownStrip)</l>
<l>reduce_domain (hiGrayUp, Rollmeasurement_StartpointRegions, hiGrayUpStrip)</l>
<c>* get gray projection/profile</c>
<l>gray_projections (Rollmeasurement_StartpointRegions, hiGrayDownStrip, 'simple', vdHorzDown, _)</l>
<l>SumHorzDown :=sum(vdHorzDown)</l>
<l>gray_projections (Rollmeasurement_StartpointRegions, hiGrayUpStrip, 'simple', vdHorzUp, _)</l>
<l>SumHorzUp :=sum(vdHorzUp)</l>
<c>* switch images if input has been switched </c>
<l>if (vdHorzUp &gt; vdHorzDown)</l>
<l>    vdBuffer := vdHorzDown</l>
<l>    vdHorzDown := vdHorzUp</l>
<l>    vdHorzUp := vdBuffer</l>
<l>endif</l>
<c>* create function from line profile</c>
<l>create_funct_1d_array( vdHorzDown, hFDown)</l>
<l>create_funct_1d_array( vdHorzUp, hFUp)</l>
<c>* remove noise // the less smoothing, the better positioning</c>
<l>smooth_funct_1d_gauss(hFDown, SmoothSigma, hFDown)</l>
<l>smooth_funct_1d_gauss(hFUp, SmoothSigma, hFUp)</l>
<c>* derivate - zero-crossing will be used later for correct position between rolls</c>
<l>derivate_funct_1d(hFDown, 'first', hFDownDeriv)</l>
<l>derivate_funct_1d(hFUp, 'first', hFUpDeriv)</l>
<c>* down is following up</c>
<l>funct_1d_to_pairs( hFDownDeriv, _, vdDerivDown)</l>
<l>funct_1d_to_pairs( hFUpDeriv, _, vdDerivUp)</l>
<c>* normalize for better threshold </c>
<c>* enlarge distances between significant extremal points and rest</c>
<l>vdDerivDown := (vdDerivDown - min(vdDerivDown)) / (max(vdDerivDown) - min(vdDerivDown))-0.5</l>
<c>* -1 before vdDerivUp if spaces are black</c>
<l>vdDerivUp   := 1-(vdDerivUp - min(vdDerivUp)) / (max(vdDerivUp) - min(vdDerivUp))-0.5</l>
<c>* drag values down to 0 line - values may be shifted due to asymmetry of extrema while normalizing</c>
<l>vdDerivDown := vdDerivDown - mean(vdDerivDown)</l>
<l>vdDerivUp := vdDerivUp - mean(vdDerivUp)</l>
<c>*********** Calculating Difference</c>
<l>vdDerivUp[find(abs(vdDerivUp) [&lt;] Threshold,1)] := 0</l>
<l>vdDerivDown[find(abs(vdDerivDown) [&lt;] Threshold,1)] := 0</l>
<c></c>
<l>vlShift := []</l>
<l>vdScore := []</l>
<c></c>
<c>* changed vdDerivDown with vdDerivUp</c>
<l>vdBase := vdDerivDown[ [minShift-1:|vdDerivDown|- maxShift-1] ]</l>
<l>for lIdx := minShift to maxShift by 1</l>
<c>    * shift profile from minshift to maxshift by increment</c>
<l>    vdTest := vdDerivUp[ [minShift-1 + lIdx:|vdDerivUp|- maxShift-1 + lIdx] ]</l>
<c>    * calculate sum of elementwise multiplactions</c>
<l>    dCurScore := sum(vdBase * vdTest)</l>
<c>    * store score, largest score is best fit</c>
<l>    vdScore := [vdScore, dCurScore]</l>
<l>endfor</l>
<c></c>
<l>vlShift := [minShift:maxShift]</l>
<l>create_funct_1d_array( vdScore, FScores)</l>
<l>local_min_max_funct_1d( FScores, 'strict_min_max', 'true', vdMin, vdMax)</l>
<c></c>
<l>if( |vdMax| &gt; 1)</l>
<l>    get_y_value_funct_1d( FScores, vdMax, 'constant', dYVals)</l>
<l>    lSortIdx := sort_index(dYVals)</l>
<l>    MeanShift := vlShift[ round(vdMax [ lSortIdx[|vdMax|-1] ] ) ]</l>
<l>else</l>
<l>    MeanShift := vlShift[round(vdMax)]</l>
<l>endif</l>
<c></c>
<c>* Image Down used to determine gap positions // Get Roll and Gap Positions</c>
<c>* calculate middle point between min/max from profile as middle of gap</c>
<c>* left and right used as identifier to determine if difference is negative (left peak - right peak) or positive (right peak - left peak)</c>
<l>create_funct_1d_array( vdDerivDown, hFDerivDownZeroed)</l>
<l>local_min_max_funct_1d( hFDerivDownZeroed, 'strict_min_max', 'true', LeftPos, RightPos) // left == min, right == max</l>
<l>RollGapDiff := []</l>
<l>res := []</l>
<l>ROI_Pos := []</l>
<l>if (|LeftPos| &lt; |RightPos|) // if more max than min exisiting (due to scratches/oil/...)</l>
<l>    for i := 0 to |LeftPos|-1 by 1 // loop through smaller first</l>
<l>        for j := 0 to |RightPos|-1 by 1 // then compare one element of larger </l>
<l>            Diff := LeftPos[i]-RightPos[j] // calculate differences between min and max position and store them into res</l>
<l>            res := [res, Diff]</l>
<l>        endfor</l>
<l>        PosSign := find(sgn(res) [==] 1,1) // find all positive differences from res (indices)</l>
<l>        if (PosSign == -1) // no value found - no iteration through list possible</l>
<c>            * do nothing/can not iterate through PosSign </c>
<l>        else // only search for positive values</l>
<l>            PosRes := res[PosSign] // only positive differences</l>
<l>            MinRes:= min(PosRes) // smallest positive difference is corresponding min/max</l>
<l>            if (MinRes &lt; MaxDist) // check if min/max distance is not too big</l>
<l>                ROI_Pos := [ROI_Pos, (LeftPos[i]+RightPos[find(res,MinRes)])/2] // store corresponding values in ROI_POS</l>
<l>            endif</l>
<l>        endif</l>
<l>        res := [] // clear res</l>
<l>    endfor       </l>
<l>elseif (|RightPos| &lt; |LeftPos|) // if more min than max exisiting (due to scratches/oil/...)</l>
<l>    for i := 0 to |RightPos|-1 by 1 // loop through smaller first</l>
<l>        for j := 0 to |LeftPos|-1 by 1 // then compare one element of larger  </l>
<l>            Diff := LeftPos[j]-RightPos[i] // calculate differences between min and max position and store them into res</l>
<l>            res := [res, Diff]</l>
<l>        endfor</l>
<l>        PosSign := find(sgn(res) [==] 1,1) // find all positive differences from res (indices)</l>
<l>        if (PosSign == -1) // no value found - no iteration through list possible</l>
<c>            * do nothing/can not iterate through PosSign </c>
<l>        else // only search for positive values</l>
<l>            PosRes := res[PosSign] // only positive differences</l>
<l>            MinRes:= min(PosRes) // smallest positive difference is corresponding min/max</l>
<l>            if (MinRes &lt; MaxDist) // check if min/max distance is not too big</l>
<l>                ROI_Pos := [ROI_Pos, (RightPos[i]+LeftPos[find(res,MinRes)])/2] // store corresponding values in ROI_POS</l>
<l>            endif</l>
<l>        endif</l>
<l>        res := [] // clear res</l>
<l>    endfor   </l>
<l>else // |RightPos| == |LeftPos|</l>
<c>    * changed due to black scatter on roll</c>
<l>    for i := 0 to |RightPos|-1 by 1 // loop through smaller first</l>
<l>        for j := 0 to |LeftPos|-1 by 1 // then compare one element of larger  </l>
<l>            Diff := LeftPos[j]-RightPos[i] // calculate differences between min and max position and store them into res</l>
<l>            res := [res, Diff]</l>
<l>        endfor</l>
<l>        PosSign := find(sgn(res) [==] 1,1) // find ps</l>
<l>        if (PosSign == -1) // no value found, take minimal value</l>
<c>            * do nothing/can not iterate through PosSign </c>
<l>        else // only search for positive values</l>
<l>            PosRes := res[PosSign] // only positive differences</l>
<l>            MinRes:= min(PosRes) // smallest positive difference is corresponding min/max</l>
<l>            if (MinRes &lt; MaxDist) // check if min/max distance is not too big</l>
<l>                ROI_Pos := [ROI_Pos, (RightPos[i]+LeftPos[find(res,MinRes)])/2] // store corresponding values in ROI_POS</l>
<l>            endif        </l>
<l>        endif</l>
<l>        res := [] // clear res</l>
<l>    endfor</l>
<l>endif</l>
<c></c>
<c>* calculating height</c>
<l>ROI_Height := []</l>
<l>if (|ROI_Pos| &gt; 1)</l>
<l>    for i := 0 to |ROI_Pos|-2 by 1</l>
<l>        ROI_Height := [ROI_Height, abs(ROI_Pos[i+1]-ROI_Pos[i])] // calculate height/distance of two rolls</l>
<l>    endfor</l>
<l>    ROI_Height := mean(ROI_Height) // get mean of heights</l>
<l>endif</l>
<c></c>
<c>*</c>
<c>*Cleanup Rollmeasurement_StartpointRegions to create lines that represent the middle position as well as the start and end points</c>
<l>gen_empty_obj (LinesInBetweenRolls_NewOutput)</l>
<l>tuple_round (ROI_Pos, ROI_Pos_Round)</l>
<l>ROI_Pos_Round_Length := |ROI_Pos_Round|</l>
<l>for Index_Cnt := 0 to ROI_Pos_Round_Length-1 by 1</l>
<l>    gen_rectangle1 (Rect_Line, ROI_Pos_Round[Index_Cnt], 0, ROI_Pos_Round[Index_Cnt], lImgWidth-1)</l>
<l>    intersection (Rollmeasurement_StartpointRegions, Rect_Line, RegionIntersection)</l>
<l>    connection (RegionIntersection, RegionIntersection)</l>
<l>    area_center (RegionIntersection, Area, Row, Column)</l>
<l>    gen_rectangle1 (MiddleLineRect, Row[0], Column[0], Row[1], Column[1]) </l>
<l>    concat_obj (LinesInBetweenRolls_NewOutput, MiddleLineRect, LinesInBetweenRolls_NewOutput)</l>
<l>endfor</l>
<l>Rollmeasurement_StartpointRegions := LinesInBetweenRolls_NewOutput</l>
<c></c>
<c></c>
<l>if(Debug = 1)</l>
<c>    * visu of regions in between rolls</c>
<l>    gen_empty_obj (Rectangle_Concat)</l>
<l>    get_image_size (ImageDown, Width, Height)</l>
<l>    for p := 0 to |ROI_Pos|-1 by 1   </l>
<l>        gen_rectangle2 (Rectangle, ROI_Pos[p]+2, Width/2, 0, Width/2, 2)</l>
<l>        concat_obj (Rectangle_Concat, Rectangle, Rectangle_Concat)</l>
<l>    endfor</l>
<l>    dev_display (ImageDown)</l>
<l>    dev_display (LinesInBetweenRolls_NewOutput)</l>
<l>endif</l>
<c></c>
<l>count_seconds(Seconds_End)</l>
<l>TimeNeeded := (Seconds_End - Seconds_Start)*1000.0</l>
<c>*************</c>
<l>* global tuple gProductionLoopCounter</l>
<l>* if(gProductionLoopCounter = 304)</l>
<l>*     stop()</l>
<l>* endif</l>
<l>return()</l>
<c></c>
<c></c>
<c></c>
</body>
<docu id="gSequencer_GetShiftInBetweenImages">
<parameters>
<parameter id="Debug"/>
<parameter id="ImageDown"/>
<parameter id="ImageUp"/>
<parameter id="MeanShift"/>
<parameter id="ROI_Height"/>
<parameter id="ROI_Pos"/>
<parameter id="Rollmeasurement_StartpointRegions"/>
<parameter id="TimeNeeded"/>
</parameters>
</docu>
</procedure>
<procedure name="gSequencer_GetShiftInBetweenImages_NoEdge_ND">
<interface>
<io>
<par name="ImageDown" base_type="iconic" dimension="0"/>
<par name="ImageUp" base_type="iconic" dimension="0"/>
</io>
<oo>
<par name="Rollmeasurement_StartpointRegions" base_type="iconic" dimension="0"/>
</oo>
<ic>
<par name="Dynthreshold0_Threshold1" base_type="ctrl" dimension="0"/>
<par name="Debug" base_type="ctrl" dimension="0"/>
</ic>
<oc>
<par name="MeanShift" base_type="ctrl" dimension="0"/>
<par name="ROI_Pos" base_type="ctrl" dimension="0"/>
<par name="ROI_Height" base_type="ctrl" dimension="0"/>
<par name="TimeNeeded" base_type="ctrl" dimension="0"/>
</oc>
</interface>
<body>
<c>* in image up as well in image down contrast can be identified within rolls</c>
<l>count_seconds(Seconds_Start)</l>
<l>gen_empty_obj (Rollmeasurement_StartpointRegions)</l>
<c></c>
<l>MeanShift := -1</l>
<l>ROI_Pos := []</l>
<l>ROI_Height := []</l>
<c></c>
<l>get_domain (ImageUp, ImageUp_Domain)</l>
<l>smallest_rectangle1 (ImageUp_Domain, ImageUp_Row1, ImageUp_Column1, ImageUp_Row2, ImageUp_Column2)</l>
<l>ImageUp_Width := ImageUp_Column2 - ImageUp_Column1</l>
<l>ImageUp_Height := ImageUp_Row2 - ImageUp_Row1</l>
<c></c>
<c>* select segmentation areas left right of image</c>
<l>SegmentationWidth := 100</l>
<l>gen_rectangle1 (Rectangle_Left, ImageUp_Row1, ImageUp_Column1, ImageUp_Row2, ImageUp_Column1 + SegmentationWidth)</l>
<l>SegmentFromOneSide := 1</l>
<l>if(SegmentFromOneSide = 1)</l>
<l>    reduce_domain (ImageDown, Rectangle_Left, ImageDown_Reduced)</l>
<l>else</l>
<l>    gen_rectangle1 (Rectangle_Right, ImageUp_Row1, ImageUp_Column2 -  SegmentationWidth, ImageUp_Row2, ImageUp_Column2)</l>
<l>    union2 (Rectangle_Left, Rectangle_Right, RegionForSegmentation)</l>
<l>    reduce_domain (ImageDown, RegionForSegmentation, ImageDown_Reduced)</l>
<l>endif</l>
<c></c>
<l>* ImageDown_Dynthreshold0_Threshold1 := 0</l>
<l>ErosionHeigth := 10</l>
<c></c>
<l>if (Dynthreshold0_Threshold1 = 0)</l>
<l>    SegmentationThresh_Low := 30</l>
<l>    SegmentationThresh_High := 255</l>
<l>    threshold (ImageDown_Reduced, Segmented_Gaps_ImageDown, SegmentationThresh_Low, SegmentationThresh_High)</l>
<l>    erosion_rectangle1 (Segmented_Gaps_ImageDown, Segmented_Gaps_ImageDown, 10, ErosionHeigth)</l>
<l>else</l>
<l>    mean_image (ImageDown_Reduced, ImageMean, 5, 25)</l>
<l>    dyn_threshold (ImageDown_Reduced, ImageMean, RegionDynThresh, 15, 'light') // was 7  // was light/dark?</l>
<l>    erosion_rectangle1 (RegionDynThresh, RegionDynThresh, 5, 5)</l>
<c>    </c>
<l>    connection (RegionDynThresh, RegionDynThresh)</l>
<c>   </c>
<l>    select_shape (RegionDynThresh, RegionDynThresh, 'area', 'and', 15, 99999)</l>
<l>    closing_rectangle1 (RegionDynThresh, Segmented_Gaps_ImageDown, 4, 32)</l>
<l>    union1 (RegionDynThresh, RegionDynThresh)</l>
<c>    </c>
<l>endif</l>
<c></c>
<l>* partition_rectangle (Segmented_Gaps_ImageDown, Segmented_Gaps_ImageDown, 10, 250)</l>
<c></c>
<c></c>
<l>connection (Segmented_Gaps_ImageDown, Segmented_Gaps_ImageDown)</l>
<c></c>
<c>* get rid of objects that are too large in height</c>
<l>* select_shape (Segmented_Gaps_ImageDown, Segmented_Gaps_ImageDown, 'height', 'and',20, 50)</l>
<l>select_shape (Segmented_Gaps_ImageDown, Segmented_Gaps_ImageDown, 'height', 'and',6, 20)</l>
<l>select_shape (Segmented_Gaps_ImageDown, Segmented_Gaps_ImageDown, 'width', 'and', 5, 500)</l>
<c></c>
<c>* if there are two objects in a gap melt them together- can happen on traspararent product that runs in side. Better approach would be a projection to the vertical axis</c>
<l>dilation_rectangle1 (Segmented_Gaps_ImageDown, Segmented_Gaps_ImageDown, 35, 13)</l>
<l>union1 (Segmented_Gaps_ImageDown, Segmented_Gaps_ImageDown)</l>
<l>connection (Segmented_Gaps_ImageDown, Segmented_Gaps_ImageDown)</l>
<c></c>
<c>***************</c>
<c>* segment regions in image up to calculate shift from</c>
<l>smallest_rectangle1 (Segmented_Gaps_ImageDown, Segmented_Gaps_ImageDown_Row1, Segmented_Gaps_ImageDown_Column1, Segmented_Gaps_ImageDown_Row2, Segmented_Gaps_ImageDown_Column2)</l>
<l>Segmented_Gaps_ImageDown_Width := Segmented_Gaps_ImageDown_Column2 - Segmented_Gaps_ImageDown_Column1</l>
<l>Segmented_Gaps_ImageDown_Height := Segmented_Gaps_ImageDown_Row2 - Segmented_Gaps_ImageDown_Row1</l>
<l>Offset_SearchAreaImageUp := 65</l>
<l>if(Segmented_Gaps_ImageDown_Row1 = []) // nothing found</l>
<l>    count_seconds (Seconds_End)</l>
<l>    TimeNeeded := (Seconds_End - Seconds_Start)*1000.0</l>
<l>    return()</l>
<l>endif</l>
<c></c>
<l>gen_rectangle1 (SearchArea_ImageUp, Segmented_Gaps_ImageDown_Row1 - ErosionHeigth - 5, Segmented_Gaps_ImageDown_Column1, Segmented_Gaps_ImageDown_Row2 + Offset_SearchAreaImageUp, Segmented_Gaps_ImageDown_Column2)</l>
<l>union1 (SearchArea_ImageUp, SearchArea_ImageUp)</l>
<c></c>
<l>reduce_domain (ImageUp, SearchArea_ImageUp, ImageUp_Reduced)</l>
<c></c>
<l>* Dynthreshold0_Threshold1 := 1</l>
<c></c>
<l>if (Dynthreshold0_Threshold1 = 0)</l>
<l>    binary_threshold (ImageUp_Reduced, Segmented_Gaps_ImageUp, 'max_separability', 'light', UsedThreshold)</l>
<c>    * fixed threshold may be problematic when light changes / goes darker</c>
<l>    erosion_rectangle1 (Segmented_Gaps_ImageUp, Segmented_Gaps_ImageUp, 10, ErosionHeigth)</l>
<l>    connection (Segmented_Gaps_ImageUp, Segmented_Gaps_ImageUp)</l>
<c>    </c>
<c>    * get rid of objects that are too large in height - ToDo... optimize for transparent rolls</c>
<l>    select_shape (Segmented_Gaps_ImageUp, Segmented_Gaps_ImageUp, 'height', 'and', 14, 110)</l>
<l>else</l>
<l>    mean_image (ImageUp_Reduced, ImageMean, 1, 35)</l>
<l>    dyn_threshold (ImageUp_Reduced, ImageMean, RegionDynThresh, 20, 'light') // was 7</l>
<l>*     closing_rectangle1 (RegionDynThresh, Segmented_Gaps_ImageUp, 5, 5)</l>
<l>    dilation_rectangle1 (RegionDynThresh, Segmented_Gaps_ImageUp, 2, 44)</l>
<c>    </c>
<l>*     closing_rectangle1 (RegionDynThresh, Segmented_Gaps_ImageUp, 2, 35)</l>
<l>*     erosion_rectangle1 (Segmented_Gaps_ImageUp, Segmented_Gaps_ImageUp, 8, ErosionHeigth)</l>
<l>    connection (Segmented_Gaps_ImageUp, Segmented_Gaps_ImageUp)</l>
<c>    * get rid of objects that are too large in height - ToDo... optimize for transparent rolls</c>
<l>    select_shape (Segmented_Gaps_ImageUp, Segmented_Gaps_ImageUp, 'height', 'and', 40, 200)</l>
<l>endif</l>
<c></c>
<c>* if there are two objects in a gap melt them together- can happen on traspararent product that runs in side. Better approach would be a projection to the vertical axis</c>
<l>dilation_rectangle1 (Segmented_Gaps_ImageUp, Segmented_Gaps_ImageUp, 35, 13)</l>
<l>union1 (Segmented_Gaps_ImageUp, Segmented_Gaps_ImageUp)</l>
<l>connection (Segmented_Gaps_ImageUp, Segmented_Gaps_ImageUp)</l>
<c></c>
<c></c>
<c>* calculate image shift - the shift roll related from downlight to uplight</c>
<l>area_center (Segmented_Gaps_ImageDown, _, Segmented_Gaps_ImageDown_CenterRow, Segmented_Gaps_ImageDown_CenterColumn)</l>
<l>area_center (Segmented_Gaps_ImageUp, _, Segmented_Gaps_ImageUp_CenterRow, Segmented_Gaps_ImageUp_CenterColumn)</l>
<l>if (Segmented_Gaps_ImageDown_CenterRow # [] and Segmented_Gaps_ImageUp_CenterRow # [])</l>
<l>    if(|Segmented_Gaps_ImageDown_CenterRow| = |Segmented_Gaps_ImageUp_CenterRow|)</l>
<l>        MeanShift := Segmented_Gaps_ImageUp_CenterRow  - Segmented_Gaps_ImageDown_CenterRow  </l>
<l>*         tuple_median (MeanShift, MeanShift)</l>
<c>        * stabilize by removing too big values - could indicate nit correct measure</c>
<l>        tuple_greater_equal_elem (MeanShift, 50, Greatereq)</l>
<l>        tuple_find (Greatereq, 1, Indices)      </l>
<l>        tuple_remove (MeanShift, Indices, MeanShift)</l>
<l>        tuple_mean (MeanShift, MeanShift)</l>
<l>        tuple_round (MeanShift, MeanShift) </l>
<l>    else // if for some reason one block could not be found</l>
<l>        MeanShift := Segmented_Gaps_ImageUp_CenterRow[0]  - Segmented_Gaps_ImageDown_CenterRow[0] </l>
<l>        if(MeanShift &gt; 50)</l>
<l>            MeanShift := Segmented_Gaps_ImageUp_CenterRow[1]  - Segmented_Gaps_ImageDown_CenterRow[0] </l>
<l>        endif</l>
<l>        if(MeanShift &gt; 50)</l>
<l>            MeanShift := Segmented_Gaps_ImageUp_CenterRow[0]  - Segmented_Gaps_ImageDown_CenterRow[1] </l>
<l>        endif</l>
<l>        tuple_round (MeanShift, MeanShift)    </l>
<l>    endif</l>
<l>endif</l>
<c></c>
<c>* calculate tyical distance from roll to roll</c>
<l>if (|Segmented_Gaps_ImageDown_CenterRow| &gt; 1)</l>
<l>   MaxDistanceCenterPointsImageDown := Segmented_Gaps_ImageDown_CenterRow[|Segmented_Gaps_ImageDown_CenterRow|-1] - Segmented_Gaps_ImageDown_CenterRow[0] </l>
<l>   ROI_Height :=  MaxDistanceCenterPointsImageDown / (|Segmented_Gaps_ImageDown_CenterRow|-1)</l>
<l>endif</l>
<c></c>
<c>* generate roll center regions for output</c>
<l>RegionHeigth := 1</l>
<l>* tuple_gen_const (|Segmented_Gaps_ImageDown_CenterRow|, ImageUp_Column2, ConstWdth)</l>
<l>* gen_rectangle1 (Rollmeasurement_StartpointRegions, Segmented_Gaps_ImageDown_CenterRow - (RegionHeigth /2), Segmented_Gaps_ImageDown_CenterColumn, Segmented_Gaps_ImageDown_CenterRow + (RegionHeigth /2), ConstWdth)</l>
<l>tuple_gen_const (|Segmented_Gaps_ImageDown_CenterRow|, ImageUp_Column1, ConstWdth_Column1)</l>
<l>tuple_gen_const (|Segmented_Gaps_ImageDown_CenterRow|, ImageUp_Column2, ConstWdth_Column2)</l>
<l>gen_rectangle1 (Rollmeasurement_StartpointRegions, Segmented_Gaps_ImageDown_CenterRow - (RegionHeigth /2), ConstWdth_Column1, Segmented_Gaps_ImageDown_CenterRow + (RegionHeigth /2), ConstWdth_Column2)</l>
<c></c>
<c>* some output naming</c>
<l>ROI_Pos := Segmented_Gaps_ImageDown_CenterRow</l>
<c></c>
<l>count_seconds (Seconds_End)</l>
<c></c>
<l>TimeNeeded := (Seconds_End - Seconds_Start)*1000.0</l>
<c></c>
<l>if(MeanShift &gt; 50) </l>
<l>*     stop()</l>
<l>endif</l>
<l>return()</l>
<c></c>
</body>
<docu id="gSequencer_GetShiftInBetweenImages_NoEdge_ND">
<parameters>
<parameter id="Debug"/>
<parameter id="Dynthreshold0_Threshold1"/>
<parameter id="ImageDown"/>
<parameter id="ImageUp"/>
<parameter id="MeanShift"/>
<parameter id="ROI_Height"/>
<parameter id="ROI_Pos"/>
<parameter id="Rollmeasurement_StartpointRegions"/>
<parameter id="TimeNeeded"/>
</parameters>
</docu>
</procedure>
<procedure name="gSerialize2DimVectorIconic">
<interface>
<io>
<par name="DataToSerialize" base_type="iconic" dimension="2"/>
</io>
<ic>
<par name="DataToSerialize_Name" base_type="ctrl" dimension="0"/>
<par name="Message" base_type="ctrl" dimension="0"/>
<par name="MessagePart_ID" base_type="ctrl" dimension="0"/>
</ic>
<oc>
<par name="TimeNeeded" base_type="ctrl" dimension="0"/>
</oc>
</interface>
<body>
<c>* deserialize 2 dim vector and send objects via queue to downstream process</c>
<l>count_seconds (Seconds_Start)</l>
<c></c>
<l>set_message_tuple (Message, ('VT2Dim_Name_' + MessagePart_ID), DataToSerialize_Name)</l>
<c></c>
<l>VT2DimLength := DataToSerialize.length()</l>
<l>set_message_tuple (Message, ('VT2DimLength_'+ MessagePart_ID), VT2DimLength)</l>
<c></c>
<l>CntRawData := 0</l>
<l>for Cnt_V2DimLength := 0 to VT2DimLength-1 by 1  </l>
<l>    VT1Dim := DataToSerialize.at(Cnt_V2DimLength)</l>
<l>    VT1DimLength := VT1Dim.length()</l>
<l>    set_message_tuple (Message, ('VT1DimLength_' + MessagePart_ID), VT1DimLength)</l>
<l>    for Cnt_V1DimLength := 0 to VT1DimLength - 1 by 1</l>
<l>        RawData := VT1Dim.at(Cnt_V1DimLength)   </l>
<l>        StringForRawData := 'RawData_' + MessagePart_ID + '_' + CntRawData</l>
<l>*         set_message_tuple (Message, StringForRawData, RawData)</l>
<l>        set_message_obj (RawData, Message, StringForRawData) </l>
<l>        CntRawData := CntRawData +1</l>
<l>    endfor</l>
<l>endfor</l>
<c></c>
<l>count_seconds (Seconds_End)</l>
<c></c>
<l>TimeNeeded := (Seconds_End - Seconds_Start) * 1000.0</l>
<l>return ()</l>
<c></c>
</body>
<docu id="gSerialize2DimVectorIconic">
<parameters>
<parameter id="DataToSerialize"/>
<parameter id="DataToSerialize_Name"/>
<parameter id="Message"/>
<parameter id="MessagePart_ID"/>
<parameter id="TimeNeeded"/>
</parameters>
</docu>
</procedure>
<procedure name="gSerialize2DimVectorTpl">
<interface>
<ic>
<par name="DataToSerialize" base_type="ctrl" dimension="1"/>
<par name="DataToSerialize_Name" base_type="ctrl" dimension="0"/>
<par name="Message" base_type="ctrl" dimension="0"/>
<par name="MessagePart_ID" base_type="ctrl" dimension="0"/>
</ic>
<oc>
<par name="TimeNeeded" base_type="ctrl" dimension="0"/>
</oc>
</interface>
<body>
<c>* deserialize 2 dim vector and send objects via queue to downstream process</c>
<l>count_seconds (Seconds_Start)</l>
<c></c>
<l>set_message_tuple (Message, ('VT2Dim_Name_' + MessagePart_ID), DataToSerialize_Name)</l>
<c></c>
<l>* VT2DimLength := DataToSerialize.length()</l>
<l>* set_message_tuple (Message, ('VT2DimLength_'+ MessagePart_ID), VT2DimLength)</l>
<c></c>
<l>CntRawData := 0</l>
<l>* for Cnt_V2DimLength := 0 to VT2DimLength-1 by 1  </l>
<l>*     VT1Dim := DataToSerialize.at(Cnt_V2DimLength)</l>
<l>    VT1DimLength := DataToSerialize.length()</l>
<l>    set_message_tuple (Message, ('VT1DimLength_' + MessagePart_ID), VT1DimLength)</l>
<l>    for Cnt_V1DimLength := 0 to VT1DimLength - 1 by 1</l>
<l>        RawData := VT1Dim.at(Cnt_V1DimLength)   </l>
<l>        StringForRawData := 'RawData_' + MessagePart_ID + '_' + CntRawData</l>
<l>*         set_message_obj (RawData, Message, StringForRawData) </l>
<l>        set_message_tuple (Message, StringForRawData, RawData)</l>
<l>        CntRawData := CntRawData +1</l>
<l>    endfor</l>
<l>* endfor</l>
<c></c>
<l>count_seconds (Seconds_End)</l>
<l>TimeNeeded := ((Seconds_End-Seconds_Start) * 1000)</l>
<l>return ()</l>
</body>
<docu id="gSerialize2DimVectorTpl">
<parameters>
<parameter id="DataToSerialize"/>
<parameter id="DataToSerialize_Name"/>
<parameter id="Message"/>
<parameter id="MessagePart_ID"/>
<parameter id="TimeNeeded"/>
</parameters>
</docu>
</procedure>
<procedure name="gSerializeShiftregisterData">
<interface>
<io>
<par name="Products_VGoodObjects_VBadObjects" base_type="iconic" dimension="2"/>
<par name="Products_IMeasuredRegionsPerFeature" base_type="iconic" dimension="1"/>
<par name="ErrorRegionsVI" base_type="iconic" dimension="1"/>
<par name="DataForShiftregisterContainer0_VI" base_type="iconic" dimension="1"/>
</io>
<ic>
<par name="GrabImageMetaData" base_type="ctrl" dimension="0"/>
<par name="Products_VT_MeasureResult_MeasureValues" base_type="ctrl" dimension="2"/>
<par name="QueueToSendTo" base_type="ctrl" dimension="0"/>
<par name="ErrorRegionNameVT" base_type="ctrl" dimension="1"/>
<par name="DataForShiftregisterContainer0_NameVT" base_type="ctrl" dimension="1"/>
<par name="DataForShiftregisterContainer1_VT" base_type="ctrl" dimension="1"/>
<par name="DataForShiftregisterContainer1_NameVT" base_type="ctrl" dimension="1"/>
</ic>
<oc>
<par name="TimeNeeded" base_type="ctrl" dimension="0"/>
</oc>
</interface>
<body>
<c>* Procedure to send shiftregister related data to downstream process ND 2019_10_05</c>
<c></c>
<l>count_seconds (Seconds_Start)</l>
<c></c>
<l>create_message(Message)</l>
<c>* populate message with data</c>
<l>set_message_tuple (Message, 'GrabImageMetaData', GrabImageMetaData)</l>
<c></c>
<c>*Dataset0</c>
<l>DataToSerializeTuple := {{}}</l>
<l>DataToSerializeTuple := Products_VT_MeasureResult_MeasureValues</l>
<l>gSerialize2DimVectorTpl (DataToSerializeTuple, 'Products_VT_MeasureResult_MeasureValues', Message, 0, TimeNeeded0)</l>
<c>*Dataset1</c>
<l>DataToSerializeIconic := {{}}</l>
<l>DataToSerializeIconic := Products_VGoodObjects_VBadObjects</l>
<l>gSerialize2DimVectorIconic (DataToSerializeIconic, 'Products_VGoodObjects_VBadObjects', Message, 1, TimeNeeded1)</l>
<c>*Dataset2</c>
<l>DataToSerializeIconic := {{}}</l>
<l>DataToSerializeIconic.at(0) := Products_IMeasuredRegionsPerFeature  // convert to 2dimensional vector so it can be send with standard procedure</l>
<l>gSerialize2DimVectorIconic (DataToSerializeIconic, 'Products_IMeasuredRegionsPerFeature', Message, 2, TimeNeeded2)</l>
<c>*Dataset3</c>
<l>DataToSerializeIconic := {{}}</l>
<l>DataToSerializeIconic.at(0) := DataForShiftregisterContainer0_VI  // convert to 2dimensional vector so it can be send with standard procedure</l>
<l>gSerialize2DimVectorIconic (DataToSerializeIconic, 'DataForShiftregisterContainer0_VI', Message, 3, TimeNeeded2)</l>
<c>*Dataset4</c>
<l>DataToSerializeTuple := {{}}</l>
<l>DataToSerializeTuple.at(0) := DataForShiftregisterContainer0_NameVT</l>
<l>gSerialize2DimVectorTpl (DataToSerializeTuple, 'DataForShiftregisterContainer0_NameVT', Message, 4, TimeNeeded0)</l>
<c>*Dataset5</c>
<l>DataToSerializeIconic := {{}}</l>
<l>DataToSerializeIconic.at(0) := ErrorRegionsVI  // convert to 2dimensional vector so it can be send with standard procedure</l>
<l>gSerialize2DimVectorIconic (DataToSerializeIconic, 'ErrorRegionsVI', Message, 5, TimeNeeded2)</l>
<c>*Dataset6</c>
<l>DataToSerializeIconic := {{}}</l>
<l>DataToSerializeTuple.at(0) := ErrorRegionNameVT</l>
<l>gSerialize2DimVectorTpl (DataToSerializeTuple, 'ErrorRegionNameVT', Message, 6, TimeNeeded0)</l>
<c>*Dataset7</c>
<l>DataToSerializeTuple := {{}}</l>
<l>DataToSerializeTuple.at(0) := DataForShiftregisterContainer1_VT</l>
<l>gSerialize2DimVectorTpl (DataToSerializeTuple, 'DataForShiftregisterContainer1_NameVT', Message, 7, TimeNeeded0)</l>
<c>*Dataset8</c>
<l>DataToSerializeTuple := {{}}</l>
<l>DataToSerializeTuple.at(0) := DataForShiftregisterContainer1_NameVT</l>
<l>gSerialize2DimVectorTpl (DataToSerializeTuple, 'DataForShiftregisterContainer1_NameVT', Message, 8, TimeNeeded0)</l>
<c></c>
<c></c>
<c>* finalize message</c>
<l>enqueue_message (QueueToSendTo, Message, [], [])</l>
<l>clear_message (Message) // clear message</l>
<c></c>
<l>count_seconds (Seconds_End)</l>
<l>TimeNeeded := (Seconds_End - Seconds_Start) * 1000.0</l>
<c></c>
<c></c>
<l>return ()</l>
<c></c>
</body>
<docu id="gSerializeShiftregisterData">
<parameters>
<parameter id="DataForShiftregisterContainer0_NameVT"/>
<parameter id="DataForShiftregisterContainer0_VI"/>
<parameter id="DataForShiftregisterContainer1_NameVT"/>
<parameter id="DataForShiftregisterContainer1_VT"/>
<parameter id="ErrorRegionNameVT"/>
<parameter id="ErrorRegionsVI"/>
<parameter id="GrabImageMetaData"/>
<parameter id="Products_IMeasuredRegionsPerFeature"/>
<parameter id="Products_VGoodObjects_VBadObjects"/>
<parameter id="Products_VT_MeasureResult_MeasureValues"/>
<parameter id="QueueToSendTo"/>
<parameter id="TimeNeeded"/>
</parameters>
</docu>
</procedure>
<procedure name="gSet_HDevelopDebugFlag">
<interface>
<oc>
<par name="SystemInformations" base_type="ctrl" dimension="0"/>
<par name="DebugInHalcon" base_type="ctrl" dimension="0"/>
</oc>
</interface>
<body>
<c>* Indicate if hdevelop or runtime environment in gui or engine is used</c>
<c>* -----------------------------------------------------------------------</c>
<c></c>
<l>dev_get_system ('engine_environment', SystemInformations)</l>
<l>if (SystemInformations = 'HDevelop')</l>
<l>    DebugInHalcon := 1</l>
<l>else</l>
<l>    DebugInHalcon := 0</l>
<l>endif</l>
<c></c>
<l>return ()</l>
</body>
<docu id="gSet_HDevelopDebugFlag">
<parameters>
<parameter id="DebugInHalcon"/>
<parameter id="SystemInformations"/>
</parameters>
</docu>
</procedure>
<procedure name="gShiftregister_360EliminateTooBigProducsOverMutlipleRolls">
<interface>
<io>
<par name="Rollmeasurement360" base_type="iconic" dimension="0"/>
<par name="Shiftregister_BadObjectsFor" base_type="iconic" dimension="0"/>
<par name="Shiftregister_GoodObjectsFor" base_type="iconic" dimension="0"/>
<par name="Tablet_Individual" base_type="iconic" dimension="0"/>
<par name="ImageOrig" base_type="iconic" dimension="0"/>
<par name="Products_IImagePartsPerObject" base_type="iconic" dimension="1"/>
<par name="Products_IMeasuredRegionsPerFeature" base_type="iconic" dimension="1"/>
</io>
<oo>
<par name="Tablet_Individual_Out" base_type="iconic" dimension="0"/>
<par name="Shiftregister_GoodObjectsFor_Out" base_type="iconic" dimension="0"/>
<par name="Shiftregister_BadObjectsFor_Out" base_type="iconic" dimension="0"/>
<par name="Products_IImagePartsPerObject_Out" base_type="iconic" dimension="1"/>
<par name="Products_IMeasuredRegionsPerFeature_Out" base_type="iconic" dimension="1"/>
</oo>
<ic>
<par name="Products_VMeasureFeature_TResult_TValue" base_type="ctrl" dimension="2"/>
<par name="Products_VImagePartsOffset_TRow_TColumn" base_type="ctrl" dimension="1"/>
</ic>
<oc>
<par name="Products_VMeasureFeature_TResult_TValue_Out" base_type="ctrl" dimension="2"/>
<par name="Products_VImagePartsOffset_TRow_TColumn_Out" base_type="ctrl" dimension="1"/>
</oc>
</interface>
<body>
<c></c>
<c></c>
<c>* if there is an object that goes over two rolls at least filter out to avoid problems downstream</c>
<c>* init of return values</c>
<l>Shiftregister_BadObjectsFor_Out := Shiftregister_BadObjectsFor</l>
<l>Shiftregister_GoodObjectsFor_Out := Shiftregister_GoodObjectsFor</l>
<l>Tablet_Individual_Out := Tablet_Individual</l>
<c></c>
<l>Products_IImagePartsPerObject_Out := Products_IImagePartsPerObject</l>
<l>Products_IMeasuredRegionsPerFeature_Out := Products_IMeasuredRegionsPerFeature</l>
<l>Products_VMeasureFeature_TResult_TValue_Out := Products_VMeasureFeature_TResult_TValue</l>
<l>Products_VImagePartsOffset_TRow_TColumn_Out := Products_VImagePartsOffset_TRow_TColumn</l>
<c></c>
<c></c>
<l>count_obj (Rollmeasurement360, Rollmeasurement360_Number)</l>
<l>if (Rollmeasurement360_Number &lt;= 1) // in case only one or no roll was detected return witout action</l>
<l>    return()</l>
<l>endif</l>
<c></c>
<c>* determine the mean distance in between rolls</c>
<l>union1 (Rollmeasurement360, Rollmeasurement360_Union)</l>
<l>smallest_rectangle1 (Rollmeasurement360_Union, Row1, Column1, Row2, Column2)</l>
<c></c>
<l>MeanDistanceRolls := (Row2- Row1) / (Rollmeasurement360_Number-1)</l>
<c></c>
<c>**************</c>
<c>* select regions that are smaller than mean roll distance</c>
<c></c>
<c>* for BadObjectsFor_Out</c>
<l>gShiftregister_360EliminateTooBigProductsOverMultipleRolls_SingleRegionSet (Shiftregister_BadObjectsFor_Out, Rollmeasurement360, ImageOrig, Shiftregister_BadObjectsFor_Out, MeanDistanceRolls, IndexOfAllRegionsWithPartlyIntersection_BadObjectsFor)</l>
<c>* for Tablet_Individual_Out</c>
<l>gShiftregister_360EliminateTooBigProductsOverMultipleRolls_SingleRegionSet (Tablet_Individual_Out, Rollmeasurement360, ImageOrig, Tablet_Individual_Out, MeanDistanceRolls, IndexOfAllRegionsWithPartlyIntersection_Tablet_Individual)</l>
<c>* for GoodObjectsFor_Out</c>
<l>gShiftregister_360EliminateTooBigProductsOverMultipleRolls_SingleRegionSet (Shiftregister_GoodObjectsFor_Out, Rollmeasurement360, ImageOrig, Shiftregister_GoodObjectsFor_Out, MeanDistanceRolls, IndexOfAllRegionsWithPartlyIntersection_GoodObjectsFor)</l>
<c>* remove data from vector</c>
<l>* if(IndexOfAllRegionsWithPartlyIntersection_BadObjectsFor # [])</l>
<l>*     stop()</l>
<l>* endif</l>
<l>gShiftregister_RemoveDataFromVector (Products_IImagePartsPerObject_Out, Products_IMeasuredRegionsPerFeature_Out, Products_IImagePartsPerObject_Out, Products_IMeasuredRegionsPerFeature_Out, IndexOfAllRegionsWithPartlyIntersection_Tablet_Individual, Products_VMeasureFeature_TResult_TValue_Out, Products_VImagePartsOffset_TRow_TColumn_Out, Products_VMeasureFeature_TResult_TValue_Out, Products_VImagePartsOffset_TRow_TColumn_Out)</l>
<c></c>
<l>* gShiftregister_RemoveDataFromVector (Products_IImagePartsPerObject_Out, Products_IMeasuredRegionsPerFeature_Out, Products_IImagePartsPerObject_Out, Products_IMeasuredRegionsPerFeature_Out, IndexOfAllRegionsWithPartlyIntersection_BadObjectsFor, Products_VMeasureFeature_TResult_TValue_Out, Products_VImagePartsOffset_TRow_TColumn_Out, Products_VMeasureFeature_TResult_TValue_Out, Products_VImagePartsOffset_TRow_TColumn_Out)</l>
<c></c>
<c>* add vector- potential bug?</c>
<l>* gShiftregister_AddDataToVector (Products_IImagePartsPerObject_Out, Products_IMeasuredRegionsPerFeature_Out, Products_IImagePartsPerObject, Products_IMeasuredRegionsPerFeature, Products_IImagePartsPerObject_Out, Products_IMeasuredRegionsPerFeature_Out, Products_VMeasureFeature_TResult_TValue, Products_VMeasureFeature_TResult_TValue_Out, Products_VImagePartsOffset_TRow_TColumn, Products_VImagePartsOffset_TRow_TColumn_Out, Shiftregister_SaveMeasureFeatureValuesAtRuntime, Shiftregister_SaveMeasureFeatureRegionsAtRuntime, Shiftregister_SaveMeasureFeaturePartImagesAtRuntime, Products_VMeasureFeature_TResult_TValue_Out, ProductsVectorLength, Products_VImagePartsOffset_TRow_TColumn_Out)</l>
<c></c>
<l>return ()</l>
</body>
<docu id="gShiftregister_360EliminateTooBigProducsOverMutlipleRolls">
<parameters>
<parameter id="ImageOrig"/>
<parameter id="Products_IImagePartsPerObject"/>
<parameter id="Products_IImagePartsPerObject_Out"/>
<parameter id="Products_IMeasuredRegionsPerFeature"/>
<parameter id="Products_IMeasuredRegionsPerFeature_Out"/>
<parameter id="Products_VImagePartsOffset_TRow_TColumn"/>
<parameter id="Products_VImagePartsOffset_TRow_TColumn_Out"/>
<parameter id="Products_VMeasureFeature_TResult_TValue"/>
<parameter id="Products_VMeasureFeature_TResult_TValue_Out"/>
<parameter id="Rollmeasurement360"/>
<parameter id="Shiftregister_BadObjectsFor"/>
<parameter id="Shiftregister_BadObjectsFor_Out"/>
<parameter id="Shiftregister_GoodObjectsFor"/>
<parameter id="Shiftregister_GoodObjectsFor_Out"/>
<parameter id="Tablet_Individual"/>
<parameter id="Tablet_Individual_Out"/>
</parameters>
</docu>
</procedure>
<procedure name="gShiftregister_360EliminateTooBigProductsOverMultipleRolls_SingleRegionSet">
<interface>
<io>
<par name="Shiftregister_Regions_In" base_type="iconic" dimension="0"/>
<par name="Rollmeasurement360" base_type="iconic" dimension="0"/>
<par name="ImageOrig" base_type="iconic" dimension="0"/>
</io>
<oo>
<par name="Shiftregister_Regions_Out" base_type="iconic" dimension="0"/>
</oo>
<ic>
<par name="MeanDistanceRolls" base_type="ctrl" dimension="0"/>
</ic>
<oc>
<par name="IndexOfAllRegionsWithPartlyIntersection" base_type="ctrl" dimension="0"/>
</oc>
</interface>
<body>
<c>* remove too big obejcts from input regions</c>
<l>Shiftregister_Regions_Out := Shiftregister_Regions_In</l>
<l>IndexOfAllRegionsWithPartlyIntersection := []</l>
<c></c>
<l>select_shape (Shiftregister_Regions_Out, Shiftregister_Regions_OutOfRange, 'height', 'and', MeanDistanceRolls, 999999)</l>
<l>intersection (Shiftregister_Regions_OutOfRange, Rollmeasurement360, OutOfSpecIntersected_Rollparts)</l>
<l>area_center (OutOfSpecIntersected_Rollparts, OutOfSpecIntersected_Rollparts_Area, _, _)</l>
<l>if (OutOfSpecIntersected_Rollparts_Area = 0 or OutOfSpecIntersected_Rollparts_Area = []) // shortcut in case no out of spec object was found</l>
<l>    return()</l>
<l>endif</l>
<c></c>
<l>union1 (OutOfSpecIntersected_Rollparts, OutOfSpecIntersected_Rollparts_Union)</l>
<c></c>
<l>gShiftregister_DetermineAndRemoveRegionsInEjectBox (OutOfSpecIntersected_Rollparts_Union, Shiftregister_Regions_Out, Shiftregister_Regions_Out, [], IndexOfAllRegionsWithPartlyIntersection)</l>
<c></c>
<l>return ()</l>
</body>
<docu id="gShiftregister_360EliminateTooBigProductsOverMultipleRolls_SingleRegionSet">
<parameters>
<parameter id="ImageOrig"/>
<parameter id="IndexOfAllRegionsWithPartlyIntersection"/>
<parameter id="MeanDistanceRolls"/>
<parameter id="Rollmeasurement360"/>
<parameter id="Shiftregister_Regions_In"/>
<parameter id="Shiftregister_Regions_Out"/>
</parameters>
</docu>
</procedure>
<procedure name="gShiftregister_AdaptEjectRegionWithEjectObject">
<interface>
<io>
<par name="Shiftregister_AllObjectsMovementAdapted_Out" base_type="iconic" dimension="0"/>
<par name="EjectSelected" base_type="iconic" dimension="0"/>
</io>
<oo>
<par name="EjectSelected_Out" base_type="iconic" dimension="0"/>
</oo>
</interface>
<body>
<l>EjectSelected_Out := EjectSelected</l>
<c>* first check if a single region is in eject box. Necessary due to position differences of one Pixel need to be coverd</c>
<l>gElementwiseComparisonTestRegionIndex_3 (EjectSelected, Shiftregister_AllObjectsMovementAdapted_Out, Shiftregister_BadObjects_InEjectBox, AllObjects_Indices, NumberOfClassificationsInEjectBin)</l>
<c></c>
<l>if (AllObjects_Indices # [])  </l>
<l>    select_obj (Shiftregister_AllObjectsMovementAdapted_Out, Shiftregister_KeyRegionToSelectFrom, AllObjects_Indices[0])</l>
<c>    * select only the lower two third of object as add on to Keyregion</c>
<l>    smallest_rectangle1 (Shiftregister_KeyRegionToSelectFrom, Row1, Column1, Row2, Column2)     </l>
<l>    KeyRegion_Heigth := Row2-Row1</l>
<l>    KeyRegion_HeightOneThird := KeyRegion_Heigth * 0.33</l>
<l>    tuple_round (KeyRegion_HeightOneThird, KeyRegion_HeightOneThird)</l>
<l>    gen_rectangle1 (CutOffRectangle, Row1, Column1, Row1+KeyRegion_HeightOneThird, Column2)</l>
<l>    difference (Shiftregister_KeyRegionToSelectFrom, CutOffRectangle, Shiftregister_KeyRegionToSelectFrom)</l>
<l>else</l>
<l>    gen_empty_obj (Shiftregister_KeyRegionToSelectFrom)</l>
<l>endif</l>
<l>union2 (EjectSelected, Shiftregister_KeyRegionToSelectFrom, EjectSelected_Out)</l>
<c>    </c>
<l>return ()</l>
</body>
<docu id="gShiftregister_AdaptEjectRegionWithEjectObject">
<parameters>
<parameter id="EjectSelected"/>
<parameter id="EjectSelected_Out"/>
<parameter id="Shiftregister_AllObjectsMovementAdapted_Out"/>
</parameters>
</docu>
</procedure>
<procedure name="gShiftregister_AddDataToVector">
<interface>
<io>
<par name="Shiftregister_IImagePartsPerObject" base_type="iconic" dimension="1"/>
<par name="Shiftregister_VMeasuredFeatures_IRegionPerFeature" base_type="iconic" dimension="1"/>
<par name="Products_IImagePartsPerObject" base_type="iconic" dimension="1"/>
<par name="Products_IMeasuredRegionsPerFeature" base_type="iconic" dimension="1"/>
</io>
<oo>
<par name="Shiftregister_IImagePartsPerObject_Out" base_type="iconic" dimension="1"/>
<par name="Shiftregister_VMeasuredFeatures_IRegionPerFeature_Out" base_type="iconic" dimension="1"/>
</oo>
<ic>
<par name="Product_VMeasureFeature_TResult_TValue" base_type="ctrl" dimension="2"/>
<par name="Shiftregister_VMeasureFeature_TResult_TValue" base_type="ctrl" dimension="2"/>
<par name="Products_VImagePartsOffset_TRow_TColumn" base_type="ctrl" dimension="1"/>
<par name="Shiftregister_VImagePartsOffset_TRow_Tcolumn" base_type="ctrl" dimension="1"/>
<par name="Shiftregister_SaveMeasureFeatureValuesAtRuntime" base_type="ctrl" dimension="0"/>
<par name="Shiftregister_SaveMeasureFeatureRegionsAtRuntime" base_type="ctrl" dimension="0"/>
<par name="Shiftregister_SaveMeasureFeaturePartImagesAtRuntime" base_type="ctrl" dimension="0"/>
</ic>
<oc>
<par name="Shiftregister_VMeasureFeature_TResult_TValue_Out" base_type="ctrl" dimension="2"/>
<par name="ProductsVectorLength" base_type="ctrl" dimension="0"/>
<par name="Shiftregister_VImagePartsOffset_TRow_Tcolumn_Out" base_type="ctrl" dimension="1"/>
</oc>
</interface>
<body>
<c></c>
<l>Shiftregister_VMeasureFeature_TResult_TValue_Out := Shiftregister_VMeasureFeature_TResult_TValue</l>
<l>Shiftregister_IImagePartsPerObject_Out := Shiftregister_IImagePartsPerObject</l>
<l>* Shiftregister_IProductsMovementAdapted_Out := Shiftregister_IProductsMovementAdapted</l>
<l>Shiftregister_VImagePartsOffset_TRow_Tcolumn_Out := Shiftregister_VImagePartsOffset_TRow_Tcolumn</l>
<l>Shiftregister_VMeasuredFeatures_IRegionPerFeature_Out := Shiftregister_VMeasuredFeatures_IRegionPerFeature</l>
<c></c>
<c>* add measured product values into shiftregister data storage</c>
<l>if (Shiftregister_SaveMeasureFeatureValuesAtRuntime = 1)</l>
<c>    </c>
<c>    * first check if the data relation is equal, if not (after init for instance) create it first</c>
<l>    ProductsVectorLength := Product_VMeasureFeature_TResult_TValue.length()</l>
<l>    ShiftregisterVectorLength := Shiftregister_VMeasureFeature_TResult_TValue_Out.length()</l>
<l>    if (ShiftregisterVectorLength # ProductsVectorLength)</l>
<l>        for Index := 0 to ProductsVectorLength-1 by 1</l>
<l>            Shiftregister_VMeasureFeature_TResult_TValue_Out.at(Index) := {[],[],[],[],[]}</l>
<l>        endfor</l>
<l>    endif</l>
<c>    </c>
<c>    </c>
<c>    * now do the data concatting</c>
<l>    for Index := 0 to ProductsVectorLength-1 by 1</l>
<l>        ElementsToAdd := Product_VMeasureFeature_TResult_TValue.at(Index).length()</l>
<c>        </c>
<l>        tuple_concat (Shiftregister_VMeasureFeature_TResult_TValue_Out.at(Index).at(0), Product_VMeasureFeature_TResult_TValue.at(Index).at(0), MeasureResult_Concatted)</l>
<l>        Shiftregister_VMeasureFeature_TResult_TValue_Out.at(Index).at(0) := MeasureResult_Concatted</l>
<l>        if(ElementsToAdd &gt; 1) // option for reduced data set</l>
<l>            tuple_concat (Shiftregister_VMeasureFeature_TResult_TValue_Out.at(Index).at(1), Product_VMeasureFeature_TResult_TValue.at(Index).at(1), MeasureValue_Concatted)</l>
<l>            Shiftregister_VMeasureFeature_TResult_TValue_Out.at(Index).at(1) := MeasureValue_Concatted</l>
<l>            if(ElementsToAdd &gt; 2) // option for reduced data set</l>
<l>                tuple_concat (Shiftregister_VMeasureFeature_TResult_TValue_Out.at(Index).at(2), Product_VMeasureFeature_TResult_TValue.at(Index).at(2), MeasureTimestamp_Concatted)</l>
<l>                Shiftregister_VMeasureFeature_TResult_TValue_Out.at(Index).at(2) := MeasureTimestamp_Concatted</l>
<l>                if(ElementsToAdd &gt; 3) // option for reduced data set</l>
<l>                    tuple_concat (Shiftregister_VMeasureFeature_TResult_TValue_Out.at(Index).at(3), Product_VMeasureFeature_TResult_TValue.at(Index).at(3), MeasureLowestObjectRowCurrent_Concatted)</l>
<l>                    Shiftregister_VMeasureFeature_TResult_TValue_Out.at(Index).at(3) := MeasureLowestObjectRowCurrent_Concatted</l>
<l>                    if(ElementsToAdd &gt; 4) // option for reduced data set</l>
<l>                        tuple_concat (Shiftregister_VMeasureFeature_TResult_TValue_Out.at(Index).at(4), Product_VMeasureFeature_TResult_TValue.at(Index).at(4), MeasureHighestObjectRowCurrent_Concatted)</l>
<l>                        Shiftregister_VMeasureFeature_TResult_TValue_Out.at(Index).at(4) := MeasureHighestObjectRowCurrent_Concatted</l>
<l>                    endif</l>
<l>                endif</l>
<l>            endif</l>
<l>        endif</l>
<l>    endfor</l>
<l>endif</l>
<c></c>
<l>if (Shiftregister_SaveMeasureFeaturePartImagesAtRuntime = 1)</l>
<l>    LengthShiftregisterCroppedImages := Shiftregister_IImagePartsPerObject.length()</l>
<l>    if (LengthShiftregisterCroppedImages = 1) //check if it is an emptyobject - directly after initialisation</l>
<l>        get_image_size (Shiftregister_IImagePartsPerObject.at(0), Width, Height)</l>
<l>        if (Width = []) //empty image found - state after initialisation</l>
<l>            LengthShiftregisterCroppedImages := 0</l>
<l>        endif</l>
<l>    endif</l>
<c>    </c>
<l>    LengthProductImagesCropped := Products_IImagePartsPerObject.length()</l>
<l>    for IndexLoop := 0 to LengthProductImagesCropped-1 by 1</l>
<l>        Shiftregister_IImagePartsPerObject_Out.at(IndexLoop + LengthShiftregisterCroppedImages) :=  Products_IImagePartsPerObject.at(IndexLoop)</l>
<l>        Shiftregister_VImagePartsOffset_TRow_Tcolumn_Out.at(IndexLoop + LengthShiftregisterCroppedImages) :=  Products_VImagePartsOffset_TRow_TColumn.at(IndexLoop)</l>
<l>    endfor</l>
<l>endif</l>
<c></c>
<l>if (Shiftregister_SaveMeasureFeatureRegionsAtRuntime = 1)</l>
<l>    MeasuredRegionsPerFeatureNumber := Products_IMeasuredRegionsPerFeature.length()</l>
<c>    * check if vector is initalized in the same order as Productdata</c>
<l>    ShiftregisterData_Length := Shiftregister_VMeasuredFeatures_IRegionPerFeature_Out.length()</l>
<l>    if (ShiftregisterData_Length &lt;  MeasuredRegionsPerFeatureNumber)</l>
<l>        for IndexMeasuredFeatureInit := 0 to MeasuredRegionsPerFeatureNumber-1 by 1</l>
<l>            gen_empty_obj (Shiftregister_VMeasuredFeatures_IRegionPerFeature_Out.at(IndexMeasuredFeatureInit))       </l>
<l>        endfor</l>
<l>    endif</l>
<c>    </c>
<l>    for IndexMeasuredRegionsPerFeature := 0 to MeasuredRegionsPerFeatureNumber-1 by 1</l>
<l>        concat_obj (Shiftregister_VMeasuredFeatures_IRegionPerFeature_Out.at(IndexMeasuredRegionsPerFeature), Products_IMeasuredRegionsPerFeature.at(IndexMeasuredRegionsPerFeature), Shiftregister_VMeasuredFeatures_IRegionPerFeature_Out.at(IndexMeasuredRegionsPerFeature))</l>
<l>    endfor</l>
<l>endif</l>
<c></c>
<l>return ()</l>
</body>
<docu id="gShiftregister_AddDataToVector">
<parameters>
<parameter id="Product_VMeasureFeature_TResult_TValue"/>
<parameter id="ProductsVectorLength"/>
<parameter id="Products_IImagePartsPerObject"/>
<parameter id="Products_IMeasuredRegionsPerFeature"/>
<parameter id="Products_VImagePartsOffset_TRow_TColumn"/>
<parameter id="Shiftregister_IImagePartsPerObject"/>
<parameter id="Shiftregister_IImagePartsPerObject_Out"/>
<parameter id="Shiftregister_SaveMeasureFeaturePartImagesAtRuntime"/>
<parameter id="Shiftregister_SaveMeasureFeatureRegionsAtRuntime"/>
<parameter id="Shiftregister_SaveMeasureFeatureValuesAtRuntime"/>
<parameter id="Shiftregister_VImagePartsOffset_TRow_Tcolumn"/>
<parameter id="Shiftregister_VImagePartsOffset_TRow_Tcolumn_Out"/>
<parameter id="Shiftregister_VMeasureFeature_TResult_TValue"/>
<parameter id="Shiftregister_VMeasureFeature_TResult_TValue_Out"/>
<parameter id="Shiftregister_VMeasuredFeatures_IRegionPerFeature"/>
<parameter id="Shiftregister_VMeasuredFeatures_IRegionPerFeature_Out"/>
</parameters>
</docu>
</procedure>
<procedure name="gShiftregister_AddDataToVector_ProductMeasurementDataAndRegion">
<interface>
<io>
<par name="Shiftregister_IImagePartsPerObject" base_type="iconic" dimension="1"/>
<par name="Shiftregister_VMeasuredFeatures_IRegionPerFeature" base_type="iconic" dimension="1"/>
<par name="Products_IImagePartsPerObject" base_type="iconic" dimension="1"/>
<par name="Products_IMeasuredRegionsPerFeature" base_type="iconic" dimension="1"/>
</io>
<oo>
<par name="Shiftregister_IImagePartsPerObject_Out" base_type="iconic" dimension="1"/>
<par name="Shiftregister_VMeasuredFeatures_IRegionPerFeature_Out" base_type="iconic" dimension="1"/>
</oo>
<ic>
<par name="Product_VMeasureFeature_TResult_TValue" base_type="ctrl" dimension="2"/>
<par name="Shiftregister_VMeasureFeature_TResult_TValue" base_type="ctrl" dimension="2"/>
<par name="Products_VImagePartsOffset_TRow_TColumn" base_type="ctrl" dimension="1"/>
<par name="Shiftregister_VImagePartsOffset_TRow_Tcolumn" base_type="ctrl" dimension="1"/>
<par name="Shiftregister_SaveMeasureFeatureValuesAtRuntime" base_type="ctrl" dimension="0"/>
<par name="Shiftregister_SaveMeasureFeatureRegionsAtRuntime" base_type="ctrl" dimension="0"/>
<par name="Shiftregister_SaveMeasureFeaturePartImagesAtRuntime" base_type="ctrl" dimension="0"/>
</ic>
<oc>
<par name="Shiftregister_VMeasureFeature_TResult_TValue_Out" base_type="ctrl" dimension="2"/>
<par name="ProductsVectorLength" base_type="ctrl" dimension="0"/>
<par name="Shiftregister_VImagePartsOffset_TRow_Tcolumn_Out" base_type="ctrl" dimension="1"/>
</oc>
</interface>
<body>
<c>  </c>
<l>Shiftregister_VMeasureFeature_TResult_TValue_Out := Shiftregister_VMeasureFeature_TResult_TValue</l>
<l>Shiftregister_IImagePartsPerObject_Out := Shiftregister_IImagePartsPerObject</l>
<l>* Shiftregister_IProductsMovementAdapted_Out := Shiftregister_IProductsMovementAdapted</l>
<l>Shiftregister_VImagePartsOffset_TRow_Tcolumn_Out := Shiftregister_VImagePartsOffset_TRow_Tcolumn</l>
<l>Shiftregister_VMeasuredFeatures_IRegionPerFeature_Out := Shiftregister_VMeasuredFeatures_IRegionPerFeature</l>
<c></c>
<c>* add measured product values into shiftregister data storage</c>
<l>if (Shiftregister_SaveMeasureFeatureValuesAtRuntime = 1)</l>
<c>        </c>
<c>    * first check if the data relation is equal, if not (after init for instance) create it first</c>
<l>    ProductsVectorLength := Product_VMeasureFeature_TResult_TValue.length()</l>
<l>    ShiftregisterVectorLength := Shiftregister_VMeasureFeature_TResult_TValue_Out.length()</l>
<l>    if (ShiftregisterVectorLength # ProductsVectorLength)</l>
<l>        for Index := 0 to ProductsVectorLength-1 by 1</l>
<l>            Shiftregister_VMeasureFeature_TResult_TValue_Out.at(Index) := {[],[],[],[],[]}</l>
<l>        endfor</l>
<l>    endif</l>
<c>    </c>
<c>    </c>
<c>    * now do the data concatting</c>
<l>    for Index := 0 to ProductsVectorLength-1 by 1</l>
<l>        ElementsToAdd := Product_VMeasureFeature_TResult_TValue.at(Index).length()</l>
<c>        </c>
<l>        tuple_concat (Shiftregister_VMeasureFeature_TResult_TValue_Out.at(Index).at(0), Product_VMeasureFeature_TResult_TValue.at(Index).at(0), MeasureResult_Concatted)</l>
<l>        tuple_concat (Shiftregister_VMeasureFeature_TResult_TValue_Out.at(Index).at(1), Product_VMeasureFeature_TResult_TValue.at(Index).at(1), MeasureValue_Concatted)</l>
<l>        if(ElementsToAdd &gt; 2) // option for reduced data set</l>
<l>            tuple_concat (Shiftregister_VMeasureFeature_TResult_TValue_Out.at(Index).at(2), Product_VMeasureFeature_TResult_TValue.at(Index).at(2), MeasureTimestamp_Concatted)</l>
<l>            tuple_concat (Shiftregister_VMeasureFeature_TResult_TValue_Out.at(Index).at(3), Product_VMeasureFeature_TResult_TValue.at(Index).at(3), MeasureLowestObjectRowCurrent_Concatted)</l>
<l>            tuple_concat (Shiftregister_VMeasureFeature_TResult_TValue_Out.at(Index).at(4), Product_VMeasureFeature_TResult_TValue.at(Index).at(4), MeasureHighestObjectRowCurrent_Concatted) </l>
<l>        endif</l>
<l>        Shiftregister_VMeasureFeature_TResult_TValue_Out.at(Index).at(0) := MeasureResult_Concatted</l>
<l>        Shiftregister_VMeasureFeature_TResult_TValue_Out.at(Index).at(1) := MeasureValue_Concatted</l>
<l>        if(ElementsToAdd &gt; 2)// option for reduced data set</l>
<l>            Shiftregister_VMeasureFeature_TResult_TValue_Out.at(Index).at(2) := MeasureTimestamp_Concatted</l>
<l>            Shiftregister_VMeasureFeature_TResult_TValue_Out.at(Index).at(3) := MeasureLowestObjectRowCurrent_Concatted</l>
<l>            Shiftregister_VMeasureFeature_TResult_TValue_Out.at(Index).at(4) := MeasureHighestObjectRowCurrent_Concatted</l>
<l>        endif</l>
<c></c>
<c></c>
<c></c>
<l>*         Shiftregister_VMeasureFeature_TResult_TValue_Out.at(Index).at(2) := Product_VMeasureFeature_TResult_TValue.at(Index).at(2)</l>
<l>    endfor</l>
<l>endif</l>
<c></c>
<l>if (Shiftregister_SaveMeasureFeaturePartImagesAtRuntime = 1)</l>
<l>    LengthShiftregisterCroppedImages := Shiftregister_IImagePartsPerObject.length()</l>
<l>    if (LengthShiftregisterCroppedImages = 1) //check if it is an emptyobject - directly after initialisation</l>
<l>        get_image_size (Shiftregister_IImagePartsPerObject.at(0), Width, Height)</l>
<l>        if (Width = []) //empty image found - state after initialisation</l>
<l>            LengthShiftregisterCroppedImages := 0</l>
<l>        endif</l>
<l>    endif</l>
<c>    </c>
<l>    LengthProductImagesCropped := Products_IImagePartsPerObject.length()</l>
<l>    for IndexLoop := 0 to LengthProductImagesCropped-1 by 1</l>
<l>        Shiftregister_IImagePartsPerObject_Out.at(IndexLoop + LengthShiftregisterCroppedImages) :=  Products_IImagePartsPerObject.at(IndexLoop)</l>
<l>        Shiftregister_VImagePartsOffset_TRow_Tcolumn_Out.at(IndexLoop + LengthShiftregisterCroppedImages) :=  Products_VImagePartsOffset_TRow_TColumn.at(IndexLoop)</l>
<l>    endfor</l>
<l>endif</l>
<c></c>
<l>if (Shiftregister_SaveMeasureFeatureRegionsAtRuntime = 1)</l>
<l>    MeasuredRegionsPerFeatureNumber := Products_IMeasuredRegionsPerFeature.length()</l>
<c>    * check if vector is initalized in the same order as Productdata</c>
<l>    ShiftregisterData_Length := Shiftregister_VMeasuredFeatures_IRegionPerFeature_Out.length()</l>
<l>    if (ShiftregisterData_Length &lt;  MeasuredRegionsPerFeatureNumber)</l>
<l>        for IndexMeasuredFeatureInit := 0 to MeasuredRegionsPerFeatureNumber-1 by 1</l>
<l>            gen_empty_obj (Shiftregister_VMeasuredFeatures_IRegionPerFeature_Out.at(IndexMeasuredFeatureInit))       </l>
<l>        endfor</l>
<l>    endif</l>
<c>    </c>
<l>    for IndexMeasuredRegionsPerFeature := 0 to MeasuredRegionsPerFeatureNumber-1 by 1</l>
<l>        concat_obj (Shiftregister_VMeasuredFeatures_IRegionPerFeature_Out.at(IndexMeasuredRegionsPerFeature), Products_IMeasuredRegionsPerFeature.at(IndexMeasuredRegionsPerFeature), Shiftregister_VMeasuredFeatures_IRegionPerFeature_Out.at(IndexMeasuredRegionsPerFeature))</l>
<l>    endfor</l>
<l>endif</l>
<c></c>
<l>return ()</l>
</body>
<docu id="gShiftregister_AddDataToVector_ProductMeasurementDataAndRegion">
<parameters>
<parameter id="Product_VMeasureFeature_TResult_TValue"/>
<parameter id="ProductsVectorLength"/>
<parameter id="Products_IImagePartsPerObject"/>
<parameter id="Products_IMeasuredRegionsPerFeature"/>
<parameter id="Products_VImagePartsOffset_TRow_TColumn"/>
<parameter id="Shiftregister_IImagePartsPerObject"/>
<parameter id="Shiftregister_IImagePartsPerObject_Out"/>
<parameter id="Shiftregister_SaveMeasureFeaturePartImagesAtRuntime"/>
<parameter id="Shiftregister_SaveMeasureFeatureRegionsAtRuntime"/>
<parameter id="Shiftregister_SaveMeasureFeatureValuesAtRuntime"/>
<parameter id="Shiftregister_VImagePartsOffset_TRow_Tcolumn"/>
<parameter id="Shiftregister_VImagePartsOffset_TRow_Tcolumn_Out"/>
<parameter id="Shiftregister_VMeasureFeature_TResult_TValue"/>
<parameter id="Shiftregister_VMeasureFeature_TResult_TValue_Out"/>
<parameter id="Shiftregister_VMeasuredFeatures_IRegionPerFeature"/>
<parameter id="Shiftregister_VMeasuredFeatures_IRegionPerFeature_Out"/>
</parameters>
</docu>
</procedure>
<procedure name="gShiftRegister_CheckProductsAtEjectPosition_InTolerance">
<interface>
<io>
<par name="EjectSelected" base_type="iconic" dimension="0"/>
<par name="Shiftregister_AllObjectsMovementAdapted" base_type="iconic" dimension="0"/>
</io>
<ic>
<par name="Shiftregister_VMeasureFeature_TResult_TValue_Out" base_type="ctrl" dimension="2"/>
<par name="Shiftregister_NumberOfDetectionsLeadToEject_PerLinePerFeature" base_type="ctrl" dimension="0"/>
<par name="Shiftregister_CriticalDefectActive_PerLinePerFeature" base_type="ctrl" dimension="0"/>
</ic>
<oc>
<par name="ErrorObjectDataToStore_VMeasureFeature_TResult_TValue" base_type="ctrl" dimension="2"/>
<par name="Result_Ovall0Good_1Bad" base_type="ctrl" dimension="0"/>
<par name="Result_ForEverySingleFeature_0Good_1Bad" base_type="ctrl" dimension="0"/>
<par name="IndicesFound" base_type="ctrl" dimension="0"/>
<par name="CriticalInspectionResultFound" base_type="ctrl" dimension="0"/>
</oc>
</interface>
<body>
<c>* Description for "NumberOfBadLeadToEject" positive values lead to n-times bad is error, negative values lead to n-times good lead to good. 0 is off</c>
<l>Result_ForEverySingleFeature_0Good_1Bad := []</l>
<l>CriticalInspectionResultFound := 0</l>
<c></c>
<c></c>
<c>* check for every feature individually if it is in/out of tolerance</c>
<l>gShiftregister_DetermineAndRemoveRegionsInEjectBox (EjectSelected, Shiftregister_AllObjectsMovementAdapted, __, [], IndicesFound)</l>
<l>* select_obj (Shiftregister_AllObjectsMovementAdapted, test, IndicesFound) // test selection for found objects in eject box</l>
<c></c>
<c>* approach based on tuple values measured / row</c>
<l>* ShiftRegister_GetIndicesForRemoval_ObjectsRowLowerThanEjectBox (EjectSelected, Shiftregister_VMeasureFeature_TResult_TValue_Out, 0, 1, IndicesFound)</l>
<c></c>
<l>* Shiftregister_SelectErrorDataSubset_GetIndicesToStore (EjectSelected, Shiftregister_VMeasureFeature_TResult_TValue_Out, BadObjects_Indices)</l>
<l>if (IndicesFound # [])</l>
<l>    IndicesFound := IndicesFound -1</l>
<l>endif</l>
<l>gShiftregister_SelectErrorDataSubset_Vector2Dim_Tuple (IndicesFound, Shiftregister_VMeasureFeature_TResult_TValue_Out, ErrorObjectDataToStore_VMeasureFeature_TResult_TValue)</l>
<c></c>
<l>ResultForFeatures := []</l>
<l>Feature_Length := ErrorObjectDataToStore_VMeasureFeature_TResult_TValue.length()</l>
<l>for Index_Cnt := 0 to Feature_Length-1 by 1</l>
<l>    ResultOfOneFeature := ErrorObjectDataToStore_VMeasureFeature_TResult_TValue.at(Index_Cnt).at(0)</l>
<c>    *case switched off</c>
<l>    if (Shiftregister_NumberOfDetectionsLeadToEject_PerLinePerFeature[Index_Cnt] = 0)</l>
<l>        ResultForFeatures := [ResultForFeatures, 0]</l>
<l>    endif</l>
<c>    * case certain number of good/ in tolerances measures lead to eject</c>
<l>    if (Shiftregister_NumberOfDetectionsLeadToEject_PerLinePerFeature[Index_Cnt] &gt; 0)</l>
<l>        tuple_find (ResultOfOneFeature, 1, Matches_Found)</l>
<l>        if (Matches_Found = -1)</l>
<l>            ResultForFeatures := [ResultForFeatures, 0]</l>
<l>        else</l>
<l>*             Matches_Found_Number := |Matches_Found|</l>
<l>*             BadThreshold :=  Shiftregister_NumberOfDetectionsLeadToEject_PerLinePerFeature[Index_Cnt]</l>
<l>            if (|Matches_Found| &gt;= Shiftregister_NumberOfDetectionsLeadToEject_PerLinePerFeature[Index_Cnt])</l>
<l>                ResultForFeatures := [ResultForFeatures, 1]</l>
<l>            else</l>
<l>                ResultForFeatures := [ResultForFeatures, 0]</l>
<l>            endif</l>
<l>        endif</l>
<l>    endif</l>
<c>    * case certain number of bad measures lead to eject    </c>
<l>    if (Shiftregister_NumberOfDetectionsLeadToEject_PerLinePerFeature[Index_Cnt] &lt; 0)</l>
<l>        tuple_find (ResultOfOneFeature, 0, Matches_Found)</l>
<l>        if (Matches_Found = -1)</l>
<l>            ResultForFeatures := [ResultForFeatures, 1] // set to bad "1" if no good is detected</l>
<l>        else</l>
<l>            tuple_abs (Shiftregister_NumberOfDetectionsLeadToEject_PerLinePerFeature[Index_Cnt], Abs)</l>
<l>            if (|Matches_Found| &gt;= Abs)</l>
<l>                ResultForFeatures := [ResultForFeatures, 0]</l>
<l>            else</l>
<l>                ResultForFeatures := [ResultForFeatures, 1]</l>
<l>            endif</l>
<l>        endif</l>
<l>    endif</l>
<l>endfor</l>
<c></c>
<l>tuple_sum (ResultForFeatures, Result_Ovall0Good_1Bad)</l>
<l>if (Result_Ovall0Good_1Bad&gt;=1)</l>
<l>    Result_Ovall0Good_1Bad := 1</l>
<l>endif</l>
<c></c>
<l>Result_ForEverySingleFeature_0Good_1Bad := ResultForFeatures</l>
<c> </c>
<c>* calculate if critical result was found</c>
<l>tuple_mult (Result_ForEverySingleFeature_0Good_1Bad, Shiftregister_CriticalDefectActive_PerLinePerFeature, Prod)</l>
<l>tuple_sum (Prod, Sum)</l>
<l>if(Sum &gt; 0)</l>
<l>    CriticalInspectionResultFound := 1</l>
<l>endif</l>
<c></c>
<l>* stop()</l>
<l>return ()</l>
</body>
<docu id="gShiftRegister_CheckProductsAtEjectPosition_InTolerance">
<parameters>
<parameter id="CriticalInspectionResultFound"/>
<parameter id="EjectSelected"/>
<parameter id="ErrorObjectDataToStore_VMeasureFeature_TResult_TValue"/>
<parameter id="IndicesFound"/>
<parameter id="Result_ForEverySingleFeature_0Good_1Bad"/>
<parameter id="Result_Ovall0Good_1Bad"/>
<parameter id="Shiftregister_AllObjectsMovementAdapted"/>
<parameter id="Shiftregister_CriticalDefectActive_PerLinePerFeature"/>
<parameter id="Shiftregister_NumberOfDetectionsLeadToEject_PerLinePerFeature"/>
<parameter id="Shiftregister_VMeasureFeature_TResult_TValue_Out"/>
</parameters>
</docu>
</procedure>
<procedure name="gShiftregister_DebugTrap_CounterMismatch_RegionCount">
<interface>
<io>
<par name="Shiftregister_BadObjects_Out" base_type="iconic" dimension="0"/>
<par name="Shiftregister_AllObjectsMovementAdapted_Out" base_type="iconic" dimension="0"/>
</io>
<oc>
<par name="Shiftregister_BadObjects_Out_Number" base_type="ctrl" dimension="0"/>
<par name="Shiftregister_AllObjectsMovementAdapted_Out_Number" base_type="ctrl" dimension="0"/>
</oc>
</interface>
<body>
<l>count_obj (Shiftregister_BadObjects_Out, Shiftregister_BadObjects_Out_Number)</l>
<l>count_obj (Shiftregister_AllObjectsMovementAdapted_Out, Shiftregister_AllObjectsMovementAdapted_Out_Number)</l>
<l>if(Shiftregister_BadObjects_Out_Number # Shiftregister_AllObjectsMovementAdapted_Out_Number)</l>
<l>    stop()</l>
<l>endif</l>
<l>return ()</l>
</body>
<docu id="gShiftregister_DebugTrap_CounterMismatch_RegionCount">
<parameters>
<parameter id="Shiftregister_AllObjectsMovementAdapted_Out"/>
<parameter id="Shiftregister_AllObjectsMovementAdapted_Out_Number"/>
<parameter id="Shiftregister_BadObjects_Out"/>
<parameter id="Shiftregister_BadObjects_Out_Number"/>
</parameters>
</docu>
</procedure>
<procedure name="gShiftregister_DetermineAndRemoveRegionsInEjectBox">
<interface>
<io>
<par name="EjectROIs" base_type="iconic" dimension="0"/>
<par name="Shiftregister_BadObjects" base_type="iconic" dimension="0"/>
</io>
<oo>
<par name="Shiftregister_BadObjects_Out" base_type="iconic" dimension="0"/>
</oo>
<ic>
<par name="Optional_ActiveIfDataIsGiven_IndicesForRemoval" base_type="ctrl" dimension="0"/>
</ic>
<oc>
<par name="IndexOfAllRegionsWithPartlyIntersection" base_type="ctrl" dimension="0"/>
</oc>
</interface>
<body>
<l>Shiftregister_BadObjects_Out := Shiftregister_BadObjects</l>
<l>IndexOfAllRegionsWithPartlyIntersection := []</l>
<l>AllRegionsToRemove_Number := 0</l>
<c></c>
<c>* remove bad Objects from Shiftregister tracking</c>
<l>count_obj (Shiftregister_BadObjects, Shiftregister_BadObjects_Number)</l>
<l>if(Shiftregister_BadObjects_Number = 0)</l>
<l>    return()</l>
<l>endif</l>
<c></c>
<l>if(Optional_ActiveIfDataIsGiven_IndicesForRemoval # [])</l>
<l>    IndexOfAllRegionsWithPartlyIntersection := Optional_ActiveIfDataIsGiven_IndicesForRemoval</l>
<l>    select_obj (Shiftregister_BadObjects, Shiftregister_BadObjects_InEjectBox, IndexOfAllRegionsWithPartlyIntersection)</l>
<l>else</l>
<l>    gElementwiseComparisonTestRegionIndex_3 (EjectROIs, Shiftregister_BadObjects, Shiftregister_BadObjects_InEjectBox, IndexOfAllRegionsWithPartlyIntersection, AllRegionsToRemove_Number)</l>
<l>endif</l>
<c></c>
<l>union1 (Shiftregister_BadObjects_InEjectBox, EjectBadRegion)</l>
<c>* in case there is more than one tablet in eject position</c>
<l>connection (EjectBadRegion, EjectBadRegion)</l>
<l>smallest_rectangle1 (EjectBadRegion, EjectBadRegion_Row1, EjectBadRegion_Column1, EjectBadRegion_Row2, EjectBadRegion_Column2)</l>
<c></c>
<c>*remove found objects</c>
<l>if (AllRegionsToRemove_Number # 0)</l>
<l>    tuple_gen_sequence (0, Shiftregister_BadObjects_Number-1, 1, SelectionTuple)</l>
<l>    SelectionTuple := SelectionTuple+1 //iconic objects start with count at 1</l>
<l>    tuple_remove (SelectionTuple, IndexOfAllRegionsWithPartlyIntersection-1, SelectionTuple) // -1 because tuple count starts with0, iconic with 1</l>
<c>    </c>
<l>    select_obj (Shiftregister_BadObjects, Shiftregister_BadObjects_Out, SelectionTuple)</l>
<l>endif</l>
<c></c>
<l>return ()</l>
</body>
<docu id="gShiftregister_DetermineAndRemoveRegionsInEjectBox">
<parameters>
<parameter id="EjectROIs"/>
<parameter id="IndexOfAllRegionsWithPartlyIntersection"/>
<parameter id="Optional_ActiveIfDataIsGiven_IndicesForRemoval"/>
<parameter id="Shiftregister_BadObjects"/>
<parameter id="Shiftregister_BadObjects_Out"/>
</parameters>
</docu>
</procedure>
<procedure name="gShiftRegister_EliminateRegionsOutsideImage">
<interface>
<io>
<par name="ImageOrig" base_type="iconic" dimension="0"/>
<par name="EjectROIs" base_type="iconic" dimension="0"/>
<par name="Shiftregister_BadObjects_Out" base_type="iconic" dimension="0"/>
<par name="Shiftregister_GoodObjects_Out" base_type="iconic" dimension="0"/>
<par name="Shiftregister_AllObjectsMovementAdapted_Out" base_type="iconic" dimension="0"/>
<par name="Shiftregister_VMeasuredFeatures_IRegionPerFeature_Out" base_type="iconic" dimension="1"/>
<par name="Shiftregister_IImagePartsPerObject_Out" base_type="iconic" dimension="1"/>
</io>
<oo>
<par name="Shiftregister_BadObjects_OutOut" base_type="iconic" dimension="0"/>
<par name="Shiftregister_GoodObjects_OutOut" base_type="iconic" dimension="0"/>
<par name="Shiftregister_AllObjectsMovementAdapted_OutOut" base_type="iconic" dimension="0"/>
<par name="Shiftregister_IImagePartsPerObject_OutOut" base_type="iconic" dimension="1"/>
<par name="Shiftregister_VMeasuredFeatures_IRegionPerFeature_OutOut" base_type="iconic" dimension="1"/>
</oo>
<ic>
<par name="Shiftregister_VMeasureFeature_TResult_TValue_Out" base_type="ctrl" dimension="2"/>
<par name="Shiftregister_VImagePartsOffset_TRow_TColumn_Out" base_type="ctrl" dimension="1"/>
</ic>
<oc>
<par name="EjectROILowestRow" base_type="ctrl" dimension="0"/>
<par name="ObjectsOutOfImage_Indices" base_type="ctrl" dimension="0"/>
<par name="Shiftregister_VMeasureFeature_TResult_TValue_OutOut" base_type="ctrl" dimension="2"/>
<par name="Shiftregister_VImagePartsOffset_TRow_TColumn_OutOut" base_type="ctrl" dimension="1"/>
</oc>
</interface>
<body>
<c>* Remove Regions outside image. This will happen due to product movement will move regions out of image.</c>
<c></c>
<l>Shiftregister_BadObjects_OutOut := Shiftregister_BadObjects_Out</l>
<l>Shiftregister_GoodObjects_OutOut := Shiftregister_GoodObjects_Out</l>
<l>Shiftregister_AllObjectsMovementAdapted_OutOut := Shiftregister_AllObjectsMovementAdapted_Out</l>
<l>Shiftregister_IImagePartsPerObject_OutOut := Shiftregister_IImagePartsPerObject_Out</l>
<l>Shiftregister_VMeasuredFeatures_IRegionPerFeature_OutOut := Shiftregister_VMeasuredFeatures_IRegionPerFeature_Out</l>
<l>Shiftregister_VImagePartsOffset_TRow_TColumn_OutOut := Shiftregister_VImagePartsOffset_TRow_TColumn_Out</l>
<l>Shiftregister_VMeasureFeature_TResult_TValue_OutOut := Shiftregister_VMeasureFeature_TResult_TValue_Out</l>
<c>* </c>
<c>* eliminate all regions outside the image</c>
<l>get_image_size (ImageOrig, ImageOrig_Width, ImageOrig_Height)</l>
<l>smallest_rectangle1 (EjectROIs, _, _, EjectROILowestRow, _)</l>
<l>if (ImageOrig_Height &lt; EjectROILowestRow)</l>
<l>    EjectROILowestRow := ImageOrig_Height</l>
<l>endif</l>
<c></c>
<c></c>
<l>set_system ('clip_region', 'false') // acrivate clipping</l>
<c></c>
<l>gen_rectangle1 (Clip_Rectangle, ImageOrig_Height -1, 0, ImageOrig_Height +1000, ImageOrig_Width)</l>
<l>difference (Shiftregister_BadObjects_OutOut, Clip_Rectangle, Shiftregister_BadObjects_OutOut)</l>
<l>select_shape (Shiftregister_BadObjects_OutOut, Shiftregister_BadObjects_OutOut, 'area', 'and', 1, 99999999)</l>
<l>difference (Shiftregister_GoodObjects_OutOut, Clip_Rectangle, Shiftregister_GoodObjects_OutOut)</l>
<l>select_shape (Shiftregister_GoodObjects_OutOut, Shiftregister_GoodObjects_OutOut, 'area', 'and', 1, 99999999)</l>
<c></c>
<c></c>
<c></c>
<c>* select indices from shiftregister vector</c>
<l>RegionsToCheckIndex := Shiftregister_VMeasuredFeatures_IRegionPerFeature_OutOut.at(0)</l>
<l>gElementwiseComparisonTestRegionIndex_3 (Clip_Rectangle, RegionsToCheckIndex, Shiftregister_BadObjects_InEjectBox, ObjectsOutOfImage_Indices, ObjectsOutOfImage_Number)</l>
<c></c>
<c>* remove data from objects that are out of image already</c>
<l>gShiftregister_RemoveDataFromVector (Shiftregister_IImagePartsPerObject_OutOut, Shiftregister_VMeasuredFeatures_IRegionPerFeature_OutOut, Shiftregister_IImagePartsPerObject_OutOut, Shiftregister_VMeasuredFeatures_IRegionPerFeature_OutOut, ObjectsOutOfImage_Indices, Shiftregister_VMeasureFeature_TResult_TValue_OutOut, Shiftregister_VImagePartsOffset_TRow_TColumn_OutOut, Shiftregister_VMeasureFeature_TResult_TValue_OutOut, Shiftregister_VImagePartsOffset_TRow_TColumn_OutOut)</l>
<l>set_system ('clip_region', 'true') </l>
<c></c>
<l>return ()</l>
</body>
<docu id="gShiftRegister_EliminateRegionsOutsideImage">
<parameters>
<parameter id="EjectROILowestRow"/>
<parameter id="EjectROIs"/>
<parameter id="ImageOrig"/>
<parameter id="ObjectsOutOfImage_Indices"/>
<parameter id="Shiftregister_AllObjectsMovementAdapted_Out"/>
<parameter id="Shiftregister_AllObjectsMovementAdapted_OutOut"/>
<parameter id="Shiftregister_BadObjects_Out"/>
<parameter id="Shiftregister_BadObjects_OutOut"/>
<parameter id="Shiftregister_GoodObjects_Out"/>
<parameter id="Shiftregister_GoodObjects_OutOut"/>
<parameter id="Shiftregister_IImagePartsPerObject_Out"/>
<parameter id="Shiftregister_IImagePartsPerObject_OutOut"/>
<parameter id="Shiftregister_VImagePartsOffset_TRow_TColumn_Out"/>
<parameter id="Shiftregister_VImagePartsOffset_TRow_TColumn_OutOut"/>
<parameter id="Shiftregister_VMeasureFeature_TResult_TValue_Out"/>
<parameter id="Shiftregister_VMeasureFeature_TResult_TValue_OutOut"/>
<parameter id="Shiftregister_VMeasuredFeatures_IRegionPerFeature_Out"/>
<parameter id="Shiftregister_VMeasuredFeatures_IRegionPerFeature_OutOut"/>
</parameters>
</docu>
</procedure>
<procedure name="gShiftregister_LimitNumberOfObjects">
<interface>
<io>
<par name="Shiftregister_IImagePartsPerObject" base_type="iconic" dimension="1"/>
<par name="Shiftregister_VMeasuredFeatures_IRegionPerFeature" base_type="iconic" dimension="1"/>
<par name="Shiftregister_AllObjectsMovementAdapted" base_type="iconic" dimension="0"/>
</io>
<oo>
<par name="Shiftregister_IImagePartsPerObject_Out" base_type="iconic" dimension="1"/>
<par name="Shiftregister_VMeasuredFeatures_IRegionPerFeature_Out" base_type="iconic" dimension="1"/>
<par name="Shiftregister_AllObjectsMovementAdapted_Out" base_type="iconic" dimension="0"/>
</oo>
<ic>
<par name="IndicesToRemove" base_type="ctrl" dimension="0"/>
<par name="MaxNumberOfObjects" base_type="ctrl" dimension="0"/>
<par name="Shiftregister_VMeasureFeature_TResult_TValue" base_type="ctrl" dimension="2"/>
<par name="Shiftregister_VImagePartsOffset_TRow_Tcolumn" base_type="ctrl" dimension="1"/>
</ic>
<oc>
<par name="Shiftregister_VMeasureFeature_TResult_TValue_Out" base_type="ctrl" dimension="2"/>
<par name="Shiftregister_VImagePartsOffset_TRow_Tcolumn_Out" base_type="ctrl" dimension="1"/>
</oc>
</interface>
<body>
<c></c>
<c>* init the output variables</c>
<l>Shiftregister_AllObjectsMovementAdapted_Out := Shiftregister_AllObjectsMovementAdapted</l>
<c>* vector dimension 1</c>
<l>Shiftregister_IImagePartsPerObject_Out := Shiftregister_IImagePartsPerObject</l>
<l>Shiftregister_VImagePartsOffset_TRow_Tcolumn_Out := Shiftregister_VImagePartsOffset_TRow_Tcolumn</l>
<l>Shiftregister_VMeasuredFeatures_IRegionPerFeature_Out := Shiftregister_VMeasuredFeatures_IRegionPerFeature</l>
<c>* vector dimension 2</c>
<l>Shiftregister_VMeasureFeature_TResult_TValue_Out := Shiftregister_VMeasureFeature_TResult_TValue</l>
<c>******************************************************************************************************************</c>
<c>* trucate the Shiftregister_AllObjectsMovementAdapted</c>
<l>count_obj (Shiftregister_AllObjectsMovementAdapted, Shiftregister_AllObjectsMovementAdapted_Number)</l>
<l>if (Shiftregister_AllObjectsMovementAdapted_Number &gt; MaxNumberOfObjects)</l>
<l>    ElementsToRemove_Number := Shiftregister_AllObjectsMovementAdapted_Number - MaxNumberOfObjects</l>
<l>    tuple_gen_const (MaxNumberOfObjects, 1, ElementsToUseForOutput_Indices)   </l>
<l>    tuple_cumul (ElementsToUseForOutput_Indices, ElementsToUseForOutput_Indices)</l>
<l>    tuple_add (ElementsToUseForOutput_Indices, ElementsToRemove_Number, ElementsToUseForOutput_Indices)</l>
<l>    select_obj (Shiftregister_AllObjectsMovementAdapted, Shiftregister_AllObjectsMovementAdapted_Out, ElementsToUseForOutput_Indices)</l>
<c>    *</c>
<l>endif</l>
<c></c>
<c></c>
<c>* truncate more data</c>
<l>ObjectLengthImageParts_Input := Shiftregister_IImagePartsPerObject_Out.length()</l>
<l>Values_Length := |Shiftregister_VMeasureFeature_TResult_TValue.at(0).at(0)|</l>
<l>if (ObjectLengthImageParts_Input &gt; MaxNumberOfObjects or Values_Length &gt; MaxNumberOfObjects)</l>
<c>  </c>
<l>    tuple_sort (IndicesToRemove, IndicesToRemove) // due to the vector is directly shortened it is done from the biggest value to the smallest value</l>
<l>    tuple_length (IndicesToRemove, IndicesToRemove_Length)</l>
<c>    * get the inverted Indices to remove first- needed for later object selection</c>
<l>    NumberOfElementsInVector := Shiftregister_VImagePartsOffset_TRow_Tcolumn_Out.length()</l>
<l>    tuple_gen_const (NumberOfElementsInVector, 1, IndicesToRemove_Inverted)   </l>
<l>    tuple_cumul (IndicesToRemove_Inverted, IndicesToRemove_Inverted)  </l>
<c>    * now truncate data</c>
<c>    * start in downcounting loop for element indices that will be removed</c>
<l>    for IndexRemoval := NumberOfElementsInVector-1 to MaxNumberOfObjects by -1</l>
<l>        Shiftregister_IImagePartsPerObject_Out.remove(IndexRemoval)</l>
<l>        Shiftregister_VImagePartsOffset_TRow_Tcolumn_Out.remove(IndexRemoval)</l>
<l>    endfor</l>
<c>    </c>
<c>   * and a normal counting loop counting over vector elements </c>
<l>   Vector2DimLength := Shiftregister_VMeasureFeature_TResult_TValue_Out.length()</l>
<l>   for IndexVector2Dim := 0 to Vector2DimLength-1 by 1</l>
<c>       * now do the tuple selection</c>
<l>       Tempvector1Dim_1 := Shiftregister_VMeasureFeature_TResult_TValue_Out.at(IndexVector2Dim)</l>
<l>       Tempvector1Dim_Length := Tempvector1Dim_1.length()</l>
<l>       for IndexTempVector1Dim := 0 to Tempvector1Dim_Length-1 by 1</l>
<l>            Testlength := Tempvector1Dim_1.at(IndexTempVector1Dim)</l>
<l>            tuple_length (Testlength, Length)</l>
<l>            if (Length # 1)                </l>
<l>                tuple_select_range (Tempvector1Dim_1.at(IndexTempVector1Dim), 0, MaxNumberOfObjects-1, Tempvector1Dim_1.at(IndexTempVector1Dim))</l>
<l>            endif</l>
<l>       endfor</l>
<l>       Shiftregister_VMeasureFeature_TResult_TValue_Out.at(IndexVector2Dim) := Tempvector1Dim_1</l>
<l>       if (ObjectLengthImageParts_Input &gt; MaxNumberOfObjects)</l>
<c>           * now do the iconic selection</c>
<l>           tuple_select_range (IndicesToRemove_Inverted, 0, MaxNumberOfObjects-1, IndicesToSelect)</l>
<l>           select_obj (Shiftregister_VMeasuredFeatures_IRegionPerFeature_Out.at(IndexVector2Dim), Shiftregister_VMeasuredFeatures_IRegionPerFeature_Out.at(IndexVector2Dim), IndicesToSelect)</l>
<l>       endif</l>
<l>   endfor</l>
<l>endif</l>
<c></c>
<c></c>
<l>* Debug := 0</l>
<l>* if (Debug = 1)</l>
<l>*     count_obj (Shiftregister_AllObjectsMovementAdapted_Out, Shiftregister_AllObjectsMovementAdapted_Out_Number)</l>
<l>*     Shiftregister_VMeasureFeature_TResult_TValue_Out_Length := |Shiftregister_VMeasureFeature_TResult_TValue_Out.at(0).at(0)|</l>
<l>*     if(Shiftregister_VMeasureFeature_TResult_TValue_Out_Length # Shiftregister_AllObjectsMovementAdapted_Out_Number)</l>
<l>*         stop()</l>
<l>*     endif</l>
<l>* endif</l>
<l>return ()</l>
</body>
<docu id="gShiftregister_LimitNumberOfObjects">
<parameters>
<parameter id="IndicesToRemove"/>
<parameter id="MaxNumberOfObjects"/>
<parameter id="Shiftregister_AllObjectsMovementAdapted"/>
<parameter id="Shiftregister_AllObjectsMovementAdapted_Out"/>
<parameter id="Shiftregister_IImagePartsPerObject"/>
<parameter id="Shiftregister_IImagePartsPerObject_Out"/>
<parameter id="Shiftregister_VImagePartsOffset_TRow_Tcolumn"/>
<parameter id="Shiftregister_VImagePartsOffset_TRow_Tcolumn_Out"/>
<parameter id="Shiftregister_VMeasureFeature_TResult_TValue"/>
<parameter id="Shiftregister_VMeasureFeature_TResult_TValue_Out"/>
<parameter id="Shiftregister_VMeasuredFeatures_IRegionPerFeature"/>
<parameter id="Shiftregister_VMeasuredFeatures_IRegionPerFeature_Out"/>
</parameters>
</docu>
</procedure>
<procedure name="gShiftregister_MovementCompensation">
<interface>
<io>
<par name="EjectSelected_MovementUncompensated" base_type="iconic" dimension="0"/>
<par name="Shiftregister_BadObjects_Out" base_type="iconic" dimension="0"/>
<par name="EjectSelected_ForFastProducts" base_type="iconic" dimension="0"/>
</io>
<oo>
<par name="Shiftregister_BadObjects_InEjectBox_MovementUncompensated" base_type="iconic" dimension="0"/>
<par name="Shiftregister_BadObjects_InEjectBox_ForFastProducts" base_type="iconic" dimension="0"/>
</oo>
<ic>
<par name="MovementCompensation_Active" base_type="ctrl" dimension="0"/>
<par name="Shiftregister_NumberOfObjetsLeadToEjectPerLine" base_type="ctrl" dimension="0"/>
<par name="Shiftregister_EjectFoundPerLine_MovementUncompensated" base_type="ctrl" dimension="0"/>
<par name="Shiftregister_EjectFoundPerLine_ForFastProducts" base_type="ctrl" dimension="0"/>
<par name="NumberOfObjetsLeadToEjectPerLine_OffsetFastProducts" base_type="ctrl" dimension="0"/>
<par name="NumberOfObjetsLeadToEjectPerLine_OffsetMovementUncompensatedProducts" base_type="ctrl" dimension="0"/>
</ic>
<oc>
<par name="Shiftregister_EjectFoundPerLine_MovementUncompensatedOut" base_type="ctrl" dimension="0"/>
<par name="Shiftregister_EjectFoundPerLine_ForFastProductsOut" base_type="ctrl" dimension="0"/>
</oc>
</interface>
<body>
<c>* calculate if there is a need to signal fast incoming products- they have to be slowed down</c>
<c>* there is an offset to for the uncompensated as wel as the fast product eject box. This is because there will be a higher count longer the proiduct travels downstream</c>
<c></c>
<l>Shiftregister_EjectFoundPerLine_ForFastProductsOut := Shiftregister_EjectFoundPerLine_ForFastProducts</l>
<l>Shiftregister_EjectFoundPerLine_MovementUncompensatedOut := Shiftregister_EjectFoundPerLine_MovementUncompensated</l>
<l>    if(MovementCompensation_Active) // only if MovementCompensation_Active</l>
<l>    gElementwiseComparisonTestRegionIndex_3 (EjectSelected_MovementUncompensated, Shiftregister_BadObjects_Out, Shiftregister_BadObjects_InEjectBox_MovementUncompensated, BadObjects_Indices_MovementUncompensated, NumberOfFailedClassificationsInEjectBin_MovementUncompensated)</l>
<l>    gElementwiseComparisonTestRegionIndex_3 (EjectSelected_ForFastProducts, Shiftregister_BadObjects_Out, Shiftregister_BadObjects_InEjectBox_ForFastProducts, TabletIndividual_InEject_Index, NumberOfFailedClassificationsInEjectBin_ForFastProducts)</l>
<c></c>
<c>        * check if there are bad detecions on movement compensated eject</c>
<c></c>
<l>        NumberOfObjetsLeadToEjectPerLine_MovementUncompensatedProducts := Shiftregister_NumberOfObjetsLeadToEjectPerLine - NumberOfObjetsLeadToEjectPerLine_OffsetMovementUncompensatedProducts</l>
<l>        if(NumberOfObjetsLeadToEjectPerLine_MovementUncompensatedProducts &lt; 2)</l>
<l>            NumberOfObjetsLeadToEjectPerLine_MovementUncompensatedProducts := 2</l>
<l>        endif</l>
<l>        if (NumberOfFailedClassificationsInEjectBin_MovementUncompensated &gt;= NumberOfObjetsLeadToEjectPerLine_MovementUncompensatedProducts)</l>
<l>            tuple_concat (Shiftregister_EjectFoundPerLine_MovementUncompensatedOut, NumberOfFailedClassificationsInEjectBin_MovementUncompensated, Shiftregister_EjectFoundPerLine_MovementUncompensatedOut)</l>
<l>        else</l>
<l>            tuple_concat (Shiftregister_EjectFoundPerLine_MovementUncompensatedOut, 0, Shiftregister_EjectFoundPerLine_MovementUncompensatedOut)</l>
<l>        endif</l>
<c>        </c>
<l>        NumberOfObjetsLeadToEjectPerLine_FastProducts := Shiftregister_NumberOfObjetsLeadToEjectPerLine - NumberOfObjetsLeadToEjectPerLine_OffsetFastProducts</l>
<l>        if(NumberOfObjetsLeadToEjectPerLine_FastProducts &lt; 2)</l>
<l>            NumberOfObjetsLeadToEjectPerLine_FastProducts := 2</l>
<l>        endif</l>
<l>        if (NumberOfFailedClassificationsInEjectBin_ForFastProducts &gt;= NumberOfObjetsLeadToEjectPerLine_FastProducts)</l>
<l>            tuple_concat (Shiftregister_EjectFoundPerLine_ForFastProductsOut, NumberOfFailedClassificationsInEjectBin_ForFastProducts, Shiftregister_EjectFoundPerLine_ForFastProductsOut)</l>
<l>        else</l>
<l>            tuple_concat (Shiftregister_EjectFoundPerLine_ForFastProductsOut, 0, Shiftregister_EjectFoundPerLine_ForFastProductsOut)</l>
<l>        endif</l>
<l>    endif</l>
<l>return ()</l>
</body>
<docu id="gShiftregister_MovementCompensation">
<parameters>
<parameter id="EjectSelected_ForFastProducts"/>
<parameter id="EjectSelected_MovementUncompensated"/>
<parameter id="MovementCompensation_Active"/>
<parameter id="NumberOfObjetsLeadToEjectPerLine_OffsetFastProducts"/>
<parameter id="NumberOfObjetsLeadToEjectPerLine_OffsetMovementUncompensatedProducts"/>
<parameter id="Shiftregister_BadObjects_InEjectBox_ForFastProducts"/>
<parameter id="Shiftregister_BadObjects_InEjectBox_MovementUncompensated"/>
<parameter id="Shiftregister_BadObjects_Out"/>
<parameter id="Shiftregister_EjectFoundPerLine_ForFastProducts"/>
<parameter id="Shiftregister_EjectFoundPerLine_ForFastProductsOut"/>
<parameter id="Shiftregister_EjectFoundPerLine_MovementUncompensated"/>
<parameter id="Shiftregister_EjectFoundPerLine_MovementUncompensatedOut"/>
<parameter id="Shiftregister_NumberOfObjetsLeadToEjectPerLine"/>
</parameters>
</docu>
</procedure>
<procedure name="gShiftregister_MoveRegions">
<interface>
<io>
<par name="Shiftregister_BadObjects" base_type="iconic" dimension="0"/>
<par name="Shiftregister_GoodObjects" base_type="iconic" dimension="0"/>
<par name="Shiftregister_AllObjectsMovementAdapted" base_type="iconic" dimension="0"/>
<par name="Tablet_Individual" base_type="iconic" dimension="0"/>
</io>
<oo>
<par name="Shiftregister_BadObjects_Out" base_type="iconic" dimension="0"/>
<par name="Shiftregister_GoodObjects_Out" base_type="iconic" dimension="0"/>
<par name="Shiftregister_AllObjectsMovementAdapted_Out" base_type="iconic" dimension="0"/>
</oo>
<ic>
<par name="Shiftregister_ObjectMovement" base_type="ctrl" dimension="0"/>
<par name="Shiftregiste_ObjectMovement_PerProduct" base_type="ctrl" dimension="0"/>
<par name="ProductMovement_Global0_OrIndividual1" base_type="ctrl" dimension="0"/>
<par name="MaxSpeed" base_type="ctrl" dimension="0"/>
<par name="Shiftregister_VMeasureFeature_TResult_TValue" base_type="ctrl" dimension="2"/>
</ic>
<oc>
<par name="Shiftregister_VMeasureFeature_TResult_TValue_Out" base_type="ctrl" dimension="2"/>
<par name="IndicesOfLostRegions_DueToMoving" base_type="ctrl" dimension="0"/>
</oc>
</interface>
<body>
<l>Shiftregister_BadObjects_Out := Shiftregister_BadObjects</l>
<l>Shiftregister_GoodObjects_Out := Shiftregister_GoodObjects</l>
<l>Shiftregister_AllObjectsMovementAdapted_Out := Shiftregister_AllObjectsMovementAdapted</l>
<l>Shiftregister_VMeasureFeature_TResult_TValue_Out := Shiftregister_VMeasureFeature_TResult_TValue</l>
<c></c>
<l>gen_empty_obj (Shiftregister_BadObjects_Repositioned)</l>
<l>gen_empty_obj (Shiftregister_GoodObjects_Repositioned)</l>
<l>gen_empty_obj (Shiftregister_AllObjectsMovementAdapted_Repositioned)</l>
<c></c>
<l>IndicesOfLostRegions_DueToMoving := []</l>
<c></c>
<c></c>
<l>if (ProductMovement_Global0_OrIndividual1 = 0)  </l>
<l>    if (Shiftregister_ObjectMovement &gt; MaxSpeed)</l>
<l>        NumberOfindividualSpeeds := |Shiftregiste_ObjectMovement_PerProduct|</l>
<l>    endif</l>
<c>    * Move Shiftregisters by Object movement</c>
<l>    move_region (Shiftregister_BadObjects_Out, Shiftregister_BadObjects_Out, Shiftregister_ObjectMovement, 0)</l>
<l>    move_region (Shiftregister_GoodObjects_Out, Shiftregister_GoodObjects_Out, Shiftregister_ObjectMovement, 0)</l>
<c>    ** bug occures here due to moving of regions outside of image regions are getting lost</c>
<l>    move_region (Shiftregister_AllObjectsMovementAdapted_Out, Shiftregister_AllObjectsMovementAdapted_Out, Shiftregister_ObjectMovement, 0)</l>
<c>    </c>
<c>    * Regions were shifted out of image, needs to be corrected also on level of Shiftregister_VMeasureFeature_TResult_TValue data</c>
<l>    count_obj (Shiftregister_AllObjectsMovementAdapted, RegionBeforeMovement_Number)</l>
<l>    count_obj (Shiftregister_AllObjectsMovementAdapted_Out, RegionAfterMovement_Number)</l>
<l>    if (RegionBeforeMovement_Number # RegionAfterMovement_Number)</l>
<l>        for IndexCNT_RegionsShifting := 1 to RegionBeforeMovement_Number by 1</l>
<l>            select_obj (Shiftregister_AllObjectsMovementAdapted, Shiftregister_AllObjectsMovementAdapted_Selected, IndexCNT_RegionsShifting)</l>
<l>            move_region (Shiftregister_AllObjectsMovementAdapted_Selected, Shiftregister_AllObjectsMovementAdapted_Selected_Moved, Shiftregister_ObjectMovement, 0)</l>
<l>            area_center (Shiftregister_AllObjectsMovementAdapted_Selected_Moved, Area_MovedObject, _, _)</l>
<l>            if (Area_MovedObject = [])</l>
<l>              IndicesOfLostRegions_DueToMoving := [IndicesOfLostRegions_DueToMoving,IndexCNT_RegionsShifting]</l>
<l>            endif</l>
<l>        endfor     </l>
<l>        select_obj (Shiftregister_AllObjectsMovementAdapted, LostObjectsDueTo_MoveRegions, IndicesOfLostRegions_DueToMoving)</l>
<l>    endif</l>
<c></c>
<l>else    </l>
<c>    *move tablet individual back by movement found. find relative regions and move them forward</c>
<l>    IndexOrder_Good := []</l>
<l>    IndexOrder_Bad := []</l>
<l>    IndexOrder_AllObjectsMovementAdapted := []</l>
<c></c>
<l>    EmptyRegion_CycleSkippedNo := 0</l>
<c>    </c>
<l>    count_obj (Tablet_Individual, NumberOfObjects)</l>
<l>*     NumberOfObjects := |Shiftregiste_ObjectMovement_PerProduct|</l>
<l>    FoundEmpty_Good := 0</l>
<l>    FoundEmpty_Bad := 0</l>
<l>    FoundEmpty_AllObjectsMovementAdapted := 0</l>
<c></c>
<l>    for Index_Cnt := 1 to NumberOfObjects by 1 </l>
<l>        select_obj (Tablet_Individual, Tablet_Individual_Selected, Index_Cnt)</l>
<c>        * error handling in case a movement value could not be found for a product - use the value before</c>
<l>        ttt := |Shiftregiste_ObjectMovement_PerProduct|</l>
<l>        if(|Shiftregiste_ObjectMovement_PerProduct| &lt; (Index_Cnt - FoundEmpty_Good))</l>
<l>            RowMovement := -Shiftregiste_ObjectMovement_PerProduct[0]</l>
<l>        else</l>
<l>            RowMovement := -Shiftregiste_ObjectMovement_PerProduct[Index_Cnt-1 - FoundEmpty_Good]</l>
<l>        endif</l>
<c>        </c>
<l>        if (RowMovement &lt; -300) </l>
<l>            tuple_median (Shiftregiste_ObjectMovement_PerProduct, RowMovement)</l>
<l>        endif</l>
<l>        move_region (Tablet_Individual_Selected, Tablet_Individual_Selected_MovedBack, RowMovement, 0)</l>
<c>        *good</c>
<l>        gShiftregister_MoveRegionsBeforeReorder (Tablet_Individual_Selected_MovedBack, Shiftregister_GoodObjects, Shiftregister_GoodObjects_Repositioned, Shiftregister_GoodObjects_Repositioned, FoundEmpty_Good, IndexOrder_Good, Shiftregiste_ObjectMovement_PerProduct, Index_Cnt, FoundEmpty_Good, IndexOrder_Good)</l>
<c>        *bad</c>
<l>        gShiftregister_MoveRegionsBeforeReorder (Tablet_Individual_Selected_MovedBack, Shiftregister_BadObjects, Shiftregister_BadObjects_Repositioned, Shiftregister_BadObjects_Repositioned, FoundEmpty_Bad, IndexOrder_Bad, Shiftregiste_ObjectMovement_PerProduct, Index_Cnt, FoundEmpty_Bad, IndexOrder_Bad)</l>
<c>        *allmovementadapted</c>
<l>        gShiftregister_MoveRegionsBeforeReorder (Tablet_Individual_Selected_MovedBack, Shiftregister_AllObjectsMovementAdapted, Shiftregister_AllObjectsMovementAdapted_Repositioned, Shiftregister_AllObjectsMovementAdapted_Repositioned, FoundEmpty_AllObjectsMovementAdapted, IndexOrder_AllObjectsMovementAdapted, Shiftregiste_ObjectMovement_PerProduct, Index_Cnt, FoundEmpty_AllObjectsMovementAdapted, IndexOrder_AllObjectsMovementAdapted)</l>
<l>    endfor</l>
<c>    </c>
<c>    * after all objects were moved the indices are wrong- reorder in relation to original index order</c>
<l>    gShiftregister_ReorderRegionsAfterMoving (Shiftregister_GoodObjects_Repositioned, Shiftregister_GoodObjects_Out, ObjectSelected, IndexOrder_Good, Index_Order_Cnt, Index_Found)</l>
<l>    gShiftregister_ReorderRegionsAfterMoving (Shiftregister_BadObjects_Repositioned, Shiftregister_BadObjects_Out, ObjectSelected, IndexOrder_Bad, Index_Order_Cnt, Index_Found)</l>
<l>    gShiftregister_ReorderRegionsAfterMoving (Shiftregister_AllObjectsMovementAdapted_Repositioned, Shiftregister_AllObjectsMovementAdapted_Out, ObjectSelected, IndexOrder_AllObjectsMovementAdapted, Index_Order_Cnt, Index_Found)</l>
<l>endif</l>
<c></c>
<c>*************************************add functionality to move values here</c>
<l>if (Shiftregister_VMeasureFeature_TResult_TValue_Out # {{[]}})</l>
<l>    ObjectsLowestRow := Shiftregister_VMeasureFeature_TResult_TValue_Out.at(0).at(3)// := MeasureLowestObjectRowCurrent_Concatted</l>
<l>    tuple_add (ObjectsLowestRow, Shiftregister_ObjectMovement, ObjectsLowestRow_Moved)</l>
<c>    * Hint_: Object movement is only described in first vector element</c>
<l>    Shiftregister_VMeasureFeature_TResult_TValue_Out.at(0).at(3) := ObjectsLowestRow_Moved</l>
<c>    **********</c>
<l>    ObjectsRowHighest := Shiftregister_VMeasureFeature_TResult_TValue_Out.at(0).at(4)// := MeasureLowestObjectRowCurrent_Concatted</l>
<l>    tuple_add (ObjectsRowHighest, Shiftregister_ObjectMovement, ObjectsRowHighest_Moved)</l>
<c>    * Hint_: Object movement is only described in first vector element</c>
<l>    Shiftregister_VMeasureFeature_TResult_TValue_Out.at(0).at(4) := ObjectsRowHighest_Moved</l>
<l>endif</l>
<c></c>
<l>return ()</l>
</body>
<docu id="gShiftregister_MoveRegions">
<parameters>
<parameter id="IndicesOfLostRegions_DueToMoving"/>
<parameter id="MaxSpeed"/>
<parameter id="ProductMovement_Global0_OrIndividual1"/>
<parameter id="Shiftregiste_ObjectMovement_PerProduct"/>
<parameter id="Shiftregister_AllObjectsMovementAdapted"/>
<parameter id="Shiftregister_AllObjectsMovementAdapted_Out"/>
<parameter id="Shiftregister_BadObjects"/>
<parameter id="Shiftregister_BadObjects_Out"/>
<parameter id="Shiftregister_GoodObjects"/>
<parameter id="Shiftregister_GoodObjects_Out"/>
<parameter id="Shiftregister_ObjectMovement"/>
<parameter id="Shiftregister_VMeasureFeature_TResult_TValue"/>
<parameter id="Shiftregister_VMeasureFeature_TResult_TValue_Out"/>
<parameter id="Tablet_Individual"/>
</parameters>
</docu>
</procedure>
<procedure name="gShiftregister_MoveRegionsBeforeReorder">
<interface>
<io>
<par name="Tablet_Individual_Selected_MovedBack" base_type="iconic" dimension="0"/>
<par name="Shiftregister_GoodObjects" base_type="iconic" dimension="0"/>
<par name="Shiftregister_GoodObjects_Repositioned" base_type="iconic" dimension="0"/>
</io>
<oo>
<par name="Shiftregister_GoodObjects_RepositionedOut" base_type="iconic" dimension="0"/>
</oo>
<ic>
<par name="FoundEmpty_Good" base_type="ctrl" dimension="0"/>
<par name="IndexOrder_Good" base_type="ctrl" dimension="0"/>
<par name="Shiftregiste_ObjectMovement_PerProduct" base_type="ctrl" dimension="0"/>
<par name="Index_Cnt" base_type="ctrl" dimension="0"/>
</ic>
<oc>
<par name="FoundEmpty_GoodOut" base_type="ctrl" dimension="0"/>
<par name="IndexOrder_GoodOut" base_type="ctrl" dimension="0"/>
</oc>
</interface>
<body>
<c>* move regions by a given value in case they have note been moved before. the indicator for before movement is given in IndexOrder_Good </c>
<c></c>
<l>Shiftregister_GoodObjects_RepositionedOut := Shiftregister_GoodObjects_Repositioned</l>
<l>FoundEmpty_GoodOut := FoundEmpty_Good</l>
<l>IndexOrder_GoodOut := IndexOrder_Good</l>
<c></c>
<c>* do the movement for the Good objects</c>
<l>gElementwiseComparisonTestRegionIndex_3 (Tablet_Individual_Selected_MovedBack, Shiftregister_GoodObjects, Shiftregister_BadObjects_InEjectBox, FoundIndices, ObjectsOutOfImage_Number)</l>
<c>*check for already processed indices and remove them from further processing</c>
<l>DoubleIndices := []</l>
<l>for Index_CntDouble := 0 to |FoundIndices|-1 by 1</l>
<l>    tuple_find (IndexOrder_GoodOut, FoundIndices[Index_CntDouble], DoubleIndicesFound)</l>
<l>    if (DoubleIndicesFound # -1 and DoubleIndicesFound # [])</l>
<l>        DoubleIndices :=  [DoubleIndices,Index_CntDouble]</l>
<l>    endif</l>
<l>endfor</l>
<l>if (DoubleIndices # [])</l>
<l>    tuple_remove (FoundIndices, DoubleIndices, FoundIndices)</l>
<l>endif</l>
<c>***</c>
<c></c>
<l>if (FoundIndices = [])</l>
<l>    FoundEmpty_GoodOut := FoundEmpty_GoodOut +1</l>
<l>else</l>
<l>    tuple_find (IndexOrder_GoodOut, FoundIndices, Indices_AlreadyBeforeMovedObjects)</l>
<l>    select_obj (Shiftregister_GoodObjects, Shiftregister_GoodObjects_Selected, FoundIndices)</l>
<l>    TplLength := |Shiftregiste_ObjectMovement_PerProduct|</l>
<c>    * patched chrash in case tpl has incorrect entys for movement- use the first entry. </c>
<l>    ToCompareTo :=  [Index_Cnt - 1 - FoundEmpty_GoodOut]</l>
<l>    if (ToCompareTo-1 &lt; TplLength)</l>
<l>        ValueToMove := Shiftregiste_ObjectMovement_PerProduct[0]</l>
<l>    else</l>
<l>       ValueToMove :=  Shiftregiste_ObjectMovement_PerProduct[Index_Cnt - 1 - FoundEmpty_GoodOut]</l>
<l>    endif</l>
<l>    move_region (Shiftregister_GoodObjects_Selected, Shiftregister_GoodObjects_Selected_Moved, ValueToMove, 0)</l>
<l>    concat_obj (Shiftregister_GoodObjects_RepositionedOut, Shiftregister_GoodObjects_Selected_Moved, Shiftregister_GoodObjects_RepositionedOut)</l>
<l>    tuple_concat (IndexOrder_GoodOut, FoundIndices, IndexOrder_GoodOut)</l>
<l>endif</l>
<c></c>
<l>return ()</l>
</body>
<docu id="gShiftregister_MoveRegionsBeforeReorder">
<parameters>
<parameter id="FoundEmpty_Good"/>
<parameter id="FoundEmpty_GoodOut"/>
<parameter id="IndexOrder_Good"/>
<parameter id="IndexOrder_GoodOut"/>
<parameter id="Index_Cnt"/>
<parameter id="Shiftregiste_ObjectMovement_PerProduct"/>
<parameter id="Shiftregister_GoodObjects"/>
<parameter id="Shiftregister_GoodObjects_Repositioned"/>
<parameter id="Shiftregister_GoodObjects_RepositionedOut"/>
<parameter id="Tablet_Individual_Selected_MovedBack"/>
</parameters>
</docu>
</procedure>
<procedure name="gShiftRegister_OneLine">
<interface>
<io>
<par name="Shiftregister_GoodObjects" base_type="iconic" dimension="0"/>
<par name="Shiftregister_BadObjects" base_type="iconic" dimension="0"/>
<par name="ShiftRegister_ObjectsInLastFrame" base_type="iconic" dimension="0"/>
<par name="Shiftregister_AllObjectsMovementAdapted" base_type="iconic" dimension="0"/>
<par name="Shiftregister_IImagePartsPerObject" base_type="iconic" dimension="1"/>
<par name="Shiftregister_VMeasuredFeatures_IRegionPerFeature" base_type="iconic" dimension="1"/>
<par name="Tablet_Individual" base_type="iconic" dimension="0"/>
<par name="ImageOrig" base_type="iconic" dimension="0"/>
<par name="RinnenROIs" base_type="iconic" dimension="0"/>
<par name="EjectROIs" base_type="iconic" dimension="0"/>
<par name="ErrorObject_BadObjects" base_type="iconic" dimension="0"/>
<par name="ErrorObject_GoodObjects" base_type="iconic" dimension="0"/>
<par name="Products_IMeasuredRegionsPerFeature" base_type="iconic" dimension="1"/>
<par name="Products_IImagePartsPerObject" base_type="iconic" dimension="1"/>
<par name="Rollmeasurement360" base_type="iconic" dimension="0"/>
</io>
<oo>
<par name="Shiftregister_GoodObjects_Out" base_type="iconic" dimension="0"/>
<par name="Shiftregister_BadObjects_Out" base_type="iconic" dimension="0"/>
<par name="ShiftRegister_ObjectsInLastFrame_Out" base_type="iconic" dimension="0"/>
<par name="Shiftregister_AllObjectsMovementAdapted_Out" base_type="iconic" dimension="0"/>
<par name="Shiftregister_IImagePartsPerObject_Out" base_type="iconic" dimension="1"/>
<par name="Shiftregister_VMeasuredFeatures_IRegionPerFeature_Out" base_type="iconic" dimension="1"/>
<par name="Shiftregister_GoodObjectsFor" base_type="iconic" dimension="0"/>
<par name="Shiftregister_BadObjectsFor" base_type="iconic" dimension="0"/>
<par name="ErrorObjectDataToStore_IImagePartsPerObject" base_type="iconic" dimension="1"/>
<par name="ErrorObjectDataToStore_IRegionPerFeature" base_type="iconic" dimension="1"/>
<par name="EjectSelected_PotentiallyAdapted" base_type="iconic" dimension="0"/>
</oo>
<ic>
<par name="IndexRinnenUndEjects" base_type="ctrl" dimension="0"/>
<par name="Shiftregister_NumberOfObjetsLeadToEjectPerLine" base_type="ctrl" dimension="0"/>
<par name="Shiftregister_NumberOfDetectionsLeadToEject_PerLinePerFeature" base_type="ctrl" dimension="0"/>
<par name="Shiftregister_CriticalDefectActive_PerLinePerFeature" base_type="ctrl" dimension="0"/>
<par name="Shiftregister_RemoveBadRegionsInEjectBox" base_type="ctrl" dimension="0"/>
<par name="Shiftregister_Rebuild_Kill" base_type="ctrl" dimension="0"/>
<par name="Shiftregister_Tuple_Data" base_type="ctrl" dimension="2"/>
<par name="Shiftregister_VMeasureFeature_TResult_TValue" base_type="ctrl" dimension="2"/>
<par name="Products_VMeasureFeature_TResult_TValue" base_type="ctrl" dimension="2"/>
<par name="Products_VImagePartsOffset_TRow_TColumn" base_type="ctrl" dimension="1"/>
<par name="Shiftregister_EjectPositionMovementCompensationActive" base_type="ctrl" dimension="0"/>
<par name="Shiftregister_EjectPositionMovementCompensation_LowerMax" base_type="ctrl" dimension="0"/>
<par name="Shiftregister_EjectPositionMovementCompensation_UpperMax" base_type="ctrl" dimension="0"/>
<par name="Shiftregister_EjectPositionMovementCompensation_SpeedMax" base_type="ctrl" dimension="0"/>
<par name="Shiftregister_FixedEjectPosition_RelativeToROI" base_type="ctrl" dimension="0"/>
<par name="Shiftregister_FixedStopPositionForFastProducts_RelativeToROI" base_type="ctrl" dimension="0"/>
<par name="Shiftregister_VImagePartsOffset_TRow_TColumn" base_type="ctrl" dimension="1"/>
<par name="Shiftregister_SaveMeasureFeatureValuesAtRuntime" base_type="ctrl" dimension="0"/>
<par name="Shiftregister_SaveMeasureFeatureGoodBadAtRuntime" base_type="ctrl" dimension="0"/>
<par name="Shiftregister_SaveMeasureFeatureRegionsAtRuntime" base_type="ctrl" dimension="0"/>
<par name="Shiftregister_SaveMeasureFeaturePartImagesAtRuntime" base_type="ctrl" dimension="0"/>
<par name="Shiftregister_CheckForGoodProductDetectionActive" base_type="ctrl" dimension="0"/>
<par name="Shiftregister_ObjectsPerTrack_LimitMax" base_type="ctrl" dimension="0"/>
<par name="Shiftregister_ObjectMovement_MinSpeedToRegisterObjects" base_type="ctrl" dimension="0"/>
<par name="RollSpeed360_Mean" base_type="ctrl" dimension="0"/>
</ic>
<oc>
<par name="Shiftregister_EjectFoundPerLine" base_type="ctrl" dimension="0"/>
<par name="Shiftregister_EjectGoodFoundPerLine" base_type="ctrl" dimension="0"/>
<par name="Shiftregister_EjectFoundPerLine_MovementUncompensated" base_type="ctrl" dimension="0"/>
<par name="Shiftregister_EjectFoundPerLine_ForFastProducts" base_type="ctrl" dimension="0"/>
<par name="Shiftregister_EjectPositionMovementCompensation" base_type="ctrl" dimension="0"/>
<par name="Shiftregister_ObjectMovement" base_type="ctrl" dimension="0"/>
<par name="Shiftregister_IndicesInEjectBoxFound" base_type="ctrl" dimension="0"/>
<par name="ObjectMovement" base_type="ctrl" dimension="0"/>
<par name="EjectROIs_Number" base_type="ctrl" dimension="0"/>
<par name="NumberOfFailedClassificationsInEjectBin" base_type="ctrl" dimension="0"/>
<par name="NumberOfGoodClassificationsInEjectBin" base_type="ctrl" dimension="0"/>
<par name="IndexOfAllRegionsWithPartlyIntersection" base_type="ctrl" dimension="0"/>
<par name="CriticalInspectionResultFound" base_type="ctrl" dimension="0"/>
<par name="Shiftregister_Tuple_Data_Out" base_type="ctrl" dimension="2"/>
<par name="Shiftregister_VMeasureFeature_TResult_TValue_Out" base_type="ctrl" dimension="2"/>
<par name="Shiftregister_VImagePartsOffset_TRow_TColumn_Out" base_type="ctrl" dimension="1"/>
<par name="ErrorObjectDataToStore_VMeasureFeature_TResult_TValue" base_type="ctrl" dimension="2"/>
<par name="ErrorObjectDataToStore_VImagePartsOffset_TRow_TColumn" base_type="ctrl" dimension="1"/>
<par name="Result_ForEverySingleFeature_0Good_1Bad" base_type="ctrl" dimension="0"/>
<par name="TimeNeeded" base_type="ctrl" dimension="0"/>
</oc>
</interface>
<body>
<l>* global tuple dict_Mode</l>
<c>***************************************************************************************************************</c>
<c>*************************************** init start ************************************************************</c>
<c>***************************************************************************************************************</c>
<l>count_seconds (Seconds_Start)</l>
<l>Result_ForEverySingleFeature_0Good_1Bad := []</l>
<l>IndexOfAllRegionsWithPartlyIntersection := []</l>
<l>Shiftregister_BadObjects_Out := Shiftregister_BadObjects</l>
<l>Shiftregister_GoodObjects_Out := Shiftregister_GoodObjects</l>
<l>Shiftregister_AllObjectsMovementAdapted_Out := Shiftregister_AllObjectsMovementAdapted</l>
<l>Shiftregister_VMeasureFeature_TResult_TValue_Out := Shiftregister_VMeasureFeature_TResult_TValue</l>
<l>Shiftregister_IImagePartsPerObject_Out := Shiftregister_IImagePartsPerObject</l>
<l>Shiftregister_VImagePartsOffset_TRow_TColumn_Out := Shiftregister_VImagePartsOffset_TRow_TColumn</l>
<l>Shiftregister_VMeasuredFeatures_IRegionPerFeature_Out := Shiftregister_VMeasuredFeatures_IRegionPerFeature</l>
<l>* Shiftregister_BadObjectsVisualisationImages_Out := Shiftregister_BadObjectsVisualisationImages</l>
<l>Shiftregister_Tuple_Data_Out := Shiftregister_Tuple_Data</l>
<c>* </c>
<c>* assignements</c>
<l>Shiftregister_EjectFoundPerLine := []</l>
<l>Shiftregister_EjectGoodFoundPerLine := []</l>
<l>Shiftregister_EjectFoundPerLine_MovementUncompensated:=[]</l>
<l>Shiftregister_EjectFoundPerLine_ForFastProducts :=[]</l>
<l>Shiftregister_EjectPositionMovementCompensation := []</l>
<l>CriticalInspectionResultFound:=0</l>
<l>ErrorObjectDataToStore_VMeasureFeature_TResult_TValue.at(0) := {[],[]}</l>
<l>ErrorObjectDataToStore_VImagePartsOffset_TRow_TColumn.at(0) := []</l>
<l>NumberOfFailedClassificationsInEjectBin := []</l>
<l>NumberOfGoodClassificationsInEjectBin := []</l>
<l>gen_empty_obj (ErrorObjectDataToStore_IImagePartsPerObject.at(0))</l>
<l>gen_empty_obj (ErrorObjectDataToStore_IRegionPerFeature.at(0))</l>
<l>gen_empty_obj (EmptyObject)</l>
<c></c>
<c></c>
<c>*************************************** init end **************************************************************</c>
<c>***************************************************************************************************************</c>
<c>*************************************** start shift register***************************************************</c>
<c></c>
<c>* reset shiftregister data in case of external trigger or if there is no product on track</c>
<l>if (Shiftregister_Rebuild_Kill[1] = 1 )//or Tablet_Individual_Number = 0)</l>
<l>    gShiftregister_OneLine_ResetData (Shiftregister_BadObjects_Out, Shiftregister_GoodObjects_Out, ShiftRegister_ObjectsInLastFrame_Out, Shiftregister_AllObjectsMovementAdapted_Out, Shiftregister_VMeasuredFeatures_IRegionPerFeature_Out, Shiftregister_IImagePartsPerObject_Out, Shiftregister_VMeasuredFeatures_IRegionPerFeature_Out.length(), Shiftregister_VMeasureFeature_TResult_TValue_Out, Shiftregister_VImagePartsOffset_TRow_TColumn_Out)</l>
<l>    Shiftregister_IndicesInEjectBoxFound := []</l>
<l>    Shiftregister_ObjectMovement := 0</l>
<l>    gen_empty_obj (Shiftregister_GoodObjectsFor)</l>
<l>    gen_empty_obj (Shiftregister_BadObjectsFor)</l>
<l>    Shiftregister_EjectFoundPerLine := [0]</l>
<l>    Shiftregister_EjectGoodFoundPerLine := [0]</l>
<l>    Shiftregister_EjectFoundPerLine_MovementUncompensated:=[0]</l>
<l>    Shiftregister_EjectFoundPerLine_ForFastProducts :=[0]</l>
<l>    Shiftregister_EjectPositionMovementCompensation := [0]</l>
<l>    return()</l>
<l>endif</l>
<c>* </c>
<c>* Good and Bad Objects of multiple features represent the input for the shift register. GoodObjectsFor as well bad are calculatet and will be added to the shift register.</c>
<l>Shiftregister_BadObjectsFor := ErrorObject_BadObjects</l>
<l>Shiftregister_GoodObjectsFor := ErrorObject_GoodObjects</l>
<l>count_obj (Tablet_Individual, Tablet_Individual_Number)</l>
<c>* special treatment in case there are no products found. in this case reset the shiftregister data</c>
<l>if (Tablet_Individual_Number = 0)</l>
<l>    gShiftregister_OneLine_ResetData (Shiftregister_BadObjects_Out, Shiftregister_GoodObjects_Out, ShiftRegister_ObjectsInLastFrame_Out, Shiftregister_AllObjectsMovementAdapted_Out, Shiftregister_VMeasuredFeatures_IRegionPerFeature_Out, Shiftregister_IImagePartsPerObject_Out, Shiftregister_VMeasuredFeatures_IRegionPerFeature_Out.length(), Shiftregister_VMeasureFeature_TResult_TValue_Out, Shiftregister_VImagePartsOffset_TRow_TColumn_Out)</l>
<l>endif</l>
<c></c>
<c></c>
<l>AddMeasuresBadObjectsInEjectROIToGoodObjects := 0</l>
<c>* special treatment for objects that where processed in eject roi. Due to possible incorrect processing results these objects are treated as good.</c>
<l>gAddBadObjectsInEjectROIToGoodObjects (Shiftregister_BadObjectsFor, Shiftregister_GoodObjectsFor, EjectROIs, Shiftregister_BadObjectsFor, Shiftregister_GoodObjectsFor, AddMeasuresBadObjectsInEjectROIToGoodObjects)</l>
<c></c>
<l>ProductMovement_AllowedSpeedMax := 120    </l>
<c></c>
<l>if (RollSpeed360_Mean = [])</l>
<l>    gObjectMovementEstimation_V5 (Tablet_Individual, ShiftRegister_ObjectsInLastFrame, ImageOrig, 0, -10, ProductMovement_AllowedSpeedMax, ObjectMovement, ObjectMovement_PerProduct)</l>
<l>else</l>
<l>    ObjectMovement := RollSpeed360_Mean</l>
<l>    ObjectMovement_PerProduct := []</l>
<l>endif</l>
<c></c>
<c></c>
<c>************* to test if following lines are still necessary** down</c>
<l>if (Tablet_Individual_Number = 0)</l>
<l>    Shiftregister_ObjectMovement := 0</l>
<l>else</l>
<l>    Shiftregister_ObjectMovement := ObjectMovement</l>
<l>endif</l>
<c>************* to test if following lines are still necessary** up</c>
<c></c>
<l>if (ObjectMovement &gt; 0)</l>
<l>    ProductMovementIndividual := 0</l>
<l>    gShiftregister_MoveRegions (Shiftregister_BadObjects_Out, Shiftregister_GoodObjects_Out, Shiftregister_AllObjectsMovementAdapted_Out, Tablet_Individual, Shiftregister_BadObjects_Out, Shiftregister_GoodObjects_Out, Shiftregister_AllObjectsMovementAdapted_Out, Shiftregister_ObjectMovement, ObjectMovement_PerProduct, ProductMovementIndividual, Shiftregister_EjectPositionMovementCompensation_SpeedMax, Shiftregister_VMeasureFeature_TResult_TValue_Out, Shiftregister_VMeasureFeature_TResult_TValue_Out, IndicesOfLostRegions_DueToMoving)</l>
<c>    *individual tracking switched on in next line - remove after tests</c>
<l>    if (IndicesOfLostRegions_DueToMoving # [])</l>
<l>        gShiftregister_RemoveDataFromVector (Shiftregister_IImagePartsPerObject_Out, Shiftregister_VMeasuredFeatures_IRegionPerFeature_Out, Shiftregister_IImagePartsPerObject_Out, Shiftregister_VMeasuredFeatures_IRegionPerFeature_Out, IndicesOfLostRegions_DueToMoving, Shiftregister_VMeasureFeature_TResult_TValue_Out, Shiftregister_VImagePartsOffset_TRow_TColumn_Out, Shiftregister_VMeasureFeature_TResult_TValue_Out, Shiftregister_VImagePartsOffset_TRow_TColumn_Out)</l>
<l>    endif</l>
<l>endif</l>
<c></c>
<c></c>
<l>gShiftRegister_EliminateRegionsOutsideImage (ImageOrig, EjectROIs, Shiftregister_BadObjects_Out, Shiftregister_GoodObjects_Out, Shiftregister_AllObjectsMovementAdapted_Out, Shiftregister_VMeasuredFeatures_IRegionPerFeature_Out, Shiftregister_IImagePartsPerObject_Out, Shiftregister_BadObjects_Out, Shiftregister_GoodObjects_Out, Shiftregister_AllObjectsMovementAdapted_Out, Shiftregister_IImagePartsPerObject_Out, Shiftregister_VMeasuredFeatures_IRegionPerFeature_Out, Shiftregister_VMeasureFeature_TResult_TValue_Out, Shiftregister_VImagePartsOffset_TRow_TColumn_Out, EjectROILowestRow, ObjectsOutOfImage_Indices, Shiftregister_VMeasureFeature_TResult_TValue_Out, Shiftregister_VImagePartsOffset_TRow_TColumn_Out)</l>
<l>gShiftregister_RemoveDataFromVector (Shiftregister_IImagePartsPerObject_Out, Shiftregister_VMeasuredFeatures_IRegionPerFeature_Out, Shiftregister_IImagePartsPerObject_Out, Shiftregister_VMeasuredFeatures_IRegionPerFeature_Out, ObjectsOutOfImage_Indices, Shiftregister_VMeasureFeature_TResult_TValue_Out, Shiftregister_VImagePartsOffset_TRow_TColumn_Out, Shiftregister_VMeasureFeature_TResult_TValue_Out, Shiftregister_VImagePartsOffset_TRow_TColumn_Out)</l>
<c></c>
<c>* in case empty lane without product is found do some data initialization </c>
<l>if (Products_VMeasureFeature_TResult_TValue.at(0).at(0) = [])</l>
<l>    gShiftregister_AddDataToVector (Shiftregister_IImagePartsPerObject_Out, Shiftregister_VMeasuredFeatures_IRegionPerFeature_Out, Products_IImagePartsPerObject, Products_IMeasuredRegionsPerFeature, Shiftregister_IImagePartsPerObject_Out, Shiftregister_VMeasuredFeatures_IRegionPerFeature_Out, Products_VMeasureFeature_TResult_TValue, Shiftregister_VMeasureFeature_TResult_TValue_Out, Products_VImagePartsOffset_TRow_TColumn, Shiftregister_VImagePartsOffset_TRow_TColumn_Out, Shiftregister_SaveMeasureFeatureValuesAtRuntime, Shiftregister_SaveMeasureFeatureRegionsAtRuntime, Shiftregister_SaveMeasureFeaturePartImagesAtRuntime, Shiftregister_VMeasureFeature_TResult_TValue_Out, ProductsVectorLength, Shiftregister_VImagePartsOffset_TRow_TColumn_Out)</l>
<l>endif</l>
<c></c>
<c>* check if there are objects available and indicate to add inout without movement in case there is nothing</c>
<l>count_obj (Shiftregister_BadObjects_Out, BadOut_Number)</l>
<l>count_obj (Shiftregister_GoodObjects_Out, GoodOut_Number)</l>
<l>AddObjectsWithoutMovement := BadOut_Number + GoodOut_Number </l>
<l>* if(Active360Inspection) // not available for 360 - to check if necessary for normal run</l>
<l>    AddObjectsWithoutMovement := 1</l>
<l>* endif</l>
<c>  </c>
<c>* Add the found calculated objets to Shift registers- only if a bigger object movement is found. Also add the first product if there is no movement detected.</c>
<l>ObjectMovement_MinSpeedToRegisterObjects :=Shiftregister_ObjectMovement_MinSpeedToRegisterObjects</l>
<l>if (Shiftregister_ObjectMovement &gt; ObjectMovement_MinSpeedToRegisterObjects or Shiftregister_Rebuild_Kill[0] &gt;= 1 or AddObjectsWithoutMovement = 1)</l>
<c>    * is for 360 there is an object that goes over two rolls at least filter out to avoid problems downstream</c>
<l>    gShiftregister_360EliminateTooBigProducsOverMutlipleRolls (Rollmeasurement360, Shiftregister_BadObjectsFor, Shiftregister_GoodObjectsFor, Tablet_Individual, ImageOrig, Products_IImagePartsPerObject, Products_IMeasuredRegionsPerFeature, Tablet_Individual, Shiftregister_GoodObjectsFor, Shiftregister_BadObjectsFor, Products_IImagePartsPerObject, Products_IMeasuredRegionsPerFeature, Products_VMeasureFeature_TResult_TValue, Products_VImagePartsOffset_TRow_TColumn, Products_VMeasureFeature_TResult_TValue, Products_VImagePartsOffset_TRow_TColumn)</l>
<c>    *issue if new segmentation is in eject roi where object was deleted directly before. leads to bad results in error review</c>
<l>    concat_obj (Shiftregister_BadObjects_Out, Shiftregister_BadObjectsFor, Shiftregister_BadObjects_Out)</l>
<l>    concat_obj (Shiftregister_GoodObjects_Out, Shiftregister_GoodObjectsFor, Shiftregister_GoodObjects_Out)</l>
<l>    concat_obj (Shiftregister_AllObjectsMovementAdapted_Out, Tablet_Individual, Shiftregister_AllObjectsMovementAdapted_Out)</l>
<l>    gShiftregister_AddDataToVector (Shiftregister_IImagePartsPerObject_Out, Shiftregister_VMeasuredFeatures_IRegionPerFeature_Out, Products_IImagePartsPerObject, Products_IMeasuredRegionsPerFeature, Shiftregister_IImagePartsPerObject_Out, Shiftregister_VMeasuredFeatures_IRegionPerFeature_Out, Products_VMeasureFeature_TResult_TValue, Shiftregister_VMeasureFeature_TResult_TValue_Out, Products_VImagePartsOffset_TRow_TColumn, Shiftregister_VImagePartsOffset_TRow_TColumn_Out, Shiftregister_SaveMeasureFeatureValuesAtRuntime, Shiftregister_SaveMeasureFeatureRegionsAtRuntime, Shiftregister_SaveMeasureFeaturePartImagesAtRuntime, Shiftregister_VMeasureFeature_TResult_TValue_Out, ProductsVectorLength, Shiftregister_VImagePartsOffset_TRow_TColumn_Out)</l>
<l>endif</l>
<c>* </c>
<c>*** remove objects that are crossing the border- this happens due to shifting of objects</c>
<c>* todo: which one to use for new sort secure? Active360Inspection = 0 or Active360Inspection = 1?</c>
<l>get_image_size (ImageOrig, ImageOrig_Width, ImageOrig_Height)</l>
<l>* if(Active360Inspection = 0)</l>
<c>    * works on countsecure- no product after eject roi</c>
<l>*     gen_rectangle1 (RegionLastLine, EjectROILowestRow-1, 0, EjectROILowestRow, ImageOrig_Width)</l>
<l>* else</l>
<c>    * works on 360- last lane is end of image due to roll measurement is used and products have to stay a bit longer </c>
<l>    gen_rectangle1 (RegionLastLine, ImageOrig_Height - 2, 0, ImageOrig_Height, ImageOrig_Width) // needs to be 2 pix less- one pix is not enought for bad objects removal in the next lines</l>
<l>* endif</l>
<c></c>
<l>gShiftregister_DetermineAndRemoveRegionsInEjectBox (RegionLastLine, Shiftregister_BadObjects_Out, Shiftregister_BadObjects_Out, [], IndexOfAllRegionsWithPartlyIntersection)</l>
<l>gShiftregister_DetermineAndRemoveRegionsInEjectBox (RegionLastLine, Shiftregister_AllObjectsMovementAdapted_Out, Shiftregister_AllObjectsMovementAdapted_Out, [], IndexOfAllRegionsWithPartlyIntersection)</l>
<l>gShiftregister_RemoveDataFromVector (Shiftregister_IImagePartsPerObject_Out, Shiftregister_VMeasuredFeatures_IRegionPerFeature_Out, Shiftregister_IImagePartsPerObject_Out, Shiftregister_VMeasuredFeatures_IRegionPerFeature_Out, IndexOfAllRegionsWithPartlyIntersection, Shiftregister_VMeasureFeature_TResult_TValue_Out, Shiftregister_VImagePartsOffset_TRow_TColumn_Out, Shiftregister_VMeasureFeature_TResult_TValue_Out, Shiftregister_VImagePartsOffset_TRow_TColumn_Out)</l>
<c>**************** movement compensation block **down</c>
<l>EjectSelected := EjectROIs</l>
<l>EjectSelected_MovementUncompensated:=EjectSelected</l>
<l>Eject_FixedEjectPosition_RelativeToROI:= Shiftregister_FixedEjectPosition_RelativeToROI</l>
<l>Eject_FixedStopPositionForFastProducts_RelativeToROI:= Shiftregister_FixedStopPositionForFastProducts_RelativeToROI</l>
<l>move_region (EjectSelected, EjectSelected, Eject_FixedEjectPosition_RelativeToROI, 0)</l>
<c></c>
<l>* move_region (EjectSelected_MovementUncompensated, EjectSelected_ForFastProducts, Eject_FixedStopPositionForFastProducts_RelativeToROI, 0)</l>
<c>* EjectSelected_ForFastProducts is not moved, a gap in between eject rectangle and rectangle for fast product must be avoided- otherwise pulsing for fine positioning will not pork</c>
<l>smallest_rectangle1 (EjectSelected, Row11, Column11, Row21, Column21)</l>
<l>gen_rectangle1 (EjectSelected_ForFastProducts, (Row11 +  Eject_FixedStopPositionForFastProducts_RelativeToROI), Column11, Row11, Column21)</l>
<c></c>
<l>gEjectPositionToProductMovementCompensation (EjectSelected, EjectSelected, ObjectMovement, Shiftregister_EjectPositionMovementCompensationActive, Shiftregister_EjectPositionMovementCompensation_LowerMax, Shiftregister_EjectPositionMovementCompensation_UpperMax, Shiftregister_EjectPositionMovementCompensation_SpeedMax, EjectPositionMovementCompensation)</l>
<c></c>
<l>tuple_concat (Shiftregister_EjectPositionMovementCompensation, EjectPositionMovementCompensation, Shiftregister_EjectPositionMovementCompensation)</l>
<c>* </c>
<l>gShiftregister_AdaptEjectRegionWithEjectObject (Shiftregister_AllObjectsMovementAdapted_Out, EjectSelected, EjectSelected)</l>
<c>**********************************check for bad objects in eject box</c>
<c>**     CheckNumberOfRegionsInSpecificRegion (EjectSelected, Shiftregister_BadObjects_Out, 1, NumberOfFailedClassificationsInEjectBin, BadObjects_Indices)</c>
<l>gElementwiseComparisonTestRegionIndex_3 (EjectSelected, Shiftregister_BadObjects_Out, Shiftregister_BadObjects_InEjectBox, BadObjects_Indices, NumberOfFailedClassificationsInEjectBin)</l>
<c>* do the eject box movement compensation to stop fast incoming products and pulse them into eject box</c>
<l>MovementCompensation_Active := Shiftregister_EjectPositionMovementCompensationActive</l>
<l>* select_obj (EjectROIs, EjectSelected, Index_Cnt_EjectROIs)</l>
<c>* to check why there is 0 found instead of different value</c>
<l>gShiftregister_MovementCompensation (EjectSelected_MovementUncompensated, Shiftregister_BadObjects_Out, EjectSelected_ForFastProducts, Shiftregister_BadObjects_InEjectBox_MovementUncompensated, Shiftregister_BadObjects_InEjectBox_ForFastProducts, MovementCompensation_Active, Shiftregister_NumberOfObjetsLeadToEjectPerLine, Shiftregister_EjectFoundPerLine_MovementUncompensated, Shiftregister_EjectFoundPerLine_ForFastProducts, 2, 1, Shiftregister_EjectFoundPerLine_MovementUncompensated, Shiftregister_EjectFoundPerLine_ForFastProducts)</l>
<c>**************** movement compensation block **up</c>
<c></c>
<c>* Check if a colour error should lead to critical stop </c>
<c>*********************     CheckForCriticalError (ErrorObject_WrongColour, Shiftregister_BadObjects_Out, EjectSelected, RinnenROIs, CriticalInspectionResultStopsSystem, ShiftregisterValues[6], CriticalInspectionResultFound)</c>
<c>******************* new approach</c>
<c>* Check for every individual feature if in or out tolerance</c>
<l>Result_Ovall0Good_1Bad := 0</l>
<c></c>
<c>* check if product is in eject position. normal case: if product touches eject box check for count in it. 360 case: reference in relation to machine rolls- gives more stable results on asymetric products (such as flat)</c>
<l>intersection (EjectROIs, Rollmeasurement360, MeasuredRollInEjectROI)  </l>
<l>area_center (MeasuredRollInEjectROI, MeasuredRollInEjectROI_Area, _, _)</l>
<l>if(MeasuredRollInEjectROI_Area &gt;0 and MeasuredRollInEjectROI_Area # [])</l>
<l>    gElementwiseComparisonTestRegionIndex_3 (EjectSelected, Shiftregister_AllObjectsMovementAdapted_Out, Shiftregister_Objects_InEjectBox, TabletIndividual_InEject_Index, NumberOfObjectsInEjectSelected)</l>
<l>*     stop()</l>
<l>else</l>
<l>    NumberOfObjectsInEjectSelected := 0</l>
<l>    TabletIndividual_InEject_Index := []</l>
<l>    gen_empty_obj (Shiftregister_Objects_InEjectBox)</l>
<l>endif</l>
<c></c>
<c></c>
<c></c>
<c>* delete single objects in eject box - was added after it was processed and removed. </c>
<l>if(NumberOfObjectsInEjectSelected &gt; 0 and NumberOfObjectsInEjectSelected &lt;=3) // maybe increase the value from 2 to 3- is done to remove detected objects in eject roi</l>
<l>    gShiftregister_DetermineAndRemoveRegionsInEjectBox (EjectSelected, Shiftregister_BadObjects_Out, Shiftregister_BadObjects_Out, [], _)</l>
<l>    gShiftregister_DetermineAndRemoveRegionsInEjectBox (EjectSelected, Shiftregister_GoodObjects_Out, Shiftregister_GoodObjects_Out, [], _)</l>
<l>    gShiftregister_DetermineAndRemoveRegionsInEjectBox (EjectSelected, Shiftregister_AllObjectsMovementAdapted_Out, Shiftregister_AllObjectsMovementAdapted_Out, [], IndicesForRemoval)</l>
<c>    * now start to remove the error detail data</c>
<l>    gShiftregister_RemoveDataFromVector (Shiftregister_IImagePartsPerObject_Out, Shiftregister_VMeasuredFeatures_IRegionPerFeature_Out, Shiftregister_IImagePartsPerObject_Out, Shiftregister_VMeasuredFeatures_IRegionPerFeature_Out, IndicesForRemoval, Shiftregister_VMeasureFeature_TResult_TValue_Out, Shiftregister_VImagePartsOffset_TRow_TColumn_Out, Shiftregister_VMeasureFeature_TResult_TValue_Out, Shiftregister_VImagePartsOffset_TRow_TColumn_Out)</l>
<c>*         ShiftRegister_RemoveDataFromLine (Shiftregister_IImagePartsPerObject_Out, Shiftregister_IImagePartsPerObject_Out, Shiftregister_IImagePartsPerObject_Out, Shiftregister_IImagePartsPerObject_Out, Shiftregister_IImagePartsPerObject_Out, Shiftregister_IImagePartsPerObject_Out, ShiftRegisterVector_Good_Bad_ObjectsLastFrame_Out, Shiftregister_VThread_VLane_IImagePartsPerObject_Out, Shiftregister_VThread_VLane_VMeasuredFeatures_IRegionPerFeature_Out, NumberOfObjectsInEjectSelected, NumberOfObjectsInEjectSelected, NumberOfObjectsInEjectSelected, NumberOfObjectsInEjectSelected, NumberOfObjectsInEjectSelected, Shiftregister_VThread_VLane_IndicesInEjectBoxFound, Time_Needed, Shiftregister_VThread_VLane_VMeasureFeature_TResult_TValue_Out, Shiftregister_VThread_VLane_VImagePartsOffset_TRow_TColumn_Out)</c>
<l>endif</l>
<c> </c>
<c></c>
<c></c>
<c>* decide to signal good or bad product</c>
<l>if(NumberOfObjectsInEjectSelected &gt;= 4) // if there is at least 4 objects in ejectbox proceed</l>
<l>    gShiftRegister_CheckProductsAtEjectPosition_InTolerance (EjectSelected, Shiftregister_AllObjectsMovementAdapted_Out, Shiftregister_VMeasureFeature_TResult_TValue_Out, Shiftregister_NumberOfDetectionsLeadToEject_PerLinePerFeature, Shiftregister_CriticalDefectActive_PerLinePerFeature, ErrorObjectDataToStore_VMeasureFeature_TResult_TValue_Temp, Result_Ovall0Good_1Bad, Result_ForEverySingleFeature_0Good_1Bad, Shiftregister_IndicesInEjectBoxFound, CriticalInspectionResultFound)</l>
<l>else</l>
<l>    Shiftregister_IndicesInEjectBoxFound := []</l>
<l>endif</l>
<c></c>
<c>******* inspection result is defined- now extract the correct data</c>
<l>EjectBox1OrBadObjectCanLeadToEject0 := 1</l>
<l>if (Result_Ovall0Good_1Bad = 1) // first the bad detection part</l>
<l>    NumberOfGoodClassificationsInEjectBin := 0</l>
<l>    BadObjects_Indices := Shiftregister_IndicesInEjectBoxFound </l>
<c>    </c>
<l>    if(EjectBox1OrBadObjectCanLeadToEject0 = 0)</l>
<l>        IndextoSelect := TabletIndividual_InEject_Index[|TabletIndividual_InEject_Index|-1]</l>
<l>        select_obj (Shiftregister_VMeasuredFeatures_IRegionPerFeature_Out.at(0), RegionToFineTuneBadEject, IndextoSelect)          </l>
<c>        * Approach that every bad object can lead to eject</c>
<l>        gIndividualBadObjectsCanLeadToEject (EjectSelected, RegionToFineTuneBadEject, Shiftregister_AllObjectsMovementAdapted_Out, Shiftregister_NumberOfObjetsLeadToEjectPerLine, Shiftregister_EjectFoundPerLine, NumberOfFailedClassificationsInEjectBin, Shiftregister_EjectFoundPerLine, IndicesOfRegionsInEjectPosition)            </l>
<l>        NumberOfFailedClassificationsInEjectBin := |BadObjects_Indices|</l>
<l>        IndicesOfRegionsInEjectPosition := BadObjects_Indices</l>
<l>    else</l>
<c>        * Approach that the eject box can lead to eject</c>
<l>        gEjectBoxCanLeadToEject (EjectSelected, Shiftregister_BadObjects_Out, Shiftregister_Objects_InEjectBox, EjectBadRegion, EjectBadRegion_MiddleRectangle, Shiftregister_BadObjects_Out, Shiftregister_EjectFoundPerLine, Shiftregister_RemoveBadRegionsInEjectBox, Shiftregister_EjectFoundPerLine)</l>
<l>    endif </l>
<c></c>
<c>    *****************************</c>
<c>    * now start saving error data</c>
<c>    *****************************</c>
<c>    * Values </c>
<l>    if (Shiftregister_SaveMeasureFeatureValuesAtRuntime)</l>
<l>        ErrorObjectDataToStore_VMeasureFeature_TResult_TValue := ErrorObjectDataToStore_VMeasureFeature_TResult_TValue_Temp // use results that were calcualted before</l>
<l>        gStopForMeanResults := 0</l>
<l>        if (gStopForMeanResults)</l>
<l>            gCalculateMeanValuesOfMeasurementfeatures (BadObjects_Indices, Shiftregister_VMeasureFeature_TResult_TValue_Out, 0, VectorMean, VectorDeviation)</l>
<l>            gCalculateMeanValuesOfMeasurementfeatures (BadObjects_Indices, Shiftregister_VMeasureFeature_TResult_TValue_Out, 25, VectorMean, VectorDeviation)</l>
<l>            ResultDataForExcel := [VectorMean.at(7),VectorDeviation.at(7),VectorMean.at(8),VectorDeviation.at(8)]</l>
<l>            LocalResolutionPixMM := 17.905</l>
<l>            ResultDataForExcel := [VectorMean.at(7)/LocalResolutionPixMM,VectorDeviation.at(7),VectorMean.at(8)/LocalResolutionPixMM,VectorDeviation.at(8)]</l>
<l>        endif</l>
<l>    else</l>
<l>        ErrorObjectDataToStore_VMeasureFeature_TResult_TValue.at(0) :=  {[],[]}</l>
<l>    endif</l>
<c></c>
<c>    * Regions</c>
<l>    if (Shiftregister_SaveMeasureFeatureRegionsAtRuntime)</l>
<l>        gShiftregister_SelectErrorDataSubset_Vector1Dim_Iconic (Shiftregister_VMeasuredFeatures_IRegionPerFeature_Out, ErrorObjectDataToStore_IRegionPerFeature, BadObjects_Indices)        </l>
<l>    else</l>
<l>        ErrorObjectDataToStore_IRegionPerFeature.at(0) := EmptyObject </l>
<l>    endif</l>
<c>    </c>
<c>    * Part images</c>
<l>    if (Shiftregister_SaveMeasureFeaturePartImagesAtRuntime)</l>
<l>        gShiftregister_SelectErrorDataSubset_Vector1Dim_Tuple (BadObjects_Indices, Shiftregister_VImagePartsOffset_TRow_TColumn_Out, ErrorObjectDataToStore_VImagePartsOffset_TRow_TColumn)</l>
<l>        gShiftregister_SelectErrorDataSubset_Iconic (Shiftregister_IImagePartsPerObject_Out, ErrorObjectDataToStore_IImagePartsPerObject, BadObjects_Indices)</l>
<l>    else</l>
<l>        ErrorObjectDataToStore_VImagePartsOffset_TRow_TColumn.at(0) := []</l>
<l>        ErrorObjectDataToStore_IImagePartsPerObject.at(0) := EmptyObject</l>
<l>    endif</l>
<c>    </c>
<c>    * Check if a colour error should lead to critical stop </c>
<c>    ************         CheckForCriticalError (ErrorObject_WrongColour, Shiftregister_BadObjects_Out, EjectSelected, RinnenROIs, CriticalInspectionResultStopsSystem, Shiftregister_NumberOfObjetsLeadToEjectPerLine, CriticalInspectionResultFound)</c>
<c>    * if there is a bad object in movement uncomensated eject</c>
<c>    ************         Shiftregister_EjectFoundPerLine_MovementUncompensated:= NumberOfFailedClassificationsInEjectBin_MovementUncompensated</c>
<l>else // now the good detection part</l>
<l>    NumberOfFailedClassificationsInEjectBin := 0</l>
<c>    *what to do with no product or good product  </c>
<l>    if (Shiftregister_CheckForGoodProductDetectionActive = 1)</l>
<l>        GoodObjects_Indices := Shiftregister_IndicesInEjectBoxFound</l>
<c>*         CheckNumberOfRegionsInSpecificRegion (EjectSelected, Shiftregister_GoodObjects_Out, 1, NumberOfGoodClassificationsInEjectBin, GoodObjects_Indices)</c>
<l>        IndicesOfRegionsInEjectPosition := []</l>
<l>        if (|GoodObjects_Indices| &gt;= 1) </l>
<l>            IndextoSelect := TabletIndividual_InEject_Index[|TabletIndividual_InEject_Index|-1]</l>
<c>            </c>
<c>            *** Janine - Exception Topic</c>
<l>            count_obj (Shiftregister_VMeasuredFeatures_IRegionPerFeature_Out.at(0), Num)</l>
<l>            if (Num &gt;= IndextoSelect)</l>
<l>                select_obj (Shiftregister_VMeasuredFeatures_IRegionPerFeature_Out.at(0), RegionToFineTuneGoodEject, IndextoSelect)</l>
<l>            else</l>
<l>                gen_empty_obj (RegionToFineTuneGoodEject)</l>
<l>            endif</l>
<c>            *** End Janine - Exception Topic</c>
<c>           </c>
<c>            </c>
<l>            if(EjectBox1OrBadObjectCanLeadToEject0 = 0)</l>
<l>                IndextoSelect := TabletIndividual_InEject_Index[|TabletIndividual_InEject_Index|-1]</l>
<l>                select_obj (Shiftregister_VMeasuredFeatures_IRegionPerFeature_Out.at(0), RegionToFineTuneBadEject, IndextoSelect)          </l>
<c>                * Approach that every bad object can lead to eject</c>
<l>                gIndividualBadObjectsCanLeadToEject (EjectSelected, RegionToFineTuneBadEject, Shiftregister_AllObjectsMovementAdapted_Out, Shiftregister_NumberOfObjetsLeadToEjectPerLine, Shiftregister_EjectFoundPerLine, NumberOfFailedClassificationsInEjectBin, Shiftregister_EjectFoundPerLine, IndicesOfRegionsInEjectPosition)            </l>
<l>                NumberOfFailedClassificationsInEjectBin := |BadObjects_Indices|</l>
<l>                IndicesOfRegionsInEjectPosition := BadObjects_Indices</l>
<l>            else</l>
<c>                * Approach that the eject box can lead to eject</c>
<l>                gEjectBoxCanLeadToEject (EjectSelected, Shiftregister_GoodObjects_Out, Shiftregister_GoodObjects_InEjectBox, EjectGoodRegion, EjectGoodRegion_MiddleRectangle, Shiftregister_GoodObjects_Out, Shiftregister_EjectFoundPerLine, Shiftregister_RemoveBadRegionsInEjectBox, Shiftregister_EjectFoundPerLine)</l>
<l>            endif </l>
<c>            </c>
<c>            ***********************************</c>
<c>            </c>
<l>            Shiftregister_GoodNumberOfObjetsLeadToEjectPerLine := 1</l>
<l>            NumberOfGoodClassificationsInEjectBin := |GoodObjects_Indices|</l>
<l>            IndicesOfRegionsInEjectPosition := GoodObjects_Indices</l>
<l>        endif </l>
<l>    else</l>
<l>        tuple_concat (Shiftregister_EjectGoodFoundPerLine, 0, Shiftregister_EjectGoodFoundPerLine)</l>
<l>        NumberOfGoodClassificationsInEjectBin := 0</l>
<l>    endif</l>
<l>endif</l>
<c></c>
<c></c>
<c>* remove bad Objects from Shiftregister tracking</c>
<l>if (Shiftregister_RemoveBadRegionsInEjectBox)</l>
<l>    EjectSelected := EjectROIs</l>
<l>    smallest_rectangle1 (EjectSelected, Row1, Column1, Row2, Column2)</l>
<l>    gen_rectangle1 (RectangleToRemoveRegions, ((Row2-Row1)/2) + Row1, Column1, Row2, Column2)</l>
<c>    * </c>
<l>    gElementwiseComparisonTestRegionIndex_3 (RectangleToRemoveRegions, Shiftregister_BadObjects_Out, Shiftregister_BadObjects_InEjectBox, IndexOfAllRegionsWithPartlyIntersection, NumberOfObjects)</l>
<l>    union1 (Shiftregister_BadObjects_InEjectBox, EjectBadRegion)</l>
<c>    * in case there are more than one tablet in eject position</c>
<l>    connection (EjectBadRegion, EjectBadRegion)</l>
<l>    smallest_rectangle1 (EjectBadRegion, EjectBadRegion_Row1, EjectBadRegion_Column1, EjectBadRegion_Row2, EjectBadRegion_Column2)</l>
<l>    if (EjectBadRegion_Row1 # [])</l>
<l>        EjectBadRegion_Height := (EjectBadRegion_Row2 - EjectBadRegion_Row1) /2</l>
<l>        gen_rectangle1 (EjectBadRegion_MiddleRectangle, EjectBadRegion_Row1 + EjectBadRegion_Height/2, EjectBadRegion_Column1, EjectBadRegion_Row2, EjectBadRegion_Column2)</l>
<c>        * have another selection in rectangle- gives better performance due to jitter in repositioning of regions</c>
<l>        gElementwiseComparisonTestRegionIndex_3 (EjectBadRegion_MiddleRectangle, Shiftregister_BadObjects_Out, Shiftregister_BadObjects_InEjectBox, IndexOfAllRegionsWithPartlyIntersection, NuberOfObjects)</l>
<l>        select_shape (Shiftregister_BadObjects_InEjectBox, Shiftregister_BadObjects_InEjectBox, 'area', 'and', 1, 999999999)</l>
<l>    endif</l>
<l>    difference (Shiftregister_BadObjects_Out, Shiftregister_BadObjects_InEjectBox, Shiftregister_BadObjects_Out)</l>
<l>    select_shape (Shiftregister_BadObjects_Out, Shiftregister_BadObjects_Out, 'area', 'and', 1, 9999999999)</l>
<l>endif</l>
<c></c>
<l>copy_obj (Tablet_Individual, ShiftRegister_ObjectsInLastFrame_Out, 1, -1)</l>
<c></c>
<c>* limit the number of objects to a max of 200 per line- otherwise algorithm will slow down dramatically over time</c>
<l>count_obj (EjectROIs, Number_EjectROIs)</l>
<l>MaxNumberOfObjects := Number_EjectROIs * Shiftregister_ObjectsPerTrack_LimitMax</l>
<l>gLimitNumberOfRegions (Shiftregister_GoodObjects_Out, Shiftregister_GoodObjects_Out, MaxNumberOfObjects, Shiftregister_GoodObjects_Out_NumberIn)</l>
<l>gLimitNumberOfRegions (Shiftregister_BadObjects_Out, Shiftregister_BadObjects_Out, MaxNumberOfObjects, Shiftregister_BadObjects_Out_NumberIn)</l>
<c>* remove data from objects that extend MaxNumberOfObjects</c>
<l>gShiftregister_LimitNumberOfObjects (Shiftregister_IImagePartsPerObject_Out, Shiftregister_VMeasuredFeatures_IRegionPerFeature_Out, Shiftregister_AllObjectsMovementAdapted_Out, Shiftregister_IImagePartsPerObject_Out, Shiftregister_VMeasuredFeatures_IRegionPerFeature_Out, Shiftregister_AllObjectsMovementAdapted_Out, ObjectsOutOfImage_Indices, MaxNumberOfObjects, Shiftregister_VMeasureFeature_TResult_TValue_Out, Shiftregister_VImagePartsOffset_TRow_TColumn_Out, Shiftregister_VMeasureFeature_TResult_TValue_Out, Shiftregister_VImagePartsOffset_TRow_TColumn_Out)</l>
<l>EjectSelected_PotentiallyAdapted := EjectSelected</l>
<c>* new approach end</c>
<c>*****************************</c>
<c></c>
<l>count_seconds (Seconds_End)</l>
<c></c>
<l>TimeNeeded := (Seconds_End - Seconds_Start) * 1000.0 </l>
<c></c>
<c>* it may happen that there is an empty result for the ejects</c>
<l>if( NumberOfFailedClassificationsInEjectBin = [])</l>
<l>    NumberOfFailedClassificationsInEjectBin := 0</l>
<l>endif</l>
<l>if( NumberOfGoodClassificationsInEjectBin = [])</l>
<l>    NumberOfGoodClassificationsInEjectBin := 0</l>
<l>endif</l>
<c></c>
<l>return()</l>
</body>
<docu id="gShiftRegister_OneLine">
<parameters>
<parameter id="CriticalInspectionResultFound"/>
<parameter id="EjectROIs"/>
<parameter id="EjectROIs_Number"/>
<parameter id="EjectSelected_PotentiallyAdapted"/>
<parameter id="ErrorObjectDataToStore_IImagePartsPerObject"/>
<parameter id="ErrorObjectDataToStore_IRegionPerFeature"/>
<parameter id="ErrorObjectDataToStore_VImagePartsOffset_TRow_TColumn"/>
<parameter id="ErrorObjectDataToStore_VMeasureFeature_TResult_TValue"/>
<parameter id="ErrorObject_BadObjects"/>
<parameter id="ErrorObject_GoodObjects"/>
<parameter id="ImageOrig"/>
<parameter id="IndexOfAllRegionsWithPartlyIntersection"/>
<parameter id="IndexRinnenUndEjects"/>
<parameter id="NumberOfFailedClassificationsInEjectBin"/>
<parameter id="NumberOfGoodClassificationsInEjectBin"/>
<parameter id="ObjectMovement"/>
<parameter id="Products_IImagePartsPerObject"/>
<parameter id="Products_IMeasuredRegionsPerFeature"/>
<parameter id="Products_VImagePartsOffset_TRow_TColumn"/>
<parameter id="Products_VMeasureFeature_TResult_TValue"/>
<parameter id="Result_ForEverySingleFeature_0Good_1Bad"/>
<parameter id="RinnenROIs"/>
<parameter id="RollSpeed360_Mean"/>
<parameter id="Rollmeasurement360"/>
<parameter id="ShiftRegister_ObjectsInLastFrame"/>
<parameter id="ShiftRegister_ObjectsInLastFrame_Out"/>
<parameter id="Shiftregister_AllObjectsMovementAdapted"/>
<parameter id="Shiftregister_AllObjectsMovementAdapted_Out"/>
<parameter id="Shiftregister_BadObjects"/>
<parameter id="Shiftregister_BadObjectsFor"/>
<parameter id="Shiftregister_BadObjects_Out"/>
<parameter id="Shiftregister_CheckForGoodProductDetectionActive"/>
<parameter id="Shiftregister_CriticalDefectActive_PerLinePerFeature"/>
<parameter id="Shiftregister_EjectFoundPerLine"/>
<parameter id="Shiftregister_EjectFoundPerLine_ForFastProducts"/>
<parameter id="Shiftregister_EjectFoundPerLine_MovementUncompensated"/>
<parameter id="Shiftregister_EjectGoodFoundPerLine"/>
<parameter id="Shiftregister_EjectPositionMovementCompensation"/>
<parameter id="Shiftregister_EjectPositionMovementCompensationActive"/>
<parameter id="Shiftregister_EjectPositionMovementCompensation_LowerMax"/>
<parameter id="Shiftregister_EjectPositionMovementCompensation_SpeedMax"/>
<parameter id="Shiftregister_EjectPositionMovementCompensation_UpperMax"/>
<parameter id="Shiftregister_FixedEjectPosition_RelativeToROI"/>
<parameter id="Shiftregister_FixedStopPositionForFastProducts_RelativeToROI"/>
<parameter id="Shiftregister_GoodObjects"/>
<parameter id="Shiftregister_GoodObjectsFor"/>
<parameter id="Shiftregister_GoodObjects_Out"/>
<parameter id="Shiftregister_IImagePartsPerObject"/>
<parameter id="Shiftregister_IImagePartsPerObject_Out"/>
<parameter id="Shiftregister_IndicesInEjectBoxFound"/>
<parameter id="Shiftregister_NumberOfDetectionsLeadToEject_PerLinePerFeature"/>
<parameter id="Shiftregister_NumberOfObjetsLeadToEjectPerLine"/>
<parameter id="Shiftregister_ObjectMovement"/>
<parameter id="Shiftregister_ObjectMovement_MinSpeedToRegisterObjects"/>
<parameter id="Shiftregister_ObjectsPerTrack_LimitMax"/>
<parameter id="Shiftregister_Rebuild_Kill"/>
<parameter id="Shiftregister_RemoveBadRegionsInEjectBox"/>
<parameter id="Shiftregister_SaveMeasureFeatureGoodBadAtRuntime"/>
<parameter id="Shiftregister_SaveMeasureFeaturePartImagesAtRuntime"/>
<parameter id="Shiftregister_SaveMeasureFeatureRegionsAtRuntime"/>
<parameter id="Shiftregister_SaveMeasureFeatureValuesAtRuntime"/>
<parameter id="Shiftregister_Tuple_Data"/>
<parameter id="Shiftregister_Tuple_Data_Out"/>
<parameter id="Shiftregister_VImagePartsOffset_TRow_TColumn"/>
<parameter id="Shiftregister_VImagePartsOffset_TRow_TColumn_Out"/>
<parameter id="Shiftregister_VMeasureFeature_TResult_TValue"/>
<parameter id="Shiftregister_VMeasureFeature_TResult_TValue_Out"/>
<parameter id="Shiftregister_VMeasuredFeatures_IRegionPerFeature"/>
<parameter id="Shiftregister_VMeasuredFeatures_IRegionPerFeature_Out"/>
<parameter id="Tablet_Individual"/>
<parameter id="TimeNeeded"/>
</parameters>
</docu>
</procedure>
<procedure name="gShiftregister_OneLine_ResetData">
<interface>
<oo>
<par name="Shiftregister_BadObjects" base_type="iconic" dimension="0"/>
<par name="Shiftregister_GoodObjects" base_type="iconic" dimension="0"/>
<par name="ShiftRegister_ObjectsInLastFrame" base_type="iconic" dimension="0"/>
<par name="Shiftregister_AllObjectsMovementAdapted" base_type="iconic" dimension="0"/>
<par name="Shiftregister_VMeasuredFeatures_IRegionPerFeature" base_type="iconic" dimension="1"/>
<par name="Shiftregister_IImagePartsPerObject" base_type="iconic" dimension="1"/>
</oo>
<ic>
<par name="IRegionPerFeature_VectorLength" base_type="ctrl" dimension="0"/>
</ic>
<oc>
<par name="Shiftregister_VMeasureFeature_TResult_TValue" base_type="ctrl" dimension="2"/>
<par name="Shiftregister_VImagePartsOffset_TRow_TColumn" base_type="ctrl" dimension="1"/>
</oc>
</interface>
<body>
<c>* Reset all data that is carried in shiftregister.</c>
<c>* Data to be considered is tracking and detail data e.g.measured values, partimages,...</c>
<l>gen_empty_obj (EmptyObject)</l>
<c>* standard data</c>
<l>Shiftregister_BadObjects := EmptyObject</l>
<l>Shiftregister_GoodObjects := EmptyObject</l>
<l>Shiftregister_AllObjectsMovementAdapted := EmptyObject</l>
<l>ShiftRegister_ObjectsInLastFrame := EmptyObject</l>
<c>* extended data</c>
<l>Shiftregister_VMeasureFeature_TResult_TValue := {{[]}}</l>
<l>Shiftregister_VImagePartsOffset_TRow_TColumn := {[]}</l>
<l>Shiftregister_IImagePartsPerObject.at(0) := EmptyObject</l>
<c></c>
<l>for Index_Vector := 0 to IRegionPerFeature_VectorLength-1 by 1</l>
<l>    Shiftregister_VMeasuredFeatures_IRegionPerFeature.at(Index_Vector) := EmptyObject</l>
<l>endfor</l>
<c></c>
<l>return ()</l>
</body>
<docu id="gShiftregister_OneLine_ResetData">
<parameters>
<parameter id="IRegionPerFeature_VectorLength"/>
<parameter id="ShiftRegister_ObjectsInLastFrame"/>
<parameter id="Shiftregister_AllObjectsMovementAdapted"/>
<parameter id="Shiftregister_BadObjects"/>
<parameter id="Shiftregister_GoodObjects"/>
<parameter id="Shiftregister_IImagePartsPerObject"/>
<parameter id="Shiftregister_VImagePartsOffset_TRow_TColumn"/>
<parameter id="Shiftregister_VMeasureFeature_TResult_TValue"/>
<parameter id="Shiftregister_VMeasuredFeatures_IRegionPerFeature"/>
</parameters>
</docu>
</procedure>
<procedure name="gShiftRegister_RemoveDataFromLine">
<interface>
<io>
<par name="EjectROIs" base_type="iconic" dimension="0"/>
<par name="ImageOrig" base_type="iconic" dimension="0"/>
<par name="ShiftRegisterVector_Good_Bad_ObjectsLastFrame" base_type="iconic" dimension="3"/>
<par name="Shiftregister_VThread_VLane_IImagePartsPerObject" base_type="iconic" dimension="3"/>
<par name="Shiftregister_VThread_VLane_VMeasuredFeatures_IRegionPerFeature" base_type="iconic" dimension="3"/>
<par name="Shiftregister_VThread_VEjectROI_Adapted" base_type="iconic" dimension="2"/>
</io>
<oo>
<par name="ShiftRegisterVector_Good_Bad_ObjectsLastFrame_Out" base_type="iconic" dimension="3"/>
<par name="Shiftregister_VThread_VLane_IImagePartsPerObject_Out" base_type="iconic" dimension="3"/>
<par name="Shiftregister_VThread_VLane_VMeasuredFeatures_IRegionPerFeature_Out" base_type="iconic" dimension="3"/>
</oo>
<ic>
<par name="EjectROI_ToRemoveFrom" base_type="ctrl" dimension="0"/>
<par name="Shiftregister_EjectPositionMovementCompensationVector" base_type="ctrl" dimension="2"/>
<par name="LanesPerThreadsVector" base_type="ctrl" dimension="1"/>
<par name="Shiftregister_VThread_VLane_VMeasureFeature_TResult_TValue" base_type="ctrl" dimension="4"/>
<par name="Shiftregister_VThread_VLane_VImagePartsOffset_TRow_TColumn" base_type="ctrl" dimension="3"/>
<par name="Shiftregister_VThread_VLane_IndicesInEjectBoxFound" base_type="ctrl" dimension="2"/>
</ic>
<oc>
<par name="Time_Needed" base_type="ctrl" dimension="0"/>
<par name="Shiftregister_VThread_VLane_VMeasureFeature_TResult_TValue_Out" base_type="ctrl" dimension="4"/>
<par name="Shiftregister_VThread_VLane_VImagePartsOffset_TRow_TColumn_Out" base_type="ctrl" dimension="3"/>
</oc>
</interface>
<body>
<l>count_seconds (Seconds_Start)</l>
<c>* init the outputs</c>
<l>Shiftregister_VThread_VLane_IImagePartsPerObject_Out := Shiftregister_VThread_VLane_IImagePartsPerObject</l>
<l>Shiftregister_VThread_VLane_VMeasuredFeatures_IRegionPerFeature_Out := Shiftregister_VThread_VLane_VMeasuredFeatures_IRegionPerFeature</l>
<l>Shiftregister_VThread_VLane_VMeasureFeature_TResult_TValue_Out := Shiftregister_VThread_VLane_VMeasureFeature_TResult_TValue</l>
<l>Shiftregister_VThread_VLane_VImagePartsOffset_TRow_TColumn_Out := Shiftregister_VThread_VLane_VImagePartsOffset_TRow_TColumn</l>
<c></c>
<l>gFindTupleValuePositionsInVector (LanesPerThreadsVector, EjectROI_ToRemoveFrom, FoundVectorIndex, FoundTupleIndex)</l>
<c>* selection of standard eject box</c>
<l>* select_obj (EjectROIs, EjectROI_Selected, EjectROI_ToRemoveFrom+1)</l>
<c>* selection of adapted eject box</c>
<l>EjectROI_Selected := Shiftregister_VThread_VEjectROI_Adapted.at(FoundVectorIndex).at(FoundTupleIndex)</l>
<c></c>
<c>* generate speed compensated eject roi</c>
<l>smallest_rectangle1 (EjectROI_Selected, Row1, Column1, Row2, Column2)</l>
<l>CompensationValue := Shiftregister_EjectPositionMovementCompensationVector.at(FoundVectorIndex).at(FoundTupleIndex)</l>
<l>gen_rectangle1 (EjectROI_Selected_Compensated, Row1 - CompensationValue, Column1, Row2, Column2)</l>
<c>* select bad objects from vector</c>
<l>ShiftRegisterVector_Good_Bad_ObjectsLastFrame_local := ShiftRegisterVector_Good_Bad_ObjectsLastFrame.at(FoundVectorIndex).at(FoundTupleIndex)</l>
<c>* select from vector good, bad, objects last frame the data via at Index</c>
<l>Shiftregister_GoodObjects := ShiftRegisterVector_Good_Bad_ObjectsLastFrame_local.at(0)</l>
<l>Shiftregister_BadObjects := ShiftRegisterVector_Good_Bad_ObjectsLastFrame_local.at(1)</l>
<l>Shiftregister_LastFrameObjects := ShiftRegisterVector_Good_Bad_ObjectsLastFrame_local.at(2)</l>
<l>Shiftregister_AllObjectsMovementAdapted := ShiftRegisterVector_Good_Bad_ObjectsLastFrame_local.at(3)</l>
<c>* select errordetail related data</c>
<l>Shiftregister_IndicesInEjectBoxFound := Shiftregister_VThread_VLane_IndicesInEjectBoxFound.at(FoundVectorIndex).at(FoundTupleIndex)</l>
<l>Shiftregister_VMeasureFeature_TResult_TValue := Shiftregister_VThread_VLane_VMeasureFeature_TResult_TValue.at(FoundVectorIndex).at(FoundTupleIndex)</l>
<l>Shiftregister_VImagePartsOffset_TRow_TColumn := Shiftregister_VThread_VLane_VImagePartsOffset_TRow_TColumn.at(FoundVectorIndex).at(FoundTupleIndex)</l>
<l>Shiftregister_IImagePartsPerObject := Shiftregister_VThread_VLane_IImagePartsPerObject.at(FoundVectorIndex).at(FoundTupleIndex)</l>
<l>Shiftregister_VMeasuredFeatures_IRegionPerFeature := Shiftregister_VThread_VLane_VMeasuredFeatures_IRegionPerFeature.at(FoundVectorIndex).at(FoundTupleIndex)</l>
<c></c>
<l>Debug := 0</l>
<l>if (Debug  = 1)</l>
<l>    Shiftregister_VMeasureFeature_TResult_TValue_NumberOfMeasures := |Shiftregister_VMeasureFeature_TResult_TValue.at(0).at(0)|</l>
<l>    Shiftregister_IndicesInEjectBoxFound_Number :=|Shiftregister_IndicesInEjectBoxFound|</l>
<l>    NumberOfMeasuresAfterCorrection := Shiftregister_VMeasureFeature_TResult_TValue_NumberOfMeasures - Shiftregister_IndicesInEjectBoxFound_Number</l>
<l>endif </l>
<c>** new approach from shiftregister</c>
<l>gShiftregister_RemoveDataFromVector (Shiftregister_IImagePartsPerObject, Shiftregister_VMeasuredFeatures_IRegionPerFeature, Shiftregister_IImagePartsPerObject_Out, Shiftregister_VMeasuredFeatures_IRegionPerFeature_Out, Shiftregister_IndicesInEjectBoxFound+1, Shiftregister_VMeasureFeature_TResult_TValue, Shiftregister_VImagePartsOffset_TRow_TColumn, Shiftregister_VMeasureFeature_TResult_TValue_Out, Shiftregister_VImagePartsOffset_TRow_TColumn_Out)</l>
<l>gShiftregister_DetermineAndRemoveRegionsInEjectBox (EjectROI_Selected, Shiftregister_BadObjects, Shiftregister_BadObjects_Out, [], _)</l>
<l>gShiftregister_DetermineAndRemoveRegionsInEjectBox (EjectROI_Selected, Shiftregister_GoodObjects, Shiftregister_GoodObjects_Out, [], _)</l>
<l>gShiftregister_DetermineAndRemoveRegionsInEjectBox (EjectROI_Selected, Shiftregister_AllObjectsMovementAdapted, Shiftregister_AllObjectsMovementAdapted_Out, [], IndicesForRemoval)</l>
<l>gShiftregister_DetermineAndRemoveRegionsInEjectBox (EjectROI_Selected, Shiftregister_LastFrameObjects, Shiftregister_LastFrameObjects_Out, [], IndicesForRemoval)</l>
<c></c>
<c>* old approach</c>
<l>* ShiftRegister_RemoveBadObjectsOfLine (ImageOrig, EjectROI_Selected_Compensated, Shiftregister_BadObjects, Shiftregister_GoodObjects, Shiftregister_LastFrameObjects, Shiftregister_AllObjectsMovementAdapted, Shiftregister_IImagePartsPerObject, Shiftregister_VMeasuredFeatures_IRegionPerFeature, Shiftregister_BadObjects_Out, Shiftregister_GoodObjects_Out, Shiftregister_LastFrameObjects_Out, Shiftregister_AllObjectsMovementAdapted_Out, Shiftregister_IImagePartsPerObject_Out, Shiftregister_VMeasuredFeatures_IRegionPerFeature_Out, Shiftregister_VMeasureFeature_TResult_TValue, Shiftregister_VImagePartsOffset_TRow_TColumn, Shiftregister_IndicesInEjectBoxFound, Shiftregister_VMeasureFeature_TResult_TValue_Out, Shiftregister_VImagePartsOffset_TRow_TColumn_Out)</l>
<c></c>
<l>if (Debug  = 1)</l>
<l>    Shiftregister_VMeasureFeature_TResult_TValue_NumberOfMeasures_Out := |Shiftregister_VMeasureFeature_TResult_TValue_Out.at(0).at(0)|</l>
<l>* stop()</l>
<l>endif</l>
<c>* write data into outputvector again</c>
<l>Shiftregister_VThread_VLane_VMeasureFeature_TResult_TValue_Out.at(FoundVectorIndex).at(FoundTupleIndex) := Shiftregister_VMeasureFeature_TResult_TValue_Out</l>
<l>Shiftregister_VThread_VLane_VImagePartsOffset_TRow_TColumn_Out.at(FoundVectorIndex).at(FoundTupleIndex) := Shiftregister_VImagePartsOffset_TRow_TColumn_Out</l>
<l>Shiftregister_VThread_VLane_IImagePartsPerObject_Out.at(FoundVectorIndex).at(FoundTupleIndex) :=  Shiftregister_IImagePartsPerObject_Out</l>
<l>Shiftregister_VThread_VLane_VMeasuredFeatures_IRegionPerFeature_Out.at(FoundVectorIndex).at(FoundTupleIndex) := Shiftregister_VMeasuredFeatures_IRegionPerFeature_Out</l>
<l>ShiftRegisterVector_Good_Bad_ObjectsLastFrame_Out := ShiftRegisterVector_Good_Bad_ObjectsLastFrame</l>
<c></c>
<l>gen_empty_obj (EmptyObject)</l>
<l>ShiftRegisterVector_Good_Bad_ObjectsLastFrame_Out.at(FoundVectorIndex).at(FoundTupleIndex).at(0) := Shiftregister_GoodObjects_Out</l>
<l>ShiftRegisterVector_Good_Bad_ObjectsLastFrame_Out.at(FoundVectorIndex).at(FoundTupleIndex).at(1):=EmptyObject</l>
<l>ShiftRegisterVector_Good_Bad_ObjectsLastFrame_Out.at(FoundVectorIndex).at(FoundTupleIndex).at(1) := Shiftregister_BadObjects_Out</l>
<l>ShiftRegisterVector_Good_Bad_ObjectsLastFrame_Out.at(FoundVectorIndex).at(FoundTupleIndex).at(2) := Shiftregister_LastFrameObjects_Out</l>
<l>ShiftRegisterVector_Good_Bad_ObjectsLastFrame_Out.at(FoundVectorIndex).at(FoundTupleIndex).at(3) := Shiftregister_AllObjectsMovementAdapted_Out</l>
<l>count_seconds (Seconds_End)</l>
<l>Time_Needed := (Seconds_End - Seconds_Start) * 1000</l>
<l>return ()</l>
</body>
<docu id="gShiftRegister_RemoveDataFromLine">
<parameters>
<parameter id="EjectROI_ToRemoveFrom"/>
<parameter id="EjectROIs"/>
<parameter id="ImageOrig"/>
<parameter id="LanesPerThreadsVector"/>
<parameter id="ShiftRegisterVector_Good_Bad_ObjectsLastFrame"/>
<parameter id="ShiftRegisterVector_Good_Bad_ObjectsLastFrame_Out"/>
<parameter id="Shiftregister_EjectPositionMovementCompensationVector"/>
<parameter id="Shiftregister_VThread_VEjectROI_Adapted"/>
<parameter id="Shiftregister_VThread_VLane_IImagePartsPerObject"/>
<parameter id="Shiftregister_VThread_VLane_IImagePartsPerObject_Out"/>
<parameter id="Shiftregister_VThread_VLane_IndicesInEjectBoxFound"/>
<parameter id="Shiftregister_VThread_VLane_VImagePartsOffset_TRow_TColumn"/>
<parameter id="Shiftregister_VThread_VLane_VImagePartsOffset_TRow_TColumn_Out"/>
<parameter id="Shiftregister_VThread_VLane_VMeasureFeature_TResult_TValue"/>
<parameter id="Shiftregister_VThread_VLane_VMeasureFeature_TResult_TValue_Out"/>
<parameter id="Shiftregister_VThread_VLane_VMeasuredFeatures_IRegionPerFeature"/>
<parameter id="Shiftregister_VThread_VLane_VMeasuredFeatures_IRegionPerFeature_Out"/>
<parameter id="Time_Needed"/>
</parameters>
</docu>
</procedure>
<procedure name="gShiftregister_RemoveDataFromVector">
<interface>
<io>
<par name="Shiftregister_IImagePartsPerObject" base_type="iconic" dimension="1"/>
<par name="Shiftregister_VMeasuredFeatures_IRegionPerFeature" base_type="iconic" dimension="1"/>
</io>
<oo>
<par name="Shiftregister_IImagePartsPerObject_Out" base_type="iconic" dimension="1"/>
<par name="Shiftregister_VMeasuredFeatures_IRegionPerFeature_Out" base_type="iconic" dimension="1"/>
</oo>
<ic>
<par name="IndicesToRemove" base_type="ctrl" dimension="0"/>
<par name="Shiftregister_VMeasureFeature_TResult_TValue" base_type="ctrl" dimension="2"/>
<par name="Shiftregister_VImagePartsOffset_TRow_Tcolumn" base_type="ctrl" dimension="1"/>
</ic>
<oc>
<par name="Shiftregister_VMeasureFeature_TResult_TValue_Out" base_type="ctrl" dimension="2"/>
<par name="Shiftregister_VImagePartsOffset_TRow_TColumn_Out" base_type="ctrl" dimension="1"/>
</oc>
</interface>
<body>
<c>* vector dimension 1</c>
<l>Shiftregister_IImagePartsPerObject_Out := Shiftregister_IImagePartsPerObject</l>
<l>Shiftregister_VImagePartsOffset_TRow_TColumn_Out := Shiftregister_VImagePartsOffset_TRow_Tcolumn</l>
<l>Shiftregister_VMeasuredFeatures_IRegionPerFeature_Out := Shiftregister_VMeasuredFeatures_IRegionPerFeature</l>
<c>* vector dimension 2</c>
<l>Shiftregister_VMeasureFeature_TResult_TValue_Out := Shiftregister_VMeasureFeature_TResult_TValue</l>
<c>******************************************************************************************************************</c>
<c></c>
<l>if (IndicesToRemove # [])</l>
<l>    tuple_sort (IndicesToRemove, IndicesToRemove) // due to the vector is directly shortened it is done from the biggest value to the smallest value</l>
<l>    tuple_length (IndicesToRemove, IndicesToRemove_Length)</l>
<c>    * get the inverted Indices to remove first- needed for later object selection</c>
<l>    if (Shiftregister_VImagePartsOffset_TRow_TColumn_Out.at(0) = []) // in case image storing s switched of use the region length        </l>
<l>        count_obj (Shiftregister_VMeasuredFeatures_IRegionPerFeature_Out.at(0), NumberOfElementsInVector)</l>
<l>    else    </l>
<l>        NumberOfElementsInVector := Shiftregister_VImagePartsOffset_TRow_TColumn_Out.length()</l>
<l>    endif</l>
<l>*     stop()</l>
<l>    tuple_gen_const (NumberOfElementsInVector, 1, IndicesToRemove_Inverted)   </l>
<l>    tuple_cumul (IndicesToRemove_Inverted, IndicesToRemove_Inverted)   </l>
<l>    tuple_remove (IndicesToRemove_Inverted, (IndicesToRemove-1), IndicesToRemove_Inverted)</l>
<c>    * now truncate data</c>
<c>    * start in downcounting loop for element indices that will be removed</c>
<c>    * skip if empty- in this case feature is switched of</c>
<l>    count_obj (Shiftregister_IImagePartsPerObject_Out.at(0), FeatureIsActive)</l>
<l>    if (FeatureIsActive &gt;= 1)</l>
<l>        for IndexRemoval := IndicesToRemove_Length-1 to 0 by -1</l>
<l>            CurrentIndexToRemove := IndicesToRemove[IndexRemoval]-1</l>
<l>            Shiftregister_IImagePartsPerObject_Out.remove(CurrentIndexToRemove)</l>
<l>            Shiftregister_VImagePartsOffset_TRow_TColumn_Out.remove(CurrentIndexToRemove)</l>
<l>        endfor   </l>
<l>    endif</l>
<c></c>
<c>   * and a normal counting loop counting over vector elements </c>
<l>   Vector2DimLength := Shiftregister_VMeasureFeature_TResult_TValue_Out.length()</l>
<l>   for IndexVector2Dim := 0 to Vector2DimLength-1 by 1</l>
<c>       * now do the tuple selection</c>
<l>       Tempvector1Dim_1 := Shiftregister_VMeasureFeature_TResult_TValue_Out.at(IndexVector2Dim)</l>
<l>       Tempvector1Dim_Length := Tempvector1Dim_1.length()</l>
<l>       for IndexTempVector1Dim := 0 to Tempvector1Dim_Length-1 by 1</l>
<l>           TempTuple := Tempvector1Dim_1.at(IndexTempVector1Dim) </l>
<l>           tuple_remove (TempTuple, (IndicesToRemove-1), TempTuple)</l>
<l>           Tempvector1Dim_1.at(IndexTempVector1Dim) := TempTuple</l>
<l>       endfor</l>
<l>       Shiftregister_VMeasureFeature_TResult_TValue_Out.at(IndexVector2Dim) := Tempvector1Dim_1</l>
<c>       * now do the iconic selection</c>
<l>       LengthVector := Shiftregister_VMeasuredFeatures_IRegionPerFeature_Out.length()</l>
<c>       </c>
<l>        if (IndexVector2Dim &gt;= LengthVector) // in case there is no iconic data</l>
<l>            continue</l>
<l>        endif      </l>
<l>        select_obj (Shiftregister_VMeasuredFeatures_IRegionPerFeature_Out.at(IndexVector2Dim), Shiftregister_VMeasuredFeatures_IRegionPerFeature_Out.at(IndexVector2Dim), IndicesToRemove_Inverted)    </l>
<l>   endfor</l>
<l>endif</l>
<l>* InTest := Shiftregister_VMeasureFeature_TResult_TValue.at(0).at(1)</l>
<l>* OutTest := Shiftregister_VMeasureFeature_TResult_TValue_Out.at(0).at(1)</l>
<c></c>
<l>return ()</l>
</body>
<docu id="gShiftregister_RemoveDataFromVector">
<parameters>
<parameter id="IndicesToRemove"/>
<parameter id="Shiftregister_IImagePartsPerObject"/>
<parameter id="Shiftregister_IImagePartsPerObject_Out"/>
<parameter id="Shiftregister_VImagePartsOffset_TRow_TColumn_Out"/>
<parameter id="Shiftregister_VImagePartsOffset_TRow_Tcolumn"/>
<parameter id="Shiftregister_VMeasureFeature_TResult_TValue"/>
<parameter id="Shiftregister_VMeasureFeature_TResult_TValue_Out"/>
<parameter id="Shiftregister_VMeasuredFeatures_IRegionPerFeature"/>
<parameter id="Shiftregister_VMeasuredFeatures_IRegionPerFeature_Out"/>
</parameters>
</docu>
</procedure>
<procedure name="gShiftregister_ReorderRegionsAfterMoving">
<interface>
<io>
<par name="Shiftregister_GoodObjects_Repositioned" base_type="iconic" dimension="0"/>
</io>
<oo>
<par name="Shiftregister_GoodObjects_Out" base_type="iconic" dimension="0"/>
<par name="ObjectSelected" base_type="iconic" dimension="0"/>
</oo>
<ic>
<par name="IndexOrder_Good" base_type="ctrl" dimension="0"/>
</ic>
<oc>
<par name="Index_Order_Cnt" base_type="ctrl" dimension="0"/>
<par name="Index_Found" base_type="ctrl" dimension="0"/>
</oc>
</interface>
<body>
<c>* after all objects were moved the indices are wrong- reorder in relation to original index order</c>
<l>gen_empty_obj (Shiftregister_GoodObjects_Out)</l>
<c></c>
<c>* in case there is an index missing in tuple use only available indices</c>
<l>tuple_sort (IndexOrder_Good, IndicesAvailable)</l>
<c></c>
<l>for Index_Order_Cnt := 0 to |IndexOrder_Good|-1 by 1</l>
<l>    testt := IndicesAvailable[Index_Order_Cnt]</l>
<l>    tuple_find_first (IndexOrder_Good, IndicesAvailable[Index_Order_Cnt], Index_Found)</l>
<l>*     if (Index_Found = -1)</l>
<l>*         stop()</l>
<l>*     endif</l>
<l>    select_obj (Shiftregister_GoodObjects_Repositioned, ObjectSelected, Index_Found +1)</l>
<l>    concat_obj (Shiftregister_GoodObjects_Out, ObjectSelected, Shiftregister_GoodObjects_Out)</l>
<l>endfor</l>
<l>return ()</l>
</body>
<docu id="gShiftregister_ReorderRegionsAfterMoving">
<parameters>
<parameter id="IndexOrder_Good"/>
<parameter id="Index_Found"/>
<parameter id="Index_Order_Cnt"/>
<parameter id="ObjectSelected"/>
<parameter id="Shiftregister_GoodObjects_Out"/>
<parameter id="Shiftregister_GoodObjects_Repositioned"/>
</parameters>
</docu>
</procedure>
<procedure name="gShiftregister_SelectErrorDataSubset_Iconic">
<interface>
<io>
<par name="VectorDataToSelectFrom" base_type="iconic" dimension="1"/>
</io>
<oo>
<par name="VectorDataSelection" base_type="iconic" dimension="1"/>
</oo>
<ic>
<par name="IndicesToSelect" base_type="ctrl" dimension="0"/>
</ic>
</interface>
<body>
<c>* now sort the vectordata so output is vector data just for one line</c>
<l>gen_empty_obj (EmptyObject)</l>
<l>VectorDataSelection.at(0) := EmptyObject</l>
<l>for IndexLoop := 0 to |IndicesToSelect|-1 by 1</l>
<l>    CurrentIndiceToSelect := IndicesToSelect[IndexLoop]</l>
<c>    *** Janine - Exception topic</c>
<l>    if (CurrentIndiceToSelect &lt; VectorDataToSelectFrom.length())</l>
<l>        VectorDataSelection.at(IndexLoop) := VectorDataToSelectFrom.at(CurrentIndiceToSelect)</l>
<l>    else</l>
<l>        VectorDataSelection := {}</l>
<l>        VectorDataSelection.clear()</l>
<l>    endif</l>
<l>*     VectorDataSelection.at(IndexLoop) := VectorDataToSelectFrom.at(CurrentIndiceToSelect)</l>
<c>    *** End Janine - Exception topic</c>
<l>endfor</l>
<l>return ()</l>
</body>
<docu id="gShiftregister_SelectErrorDataSubset_Iconic">
<parameters>
<parameter id="IndicesToSelect"/>
<parameter id="VectorDataSelection"/>
<parameter id="VectorDataToSelectFrom"/>
</parameters>
</docu>
</procedure>
<procedure name="gShiftregister_SelectErrorDataSubset_Vector1Dim_Iconic">
<interface>
<io>
<par name="VectorDataToSelectFrom" base_type="iconic" dimension="1"/>
</io>
<oo>
<par name="VectorDataSelection" base_type="iconic" dimension="1"/>
</oo>
<ic>
<par name="IndicesToSelect" base_type="ctrl" dimension="0"/>
</ic>
</interface>
<body>
<c>* now sort the vectordata so output is vector data just for the selected indices (one line)</c>
<l>gen_empty_obj (VectorDataSelection.at(0))</l>
<l>tuple_length (IndicesToSelect, IndicesToSelect_Length)</l>
<l>VectorDataToSelectFrom_Length := VectorDataToSelectFrom.length()</l>
<l>for IndexVectorDataToSelectFrom := 0 to VectorDataToSelectFrom_Length-1 by 1</l>
<l>    VectorDataSubset := VectorDataToSelectFrom.at(IndexVectorDataToSelectFrom)</l>
<c>   *** Janine - Exception topic</c>
<l>    count_obj (VectorDataSubset, Number)</l>
<l>    test := IndicesToSelect[|IndicesToSelect|-1]</l>
<l>    if (Number &gt; IndicesToSelect[|IndicesToSelect|-1])</l>
<l>        select_obj (VectorDataSubset, SelectedVectorDataSubset, IndicesToSelect+1)</l>
<l>    else</l>
<l>        gen_empty_obj (SelectedVectorDataSubset)</l>
<l>    endif</l>
<l>    *     select_obj (VectorDataSubset, SelectedVectorDataSubset, IndicesToSelect+1)</l>
<c>    *** End Janine - Exception topic</c>
<l>   VectorDataSelection.at(IndexVectorDataToSelectFrom) := SelectedVectorDataSubset</l>
<l>endfor</l>
<c></c>
<l>return ()</l>
</body>
<docu id="gShiftregister_SelectErrorDataSubset_Vector1Dim_Iconic">
<parameters>
<parameter id="IndicesToSelect"/>
<parameter id="VectorDataSelection"/>
<parameter id="VectorDataToSelectFrom"/>
</parameters>
</docu>
</procedure>
<procedure name="gShiftregister_SelectErrorDataSubset_Vector1Dim_Tuple">
<interface>
<ic>
<par name="IndicesToSelect" base_type="ctrl" dimension="0"/>
<par name="VectorDataToSelectFrom" base_type="ctrl" dimension="1"/>
</ic>
<oc>
<par name="VectorDataSelection" base_type="ctrl" dimension="1"/>
</oc>
</interface>
<body>
<c>* now sort the vectordata so output is vector data just for one line</c>
<l>VectorDataSelection.at(0) := []</l>
<l>gen_empty_obj (EmptyObject)</l>
<l>tuple_length (IndicesToSelect, IndicesToSelect_Length)</l>
<l>for IndexLoop := 0 to IndicesToSelect_Length-1 by 1</l>
<l>    CurrentIndiceToSelect := IndicesToSelect[IndexLoop]</l>
<c>    *** Janine - Exception topic</c>
<l>    test := VectorDataToSelectFrom.length()</l>
<l>    if (CurrentIndiceToSelect &lt; VectorDataToSelectFrom.length())</l>
<l>        VectorDataSelection.at(IndexLoop) := VectorDataToSelectFrom.at(CurrentIndiceToSelect)</l>
<l>    else</l>
<l>        VectorDataSelection := {}</l>
<l>        VectorDataSelection.clear()</l>
<l>    endif</l>
<l>*     VectorDataSelection.at(IndexLoop) := VectorDataToSelectFrom.at(CurrentIndiceToSelect)</l>
<c>    *** End Janine - Exception topic</c>
<c>    </c>
<l>endfor</l>
<l>return ()</l>
</body>
<docu id="gShiftregister_SelectErrorDataSubset_Vector1Dim_Tuple">
<parameters>
<parameter id="IndicesToSelect"/>
<parameter id="VectorDataSelection"/>
<parameter id="VectorDataToSelectFrom"/>
</parameters>
</docu>
</procedure>
<procedure name="gShiftregister_SelectErrorDataSubset_Vector2Dim_Tuple">
<interface>
<ic>
<par name="IndicesToSelect" base_type="ctrl" dimension="0"/>
<par name="VectorDataToSelectFrom" base_type="ctrl" dimension="2"/>
</ic>
<oc>
<par name="VectorDataSelection" base_type="ctrl" dimension="2"/>
</oc>
</interface>
<body>
<c>* now sort the vectordata so output is vector data just for one line</c>
<l>VectorDataSelection.at(0) := {[],[]}</l>
<l>VectorFeatureLength := VectorDataToSelectFrom.length()</l>
<c></c>
<l>for IndexLoop := 0 to VectorFeatureLength-1 by 1</l>
<l>    VectorDataSelection.at(IndexLoop).at(0) := VectorDataToSelectFrom.at(IndexLoop).at(0)[IndicesToSelect]</l>
<l>    VectorDataSelection.at(IndexLoop).at(1) := VectorDataToSelectFrom.at(IndexLoop).at(1)[IndicesToSelect]</l>
<l>    if ( IndexLoop = 0 )</l>
<l>        if ( VectorDataToSelectFrom.at(IndexLoop).at(2) = [])</l>
<l>            VectorDataSelection.at(IndexLoop).at(2) := []</l>
<l>        else</l>
<l>            VectorDataSelection.at(IndexLoop).at(2) := VectorDataToSelectFrom.at(IndexLoop).at(2)[0]</l>
<l>        endif</l>
<l>    endif</l>
<l>endfor</l>
<c></c>
<l>return ()</l>
</body>
<docu id="gShiftregister_SelectErrorDataSubset_Vector2Dim_Tuple">
<parameters>
<parameter id="IndicesToSelect"/>
<parameter id="VectorDataSelection"/>
<parameter id="VectorDataToSelectFrom"/>
</parameters>
</docu>
</procedure>

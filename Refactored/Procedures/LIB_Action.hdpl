<?xml version="1.0" encoding="UTF-8"?>
<hdevelop file_version="1.2" halcon_version="25.11.0.0">
<library/>
<procedure name="Append_Images_ToVector">
<interface>
<io>
<par name="Image" base_type="iconic" dimension="0"/>
</io>
<ic>
<par name="CameraId" base_type="ctrl" dimension="0"/>
<par name="CollectProcessImages" base_type="ctrl" dimension="0"/>
</ic>
<oc>
<par name="NumberOfImagesInBuffer" base_type="ctrl" dimension="0"/>
<par name="TimeNeeded" base_type="ctrl" dimension="0"/>
</oc>
</interface>
<body>
<l>global object vector(2) gCountercheckimages</l>
<l>NumberOfImagesInBuffer := []</l>
<l>TimeNeeded := []</l>
<c></c>
<l>if(CollectProcessImages = 0)</l>
<l>    return()</l>
<l>endif</l>
<c></c>
<l>count_seconds (Seconds_Start)</l>
<l>NumberOfImagesInBuffer := gCountercheckimages.at(CameraId).length()</l>
<l>if (NumberOfImagesInBuffer = 1)</l>
<l>    CheckIfSeroImage := gCountercheckimages.at(CameraId).at(0)</l>
<l>    get_image_size (CheckIfSeroImage, Width, Height)</l>
<l>    if (Width = [])</l>
<l>        gCountercheckimages.at(CameraId).at(0) := Image</l>
<l>        NumberOfImagesInBuffer := 1</l>
<l>    else</l>
<l>        gCountercheckimages.at(CameraId).at(NumberOfImagesInBuffer) := Image</l>
<l>        NumberOfImagesInBuffer := 2</l>
<l>    endif</l>
<l>else</l>
<l>    gCountercheckimages.at(CameraId).at(NumberOfImagesInBuffer) := Image</l>
<l>    NumberOfImagesInBuffer := NumberOfImagesInBuffer +1</l>
<l>endif</l>
<l>count_seconds (Seconds_End)</l>
<c></c>
<l>TimeNeeded := (Seconds_End-Seconds_Start) * 1000.0</l>
<c>* </c>
<l>return ()</l>
</body>
<docu id="Append_Images_ToVector">
<parameters>
<parameter id="CameraId"/>
<parameter id="CollectProcessImages"/>
<parameter id="Image"/>
<parameter id="NumberOfImagesInBuffer"/>
<parameter id="TimeNeeded"/>
</parameters>
</docu>
</procedure>
<procedure name="CriticalInspectionResultFound_Check">
<interface>
<ic>
<par name="Shiftregister_CriticalInspectionResultFoundPerLine_Vector" base_type="ctrl" dimension="1"/>
</ic>
<oc>
<par name="Shiftregister_CriticalInspectionResultFound" base_type="ctrl" dimension="0"/>
</oc>
</interface>
<body>
<l>Shiftregister_CriticalInspectionResultFound := 0</l>
<c></c>
<l>convert_vector_to_tuple (Shiftregister_CriticalInspectionResultFoundPerLine_Vector, Shiftregister_CriticalInspectionResultFoundPerLine)</l>
<l>tuple_sum (Shiftregister_CriticalInspectionResultFoundPerLine, Shiftregister_CriticalInspectionResultFoundPerLine_Sum)</l>
<l>if (Shiftregister_CriticalInspectionResultFoundPerLine_Sum &gt;=1)</l>
<l>    Shiftregister_CriticalInspectionResultFound:=1</l>
<l>endif</l>
<l>return ()</l>
</body>
<docu id="CriticalInspectionResultFound_Check">
<parameters>
<parameter id="Shiftregister_CriticalInspectionResultFound"/>
<parameter id="Shiftregister_CriticalInspectionResultFoundPerLine_Vector"/>
</parameters>
</docu>
</procedure>
<procedure name="doActionBV">
<interface>
<io>
<par name="Image" base_type="iconic" dimension="0"/>
<par name="ThreadUpstreamResults" base_type="iconic" dimension="1"/>
</io>
<ic>
<par name="ThreadId" base_type="ctrl" dimension="0"/>
<par name="CameraId" base_type="ctrl" dimension="0"/>
<par name="GrabImageMetaData" base_type="ctrl" dimension="0"/>
</ic>
<oc>
<par name="TimeNeeded" base_type="ctrl" dimension="0"/>
<par name="TimeMeasure_ColletedResults" base_type="ctrl" dimension="1"/>
</oc>
</interface>
<body>
<l>global tuple gProductionLoopCounter</l>
<l>global tuple gWorkOnFramegrabber_Enable</l>
<l>global tuple gStopAtProcess</l>
<l>global tuple gLocalCameraNumberUsed</l>
<l>global tuple gUseCameraIOsAsDirectEjectSignals</l>
<l>global tuple gMachineEnableInspectionSignal_RunProductionDirectly</l>
<l>global tuple gPLC_PulsingmodeConveyorDrive</l>
<l>global tuple gPLC_ErrorEjectCountercheckRetriesValue</l>
<l>global tuple gSystemDebugEjectAndStopOverride</l>
<l>global tuple gErrorDetails_MaxNumberToStoreOnDisk</l>
<l>global tuple gVisuDevWindowOrNonDevWindow</l>
<l>global tuple gStopProcessingExit</l>
<l>global tuple vector(1) gVisuImageGernarationMode</l>
<c></c>
<c></c>
<c></c>
<c></c>
<l>* global tuple gShiftregister_NumberOfErrorsForEjectMin</l>
<l>global tuple gInternalThreading</l>
<l>global tuple vector(1) gProcessingLoopcounter</l>
<l>global tuple vector(1) gWindowVector</l>
<l>global object vector(1) gRinnenROIs</l>
<l>global object vector(1) gEjectROIs</l>
<l>global tuple vector(1) gAcqHandle</l>
<l>global tuple vector(1) gPLC_CommunicationSocket</l>
<c></c>
<l>global tuple vector(1) gLanesPerThreadsVector</l>
<l>global tuple vector(1) gPLCWatchdogSignal</l>
<c></c>
<l>global object vector(2) gCountercheckimages</l>
<l>global tuple gProcessingMode</l>
<l>global tuple vector(1) gProcessingModeInLastFrame</l>
<l>global tuple gDebugCollectProcessimagesOnCameraOne</l>
<l>global tuple gCollectProcessImages</l>
<l>global tuple gProductCounterGood</l>
<l>global tuple gProductCounterBad</l>
<c></c>
<c></c>
<l>global tuple gEjectQueueRecentlyResetted</l>
<l>global tuple vector(1) gEjectQueue</l>
<c></c>
<l>global tuple gColourClassificationHandle</l>
<c></c>
<l>global tuple dict_Mode</l>
<l>global tuple dict_Shiftregister</l>
<c></c>
<l>global tuple dict_MachineState</l>
<c></c>
<l>global tuple vector(3) gCalibration_VTCamera_VTLane_VTPixToMM_XY</l>
<c></c>
<c>* Shiftregister</c>
<l>global tuple vector(1) gShiftregister_EjectObjectInMovementUncompensatedEjectFound_Vector</l>
<l>global tuple vector(1) gShiftregister_EjectFoundPerLine_Vector  // neu</l>
<l>global tuple vector(1) gShiftregister_EjectGoodFoundPerLine_Vector // neu</l>
<c></c>
<c></c>
<c></c>
<l>global tuple vector(2) gShiftregister_RebuildDataVector</l>
<l>global tuple vector(2) gProcessingTime_VCamera_VThread_TTime</l>
<c></c>
<l>global object vector(2) gImageOrigGrabbed_LastFrame // neu</l>
<c></c>
<l>global tuple vector(3) gShiftregisterVector_ObjectMovement_Thread_CameraVector</l>
<l>global tuple vector(3) gShiftregister_EjectPositionMovementCompensationVector</l>
<l>global tuple vector(3) gCalibration_VTCamera_VTLane_VTPixToMM_XY</l>
<c></c>
<l>global object vector(3) gGoodObjectVector_TabletIndividual_WidthGood_ThreadVector   // neu</l>
<l>global object vector(3) gErrorObjectVector_Colour_Width_Diameter_Spots_Area_Length_ThreadVector   // neu</l>
<c></c>
<l>global object vector(4) gShiftRegisterVector_Good_Bad_ObjectsLastFrame_Thread_CameraVector</l>
<l>global tuple vector(4) gErrorDetailsToStore_VCamera_VError_VMeasureFeature_TResult_TValue_TTime</l>
<l>global object vector(4) gShiftregister_VCamera_VThread_VLane_IImagePartsPerObject </l>
<l>global tuple vector(4) gShiftregister_VCamera_VThread_VLane_VImagePartsOffset_TRow_TColumn</l>
<l>global object vector(4) gShiftregister_VCamera_VThread_VLane_VMeasuredFeatures_IRegionPerFeature</l>
<c></c>
<l>global object vector(5) gShiftregister_Iconic_Cameras_Threads_Lanes_Data</l>
<l>global tuple vector(5) gShiftregister_Tuple_Cameras_Threads_Lanes_Data</l>
<l>global tuple vector(5) gShiftregister_VCamera_VThread_VLane_VMeasureFeature_TResult_TValue</l>
<c>    </c>
<c></c>
<l>PauseAfterVisualisationInMS := 100</l>
<c></c>
<l>count_seconds (TimeStamp_StartActionBV)</l>
<l>TimeStamp_BeforeProcessing := -1</l>
<l>TimeStamp_AfterProcessing := -1</l>
<l>Calculation_Colour_Mean_Red_Vector :={}</l>
<l>Calculation_Colour_Mean_Green_Vector :={}</l>
<l>Calculation_Colour_Mean_Blue_Vector :={}</l>
<l>Calculation_Width_Vector :={}</l>
<l>Calculation_Length_Vector :={}</l>
<l>* Calculation_Diameter_Vector :={}</l>
<l>Calculation_Area_Vector:={}</l>
<c></c>
<c></c>
<c></c>
<l>TeachInMode := 0</l>
<c></c>
<l>if (dict_Mode.V_SystemDebugEjectAndStopOverride.Value)</l>
<l>    gPLCDebugMode := 1  // todo: gPLCDebugMode wieder einfügen</l>
<l>endif</l>
<c></c>
<l>TimeMeasure_ColletedResults := {[]}</l>
<c>* </c>
<l>gDebug_StopOptions_Counterbased ([], [], [], [], DebugProcessingCounter)</l>
<c></c>
<c></c>
<c></c>
<l>WriteInVectorBufferedImagesToDisk (CameraId)</l>
<c></c>
<l>if(gWorkOnFramegrabber_Enable and gDebugCollectProcessimagesOnCameraOne &gt; 0) // and gLocalCameraNumberUsed = 0) </l>
<l>    gCollectProcessImages := 1</l>
<l>    if(gDebugCollectProcessimagesOnCameraOne = gCountercheckimages.at(CameraId).length())</l>
<l>        gStopProcessingExit := 1</l>
<l>    endif</l>
<l>endif</l>
<l>NumberofCountercheckimages := gCountercheckimages.at(CameraId).length()</l>
<l>if (NumberofCountercheckimages &gt;= 1500)</l>
<l>    CollectProcessImages := 0</l>
<l>else</l>
<l>  CollectProcessImages := gCollectProcessImages </l>
<l>endif</l>
<c>* </c>
<l>ProcessingThread := ThreadId</l>
<l>ExternalHardware_ConveyorDriveSlowly := 0</l>
<c></c>
<l>Shiftregister_TriggerVector_Rebuild_Kill := [0,-1]</l>
<l>Shiftregister_NumberOfErrorsForEjectMin := dict_Shiftregister.V_NumberOfErrorsForEjectMin.Value</l>
<c></c>
<c></c>
<c>* check which processing mode should be used. 1- normal processing. 2- countercheck action. 3- reset to normal processing</c>
<l>switch (gProcessingMode)</l>
<l>case 1:</l>
<c>    * at the end of the slow down phase for products on conveyor generate signal to remove regions from eject</c>
<l>    Shiftregister_RemoveBadRegionsInEjectBox := 0</l>
<l>*     ExternalHardware_MachineState (gMachineState_Vector, [], [], gMachineState_Vector, CurrentMachineState, CurrentMachineAction, CurrentMachineStateKeys, CurrentMachineValues)</l>
<c></c>
<l>    CurrentMachineState := dict_MachineState.CurrentMachineState</l>
<c></c>
<c>    * in case system is stopped completely start it</c>
<l>    if (CurrentMachineState[0] = 0)</l>
<l>        ExternalHardware_MachineState_dict ([], [1, 1], CurrentMachineState, CurrentMachineAction)</l>
<l>*         ExternalHardware_MachineState (gMachineState_Vector, [], [1,1], gMachineState_Vector, CurrentMachineState, CurrentMachineAction, CurrentMachineStateKeys, CurrentMachineValues)</l>
<l>    endif</l>
<c>    * if slow down phase is finished - kill eject queu to rebuild it in slow movement</c>
<l>    if (CurrentMachineState[0] = 4)</l>
<c>        * when all products are stopped rebuild the eject queue. When bad object is in eject position eject queu is build again, if not bad product is conveyed a bit further. this functionality is needed due to movement compensation of products in relation to fix eject position.</c>
<l>        gEjectQueue.at(CameraId) := []</l>
<l>        gEjectQueueRecentlyResetted := 1</l>
<l>    endif</l>
<c></c>
<c>    * Process in the main thread or in a multithreaded environment</c>
<c>    * when starting up shiftregister is automatically filled for some frames</c>
<l>    Shiftregister_TriggerVector_Rebuild_Kill := gShiftregister_RebuildDataVector.at(CameraId).at(0)</l>
<l>    Shiftregister_RebuildCalc (Shiftregister_TriggerVector_Rebuild_Kill[0], Shiftregister_TriggerVector_Rebuild_Kill[1], gProcessingLoopcounter.at(CameraId), gShiftregister_RebuildDataVector.at(CameraId), Shiftregister_NumberOfErrorsForEjectMin+1, gShiftregister_RebuildDataVector.at(CameraId))</l>
<l>*     Shiftregister_RebuildActive := gShiftregister_RebuildDataVector.at(CameraId).at(0)</l>
<c></c>
<c> </c>
<c>    ******************************Count Secure inspection related start**************************************************</c>
<l>    count_seconds (TimeStamp_BeforeProcessing)</l>
<l>    if (gInternalThreading) </l>
<c>        * prepare for a time optimized environment</c>
<l>        NumberOfThreads := gLanesPerThreadsVector.length()</l>
<l>        for I := 0 to NumberOfThreads - 1 by 1</l>
<l>            ProcessingThread := I</l>
<l>            par_start&lt;VThreads.at(ProcessingThread)&gt; : gProcessOneLine (Image, gRinnenROIs.at(0), gEjectROIs.at(0), gShiftRegisterVector_Good_Bad_ObjectsLastFrame_Thread_CameraVector.at(CameraId).at(ProcessingThread), gShiftregister_Iconic_Cameras_Threads_Lanes_Data.at(CameraId).at(ProcessingThread), gShiftregister_VCamera_VThread_VLane_IImagePartsPerObject.at(CameraId).at(ProcessingThread), gShiftregister_VCamera_VThread_VLane_VMeasuredFeatures_IRegionPerFeature.at(CameraId).at(ProcessingThread), ThreadUpstreamResults, ImageOrig_RGB.at(CameraId).at(ProcessingThread), ImageOrig_Sequencer_RGB.at(CameraId).at(ProcessingThread), gShiftRegisterVector_Good_Bad_ObjectsLastFrame_Thread_CameraVector.at(CameraId).at(ProcessingThread), gErrorObjectVector_Colour_Width_Diameter_Spots_Area_Length_ThreadVector.at(ProcessingThread), gGoodObjectVector_TabletIndividual_WidthGood_ThreadVector.at(ProcessingThread), gShiftregister_VCamera_VThread_VLane_IImagePartsPerObject.at(CameraId).at(ProcessingThread), gShiftregister_VCamera_VThread_VLane_VMeasuredFeatures_IRegionPerFeature.at(CameraId).at(ProcessingThread), gErrorObjectDataToStore_VCamera_VThread_VLane_IImagePartsPerObject.at(CameraId).at(ProcessingThread), gErrorObjectDataToStore_VCamera_VThread_VLane_IRegionPerFeature.at(CameraId).at(ProcessingThread), gShiftregister_VCamera_VThread_VEjectROI_Adapted.at(CameraId).at(ProcessingThread), gProducts_IMeasuredRegionsPerFeature.at(CameraId).at(ProcessingThread), gLanesPerThreadsVector.at(ProcessingThread), gColourClassificationHandle, gShiftregisterVector_ObjectMovement_Thread_CameraVector.at(CameraId).at(ProcessingThread), ProcessingThread, gWorkOnFramegrabber_Enable, gWindowVector.at(CameraId), Shiftregister_RemoveBadRegionsInEjectBox, gShiftregister_RebuildDataVector.at(CameraId).at(0), TeachInMode, gShiftregister_Tuple_Cameras_Threads_Lanes_Data.at(CameraId).at(ProcessingThread), gShiftregister_VCamera_VThread_VLane_VMeasureFeature_TResult_TValue.at(CameraId).at(ProcessingThread), gShiftregister_VCamera_VThread_VLane_VImagePartsOffset_TRow_TColumn.at(CameraId).at(ProcessingThread), gCalibration_VTCamera_VTLane_VTPixToMM_XY.at(gLocalCameraNumberUsed), GrabImageMetaData, gProcessingTime_VCamera_VThread_TTime.at(CameraId).at(ProcessingThread), gShiftregister_EjectFoundPerLine_Vector.at(ProcessingThread), gShiftregister_EjectGoodFoundPerLine_Vector.at(ProcessingThread), gShiftregister_EjectObjectInMovementUncompensatedEjectFound_Vector.at(ProcessingThread), gShiftregister_CriticalInspectionResultFoundPerLine_Vector.at(ProcessingThread), gShiftregisterVector_ObjectMovement_Thread_CameraVector.at(CameraId).at(ProcessingThread), gShiftregister_EjectPositionMovementCompensationVector.at(CameraId).at(ProcessingThread), Calculation_Colour_Mean_Red_Vector.at(ProcessingThread), Calculation_Colour_Mean_Green_Vector.at(ProcessingThread), Calculation_Colour_Mean_Blue_Vector.at(ProcessingThread), Calculation_Width_Vector.at(ProcessingThread), Calculation_Length_Vector.at(ProcessingThread), Calculation_Area_Vector.at(ProcessingThread), gShiftregister_VCamera_VThread_VLane_VMeasureFeature_TResult_TValue.at(CameraId).at(ProcessingThread), gShiftregister_VCamera_VThread_VLane_VImagePartsOffset_TRow_TColumn.at(CameraId).at(ProcessingThread), gShiftregister_VThread_VLane_IndicesInEjectBoxFound.at(ProcessingThread), gErrorObjectDataToStore_VCamera_VThread_VLane_VMeasureFeature_TResult_TValue.at(CameraId).at(ProcessingThread), gErrorObjectDataToStore_VCamera_VThread_VLane_VImagePartsOffset_TRow_TColumn.at(CameraId).at(ProcessingThread), gProducts_VT_MeasureResult_MeasureValues, Calculation_FeatureAllValues)</l>
<l>        endfor</l>
<c>        * do a visualisation of last image processing results in the meantime the threads do some processing.</c>
<l>        if (gProcessingLoopcounter.at(CameraId) &gt; 0)</l>
<c>            * only visualize when last image was ready</c>
<l>            tuple_mod (GrabImageMetaData.GrabLoopCounter, 5, Mod)</l>
<l>            if (gVisuImageGernarationMode.at(CameraId) = -1 and Mod = 0)</l>
<l>                gVisuImageGernarationMode.at(CameraId) := 0</l>
<l>                gen_empty_obj (EmptyObject)</l>
<l>                convert_vector_to_tuple (gProcessingTime_VCamera_VThread_TTime, TimeNeededThreads)</l>
<l>                tuple_max (TimeNeededThreads, ProcessingTime)</l>
<l>                par_start&lt;gVisuThreadID.at(CameraId)&gt; : gVisualisationOfResultsCollection (EmptyObject, gVisuImageVector.at(CameraId), CameraId, [], ProcessingTime, gWindowVector.at(CameraId), gVisuDevWindowOrNonDevWindow, gProcessingLoopcounter.at(CameraId), gShiftregisterVector_ObjectMovement_Thread_CameraVector, Calculation_Colour_Mean_Red_Vector, Calculation_Colour_Mean_Green_Vector, Calculation_Colour_Mean_Blue_Vector, Calculation_Length_Vector, Calculation_Width_Vector, Calculation_Area_Vector, gLocalCameraNumberUsed, PauseAfterVisualisationInMS, ExternalHardware_ConveyorDriveSlowly, GrabImageMetaData, VisualisationTime)</l>
<c>*                 par_start&lt;gVisuThreadID.at(CameraId)&gt; : gVisualisationOfResultsCollection (EmptyObject, gVisuImageVector.at(CameraId), CameraId, [], ProcessingTime, gWindowVector.at(CameraId), gVisuDevWindowOrNonDevWindow, gProcessingLoopcounter.at(CameraId), gShiftregisterVector_ObjectMovement_Thread_CameraVector, gCalculation_Colour_Mean_Red_Vector, gCalculation_Colour_Mean_Green_Vector, gCalculation_Colour_Mean_Blue_Vector, gCalculation_Length_Vector, gCalculation_Width_Vector, gCalculation_Diameter_Vector, gCalculation_Area_Vector, gLocalCameraNumberUsed, GrabImageMetaData[1], ExternalHardware_ConveyorDriveSlowly, VisualisationTime)</c>
<l>            endif</l>
<l>        endif</l>
<c>        * Wait for all threads to finish</c>
<l>        convert_vector_to_tuple (VThreads, Threads)</l>
<l>        par_join (Threads)</l>
<l>        gImageOrigGrabbed_LastFrame.at(CameraId) := ImageOrig_RGB.at(CameraId)</l>
<l>    else</l>
<l>        gDebug_StopOptions_Counterbased ([], [], [], [], DebugProcessingCounter)</l>
<l>        gProcessOneLine (Image, gRinnenROIs.at(0), gEjectROIs.at(0), gShiftRegisterVector_Good_Bad_ObjectsLastFrame_Thread_CameraVector.at(CameraId).at(ProcessingThread), gShiftregister_Iconic_Cameras_Threads_Lanes_Data.at(CameraId).at(ProcessingThread), gShiftregister_VCamera_VThread_VLane_IImagePartsPerObject.at(CameraId).at(ProcessingThread), gShiftregister_VCamera_VThread_VLane_VMeasuredFeatures_IRegionPerFeature.at(CameraId).at(ProcessingThread), ThreadUpstreamResults, ImageOrig_RGB.at(CameraId).at(ProcessingThread), ImageOrig_Sequencer_RGB.at(CameraId).at(ProcessingThread), gShiftRegisterVector_Good_Bad_ObjectsLastFrame_Thread_CameraVector.at(CameraId).at(ProcessingThread), gErrorObjectVector_Colour_Width_Diameter_Spots_Area_Length_ThreadVector.at(ProcessingThread), gGoodObjectVector_TabletIndividual_WidthGood_ThreadVector.at(ProcessingThread), gShiftregister_VCamera_VThread_VLane_IImagePartsPerObject.at(CameraId).at(ProcessingThread), gShiftregister_VCamera_VThread_VLane_VMeasuredFeatures_IRegionPerFeature.at(CameraId).at(ProcessingThread), gErrorObjectDataToStore_VCamera_VThread_VLane_IImagePartsPerObject.at(CameraId).at(ProcessingThread), gErrorObjectDataToStore_VCamera_VThread_VLane_IRegionPerFeature.at(CameraId).at(ProcessingThread), gShiftregister_VCamera_VThread_VEjectROI_Adapted.at(CameraId).at(ProcessingThread), gProducts_IMeasuredRegionsPerFeature.at(CameraId).at(ProcessingThread), gLanesPerThreadsVector.at(ProcessingThread), gColourClassificationHandle, gShiftregisterVector_ObjectMovement_Thread_CameraVector.at(CameraId).at(ProcessingThread), ProcessingThread, gWorkOnFramegrabber_Enable, gWindowVector.at(CameraId), Shiftregister_RemoveBadRegionsInEjectBox, gShiftregister_RebuildDataVector.at(CameraId).at(0), TeachInMode, gShiftregister_Tuple_Cameras_Threads_Lanes_Data.at(CameraId).at(ProcessingThread), gShiftregister_VCamera_VThread_VLane_VMeasureFeature_TResult_TValue.at(CameraId).at(ProcessingThread), gShiftregister_VCamera_VThread_VLane_VImagePartsOffset_TRow_TColumn.at(CameraId).at(ProcessingThread), gCalibration_VTCamera_VTLane_VTPixToMM_XY.at(gLocalCameraNumberUsed), GrabImageMetaData, gProcessingTime_VCamera_VThread_TTime.at(CameraId).at(ProcessingThread), gShiftregister_EjectFoundPerLine_Vector.at(ProcessingThread), gShiftregister_EjectGoodFoundPerLine_Vector.at(ProcessingThread), gShiftregister_EjectObjectInMovementUncompensatedEjectFound_Vector.at(ProcessingThread), gShiftregister_CriticalInspectionResultFoundPerLine_Vector.at(ProcessingThread), gShiftregisterVector_ObjectMovement_Thread_CameraVector.at(CameraId).at(ProcessingThread), gShiftregister_EjectPositionMovementCompensationVector.at(CameraId).at(ProcessingThread), Calculation_Colour_Mean_Red_Vector.at(ProcessingThread), Calculation_Colour_Mean_Green_Vector.at(ProcessingThread), Calculation_Colour_Mean_Blue_Vector.at(ProcessingThread), Calculation_Width_Vector.at(ProcessingThread), Calculation_Length_Vector.at(ProcessingThread), Calculation_Area_Vector.at(ProcessingThread), gShiftregister_VCamera_VThread_VLane_VMeasureFeature_TResult_TValue.at(CameraId).at(ProcessingThread), gShiftregister_VCamera_VThread_VLane_VImagePartsOffset_TRow_TColumn.at(CameraId).at(ProcessingThread), gShiftregister_VThread_VLane_IndicesInEjectBoxFound.at(ProcessingThread), gErrorObjectDataToStore_VCamera_VThread_VLane_VMeasureFeature_TResult_TValue.at(CameraId).at(ProcessingThread), gErrorObjectDataToStore_VCamera_VThread_VLane_VImagePartsOffset_TRow_TColumn.at(CameraId).at(ProcessingThread), gProducts_VT_MeasureResult_MeasureValues, Calculation_FeatureAllValues)</l>
<c>        * next line for indication external hardware is implemented a bit later again- neessary for correct visu in non threaded environment</c>
<l>        ExternalHardware_CheckIfStartNormalOrSlow (ExternalHardware_ConveyorDriveSlowly)</l>
<l>        if(ExternalHardware_ConveyorDriveSlowly = 1)</l>
<l>            stop()</l>
<l>        endif</l>
<l>        set_window_param (gWindowVector.at(CameraId), 'flush', 'false')</l>
<l>        gVisualisationOfResults (ImageOrig_RGB.at(CameraId).at(ProcessingThread), ImageOrig_Sequencer_RGB.at(CameraId).at(ProcessingThread),  gRinnenROIs.at((gLocalCameraNumberUsed)), gEjectROIs.at((gLocalCameraNumberUsed)), gGoodObjectVector_TabletIndividual_WidthGood_ThreadVector, gErrorObjectVector_Colour_Width_Diameter_Spots_Area_Length_ThreadVector, gWindowVector.at(CameraId), gShiftregister_EjectFoundPerLine_Vector, gShiftregister_EjectGoodFoundPerLine_Vector, gVisuDevWindowOrNonDevWindow, gShiftregister_EjectPositionMovementCompensationVector.at(CameraId), ExternalHardware_ConveyorDriveSlowly, 0, VisualisationTime)  // todo: richtige eingabe für ShowSequencerImage finden</l>
<l>        convert_vector_to_tuple (gProcessingTime_VCamera_VThread_TTime, TimeNeededThreads)</l>
<l>        tuple_max (TimeNeededThreads, ProcessingTime)</l>
<l>        gVisualisationOfStrings (VisualisationTime, ProcessingTime, gWindowVector.at(CameraId), gVisuDevWindowOrNonDevWindow, gShiftregisterVector_ObjectMovement_Thread_CameraVector, Calculation_Colour_Mean_Red_Vector, Calculation_Colour_Mean_Green_Vector, Calculation_Colour_Mean_Blue_Vector, Calculation_Length_Vector, Calculation_Width_Vector, Calculation_Area_Vector, gLocalCameraNumberUsed, gProductCounterGood, gProductCounterBad, GrabImageMetaData)</l>
<l>        flush_buffer (gWindowVector.at(CameraId))</l>
<l>        set_window_param (gWindowVector.at(CameraId), 'flush', 'true')</l>
<l>        gImageOrigGrabbed_LastFrame.at(CameraId).at(ProcessingThread) := ImageOrig_RGB.at(CameraId).at(ProcessingThread)</l>
<c>     </c>
<c> </c>
<l>    endif</l>
<l>    count_seconds (TimeStamp_AfterProcessing)</l>
<c> </c>
<l>    if (gStopAtProcess)</l>
<l>        gStopAtProcess := 0</l>
<l>        stop()  </l>
<l>    endif</l>
<c>    </c>
<c>    * Debug use different stop options</c>
<l>    gDebug_StopOptions_Counterbased ([], [], [], [], DebugProcessingCounter)</l>
<c></c>
<c>    * When Shiftregister was killed/active reset the state</c>
<l>    if (gShiftregister_RebuildDataVector.at(CameraId).at(0)[1] = 1)</l>

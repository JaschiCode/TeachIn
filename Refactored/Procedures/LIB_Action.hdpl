<par name="ErrorObject_Area" base_type="iconic" dimension="0"/>
<par name="ErrorObject_WrongPRV" base_type="iconic" dimension="0"/>
<par name="ErrorObject_WrongPCC" base_type="iconic" dimension="0"/>

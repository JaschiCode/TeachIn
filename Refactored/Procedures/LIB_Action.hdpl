<par name="ShiftRegisterVector_Good_Bad_ObjectsLastFrame" base_type="iconic" dimension="2"/>
<par name="Shiftregister_Iconic_Lanes_Data" base_type="iconic" dimension="3"/>
<par name="Products_VGoodObjects_VBadObjects" base_type="iconic" dimension="2"/>
<par name="Products_IMeasuredRegionsPerFeature" base_type="iconic" dimension="1"/>
<par name="Shiftregister_VLane_IImagePartsPerObject" base_type="iconic" dimension="2"/>
<par name="Shiftregister_VLane_VMeasuredFeatures_IRegionPerFeature" base_type="iconic" dimension="2"/>
<par name="Rollmeasurement360" base_type="iconic" dimension="0"/>
</io>
<oo>
<par name="ShiftRegisterVector_Good_Bad_ObjectsLastFrame_Out" base_type="iconic" dimension="2"/>
<par name="ErrorObjectVector_Colour_Width_Diameter_Spots_Area_Length" base_type="iconic" dimension="2"/>
<par name="GoodObjectVector_TabletIndividual_WidthGood" base_type="iconic" dimension="2"/>
<par name="Shiftregister_VLane_IImagePartsPerObject_Out" base_type="iconic" dimension="2"/>
<par name="Shiftregister_VLane_VMeasuredFeatures_IRegionPerFeature_Out" base_type="iconic" dimension="2"/>
<par name="ErrorObjectDataToStore_VLane_IImagePartsPerObject" base_type="iconic" dimension="2"/>
<par name="ErrorObjectDataToStore_VLane_IRegionPerFeature" base_type="iconic" dimension="2"/>

<procedure name="gCalculate_UpperLowerFeatures">
<interface>
<io>
<par name="AllObjects_MeasuredRegions" base_type="iconic" dimension="0"/>
</io>
<oo>
<par name="Region_BadObjects" base_type="iconic" dimension="0"/>
<par name="Region_GoodObjects" base_type="iconic" dimension="0"/>
</oo>
<ic>
<par name="AllObjects_MeasuredValues" base_type="ctrl" dimension="0"/>
<par name="ThresholdValue_Min" base_type="ctrl" dimension="0"/>
<par name="ThresholdValue_Max" base_type="ctrl" dimension="0"/>
</ic>
<oc>
<par name="NumberOfObjectsOutOfTolerance" base_type="ctrl" dimension="0"/>
<par name="Indices" base_type="ctrl" dimension="0"/>
<par name="IndicesBadObjects" base_type="ctrl" dimension="0"/>
<par name="BadObjects_MeasuredValues" base_type="ctrl" dimension="0"/>
<par name="Region_Number" base_type="ctrl" dimension="0"/>
<par name="ObjectsIndication_IfGood0_Bad1" base_type="ctrl" dimension="0"/>
<par name="Indices_BadObjects" base_type="ctrl" dimension="0"/>
</oc>
</interface>
<body>
<c>*** gCalculate_UpperLowerFeatures</c>
<c>* This procedure was made to check if flat objects do really turn.</c>
<c>* It is supposed to be used for feature 'width' but can also be combined with other geometric features.</c>
<c></c>
<c>* Check if the width does reach a certain range of values.</c>
<c>* That range should be a subset of [Width_Min, Width_Max].</c>
<c>* return the values and regions of good and bad objects</c>
<c></c>
<l>Indices_BadObjects := []</l>
<c>    </c>
<c>* Indicator for bad objects. </c>
<c>* 1 if values are too small or to big</c>
<c>* 0 if values are ok</c>
<l>Less := AllObjects_MeasuredValues [&lt;] ThresholdValue_Min</l>
<l>Greater := AllObjects_MeasuredValues [&gt;] ThresholdValue_Max</l>
<l>ObjectsIndication_IfGood0_Bad1 := Greater or Less</l>
<c></c>
<c>* indices of bad objects</c>
<l>tuple_find (ObjectsIndication_IfGood0_Bad1, 1, Indices_BadObjects)</l>
<c></c>
<c>* if no bad object was found, return empty tuple</c>
<l>if (Indices_BadObjects = -1)</l>
<l>    Indices_BadObjects := []</l>
<l>endif</l>
<c></c>
<c>    </c>
<c>* select the bad objects, the differenct of all objects must be the good ones</c>
<l>select_obj (AllObjects_MeasuredRegions, Region_BadObjects, Indices_BadObjects+1)</l>
<l>difference (AllObjects_MeasuredRegions, Region_BadObjects, Region_GoodObjects)</l>
<l>select_shape (Region_GoodObjects, Region_GoodObjects, 'area', 'and', 1, 99999999)</l>
<c>* select values of bad objects</c>
<l>tuple_select (AllObjects_MeasuredValues, Indices_BadObjects, BadObjects_MeasuredValues)</l>
<c></c>
<l>return ()</l>
</body>
<docu id="gCalculate_UpperLowerFeatures">
<parameters>
<parameter id="AllObjects_MeasuredRegions"/>
<parameter id="AllObjects_MeasuredValues"/>
<parameter id="BadObjects_MeasuredValues"/>
<parameter id="Indices"/>
<parameter id="IndicesBadObjects"/>
<parameter id="Indices_BadObjects"/>
<parameter id="NumberOfObjectsOutOfTolerance"/>
<parameter id="ObjectsIndication_IfGood0_Bad1"/>
<parameter id="Region_BadObjects"/>
<parameter id="Region_GoodObjects"/>
<parameter id="Region_Number"/>
<parameter id="ThresholdValue_Max"/>
<parameter id="ThresholdValue_Min"/>
</parameters>
</docu>
</procedure>
<procedure name="gCalculate_Width_PrepareData">
<interface>
<ic>
<par name="dict_Feature" base_type="ctrl" dimension="0"/>
<par name="Segmentation_SelectSegmentationImage_BottomLight0_TopLight1_UVLight2" base_type="ctrl" dimension="0"/>
<par name="Sequencer_MovedDistanceInBetweenGrabbedImages" base_type="ctrl" dimension="0"/>
<par name="Segmentation_DarkOnBright0_BrightOnDark_1" base_type="ctrl" dimension="0"/>
<par name="Calibration_FeatureActive" base_type="ctrl" dimension="0"/>
<par name="Calibration_GlobalMeasurementOffset_Micron_X" base_type="ctrl" dimension="0"/>
<par name="Calibration_VTLane_VTPixToMM_XY" base_type="ctrl" dimension="2"/>
<par name="ProcessingThread" base_type="ctrl" dimension="0"/>
</ic>
</interface>
<body>
<l>switch (Segmentation_SelectSegmentationImage_BottomLight0_TopLight1_UVLight2)</l>
<l>case 0:</l>
<l>    dict_Feature.Sequencer_MovedDistanceInBetweenGrabbedImages := Sequencer_MovedDistanceInBetweenGrabbedImages</l>
<l>    dict_Feature.MeasureSubpix_Transition_Negative0_Positive1 := 0</l>
<l>    break</l>
<l>  case 1:</l>
<l>    dict_Feature.Sequencer_MovedDistanceInBetweenGrabbedImages := Sequencer_MovedDistanceInBetweenGrabbedImages</l>
<l>    dict_Feature.MeasureSubpix_Transition_Negative0_Positive1 := Segmentation_DarkOnBright0_BrightOnDark_1</l>
<l>    break</l>
<l>  case 2:</l>
<l>    dict_Feature.Sequencer_MovedDistanceInBetweenGrabbedImages := 0</l>
<l>    dict_Feature.MeasureSubpix_Transition_Negative0_Positive1 := 1</l>
<l>    break</l>
<l>endswitch</l>
<c></c>
<c></c>
<l>if(Calibration_FeatureActive = 1)</l>
<l>    dict_Feature.Calibration_GlobalMeasurementOffset_Micron_X := Calibration_GlobalMeasurementOffset_Micron_X</l>
<l>    dict_Feature.Calibration_X_PixToMM := Calibration_VTLane_VTPixToMM_XY.at(ProcessingThread).at(0)</l>
<l>else</l>
<l>    dict_Feature.Calibration_GlobalMeasurementOffset_Micron_X :=0</l>
<l>    dict_Feature.Calibration_X_PixToMM := 1</l>
<l>endif</l>
<l>return ()</l>
</body>
<docu id="gCalculate_Width_PrepareData">
<parameters>
<parameter id="Calibration_FeatureActive"/>
<parameter id="Calibration_GlobalMeasurementOffset_Micron_X"/>
<parameter id="Calibration_VTLane_VTPixToMM_XY"/>
<parameter id="ProcessingThread"/>
<parameter id="Segmentation_DarkOnBright0_BrightOnDark_1"/>
<parameter id="Segmentation_SelectSegmentationImage_BottomLight0_TopLight1_UVLight2"/>
<parameter id="Sequencer_MovedDistanceInBetweenGrabbedImages"/>
<parameter id="dict_Feature"/>
</parameters>
</docu>
</procedure>
<procedure name="gCalculate_XY_MaxPoints_OfRotatedRegion">
<interface>
<io>
<par name="InputRegion" base_type="iconic" dimension="0"/>
</io>
<oc>
<par name="Min_RowColumn" base_type="ctrl" dimension="0"/>
<par name="Max_RowColumn" base_type="ctrl" dimension="0"/>
</oc>
</interface>
<body>
<c>* find min and max column points of a region</c>
<c></c>
<l>Min_RowColumn := []</l>
<l>Max_RowColumn := []</l>
<c></c>
<c></c>
<l>get_region_points (InputRegion, Rows, Columns)</l>
<l>if(|Columns| &gt;=2) // only do something if the input region is at least 2 pixel long</l>
<l>    tuple_sort (Columns, Columns_Sorted)</l>
<c>    *find smallest column point</c>
<l>    tuple_find_first (Columns, Columns_Sorted[0], Index_Smallest)</l>
<l>    MinRow := Rows[Index_Smallest[0]]</l>
<l>    MinColumn := Columns[Index_Smallest[0]]</l>
<l>    Min_RowColumn := [MinRow,MinColumn]</l>
<c>    </c>
<c>    *find biggest column point</c>
<l>    tuple_find_first (Columns, Columns_Sorted[|Columns_Sorted|-1], Index_Biggest)</l>
<l>    MaxRow := Rows[Index_Biggest[0]]</l>
<l>    MaxColumn := Columns[Index_Biggest[0]]</l>
<l>    Max_RowColumn := [MaxRow,MaxColumn]</l>
<l>endif</l>
<c></c>
<l>Debug := 0</l>
<l>if (Debug =1)</l>
<l>    dev_get_window (WindowHandle)</l>
<l>    disp_cross (WindowHandle, MinRow, MinColumn, 60, 0.785398)</l>
<l>    disp_cross (WindowHandle, MaxRow, MaxColumn, 60, 0.785398)</l>
<c>    </c>
<l>    dev_set_color ('red')</l>
<l>    gen_region_line (RegionLines, Min_RowColumn[0], Min_RowColumn[1], Max_RowColumn[0], Max_RowColumn[1]) // for visu of mirroring angle  - buggy?</l>
<l>    dev_display(RegionLines)</l>
<c></c>
<l>    dev_set_color ('green')</l>
<l>    dev_display(InputRegion)</l>
<c></c>
<l>endif</l>
<c></c>
<c></c>
<l>return ()</l>
</body>
<docu id="gCalculate_XY_MaxPoints_OfRotatedRegion">
<parameters>
<parameter id="InputRegion"/>
<parameter id="Max_RowColumn"/>
<parameter id="Min_RowColumn"/>
</parameters>
</docu>
</procedure>
<procedure name="gCalculateFeature_Concavity">
<interface>
<io>
<par name="ImageOrig" base_type="iconic" dimension="0"/>
<par name="RegionsToMeasure" base_type="iconic" dimension="0"/>
</io>
<oo>
<par name="MeasuredVisu" base_type="iconic" dimension="0"/>
</oo>
<ic>
<par name="DebugVisu" base_type="ctrl" dimension="0"/>
</ic>
<oc>
<par name="DeviationValue" base_type="ctrl" dimension="0"/>
</oc>
</interface>
<body>
<l>NumberOfPArtitionsPerObject := 4</l>
<c></c>
<l>DeviationValue := []</l>
<l>gen_empty_obj (MeasuredVisu)</l>
<c></c>
<l>count_obj (RegionsToMeasure, RegionsToMeasure_Number)</l>
<l>smallest_rectangle1 (RegionsToMeasure, SmallestRect_Row1, SmallestRect_Column1, SmallestRect_Row2, SmallestRect_Column2)</l>
<l>if (SmallestRect_Row1 # [])</l>
<l>    gen_rectangle1 (RegionsToMeasure_Boxed, SmallestRect_Row1, SmallestRect_Column1+10, SmallestRect_Row2, SmallestRect_Column2-10)</l>
<l>endif</l>
<c></c>
<l>RegionsToMeasure_Width := SmallestRect_Column2 - SmallestRect_Column1</l>
<l>for Index_Cnt := 1 to RegionsToMeasure_Number by 1</l>
<l>    select_obj (RegionsToMeasure, RegionsToMeasure_Selected, Index_Cnt)</l>
<l>    select_obj (RegionsToMeasure_Boxed, RegionsToMeasure_Boxed_Selected, Index_Cnt)</l>
<c></c>
<l>    intersection (RegionsToMeasure_Selected, RegionsToMeasure_Boxed_Selected, RegionsToMeasure_Selected_ReducedToAnalyzeRegion)</l>
<c></c>
<c>    * analyze with convex hull aproach    </c>
<l>    get_region_convex (RegionsToMeasure_Selected_ReducedToAnalyzeRegion, Rows, Columns)</l>
<l>    gen_region_polygon (TestConvexHull, Rows, Columns)</l>
<l>    fill_up (TestConvexHull, TestConvexHull)</l>
<l>    erosion_circle (TestConvexHull, TestConvexHull, 1.5)</l>
<l>    difference (TestConvexHull, RegionsToMeasure_Selected_ReducedToAnalyzeRegion, Difference_ConvexHull_ToMeasureRegion)</l>
<c></c>
<l>    area_center (Difference_ConvexHull_ToMeasureRegion, Deviation_Area, _, _)</l>
<l>    if(Deviation_Area # [])</l>
<l>        DeviationValue := [DeviationValue,Deviation_Area]</l>
<c>        * get vizu add on and have it ready for outupt</c>
<l>        difference (RegionsToMeasure_Selected, RegionsToMeasure_Boxed, VizuAddon)</l>
<l>        concat_obj (VizuAddon, Difference_ConvexHull_ToMeasureRegion, Difference_ConvexHull_ToMeasureRegion)</l>
<l>        union1 (Difference_ConvexHull_ToMeasureRegion, Difference_ConvexHull_ToMeasureRegion)</l>
<l>        concat_obj (MeasuredVisu, Difference_ConvexHull_ToMeasureRegion, MeasuredVisu)</l>
<l>    else</l>
<l>        DeviationValue := [DeviationValue,0]</l>
<l>        concat_obj (MeasuredVisu, RegionsToMeasure_Selected, MeasuredVisu)</l>
<l>    endif</l>
<l>endfor</l>
<c></c>
<l>if(DebugVisu =1)</l>
<l>    dev_set_color ('red')</l>
<l>    dev_get_window (WindowHandle)</l>
<l>    dev_display (ImageOrig)</l>
<l>    dev_display (MeasuredVisu)</l>
<l>endif</l>
<l>return ()</l>
</body>
<docu id="gCalculateFeature_Concavity">
<parameters>
<parameter id="DebugVisu"/>
<parameter id="DeviationValue"/>
<parameter id="ImageOrig"/>
<parameter id="MeasuredVisu"/>
<parameter id="RegionsToMeasure"/>
</parameters>
</docu>
</procedure>
<procedure name="gCalculateFeature_MidToGravityDeviation">
<interface>
<io>
<par name="RegionsToMeasure" base_type="iconic" dimension="0"/>
</io>
<ic>
<par name="Xis0_Yis1" base_type="ctrl" dimension="0"/>
</ic>
<oc>
<par name="DeviationValue" base_type="ctrl" dimension="0"/>
</oc>
</interface>
<body>
<c>* calculate the diviation middle of geometrical objecct to center of gravity</c>
<l>DeviationValue :=[]</l>
<l>smallest_rectangle1 (RegionsToMeasure, RegionsToMeasure_Row1, RegionsToMeasure_Column1, RegionsToMeasure_Row2, RegionsToMeasure_Column2)</l>
<l>WidthOfObject := RegionsToMeasure_Column2 - RegionsToMeasure_Column1</l>
<l>HeigthOfObject := RegionsToMeasure_Row2 - RegionsToMeasure_Row1</l>
<l>MiddlePointGeometric_Column := WidthOfObject/2 + RegionsToMeasure_Column1</l>
<l>MiddlePointGeometric_Row := HeigthOfObject/2 + RegionsToMeasure_Row1</l>
<l>area_center (RegionsToMeasure, Area, RegionsToMeasure_CenterOfGravity_Row, RegionsToMeasure_CenterOfGravity_Column)</l>
<l>Deviation_Column := RegionsToMeasure_CenterOfGravity_Column - MiddlePointGeometric_Column</l>
<l>Deviation_Row := RegionsToMeasure_CenterOfGravity_Row - MiddlePointGeometric_Row</l>
<l>if (Xis0_Yis1 = 0)</l>
<l>    DeviationValue := Deviation_Column</l>
<l>else</l>
<l>    DeviationValue := Deviation_Row</l>
<l>endif</l>
<c>* due to the measurement is rotational symmetric just use the abs value</c>
<l>tuple_abs (DeviationValue, DeviationValue)</l>
<c></c>
<l>return ()</l>
</body>
<docu id="gCalculateFeature_MidToGravityDeviation">
<parameters>
<parameter id="DeviationValue"/>
<parameter id="RegionsToMeasure"/>
<parameter id="Xis0_Yis1"/>
</parameters>
</docu>
</procedure>
<procedure name="gCalculateFeature_PrintInspection">
<interface>
<io>
<par name="ImageOrig" base_type="iconic" dimension="0"/>
<par name="RegionsToMeasure" base_type="iconic" dimension="0"/>
<par name="Tablet_Individual_ColourClassified" base_type="iconic" dimension="0"/>
</io>
<oo>
<par name="MeasuredVisuSymmetry" base_type="iconic" dimension="0"/>
</oo>
<ic>
<par name="TabletPrintInspection_SegmentColorHueMin" base_type="ctrl" dimension="0"/>
<par name="TabletPrintInspection_SegmentColorHueMax" base_type="ctrl" dimension="0"/>
<par name="TabletPrintInspection_SegmentColorSaturationMin" base_type="ctrl" dimension="0"/>
<par name="TabletPrintInspection_SegmentColorSaturationMax" base_type="ctrl" dimension="0"/>
</ic>
<oc>
<par name="DeviationValue" base_type="ctrl" dimension="0"/>
<par name="TimeNeeded" base_type="ctrl" dimension="0"/>
</oc>
</interface>
<body>
<l>* Splitmode := 'vertical'</l>
<l>* Splitmode := 'horizontal'</l>
<c>* option for a region based matching</c>
<l>* RepositioningActive := 1</l>
<c></c>
<l>count_seconds(Seconds_Start)</l>
<c>* calculate the diviation middle of geometrical objecct to center of gravity</c>
<l>DeviationValue :=[]</l>
<l>gen_empty_obj (MeasuredVisuSymmetry)</l>
<c></c>
<l>count_obj (RegionsToMeasure, RegionsToMeasure_Number)</l>
<l>if (RegionsToMeasure_Number # 0) </l>
<l>*     erosion_rectangle1 (RegionsToMeasure, RegionsToMeasure, 10, 10)</l>
<l>    for Index_Cnt := 1 to RegionsToMeasure_Number by 1</l>
<l>        Deviation_Area := []</l>
<l>        select_obj (RegionsToMeasure, RegionsToMeasure_Selected, Index_Cnt)</l>
<l>        intersection (RegionsToMeasure_Selected, Tablet_Individual_ColourClassified, PrintSegmented)</l>
<c></c>
<c>        * after union2 there are two regions- melt them together</c>
<l>        union1 (PrintSegmented, PrintSegmented)</l>
<c>        * test single character approach</c>
<l>*         select_characters (PrintSegmented, RegionCharacters, 'false', 'light', 22, 45, 'true', 'true', 'variable_width', 'false', 'narrow', 'true', 0, 'completion')</l>
<c>        * test single character approach</c>
<c>        </c>
<c>        * ToDo- maybe filter out agoin - remove line      </c>
<l>*         dilation_rectangle1 (PrintSegmented, PrintSegmented, 4, 4)</l>
<l>*         erosion_rectangle1 (PrintSegmented, PrintSegmented, 2, 2)</l>
<c></c>
<c>        </c>
<l>        area_center (PrintSegmented, Deviation_Area, Row, Column)</l>
<l>        region_features (PrintSegmented, 'area', Value)</l>
<c>        </c>
<l>        if (Deviation_Area # 0 and Deviation_Area # []) </l>
<l>            tuple_concat (DeviationValue, Deviation_Area, DeviationValue)</l>
<c>            * prepare visu output</c>
<l>            difference (RegionsToMeasure_Selected, PrintSegmented, PrintSegmented_Visu)</l>
<c>            * in case no region is given get one for vizualisation. is necessary for later handling</c>
<l>            area_center (PrintSegmented_Visu, Area, _, _)</l>
<l>            if (Area = [] or Area = 0)</l>
<l>                concat_obj (MeasuredVisuSymmetry, RegionsToMeasure_Selected, MeasuredVisuSymmetry)              </l>
<l>            else</l>
<l>                concat_obj (MeasuredVisuSymmetry, PrintSegmented_Visu, MeasuredVisuSymmetry)              </l>
<l>            endif</l>
<l>        else</l>
<l>            tuple_concat (DeviationValue, 0, DeviationValue)</l>
<l>            concat_obj (MeasuredVisuSymmetry, RegionsToMeasure_Selected, MeasuredVisuSymmetry)</l>
<l>        endif </l>
<l>    endfor</l>
<l>endif</l>
<c></c>
<l>count_seconds(Seconds_End)</l>
<l>TimeNeeded := (Seconds_End - Seconds_Start) * 1000.0</l>
<c>* only to check results</c>
<l>* Visualize_Debuginformation:= 0</l>
<l>* if (Visualize_Debuginformation = 1)</l>
<l>*     dev_display (ImageOrig)</l>
<l>*     dev_display (MeasuredVisuSymmetry)</l>
<l>*     stop()</l>
<l>* endif</l>
<c></c>
<l>return ()</l>
<c></c>
<c></c>
<c>************************************************************** old code</c>
<l>* count_obj (RegionsToMeasure, RegionsToMeasure_Number)</l>
<l>* if (RegionsToMeasure_Number # 0)  </l>
<l>*     for Index_Cnt := 1 to RegionsToMeasure_Number by 1</l>
<l>*         Deviation_Area := []</l>
<l>*         select_obj (RegionsToMeasure, RegionsToMeasure_Selected, Index_Cnt)</l>
<l>*         erosion_rectangle1 (RegionsToMeasure_Selected, RegionsToMeasure_Selected, 15, 11)</l>
<c></c>
<l>*         reduce_domain (ImageOrig, RegionsToMeasure_Selected, ImageReducedTo_OneTabletBody)</l>
<l>*         decompose3 (ImageReducedTo_OneTabletBody, Hue, Saturation, Value)</l>
<c></c>
<c>        * segment via colour -Hue-. Red needs two sgmentation steps due to it is a 360Deg colour description</c>
<l>*         if(TabletPrintInspection_SegmentColorHueMin = TabletPrintInspection_SegmentColorHueMax)</l>
<c>           * in case feature is switeched off</c>
<l>*             gen_empty_obj (PrintSegmentedHue)</l>
<l>*         else // in case feature is active </l>
<l>*             if (TabletPrintInspection_SegmentColorHueMin &lt; TabletPrintInspection_SegmentColorHueMax)</l>
<l>*                 fast_threshold (Hue, PrintSegmentedHue, TabletPrintInspection_SegmentColorHueMin, TabletPrintInspection_SegmentColorHueMax, 0)</l>
<l>*             else</l>
<l>*                 fast_threshold (Hue, PrintSegmentedHue, [0,TabletPrintInspection_SegmentColorHueMin], [TabletPrintInspection_SegmentColorHueMax,255], 0)</l>
<l>*                 union2 (PrintSegmentedHue, PrintSegmentedHue, PrintSegmentedHue)</l>
<l>*             endif</l>
<l>*         endif</l>
<c></c>
<c>        * make shure that only strong print is available via Saturation</c>
<l>*         if (TabletPrintInspection_SegmentColorSaturationMin &lt; TabletPrintInspection_SegmentColorSaturationMax)</l>
<l>*             fast_threshold (Saturation, PrintSegmentedSaturation, TabletPrintInspection_SegmentColorSaturationMin, TabletPrintInspection_SegmentColorSaturationMax, 0)</l>
<l>*         else</l>
<l>*             fast_threshold (Saturation, PrintSegmentedSaturation, [0,TabletPrintInspection_SegmentColorSaturationMin], [TabletPrintInspection_SegmentColorSaturationMax,255], 0)</l>
<l>*             union2 (PrintSegmentedSaturation, PrintSegmentedSaturation, PrintSegmentedSaturation)</l>
<l>*         endif</l>
<c>        </c>
<l>*         union2 (PrintSegmentedHue, PrintSegmentedSaturation, PrintSegmented)</l>
<c>        * after union2 there are two regions- melt them together</c>
<l>*         union1 (PrintSegmented, PrintSegmented)</l>
<c>        </c>
<l>*         area_center (PrintSegmented, Deviation_Area, Row, Column)</l>
<c>        </c>
<l>*         if (Deviation_Area # 0 and Deviation_Area # []) </l>
<l>*             tuple_concat (DeviationValue, Deviation_Area, DeviationValue)</l>
<c>            * prepare visu output</c>
<l>*             difference (RegionsToMeasure_Selected, PrintSegmented, PrintSegmented_Visu)</l>
<l>*             concat_obj (MeasuredVisuSymmetry, PrintSegmented_Visu, MeasuredVisuSymmetry)</l>
<l>*         else</l>
<l>*             tuple_concat (DeviationValue, 0, DeviationValue)</l>
<l>*             concat_obj (MeasuredVisuSymmetry, RegionsToMeasure_Selected, MeasuredVisuSymmetry)</l>
<l>*         endif </l>
<l>*     endfor</l>
<l>* endif</l>
<l>* count_seconds(Seconds_End)</l>
<l>* TimeNeeded := (Seconds_End - Seconds_Start) * 1000.0</l>
<c>* only to check results</c>
<l>* Visualize_Debuginformation:= 0</l>
<l>* if (Visualize_Debuginformation = 1)</l>
<l>*     dev_display (ImageOrig)</l>
<l>*     dev_display (MeasuredVisuSymmetry)</l>
<l>*     stop()</l>
<l>* endif</l>
<c></c>
<c></c>
<c></c>
</body>
<docu id="gCalculateFeature_PrintInspection">
<parameters>
<parameter id="DeviationValue"/>
<parameter id="ImageOrig"/>
<parameter id="MeasuredVisuSymmetry"/>
<parameter id="RegionsToMeasure"/>
<parameter id="TabletPrintInspection_SegmentColorHueMax"/>
<parameter id="TabletPrintInspection_SegmentColorHueMin"/>
<parameter id="TabletPrintInspection_SegmentColorSaturationMax"/>
<parameter id="TabletPrintInspection_SegmentColorSaturationMin"/>
<parameter id="Tablet_Individual_ColourClassified"/>
<parameter id="TimeNeeded"/>
</parameters>
</docu>
</procedure>
<procedure name="gCalculateFeature_Symmetry">
<interface>
<io>
<par name="ImageOrig" base_type="iconic" dimension="0"/>
<par name="RegionsToMeasure" base_type="iconic" dimension="0"/>
</io>
<oo>
<par name="MeasuredVisuSymmetry" base_type="iconic" dimension="0"/>
</oo>
<ic>
<par name="DebugVisu" base_type="ctrl" dimension="0"/>
</ic>
<oc>
<par name="DeviationValue" base_type="ctrl" dimension="0"/>
</oc>
</interface>
<body>
<l>* Splitmode := 'vertical'</l>
<l>Splitmode := 'horizontal'</l>
<c>* option for a region based matching</c>
<l>RepositioningActive := 1</l>
<c></c>
<c>* Split every input object in horizontal half and calculate upper to lowwer by difference.</c>
<c>* An easy rotation compensation is implemented as well s easy matching of the two halfs to each other.</c>
<c></c>
<l>DeviationValue :=[]</l>
<l>gen_empty_obj (MeasuredVisuSymmetry)</l>
<c></c>
<l>count_obj (RegionsToMeasure, RegionsToMeasure_Number)</l>
<l>if (RegionsToMeasure_Number # 0)</l>
<l>    smallest_rectangle2 (RegionsToMeasure, Row, Column, Phi, Length1, Length2)</l>
<l>    gen_rectangle2 (BoundigBoxRectangle, Row, Column, Phi, Length1, Length2)</l>
<l>    tuple_deg (Phi, Deg)</l>
<c></c>
<l>    for Index_Cnt := 1 to RegionsToMeasure_Number by 1</l>
<l>        Deviation_Area := []</l>
<l>        select_obj (BoundigBoxRectangle, BoundigBoxRectangle_Selected, Index_Cnt)</l>
<c>        * gen a split line, choose object part left and right, mirror it twice and check for differences . The bigger part is assumed to be the still correct one</c>
<l>        if (Splitmode = 'vertical') // ToDo in vertical is a bug due to wrong rotation?</l>
<l>            if(Deg[Index_Cnt-1] &lt; 20 or Deg[Index_Cnt-1] &gt; -20) // restrict to +-20 degree deviation. otherwise vertical could happen</l>
<l>                Phi[Index_Cnt-1] := 0.0</l>
<l>            endif</l>
<l>            gen_rectangle2 (MiddleLine, Row[Index_Cnt-1], Column[Index_Cnt-1], Phi[Index_Cnt-1], 1, Length2[Index_Cnt-1]) // horizontal split line</l>
<l>        else      </l>
<l>            if(Deg[Index_Cnt-1] &gt; 20 or Deg[Index_Cnt-1] &lt; -20) // restrict to +-20 degree deviation. otherwise vertical could happen</l>
<l>                Phi[Index_Cnt-1] := 0.0</l>
<l>            endif</l>
<l>            gen_rectangle2 (MiddleLine, Row[Index_Cnt-1], Column[Index_Cnt-1], Phi[Index_Cnt-1], Length1[Index_Cnt-1], 1) // horizontal split line</l>
<l>        endif</l>
<l>        difference (BoundigBoxRectangle_Selected, MiddleLine, TwoHalfRegions)</l>
<l>        connection (TwoHalfRegions, TwoHalfRegions)</l>
<l>        select_obj (RegionsToMeasure, RegionsToMeasure_Selected, Index_Cnt)</l>
<l>        count_obj (TwoHalfRegions, TwoHalfRegions_Number)</l>
<c>        </c>
<l>        if (TwoHalfRegions_Number = 2) // just in case there is only one or []</l>
<l>            difference (TwoHalfRegions, RegionsToMeasure_Selected, RegionDifference)</l>
<l>            area_center (RegionDifference, TwoHalfsDiff_Area, _, _)</l>
<l>            tuple_sort_index (TwoHalfsDiff_Area, Indices)</l>
<l>            if (Indices # []) // in case there is no indices - happens if full image was segmented</l>
<c>                * select the more complete reference object</c>
<l>                select_obj (TwoHalfRegions, ReferenceHalf_Rectangle, Indices[0]+1)</l>
<l>                intersection (RegionsToMeasure_Selected, ReferenceHalf_Rectangle, ReferenceHalf_Rectangle)</l>
<c>                </c>
<l>                skeleton (MiddleLine, Skeleton)</l>
<l>                gCalculate_XY_MaxPoints_OfRotatedRegion (Skeleton, Min_RowColumn, Max_RowColumn)</l>
<l>                hom_mat2d_identity (HomMat2DIdentity)</l>
<l>                hom_mat2d_reflect (HomMat2DIdentity, Min_RowColumn[0], Min_RowColumn[1], Max_RowColumn[0], Max_RowColumn[1], HomMat2DReflect) //newer</l>
<l>                affine_trans_region (ReferenceHalf_Rectangle, ReferenceHalf_Rectangle_Mirrored, HomMat2DReflect, 'nearest_neighbor')</l>
<c>                </c>
<l>                select_obj (TwoHalfRegions, TestHalf_Rectangle, Indices[1]+1)</l>
<l>                intersection (TestHalf_Rectangle, RegionsToMeasure_Selected, TestHalf_Rectangle)</l>
<c>                * try to rematch the regions</c>
<l>                if(RepositioningActive = 1)</l>
<l>                    gRepositioning (ReferenceHalf_Rectangle_Mirrored, TestHalf_Rectangle, ImageOrig, MiddleLine, ReferenceHalf_Rectangle_Mirrored, 5.5, TimeNeeded)</l>
<l>                endif</l>
<l>                difference (ReferenceHalf_Rectangle_Mirrored, TestHalf_Rectangle, DifferencesReferenceToTestObject)</l>
<l>                union1 (DifferencesReferenceToTestObject, DifferencesReferenceToTestObject)</l>
<l>                area_center (DifferencesReferenceToTestObject, Deviation_Area, _, _) </l>
<l>            endif</l>
<l>        endif</l>
<l>        if (Deviation_Area # 0 and Deviation_Area # []) </l>
<l>            tuple_concat (DeviationValue, Deviation_Area, DeviationValue)</l>
<c>            * prepare visu output</c>
<l>            union2 (RegionsToMeasure_Selected, DifferencesReferenceToTestObject, VisuRegion)</l>
<l>            concat_obj (MeasuredVisuSymmetry, VisuRegion, MeasuredVisuSymmetry)</l>
<l>        else</l>
<l>            tuple_concat (DeviationValue, 0, DeviationValue)</l>
<l>            concat_obj (MeasuredVisuSymmetry, RegionsToMeasure_Selected, MeasuredVisuSymmetry)</l>
<l>        endif </l>
<l>    endfor</l>
<l>endif</l>
<c></c>
<l>if(DebugVisu =1)</l>
<l>    dev_set_color ('red')</l>
<l>    dev_get_window (WindowHandle)</l>
<l>    dev_display (ImageOrig)</l>
<l>    dev_display (MeasuredVisuSymmetry)</l>
<l>endif</l>
<c></c>
<l>return ()</l>
</body>
<docu id="gCalculateFeature_Symmetry">
<parameters>
<parameter id="DebugVisu"/>
<parameter id="DeviationValue"/>
<parameter id="ImageOrig"/>
<parameter id="MeasuredVisuSymmetry"/>
<parameter id="RegionsToMeasure"/>
</parameters>
</docu>
</procedure>
<procedure name="gCalculateFeature_Symmetry_AxisHorizontal">
<interface>
<io>
<par name="ImageOrig" base_type="iconic" dimension="0"/>
<par name="RegionsToMeasure" base_type="iconic" dimension="0"/>
</io>
<oo>
<par name="MeasuredVisuSymmetry" base_type="iconic" dimension="0"/>
</oo>
<oc>
<par name="DeviationValue" base_type="ctrl" dimension="0"/>
</oc>
</interface>
<body>
<c>* calculate the diviation middle of geometrical objecct to center of gravity</c>
<l>DeviationValue :=[]</l>
<l>gen_empty_obj (MeasuredVisuSymmetry)</l>
<c></c>
<l>count_obj (RegionsToMeasure, RegionsToMeasure_Number)</l>
<c></c>
<l>if (RegionsToMeasure_Number # 0)</l>
<l>    skeleton (RegionsToMeasure, Skeleton1)</l>
<c>    </c>
<l>    pruning (Skeleton1, Skeleton1, 80)</l>
<l>    dev_display (ImageOrig)</l>
<l>    dev_display (RegionsToMeasure)</l>
<l>    dev_display (Skeleton1)</l>
<l>*     stop()</l>
<c>    </c>
<l>    smallest_rectangle2 (Skeleton1, Row, Column, Phi, Length1, Length2)</l>
<l>    gen_rectangle2 (BoundigBoxRectangle, Row, Column, Phi, Length1, Length2)</l>
<c>    </c>
<l>    for Index_Cnt := 1 to RegionsToMeasure_Number by 1</l>
<l>        Deviation_Area := []</l>
<l>        select_obj (BoundigBoxRectangle, BoundigBoxRectangle_Selected, Index_Cnt)</l>
<c>        * prepare visu output</c>
<l>        concat_obj (MeasuredVisuSymmetry, BoundigBoxRectangle_Selected, MeasuredVisuSymmetry)</l>
<l>        tuple_concat (DeviationValue, Length2[Index_Cnt-1], DeviationValue)</l>
<l>    endfor</l>
<l>endif</l>
<l>* dev_display (ImageOrig)</l>
<l>* dev_display (MeasuredVisuSymmetry)</l>
<c></c>
<l>return ()</l>
</body>
<docu id="gCalculateFeature_Symmetry_AxisHorizontal">
<parameters>
<parameter id="DeviationValue"/>
<parameter id="ImageOrig"/>
<parameter id="MeasuredVisuSymmetry"/>
<parameter id="RegionsToMeasure"/>
</parameters>
</docu>
</procedure>
<procedure name="gCalculateMeanValuesOfMeasurementfeatures">
<interface>
<ic>
<par name="IndicesToSelect" base_type="ctrl" dimension="0"/>
<par name="VectorDataToSelectFrom" base_type="ctrl" dimension="2"/>
<par name="EliminateExtremeValuesInPercent" base_type="ctrl" dimension="0"/>
</ic>
<oc>
<par name="VectorMean" base_type="ctrl" dimension="1"/>
<par name="VectorDeviation" base_type="ctrl" dimension="1"/>
</oc>
</interface>
<body>
<c>* now sort the vectordata so output is vector data just for one line</c>
<l>VectorDataSelection.at(0) := {[],[]}</l>
<l>VectorFeatureLength := VectorDataToSelectFrom.length()</l>
<c></c>
<l>VectorMean := {[]}</l>
<l>VectorDeviation := {[]}</l>
<c></c>
<l>for IndexLoop := 0 to VectorFeatureLength-1 by 1</l>
<l>    VectorDataSelection.at(IndexLoop).at(0) := VectorDataToSelectFrom.at(IndexLoop).at(0)[IndicesToSelect]</l>
<l>    VectorDataSelection.at(IndexLoop).at(1) := VectorDataToSelectFrom.at(IndexLoop).at(1)[IndicesToSelect]</l>
<l>    MeasuredProcessValues := VectorDataToSelectFrom.at(IndexLoop).at(1)[IndicesToSelect]</l>
<l>    if (EliminateExtremeValuesInPercent &gt; 0 and EliminateExtremeValuesInPercent &lt; 100)</l>
<l>        tuple_length (MeasuredProcessValues, MeasuredProcessValues_Length)</l>
<l>        ReductionOfValues := MeasuredProcessValues_Length * (EliminateExtremeValuesInPercent/100.0)    </l>
<l>        tuple_round (ReductionOfValues, ReductionOfValues)</l>
<l>        tuple_sort (MeasuredProcessValues, MeasuredProcessValues)    </l>
<l>        tuple_gen_sequence (0, ReductionOfValues-1, 1, Sequence) </l>
<l>        tuple_remove (MeasuredProcessValues, Sequence, MeasuredProcessValues) // reduce the smallest values at start of tuple</l>
<l>        tuple_length (MeasuredProcessValues, MeasuredProcessValues_Length)</l>
<l>        tuple_gen_sequence (MeasuredProcessValues_Length - ReductionOfValues, MeasuredProcessValues_Length-1, 1, Sequence) </l>
<l>        tuple_remove (MeasuredProcessValues, Sequence, MeasuredProcessValues) // reduce the biggest values at end of tuple    </l>
<l>    endif</l>
<c>    </c>
<l>    if (MeasuredProcessValues # [])</l>
<l>      tuple_deviation (MeasuredProcessValues, Deviation)  </l>
<l>      tuple_mean (MeasuredProcessValues, Mean)</l>
<l>    else</l>
<l>        Deviation := []</l>
<l>        Mean := []</l>
<l>    endif</l>
<c>    </c>
<l>    VectorDeviation.at(IndexLoop) := Deviation</l>
<c>   </c>
<l>    VectorMean.at(IndexLoop) := Mean</l>
<l>    if ( IndexLoop = 0 )</l>
<l>        if ( VectorDataToSelectFrom.at(IndexLoop).at(2) = [])</l>
<l>            VectorDataSelection.at(IndexLoop).at(2) := []</l>
<l>        else</l>
<l>            VectorDataSelection.at(IndexLoop).at(2) := VectorDataToSelectFrom.at(IndexLoop).at(2)[0]</l>
<l>        endif</l>
<l>    endif</l>
<l>endfor</l>
<c></c>
<c></c>
<l>* Resolution_PixelToMM := 9.625/2</l>
<l>* Resolution_PixelToMM := 14.70588/2</l>
<c>* on 75mm lens around 17,91pixel/mm</c>
<l>return()</l>
</body>
<docu id="gCalculateMeanValuesOfMeasurementfeatures">
<parameters>
<parameter id="EliminateExtremeValuesInPercent"/>
<parameter id="IndicesToSelect"/>
<parameter id="VectorDataToSelectFrom"/>
<parameter id="VectorDeviation"/>
<parameter id="VectorMean"/>
</parameters>
</docu>
</procedure>
<procedure name="gCalculateSpots_GetSpotsInProductInnerRegion">
<interface>
<io>
<par name="SegmentedTabletsWithoutMirrors" base_type="iconic" dimension="0"/>
</io>
<oo>
<par name="SpotsOnIndividualTablet" base_type="iconic" dimension="0"/>
<par name="TabletRegionCheckedForSpots" base_type="iconic" dimension="0"/>
</oo>
</interface>
<body>
<c></c>
<c>* use convex hull - necessary if spots are on edge of product</c>
<l>shape_trans (SegmentedTabletsWithoutMirrors, Convex_Region, 'convex')</l>
<c>* due to shape trans may be different from eroded object reduce the outer hull minimal</c>
<l>dilation_rectangle1 (SegmentedTabletsWithoutMirrors, SegmentedTabletsWithoutMirrors, 3, 3)</l>
<c></c>
<c></c>
<l>difference (Convex_Region, SegmentedTabletsWithoutMirrors, SpotsOnIndividualTablet)</l>
<c>* prepare output</c>
<l>TabletRegionCheckedForSpots := Convex_Region</l>
<c></c>
<l>difference (TabletRegionCheckedForSpots, SpotsOnIndividualTablet, TabletRegionCheckedForSpots)</l>
<c></c>
<l>return ()</l>
</body>
<docu id="gCalculateSpots_GetSpotsInProductInnerRegion">
<parameters>
<parameter id="SegmentedTabletsWithoutMirrors"/>
<parameter id="SpotsOnIndividualTablet"/>
<parameter id="TabletRegionCheckedForSpots"/>
</parameters>
</docu>
</procedure>
<procedure name="gCalculateSpotsOnExtractedTabletWithoutMirror">
<interface>
<io>
<par name="SegmentedTabletsWithoutMirrors" base_type="iconic" dimension="0"/>
<par name="Image" base_type="iconic" dimension="0"/>
</io>
<oo>
<par name="TabletRegionCheckedForSpots" base_type="iconic" dimension="0"/>
<par name="GoodTablet" base_type="iconic" dimension="0"/>
<par name="BadTablet" base_type="iconic" dimension="0"/>
</oo>
<ic>
<par name="TabletSpotdetection_Minsize" base_type="ctrl" dimension="0"/>
<par name="TabletWidth_Min" base_type="ctrl" dimension="0"/>
</ic>
<oc>
<par name="SpotsArea_Measured" base_type="ctrl" dimension="0"/>
</oc>
</interface>
<body>
<l>SpotsArea_Measured := 0</l>
<l>gen_empty_obj (GoodTablet)</l>
<l>gen_empty_obj (BadTablet)</l>
<l>gen_empty_obj (TabletRegionCheckedForSpots)</l>
<c>* </c>
<c>* </c>
<l>count_obj (SegmentedTabletsWithoutMirrors, SegmentedTablesWithoutMirrors_Number)</l>
<l>if (SegmentedTablesWithoutMirrors_Number &gt; 0)</l>
<l>    gCalculateSpots_GetSpotsInProductInnerRegion (SegmentedTabletsWithoutMirrors, SpotsOnIndividualTablet, TabletRegionCheckedForSpots)</l>
<c></c>
<c>    * just use biggest single spot</c>
<l>    connection (SpotsOnIndividualTablet, SpotsOnIndividualTablet)</l>
<c>    </c>
<c>    *get Maxarea of spots</c>
<l>    area_center (SpotsOnIndividualTablet, SpotsOnIndividualTablet_Nonfiltered_Area, _, _)</l>
<l>    tuple_sort_index (-SpotsOnIndividualTablet_Nonfiltered_Area, Indices_Nonfiltered)</l>
<l>    if (Indices_Nonfiltered # [])</l>
<l>        SpotsArea_Measured := SpotsOnIndividualTablet_Nonfiltered_Area[Indices_Nonfiltered[0]]</l>
<l>    else</l>
<l>        SpotsArea_Measured := 0</l>
<l>    endif</l>
<c>    *get Maxarea for later use** end</c>
<l>    if(SpotsArea_Measured &gt;= TabletSpotdetection_Minsize)</l>
<c>        * gen values for measurement</c>
<l>        BadTablet := TabletRegionCheckedForSpots</l>
<l>    else</l>
<l>        GoodTablet := TabletRegionCheckedForSpots</l>
<l>    endif</l>
<l>else</l>
<l>    SpotsArea_Measured := [] // in case nothing was measured</l>
<l>endif</l>
<c></c>
<c>************************************</c>
<l>return()    </l>
</body>
<docu id="gCalculateSpotsOnExtractedTabletWithoutMirror">
<parameters>
<parameter id="BadTablet"/>
<parameter id="GoodTablet"/>
<parameter id="Image"/>
<parameter id="SegmentedTabletsWithoutMirrors"/>
<parameter id="SpotsArea_Measured"/>
<parameter id="TabletRegionCheckedForSpots"/>
<parameter id="TabletSpotdetection_Minsize"/>
<parameter id="TabletWidth_Min"/>
</parameters>
</docu>
</procedure>
<procedure name="gCalibration_TeachIn_CollectData">
<interface>
<io>
<par name="Products_IMeasuredRegionsPerFeature" base_type="iconic" dimension="1"/>
<par name="ImageOrig_RGB" base_type="iconic" dimension="2"/>
<par name="gRinnenROIs" base_type="iconic" dimension="1"/>
<par name="gEjectROIs" base_type="iconic" dimension="1"/>
</io>
<ic>
<par name="StoreProductData_Straight0_ProductAccumulated1" base_type="ctrl" dimension="0"/>
<par name="Calibration_TeachIn_Active" base_type="ctrl" dimension="0"/>
<par name="CalibrationObject_MeasureSystemAnalyses_Active" base_type="ctrl" dimension="0"/>
<par name="gROI_NumberOfPos" base_type="ctrl" dimension="0"/>
<par name="gProducts_VT_MeasureResult_MeasureValues" base_type="ctrl" dimension="2"/>
<par name="Camera_DeviceNumberUsedForGrabbing" base_type="ctrl" dimension="0"/>
<par name="ErrorObjectDataToStore_VLane_VMeasureFeature_TResult_TValue" base_type="ctrl" dimension="3"/>
<par name="Calibration_VCamera_VLane_VMeasureFeature_TResult_TValue" base_type="ctrl" dimension="4"/>
</ic>
<oc>
<par name="Calibration_VCamera_VLane_VMeasureFeature_TResult_TValueOut" base_type="ctrl" dimension="4"/>
</oc>
</interface>
<body>
<l>gen_empty_obj (EmptyObject)</l>
<c></c>
<c>                    </c>
<c>* implementation for calibration data collection</c>
<c>* from upstream the measured data is taken. It is filtered by length and width (relevant calibration data). The result is stored in vector that stores in relation to camera and lanes</c>
<c>* Hint: the data is only stored if a camera number could be found from input</c>
<l>* if( StoreProductData_Straight0_ProductAccumulated1 = 0)</l>
<l>    Calibration_VCamera_VLane_VMeasureFeature_TResult_TValueOut := Calibration_VCamera_VLane_VMeasureFeature_TResult_TValue</l>
<l>* else</l>
<l>*     Calibration_VCamera_VLane_VMeasureFeature_TResult_TValueOut.at(0) := ErrorObjectDataToStore_VLane_VMeasureFeature_TResult_TValue</l>
<l>* endif</l>
<c></c>
<c>* collect data per camera per lane</c>
<l>if (Calibration_TeachIn_Active = 1 or CalibrationObject_MeasureSystemAnalyses_Active = 1)</l>
<c>    * only store data if relevant camera number could be found</c>
<l>    dev_error_var (ErrorVar, 1)</l>
<l>    dev_set_check ('~give_error')</l>
<l>    tuple_int (Camera_DeviceNumberUsedForGrabbing, Int)</l>
<l>    Error := ErrorVar</l>
<l>    dev_set_check ('give_error')</l>
<l>    if( Error = 2)</l>
<c>        * get width and length indices from measured data array- necessary due to features are configurable</c>
<l>        for IndexLine := 0 to gROI_NumberOfPos[Camera_DeviceNumberUsedForGrabbing]-1 by 1 </l>
<c>            * select line specific data. Reformat measured data with row (low and high) information </c>
<l>            Feature_Width_NoInSet := []</l>
<l>            Feature_Length_NoInSet := []</l>
<l>            for Index_Feature := 0 to gProducts_VT_MeasureResult_MeasureValues.length()-1 by 1</l>
<l>                Feature_Name := gProducts_VT_MeasureResult_MeasureValues.at(Index_Feature).at(2)[0]</l>
<l>                if(Feature_Name = 'Calculation_Length')</l>
<l>                    Feature_Length_NoInSet := Index_Feature</l>
<l>                endif</l>
<l>                if(Feature_Name = 'Calculation_Width')</l>
<l>                    Feature_Width_NoInSet := Index_Feature</l>
<l>                endif</l>
<l>            endfor</l>
<c>            * some init to use standard procedure</c>
<c></c>
<c>            </c>
<l>            if(StoreProductData_Straight0_ProductAccumulated1 = 0)</l>
<c>                * extraction from raw product measure</c>
<l>                Products_VT_MeasureResult_MeasureValues_Reduced.at(0) := gProducts_VT_MeasureResult_MeasureValues.at(Feature_Width_NoInSet)</l>
<l>                Products_VT_MeasureResult_MeasureValues_Reduced.at(1) := gProducts_VT_MeasureResult_MeasureValues.at(Feature_Length_NoInSet)</l>
<c>                </c>
<l>                Products_IMeasuredRegionsPerFeature_Reduced.at(0) := Products_IMeasuredRegionsPerFeature.at(Feature_Width_NoInSet)</l>
<l>                Products_IMeasuredRegionsPerFeature_Reduced.at(1) := Products_IMeasuredRegionsPerFeature.at(Feature_Length_NoInSet)</l>
<l>                gSelect_LinespecificData_MeasuresDataOnly (ImageOrig_RGB.at(0).at(0), gRinnenROIs.at(Camera_DeviceNumberUsedForGrabbing), gEjectROIs.at(Camera_DeviceNumberUsedForGrabbing), Products_IMeasuredRegionsPerFeature_Reduced, Products_IMeasuredRegionsPerFeature_OneLine, IndexLine, Products_VT_MeasureResult_MeasureValues_Reduced, Products_VT_MeasureResult_MeasureValues_OneLine)</l>
<c></c>
<l>            else</l>
<c>                * extraction from accumulated data per product</c>
<c>                </c>
<l>                if(ErrorObjectDataToStore_VLane_VMeasureFeature_TResult_TValue.at(IndexLine).length() &gt;= Feature_Width_NoInSet) // clean data</l>
<l>*                     stop()</l>
<l>*                     ErrorSpecificData := ErrorObjectDataToStore_VLane_VMeasureFeature_TResult_TValue.at(IndexLine).at(Feature_Width_NoInSet).at(1)         </l>
<l>                    ErrorSpecificData1 := ErrorObjectDataToStore_VLane_VMeasureFeature_TResult_TValue.at(IndexLine).at(Feature_Width_NoInSet).at(0) </l>
<c>                    * clean the data from out of range data by deleting highest ans smallest values        </c>
<c> </c>
<l>                    gRemove_FirstAndLast_NValues_FromTuple (ErrorObjectDataToStore_VLane_VMeasureFeature_TResult_TValue.at(IndexLine).at(Feature_Width_NoInSet).at(1), 20, ErrorObjectDataToStore_VLane_VMeasureFeature_TResult_TValue.at(IndexLine).at(Feature_Width_NoInSet).at(1), IndicesRemoved)</l>
<l>                    tuple_remove (ErrorObjectDataToStore_VLane_VMeasureFeature_TResult_TValue.at(IndexLine).at(Feature_Width_NoInSet).at(0) , IndicesRemoved, ErrorObjectDataToStore_VLane_VMeasureFeature_TResult_TValue.at(IndexLine).at(Feature_Width_NoInSet).at(0) )</l>
<c>                    </c>
<l>                    gRemove_FirstAndLast_NValues_FromTuple (ErrorObjectDataToStore_VLane_VMeasureFeature_TResult_TValue.at(IndexLine).at(Feature_Length_NoInSet).at(1), 20, ErrorObjectDataToStore_VLane_VMeasureFeature_TResult_TValue.at(IndexLine).at(Feature_Length_NoInSet).at(1), IndicesRemoved)</l>
<l>                    tuple_remove (ErrorObjectDataToStore_VLane_VMeasureFeature_TResult_TValue.at(IndexLine).at(Feature_Length_NoInSet).at(0) , IndicesRemoved, ErrorObjectDataToStore_VLane_VMeasureFeature_TResult_TValue.at(IndexLine).at(Feature_Length_NoInSet).at(0) )</l>
<c>         </c>
<l>                    Products_VT_MeasureResult_MeasureValues_Reduced.at(0) := ErrorObjectDataToStore_VLane_VMeasureFeature_TResult_TValue.at(IndexLine).at(Feature_Width_NoInSet)</l>
<l>                    Products_VT_MeasureResult_MeasureValues_Reduced.at(1) := ErrorObjectDataToStore_VLane_VMeasureFeature_TResult_TValue.at(IndexLine).at(Feature_Length_NoInSet)</l>
<c>                    </c>
<l>                    Products_IMeasuredRegionsPerFeature_Reduced.at(0) := EmptyObject</l>
<l>                    Products_IMeasuredRegionsPerFeature_Reduced.at(1) := EmptyObject</l>
<c></c>
<l>*                   ddd :=  Calibration_VCamera_VLane_VMeasureFeature_TResult_TValueOut.at(Camera_DeviceNumberUsedForGrabbing).at(IndexLine)</l>
<l>                    MeasureResults_OneProduct_Count := |ErrorObjectDataToStore_VLane_VMeasureFeature_TResult_TValue.at(IndexLine).at(Feature_Width_NoInSet).at(0)|</l>
<l>*                     stop()</l>
<l>                else // should be empty - added to be compatible to downstream data</l>
<c></c>
<l>                    Products_IMeasuredRegionsPerFeature_Reduced.at(0) := EmptyObject</l>
<l>                    Products_IMeasuredRegionsPerFeature_Reduced.at(1) := EmptyObject</l>
<c>                    </c>
<l>                    for Index_Cnt2 := 0 to Products_IMeasuredRegionsPerFeature_Reduced.length()-1 by 1</l>
<l>                        Products_IMeasuredRegionsPerFeature_Reduced.at(Index_Cnt2) := EmptyObject</l>
<l>                    endfor</l>
<l>                   Products_VT_MeasureResult_MeasureValues_Reduced.at(0) := {[],[],['Calculation_Width', 0.000, 10.000]}</l>
<l>                   Products_VT_MeasureResult_MeasureValues_Reduced.at(1) := {[],[],['Calculation_Length', 0.000, 10.000]}</l>
<l>                endif</l>
<l>                Products_VT_MeasureResult_MeasureValues_OneLine := Products_VT_MeasureResult_MeasureValues_Reduced</l>
<l>                Products_IMeasuredRegionsPerFeature_OneLine.at(0) := EmptyObject</l>
<l>            endif</l>
<c>      </c>
<l>*             gSelect_LinespecificData_MeasuresDataOnly (ImageOrig_RGB.at(0).at(0), gRinnenROIs.at(Camera_DeviceNumberUsedForGrabbing), gEjectROIs.at(Camera_DeviceNumberUsedForGrabbing), Products_IMeasuredRegionsPerFeature_Reduced, Products_IMeasuredRegionsPerFeature_OneLine, IndexLine, Products_VT_MeasureResult_MeasureValues_Reduced, Products_VT_MeasureResult_MeasureValues_OneLine)</l>
<c>            </c>
<l>            Shiftregister_IImagePartsPerObject_Out.at(0) := EmptyObject</l>
<l>            Shiftregister_VMeasuredFeatures_IRegionPerFeature_Out.at(0) := EmptyObject</l>
<l>            Products_IImagePartsPerObject.at(0) := EmptyObject</l>
<l>            Products_VMeasureFeature_TResult_TValue.at(0) := []</l>
<l>            Products_VImagePartsOffset_TRow_TColumn.at(0) := []</l>
<l>            Shiftregister_VMeasureFeature_TResult_TValue_Out.at(0).at(0) := []</l>
<l>            Shiftregister_VImagePartsOffset_TRow_TColumn_Out.at(0) := []</l>
<c>            </c>
<l>            Shiftregister_VMeasureFeature_TResult_TValue_Out := Calibration_VCamera_VLane_VMeasureFeature_TResult_TValueOut.at(Camera_DeviceNumberUsedForGrabbing).at(IndexLine)</l>
<c>         </c>
<l>            gShiftregister_AddDataToVector (Shiftregister_IImagePartsPerObject_Out, Shiftregister_VMeasuredFeatures_IRegionPerFeature_Out, Products_IImagePartsPerObject, Products_IMeasuredRegionsPerFeature_OneLine, Shiftregister_IImagePartsPerObject_Out, Shiftregister_VMeasuredFeatures_IRegionPerFeature_Out, Products_VT_MeasureResult_MeasureValues_OneLine, Shiftregister_VMeasureFeature_TResult_TValue_Out, Products_VImagePartsOffset_TRow_TColumn, Shiftregister_VImagePartsOffset_TRow_TColumn_Out, 1, 1, 0, Shiftregister_VMeasureFeature_TResult_TValue_Out, ProductsVectorLength, Shiftregister_VImagePartsOffset_TRow_TColumn_Out)</l>
<l>            Calibration_VCamera_VLane_VMeasureFeature_TResult_TValueOut.at(Camera_DeviceNumberUsedForGrabbing).at(IndexLine) := Shiftregister_VMeasureFeature_TResult_TValue_Out</l>
<l>            MeasureResults_Acucumulated_Count := |Calibration_VCamera_VLane_VMeasureFeature_TResult_TValueOut.at(Camera_DeviceNumberUsedForGrabbing).at(IndexLine).at(0).at(0)|</l>
<l>        endfor</l>
<c>        </c>
<l>*         Shiftregister_VMeasureFeature_TResult_TValue_Out := Calibration_VCamera_VLane_VMeasureFeature_TResult_TValueOut.at(Camera_DeviceNumberUsedForGrabbing).at(IndexLine)</l>
<l>*         gShiftregister_AddDataToVector (Shiftregister_IImagePartsPerObject_Out, Shiftregister_VMeasuredFeatures_IRegionPerFeature_Out, Products_IImagePartsPerObject, Products_IMeasuredRegionsPerFeature_OneLine, Shiftregister_IImagePartsPerObject_Out, Shiftregister_VMeasuredFeatures_IRegionPerFeature_Out, Products_VT_MeasureResult_MeasureValues_OneLine, Shiftregister_VMeasureFeature_TResult_TValue_Out, Products_VImagePartsOffset_TRow_TColumn, Shiftregister_VImagePartsOffset_TRow_TColumn_Out, 1, 1, 0, Shiftregister_VMeasureFeature_TResult_TValue_Out, ProductsVectorLength, Shiftregister_VImagePartsOffset_TRow_TColumn_Out)</l>
<l>*         Calibration_VCamera_VLane_VMeasureFeature_TResult_TValueOut.at(Camera_DeviceNumberUsedForGrabbing).at(IndexLine) := Shiftregister_VMeasureFeature_TResult_TValue_Out</l>
<l>*         MeasureResults_Acucumulated_Count := |Calibration_VCamera_VLane_VMeasureFeature_TResult_TValueOut.at(Camera_DeviceNumberUsedForGrabbing).at(IndexLine).at(0).at(0)|</l>
<c></c>
<l>    endif</l>
<l>endif</l>
<l>return ()</l>
</body>
<docu id="gCalibration_TeachIn_CollectData">
<parameters>
<parameter id="CalibrationObject_MeasureSystemAnalyses_Active"/>
<parameter id="Calibration_TeachIn_Active"/>
<parameter id="Calibration_VCamera_VLane_VMeasureFeature_TResult_TValue"/>
<parameter id="Calibration_VCamera_VLane_VMeasureFeature_TResult_TValueOut"/>
<parameter id="Camera_DeviceNumberUsedForGrabbing"/>
<parameter id="ErrorObjectDataToStore_VLane_VMeasureFeature_TResult_TValue"/>
<parameter id="ImageOrig_RGB"/>
<parameter id="Products_IMeasuredRegionsPerFeature"/>
<parameter id="StoreProductData_Straight0_ProductAccumulated1"/>
<parameter id="gEjectROIs"/>
<parameter id="gProducts_VT_MeasureResult_MeasureValues"/>
<parameter id="gROI_NumberOfPos"/>
<parameter id="gRinnenROIs"/>
</parameters>
</docu>
</procedure>
<procedure name="gCalibration_TeachIn_WriteToFile">
<interface>
<ic>
<par name="Calibration_TeachIn_Active" base_type="ctrl" dimension="0"/>
<par name="CalibrationObject_MeasureSystemAnalyses_Active" base_type="ctrl" dimension="0"/>
<par name="Calibration_VCamera_VLane_VMeasureFeature_TResult_TValue" base_type="ctrl" dimension="4"/>
<par name="FormatPath" base_type="ctrl" dimension="0"/>
</ic>
<oc>
<par name="Calibration_VCamera_VLane_PixToMM_XY" base_type="ctrl" dimension="2"/>
</oc>
</interface>
<body>
<l>global tuple vector(1) gVTFiledefinitions</l>
<l>global tuple vector(1) gVTCalibration</l>
<l>global tuple vector(3) gCalibration_VTCamera_VTLane_VTPixToMM_XY</l>
<c></c>
<l>wsw := gCalibration_VTCamera_VTLane_VTPixToMM_XY</l>
<l>set_system ('filename_encoding', 'utf8') // otherwise the ä,öü are not displayed corrently in engine environment- it is correct in hdev environemnt</l>
<c></c>
<c></c>
<c>* Procedure gets calculated data from calibration objects in langth and width- per camera and lane. For the tuple data in pixel a mean value is calculated and set in relation to the object length and width in mm</c>
<c>* the data then is stored to the calibration.json file</c>
<l>Calibration_VCamera_VLane_PixToMM_XY.at(0).at(0) := []</l>
<l>Calibration_X_Pixeldata_AllDataCollected := []</l>
<l>Calibration_Y_Pixeldata_AllDataCollected := []</l>
<c></c>
<l>if(CalibrationObject_MeasureSystemAnalyses_Active = 1 and Calibration_TeachIn_Active= 1) // only one feature can work at a time</l>
<l>    CalibrationObject_MeasureSystemAnalyses_Active := 0</l>
<l>endif</l>
<c></c>
<l>if (Calibration_TeachIn_Active = 1 or CalibrationObject_MeasureSystemAnalyses_Active)</l>
<l>    gGetSubObjectVariables_SingleValue (gVTFiledefinitions, 'CalibrationFilename', CalibrationFilename)    </l>
<l>    gJSON_Read_File_to_Vector (CalibrationFilename, ParameterVector)</l>
<c>    </c>
<c>    *************************************************************************************************</c>
<c>    </c>
<l>    gGetSubObjectVariables_SingleValue (gVTCalibration, '/General/V_CalibrationObject_Length_MM/Value', CalibrationObject_Length_MM)</l>
<l>    gGetSubObjectVariables_SingleValue (gVTCalibration,'/General/V_CalibrationObject_Width_MM/Value', CalibrationObject_Width_MM)</l>
<c>    </c>
<l>    LanesProcessedCount := 0</l>
<l>    Calibration_CameraCount := Calibration_VCamera_VLane_VMeasureFeature_TResult_TValue.length() </l>
<l>    for Index_Camera := 0 to Calibration_CameraCount-1 by 1</l>
<l>        Calibration_ROICount := Calibration_VCamera_VLane_VMeasureFeature_TResult_TValue.at(Index_Camera).length()       </l>
<l>        for Index_ROICount := 0 to Calibration_ROICount -1 by 1</l>
<l>            FeatureSetMeasured := Calibration_VCamera_VLane_VMeasureFeature_TResult_TValue.at(Index_Camera).at(Index_ROICount)</l>
<l>            if(FeatureSetMeasured.at(0).at(0) # [])</l>
<l>                Calibration_X_Pixeldata := FeatureSetMeasured.at(0).at(1)</l>
<l>                Calibration_Y_Pixeldata := FeatureSetMeasured.at(1).at(1)</l>
<l>                Calibration_X_Pixeldata_Mean := []</l>
<l>                Calibration_Y_Pixeldata_Mean := []</l>
<l>                Calibration_X_PixPerMM := []</l>
<l>                Calibration_Y_PixPerMM := []</l>
<l>                if (Calibration_X_Pixeldata # []) // if nothing was measured no data can be stored</l>
<c>                    * for calibration we need to filter the data- eliminate the smallest and biggest values to reduce data noise</c>
<l>                    if (Calibration_TeachIn_Active = 1)</l>
<l>                        PercentageToRemove := 20</l>
<l>                        gRemove_FirstAndLast_NValues_FromTuple (Calibration_X_Pixeldata, PercentageToRemove, Calibration_X_Pixeldata, IndicesRemoved)</l>
<l>                        gRemove_FirstAndLast_NValues_FromTuple (Calibration_Y_Pixeldata, PercentageToRemove, Calibration_Y_Pixeldata, IndicesRemoved1)</l>
<l>                    endif</l>
<l>*               stop()</l>
<c>              </c>
<l>                    tuple_mean (Calibration_X_Pixeldata, Calibration_X_Pixeldata_Mean)</l>
<l>                    tuple_mean (Calibration_Y_Pixeldata, Calibration_Y_Pixeldata_Mean)</l>
<l>                    tuple_deviation (Calibration_X_Pixeldata, Calibration_X_Deviation)</l>
<l>                    tuple_deviation (Calibration_Y_Pixeldata, Calibration_Y_Deviation)</l>
<l>                    Calibration_X_PixPerMM := Calibration_X_Pixeldata_Mean/CalibrationObject_Width_MM</l>
<l>                    Calibration_Y_PixPerMM := Calibration_Y_Pixeldata_Mean/CalibrationObject_Length_MM</l>
<l>                    Calibration_VCamera_VLane_PixToMM_XY.at(Index_Camera).at(Index_ROICount) := [Calibration_X_PixPerMM, Calibration_Y_PixPerMM]</l>
<c>                    * add data into json for storage</c>
<l>                    gJSON_Set_Value_in_Vector ('/Calibration/Calib_Cam_' + Index_Camera + '/V_CalibX_PixToMM_' + Index_ROICount + '/Value', ParameterVector, Calibration_X_PixPerMM, ParameterVector)   </l>
<l>                    gJSON_Set_Value_in_Vector ('/Calibration/Calib_Cam_' + Index_Camera + '/V_CalibY_PixToMM_' + Index_ROICount + '/Value', ParameterVector, Calibration_Y_PixPerMM, ParameterVector)   </l>
<c>                    * collect data for MeasureSystemAnalyses   </c>
<l>                    Calibration_X_Pixeldata_AllDataCollected := [Calibration_X_Pixeldata_AllDataCollected, Calibration_X_Pixeldata]</l>
<l>                    Calibration_Y_Pixeldata_AllDataCollected := [Calibration_Y_Pixeldata_AllDataCollected, Calibration_Y_Pixeldata]</l>
<l>                    if(CalibrationObject_MeasureSystemAnalyses_Active = 1)</l>
<l>                        gTeachIn_WriteMSA_Data (Calibration_X_Pixeldata, FormatPath + 'MSA_File_Width_Cam' + (Index_Camera +1) + '_Lane' +  (Index_ROICount +1) + '.dat')</l>
<l>                        gTeachIn_WriteMSA_Data (Calibration_Y_Pixeldata, FormatPath + 'MSA_File_Length_Cam' + (Index_Camera +1) + '_Lane' +  (Index_ROICount +1) + '.dat')  </l>
<l>                    endif</l>
<l>                endif </l>
<l>                VTPlotTableData_Calibration.at(LanesProcessedCount) := [LanesProcessedCount+1, Calibration_X_Pixeldata_Mean, Calibration_Y_Pixeldata_Mean, Calibration_X_PixPerMM, Calibration_Y_PixPerMM, Calibration_X_PixPerMM - gCalibration_VTCamera_VTLane_VTPixToMM_XY.at(Index_Camera).at(Index_ROICount).at(0), Calibration_Y_PixPerMM - gCalibration_VTCamera_VTLane_VTPixToMM_XY.at(Index_Camera).at(Index_ROICount).at(1)]         </l>
<l>                VTPlotTableData_MeasureSystemAnalyses.at(LanesProcessedCount) := [LanesProcessedCount+1, Calibration_X_Pixeldata_Mean, Calibration_X_Deviation, Calibration_Y_Pixeldata_Mean, Calibration_Y_Deviation, gCalibration_VTCamera_VTLane_VTPixToMM_XY.at(Index_Camera).at(Index_ROICount).at(1), gCalibration_VTCamera_VTLane_VTPixToMM_XY.at(Index_Camera).at(Index_ROICount).at(0), |Calibration_X_Pixeldata|]</l>
<c></c>
<l>                LanesProcessedCount := LanesProcessedCount +1</l>
<l>            endif</l>
<l>        endfor</l>
<l>    endfor  </l>
<c> </c>
<c>    * section for Calibration Teach In    </c>
<l>    if (Calibration_TeachIn_Active = 1)</l>
<l>        csHeader[0] := 'Spur'</l>
<l>        csHeader[1] := 'Durchmesser Ø [pxl]'</l>
<l>        csHeader[2] := 'Länge L [pxl]'</l>
<l>        csHeader[3] := 'Durchmesser Ø [pxl/mm]'</l>
<l>        csHeader[4] := 'Länge L [pxl/mm]'</l>
<l>        csHeader[5] := 'Veränderung Ø'</l>
<l>        csHeader[6] := 'Veränderung L'    </l>
<l>        gplot_List (PlottedList, csHeader, VTPlotTableData_Calibration, 18)</l>
<c>        </c>
<l>        get_image_size (PlottedList, PlottedList_Width, PlottedList_Height)</l>
<l>        dev_set_part (0, 0, PlottedList_Height, PlottedList_Width)</l>
<l>        dev_display (PlottedList)</l>
<c>        </c>
<c>        * Write JSON-File in copy of original</c>
<l>        gJSON_Save_Vector_as_File (CalibrationFilename, ParameterVector) </l>
<c>        </c>
<c>        ** write data to audit file</c>
<l>        AuditMessage := 'Justierung wurde durchgeführt.'</l>
<l>        open_file ('C:/CountSecure/temp/audit.txt', 'output', FileHandle)</l>
<l>        fwrite_string (FileHandle, AuditMessage)</l>
<l>        close_file (FileHandle)</l>
<l>    endif</l>
<c>    </c>
<c>    * section for Measure System Aanalyses</c>
<l>    if(CalibrationObject_MeasureSystemAnalyses_Active = 1)</l>
<l>        csHeader[0] := 'Spur'</l>
<l>        csHeader[1] := 'Durchmesser Ø [mm]'</l>
<l>        csHeader[2] := 'Ø Stdabw [mm]'</l>
<l>        csHeader[3] := 'Länge L [mm]'</l>
<l>        csHeader[4] := 'L Stdabw [mm]'</l>
<l>        csHeader[5] := 'Umrechfakt Ø [pxl/mm]'</l>
<l>        csHeader[6] := 'Umrechfakt L [pxl/mm]'</l>
<l>        csHeader[7] := 'Anzahl Werte'</l>
<l>        gplot_List (PlottedList, csHeader, VTPlotTableData_MeasureSystemAnalyses, 18)</l>
<c>        </c>
<l>        get_image_size (PlottedList, PlottedList_Width, PlottedList_Height)</l>
<l>        dev_set_part (0, 0, PlottedList_Height, PlottedList_Width)</l>
<l>        dev_display (PlottedList)</l>
<l>        gTeachIn_WriteMSA_Data (Calibration_X_Pixeldata_AllDataCollected, FormatPath + 'MSA_File_Width_AllLines.dat')</l>
<l>        gTeachIn_WriteMSA_Data (Calibration_Y_Pixeldata_AllDataCollected, FormatPath + 'MSA_File_Length_AllLines.dat')      </l>
<l>    endif       </l>
<l>endif</l>
<c>* halcon fix -if white was used before it is storen in buffer for some reason</c>
<l>dev_open_window (50, 50, 1024, 768, 'black', WindowHandle)</l>
<l>dev_close_window()</l>
<l>* stop()</l>
<c></c>
<l>return ()</l>
</body>
<docu id="gCalibration_TeachIn_WriteToFile">
<parameters>
<parameter id="CalibrationObject_MeasureSystemAnalyses_Active"/>
<parameter id="Calibration_TeachIn_Active"/>
<parameter id="Calibration_VCamera_VLane_PixToMM_XY"/>
<parameter id="Calibration_VCamera_VLane_VMeasureFeature_TResult_TValue"/>
<parameter id="FormatPath"/>
</parameters>
</docu>
</procedure>
<procedure name="gChunkDataSignalEdgeDetector">
<interface>
<io>
<par name="GrabImage" base_type="iconic" dimension="0"/>
</io>
<ic>
<par name="LastStateIn" base_type="ctrl" dimension="0"/>
<par name="CurrentState" base_type="ctrl" dimension="0"/>
<par name="Polarity" base_type="ctrl" dimension="0"/>
<par name="LineNumber" base_type="ctrl" dimension="0"/>
<par name="GrabLoopCounter" base_type="ctrl" dimension="0"/>
<par name="CameraId" base_type="ctrl" dimension="0"/>
</ic>
<oc>
<par name="LastStateOut" base_type="ctrl" dimension="0"/>
<par name="PLCWatchdogSignal_Out" base_type="ctrl" dimension="0"/>
</oc>
</interface>
<body>
<c>* todo: remove procedure from library</c>
<c></c>
<c></c>
<c></c>
<l>* global def tuple gMachineShiftregister_Index</l>
<l>* global tuple vector(1) gPLC_CommunicationSocket</l>
<c></c>
<c>* check for rising flank (Polarity == 0) </c>
<l>* if (Polarity = 0)</l>
<l>*     LastPol := 0</l>
<l>*     CurPol := 1</l>
<c>    * check for falling flank (Polarity == 1)</c>
<l>* elseif (Polarity == 1)</l>
<l>*     LastPol := 1</l>
<l>*     CurPol := 0</l>
<l>* else</l>
<c>    * wrong input</c>
<l>* endif</l>
<c></c>
<l>* CurrentState := (rsh(CurrentState, LineNumber-1) band 1 ) != 0</l>
<c></c>
<l>* if(LastStateIn = LastPol and CurrentState = CurPol)</l>
<l>*     gMachineShiftregister_Index := gMachineShiftregister_Index +1</l>
<l>*     if(gMachineShiftregister_Index = 256) // MachineShiftregister_Index allowed range is 1-255</l>
<l>*         gMachineShiftregister_Index := 1</l>
<l>*     endif </l>
<l>* endif</l>
<c></c>
<c></c>
<l>* LastStateOut := CurrentState</l>
<c></c>
<c></c>
<l>* return ()</l>
</body>
<docu id="gChunkDataSignalEdgeDetector">
<parameters>
<parameter id="CameraId"/>
<parameter id="CurrentState"/>
<parameter id="GrabImage"/>
<parameter id="GrabLoopCounter"/>
<parameter id="LastStateIn"/>
<parameter id="LastStateOut"/>
<parameter id="LineNumber"/>
<parameter id="PLCWatchdogSignal_Out"/>
<parameter id="Polarity"/>
</parameters>
</docu>
</procedure>
<procedure name="gCorrectResultIndexForProductTracking">
<interface>
<ic>
<par name="Products_VT_MeasureResult_MeasureValues" base_type="ctrl" dimension="2"/>
</ic>
<oc>
<par name="Products_VT_MeasureResult_MeasureValues_Out" base_type="ctrl" dimension="2"/>
</oc>
</interface>
<body>
<c>* if one Result is "-1" for a product (on border- so only tracking) set all results to "-1"</c>
<l>Products_VT_MeasureResult_MeasureValues_Out := Products_VT_MeasureResult_MeasureValues</l>
<l>ProductsMeasured := 0</l>
<c></c>
<l>VectorLength := Products_VT_MeasureResult_MeasureValues.length()</l>
<c>* check number of measured product results</c>
<l>if(VectorLength # [])</l>
<l>    ProductsMeasured := |Products_VT_MeasureResult_MeasureValues.at(0).at(0)|</l>
<l>endif</l>
<c></c>
<l>for IndexCnt_Products := 0 to ProductsMeasured-1 by 1</l>
<l>    AccumulatedResults := []</l>
<c></c>
<l>    for IndexCnt := 0 to VectorLength-1 by 1</l>
<l>        AccumulatedResults := [AccumulatedResults,Products_VT_MeasureResult_MeasureValues.at(IndexCnt).at(0)[IndexCnt_Products]]</l>
<l>    endfor</l>
<c>    </c>
<l>    tuple_find (AccumulatedResults, -1, Indices)</l>
<l>    if (Indices # -1 and Indices # [])</l>
<l>        for IndexCnt := 0 to VectorLength-1 by 1</l>
<l>            Products_VT_MeasureResult_MeasureValues_Out.at(IndexCnt).at(0)[IndexCnt_Products] := -1</l>
<l>        endfor</l>
<l>    endif   </l>
<l>endfor</l>
<c></c>
<l>return ()</l>
</body>
<docu id="gCorrectResultIndexForProductTracking">
<parameters>
<parameter id="Products_VT_MeasureResult_MeasureValues"/>
<parameter id="Products_VT_MeasureResult_MeasureValues_Out"/>
</parameters>
</docu>
</procedure>
<procedure name="gDebayer_GrabbedImage_AndColourConversion">
<interface>
<io>
<par name="ImageOrig" base_type="iconic" dimension="0"/>
<par name="DomainToReduceTo" base_type="iconic" dimension="0"/>
</io>
<oo>
<par name="ImageOrig_RGB" base_type="iconic" dimension="0"/>
<par name="ImageOrig_YUV" base_type="iconic" dimension="0"/>
<par name="ImageOrig_Sequencer" base_type="iconic" dimension="0"/>
<par name="MultiChannel_Image" base_type="iconic" dimension="0"/>
</oo>
<oc>
<par name="TimeNeeded" base_type="ctrl" dimension="0"/>
<par name="MultiChannelImage_ColourSpaceDescriptor" base_type="ctrl" dimension="0"/>
</oc>
</interface>
<body>
<l>* global tuple gColorTransLUTHandle_YUV_To_RGB</l>
<l>* global tuple gColorTransLUTHandle_RGB_To_HSV</l>
<l>* global tuple gCameraDebayerpattern</l>
<l>global tuple gLocalCameraNumberUsed</l>
<l>global tuple gWorkOnFramegrabber_Enable</l>
<l>global tuple dict_Camera</l>
<c></c>
<l>* CameraDebayerpattern := gCameraDebayerpattern[gLocalCameraNumberUsed]</l>
<l>UseMultipleColourscpaces := dict_Camera.General.V_Camera_UseMultipleColourscpaces.Value</l>
<c></c>
<c></c>
<c>* </c>
<l>count_seconds (Seconds_Start)</l>
<l>gen_empty_obj (ImageOrig_YUV)</l>
<l>gen_empty_obj (ImageOrig_Sequencer)</l>
<c></c>
<c>* reduce domain if given to speed up conversion</c>
<l>area_center (DomainToReduceTo, DomainToReduceTo_Area, _, _)</l>
<l>if (DomainToReduceTo_Area &gt; 0)</l>
<l>    reduce_domain (ImageOrig, DomainToReduceTo, ImageOrig)</l>
<l>endif</l>
<c></c>
<c>* debeyer image if necessary</c>
<l>count_channels (ImageOrig, ImageOrig_Channels)</l>
<c></c>
<l>if( ImageOrig_Channels = 5)</l>
<l>    MultiChannelImage_ColourSpaceDescriptor := ['HSV_H_CH=1', 'HSV_S_CH=2' ,'HSV_V_CH=3', 'Bottomlight_Mono_CH=4','Toplight_UV_CH=5']      </l>
<l>    MultiChannel_Image := ImageOrig</l>
<l>    return()</l>
<l>else</l>
<l>    stop()</l>
<l>endif</l>
<c></c>
<c></c>
<l>* if (ImageOrig_Channels = 1)</l>
<c>    * Debayerpattern 0=x( )y( )RG, 1= x(x)y( )GR, 2=x( )y(x)GB, 3= x(x)y(x)BG</c>
<l>*     if (CameraDebayerpattern = 'RG')</l>
<l>*         CFA_Type := 'bayer_rg'</l>
<l>*     endif</l>
<l>*     if (CameraDebayerpattern = 'GR')</l>
<l>*         CFA_Type := 'bayer_gr'</l>
<l>*     endif</l>
<l>*     if (CameraDebayerpattern = 'GB')</l>
<l>*         CFA_Type := 'bayer_gb'</l>
<l>*     endif</l>
<l>*     if (CameraDebayerpattern = 'BG')</l>
<l>*         CFA_Type := 'bayer_bg'</l>
<l>*     endif</l>
<c>    * ERROR, what if no type has been selected?</c>
<l>*     cfa_to_rgb (ImageOrig, ImageOrig_RGB, CFA_Type, 'bilinear_enhanced')</l>
<c>    *</c>
<l>* else</l>
<c>    * in case single 3 channel image is available - rgb or yuv</c>
<l>*     if(ImageOrig_Channels = 3)</l>
<l>*         decompose3 (ImageOrig, Colour1, Colour2, Colour3)</l>
<l>*     elseif (ImageOrig_Channels = 5) // in case FPGA preprocessid image is attached</l>
<l>*         decompose5 (ImageOrig, Colour1, Colour2, Colour3, Colour4, Colour5) // in case a sequencer image is available</l>
<l>*     elseif (ImageOrig_Channels = 6) // in case sequencer image is attached</l>
<l>*         decompose6 (ImageOrig, Colour1, Colour2, Colour3, Colour4, Colour5, Colour6) // in case a sequencer image is available</l>
<l>*     endif</l>
<c>    </c>
<l>*     if ((CameraDebayerpattern) = 'YUVFromCamera' and gWorkOnFramegrabber_Enable)  </l>
<l>*         apply_color_trans_lut (Colour1, Colour2, Colour3, Red, Green, Blue, gColorTransLUTHandle_YUV_To_RGB) </l>
<l>*         compose3 (Red, Green, Blue, ImageOrig_RGB)</l>
<l>*         if(ImageOrig_Channels = 6)</l>
<l>*             apply_color_trans_lut (Colour4, Colour5, Colour6, Sequencer_Red, Sequencer_Green, Sequencer_Blue, gColorTransLUTHandle_YUV_To_RGB) </l>
<l>*             compose3 (Sequencer_Red, Sequencer_Green, Sequencer_Blue, ImageOrig_Sequencer)</l>
<l>*         endif</l>
<l>*     else</l>
<l>*         if ((CameraDebayerpattern) = 'YUVFromCamera' and gWorkOnFramegrabber_Enable = 0) // rgb was loaded from disk and it has to be converted to YUV </l>
<l>*             trans_from_rgb (Colour1, Colour2, Colour3, YUV_Y, YUV_U, YUV_V, 'yuv') </l>
<l>*             compose3 (YUV_Y, YUV_U, YUV_V, ImageOrig_YUV)</l>
<l>*         endif</l>
<l>*         if(ImageOrig_Channels = 3)</l>
<l>*             ImageOrig_RGB := ImageOrig </l>
<l>*         elseif (ImageOrig_Channels = 5)</l>
<l>*             compose3 (Colour1, Colour2, Colour3, ImageOrig_HSV)</l>
<l>*             compose3 (Colour4, Colour5, Colour6, ImageOrig_Sequencer)</l>
<l>*         elseif (ImageOrig_Channels = 6)</l>
<l>*             compose3 (Colour1, Colour2, Colour3, ImageOrig_RGB)</l>
<l>*             compose3 (Colour4, Colour5, Colour6, ImageOrig_Sequencer)</l>
<l>*         endif</l>
<c>        </c>
<l>*     endif      </l>
<l>* endif</l>
<l>* MultiChannelImage_ColourSpaceDescriptor := ['RGB_R_CH=1', 'RGB_G_CH=2', 'RGB_B_CH=3']</l>
<c></c>
<c>**************************** Do multichannel image  related work</c>
<l>* if (UseMultipleColourscpaces)     </l>
<c>    * do the conversion into an other colour space</c>
<l>*     decompose3 (ImageOrig, Colour1, Colour2, Colour3)</l>
<l>*     reduce_domain (Colour1, DomainToReduceTo, Colour1)</l>
<l>*     reduce_domain (Colour2, DomainToReduceTo, Colour2)</l>
<l>*     reduce_domain (Colour3, DomainToReduceTo, Colour3)</l>
<c>    * colour conversion via lut is more performant than via standard conversion</c>
<l>*     apply_color_trans_lut (Colour1, Colour2, Colour3, Hue, Saturation, Value, gColorTransLUTHandle_RGB_To_HSV)</l>
<l>*     compose6 (Colour1, Colour2, Colour3, Hue, Saturation, Value, MultiChannel_Image) </l>
<c>    </c>
<l>*     tuple_length (MultiChannelImage_ColourSpaceDescriptor, MultiChannelImage_ColourSpaceDescriptor_Length)</l>
<l>*     MultiChannelImage_ColourSpaceDescriptor := [MultiChannelImage_ColourSpaceDescriptor,'HSV_H_CH=' + (MultiChannelImage_ColourSpaceDescriptor_Length+1), 'HSV_S_CH='+ (MultiChannelImage_ColourSpaceDescriptor_Length+2), 'HSV_V_CH='+( MultiChannelImage_ColourSpaceDescriptor_Length+3)]  </l>
<c>    * in case sequencer is active add channels</c>
<l>*     get_image_size (ImageOrig_Sequencer, ImageOrig_Sequencer_Width, _)</l>
<l>*     if(ImageOrig_Sequencer_Width &gt; 1)</l>
<l>*         append_channel (MultiChannel_Image, ImageOrig_Sequencer, MultiChannel_Image)</l>
<l>*         tuple_length (MultiChannelImage_ColourSpaceDescriptor, MultiChannelImage_ColourSpaceDescriptor_Length)</l>
<l>*         MultiChannelImage_ColourSpaceDescriptor:= [MultiChannelImage_ColourSpaceDescriptor,'RGB_Sequencer_R_CH='+ (MultiChannelImage_ColourSpaceDescriptor_Length+1), 'RGB_Sequencer_G_CH='+ (MultiChannelImage_ColourSpaceDescriptor_Length+2), 'RGB_Sequencer_B_CH='+ (MultiChannelImage_ColourSpaceDescriptor_Length+3)]</l>
<l>*     endif</l>
<c>    </c>
<c>    * in case there is an yuv image available append it</c>
<l>*     get_image_size (ImageOrig_YUV, ImageOrig_YUV_Width, _)</l>
<l>*     if (ImageOrig_YUV_Width # [])</l>
<l>*         append_channel (MultiChannel_Image, ImageOrig_YUV, MultiChannel_Image)</l>
<l>*         tuple_length (MultiChannelImage_ColourSpaceDescriptor, MultiChannelImage_ColourSpaceDescriptor_Length)</l>
<l>*         MultiChannelImage_ColourSpaceDescriptor:= [MultiChannelImage_ColourSpaceDescriptor,'YUV_Y_CH='+ (MultiChannelImage_ColourSpaceDescriptor_Length+1), 'YUV_U_CH='+ (MultiChannelImage_ColourSpaceDescriptor_Length+2), 'YUV_V_CH='+ (MultiChannelImage_ColourSpaceDescriptor_Length+3)]</l>
<l>*     endif</l>
<l>* endif</l>
<c></c>
<l>count_seconds (Seconds_End)</l>
<l>TimeNeeded := (Seconds_End - Seconds_Start) * 1000.0</l>
<c></c>
<l>return ()</l>
</body>
<docu id="gDebayer_GrabbedImage_AndColourConversion">
<parameters>
<parameter id="DomainToReduceTo"/>
<parameter id="ImageOrig"/>
<parameter id="ImageOrig_RGB"/>
<parameter id="ImageOrig_Sequencer"/>
<parameter id="ImageOrig_YUV"/>
<parameter id="MultiChannelImage_ColourSpaceDescriptor"/>
<parameter id="MultiChannel_Image"/>
<parameter id="TimeNeeded"/>
</parameters>
</docu>
</procedure>
<procedure name="gDebug_Aquisition_ReplaceGrabbedImagesWithBufferedImagesLoadedFromDisk">
<interface>
<io>
<par name="Image" base_type="iconic" dimension="0"/>
<par name="VISimulationImagesImageBuffer" base_type="iconic" dimension="1"/>
</io>
<oo>
<par name="ImageOut" base_type="iconic" dimension="0"/>
</oo>
<ic>
<par name="ReplaceGrabbedImagesWithBufferedImagesLoadedFromDisk_Counter" base_type="ctrl" dimension="0"/>
<par name="VISimulationImagesImageBuffer_Length" base_type="ctrl" dimension="0"/>
<par name="DebugWindowIsOpen" base_type="ctrl" dimension="0"/>
<par name="ShowTwoPictureBoxesForManualSynchronisation" base_type="ctrl" dimension="0"/>
</ic>
<oc>
<par name="ReplaceGrabbedImagesWithBufferedImagesLoadedFromDisk_CounterOut" base_type="ctrl" dimension="0"/>
</oc>
</interface>
<body>
<c>* todo: remove from library</c>
<c></c>
<l>* global tuple gDebug_Aquisition_ReplaceGrabbedImagesWithBufferedImagesLoadedFromDisk</l>
<l>* global tuple gMachineShiftregister_Index</l>
<l>* ImageOut := Image</l>
<l>* DebugWindowIsOpenOut := DebugWindowIsOpen</l>
<l>* ReplaceGrabbedImagesWithBufferedImagesLoadedFromDisk_CounterOut := ReplaceGrabbedImagesWithBufferedImagesLoadedFromDisk_Counter</l>
<c>* Debug_Aquisition_ReplaceGrabbedImagesWithBufferedImagesLoadedFromDisk</c>
<l>* if(gDebug_Aquisition_ReplaceGrabbedImagesWithBufferedImagesLoadedFromDisk = 1) // todo remove and gMachineShiftregister_Index &gt; 0)</l>
<c>    </c>
<l>*     tuple_mod (ReplaceGrabbedImagesWithBufferedImagesLoadedFromDisk_CounterOut, VISimulationImagesImageBuffer_Length, Mod)</l>
<c>    * show debug visu to synchronize images</c>
<l>*     if(ShowTwoPictureBoxesForManualSynchronisation = 1)</l>
<l>*         if (DebugWindowIsOpenOut = 0)</l>
<l>*             dev_open_window (0, 0, 640, 480, 'black', WindowHandle0)</l>
<l>*             dev_open_window (0, 640, 640, 480, 'black', WindowHandle1)</l>
<l>*             DebugWindowIsOpenOut := 1</l>
<l>*         endif</l>
<l>*         dev_set_window (WindowHandle0)</l>
<l>*         dev_clear_window ()</l>
<l>*         dev_display (ImageOut)</l>
<l>*         dev_set_window (WindowHandle1)   </l>
<l>*         dev_clear_window ()</l>
<l>*         dev_display (VISimulationImagesImageBuffer.at(Mod))</l>
<l>*         if (ReplaceGrabbedImagesWithBufferedImagesLoadedFromDisk_CounterOut = 245)</l>
<l>*             stop()</l>
<l>*         endif</l>
<l>*     endif</l>
<c>    </c>
<l>*     ImageOut := VISimulationImagesImageBuffer.at(Mod)</l>
<l>*     ReplaceGrabbedImagesWithBufferedImagesLoadedFromDisk_CounterOut := ReplaceGrabbedImagesWithBufferedImagesLoadedFromDisk_CounterOut +1</l>
<l>* endif</l>
<l>* return ()</l>
</body>
<docu id="gDebug_Aquisition_ReplaceGrabbedImagesWithBufferedImagesLoadedFromDisk">
<parameters>
<parameter id="DebugWindowIsOpen"/>
<parameter id="Image"/>
<parameter id="ImageOut"/>
<parameter id="ReplaceGrabbedImagesWithBufferedImagesLoadedFromDisk_Counter"/>
<parameter id="ReplaceGrabbedImagesWithBufferedImagesLoadedFromDisk_CounterOut"/>
<parameter id="ShowTwoPictureBoxesForManualSynchronisation"/>
<parameter id="VISimulationImagesImageBuffer"/>
<parameter id="VISimulationImagesImageBuffer_Length"/>
</parameters>
</docu>
</procedure>
<procedure name="gDebug_StopOptions_Counterbased">
<interface>
<ic>
<par name="StopOn_ProcessingLoopcounter" base_type="ctrl" dimension="0"/>
<par name="StopOn_ProductionLoopCounter" base_type="ctrl" dimension="0"/>
<par name="StopOn_ProductCounterGood" base_type="ctrl" dimension="0"/>
<par name="StopOn_ProductCounterBad" base_type="ctrl" dimension="0"/>
</ic>
<oc>
<par name="ProcessingLoopcounterOut" base_type="ctrl" dimension="0"/>
</oc>
</interface>
<body>
<l>global tuple vector(1) gProcessingLoopcounter</l>
<l>global tuple gProductCounterGood</l>
<l>global tuple gProductCounterBad</l>
<l>global tuple gProductionLoopCounter</l>
<c></c>
<l>ProcessingLoopcounterOut := gProcessingLoopcounter.at(0)[0]</l>
<c></c>
<l>if (gProcessingLoopcounter = {[StopOn_ProcessingLoopcounter]} and StopOn_ProcessingLoopcounter # [])</l>
<l>    stop()   </l>
<l>endif</l>
<c></c>
<l>if (gProductionLoopCounter = StopOn_ProductionLoopCounter and StopOn_ProductionLoopCounter # [])</l>
<l>    stop()   </l>
<l>endif</l>
<c></c>
<l>if (gProductCounterGood = StopOn_ProductCounterGood and StopOn_ProductCounterGood # [])</l>
<l>    stop()   </l>
<l>endif</l>
<c></c>
<l>if (gProductCounterBad = StopOn_ProductCounterBad and StopOn_ProductCounterBad # [])</l>
<l>    stop()   </l>
<l>endif</l>
<c></c>
<c></c>
<l>return ()</l>
</body>
<docu id="gDebug_StopOptions_Counterbased">
<parameters>
<parameter id="ProcessingLoopcounterOut"/>
<parameter id="StopOn_ProcessingLoopcounter"/>
<parameter id="StopOn_ProductCounterBad"/>
<parameter id="StopOn_ProductCounterGood"/>
<parameter id="StopOn_ProductionLoopCounter"/>
</parameters>
</docu>
</procedure>
<procedure name="gDebug_TimeMeasure">
<interface>
<ic>
<par name="Debug_Seconds0" base_type="ctrl" dimension="0"/>
<par name="Debug_TimeMeasure" base_type="ctrl" dimension="0"/>
</ic>
<oc>
<par name="Debug_TimeMeasureOut" base_type="ctrl" dimension="0"/>
</oc>
</interface>
<body>
<l>Debug_TimeMeasureOut := Debug_TimeMeasure</l>
<l>dev_get_system ('engine_environment', SystemInformations)</l>
<l>if (SystemInformations = 'HDevelop')</l>
<l>    count_seconds (Debug_Seconds1)   </l>
<l>    Debug_SecondsDelta := (Debug_Seconds1 - Debug_Seconds0) *1000.0</l>
<l>    Debug_TimeMeasureOut := [Debug_TimeMeasureOut,Debug_SecondsDelta]</l>
<l>endif</l>
<c></c>
<c></c>
<l>return ()</l>
</body>
<docu id="gDebug_TimeMeasure">

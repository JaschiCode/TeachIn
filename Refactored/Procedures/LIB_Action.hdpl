</parameters>
</docu>
</procedure>
<procedure name="gDeSerialize2DimIconic">
<interface>
<oo>
<par name="V2DimToDeserialize" base_type="iconic" dimension="2"/>
</oo>
<ic>
<par name="MessageHandle_Input" base_type="ctrl" dimension="0"/>
<par name="MessagePart_ID" base_type="ctrl" dimension="0"/>
</ic>
<oc>
<par name="VariableName" base_type="ctrl" dimension="0"/>
</oc>
</interface>
<body>
<c>* get data from corresponding serialisation part</c>
<c>* Note: iconic to tuple function is pretty similar- just interchange the commented out parts with the red highlighted parts</c>
<c></c>
<c></c>
<l>gen_empty_obj (EmptyObject)</l>
<l>V2DimToDeserialize.at(0).at(0) := EmptyObject</l>
<c></c>
<l>* V2DimToDeserialize.at(0).at(0) := []</l>
<l>get_message_tuple (MessageHandle_Input, ('VT2Dim_Name_' + MessagePart_ID), VariableName)</l>
<l>get_message_tuple (MessageHandle_Input, ('VT2DimLength_' + MessagePart_ID), VT2DimLength)</l>
<c></c>
<l>CntRawData := 0</l>
<l>for Cnt2Dim := 0 to VT2DimLength-1 by 1</l>
<l>    get_message_tuple (MessageHandle_Input, ('VT1DimLength_' + MessagePart_ID), VT1DimLength)</l>
<l>    for Cnt1Dim := 0 to VT1DimLength-1 by 1</l>
<l>        StringForRawData := 'RawData_' + MessagePart_ID + '_' + CntRawData</l>
<l>*         get_message_tuple (MessageHandle_Input, StringForRawData, RawData)</l>
<l>        get_message_obj (RawData, MessageHandle_Input, StringForRawData)</l>
<l>        V2DimToDeserialize.at(Cnt2Dim).at(Cnt1Dim) := RawData</l>
<l>        CntRawData := CntRawData +1</l>
<l>    endfor</l>
<l>endfor </l>
<l>return ()</l>
<c></c>
<c></c>
<l>* gen_empty_obj (EmptyObject)</l>
<l>* V2DimToDeserialize.at(0).at(0) := EmptyObject</l>
<l>* get_message_tuple (MessageHandle_Input, 'VT2Dim_Name', VariableName)</l>
<l>* get_message_tuple (MessageHandle_Input, 'VT2DimLength', VT2DimLength)</l>
<c></c>
<l>* CntRawData := 0</l>
<l>* for Cnt2Dim := 0 to VT2DimLength-1 by 1</l>
<l>*     get_message_tuple (MessageHandle_Input, 'VT1DimLength', VT1DimLength)</l>
<l>*     for Cnt1Dim := 0 to VT1DimLength-1 by 1</l>
<l>*         StringForRawData := 'RawData' + CntRawData</l>
<l>*         get_message_obj (RawData, MessageHandle_Input, StringForRawData)</l>
<l>*         V2DimToDeserialize.at(Cnt2Dim).at(Cnt1Dim) := RawData</l>
<l>*         CntRawData := CntRawData +1</l>
<l>*     endfor</l>
<l>* endfor </l>
<l>* return ()</l>
</body>
<docu id="gDeSerialize2DimIconic">
<parameters>
<parameter id="MessageHandle_Input"/>
<parameter id="MessagePart_ID"/>
<parameter id="V2DimToDeserialize"/>
<parameter id="VariableName"/>
</parameters>
</docu>
</procedure>
<procedure name="gDeSerialize2DimTpl">
<interface>
<ic>
<par name="MessageHandle_Input" base_type="ctrl" dimension="0"/>
<par name="MessagePart_ID" base_type="ctrl" dimension="0"/>
</ic>
<oc>
<par name="VariableName" base_type="ctrl" dimension="0"/>
<par name="V2DimToDeserialize" base_type="ctrl" dimension="2"/>
</oc>
</interface>
<body>
<l>* gen_empty_obj (EmptyObject)</l>
<l>V2DimToDeserialize.at(0).at(0) := []</l>
<l>get_message_tuple (MessageHandle_Input, ('VT2Dim_Name_' + MessagePart_ID), VariableName)</l>
<l>get_message_tuple (MessageHandle_Input, ('VT2DimLength_' + MessagePart_ID), VT2DimLength)</l>
<c></c>
<l>CntRawData := 0</l>
<l>for Cnt2Dim := 0 to VT2DimLength-1 by 1</l>
<l>    get_message_tuple (MessageHandle_Input, ('VT1DimLength_' + MessagePart_ID), VT1DimLength)</l>
<l>    for Cnt1Dim := 0 to VT1DimLength-1 by 1</l>
<l>        StringForRawData := 'RawData_' + MessagePart_ID + '_' + CntRawData</l>
<l>        get_message_tuple (MessageHandle_Input, StringForRawData, RawData)</l>
<l>*         get_message_obj (RawData, MessageHandle_Input, StringForRawData)</l>
<l>        V2DimToDeserialize.at(Cnt2Dim).at(Cnt1Dim) := RawData</l>
<l>        CntRawData := CntRawData +1</l>
<l>    endfor</l>
<l>endfor </l>
<l>return ()</l>
</body>
<docu id="gDeSerialize2DimTpl">
<parameters>
<parameter id="MessageHandle_Input"/>
<parameter id="MessagePart_ID"/>
<parameter id="V2DimToDeserialize"/>
<parameter id="VariableName"/>
</parameters>
</docu>
</procedure>
<procedure name="gDetermineCropCoordinatesInImage">
<interface>
<ic>
<par name="CropOffset" base_type="ctrl" dimension="0"/>
<par name="VariableToCheck" base_type="ctrl" dimension="0"/>
<par name="MaxValue" base_type="ctrl" dimension="0"/>
<par name="IncreaseCroppOffsetValue_Positive1_Negative0" base_type="ctrl" dimension="0"/>
</ic>
<oc>
<par name="VariableToCheck_Out" base_type="ctrl" dimension="0"/>
</oc>
</interface>
<body>
<l>VariableToCheck_Out := VariableToCheck</l>
<c>* check if offset is in positive oor in negative direction</c>
<l>if (IncreaseCroppOffsetValue_Positive1_Negative0 = 0)</l>
<l>    VariableToCheck_Out := VariableToCheck - CropOffset</l>
<l>else</l>
<l>    VariableToCheck_Out := VariableToCheck + CropOffset</l>
<l>endif</l>
<c>*Ensure Coordinate is not negative outside image</c>
<l>if (VariableToCheck_Out &lt; 0)</l>
<l>    VariableToCheck_Out := 0</l>
<l>endif</l>
<c>*Ensure Coordinate is not positive outside image</c>
<l>if (VariableToCheck_Out &gt;= (MaxValue-1))</l>
<l>    VariableToCheck_Out := MaxValue-1</l>
<l>endif</l>
<l>return ()</l>
</body>
<docu id="gDetermineCropCoordinatesInImage">
<parameters>
<parameter id="CropOffset"/>
<parameter id="IncreaseCroppOffsetValue_Positive1_Negative0"/>
<parameter id="MaxValue"/>
<parameter id="VariableToCheck"/>
<parameter id="VariableToCheck_Out"/>
</parameters>
</docu>
</procedure>
<procedure name="gDisplay_EjectMovementCompensationLines">
<interface>
<io>
<par name="EjectROIs" base_type="iconic" dimension="0"/>
</io>
<ic>
<par name="DevWindow0_NonDevWindow1" base_type="ctrl" dimension="0"/>
<par name="WindowHandle" base_type="ctrl" dimension="0"/>
<par name="Shiftregister_EjectPositionMovementCompensationVector" base_type="ctrl" dimension="2"/>
<par name="ExternalHardware_ConveyorDriveSlowly" base_type="ctrl" dimension="0"/>
</ic>
</interface>
<body>
<c>* Visualize indicator for eject position at side of eject  box</c>
<c>* Visualize indicator for eject compensation rectangle at side of eject  box</c>
<c>* Visualize indicator for fast product - slow down indication position at side of eject box</c>
<l>global tuple dict_Shiftregister</l>
<c></c>
<c></c>
<c>* get variables from vector</c>
<l>EjectCompensationActive := dict_Shiftregister.MovementCompensation.V_Active.Value</l>
<l>Shiftregister_Eject_FixedEjectPosition_RelativeToROI:= dict_Shiftregister.V_Eject_FixedEjectPosition_RelativeToROI.Value //VTShiftregister.at(4)[1]</l>
<l>Shiftregister_Eject_FixedStopPositionForFastProducts_RelativeToROI:= dict_Shiftregister.V_Eject_FixedStopPositionForFastProducts_RelativeToROI.Value  // VTShiftregister.at(5)[1]</l>
<c></c>
<c>* generate marker for eject position</c>
<l>smallest_rectangle1 (EjectROIs, Row1, Column1, Row2, Column2)</l>
<l>if (Row1 # [])</l>
<l>    gen_rectangle1 (MarkerForProductEjectPosition, Row1+Shiftregister_Eject_FixedEjectPosition_RelativeToROI-3, Column1-3, Row1+Shiftregister_Eject_FixedEjectPosition_RelativeToROI+3, Column1+3)</l>
<l>else </l>
<l>    gen_empty_obj (MarkerForProductEjectPosition)</l>
<l>endif</l>
<c></c>
<c>* generate marker for fast product - slow down indication position</c>
<l>if (Row1 # [])</l>
<l>    gen_rectangle1 (MarkerForProductFastProductsDetection, (Row1+Shiftregister_Eject_FixedEjectPosition_RelativeToROI-3)+Shiftregister_Eject_FixedStopPositionForFastProducts_RelativeToROI, Column1-3, (Row1+Shiftregister_Eject_FixedEjectPosition_RelativeToROI+3)+Shiftregister_Eject_FixedStopPositionForFastProducts_RelativeToROI, Column1+3)</l>
<l>else </l>
<l>    gen_empty_obj (MarkerForProductFastProductsDetection)</l>
<l>endif</l>
<c></c>
<c></c>
<l>if (EjectCompensationActive = 1)</l>
<l>    convert_vector_to_tuple (Shiftregister_EjectPositionMovementCompensationVector, EjectCompensationValues)</l>
<l>    tuple_length (EjectCompensationValues, EjectCompensationValues_Length)</l>
<l>    tuple_select_range (Row1, 0, EjectCompensationValues_Length-1, Row1)</l>
<l>    tuple_select_range (Row2, 0, EjectCompensationValues_Length-1, Row2)</l>
<l>    tuple_select_range (Column1, 0, EjectCompensationValues_Length-1, Column1)</l>
<l>    tuple_select_range (Column2, 0, EjectCompensationValues_Length-1, Column2)</l>
<c>    * </c>
<l>    if (Row1 # [])</l>
<l>            gen_rectangle1 (CompensationRectangle, Row1-EjectCompensationValues, Column1, Row2, Column1+2)</l>
<c>            * </c>
<l>            if (DevWindow0_NonDevWindow1 = 0)</l>
<l>                dev_set_color ('dim gray')</l>
<l>                dev_display (CompensationRectangle)</l>
<l>            else</l>
<l>                set_color (WindowHandle, 'dim gray')</l>
<l>                disp_obj (CompensationRectangle, WindowHandle)</l>
<l>            endif</l>
<c>            * show position where products are ejected without compensation</c>
<l>            if (DevWindow0_NonDevWindow1 = 0)</l>
<l>                dev_set_color ('light gray')</l>
<l>                dev_display (MarkerForProductEjectPosition)</l>
<l>                if(ExternalHardware_ConveyorDriveSlowly = 1)</l>
<l>                    dev_set_color ('dim gray')</l>
<l>                endif</l>
<l>                dev_display (MarkerForProductFastProductsDetection)</l>
<l>            else</l>
<l>                set_color (WindowHandle, 'light gray')</l>
<l>                disp_obj (MarkerForProductEjectPosition, WindowHandle)</l>
<l>                if(ExternalHardware_ConveyorDriveSlowly = 1)</l>
<l>                    set_color (WindowHandle, 'dim gray')</l>
<l>                endif</l>
<l>                disp_obj (MarkerForProductFastProductsDetection, WindowHandle)</l>
<l>            endif</l>
<l>    endif</l>
<l>else</l>
<c>    * show position where products are ejected without compensation- different than before gray to see it</c>
<l>    if (DevWindow0_NonDevWindow1 = 0)</l>
<l>        dev_set_color ('dim gray')</l>
<l>        dev_display (MarkerForProductEjectPosition)</l>
<l>    else</l>
<l>        set_color (WindowHandle, 'dim gray')</l>
<l>        disp_obj (MarkerForProductEjectPosition, WindowHandle)</l>
<l>    endif</l>
<l>endif</l>
<c></c>
<c>* </c>
<l>return ()</l>
</body>
<docu id="gDisplay_EjectMovementCompensationLines">
<parameters>
<parameter id="DevWindow0_NonDevWindow1"/>
<parameter id="EjectROIs"/>
<parameter id="ExternalHardware_ConveyorDriveSlowly"/>
<parameter id="Shiftregister_EjectPositionMovementCompensationVector"/>
<parameter id="WindowHandle"/>
</parameters>
</docu>
</procedure>
<procedure name="gDisplayImageAndRegions_Local">
<interface>
<io>
<par name="ImageOrig" base_type="iconic" dimension="0"/>
<par name="RinnenROIs" base_type="iconic" dimension="0"/>
<par name="EjectROIs" base_type="iconic" dimension="0"/>
</io>
<ic>
<par name="DevWindow0_NonDevWindow1" base_type="ctrl" dimension="0"/>
<par name="WindowHandle" base_type="ctrl" dimension="0"/>
</ic>
</interface>
<body>
<l>get_image_size (ImageOrig, ImageOrig_Width, ImageOrig_Height)</l>
<c>* </c>
<l>if (DevWindow0_NonDevWindow1 = 0)</l>
<l>    dev_clear_window ()</l>
<l>    dev_set_window (WindowHandle)</l>
<l>    dev_set_part (0, 0, ImageOrig_Height, ImageOrig_Width)</l>
<l>    dev_display (ImageOrig)</l>
<l>    dev_set_color ('blue')</l>
<l>    dev_display (RinnenROIs)</l>
<l>    dev_set_color ('gray')</l>
<l>    dev_display (EjectROIs)</l>
<l>else</l>
<l>    clear_window (WindowHandle)</l>
<l>    set_part (WindowHandle, 0, 0, ImageOrig_Height, ImageOrig_Width)</l>
<l>    disp_obj (ImageOrig, WindowHandle)</l>
<l>    set_color (WindowHandle, 'blue')</l>
<l>    disp_region (RinnenROIs, WindowHandle)</l>
<l>    set_color (WindowHandle, 'gray')</l>
<l>    disp_region (EjectROIs, WindowHandle)</l>
<l>endif</l>
<c>* </c>
<l>return ()</l>
</body>
<docu id="gDisplayImageAndRegions_Local">
<parameters>
<parameter id="DevWindow0_NonDevWindow1"/>
<parameter id="EjectROIs"/>
<parameter id="ImageOrig"/>
<parameter id="RinnenROIs"/>
<parameter id="WindowHandle"/>
</parameters>
</docu>
</procedure>
<procedure name="gDistanceTransformRegionSeperation">
<interface>
<io>
<par name="TabletRegionWithMirrors" base_type="iconic" dimension="0"/>
<par name="ColourImage" base_type="iconic" dimension="0"/>
</io>
<oo>
<par name="WatershedSegmentedObjects" base_type="iconic" dimension="0"/>
</oo>
<ic>
<par name="SeperationThreshold" base_type="ctrl" dimension="0"/>
</ic>
<oc>
<par name="ContinueOutside" base_type="ctrl" dimension="0"/>
<par name="Time_Needed" base_type="ctrl" dimension="0"/>
</oc>
</interface>
<body>
<l>ScaleFactor := 0.5</l>
<l>* ScaleFactor := 0.25</l>
<c></c>
<l>ContinueOutside := 0</l>
<l>count_seconds (Seconds_Start)</l>
<l>gen_empty_obj (WatershedSegmentedObjects)</l>
<c></c>
<c>* only do it when there is content</c>
<l>area_center (TabletRegionWithMirrors, Area, _, _)</l>
<l>if (Area # [])   </l>
<c>    * </c>
<l>    copy_obj (TabletRegionWithMirrors, TabletRegionWithMirrors_Processed, 1, -1)</l>
<c>    * </c>
<l>*     closing_circle (TabletRegionWithMirrors_Processed, TabletRegionWithMirrors_Processed, 8.5)</l>
<c></c>
<c>    * prefiltering for a better segmentation of the middle tablet</c>
<l>*     erosion_circle (TabletRegionWithMirrors, TabletRegionWithMirrors_Processed, 2.0)</l>
<l>*     erosion_rectangle1 (TabletRegionWithMirrors_Processed, TabletRegionWithMirrors_Processed, 1, 5)</l>
<l>* stop ()</l>
<c>    * For speeding up the process the region can be scaled</c>
<l>    if (ScaleFactor # 1)</l>
<l>        erosion_rectangle1 (TabletRegionWithMirrors_Processed, TabletRegionWithMirrors_Processed, 1, 2)</l>
<l>        zoom_region (TabletRegionWithMirrors_Processed, TabletRegionWithMirrors_Processed, ScaleFactor, ScaleFactor)</l>
<l>    endif</l>
<l>*     SeperationThreshold := 4  // used for default</l>
<l>    * SeperationThreshold := 6  // used for Abbott</l>
<c>      </c>
<l>    gWathershedStep (TabletRegionWithMirrors_Processed, WatershedSegmentedObjects, 1, SeperationThreshold, ContinueOutside, Time_Needed)</l>
<c>    * For speeding up the process the scaling was done- here the inversion to get original szed regions again</c>
<l>    if (ScaleFactor # 1)</l>
<l>        zoom_region (WatershedSegmentedObjects, WatershedSegmentedObjects, 1/ScaleFactor, 1/ScaleFactor)</l>
<l>    endif</l>
<c>    * small erosion is necessary- otherwise it can lead to issues in shiftegister mapping good to bad objects when products are close to each other</c>
<l>    erosion_circle (WatershedSegmentedObjects, WatershedSegmentedObjects, 1.5)</l>
<c>    * </c>
<c>    * </c>
<l>    connection (WatershedSegmentedObjects, WatershedSegmentedObjects)</l>
<l>    select_shape (WatershedSegmentedObjects, WatershedSegmentedObjects, 'area', 'and', 10, 99999999)</l>
<l>endif</l>
<c></c>
<l>count_seconds (Seconds_End)</l>
<l>Time_Needed := (Seconds_End- Seconds_Start) * 1000</l>
<l>return ()</l>
</body>
<docu id="gDistanceTransformRegionSeperation">
<parameters>
<parameter id="ColourImage"/>
<parameter id="ContinueOutside"/>
<parameter id="SeperationThreshold"/>
<parameter id="TabletRegionWithMirrors"/>
<parameter id="Time_Needed"/>
<parameter id="WatershedSegmentedObjects"/>
</parameters>
</docu>
</procedure>
<procedure name="gdoAquireImage">
<interface>
<oo>
<par name="ImageOrigGrabbed" base_type="iconic" dimension="0"/>
<par name="CapImage" base_type="iconic" dimension="0"/>
</oo>
<ic>
<par name="ThreadId" base_type="ctrl" dimension="0"/>
<par name="CameraId" base_type="ctrl" dimension="0"/>
</ic>
<oc>
<par name="TimeNeeded" base_type="ctrl" dimension="0"/>
<par name="NoMore_ImageLoadedFromDisk" base_type="ctrl" dimension="0"/>
<par name="Framegrabber_ChunkData" base_type="ctrl" dimension="0"/>
<par name="Camera_DeviceNumberUsedForGrabbing" base_type="ctrl" dimension="0"/>
<par name="Grab_Time_Needed" base_type="ctrl" dimension="0"/>
</oc>
</interface>
<body>
<l>global tuple gEndlessLoopForTestingEngine</l>
<l>global tuple gProductionLoopCounter</l>
<l>global tuple vector(1) gAcqHandle</l>
<c>* </c>
<c>* </c>
<l>Camera_DeviceNumberUsedForGrabbing := []</l>
<c></c>
<l>count_seconds (Seconds_Start)</l>
<c></c>
<l>if (gEndlessLoopForTestingEngine = 0)</l>
<c>    * If the image can be grabbed from camera 1 then do it, otherwise grab and use the loaded productimage. In no grabber use productimage as well.</c>
<l>    gGetImageForElaboration (ImageOrigGrabbed, CapImage, gAcqHandle.at(CameraId), gProductionLoopCounter, NoMore_ImageLoadedFromDisk, Framegrabber_ChunkData, Camera_DeviceNumberUsedForGrabbing, Grab_Time_Needed)</l>
<l>    gProductionLoopCounter := gProductionLoopCounter +1</l>
<l>else</l>
<l>    NoMore_ImageLoadedFromDisk := 0</l>
<l>endif</l>
<c>*  </c>
<l>count_seconds (Seconds_End)</l>
<l>TimeNeeded := (Seconds_End- Seconds_Start) * 1000.0</l>
<c></c>
<l>return ()</l>
</body>
<docu id="gdoAquireImage">
<parameters>
<parameter id="CameraId"/>
<parameter id="Camera_DeviceNumberUsedForGrabbing"/>
<parameter id="CapImage"/>
<parameter id="Framegrabber_ChunkData"/>
<parameter id="Grab_Time_Needed"/>
<parameter id="ImageOrigGrabbed"/>
<parameter id="NoMore_ImageLoadedFromDisk"/>
<parameter id="ThreadId"/>
<parameter id="TimeNeeded"/>
</parameters>
</docu>
</procedure>
<procedure name="gDominik_GetShift">
<interface>
<io>
<par name="ImageDown" base_type="iconic" dimension="0"/>
<par name="ImageUp" base_type="iconic" dimension="0"/>
</io>
<oo>
<par name="Rollmeasurement_StartpointRegions" base_type="iconic" dimension="0"/>
</oo>
<oc>
<par name="MeanShift" base_type="ctrl" dimension="0"/>
<par name="ROI_Pos" base_type="ctrl" dimension="0"/>
<par name="ROI_Height" base_type="ctrl" dimension="0"/>
<par name="TimeNeeded" base_type="ctrl" dimension="0"/>
</oc>
</interface>
<body>
<c>* in image up as well in image down contrast can be identified within rolls</c>
<l>count_seconds(Seconds_Start)</l>
<l>gen_empty_obj (Rollmeasurement_StartpointRegions)</l>
<c></c>
<l>MeanShift := -1</l>
<l>ROI_Pos := []</l>
<l>ROI_Height := []</l>
<c></c>
<l>get_domain (ImageUp, ImageUp_Domain)</l>
<l>smallest_rectangle1 (ImageUp_Domain, ImageUp_Row1, ImageUp_Column1, ImageUp_Row2, ImageUp_Column2)</l>
<l>ImageUp_Width := ImageUp_Column2 - ImageUp_Column1</l>
<l>ImageUp_Height := ImageUp_Row2 - ImageUp_Row1</l>
<c></c>
<c>* select segmentation areas left right of image</c>
<l>SegmentationWidth := 100</l>
<l>gen_rectangle1 (Rectangle_Left, ImageUp_Row1, ImageUp_Column1, ImageUp_Row2, ImageUp_Column1 + SegmentationWidth)</l>
<l>SegmentFromOneSide := 1</l>
<l>if(SegmentFromOneSide = 1)</l>
<l>    reduce_domain (ImageDown, Rectangle_Left, ImageDown_Reduced)</l>
<l>    reduce_domain (ImageUp, Rectangle_Left, ImageUp_Reduced)</l>
<l>else</l>
<l>    gen_rectangle1 (Rectangle_Right, ImageUp_Row1, ImageUp_Column2 -  SegmentationWidth, ImageUp_Row2, ImageUp_Column2)</l>
<l>    union2 (Rectangle_Left, Rectangle_Right, RegionForSegmentation)</l>
<l>    reduce_domain (ImageDown, RegionForSegmentation, ImageDown_Reduced)</l>
<l>    reduce_domain (ImageUp, RegionForSegmentation, ImageUp_Reduced)</l>
<l>endif</l>
<c></c>
<c>***</c>
<c></c>
<l>lineWidth:=1</l>
<l>fuzzyExtensionSizeGreyBool:=1</l>
<l>visualizeUsedChannel:= 1</l>
<c></c>
<c>*measure duration of rift detection from here</c>
<l>riftDetectionDurationsMs:=[]</l>
<c></c>
<l>* AmplitudeThreshold := 35</l>
<l>* AmplitudeThreshold := 20</l>
<c></c>
<l>scaleMult:= 1.75</l>
<l>scaleAdd:=-200</l>
<c></c>
<c>* Measure 02: Coordinates for line Measure 02 [0]</c>
<l>* LineRowStart_Measure_02_0 := 20</l>
<l>* LineColumnStart_Measure_02_0 := 52.0449</l>
<l>* LineRowEnd_Measure_02_0 := 1226.82</l>
<l>* LineColumnEnd_Measure_02_0 := 55.9371</l>
<c></c>
<c></c>
<l>LineRowStart_Measure_02_0 := ImageUp_Row1</l>
<l>LineColumnStart_Measure_02_0 := ImageUp_Column1</l>
<c>*This Value was 30 but thats too much. In the some pictures the space between two roles crosses the ROI.</c>
<l>LineRowEnd_Measure_02_0 := ImageUp_Row2 - 25 // necessary to compensate bug in UV- shift moves regions outside image there</l>
<l>LineColumnEnd_Measure_02_0 := ImageUp_Column1 + SegmentationWidth</l>
<c></c>
<l>RoiWidthLen2 := 40 </l>
<l>measure_pairsSigma:=4.2</l>
<l>measure_pairsSigma:=6</l>
<c>* Test ND</c>
<l>AmplitudeThreshold := 20</l>
<l>* measure_pairsSigma:=9	</l>
<c></c>
<c></c>
<l>if(fuzzyExtensionSizeGreyBool==1)</l>
<c>    * Measure 01: Set fuzzy functions on measure objects   </c>
<l>    FuzzyThreshold := 0.6</l>
<l>    create_funct_1d_pairs ([7.87789,19.3829,48.1288,59.6338], [0,1,1,0], TmpCtrl_FunctionSize)</l>
<l>    create_funct_1d_pairs ([104.483,109.338,143.047,147.902], [0,1,1,0], TmpCtrl_FunctionGray)</l>
<l>endif</l>
<c>************************</c>
<c>* Image Down Calculation</c>
<c>* The Backlight image is calculated with Fuzzy</c>
<l>ScaleImage := 1</l>
<l>gDominik_riftCenter (ImageDown_Reduced, FoundLine_Down, scaleMult, scaleAdd, LineRowStart_Measure_02_0, LineRowEnd_Measure_02_0, LineColumnStart_Measure_02_0, LineColumnEnd_Measure_02_0, RoiWidthLen2, TmpCtrl_FunctionSize, TmpCtrl_FunctionGray, fuzzyExtensionSizeGreyBool, measure_pairsSigma, AmplitudeThreshold, ScaleImage, measureColumnRiftCentersTuple_Down, riftDetectionDurationMs_Down)</l>
<l>if(measureColumnRiftCentersTuple_Down = [])</l>
<l>    fuzzyExtensionSizeGreyBool:=0</l>
<l>    ScaleImage := 0</l>
<l>    gDominik_riftCenter (ImageDown_Reduced, FoundLine_Down, scaleMult, scaleAdd, LineRowStart_Measure_02_0, LineRowEnd_Measure_02_0, LineColumnStart_Measure_02_0, LineColumnEnd_Measure_02_0, RoiWidthLen2, TmpCtrl_FunctionSize, TmpCtrl_FunctionGray, fuzzyExtensionSizeGreyBool, measure_pairsSigma, AmplitudeThreshold, ScaleImage, measureColumnRiftCentersTuple_Down, riftDetectionDurationMs_Down)</l>
<l>    fuzzyExtensionSizeGreyBool:=1</l>
<l>endif</l>
<c>* visualize Lines</c>
<l>* tuple_gen_const (|measureColumnRiftCentersTuple_Down|, 0, Const_0)</l>
<l>* tuple_gen_const (|measureColumnRiftCentersTuple_Down|, ImageUp_Column2, Const_Wdth)</l>
<l>* gen_rectangle1 (FoundLine_Down, measureColumnRiftCentersTuple_Down -1, Const_0, measureColumnRiftCentersTuple_Down +1, Const_Wdth)</l>
<c>************************</c>
<c></c>
<c>* Image Up Calculation</c>
<c>* The Toplight Image is Calculated without Fuzzy</c>
<l>ScaleImage := 1</l>
<l>gDominik_riftCenter (ImageUp_Reduced, FoundLine_Up, scaleMult, scaleAdd, LineRowStart_Measure_02_0, LineRowEnd_Measure_02_0, LineColumnStart_Measure_02_0, LineColumnEnd_Measure_02_0, RoiWidthLen2, TmpCtrl_FunctionSize, TmpCtrl_FunctionGray, fuzzyExtensionSizeGreyBool, measure_pairsSigma, AmplitudeThreshold, ScaleImage, measureColumnRiftCentersTuple_Up, riftDetectionDurationMs_Up)</l>
<l>if(measureColumnRiftCentersTuple_Up = [])</l>
<l>    fuzzyExtensionSizeGreyBool:=0</l>
<l>    ScaleImage := 0</l>
<l>    gDominik_riftCenter (ImageUp_Reduced, FoundLine_Up, scaleMult, scaleAdd, LineRowStart_Measure_02_0, LineRowEnd_Measure_02_0, LineColumnStart_Measure_02_0, LineColumnEnd_Measure_02_0, RoiWidthLen2, TmpCtrl_FunctionSize, TmpCtrl_FunctionGray, fuzzyExtensionSizeGreyBool, measure_pairsSigma, AmplitudeThreshold, ScaleImage, measureColumnRiftCentersTuple_Up, riftDetectionDurationMs_Up)</l>
<l>    fuzzyExtensionSizeGreyBool:=1</l>
<l>endif</l>
<c>* visualize Lines</c>
<l>* tuple_gen_const (|measureColumnRiftCentersTuple_Up|, 0, Const_0)</l>
<l>* tuple_gen_const (|measureColumnRiftCentersTuple_Up|, ImageUp_Column2, Const_Wdth)</l>
<l>* gen_rectangle1 (FoundLine_Up, measureColumnRiftCentersTuple_Up -1, Const_0, measureColumnRiftCentersTuple_Up +1, Const_Wdth)</l>
<c></c>
<c></c>
<c></c>
<c>* calculate image shift - the shift roll related from downlight to uplight</c>
<l>Segmented_Gaps_ImageUp_CenterRow :=measureColumnRiftCentersTuple_Up</l>
<l>Segmented_Gaps_ImageDown_CenterRow := measureColumnRiftCentersTuple_Down</l>
<l>* area_center (Segmented_Gaps_ImageDown, _, Segmented_Gaps_ImageDown_CenterRow, Segmented_Gaps_ImageDown_CenterColumn)</l>
<l>* area_center (Segmented_Gaps_ImageUp, _, Segmented_Gaps_ImageUp_CenterRow, Segmented_Gaps_ImageUp_CenterColumn)</l>
<l>gDominik_GetShift_CalcMeanShift (Segmented_Gaps_ImageDown_CenterRow, Segmented_Gaps_ImageUp_CenterRow, MeanShift)</l>
<c></c>
<c>* calculate tyical distance from roll to roll</c>
<l>if (|Segmented_Gaps_ImageDown_CenterRow| &gt; 1)</l>
<l>   MaxDistanceCenterPointsImageDown := Segmented_Gaps_ImageDown_CenterRow[|Segmented_Gaps_ImageDown_CenterRow|-1] - Segmented_Gaps_ImageDown_CenterRow[0] </l>
<l>   ROI_Height :=  MaxDistanceCenterPointsImageDown / (|Segmented_Gaps_ImageDown_CenterRow|-1)</l>
<l>    tuple_abs (ROI_Height, ROI_Height)</l>
<l>endif</l>
<c></c>
<c>* generate roll center regions for output</c>
<l>RegionHeigth := 1</l>
<l>* tuple_gen_const (|Segmented_Gaps_ImageDown_CenterRow|, ImageUp_Column2, ConstWdth)</l>
<l>* gen_rectangle1 (Rollmeasurement_StartpointRegions, Segmented_Gaps_ImageDown_CenterRow - (RegionHeigth /2), Segmented_Gaps_ImageDown_CenterColumn, Segmented_Gaps_ImageDown_CenterRow + (RegionHeigth /2), ConstWdth)</l>
<l>tuple_gen_const (|Segmented_Gaps_ImageDown_CenterRow|, ImageUp_Column1, ConstWdth_Column1)</l>
<l>tuple_gen_const (|Segmented_Gaps_ImageDown_CenterRow|, ImageUp_Column2, ConstWdth_Column2)</l>
<l>if ( Segmented_Gaps_ImageDown_CenterRow # [] and ConstWdth_Column1 # [] and ConstWdth_Column2 # [])</l>
<l>    gen_rectangle1 (Rollmeasurement_StartpointRegions, Segmented_Gaps_ImageDown_CenterRow - (RegionHeigth /2), ConstWdth_Column1, Segmented_Gaps_ImageDown_CenterRow + (RegionHeigth /2), ConstWdth_Column2)</l>
<l>endif</l>
<c></c>
<c>* some output naming</c>
<l>ROI_Pos := Segmented_Gaps_ImageDown_CenterRow</l>
<l>tuple_sort (ROI_Pos, ROI_Pos)</l>
<l>sort_region (Rollmeasurement_StartpointRegions, Rollmeasurement_StartpointRegions, 'first_point', 'true', 'row')</l>
<c></c>
<c></c>
<l>* stop()</l>
<l>* gDominik_interpolateOmittedRiftCenters (usedChannelWidth, riftCentersTupleLeft, riftCentersTupleMiddle, riftCentersTupleRight, riftCentersTupleLeftInterpolated, riftCentersTupleMiddleInterpolated, riftCentersTupleRightInterpolated)</l>
<c></c>
<c></c>
<l>count_seconds(Seconds_End)</l>
<l>TimeNeeded := (Seconds_End - Seconds_Start) * 1000.0</l>
<c></c>
<l>return ()</l>
</body>
<docu id="gDominik_GetShift">
<parameters>
<parameter id="ImageDown"/>
<parameter id="ImageUp"/>
<parameter id="MeanShift"/>
<parameter id="ROI_Height"/>
<parameter id="ROI_Pos"/>
<parameter id="Rollmeasurement_StartpointRegions"/>
<parameter id="TimeNeeded"/>
</parameters>
</docu>
</procedure>
<procedure name="gDominik_GetShift_CalcMeanShift">
<interface>
<ic>
<par name="ImageDown_CenterRow" base_type="ctrl" dimension="0"/>
<par name="ImageUp_CenterRow" base_type="ctrl" dimension="0"/>
</ic>
<oc>
<par name="MeanShift" base_type="ctrl" dimension="0"/>
</oc>
</interface>
<body>
<l>MeanShift := []</l>
<c></c>
<l>if (ImageDown_CenterRow # [] and ImageUp_CenterRow # [])</l>
<c>    * concept is to calculate for every element in image down a corrosponding minimal distance (if not bigger thyn x) and get mean of all results</c>
<l>    GapDistances_Found := []</l>
<l>    for Index_Cnt := 0 to |ImageDown_CenterRow| -1 by 1</l>
<l>        Selected_DownElement := ImageDown_CenterRow[Index_Cnt]</l>
<l>        tuple_gen_const (|ImageUp_CenterRow|, Selected_DownElement, Selected_DownElement_Const)</l>
<l>        Gaps := ImageUp_CenterRow - Selected_DownElement_Const</l>
<c>        * eliminate all negative values in gaps</c>
<l>        tuple_greater_equal_elem (Gaps, -5, Greatereq1)    </l>
<l>        tuple_find (Greatereq1, 0, Indices_ToRemove)</l>
<l>        tuple_remove (Gaps, Indices_ToRemove, Gaps)</l>
<l>        tuple_sort (Gaps, Gaps)</l>
<l>        Mingap := []</l>
<l>        if (Gaps # [])</l>
<l>            Mingap := Gaps[0]</l>
<l>        endif</l>
<l>        if(Mingap &lt; 30 and  Mingap &gt; -5) // spec here the min and max movement of roll - -5 up to 30</l>
<l>            GapDistance := Mingap</l>
<l>            GapDistances_Found := [GapDistances_Found, GapDistance]</l>
<l>        endif</l>
<l>    endfor</l>
<c>    </c>
<l>    if(GapDistances_Found # [])</l>
<l>        tuple_mean (GapDistances_Found, MeanShift)</l>
<l>        tuple_round (MeanShift, MeanShift)   </l>
<l>    endif</l>
<c> </c>
<l>endif</l>
<l>return ()</l>
</body>
<docu id="gDominik_GetShift_CalcMeanShift">
<parameters>
<parameter id="ImageDown_CenterRow"/>
<parameter id="ImageUp_CenterRow"/>
<parameter id="MeanShift"/>
</parameters>
</docu>
</procedure>
<procedure name="gDominik_interpolateOmittedRiftCenters">
<interface>
<ic>
<par name="usedChannelWidth" base_type="ctrl" dimension="0"/>
<par name="riftCentersTupleLeft" base_type="ctrl" dimension="0"/>
<par name="riftCentersTupleMiddle" base_type="ctrl" dimension="0"/>
<par name="riftCentersTupleRight" base_type="ctrl" dimension="0"/>
</ic>
<oc>
<par name="riftCentersTupleLeftInterpolated" base_type="ctrl" dimension="0"/>
<par name="riftCentersTupleMiddleInterpolated" base_type="ctrl" dimension="0"/>
<par name="riftCentersTupleRightInterpolated" base_type="ctrl" dimension="0"/>
</oc>
</interface>
<body>
<l>        tuple_gen_sequence(0,usedChannelWidth, usedChannelWidth/4, riftRowBins)</l>
<c>        </c>
<l>        row1Centers:=[]</l>
<l>        row2Centers:=[]</l>
<l>        row3Centers:=[]</l>
<l>        row4Centers:=[]</l>
<c>        </c>
<l>        tuple_length(riftCentersTupleLeft, riftCentersTupleLeftLength)</l>
<c>    </c>
<l>        tuple_length(row1Centers, row1CentersLengthBefore)</l>
<l>        tuple_length(row2Centers, row2CentersLengthBefore)</l>
<l>        tuple_length(row3Centers, row3CentersLengthBefore)</l>
<l>        tuple_length(row4Centers, row4CentersLengthBefore)</l>
<c>        </c>
<l>        for riftRowBinsIndex:= 0 to riftCentersTupleLeftLength-1 by 1</l>
<l>            if(riftRowBins[0]&lt;riftCentersTupleLeft[riftRowBinsIndex] and riftCentersTupleLeft[riftRowBinsIndex]&lt;riftRowBins[1])</l>
<l>                row1Centers[0]:= riftCentersTupleLeft[riftRowBinsIndex]</l>
<l>            endif</l>
<l>            if(riftRowBins[1]&lt;riftCentersTupleLeft[riftRowBinsIndex] and riftCentersTupleLeft[riftRowBinsIndex]&lt;riftRowBins[2])</l>
<l>                row2Centers[0]:= riftCentersTupleLeft[riftRowBinsIndex]</l>
<l>            endif</l>
<l>            if(riftRowBins[2]&lt;riftCentersTupleLeft[riftRowBinsIndex] and riftCentersTupleLeft[riftRowBinsIndex]&lt;riftRowBins[3])</l>
<l>                row3Centers[0]:= riftCentersTupleLeft[riftRowBinsIndex]</l>
<l>            endif</l>
<l>            if(riftRowBins[3]&lt;riftCentersTupleLeft[riftRowBinsIndex] and riftCentersTupleLeft[riftRowBinsIndex]&lt;riftRowBins[4])</l>
<l>                row4Centers[0]:= riftCentersTupleLeft[riftRowBinsIndex]</l>
<l>            endif</l>
<l>        endfor</l>
<c>        </c>
<l>        tuple_length(row1Centers, row1CentersLengthAfter)</l>
<l>        tuple_length(row2Centers, row2CentersLengthAfter)</l>
<l>        tuple_length(row3Centers, row3CentersLengthAfter)</l>
<l>        tuple_length(row4Centers, row4CentersLengthAfter)</l>
<c>        </c>
<l>        if((row1CentersLengthAfter-row1CentersLengthBefore)==0)</l>
<l>            row1Centers[0]:= -1</l>
<l>        endif</l>
<l>        if((row2CentersLengthAfter-row2CentersLengthBefore)==0)</l>
<l>            row2Centers[0]:= -1</l>
<l>        endif</l>
<l>        if((row3CentersLengthAfter-row3CentersLengthBefore)==0)</l>
<l>            row3Centers[0]:= -1</l>
<l>        endif</l>
<l>        if((row4CentersLengthAfter-row4CentersLengthBefore)==0)</l>
<l>            row4Centers[0]:= -1</l>
<l>        endif</l>
<c>        </c>
<l>        row1CentersLengthBefore:=row1CentersLengthAfter</l>
<l>        row2CentersLengthBefore:=row2CentersLengthAfter</l>
<l>        row3CentersLengthBefore:=row3CentersLengthAfter</l>
<l>        row4CentersLengthBefore:=row4CentersLengthAfter</l>
<c>        </c>
<c>        </c>
<l>        tuple_length(riftCentersTupleMiddle, riftCentersTupleMiddleLength)</l>
<l>        for riftRowBinsIndex:= 0 to riftCentersTupleMiddleLength-1 by 1</l>
<l>            if(riftRowBins[0]&lt;riftCentersTupleMiddle[riftRowBinsIndex] and riftCentersTupleMiddle[riftRowBinsIndex]&lt;riftRowBins[1])</l>
<l>                row1Centers[1]:= riftCentersTupleMiddle[riftRowBinsIndex]</l>
<l>            endif</l>
<l>            if(riftRowBins[1]&lt;riftCentersTupleMiddle[riftRowBinsIndex] and riftCentersTupleMiddle[riftRowBinsIndex]&lt;riftRowBins[2])</l>
<l>                row2Centers[1]:= riftCentersTupleMiddle[riftRowBinsIndex]</l>
<l>            endif</l>
<l>            if(riftRowBins[2]&lt;riftCentersTupleMiddle[riftRowBinsIndex] and riftCentersTupleMiddle[riftRowBinsIndex]&lt;riftRowBins[3])</l>
<l>                row3Centers[1]:= riftCentersTupleMiddle[riftRowBinsIndex]</l>
<l>            endif</l>
<l>            if(riftRowBins[3]&lt;riftCentersTupleMiddle[riftRowBinsIndex] and riftCentersTupleMiddle[riftRowBinsIndex]&lt;riftRowBins[4])</l>
<l>                row4Centers[1]:= riftCentersTupleMiddle[riftRowBinsIndex]</l>
<l>            endif</l>
<l>        endfor</l>
<c>        </c>
<l>        tuple_length(row1Centers, row1CentersLengthAfter)</l>
<l>        tuple_length(row2Centers, row2CentersLengthAfter)</l>
<l>        tuple_length(row3Centers, row3CentersLengthAfter)</l>
<l>        tuple_length(row4Centers, row4CentersLengthAfter)</l>
<c>        </c>
<l>        if((row1CentersLengthAfter-row1CentersLengthBefore)==0)</l>
<l>            row1Centers[1]:= -1</l>
<l>        endif</l>
<l>        if((row2CentersLengthAfter-row2CentersLengthBefore)==0)</l>
<l>            row2Centers[1]:= -1</l>
<l>        endif</l>
<l>        if((row3CentersLengthAfter-row3CentersLengthBefore)==0)</l>
<l>            row3Centers[1]:= -1</l>
<l>        endif</l>
<l>        if((row4CentersLengthAfter-row4CentersLengthBefore)==0)</l>
<l>            row4Centers[1]:= -1</l>
<l>        endif</l>
<c>        </c>
<l>        row1CentersLengthBefore:=row1CentersLengthAfter</l>
<l>        row2CentersLengthBefore:=row2CentersLengthAfter</l>
<l>        row3CentersLengthBefore:=row3CentersLengthAfter</l>
<l>        row4CentersLengthBefore:=row4CentersLengthAfter</l>
<c>        </c>
<l>        tuple_length(riftCentersTupleRight, riftCentersTupleRightLength)</l>
<l>        for riftRowBinsIndex:= 0 to riftCentersTupleRightLength-1 by 1</l>
<l>            if(riftRowBins[0]&lt;riftCentersTupleRight[riftRowBinsIndex] and riftCentersTupleRight[riftRowBinsIndex]&lt;riftRowBins[1])</l>
<l>                row1Centers[2]:= riftCentersTupleRight[riftRowBinsIndex]</l>
<l>            endif</l>
<l>            if(riftRowBins[1]&lt;riftCentersTupleRight[riftRowBinsIndex] and riftCentersTupleRight[riftRowBinsIndex]&lt;riftRowBins[2])</l>
<l>                row2Centers[2]:= riftCentersTupleRight[riftRowBinsIndex]</l>
<l>            endif</l>
<l>            if(riftRowBins[2]&lt;riftCentersTupleRight[riftRowBinsIndex] and riftCentersTupleRight[riftRowBinsIndex]&lt;riftRowBins[3])</l>
<l>                row3Centers[2]:= riftCentersTupleRight[riftRowBinsIndex]</l>
<l>            endif</l>
<l>            if(riftRowBins[3]&lt;riftCentersTupleRight[riftRowBinsIndex] and riftCentersTupleRight[riftRowBinsIndex]&lt;riftRowBins[4])</l>
<l>                row4Centers[2]:= riftCentersTupleRight[riftRowBinsIndex]</l>
<l>            endif</l>
<l>        endfor</l>
<c>        </c>
<l>        tuple_length(row1Centers, row1CentersLengthAfter)</l>
<l>        tuple_length(row2Centers, row2CentersLengthAfter)</l>
<l>        tuple_length(row3Centers, row3CentersLengthAfter)</l>
<l>        tuple_length(row4Centers, row4CentersLengthAfter)</l>
<c>        </c>
<l>        if((row1CentersLengthAfter-row1CentersLengthBefore)==0)</l>
<l>            row1Centers[2]:= -1</l>
<l>        endif</l>
<l>        if((row2CentersLengthAfter-row2CentersLengthBefore)==0)</l>
<l>            row2Centers[2]:= -1</l>
<l>        endif</l>
<l>        if((row3CentersLengthAfter-row3CentersLengthBefore)==0)</l>
<l>            row3Centers[2]:= -1</l>
<l>        endif</l>
<l>        if((row4CentersLengthAfter-row4CentersLengthBefore)==0)</l>
<l>            row4Centers[2]:= -1</l>
<l>        endif</l>
<c>        </c>
<l>        riftCentersTupleLeftInterpolated:=riftCentersTupleLeft</l>
<l>        riftCentersTupleMiddleInterpolated:=riftCentersTupleMiddle</l>
<l>        riftCentersTupleRightInterpolated:=riftCentersTupleRight</l>
<c>        </c>
<l>        for riftCentersTupleIndex:=0 to 3 by 1</l>
<l>            for riftColumnsIndex:= 0 to 2 by 1</l>
<c>                </c>
<l>                if(row1Centers[riftColumnsIndex]== (-1))</l>
<l>                    row1CentersNonMinusOne:=row1Centers[find(row1Centers [!=] (-1),1)]</l>
<l>                    tuple_length(row1CentersNonMinusOne, row1CentersNonMinusOneLenght)</l>
<l>                    if(row1CentersNonMinusOneLenght&gt;0)</l>
<l>                        if(riftColumnsIndex==0)</l>
<l>                            riftCentersTupleLeftInterpolated[riftCentersTupleIndex] := mean(row1CentersNonMinusOne)</l>
<l>                        endif</l>
<l>                        if(riftColumnsIndex==1)</l>
<l>                            riftCentersTupleMiddleInterpolated[riftCentersTupleIndex] := mean(row1CentersNonMinusOne)</l>
<l>                        endif</l>
<l>                        if(riftColumnsIndex==2)</l>
<l>                            riftCentersTupleRightInterpolated[riftCentersTupleIndex] := mean(row1CentersNonMinusOne)</l>
<l>                        endif</l>
<l>                    endif</l>
<l>                endif</l>
<c>                </c>
<l>                if(row2Centers[riftColumnsIndex]== (-1))</l>
<l>                    row2CentersNonMinusOne:=row2Centers[find(row2Centers [!=] (-1),1)]</l>
<l>                    tuple_length(row2CentersNonMinusOne, row2CentersNonMinusOneLenght)</l>
<l>                    if(row2CentersNonMinusOneLenght&gt;0)</l>
<l>                        if(riftColumnsIndex==0)</l>
<l>                            riftCentersTupleLeftInterpolated[riftCentersTupleIndex] := mean(row2CentersNonMinusOne)</l>
<l>                        endif</l>
<l>                        if(riftColumnsIndex==1)</l>
<l>                            riftCentersTupleMiddleInterpolated[riftCentersTupleIndex] := mean(row2CentersNonMinusOne)</l>
<l>                        endif</l>
<l>                        if(riftColumnsIndex==2)</l>
<l>                            riftCentersTupleRightInterpolated[riftCentersTupleIndex] := mean(row2CentersNonMinusOne)</l>
<l>                        endif</l>
<l>                    endif</l>
<l>                endif</l>
<c>                </c>
<l>                if(row3Centers[riftColumnsIndex]== (-1))</l>
<l>                    row3CentersNonMinusOne:=row3Centers[find(row3Centers [!=] (-1),1)]</l>
<l>                    tuple_length(row3CentersNonMinusOne, row3CentersNonMinusOneLenght)</l>
<l>                    if(row3CentersNonMinusOneLenght&gt;0)</l>
<l>                        if(riftColumnsIndex==0)</l>
<l>                            riftCentersTupleLeftInterpolated[riftCentersTupleIndex] := mean(row3CentersNonMinusOne)</l>
<l>                        endif</l>
<l>                        if(riftColumnsIndex==1)</l>
<l>                            riftCentersTupleMiddleInterpolated[riftCentersTupleIndex] := mean(row3CentersNonMinusOne)</l>
<l>                        endif</l>
<l>                        if(riftColumnsIndex==2)</l>
<l>                            riftCentersTupleRightInterpolated[riftCentersTupleIndex] := mean(row3CentersNonMinusOne)</l>
<l>                        endif</l>
<l>                    endif</l>
<l>                endif</l>
<c>                </c>
<l>                if(row4Centers[riftColumnsIndex]== (-1))</l>
<l>                    row4CentersNonMinusOne:=row4Centers[find(row4Centers [!=] (-1),1)]</l>
<l>                    tuple_length(row4CentersNonMinusOne, row4CentersNonMinusOneLenght)</l>
<l>                    if(row4CentersNonMinusOneLenght&gt;0)</l>
<l>                        if(riftColumnsIndex==0)</l>
<l>                            riftCentersTupleLeftInterpolated[riftCentersTupleIndex] := mean(row4CentersNonMinusOne)</l>
<l>                        endif</l>
<l>                        if(riftColumnsIndex==1)</l>
<l>                            riftCentersTupleMiddleInterpolated[riftCentersTupleIndex] := mean(row4CentersNonMinusOne)</l>
<l>                        endif</l>
<l>                        if(riftColumnsIndex==2)</l>
<l>                            riftCentersTupleRightInterpolated[riftCentersTupleIndex] := mean(row4CentersNonMinusOne)</l>
<l>                        endif</l>
<l>                    endif</l>
<l>                endif</l>
<c>                </c>
<l>            endfor</l>
<l>        endfor</l>
<l>return ()</l>
</body>
<docu id="gDominik_interpolateOmittedRiftCenters">
<parameters>
<parameter id="riftCentersTupleLeft">
<default_type>real</default_type>
<sem_type>real</sem_type>
<type_list>
<item>real</item>
</type_list>
</parameter>
<parameter id="riftCentersTupleLeftInterpolated">
<default_type>real</default_type>
<sem_type>real</sem_type>
<type_list>
<item>real</item>
</type_list>
</parameter>
<parameter id="riftCentersTupleMiddle">
<default_type>real</default_type>
<sem_type>real</sem_type>
<type_list>
<item>real</item>
</type_list>
</parameter>
<parameter id="riftCentersTupleMiddleInterpolated">
<default_type>real</default_type>
<sem_type>real</sem_type>
<type_list>
<item>real</item>
</type_list>
</parameter>
<parameter id="riftCentersTupleRight">
<default_type>real</default_type>
<sem_type>real</sem_type>
<type_list>
<item>real</item>
</type_list>
</parameter>
<parameter id="riftCentersTupleRightInterpolated">
<default_type>real</default_type>
<sem_type>real</sem_type>
<type_list>
<item>real</item>
</type_list>
</parameter>
<parameter id="usedChannelWidth">
<default_type>integer</default_type>
<sem_type>integer</sem_type>
<type_list>
<item>integer</item>
</type_list>
</parameter>
</parameters>
</docu>

<l>Segmentation_ColourSupport_OpeningAfterSegmentation_MaskSize := dict_Segmentation.V_Segmentation_ColourSupport_AreaToSelect_MinSize.Value</l>
<l>Segmentation_ColourSupport_AreaToSelect_MinSize := dict_Segmentation.V_Segmentation_ColourSupport_AreaToSelect_MinSize.Value</l>
<l>Segmentation_ColourSupport_Threshold_RedMin := dict_Segmentation.V_Segmentation_ColourSupport_Threshold_RedMin.Value</l>
<l>Segmentation_ColourSupport_Threshold_RedMax := dict_Segmentation.V_Segmentation_ColourSupport_Threshold_RedMax.Value</l>
<l>Segmentation_SmallestSingleObjectFilter_Area_Min := dict_Segmentation.V_Segmentation_SmallestSingleObjectFilter_Area_Min.Value</l>
<l>Segmentation_DarkOnBright0_BrightOnDark_1:= dict_Segmentation.V_Segmentation_DarkOnBright0_BrightOnDark1.Value</l>

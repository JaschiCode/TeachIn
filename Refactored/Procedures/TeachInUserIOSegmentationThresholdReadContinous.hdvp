<?xml version="1.0" encoding="UTF-8"?>
<hdevelop file_version="1.2" halcon_version="25.11.0.0">
<procedure name="TeachInUserIOSegmentationThresholdReadContinous">
<interface/>
<body>
<c>* TeachInUserIOSegmentationThresholdReadContinous</c>
<c>* -------------------------------------------------------------</c>
<c></c>
<l>global tuple App</l>
<c></c>
<l>while (1)</l>
<l>    wait_seconds (0.5)</l>
<c>    </c>
<c>    * Read again the format conten of TabletInspection to update SegmentationThreshold value</c>
<l>    FormatReadDict ('TabletInspection')</l>
<c>    </c>
<c>    * Stop the thread after the LineProfile Step</c>
<l>    if (App.TeachIn.UserIO.StopMonitoringFileIO)</l>
<l>        break</l>
<l>    endif</l>
<c>    </c>
<l>endwhile</l>
<c></c>
<l>return ()</l>
</body>
<docu id="TeachInUserIOSegmentationThresholdReadContinous">
<parameters/>
</docu>
</procedure>
</hdevelop>

<?xml version="1.0" encoding="UTF-8"?>
<hdevelop file_version="1.2" halcon_version="25.11.0.0">
<procedure name="TeachInUserIOMonitorFileIO">
<interface/>
<body>
<c>* TeachInUserIOMonitorFileIO</c>
<c>* -----------------------------------------------------------</c>
<l>global tuple App</l>
<c></c>
<l>BtnBreak := 2</l>
<c></c>
<l>while (1)</l>
<c>    </c>
<l>    wait_seconds (0.2)</l>
<c>    </c>
<l>    file_exists (App.Filesystem.Temp.Files.ButtonInterfaceFromGUI, FileExists)</l>
<l>    if (FileExists)</l>
<l>        Error := 2</l>
<l>        open_file (App.Filesystem.Temp.Files.ButtonInterfaceFromGUI, 'input', FileHandle)</l>
<l>        fread_line (FileHandle, OutLine, IsEOF)</l>
<l>        close_file (FileHandle)</l>
<l>        dev_set_check ('~give_error')</l>
<l>        delete_file (App.Filesystem.Temp.Files.ButtonInterfaceFromGUI)</l>
<l>        dev_set_check ('give_error')</l>
<c>        </c>
<l>        Position := strchr(OutLine, '\n')</l>
<l>        App.TeachIn.UserIO.ExternalBtnPressed := number(str_firstn(OutLine, Position-1))</l>
<l>        if (App.TeachIn.UserIO.ExternalBtnPressed == BtnBreak)</l>
<l>            break</l>
<l>        endif</l>
<l>    endif</l>
<l>    if (App.TeachIn.UserIO.StopMonitoringFileIO)</l>
<l>        break</l>
<l>    endif</l>
<c>    </c>
<l>endwhile</l>
<c></c>
<l>return ()</l>
</body>
<docu id="TeachInUserIOMonitorFileIO">
<parameters/>
</docu>
</procedure>
</hdevelop>

<?xml version="1.0" encoding="UTF-8"?>
<hdevelop file_version="1.2" halcon_version="25.11.0.0">
<procedure name="InspectionSplitIntoSingleTablets">
<interface>
<ic>
<par name="ProcessingThreadID" base_type="ctrl" dimension="0"/>
<par name="FeatureActive" base_type="ctrl" dimension="0"/>
</ic>
<oc>
<par name="TimeNeeded" base_type="ctrl" dimension="0"/>
</oc>
</interface>
<body>
<c>* InspectionSplitIntoSingleTablets</c>
<c>* -------------------------------------------------------</c>
<c></c>
<l>global tuple App</l>
<c></c>
<l>count_seconds (TimeStart)</l>
<c></c>
<c></c>
<c>* Get variables from dictionary</c>
<l>ImageHSV       := App.Inspection.Threads.[ProcessingThreadID].Images.TopLight.HSV.AllChannel</l>
<l>LanesROIs      := App.Inspection.Threads.[ProcessingThreadID].Regions.Lanes.ROIs</l>
<l>RegionTablets  := App.Inspection.Threads.[ProcessingThreadID].Regions.Tablets.Segmented</l>
<c></c>
<c></c>
<l>if (FeatureActive)</l>
<c>    * Split the tablets based on different possible modes to get them seperated if they are to near to each other</c>
<l>    count_obj (LanesROIs, NumberOfObjectsToProcessParallel)</l>
<l>    gen_empty_obj (RegionTabletsIndividual)</l>
<l>    for IdxLane := 0 to NumberOfObjectsToProcessParallel-1 by 1</l>
<l>        select_obj (LanesROIs, LaneROI, IdxLane+1)</l>
<l>        intersection (LaneROI, RegionTablets, RegionTablet)</l>
<l>        InspectionSplitIntoSingleTabletsDifferentModes (RegionTablet, RegionTabletIndividual, ProcessingThreadID, IdxLane)</l>
<l>        concat_obj (RegionTabletsIndividual, RegionTabletIndividual, RegionTabletsIndividual)</l>
<l>    endfor</l>
<c>    </c>
<l>    stop()</l>
<l>    +++ Go on here !!!</l>
<c>    </c>
<c>    * Remove tablets that crosses the border of the lane, but keep them in seperate parameter</c>
<l>    InspectionSplitIntoSingleTabletsRemoveRegionsThatCrossTheBorder (ImageHSV, RegionTabletsIndividual, LanesROIs, RegionTabletsOnBorder, RegionTabletsToRemove)</l>
<c></c>
<l>else</l>
<l>    RegionTabletsIndividual := RegionTablets</l>
<c>    </c>
<l>endif</l>
<c></c>
<l>App.Inspection.Threads.[ProcessingThreadID].Regions.Tablets.Individual := RegionTabletsIndividual</l>
<l>App.Inspection.Threads.[ProcessingThreadID].Regions.Tablets.OnBorder </l>
<c></c>
<c></c>
<c>* Remove empty regions</c>
<l>RegionTabletsIndividual := App.Inspection.Threads.[ProcessingThreadID].Regions.Tablets.Individual</l>
<l>select_shape (RegionTabletsIndividual, RegionTabletsIndividual, 'area', 'and', 1, 1e6)</l>
<c></c>
<c></c>
<l>App.Inspection.Threads.[ProcessingThreadID].Regions.Tablets.Individual := RegionTabletsIndividual</l>
<c></c>
<l>count_seconds (TimeEnd)</l>
<l>TimeNeeded := (TimeEnd - TimeStart) * 1000</l>
<c></c>
<l>return ()</l>
</body>
<docu id="InspectionSplitIntoSingleTablets">
<parameters>
<parameter id="FeatureActive"/>
<parameter id="ProcessingThreadID"/>
<parameter id="TimeNeeded"/>
</parameters>
</docu>
</procedure>
</hdevelop>

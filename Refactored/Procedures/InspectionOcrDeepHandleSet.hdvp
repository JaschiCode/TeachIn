<?xml version="1.0" encoding="UTF-8"?>
<hdevelop file_version="1.2" halcon_version="25.11.0.0">
<procedure name="InspectionOcrDeepHandleSet">
<interface>
<ic>
<par name="OCRHandle" base_type="ctrl" dimension="0"/>
</ic>
</interface>
<body>
<c>* Registriert den geladenen Deep-OCR-Handle vor dem Start der parallelen Inspektion.</c>
<c>* Der globale Handle bleibt voruebergehend als Kompatibilitaetsbruecke erhalten.</c>
<l>global tuple App</l>
<l>global tuple DeepOcrHandle</l>
<l>App.OCR.DeepOCR.Handle := OCRHandle</l>
<l>App.OCR.DeepOCR.HandleRegistered := true</l>
<l>DeepOcrHandle := OCRHandle</l>
<l>return ()</l>
</body>
<docu id="InspectionOcrDeepHandleSet">
<parameters>
<parameter id="OCRHandle"/>
</parameters>
</docu>
</procedure>
</hdevelop>

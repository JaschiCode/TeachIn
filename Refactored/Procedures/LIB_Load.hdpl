<?xml version="1.0" encoding="UTF-8"?>
<hdevelop file_version="1.2" halcon_version="25.11.0.0">
<library/>
<procedure name="add_NumberOfDetectionsThatLeadToEject">
<interface>
<ic>
<par name="dict_Feature" base_type="ctrl" dimension="0"/>
<par name="NumberOfDetectionsLeadToEject_PerLinePerFeature" base_type="ctrl" dimension="0"/>
<par name="CriticalDefectActive_PerLinePerFeature" base_type="ctrl" dimension="0"/>
</ic>
<oc>
<par name="NumberOfDetectionsLeadToEject_PerLinePerFeatureOut" base_type="ctrl" dimension="0"/>
<par name="CriticalDefectActive_PerLinePerFeatureOut" base_type="ctrl" dimension="0"/>
</oc>
</interface>
<body>
<c>    * check if the given feature is active. if yes, add the number of detections that lead to eject</c>
<c></c>
<l>    NumberOfDetectionsLeadToEject_PerLinePerFeatureOut := NumberOfDetectionsLeadToEject_PerLinePerFeature</l>
<l>    CriticalDefectActive_PerLinePerFeatureOut := CriticalDefectActive_PerLinePerFeature</l>
<c>    </c>
<l>    if(dict_Feature.V_FeatureActive.Value)</l>
<l>        NumberOfDetectionsLeadToEject_PerLinePerFeatureOut := [NumberOfDetectionsLeadToEject_PerLinePerFeatureOut, dict_Feature.V_NumberOfDetectionsLeadToEject.Value]</l>
<l>        CriticalDefectActive_PerLinePerFeatureOut := [CriticalDefectActive_PerLinePerFeatureOut, dict_Feature.V_CriticalDefectActive.Value]</l>
<l>    endif</l>
<l>return ()</l>
</body>
<docu id="add_NumberOfDetectionsThatLeadToEject">
<parameters>
<parameter id="CriticalDefectActive_PerLinePerFeature"/>
<parameter id="CriticalDefectActive_PerLinePerFeatureOut"/>
<parameter id="NumberOfDetectionsLeadToEject_PerLinePerFeature"/>
<parameter id="NumberOfDetectionsLeadToEject_PerLinePerFeatureOut"/>
<parameter id="dict_Feature"/>
</parameters>
</docu>
</procedure>
<procedure name="gCameraModule_WriteExposureTimeData">
<interface>
<ic>
<par name="VTFiledefinitions" base_type="ctrl" dimension="1"/>
<par name="FileElementNumber" base_type="ctrl" dimension="0"/>
<par name="TeachInMode" base_type="ctrl" dimension="0"/>
<par name="Camera_Light0_Brightness" base_type="ctrl" dimension="0"/>
<par name="Camera_Light1_Brightness" base_type="ctrl" dimension="0"/>
<par name="Camera_Light2_Brightness" base_type="ctrl" dimension="0"/>
</ic>
</interface>
<body>
<l>VTDataVector.at(0) := []</l>
<c>* Read JSON-File</c>
<l>FilenameToLoad := VTFiledefinitions.at(FileElementNumber)[1]</l>
<c></c>
<c>* read current file</c>
<l>gJSON_Read_File_to_Vector (FilenameToLoad, ParameterVector)</l>
<c>* set values</c>
<l>gJSON_Set_Value_in_Vector ('/FPGA/V_Camera_FPGA_TopLight_MicroSec/Value', ParameterVector, Camera_Light1_Brightness, ParameterVector)        // Top light       </l>
<l>gJSON_Set_Value_in_Vector ('/FPGA/V_Camera_FPGA_UVLight_Gain/Value', ParameterVector, Camera_Light2_Brightness, ParameterVector)             // UV light   </l>
<l>gJSON_Set_Value_in_Vector ('/FPGA/V_Camera_FPGA_BackLight_MicroSec/Value', ParameterVector, Camera_Light0_Brightness, ParameterVector)       // Back light    </l>
<c></c>
<c>* write file with udated data</c>
<l>gJSON_Save_Vector_as_File (FilenameToLoad, ParameterVector)   </l>
<c></c>
<c>*************************************************************</c>
<c></c>
<l>return ()</l>
</body>
<docu id="gCameraModule_WriteExposureTimeData">
<chapters lang="de_DE">
<item>Load_Data</item>
</chapters>
<short lang="de_DE">Load from Inifile Camera, Image and IO PArameter</short>
<parameters>
<parameter id="Camera_Light0_Brightness"/>
<parameter id="Camera_Light1_Brightness"/>
<parameter id="Camera_Light2_Brightness"/>
<parameter id="FileElementNumber"/>
<parameter id="TeachInMode"/>
<parameter id="VTFiledefinitions"/>
</parameters>
</docu>
</procedure>
<procedure name="gColourLoadingPreprocessing">
<interface>
<ic>
<par name="VTFiledefinitions" base_type="ctrl" dimension="1"/>
<par name="VTPrintinspection" base_type="ctrl" dimension="1"/>
<par name="VTTabletInspection" base_type="ctrl" dimension="1"/>
<par name="VTCamera" base_type="ctrl" dimension="1"/>
<par name="TeachInMode" base_type="ctrl" dimension="0"/>
</ic>
<oc>
<par name="ColourClassificationHandle" base_type="ctrl" dimension="0"/>
<par name="ColorTransLUTHandle_RGB_To_HSV" base_type="ctrl" dimension="0"/>
<par name="ColorTransLUTHandle_YUV_To_RGB" base_type="ctrl" dimension="0"/>
</oc>
</interface>
<body>
<l>gGetSubObjectVariables_SingleValue (VTCamera, 'V_Camera_UseMultipleColourscpaces', UseMultipleColourscpaces)</l>
<c></c>
<l>gGetSubObjectVariables_SingleValue (VTFiledefinitions, 'ColourClassificationFilename', ColourClassificationFilename)</l>
<c></c>
<l>gGetSubObjectVariables_SingleValue (VTPrintinspection, 'V_FeatureActive', PrintInspectionActive)</l>
<l>gGetSubObjectVariables_SingleValue (VTTabletInspection, 'Measure_ProductSpot/V_FeatureActive', SpotDetectionActive)</l>
<l>gGetSubObjectVariables_SingleValue (VTTabletInspection, 'Measure_ProductPrint/V_FeatureActive', PrintDetectionActive)</l>
<c></c>
<l>if (PrintInspectionActive = 1 or SpotDetectionActive = 1)</l>
<l>    TabletSpot_DetectionActive := 1</l>
<l>else</l>
<l>    TabletSpot_DetectionActive := 0</l>
<l>endif</l>
<c></c>
<l>get_system ('processor_num', NumberOfProcessors)</l>
<l>if(NumberOfProcessors &gt; 1)</l>
<c>    * use max amount of cpu power - but leave one cpu available for other system related things</c>
<l>    NumberOfProcessors := NumberOfProcessors -1</l>
<l>endif</l>
<l>set_system ('thread_num', NumberOfProcessors)</l>
<c></c>
<c>* use colour spot detection. if not activated in the later process phase it is identified via the empty colourhandle</c>
<l>if ((TabletSpot_DetectionActive = 1 and TeachInMode = 0) or (PrintDetectionActive = 1 and TeachInMode = 0))</l>
<l>    read_class_mlp (ColourClassificationFilename, MLPHandle)</l>
<l>    set_system ('parallelize_operators', 'true') </l>
<c>    *** Janine - Update for Achema</c>
<c>    *** Use rejecte_threshold for images with uv-light to get better results</c>
<l>*     create_class_lut_mlp (MLPHandle, [], [], ColourClassificationHandle)</l>
<l>    create_class_lut_mlp (MLPHandle, ['rejection_threshold'], [0.1], ColourClassificationHandle)</l>
<c>    *** End Janine - Update for Achema</c>
<l>    set_system ('parallelize_operators', 'false')</l>
<l>else</l>
<l>    ColourClassificationHandle := []</l>
<l>endif</l>
<c>* </c>
<l>if(UseMultipleColourscpaces = 1)</l>
<l>    set_system ('parallelize_operators', 'true')</l>
<l>    create_color_trans_lut ('hsv', 'from_rgb', 8, ColorTransLUTHandle_RGB_To_HSV)</l>
<l>    set_system ('parallelize_operators', 'false')</l>
<l>else</l>
<l>    ColorTransLUTHandle_RGB_To_HSV:=[]</l>
<l>endif</l>
<c></c>
<c>* check if one of hte connected cameras needs a yuv-converseion</c>
<c>* in the vector VTData should be a</c>
<l>gGetSubObjectVariables (VTCamera, 'V_Debayerpattern', VTempVariable)</l>
<l>VectorLength := VTempVariable.length()</l>
<l>YUVConversionActive := 0</l>
<l>for IndexVector := 0 to VectorLength-1 by 1</l>
<l>    if (VTempVariable.at(IndexVector)[1] = 'YUVFromCamera')</l>
<l>        YUVConversionActive := 1</l>
<l>    endif    </l>
<l>endfor</l>
<c></c>
<c>* hier muss noch lut korrekt geladen werden</c>
<l>if(YUVConversionActive = 1)</l>
<l>    set_system ('parallelize_operators', 'true')</l>
<l>    create_color_trans_lut ('yuv', 'to_rgb', 8, ColorTransLUTHandle_YUV_To_RGB)</l>
<l>    set_system ('parallelize_operators', 'false')</l>
<l>else</l>
<l>    ColorTransLUTHandle_YUV_To_RGB:=[]</l>
<l>endif</l>
<c>* </c>
<l>return ()</l>
</body>
<docu id="gColourLoadingPreprocessing">
<parameters>
<parameter id="ColorTransLUTHandle_RGB_To_HSV"/>
<parameter id="ColorTransLUTHandle_YUV_To_RGB"/>
<parameter id="ColourClassificationHandle"/>
<parameter id="TeachInMode"/>
<parameter id="VTCamera"/>
<parameter id="VTFiledefinitions"/>
<parameter id="VTPrintinspection"/>
<parameter id="VTTabletInspection"/>
</parameters>
</docu>
</procedure>
<procedure name="get_number_of_detections_that_lead_to_eject">
<interface>
<oc>
<par name="NumberOfDetectionsLeadToEject_PerLinePerFeature" base_type="ctrl" dimension="0"/>
<par name="CriticalDefectActive_PerLinePerFeature" base_type="ctrl" dimension="0"/>
</oc>
</interface>
<body>
<l>global tuple dict_TabletInspection</l>
<c>* todo: </c>
<c>* 1. gewählte feature prüfen</c>
<c>* 2. In Konfigurationen eine Eingabe der möglichen Feature einfügen, damit diese beim Einfügen/Entfernen von Features nicht jedes Mal an mehreren Stellen von Hand geändert werden müssen</c>
<c></c>
<c>* create a tuple for number of detections that lead to eject for each active feature and another tuple for critical defect active for each active feature</c>
<l>NumberOfDetectionsLeadToEject_PerLinePerFeature := []</l>
<l>CriticalDefectActive_PerLinePerFeature := []</l>
<l>add_NumberOfDetectionsThatLeadToEject (dict_TabletInspection.Measure_ProductLength, NumberOfDetectionsLeadToEject_PerLinePerFeature, CriticalDefectActive_PerLinePerFeature, NumberOfDetectionsLeadToEject_PerLinePerFeature, CriticalDefectActive_PerLinePerFeature)</l>
<l>add_NumberOfDetectionsThatLeadToEject (dict_TabletInspection.Measure_ProductWidth, NumberOfDetectionsLeadToEject_PerLinePerFeature, CriticalDefectActive_PerLinePerFeature, NumberOfDetectionsLeadToEject_PerLinePerFeature, CriticalDefectActive_PerLinePerFeature)</l>
<l>add_NumberOfDetectionsThatLeadToEject (dict_TabletInspection.Measure_ProductArea, NumberOfDetectionsLeadToEject_PerLinePerFeature, CriticalDefectActive_PerLinePerFeature, NumberOfDetectionsLeadToEject_PerLinePerFeature, CriticalDefectActive_PerLinePerFeature)</l>
<l>add_NumberOfDetectionsThatLeadToEject (dict_TabletInspection.Measure_ProductColour1, NumberOfDetectionsLeadToEject_PerLinePerFeature, CriticalDefectActive_PerLinePerFeature, NumberOfDetectionsLeadToEject_PerLinePerFeature, CriticalDefectActive_PerLinePerFeature)</l>
<l>add_NumberOfDetectionsThatLeadToEject (dict_TabletInspection.Measure_ProductColour2, NumberOfDetectionsLeadToEject_PerLinePerFeature, CriticalDefectActive_PerLinePerFeature, NumberOfDetectionsLeadToEject_PerLinePerFeature, CriticalDefectActive_PerLinePerFeature)</l>
<l>add_NumberOfDetectionsThatLeadToEject (dict_TabletInspection.Measure_ProductColour3, NumberOfDetectionsLeadToEject_PerLinePerFeature, CriticalDefectActive_PerLinePerFeature, NumberOfDetectionsLeadToEject_PerLinePerFeature, CriticalDefectActive_PerLinePerFeature)</l>
<l>add_NumberOfDetectionsThatLeadToEject (dict_TabletInspection.Measure_ProductSpot, NumberOfDetectionsLeadToEject_PerLinePerFeature, CriticalDefectActive_PerLinePerFeature, NumberOfDetectionsLeadToEject_PerLinePerFeature, CriticalDefectActive_PerLinePerFeature)</l>
<l>add_NumberOfDetectionsThatLeadToEject (dict_TabletInspection.Measure_ProductPRV, NumberOfDetectionsLeadToEject_PerLinePerFeature, CriticalDefectActive_PerLinePerFeature, NumberOfDetectionsLeadToEject_PerLinePerFeature, CriticalDefectActive_PerLinePerFeature)</l>
<l>add_NumberOfDetectionsThatLeadToEject (dict_TabletInspection.Measure_ProductPCC, NumberOfDetectionsLeadToEject_PerLinePerFeature, CriticalDefectActive_PerLinePerFeature, NumberOfDetectionsLeadToEject_PerLinePerFeature, CriticalDefectActive_PerLinePerFeature)</l>
<l>add_NumberOfDetectionsThatLeadToEject (dict_TabletInspection.Measure_ProductOCR, NumberOfDetectionsLeadToEject_PerLinePerFeature, CriticalDefectActive_PerLinePerFeature, NumberOfDetectionsLeadToEject_PerLinePerFeature, CriticalDefectActive_PerLinePerFeature)</l>
<c> </c>
<l>return ()</l>
</body>
<docu id="get_number_of_detections_that_lead_to_eject">
<parameters>
<parameter id="CriticalDefectActive_PerLinePerFeature"/>
<parameter id="NumberOfDetectionsLeadToEject_PerLinePerFeature"/>
</parameters>
</docu>
</procedure>
<procedure name="gFramegrabber_OpenAndInit">
<interface>
<ic>
<par name="PathToCheckForLocalCameraUsed" base_type="ctrl" dimension="0"/>
<par name="DebugWorkOnFirstCameraOnly" base_type="ctrl" dimension="0"/>
<par name="VTCamera" base_type="ctrl" dimension="1"/>
<par name="CameraNumberToOpen" base_type="ctrl" dimension="0"/>
</ic>
<oc>
<par name="AcqHandle" base_type="ctrl" dimension="0"/>
<par name="CameraNumberUsed" base_type="ctrl" dimension="0"/>
<par name="CameraCorrectlyInitialised" base_type="ctrl" dimension="0"/>
</oc>
</interface>
<body>
<c>* module init´s the framegrabbers if available. </c>
<c>* specials for 360 configuration: // the timeout is relevant for the machineindexreset - due to it is in relation to a framegrabber timeout</c>
<l>global tuple gGrab_Timeout</l>
<l>global tuple g360InspectionActive</l>
<l>global def tuple gFramegrabberFirstImageToInitTaken</l>
<l>global def tuple gFramegrabberInitFrames</l>
<l>global tuple vector(1) gVTCalibrationMSA</l>
<l>* global tuple gFramegrabber_GrabParalelCameras</l>
<c></c>
<l>* gFramegrabber_GrabParalelCameras := 1 </l>
<c>* </c>
<l>AcqHandle := []</l>
<l>CameraNumberUsed := 0</l>
<l>CameraCorrectlyInitialised := 0</l>
<l>gFramegrabberFirstImageToInitTaken := 0 // variable to skip first image that was grabben on SiSo interface</l>
<l>gFramegrabberInitFrames := 10 // count of mono colored images to init queues and complete engine cycle</l>
<c>* Simple example for grabbing images via the pylon interface</c>
<c>* </c>
<l>gGetSubObjectVariables (VTCamera, '/V_Camera_WorkOnCameraEnable/Value', WorkOnCameraEnable)</l>
<l>gGetSubObjectVariables (VTCamera, '/V_Camera_NumberOfConnectedCameras/Value', NumberOfConnectedCameras)</l>
<l>gGetSubObjectVariables (VTCamera, '/V_Camera_UseCameraIOsAsDirectEjectSignals/Value', UseCameraIOsAsDirectEjectSignals)</l>
<l>gGetSubObjectVariables (VTCamera, '/V_Camera_GrabSequencer_Active/Value', GrabSequencer_Active)</l>
<c></c>
<c>* load data for each camera ans store it in tuple </c>
<l>gGetSubObjectVariables (VTCamera, '/V_Debayerpattern/Value', DebayerpatternTpl)</l>
<l>gGetSubObjectVariables (VTCamera, '/V_Exposuretime/Value', ExposuretimeTpl)</l>
<l>gGetSubObjectVariables (VTCamera, '/V_Gain/Value', GainTpl)</l>
<l>gGetSubObjectVariables (VTCamera, '/V_FPS/Value', FPSTpl)</l>
<c>* </c>
<l>gGetSubObjectVariables (VTCamera, '/V_ImageGrabResolution_Width/Value', ImageGrabResolution_WidthTpl)</l>
<l>gGetSubObjectVariables (VTCamera, '/V_ImageGrabResolution_Height/Value', ImageGrabResolution_HeightTpl)</l>
<l>gGetSubObjectVariables (VTCamera, '/V_ImageGrabOffset_X/Value', ImageGrabOffset_XTpl)</l>
<l>gGetSubObjectVariables (VTCamera, '/V_ImageGrabOffset_Y/Value', ImageGrabOffset_YTpl)</l>
<l>gGetSubObjectVariables (VTCamera, '/V_GammaEnable/Value', GammaEnable_Tpl)</l>
<c></c>
<l>gGetSubObjectVariables_SingleValue (VTCamera, '/General/V_Camera_InternalTrigger0_External1/Value', InternalTrigger0_External1)</l>
<l>gGetSubObjectVariables_SingleValue (VTCamera, '/General/V_Camera_BrandInterface/Value', BrandInterface)</l>
<c></c>
<l>if (BrandInterface = 'SiliconSoftware')</l>
<l>    SiliconSoftwareGrabberActive := 1</l>
<l>else</l>
<l>    SiliconSoftwareGrabberActive := 0</l>
<l>endif</l>
<c>* </c>
<c></c>
<c></c>
<l>if (WorkOnCameraEnable.at(0)[1] &gt;= 1)  </l>
<l>    if (SiliconSoftwareGrabberActive = 1)</l>
<l>        gGetSubObjectVariables_SingleValue (VTCamera, '/FPGA/V_Camera_FPGA_TopLight_MicroSec/Value', Camera_FPGA_TopLight_MicroSec)      </l>
<l>        gGetSubObjectVariables_SingleValue (VTCamera, '/FPGA/V_Camera_FPGA_TopLight_SupportBackLight_MicroSec/Value', Camera_FPGA_TopLight_SupportBackLight_MicroSec)</l>
<l>        gGetSubObjectVariables_SingleValue (VTCamera, '/FPGA/V_Camera_FPGA_BackLight_MicroSec/Value', Camera_FPGA_BackLight_MicroSec)  </l>
<l>        gGetSubObjectVariables_SingleValue (VTCamera, '/FPGA/V_Camera_FPGA_UVLight_Gain/Value', Camera_FPGA_UVLight_Gain)</l>
<c>        * Signal length Eject </c>
<l>        gGetSubObjectVariables_SingleValue (VTCamera, '/FPGA/V_Camera_FPGA_EjectPulseLength_SampleEject_MicroSec/Value', Camera_FPGA_EjectPulseLength_SampleEject_MicroSec)</l>
<l>        gGetSubObjectVariables_SingleValue (VTCamera, '/FPGA/V_Camera_FPGA_EjectPulseLength_MicroSec/Value', Camera_FPGA_EjectPulseLength_MicroSec)   </l>
<l>        gGetSubObjectVariables_SingleValue (VTCamera, '/FPGA/V_Camera_FPGA_EjectPulseLength_Offset_MicroSec_Lane0/Value', Camera_FPGA_EjectPulseLength_Offset_MicroSec_Lane0)</l>
<l>        gGetSubObjectVariables_SingleValue (VTCamera, '/FPGA/V_Camera_FPGA_EjectPulseLength_Offset_MicroSec_Lane1/Value', Camera_FPGA_EjectPulseLength_Offset_MicroSec_Lane1)</l>
<l>        gGetSubObjectVariables_SingleValue (VTCamera, '/FPGA/V_Camera_FPGA_EjectPulseLength_Offset_MicroSec_Lane2/Value', Camera_FPGA_EjectPulseLength_Offset_MicroSec_Lane2)</l>
<l>        gGetSubObjectVariables_SingleValue (VTCamera, '/FPGA/V_Camera_FPGA_EjectPulseLength_Offset_MicroSec_Lane3/Value', Camera_FPGA_EjectPulseLength_Offset_MicroSec_Lane3)</l>
<l>        gGetSubObjectVariables_SingleValue (VTCamera, '/FPGA/V_Camera_FPGA_EjectPulseLength_Offset_MicroSec_Lane4/Value', Camera_FPGA_EjectPulseLength_Offset_MicroSec_Lane4)</l>
<l>        gGetSubObjectVariables_SingleValue (VTCamera, '/FPGA/V_Camera_FPGA_EjectPulseLength_Offset_MicroSec_Lane5/Value', Camera_FPGA_EjectPulseLength_Offset_MicroSec_Lane5)</l>
<l>        gGetSubObjectVariables_SingleValue (VTCamera, '/FPGA/V_Camera_FPGA_EjectPulseLength_Offset_MicroSec_Lane6/Value', Camera_FPGA_EjectPulseLength_Offset_MicroSec_Lane6)</l>
<l>        gGetSubObjectVariables_SingleValue (VTCamera, '/FPGA/V_Camera_FPGA_EjectPulseLength_Offset_MicroSec_Lane7/Value', Camera_FPGA_EjectPulseLength_Offset_MicroSec_Lane7)</l>
<l>        gGetSubObjectVariables_SingleValue (VTCamera, '/FPGA/V_Camera_FPGA_EjectPulseLength_Offset_MicroSec_Lane8/Value', Camera_FPGA_EjectPulseLength_Offset_MicroSec_Lane8)</l>
<l>        gGetSubObjectVariables_SingleValue (VTCamera, '/FPGA/V_Camera_FPGA_EjectPulseLength_Offset_MicroSec_Lane9/Value', Camera_FPGA_EjectPulseLength_Offset_MicroSec_Lane9)</l>
<l>        gGetSubObjectVariables_SingleValue (VTCamera, '/FPGA/V_Camera_FPGA_EjectPulseLength_Offset_MicroSec_Lane10/Value', Camera_FPGA_EjectPulseLength_Offset_MicroSec_Lane10)</l>
<l>        gGetSubObjectVariables_SingleValue (VTCamera, '/FPGA/V_Camera_FPGA_EjectPulseLength_Offset_MicroSec_Lane11/Value', Camera_FPGA_EjectPulseLength_Offset_MicroSec_Lane11)</l>
<c>        </c>
<c>        * check for framegrabber parameter and set applet</c>
<l>        info_framegrabber ('SiliconSoftware', 'camera_type', CameraTypeInfo, CameraTypeInfoValues)</l>
<l>        info_framegrabber ('SiliconSoftware', 'defaults', DefaultInfo, DefaultInfoValues)</l>
<l>        info_framegrabber ('SiliconSoftware', 'device', DeviceInfo, DeviceInfoValues)</l>
<l>        info_framegrabber ('SiliconSoftware', 'general', GeneralInfo, GeneralInfoValues)</l>
<l>        info_framegrabber ('SiliconSoftware', 'info_boards', BoardInfo, BoardInfoValues)</l>
<l>        info_framegrabber ('SiliconSoftware', 'port', PortInfo, PortInfoValues)</l>
<l>        info_framegrabber ('SiliconSoftware', 'parameters', ParameterInfo, ParameterInfoValues)</l>
<l>        info_framegrabber ('SiliconSoftware', 'revision', RevisionInfo, RevisionInfoValues)</l>
<l>        MyCamType := 'C:/Program Files/SiliconSoftware/Runtime5.7.0/Hardware Applets/mE5-MA-VCX-QP/PillInspect_V33_5_internalTrigger_hsv.mcf'</l>
<l>        MyCamType := 'C:/Program Files/SiliconSoftware/Runtime5.7.0/Hardware Applets/mE5-MA-VCX-QP/PillInspect_V33_5_2_externalTrigger_hsv.mcf'</l>
<l>        MyCamType := 'C:/Program Files/SiliconSoftware/Runtime5.7.0/Hardware Applets/mE5-MA-VCX-QP/PillInspect_V33_5_3_externalTrigger_hsv.mcf'</l>
<c>         </c>
<l>        GrabBuffer_SizeInFrames := 50 </l>
<l>        AcqHandle_temp := []</l>
<l>*         stop()        </l>
<l>        TestGrabber := 1 </l>
<l>*         stop()  </l>
<l>        if(TestGrabber) </l>
<l>            gFramegrabber_OpenAndInit_FileSynchronisation_CameraNumberUsed (DebugWorkOnFirstCameraOnly, PathToCheckForLocalCameraUsed, CameraNumberUsed)</l>
<c>            ******************************</c>
<l>            write_tuple (CameraNumberUsed, '../temp/CamUsed' + CameraNumberUsed + '.tpl')</l>
<c>            </c>
<c>            *Christian: check ob MSA aktiv</c>
<l>            if (gVTCalibrationMSA#{})</l>
<l>                if (gVTCalibrationMSA.at(2)[1]==1 or gVTCalibrationMSA.at(1)[1]==1)</l>
<l>                    teachinactive := 1</l>
<l>                else </l>
<l>                    teachinactive := 0</l>
<l>                endif</l>
<l>            else</l>
<l>                teachinactive := 0</l>
<l>            endif</l>
<c></c>
<c>            *Christian: Überschreiben der CameraNumberUsed, da nicht die eingestellte Kamera verwendet wird; Nur für TeachIn</c>
<l>            if (teachinactive == 1)</l>
<l>                CameraNumberUsed := CameraNumberToOpen</l>
<l>            endif</l>
<c>            ***</c>
<c>            </c>
<c>            * delete initialized flag if available</c>
<l>            file_exists (PathToCheckForLocalCameraUsed + 'CamInitialised_' + CameraNumberUsed + '.txt', FileExists)</l>
<l>            if (FileExists = 1)</l>
<l>                delete_file (PathToCheckForLocalCameraUsed + 'CamInitialised_' + CameraNumberUsed + '.txt')</l>
<l>            endif</l>
<c></c>
<l>            gFramegrabber_SiSo_SetupDevice (CameraNumberUsed, DebugWorkOnFirstCameraOnly, 3, Device, Port, SlaveString)</l>
<c>            </c>
<c>            *Christian: Wenn Teachin dann ist die gewählte Kamera Master</c>
<l>            if (teachinactive == 1)</l>
<l>                SlaveString := 'slave=0'</l>
<l>            endif</l>
<c>            ***</c>
<c>            </c>
<l>            BufferString := ('num_buffers=' + GrabBuffer_SizeInFrames)</l>
<c>            </c>
<c>            *Christian: Wenn TeachIn dann wird jede Kamera so behandelt wie sonst nur Master</c>
<l>            if (teachinactive == 1)</l>
<l>                GenericParameters := [BufferString,SlaveString]</l>
<l>                dev_set_check ('~give_error')</l>
<l>                open_framegrabber ('SiliconSoftware', 1, 1, 0, 0, 0, 0, 'default', -1, 'default', GenericParameters, 'false', MyCamType, Device, Port, -1, AcqHandle)</l>
<l>                dev_set_check ('give_error') </l>
<c>                * Get the number of allowed field parameters</c>
<l>                get_framegrabber_param (AcqHandle, 'available_param_names', NumFieldParameterPow) // all available parameters listed</l>
<l>                if(DebugWorkOnFirstCameraOnly # 1) // assuming there are 3 cameras per board</l>
<c>                    **** init precondition for camera 1 and 4 (start count an 0)</c>
<l>                    gFramegrabber_SiSo_SetupDevice (CameraNumberUsed +1 , 0, 3, Device, Port, SlaveString)        </l>
<l>                    GenericParameters := [BufferString,SlaveString]</l>
<l>                    dev_set_check ('~give_error')</l>
<l>                    open_framegrabber ('SiliconSoftware', 1, 1, 0, 0, 0, 0, 'default', -1, 'default', GenericParameters, 'false', MyCamType, Device, Port, -1, AcqHandle1)</l>
<l>                    dev_set_check ('give_error') </l>
<c>                    **** init precondition for camera 2 and 5 (start count an 0)</c>
<l>                    gFramegrabber_SiSo_SetupDevice (CameraNumberUsed +2, 0, 3, Device, Port, SlaveString)</l>
<l>                    GenericParameters := [BufferString,SlaveString]</l>
<l>                    dev_set_check ('~give_error')</l>
<l>                    open_framegrabber ('SiliconSoftware', 1, 1, 0, 0, 0, 0, 'default', -1, 'default', GenericParameters, 'false', MyCamType, Device, Port, -1, AcqHandle2)</l>
<l>                    dev_set_check ('give_error')</l>
<c>                    **************************************</c>
<l>                endif</l>
<c>                * set signal that cam master is initialised</c>
<l>                open_file (PathToCheckForLocalCameraUsed + 'CamInitialised_' + CameraNumberUsed + '.txt', 'output', FileHandle)</l>
<l>                close_file (FileHandle)</l>
<c>            </c>
<l>            else</l>
<l>                if(CameraNumberUsed = 0 or CameraNumberUsed = 3) // cam 0 and 3 are the master cameras on the fpga board</l>
<l>                    GenericParameters := [BufferString,SlaveString]</l>
<l>                    dev_set_check ('~give_error')</l>
<l>                    open_framegrabber ('SiliconSoftware', 1, 1, 0, 0, 0, 0, 'default', -1, 'default', GenericParameters, 'false', MyCamType, Device, Port, -1, AcqHandle)</l>
<l>                    dev_set_check ('give_error') </l>
<c>                    * Get the number of allowed field parameters</c>
<l>                    get_framegrabber_param (AcqHandle, 'available_param_names', NumFieldParameterPow) // all available parameters listed</l>
<l>                    if(DebugWorkOnFirstCameraOnly # 1) // assuming there are 3 cameras per board</l>
<c>                        **** init precondition for camera 1 and 4 (start count an 0)</c>
<l>                        gFramegrabber_SiSo_SetupDevice (CameraNumberUsed +1 , 0, 3, Device, Port, SlaveString)        </l>
<l>                        GenericParameters := [BufferString,SlaveString]</l>
<l>                        dev_set_check ('~give_error')</l>
<l>                        open_framegrabber ('SiliconSoftware', 1, 1, 0, 0, 0, 0, 'default', -1, 'default', GenericParameters, 'false', MyCamType, Device, Port, -1, AcqHandle1)</l>
<l>                        dev_set_check ('give_error') </l>
<c>                        **** init precondition for camera 2 and 5 (start count an 0)</c>
<l>                        gFramegrabber_SiSo_SetupDevice (CameraNumberUsed +2, 0, 3, Device, Port, SlaveString)</l>
<l>                        GenericParameters := [BufferString,SlaveString]</l>
<l>                        dev_set_check ('~give_error')</l>
<l>                        open_framegrabber ('SiliconSoftware', 1, 1, 0, 0, 0, 0, 'default', -1, 'default', GenericParameters, 'false', MyCamType, Device, Port, -1, AcqHandle2)</l>
<l>                        dev_set_check ('give_error')</l>
<c>                        **************************************</c>
<l>                    endif</l>
<c>                    * set signal that cam master is initialised</c>
<l>                    open_file (PathToCheckForLocalCameraUsed + 'CamInitialised_' + CameraNumberUsed + '.txt', 'output', FileHandle)</l>
<l>                    close_file (FileHandle)</l>
<l>                else  </l>
<l>                    gFramegrabber_SiSo_SetupDevice (CameraNumberUsed, 0, 3, Device, Port, SlaveString)</l>
<c>                    **** start slave cameras only after master camera (0 or 3) are already initialized</c>
<l>                    if(CameraNumberUsed = 1 or CameraNumberUsed = 2)</l>
<l>                        while(1)</l>
<l>                            file_exists (PathToCheckForLocalCameraUsed + 'CamInitialised_0.txt', FileExists)</l>
<l>                            if (FileExists = 1)</l>
<l>                                break</l>
<l>                            else</l>
<l>                                wait_seconds(0.1)</l>
<l>                            endif</l>
<l>                        endwhile</l>
<l>                    endif                </l>
<l>                    if(CameraNumberUsed = 4 or CameraNumberUsed = 5)</l>
<l>                        while(1)</l>
<l>                            file_exists (PathToCheckForLocalCameraUsed + 'CamInitialised_3.txt', FileExists)</l>
<l>                            if (FileExists = 1)</l>
<l>                                break</l>
<l>                            else</l>
<l>                                wait_seconds(0.1)</l>
<l>                            endif</l>
<l>                        endwhile</l>
<l>                    endif</l>
<c>                    * init frame grabber</c>
<l>                    GenericParameters := [BufferString,SlaveString]</l>
<l>                    dev_set_check ('~give_error')</l>
<l>                    open_framegrabber ('SiliconSoftware', 1, 1, 0, 0, 0, 0, 'default', -1, 'default', GenericParameters, 'false', MyCamType, Device, Port, -1, AcqHandle)</l>
<l>                    dev_set_check ('give_error')</l>
<l>                    set_framegrabber_param(AcqHandle, 'image_format', 2)</l>
<c>    </c>
<c>                    ********************************************************</c>
<c>                    * set signal that cam master is initialised</c>
<l>                    open_file (PathToCheckForLocalCameraUsed + 'CamInitialised_' + CameraNumberUsed + '.txt', 'output', FileHandle)</l>
<l>                    close_file (FileHandle)</l>
<l>                endif   </l>
<l>            endif</l>
<c>            </c>
<c>            ***</c>
<c>            </c>
<c>   </c>
<l>            if (CameraNumberUsed = 1 or CameraNumberUsed = 4)</l>
<l>                wait_seconds(0.5)</l>
<l>            endif</l>
<l>            if (CameraNumberUsed = 2 or CameraNumberUsed = 5)</l>
<l>                wait_seconds(1.0)</l>
<l>            endif</l>
<c>            </c>
<l>            if (AcqHandle = [])</l>
<l>                CameraCorrectlyInitialised := 0</l>
<l>*                 stop()</l>
<l>                return()</l>
<l>            endif</l>
<c>  </c>
<c>            </c>
<c>            * set up light timing - bottom light    </c>
<l>            set_framegrabber_param (AcqHandle, 'Device1_Process3_Parameters_ExposureTimeLight0', Camera_FPGA_BackLight_MicroSec)</l>
<c>            * set up light timing - top light</c>
<l>            set_framegrabber_param (AcqHandle, 'Device1_Process3_Parameters_ExposureTimeLight1', Camera_FPGA_TopLight_MicroSec) // Top light set value of first camera to all cameras            </l>
<l>            set_framegrabber_param (AcqHandle, 'Device1_Process3_Parameters_SupportBacklight', 1) // switch on support back light for top light</l>
<l>            set_framegrabber_param (AcqHandle, 'Device1_Process3_Parameters_SupportBacklightTime', Camera_FPGA_TopLight_SupportBackLight_MicroSec) // set length for backlight duration as support light in toplight illumination</l>
<c>            </c>
<c>            * set up light timing - UV-Light</c>
<l>            set_framegrabber_param (AcqHandle, 'Device1_Process' + 0 + '_Parameters_ScaleRedLight2', 0)</l>
<l>            set_framegrabber_param (AcqHandle, 'Device1_Process' + 1 + '_Parameters_ScaleRedLight2', 0)</l>
<l>            set_framegrabber_param (AcqHandle, 'Device1_Process' + 2 + '_Parameters_ScaleRedLight2', 0)</l>
<l>            set_framegrabber_param (AcqHandle, 'Device1_Process' + 0 + '_Parameters_ScaleBlueLight2', 0)    </l>
<l>            set_framegrabber_param (AcqHandle, 'Device1_Process' + 1 + '_Parameters_ScaleBlueLight2', 0)    </l>
<l>            set_framegrabber_param (AcqHandle, 'Device1_Process' + 2 + '_Parameters_ScaleBlueLight2', 0)    </l>
<l>            set_framegrabber_param (AcqHandle, 'Device1_Process' + 0 + '_Parameters_ScaleGreenLight2', Camera_FPGA_UVLight_Gain) // UV light gain</l>
<l>            set_framegrabber_param (AcqHandle, 'Device1_Process' + 1 + '_Parameters_ScaleGreenLight2', Camera_FPGA_UVLight_Gain) // UV light gain</l>
<l>            set_framegrabber_param (AcqHandle, 'Device1_Process' + 2 + '_Parameters_ScaleGreenLight2', Camera_FPGA_UVLight_Gain) // UV light gain</l>
<c>                       </c>
<c>            * set trigger behaviour</c>
<c>            * impotant to leave light switched off- otherwise parallel processes will grab e.g. slave processes</c>
<l>*             set_framegrabber_param (AcqHandle, 'Device1_Process3_Parameters_ImageTriggerMode', 0) // external via IO</l>
<c>           * next lines were used to switch in between internal and extrnal triggering. for some reason it did not work as supposed- image channels were mixed up </c>
<l>*             if(InternalTrigger0_External1 = 0) // use internal frequency or external trigger to trigger cams</l>
<l>*                 set_framegrabber_param (AcqHandle, 'Device1_Process3_Parameters_ImageTriggerMode', 0) // external via IO</l>
<l>*                 wait_seconds(0.1)</l>
<l>*                 set_framegrabber_param (AcqHandle, 'Device1_Process3_Parameters_ImageTriggerMode', 2) // internal via frequency generator</l>
<l>*             else</l>
<c>                * impotant to leave light switched off- otherwise parallel processes will grab e.g. slave processes</c>
<l>*                 set_framegrabber_param (AcqHandle, 'Device1_Process3_Parameters_ImageTriggerMode', 0) // external via IO</l>
<l>*             endif</l>
<c>            * set image output to rgb if needed</c>
<l>            RGB_Output := 0</l>
<l>            if(RGB_Output = 0) // this is hsl output</l>
<l>                set_framegrabber_param (AcqHandle, 'Device1_Process0_Parameters_ColorOutput', 1) // external vcamera to hsl output</l>
<l>                set_framegrabber_param (AcqHandle, 'Device1_Process1_Parameters_ColorOutput', 1) // external vcamera to hsl output</l>
<l>                set_framegrabber_param (AcqHandle, 'Device1_Process2_Parameters_ColorOutput', 1) // external vcamera to hsl output      </l>
<l>            else</l>
<l>                set_framegrabber_param (AcqHandle, 'Device1_Process0_Parameters_ColorOutput', 0) // external vcamera to rgb output</l>
<l>                set_framegrabber_param (AcqHandle, 'Device1_Process1_Parameters_ColorOutput', 0) // external vcamera to rgb output</l>
<l>                set_framegrabber_param (AcqHandle, 'Device1_Process2_Parameters_ColorOutput', 0) // external vcamera to rgb output    </l>
<l>            endif</l>
<c>            </c>
<c>            * Set eject pulse length</c>
<l>            set_framegrabber_param (AcqHandle, 'Device1_Process3_Parameters_JetControl_JetPulseWidth', Camera_FPGA_EjectPulseLength_MicroSec) // pulse width for ejection signal</l>
<c>            </c>
<l>            FPGA_Tick_InSec := 0.00625</l>
<c>            </c>
<c>            * Set sample eject length        </c>
<l>*             Camera_FPGA_EjectPulseLength_SampleEject_MicroSec := 10000</l>
<l>            Camera_FPGA_EjectPulseLength_SampleEject_FPGATicks := Camera_FPGA_EjectPulseLength_SampleEject_MicroSec / FPGA_Tick_InSec</l>
<l>            tuple_int (Camera_FPGA_EjectPulseLength_SampleEject_FPGATicks, Camera_FPGA_EjectPulseLength_SampleEject_FPGATicks)</l>
<l>            set_framegrabber_param (AcqHandle, 'Device1_Process3_Implementation_SensorGate_Width6_Width', Camera_FPGA_EjectPulseLength_SampleEject_FPGATicks)    </l>
<c>            </c>
<l>            Camera_FPGA_EjectPulseLength_FPGATicksc := Camera_FPGA_EjectPulseLength_MicroSec / FPGA_Tick_InSec</l>
<c>            </c>
<c>            * setup FPGA Eject Lane specific IO values for board 0</c>
<l>            if ((CameraNumberUsed ) = 0 or (CameraNumberUsed ) = 1 or (CameraNumberUsed ) = 2) // setup FPGA Eject Lane specific IO values</l>
<l>                tuple_int ((Camera_FPGA_EjectPulseLength_Offset_MicroSec_Lane0 / FPGA_Tick_InSec) + Camera_FPGA_EjectPulseLength_FPGATicksc, FPGATicks_Temp)</l>
<l>                set_framegrabber_param (AcqHandle, 'Device1_Process3_Implementation_SensorGate_Width0_Width', FPGATicks_Temp)   </l>
<l>                tuple_int ((Camera_FPGA_EjectPulseLength_Offset_MicroSec_Lane1 / FPGA_Tick_InSec) + Camera_FPGA_EjectPulseLength_FPGATicksc, FPGATicks_Temp)</l>
<l>                set_framegrabber_param (AcqHandle, 'Device1_Process3_Implementation_SensorGate_Width1_Width', FPGATicks_Temp)</l>
<l>                tuple_int ((Camera_FPGA_EjectPulseLength_Offset_MicroSec_Lane2 / FPGA_Tick_InSec) + Camera_FPGA_EjectPulseLength_FPGATicksc, FPGATicks_Temp)</l>
<l>                set_framegrabber_param (AcqHandle, 'Device1_Process3_Implementation_SensorGate_Width2_Width', FPGATicks_Temp)</l>
<l>                tuple_int ((Camera_FPGA_EjectPulseLength_Offset_MicroSec_Lane3 / FPGA_Tick_InSec) + Camera_FPGA_EjectPulseLength_FPGATicksc, FPGATicks_Temp)</l>
<l>                set_framegrabber_param (AcqHandle, 'Device1_Process3_Implementation_SensorGate_Width3_Width', FPGATicks_Temp)</l>
<l>                tuple_int ((Camera_FPGA_EjectPulseLength_Offset_MicroSec_Lane4 / FPGA_Tick_InSec) + Camera_FPGA_EjectPulseLength_FPGATicksc, FPGATicks_Temp)</l>
<l>                set_framegrabber_param (AcqHandle, 'Device1_Process3_Implementation_SensorGate_Width4_Width', FPGATicks_Temp)</l>
<l>                tuple_int ((Camera_FPGA_EjectPulseLength_Offset_MicroSec_Lane5 / FPGA_Tick_InSec) + Camera_FPGA_EjectPulseLength_FPGATicksc, FPGATicks_Temp)</l>
<l>                set_framegrabber_param (AcqHandle, 'Device1_Process3_Implementation_SensorGate_Width5_Width', FPGATicks_Temp)</l>
<l>            else // setup FPGA Eject Lane specific IO values for board 1</l>
<l>                tuple_int ((Camera_FPGA_EjectPulseLength_Offset_MicroSec_Lane6 / FPGA_Tick_InSec) + Camera_FPGA_EjectPulseLength_FPGATicksc, FPGATicks_Temp)</l>
<l>                set_framegrabber_param (AcqHandle, 'Device1_Process3_Implementation_SensorGate_Width0_Width', FPGATicks_Temp)   </l>
<l>                 tuple_int ((Camera_FPGA_EjectPulseLength_Offset_MicroSec_Lane7 / FPGA_Tick_InSec) + Camera_FPGA_EjectPulseLength_FPGATicksc, FPGATicks_Temp)</l>
<l>                set_framegrabber_param (AcqHandle, 'Device1_Process3_Implementation_SensorGate_Width1_Width', FPGATicks_Temp)</l>
<l>                tuple_int ((Camera_FPGA_EjectPulseLength_Offset_MicroSec_Lane8 / FPGA_Tick_InSec) + Camera_FPGA_EjectPulseLength_FPGATicksc, FPGATicks_Temp)</l>
<l>                set_framegrabber_param (AcqHandle, 'Device1_Process3_Implementation_SensorGate_Width2_Width', FPGATicks_Temp)</l>
<l>                tuple_int ((Camera_FPGA_EjectPulseLength_Offset_MicroSec_Lane9 / FPGA_Tick_InSec) + Camera_FPGA_EjectPulseLength_FPGATicksc, FPGATicks_Temp)</l>
<l>                set_framegrabber_param (AcqHandle, 'Device1_Process3_Implementation_SensorGate_Width3_Width', FPGATicks_Temp)</l>
<l>                tuple_int ((Camera_FPGA_EjectPulseLength_Offset_MicroSec_Lane10 / FPGA_Tick_InSec) + Camera_FPGA_EjectPulseLength_FPGATicksc, FPGATicks_Temp)</l>
<l>                set_framegrabber_param (AcqHandle, 'Device1_Process3_Implementation_SensorGate_Width4_Width', FPGATicks_Temp)</l>
<l>                tuple_int ((Camera_FPGA_EjectPulseLength_Offset_MicroSec_Lane11 / FPGA_Tick_InSec) + Camera_FPGA_EjectPulseLength_FPGATicksc, FPGATicks_Temp)</l>
<l>                set_framegrabber_param (AcqHandle, 'Device1_Process3_Implementation_SensorGate_Width5_Width', FPGATicks_Temp)</l>
<l>            endif</l>
<c>            </c>
<c>            </c>
<c>            </c>
<c></c>
<c>            </c>
<c>            </c>
<c>            </c>
<c>            * activate trigger processing 0 is off, 1 is on</c>
<l>            set_framegrabber_param (AcqHandle, 'Device1_Process3_Parameters_EnableTriggerProcessing', 0)    </l>
<c>           </c>
<c>            </c>
<c>            * next lines were used to switch in between internal and extrnal triggering. for some reason it did not work as supposed- image channels were mixed up </c>
<l>            if(InternalTrigger0_External1 = 0) // use internal frequency or external trigger to trigger cams - trgger mode is activated in grab just before grab procedure loop</l>
<l>                set_framegrabber_param (AcqHandle, 'Device1_Process3_Parameters_ImageTriggerMode', 2) // internal via frequency generator</l>
<l>            else // external triggering via IO</l>
<c>                * impotant to leave light switched off- otherwise parallel processes will grab e.g. slave processes</c>
<l>                set_framegrabber_param (AcqHandle, 'Device1_Process3_Parameters_ImageTriggerMode', 0) // external via IO</l>
<c>                * activate trigger processing 0 is off, 1 is on - is activated just before grabbing loop</c>
<l>                set_framegrabber_param (AcqHandle, 'Device1_Process3_Parameters_EnableTriggerProcessing', 1)</l>
<l>            endif</l>
<c>            </c>
<c>            * activate trigger processing 0 is off, 1 is on - is activated just before grabbing loop</c>
<l>*             set_framegrabber_param (AcqHandle, 'Device1_Process3_Parameters_EnableTriggerProcessing', 1)    </l>
<c>           </c>
<c>            </c>
<c>            *** Janine - Debug - Textfile with clocknumber and tcp-telegramm</c>
<c>            *** Open textfiles for debugging the sending of tcp-telegramms and the wiritng of clock number</c>
<l>*             global tuple gFileHandle</l>
<l>*             global tuple gCameraNumberUsed</l>
<l>*             gCameraNumberUsed := CameraNumberUsed</l>
<l>*             open_file ('test-' + CameraNumberUsed + '.txt', 'output', gFileHandle)</l>
<l>*             fwrite_string (gFileHandle, 'Start')</l>
<l>*             fnew_line (gFileHandle)</l>
<c>            </c>
<l>*             global tuple gFileHandleTrigger</l>
<l>*             open_file ('trigger-' + CameraNumberUsed + '.txt', 'output', gFileHandleTrigger)</l>
<l>*             fwrite_string (gFileHandleTrigger, 'Start')</l>
<l>*             fnew_line (gFileHandleTrigger)</l>
<c>            *** End Janine - Debug</c>
<c>            </c>
<c> </c>
<c>            </c>
<l>            CameraCorrectlyInitialised := 1</l>
<c>            </c>
<l>            return()</l>
<c>            </c>
<c>            * test grab</c>
<l>            grab_image_start (AcqHandle, -1)</l>
<l>            while(1)</l>
<l>                dev_set_check ('~give_error')</l>
<l>                grab_image_async (ImageOrig, AcqHandle, -1)</l>
<l>                dev_set_check ('give_error')</l>
<l>                get_image_size (ImageOrig, Width1, Height1)</l>
<l>                if(Width1 # [])</l>
<l>                    count_channels (ImageOrig, ImageOrig_Channels)</l>
<l>                    if(ImageOrig_Channels = 1)</l>
<c>                        * convert interleaved image to a 3 channel image</c>
<l>                        get_image_pointer1 (ImageOrig, Pointer, TypeRGB, Width, Height)</l>
<l>                        gen_image_interleaved (ImageOrig, Pointer, 'bgr', Width / 3, Height, -1, 'byte', 0, 0, 0, 0, -1, 0)</l>
<l>                        dev_display (ImageOrig)</l>
<l>*                         stop()</l>
<l>                    endif                    </l>
<l>*                     decompose3 (ImageOrig, Image1, Image2, Image3)</l>
<l>*                     trans_to_rgb (Image1, Image3, Image2, ImageRed, ImageGreen, ImageBlue, 'hls')        </l>
<l>*                     compose3 (ImageRed, ImageGreen, ImageBlue, MultiChannelImage)</l>
<l>*                     dev_display (MultiChannelImage)</l>
<l>*                     stop()</l>
<l>                endif</l>
<c>                </c>
<l>            endwhile</l>
<l>        endif</l>
<c>        *********************************************************************************************************************</c>
<c>        *********************************************************************************************************************</c>
<c>        *********************************************************************************************************************</c>
<c>        * older part to work on multiple single framegrabbers (one per cam)</c>
<l>*         CameraNumberToOpen := 5</l>
<l>*         stop()  </l>
<l>        for Index := CameraNumberToOpen to NumberOfConnectedCameras.at(0)[1]-1 by 1</l>
<c>            ******************************</c>
<l>*             stop()  </l>
<l>            gFramegrabber_SiSo_SetupDevice (Index, DebugWorkOnFirstCameraOnly, 1, Device, Port, SlaveString)</l>
<l>            BufferString := ('num_buffers=' + GrabBuffer_SizeInFrames)</l>
<l>            GenericParameters := [BufferString,SlaveString]</l>
<l>            dev_set_check ('~give_error')</l>
<l>*             open_framegrabber ('SiliconSoftware', 1, 1, 0, 0, 0, 0, 'default', -1, 'default', [('num_buffers=' + GrabBuffer_SizeInFrames), SlaveString], 'false', MyCamType, Device, Port, -1, AcqHandle)</l>
<l>            open_framegrabber ('SiliconSoftware', 1, 1, 0, 0, 0, 0, 'default', -1, 'default', GenericParameters, 'false', MyCamType, Device, Port, -1, AcqHandle)</l>
<l>            dev_set_check ('give_error') </l>
<l>            if(AcqHandle = [])</l>
<l>                continue</l>
<l>            endif </l>
<l>            set_framegrabber_param (AcqHandle, 'grab_timeout', gGrab_Timeout)</l>
<c></c>
<c>            * Get the number of allowed field parameters</c>
<l>            get_framegrabber_param (AcqHandle, 'available_param_names', NumFieldParameterPow) // all available parameters listed</l>
<c>            </c>
<l>            if(SlaveString =  'slave=0' ) // for the master camera</l>
<c>                **** init precondition for camera 2 and 3</c>
<l>*                 gFramegrabber_SiSo_SetupDevice (1, 0, 3, Device, Port, SlaveString)</l>
<l>*                 GenericParameters := [BufferString,SlaveString]</l>
<l>*                 dev_set_check ('~give_error')</l>
<l>*                 open_framegrabber ('SiliconSoftware', 1, 1, 0, 0, 0, 0, 'default', -1, 'default', GenericParameters, 'false', MyCamType, Device, Port, -1, AcqHandle1)</l>
<l>*                 dev_set_check ('give_error') </l>
<c>                * cam3</c>
<l>*                 gFramegrabber_SiSo_SetupDevice (2, 0, 3, Device, Port, SlaveString)</l>
<l>*                 GenericParameters := [BufferString,SlaveString]</l>
<l>*                 dev_set_check ('~give_error')</l>
<l>*                 open_framegrabber ('SiliconSoftware', 1, 1, 0, 0, 0, 0, 'default', -1, 'default', GenericParameters, 'false', MyCamType, Device, Port, -1, AcqHandle2)</l>
<l>*                 dev_set_check ('give_error')</l>
<c>                **************************************</c>
<l>*                 wait_seconds(0.1)</l>
<l>*                 set_framegrabber_param (AcqHandle, 'Device1_Process3_Parameters_ExposureTimeLight1', ExposuretimeTpl.at(0)[1]) // Top light set value of first camera to all cameras</l>
<l>*                 set_framegrabber_param (AcqHandle, 'Device1_Process3_Parameters_JetControl_JetPulseWidth', Camera_FPGA_EjectPulseLength_MicroSec) // pulse width for ejection signal</l>
<l>*                 set_framegrabber_param (AcqHandle, 'Device1_Process3_Parameters_SupportBacklight', 1) // switch on backlight in parallel to toplight white</l>
<l>*                 set_framegrabber_param (AcqHandle, 'Device1_Process3_Parameters_SupportBacklightTime', Camera_FPGA_TopLight_SupportBacklight_MicroSec) // set length for backlight duration as support light in toplight illumination</l>
<l>            endif</l>
<c>            </c>
<c>            * set up light timing - bottom light    </c>
<l>            set_framegrabber_param (AcqHandle, 'Device1_Process3_Parameters_ExposureTimeLight0', Camera_FPGA_BackLight_MicroSec)</l>
<c>            * set up light timing - top light</c>
<l>            set_framegrabber_param (AcqHandle, 'Device1_Process3_Parameters_ExposureTimeLight1', Camera_FPGA_TopLight_MicroSec) // Top light set value of first camera to all cameras            </l>
<l>            set_framegrabber_param (AcqHandle, 'Device1_Process3_Parameters_SupportBacklight', 1) // switch on support back light for top light</l>
<l>            set_framegrabber_param (AcqHandle, 'Device1_Process3_Parameters_SupportBacklightTime', Camera_FPGA_TopLight_SupportBackLight_MicroSec) // set length for backlight duration as support light in toplight illumination</l>
<c>            </c>
<c>            * set up light timing - UV-Light</c>
<l>            set_framegrabber_param (AcqHandle, 'Device1_Process' + 0 + '_Parameters_ScaleRedLight2', 0)</l>
<l>            set_framegrabber_param (AcqHandle, 'Device1_Process' + 1 + '_Parameters_ScaleRedLight2', 0)</l>
<l>            set_framegrabber_param (AcqHandle, 'Device1_Process' + 2 + '_Parameters_ScaleRedLight2', 0)</l>
<l>            set_framegrabber_param (AcqHandle, 'Device1_Process' + 0 + '_Parameters_ScaleBlueLight2', 0)    </l>
<l>            set_framegrabber_param (AcqHandle, 'Device1_Process' + 1 + '_Parameters_ScaleBlueLight2', 0)    </l>
<l>            set_framegrabber_param (AcqHandle, 'Device1_Process' + 2 + '_Parameters_ScaleBlueLight2', 0)    </l>
<l>            set_framegrabber_param (AcqHandle, 'Device1_Process' + 0 + '_Parameters_ScaleGreenLight2', Camera_FPGA_UVLight_Gain) // UV light gain</l>
<l>            set_framegrabber_param (AcqHandle, 'Device1_Process' + 1 + '_Parameters_ScaleGreenLight2', Camera_FPGA_UVLight_Gain) // UV light gain</l>
<l>            set_framegrabber_param (AcqHandle, 'Device1_Process' + 2 + '_Parameters_ScaleGreenLight2', Camera_FPGA_UVLight_Gain) // UV light gain</l>
<c>            </c>
<c>            </c>
<c>            * set trigger behaviour</c>
<l>            if(InternalTrigger0_External1 = 0) // use internal frequency or external trigger to trigger cams</l>
<l>                set_framegrabber_param (AcqHandle, 'Device1_Process3_Parameters_ImageTriggerMode', 2) // internal via frequency generator</l>
<l>            else</l>
<l>                set_framegrabber_param (AcqHandle, 'Device1_Process3_Parameters_ImageTriggerMode', 2) // internal via frequency generator</l>
<l>                wait_seconds(0.1)</l>
<l>                set_framegrabber_param (AcqHandle, 'Device1_Process3_Parameters_ImageTriggerMode', 0) // external via IO</l>
<l>            endif</l>
<c>            * set image output to rgb if needed</c>
<l>            RGB_Output := 0</l>
<l>            if(RGB_Output = 0) // this is hsl output</l>
<l>                set_framegrabber_param (AcqHandle, 'Device1_Process0_Parameters_ColorOutput', 1) // external vcamera to hsl output</l>
<l>                set_framegrabber_param (AcqHandle, 'Device1_Process1_Parameters_ColorOutput', 1) // external vcamera to hsl output</l>
<l>                set_framegrabber_param (AcqHandle, 'Device1_Process2_Parameters_ColorOutput', 1) // external vcamera to hsl output      </l>
<l>            else</l>
<l>                set_framegrabber_param (AcqHandle, 'Device1_Process0_Parameters_ColorOutput', 0) // external vcamera to rgb output</l>
<l>                set_framegrabber_param (AcqHandle, 'Device1_Process1_Parameters_ColorOutput', 0) // external vcamera to rgb output</l>
<l>                set_framegrabber_param (AcqHandle, 'Device1_Process2_Parameters_ColorOutput', 0) // external vcamera to rgb output    </l>
<l>            endif</l>
<c>            </c>
<c>            * Set eject pulse length</c>
<l>            set_framegrabber_param (AcqHandle, 'Device1_Process3_Parameters_JetControl_JetPulseWidth', Camera_FPGA_EjectPulseLength_MicroSec) // pulse width for ejection signal</l>
<c>            </c>
<l>            FPGA_Tick_InSec := 0.00625</l>
<c>            </c>
<c>            * Set sample eject length        </c>
<l>*             Camera_FPGA_EjectPulseLength_SampleEject_MicroSec := 10000</l>
<l>            Camera_FPGA_EjectPulseLength_SampleEject_FPGATicks := Camera_FPGA_EjectPulseLength_SampleEject_MicroSec / FPGA_Tick_InSec</l>
<l>            tuple_int (Camera_FPGA_EjectPulseLength_SampleEject_FPGATicks, Camera_FPGA_EjectPulseLength_SampleEject_FPGATicks)</l>
<l>            set_framegrabber_param (AcqHandle, 'Device1_Process3_Implementation_SensorGate_Width6_Width', Camera_FPGA_EjectPulseLength_SampleEject_FPGATicks)    </l>
<c>            </c>
<l>            Camera_FPGA_EjectPulseLength_FPGATicksc := Camera_FPGA_EjectPulseLength_MicroSec / FPGA_Tick_InSec</l>
<l>            if ((CameraNumberUsed ) = 0) // setup FPGA Eject Lane specific IO values</l>
<l>                tuple_int ((Camera_FPGA_EjectPulseLength_Offset_MicroSec_Lane0 / FPGA_Tick_InSec) + Camera_FPGA_EjectPulseLength_FPGATicksc, FPGATicks_Temp)</l>
<l>                set_framegrabber_param (AcqHandle, 'Device1_Process3_Implementation_SensorGate_Width0_Width', FPGATicks_Temp)   </l>
<l>                tuple_int ((Camera_FPGA_EjectPulseLength_Offset_MicroSec_Lane1 / FPGA_Tick_InSec) + Camera_FPGA_EjectPulseLength_FPGATicksc, FPGATicks_Temp)</l>
<l>                set_framegrabber_param (AcqHandle, 'Device1_Process3_Implementation_SensorGate_Width1_Width', FPGATicks_Temp)</l>
<l>                tuple_int ((Camera_FPGA_EjectPulseLength_Offset_MicroSec_Lane2 / FPGA_Tick_InSec) + Camera_FPGA_EjectPulseLength_FPGATicksc, FPGATicks_Temp)</l>
<l>                set_framegrabber_param (AcqHandle, 'Device1_Process3_Implementation_SensorGate_Width2_Width', FPGATicks_Temp)</l>
<l>                tuple_int ((Camera_FPGA_EjectPulseLength_Offset_MicroSec_Lane3 / FPGA_Tick_InSec) + Camera_FPGA_EjectPulseLength_FPGATicksc, FPGATicks_Temp)</l>
<l>                set_framegrabber_param (AcqHandle, 'Device1_Process3_Implementation_SensorGate_Width3_Width', FPGATicks_Temp)</l>
<l>                tuple_int ((Camera_FPGA_EjectPulseLength_Offset_MicroSec_Lane4 / FPGA_Tick_InSec) + Camera_FPGA_EjectPulseLength_FPGATicksc, FPGATicks_Temp)</l>
<l>                set_framegrabber_param (AcqHandle, 'Device1_Process3_Implementation_SensorGate_Width4_Width', FPGATicks_Temp)</l>
<l>                tuple_int ((Camera_FPGA_EjectPulseLength_Offset_MicroSec_Lane5 / FPGA_Tick_InSec) + Camera_FPGA_EjectPulseLength_FPGATicksc, FPGATicks_Temp)</l>
<l>                set_framegrabber_param (AcqHandle, 'Device1_Process3_Implementation_SensorGate_Width5_Width', FPGATicks_Temp)</l>
<l>            endif</l>
<l>            if ((CameraNumberUsed ) = 1) // setup FPGA Eject Lane specific IO values</l>
<l>                tuple_int ((Camera_FPGA_EjectPulseLength_Offset_MicroSec_Lane6 / FPGA_Tick_InSec) + Camera_FPGA_EjectPulseLength_FPGATicksc, FPGATicks_Temp)</l>
<l>                set_framegrabber_param (AcqHandle, 'Device1_Process3_Implementation_SensorGate_Width0_Width', FPGATicks_Temp)   </l>
<l>                tuple_int ((Camera_FPGA_EjectPulseLength_Offset_MicroSec_Lane7 / FPGA_Tick_InSec) + Camera_FPGA_EjectPulseLength_FPGATicksc, FPGATicks_Temp)</l>
<l>                set_framegrabber_param (AcqHandle, 'Device1_Process3_Implementation_SensorGate_Width1_Width', FPGATicks_Temp)</l>
<l>                tuple_int ((Camera_FPGA_EjectPulseLength_Offset_MicroSec_Lane8 / FPGA_Tick_InSec) + Camera_FPGA_EjectPulseLength_FPGATicksc, FPGATicks_Temp)</l>
<l>                set_framegrabber_param (AcqHandle, 'Device1_Process3_Implementation_SensorGate_Width2_Width', FPGATicks_Temp)</l>
<l>                tuple_int ((Camera_FPGA_EjectPulseLength_Offset_MicroSec_Lane9 / FPGA_Tick_InSec) + Camera_FPGA_EjectPulseLength_FPGATicksc, FPGATicks_Temp)</l>
<l>                set_framegrabber_param (AcqHandle, 'Device1_Process3_Implementation_SensorGate_Width3_Width', FPGATicks_Temp)</l>
<l>                tuple_int ((Camera_FPGA_EjectPulseLength_Offset_MicroSec_Lane10 / FPGA_Tick_InSec) + Camera_FPGA_EjectPulseLength_FPGATicksc, FPGATicks_Temp)</l>
<l>                set_framegrabber_param (AcqHandle, 'Device1_Process3_Implementation_SensorGate_Width4_Width', FPGATicks_Temp)</l>
<l>                tuple_int ((Camera_FPGA_EjectPulseLength_Offset_MicroSec_Lane11 / FPGA_Tick_InSec) + Camera_FPGA_EjectPulseLength_FPGATicksc, FPGATicks_Temp)</l>
<l>                set_framegrabber_param (AcqHandle, 'Device1_Process3_Implementation_SensorGate_Width5_Width', FPGATicks_Temp)</l>
<l>            endif</l>
<c>            </c>
<c>            * activate trigger processing 0 is off, 1 is on</c>
<l>            set_framegrabber_param (AcqHandle, 'Device1_Process3_Parameters_EnableTriggerProcessing', 1)    </l>
<c>            </c>
<c>            ********************************</c>
<l>            if (AcqHandle = [])</l>
<l>                continue</l>
<l>            else</l>
<l>                gFramegrabber_OpenAndInit_FileSynchronisation_CameraNumberUsed (DebugWorkOnFirstCameraOnly, PathToCheckForLocalCameraUsed, CameraNumberUsed)</l>
<l>                CameraCorrectlyInitialised := 1</l>
<l>*                 stop()</l>
<l>                return() </l>
<c>                </c>
<c>                ****************************************************************************</c>
<l>                gen_empty_obj (EmptyObject)</l>
<l>                ImagesVector.at(0) := EmptyObject</l>
<l>                ImagesVectorCount := 0</l>
<c>                </c>
<c>                * test grab</c>
<l>                grab_image_start (AcqHandle, -1)</l>
<l>                while(1)</l>
<l>                    dev_set_check ('~give_error')</l>
<l>                    grab_image_async (ImageOrig, AcqHandle, -1)</l>
<l>                    dev_set_check ('give_error')</l>
<l>                    get_image_size (ImageOrig, Width1, Height1)</l>
<l>                    if(Width1 # []) </l>
<l>*                         dev_display (ImageOrig)</l>
<c>                        </c>
<l>*                         decompose3 (ImageOrig, Image1, Image2, Image3)</l>
<l>*                         trans_to_rgb (Image1, Image3, Image2, ImageRed, ImageGreen, ImageBlue, 'hls')        </l>
<l>*                         compose3 (ImageRed, ImageGreen, ImageBlue, ImageOrig)</l>
<l>                        ImagesVector.at(ImagesVectorCount) := ImageOrig</l>
<l>                        ImagesVectorCount := ImagesVectorCount + 1</l>
<l>                        if(ImagesVectorCount = 10)</l>
<l>                            stop()</l>
<l>                        endif</l>
<l>*                         dev_display (MultiChannelImage)</l>
<c>                        </c>
<l>*                         stop()</l>
<c>                        * convert interleaved image to a 3 channel image</c>
<l>*                         get_image_pointer1 (ImageOrig, Pointer, TypeRGB, Width, Height)</l>
<l>*                         gen_image_interleaved (ImageInterleaved, Pointer, 'bgr', Width / 3, Height, -1, 'byte', 0, 0, 0, 0, -1, 0)</l>
<l>*                         dev_display (ImageInterleaved)</l>
<l>                    endif        </l>
<l>                endwhile</l>
<l>            endif</l>
<l>        endfor</l>
<l>    endif</l>
<c>    * SiiliconSoftwareInterface End </c>
<c>    </c>
<c>    * check interface GigE_Vision2:</c>
<l>    info_framegrabber ('GigEVision2', 'revision', RevInfo, RevInfoValues)</l>
<l>    info_framegrabber ('GigEVision2', 'info_boards', BoardInfo, BoardInfoValues_GigEVision2)</l>
<c>    </c>
<l>    if(BoardInfoValues_GigEVision2 # [])</l>
<l>        FramegrabberInterfaceToUse := 'GigEVision2'</l>
<l>    else</l>
<c>        * check interface USB3_Vision:</c>
<l>        info_framegrabber ('USB3Vision', 'revision', RevInfo, RevInfoValues)</l>
<l>        info_framegrabber ('USB3Vision', 'info_boards', BoardInfo, BoardInfoValues_USB3Vision)</l>
<l>        FramegrabberInterfaceToUse := 'USB3Vision'</l>
<l>    endif</l>
<c>    </c>
<l>*     FramegrabberInterfaceToUse := 'pylon'</l>
<c>    * check interface revision:</c>
<l>*     info_framegrabber ('pylon', 'revision', RevInfo, RevInfoValues)</l>
<c>    * check your installed cameras for device:</c>
<l>*     info_framegrabber ('pylon', 'info_boards', BoardInfo, BoardInfoValues)</l>
<c>    * init cameras- hack to get used camera. Check if camera is occupied, if yes use it, if no continue to next one</c>
<l>    for Index := CameraNumberToOpen to NumberOfConnectedCameras.at(0)[1]-1 by 1</l>
<c>        * decide to open framegrabber in 'rgb', 'yuv' or 'raw'</c>
<l>        if (DebayerpatternTpl.at(Index)[1] = 'RGBFromCamera')</l>
<l>            ColourSpace_ToGrabIn := 'rgb'</l>
<l>        else</l>
<l>            if (DebayerpatternTpl.at(Index)[1] = 'YUVFromCamera')</l>
<l>                ColourSpace_ToGrabIn := 'yuv'</l>
<l>            else</l>
<l>                ColourSpace_ToGrabIn := 'raw'</l>
<l>            endif</l>
<l>        endif</l>
<c>        * increase image buffer for high frequency grabbing like in sequencer</c>
<c>        * ToDo Marco- load via JSon</c>
<c>        ******************************</c>
<l>*         Test_Grab_Chunkdata ()</l>
<l>        GrabBuffer_SizeInFrames := 50</l>
<c>        * open camera with default settings and default resolution:</c>
<l>        dev_set_check ('~give_error')</l>
<l>        open_framegrabber (FramegrabberInterfaceToUse, 0, 0, 0, 0, 0, 0, 'default', -1, ColourSpace_ToGrabIn, [('num_buffers=' + GrabBuffer_SizeInFrames)], 'false', 'default', 'Cam' + (Index+1), 0, -1, AcqHandle)</l>
<l>        dev_set_check ('give_error')     </l>
<c>        ********************************</c>
<l>        if (AcqHandle = [])</l>
<l>            continue</l>
<l>        else</l>
<l>            CameraNumberUsed := Index</l>
<l>            CameraCorrectlyInitialised := 1</l>
<l>            break</l>
<l>        endif</l>
<l>    endfor</l>
<c>    * </c>
<c>    *  </c>
<l>    if (CameraCorrectlyInitialised = 1)</l>
<c>        * set grab timeout from default 5 sec to 2 sec</c>
<l>        set_framegrabber_param( AcqHandle, 'grab_timeout', gGrab_Timeout) // the timeout is relevant for the machineindexreset - due to it is in relation to a framegrabber timeout</l>
<c>        *</c>
<c>        </c>
<l>        dev_set_check ('~give_error')</l>
<l>        set_framegrabber_param( AcqHandle, 'SequencerMode', 'Off')</l>
<l>        dev_set_check ('give_error')</l>
<c>        </c>
<c>        * </c>
<l>        get_framegrabber_param (AcqHandle, 'WidthMax', WidthMax)</l>
<l>        if (ImageGrabResolution_WidthTpl.at(CameraNumberUsed)[1] &gt;= WidthMax)</l>
<l>            ImageGrabResolution_WidthTpl.at(CameraNumberUsed)[1] := WidthMax</l>
<l>        endif</l>
<l>        get_framegrabber_param (AcqHandle, 'HeightMax', HeightMax)</l>
<l>        if (ImageGrabResolution_HeightTpl.at(CameraNumberUsed)[1] &gt;= HeightMax)</l>
<l>            ImageGrabResolution_HeightTpl.at(CameraNumberUsed)[1] := HeightMax</l>
<l>        endif</l>
<c>        * set offsets to 0 before changing image width and height. Otherwise a big image with an offset will lead to and out of sensor region- and an error</c>
<l>        set_framegrabber_param (AcqHandle, 'CenterX', 0) // disable the center position of image on sensor, otherwise offset will lead to an exception</l>
<l>        get_framegrabber_param (AcqHandle, 'OffsetX', Value)</l>
<l>        set_framegrabber_param (AcqHandle, 'OffsetX', 0)</l>
<l>        set_framegrabber_param (AcqHandle, 'CenterY', 0) // disable the center position of image on sensor, otherwise offset will lead to an exception</l>
<l>        get_framegrabber_param (AcqHandle, 'OffsetY', Value)</l>
<l>        set_framegrabber_param (AcqHandle, 'OffsetY', 0)</l>
<c>        * Do checks to set image parameters in correct relation to connected camera sensor</c>
<l>        get_framegrabber_param (AcqHandle, 'SensorWidth', SensorWidth)</l>
<l>        get_framegrabber_param (AcqHandle, 'SensorHeight', SensorHeight)</l>
<l>        Width_ToSet := ImageGrabResolution_WidthTpl.at(CameraNumberUsed)[1]</l>
<l>        Height_ToSet := ImageGrabResolution_HeightTpl.at(CameraNumberUsed)[1]</l>
<l>        OffsetX_ToSet := ImageGrabOffset_XTpl.at(CameraNumberUsed)[1]</l>
<l>        OffsetY_ToSet := ImageGrabOffset_YTpl.at(CameraNumberUsed)[1]</l>
<l>        gFramegrabber_OpenAndInit_AdaptParamsToCameraSettables (SensorWidth, SensorHeight, OffsetX_ToSet, OffsetY_ToSet, Width_ToSet, Height_ToSet, 4, OffsetX_ToSet, OffsetY_ToSet, Width_ToSet, Height_ToSet)</l>
<l>        set_framegrabber_param (AcqHandle, 'Width', Width_ToSet)</l>
<l>        set_framegrabber_param (AcqHandle, 'Height', Height_ToSet)</l>
<l>        if (FramegrabberInterfaceToUse # 'USB3Vision')  </l>
<c>            </c>
<l>            if (FramegrabberInterfaceToUse = 'GigEVision2')</l>
<l>                set_framegrabber_param (AcqHandle, 'Width', Width_ToSet)</l>
<l>                set_framegrabber_param (AcqHandle, 'Height', Height_ToSet)</l>
<l>            else</l>
<l>                set_framegrabber_param (AcqHandle, 'image_width', Width_ToSet)</l>
<l>                set_framegrabber_param (AcqHandle, 'image_height', Height_ToSet)</l>
<l>            endif</l>
<l>        endif</l>
<c>        </c>
<l>        set_framegrabber_param (AcqHandle, 'OffsetX', OffsetX_ToSet)</l>
<l>        set_framegrabber_param (AcqHandle, 'OffsetY', OffsetY_ToSet)</l>
<c>        **************************************************************</c>
<c>        ****************** added 20190429 by MF    *******************</c>
<c>        **************************************************************</c>
<c>        * get cam interface type (2 variants) - function can only handle homogenous environments</c>
<l>*         tuple_strstr (BoardInfoValues[Index], 'device_class:', TypePos)</l>
<l>*         tuple_str_last_n(BoardInfoValues[Index], TypePos+13, InterfaceType) // BaslerUsb // BaslerGigE</l>
<c>        </c>
<l>        if (FramegrabberInterfaceToUse = 'GigEVision2')</l>
<c>            * set GigE param</c>
<c>            * ConfigIn</c>
<l>            set_framegrabber_param (AcqHandle, 'LineSelector', 'Line1')</l>
<l>            set_framegrabber_param (AcqHandle, 'LineMode', 'Input')</l>
<l>            set_framegrabber_param (AcqHandle, 'LineFormat', 'OptoCoupled')</l>
<l>            set_framegrabber_param (AcqHandle, 'LineInverter', 0)</l>
<l>            set_framegrabber_param (AcqHandle, 'LineDebouncerTimeAbs', 10.0)</l>
<c>            </c>
<l>            set_framegrabber_param (AcqHandle, 'UserOutputSelector', 'UserOutput1')</l>
<l>            set_framegrabber_param (AcqHandle, 'UserOutputValue', 0)</l>
<l>            set_framegrabber_param (AcqHandle, 'UserOutputValueAll', 0)</l>
<c>            </c>
<l>            set_framegrabber_param (AcqHandle, 'SyncUserOutputSelector', 'SyncUserOutput1')</l>
<l>            set_framegrabber_param (AcqHandle, 'SyncUserOutputValue', 0)</l>
<l>            set_framegrabber_param (AcqHandle, 'SyncUserOutputValueAll', 0)</l>
<c>            </c>
<c>            * ConfigOut1</c>
<l>            set_framegrabber_param (AcqHandle, 'LineSelector', 'Line2')</l>
<l>            set_framegrabber_param (AcqHandle, 'LineMode', 'Output')</l>
<l>            set_framegrabber_param (AcqHandle, 'LineFormat', 'OptoCoupled')</l>
<l>            if(InternalTrigger0_External1 = 1) // use additional io to select or use io to drive external light</l>
<l>                set_framegrabber_param (AcqHandle, 'LineSource', 'UserOutput1')</l>
<l>            else</l>
<l>                set_framegrabber_param (AcqHandle, 'LineSource', 'ExposureActive')</l>
<l>            endif</l>
<c>            </c>
<l>            set_framegrabber_param (AcqHandle, 'LineInverter', 1)</l>
<l>            set_framegrabber_param (AcqHandle, 'MinOutPulseWidthAbs', 0.0)</l>
<c>            </c>
<l>            set_framegrabber_param (AcqHandle, 'UserOutputSelector', 'UserOutput1')</l>
<l>            set_framegrabber_param (AcqHandle, 'UserOutputValue', 0)</l>
<l>            set_framegrabber_param (AcqHandle, 'UserOutputValueAll', 0)</l>
<c>            </c>
<l>            set_framegrabber_param (AcqHandle, 'SyncUserOutputSelector', 'SyncUserOutput1')</l>
<l>            set_framegrabber_param (AcqHandle, 'SyncUserOutputValue', 0)</l>
<l>            set_framegrabber_param (AcqHandle, 'SyncUserOutputValueAll', 0)</l>
<c>            </c>
<c>            * ConfigOut2</c>
<l>            set_framegrabber_param (AcqHandle, 'LineSelector', 'Line3')</l>
<c>            * ToDo ND - the io for line 3 needs to be switchable. In countsecure it is a output line- for 360 it is an input line</c>
<c>            </c>
<l>            if (g360InspectionActive = 0)</l>
<l>                set_framegrabber_param (AcqHandle, 'LineMode', 'Output')</l>
<l>                set_framegrabber_param (AcqHandle, 'LineFormat', 'TTL')</l>
<l>                set_framegrabber_param (AcqHandle, 'LineSource', 'UserOutput2')</l>
<l>                set_framegrabber_param (AcqHandle, 'LineInverter', 1)</l>
<l>                set_framegrabber_param (AcqHandle, 'MinOutPulseWidthAbs', 0.0)</l>
<l>            else</l>
<l>                set_framegrabber_param (AcqHandle, 'LineMode', 'Input')</l>
<l>            endif</l>
<c>            </c>
<c>            </c>
<l>            set_framegrabber_param (AcqHandle, 'UserOutputSelector', 'UserOutput1')</l>
<l>            set_framegrabber_param (AcqHandle, 'UserOutputValue', 0)</l>
<l>            set_framegrabber_param (AcqHandle, 'UserOutputValueAll', 0)</l>
<c>            </c>
<l>            set_framegrabber_param (AcqHandle, 'SyncUserOutputSelector', 'SyncUserOutput1')</l>
<l>            set_framegrabber_param (AcqHandle, 'SyncUserOutputValue', 0)</l>
<l>            set_framegrabber_param (AcqHandle, 'SyncUserOutputValueAll', 0)</l>
<c>            *</c>
<l>        else // 'USB3Vision'</l>
<c>            </c>
<l>        endif</l>
<c>        </c>
<l>        dev_error_var (ErrorVar, 1)</l>
<l>        dev_set_check ('~give_error')</l>
<l>        set_framegrabber_param (AcqHandle, 'ExposureTimeAbs', ExposuretimeTpl.at(CameraNumberUsed)[1])</l>
<l>        Error := ErrorVar</l>
<l>        dev_set_check ('give_error')</l>
<l>        if(Error # 2)</l>
<l>            set_framegrabber_param (AcqHandle, 'ExposureTime', ExposuretimeTpl.at(CameraNumberUsed)[1])</l>
<l>        endif</l>
<l>        dev_set_check ('~give_error')</l>
<l>        set_framegrabber_param (AcqHandle, 'AcquisitionFrameRateAbs', FPSTpl.at(CameraNumberUsed)[1])</l>
<l>        Error := ErrorVar</l>
<l>        dev_set_check ('give_error')</l>
<l>        if(Error # 2)</l>
<l>            set_framegrabber_param (AcqHandle, 'AcquisitionFrameRate', FPSTpl.at(CameraNumberUsed)[1])</l>
<l>        endif</l>
<l>        dev_set_check ('~give_error')</l>
<l>        set_framegrabber_param (AcqHandle, 'GainRaw', GainTpl.at(CameraNumberUsed)[1])</l>
<l>        Error := ErrorVar</l>
<l>        dev_set_check ('give_error')</l>
<l>        if(Error # 2)</l>
<l>            Gain_ToSet := GainTpl.at(CameraNumberUsed)[1]</l>
<l>            if (Gain_ToSet &gt; 36)</l>
<l>                Gain_ToSet := 36</l>
<l>            endif</l>
<l>            set_framegrabber_param (AcqHandle, 'Gain',Gain_ToSet)</l>
<l>        endif</l>
<c>        * 20190619</c>
<l>        set_framegrabber_param (AcqHandle, 'TriggerMode', 'On')</l>
<l>*         set_framegrabber_param (AcqHandle, 'TriggerMode', 'Off')</l>
<c>        </c>
<l>        set_framegrabber_param (AcqHandle, 'AcquisitionFrameRateEnable', 1)</l>
<c>        </c>
<l>        dev_set_check ('~give_error')</l>
<l>        set_framegrabber_param (AcqHandle, 'GammaEnable', GammaEnable_Tpl.at(CameraNumberUsed)[1])</l>
<l>        Error := ErrorVar</l>
<l>        dev_set_check ('give_error')</l>
<l>        if(Error # 2)</l>
<l>            set_framegrabber_param (AcqHandle, 'Gamma', GammaEnable_Tpl.at(CameraNumberUsed)[1]) // for usb no enable is given- just use the value</l>
<l>        endif</l>
<c>        * only for GigE-Version</c>
<c>        * set packet size for communication to big amount. important to set network adapter accodingly</c>
<l>        dev_set_check ('~give_error')</l>
<l>        set_framegrabber_param (AcqHandle, 'GevSCPSPacketSize', 9000)</l>
<l>        Error := ErrorVar</l>
<l>        dev_set_check ('give_error')</l>
<c>        * </c>
<c>        * </c>
<l>        if (false)</l>
<l>            get_framegrabber_param (AcqHandle, 'image_width', Width)</l>
<l>            get_framegrabber_param (AcqHandle, 'image_height', Height)</l>
<l>            get_framegrabber_param (AcqHandle, 'OffsetX', OffsetX)</l>
<l>            get_framegrabber_param (AcqHandle, 'OffsetY', OffsetY)</l>
<l>            get_framegrabber_param (AcqHandle, 'ExposureTimeAbs', exposure)</l>
<l>            get_framegrabber_param (AcqHandle, 'AcquisitionFrameRateAbs', fps)</l>
<l>            get_framegrabber_param (AcqHandle, 'GainRaw', gain)</l>
<l>        endif</l>
<c>        * </c>
<l>        if (UseCameraIOsAsDirectEjectSignals.at(0)[1] = 1)</l>
<l>            set_framegrabber_param (AcqHandle, 'UserOutputSelector', 'UserOutput1')</l>
<l>            set_framegrabber_param (AcqHandle, 'UserOutputValue', 0)</l>
<l>            set_framegrabber_param (AcqHandle, 'UserOutputValue', 0)</l>
<l>            wait_seconds (0.01)</l>
<l>            set_framegrabber_param (AcqHandle, 'UserOutputSelector', 'UserOutput2')</l>
<l>            set_framegrabber_param (AcqHandle, 'UserOutputValue', 0)</l>
<l>            set_framegrabber_param (AcqHandle, 'UserOutputValue', 0)</l>
<l>        else</l>
<c>            * double setting of io to be really shure</c>
<l>            set_framegrabber_param (AcqHandle, 'UserOutputSelector', 'UserOutput1')</l>
<l>            set_framegrabber_param (AcqHandle, 'UserOutputValue', 0)</l>
<l>            set_framegrabber_param (AcqHandle, 'UserOutputValue', 0)</l>
<l>            set_framegrabber_param (AcqHandle, 'UserOutputSelector', 'UserOutput2')</l>
<l>            set_framegrabber_param (AcqHandle, 'UserOutputValue', 0)</l>
<l>            set_framegrabber_param (AcqHandle, 'UserOutputValue', 0)</l>
<l>            set_framegrabber_param (AcqHandle, 'UserOutputSelector', 'UserOutput1')</l>
<l>        endif</l>
<c>        * </c>
<c>        **************************************************************</c>
<c>        **************************************************************        </c>
<l>        if(GrabSequencer_Active.at(0)[1] = 1) // setup sequencer in basler cameras if active MP 2019_04_30</l>
<l>            set_framegrabber_param( AcqHandle, 'SequencerMode', 'Off')</l>
<l>*             get_framegrabber_param (AcqHandle, 'SequencerMode', Value1)</l>
<c>            </c>
<l>            set_framegrabber_param (AcqHandle, 'LineSelector', 'Line3')</l>
<l>            set_framegrabber_param (AcqHandle, 'LineMode', 'Input')</l>
<l>            set_framegrabber_param (AcqHandle, 'ChunkModeActive', 1)</l>
<l>*             get_framegrabber_param (AcqHandle, 'ChunkModeActive', Value1)</l>
<c>            </c>
<l>            set_framegrabber_param (AcqHandle, 'ChunkSelector', 'LineStatusAll')</l>
<l>            set_framegrabber_param (AcqHandle, 'ChunkEnable', 1)</l>
<l>*             get_framegrabber_param (AcqHandle, 'ChunkEnable', Value1)       </l>
<c>            </c>
<c>            */*Configuring the sequencer sets*/</c>
<l>            set_framegrabber_param( AcqHandle, 'SequencerConfigurationMode', 'On')</l>
<c>            </c>
<c>            *//Set Values ROI Set1</c>
<l>            set_framegrabber_param( AcqHandle, 'ExposureTime' , ExposuretimeTpl.at(CameraNumberUsed)[1])</l>
<l>*             set_framegrabber_param( AcqHandle, 'ExposureTime' , dExposure1)</l>
<c>            </c>
<l>            set_framegrabber_param( AcqHandle, 'SequencerSetSelector', 0)</l>
<l>            set_framegrabber_param( AcqHandle, 'SequencerSetSave', 'true')</l>
<c>            </c>
<c>            *//Set Values ROI Set2</c>
<l>            set_framegrabber_param( AcqHandle, 'ExposureTime' , ExposuretimeTpl.at(CameraNumberUsed)[1])</l>
<l>*             set_framegrabber_param( AcqHandle, 'ExposureTime' , dExposure2)</l>
<c>            </c>
<c>            </c>
<l>            set_framegrabber_param( AcqHandle, 'SequencerSetSelector', 1)</l>
<l>            set_framegrabber_param( AcqHandle, 'SequencerSetSave', 'true')</l>
<c>            </c>
<c>            </c>
<c>            *//Set Counter and Path0 Set1</c>
<l>            set_framegrabber_param( AcqHandle, 'SequencerSetSelector', 0)</l>
<l>            set_framegrabber_param( AcqHandle, 'SequencerSetLoad', 'true')</l>
<l>            set_framegrabber_param( AcqHandle, 'SequencerPathSelector', 0)</l>
<c>            </c>
<l>            set_framegrabber_param( AcqHandle, 'SequencerTriggerSource', 'Line4')</l>
<l>            set_framegrabber_param( AcqHandle, 'SequencerSetSave', 'true')</l>
<c>            </c>
<c>            *//Set Counter and Path1 Set2</c>
<l>            set_framegrabber_param( AcqHandle, 'SequencerSetSelector', 0)</l>
<l>            set_framegrabber_param( AcqHandle, 'SequencerSetLoad', 'true')</l>
<l>            set_framegrabber_param( AcqHandle, 'SequencerPathSelector', 1)</l>
<c>            </c>
<l>            set_framegrabber_param( AcqHandle, 'SequencerTriggerSource', 'Line1')</l>
<l>            set_framegrabber_param( AcqHandle, 'SequencerSetNext', 1)</l>
<l>            set_framegrabber_param( AcqHandle, 'SequencerSetSave', 'true')</l>
<c>            </c>
<l>            set_framegrabber_param( AcqHandle, 'SequencerConfigurationMode', 'Off')</l>
<l>            set_framegrabber_param( AcqHandle, 'SequencerMode', 'On')</l>
<l>        endif</l>
<c>        </c>
<c>        **************************************************************</c>
<l>    endif</l>
<l>else</l>
<l>    CameraCorrectlyInitialised := 1</l>
<l>endif</l>
<c>* </c>
<l>gFramegrabber_OpenAndInit_FileSynchronisation_CameraNumberUsed (DebugWorkOnFirstCameraOnly, PathToCheckForLocalCameraUsed, CameraNumberUsed)</l>
<c></c>
<l>return ()</l>
</body>
<docu id="gFramegrabber_OpenAndInit">
<parameters>
<parameter id="AcqHandle"/>
<parameter id="CameraCorrectlyInitialised"/>
<parameter id="CameraNumberToOpen"/>
<parameter id="CameraNumberUsed"/>
<parameter id="DebugWorkOnFirstCameraOnly"/>
<parameter id="PathToCheckForLocalCameraUsed"/>
<parameter id="VTCamera"/>
</parameters>
</docu>
</procedure>
<procedure name="gFramegrabber_OpenAndInit_AdaptParamsToCameraSettables">
<interface>
<ic>
<par name="SensorWidth" base_type="ctrl" dimension="0"/>
<par name="SensorHeight" base_type="ctrl" dimension="0"/>
<par name="OffsetX_ToSet" base_type="ctrl" dimension="0"/>
<par name="OffsetY_ToSet" base_type="ctrl" dimension="0"/>
<par name="Width_ToSetIn" base_type="ctrl" dimension="0"/>
<par name="Height_ToSetIn" base_type="ctrl" dimension="0"/>
<par name="ParameterSteppingDivider" base_type="ctrl" dimension="0"/>
</ic>
<oc>
<par name="OffsetX_ToSetOut" base_type="ctrl" dimension="0"/>
<par name="OffsetY_ToSetOut" base_type="ctrl" dimension="0"/>
<par name="Width_ToSetOut" base_type="ctrl" dimension="0"/>
<par name="Height_ToSetOut" base_type="ctrl" dimension="0"/>
</oc>
</interface>
<body>
<c>* some cameras can only be set in a certain stepping. This is calculatet in this procedure</c>
<c></c>
<l>OffsetX_ToSetOut := OffsetX_ToSet</l>
<l>OffsetY_ToSetOut := OffsetY_ToSet</l>
<c></c>
<c>********************calculation</c>
<c>* Width*************</c>
<l>if(Width_ToSetIn &gt; SensorWidth)</l>
<l>    Width_ToSetIn := SensorWidth</l>
<l>endif</l>
<c>* round by divider</c>
<l>Width_ToSetOut := Width_ToSetIn/ParameterSteppingDivider</l>
<l>Width_ToSetOut := Width_ToSetOut*ParameterSteppingDivider</l>
<c>* Height*************</c>
<l>if(Height_ToSetIn &gt; SensorHeight)</l>
<l>    Height_ToSetIn := SensorHeight</l>
<l>endif</l>
<c>* round by divider</c>
<l>Height_ToSetOut := Height_ToSetIn/ParameterSteppingDivider</l>
<l>Height_ToSetOut := Height_ToSetOut*ParameterSteppingDivider</l>
<c></c>
<c>* OffsetX*************</c>
<c>* sensor allows only shift by 4 - ensure here</c>
<l>OffsetX_ToSet_temp := OffsetX_ToSetOut/ParameterSteppingDivider</l>
<l>OffsetX_ToSetOut := OffsetX_ToSet_temp *ParameterSteppingDivider</l>
<l>if ((OffsetX_ToSetOut + Width_ToSetOut) &gt; SensorWidth)</l>
<l>    OffsetX_ToSetOut := SensorWidth - Width_ToSetOut</l>
<c>    * sensor allows only shift by 4 - ensure here</c>
<l>    OffsetX_ToSet_temp := OffsetX_ToSetOut/ParameterSteppingDivider</l>
<l>    OffsetX_ToSetOut := OffsetX_ToSet_temp *ParameterSteppingDivider</l>
<l>endif</l>
<c></c>
<c>* OffsetY*************</c>
<c>* sensor allows only shift by 4 - ensure here</c>
<l>OffsetY_ToSet_temp := OffsetY_ToSetOut/ParameterSteppingDivider</l>
<l>OffsetY_ToSetOut := OffsetY_ToSet_temp *ParameterSteppingDivider</l>
<l>if ((OffsetY_ToSetOut + Height_ToSetOut) &gt; SensorHeight)</l>
<l>    OffsetY_ToSetOut := SensorHeight - Height_ToSetOut</l>
<c>    * sensor allows only shift by 4 - ensure here</c>
<l>    OffsetY_ToSet_temp := OffsetY_ToSetOut/ParameterSteppingDivider</l>
<l>    OffsetY_ToSetOut := OffsetY_ToSet_temp *ParameterSteppingDivider</l>
<l>endif</l>
<c></c>
<l>return ()</l>
</body>
<docu id="gFramegrabber_OpenAndInit_AdaptParamsToCameraSettables">
<parameters>
<parameter id="Height_ToSetIn"/>
<parameter id="Height_ToSetOut"/>
<parameter id="OffsetX_ToSet"/>
<parameter id="OffsetX_ToSetOut"/>
<parameter id="OffsetY_ToSet"/>
<parameter id="OffsetY_ToSetOut"/>
<parameter id="ParameterSteppingDivider"/>
<parameter id="SensorHeight"/>
<parameter id="SensorWidth"/>
<parameter id="Width_ToSetIn"/>
<parameter id="Width_ToSetOut"/>
</parameters>
</docu>
</procedure>
<procedure name="gGetSubObjectVariables">
<interface>
<ic>
<par name="VTData" base_type="ctrl" dimension="1"/>
<par name="PrefixStringToSearchFor" base_type="ctrl" dimension="0"/>
</ic>
<oc>
<par name="VTData_SubVector" base_type="ctrl" dimension="1"/>
</oc>
</interface>
<body>
<l>VTData_SubVector.at(0) := [] </l>
<c></c>
<l>VectorLength := VTData.length()</l>
<l>ElementsWritten := 0</l>
<l>for IndexVector := 0 to VectorLength-1 by 1</l>
<l>    StringToSearchIn := VTData.at(IndexVector)[0]</l>
<l>    tuple_strrstr (StringToSearchIn, PrefixStringToSearchFor, Position)</l>
<l>    if (Position &gt;= 0) // prefix was found</l>
<l>        tuple_regexp_replace (StringToSearchIn, '(.*)^'+ PrefixStringToSearchFor , '', ConvertedName)</l>
<l>        VTData_SubVector.at(ElementsWritten) := [ConvertedName, VTData.at(IndexVector)[1]]</l>
<l>        ElementsWritten := ElementsWritten +1</l>
<l>    endif</l>
<l>endfor</l>
<l>return ()</l>
</body>
<docu id="gGetSubObjectVariables">
<parameters>
<parameter id="PrefixStringToSearchFor"/>
<parameter id="VTData"/>
<parameter id="VTData_SubVector"/>
</parameters>
</docu>
</procedure>
<procedure name="gGetSubObjectVariables_SingleValue">
<interface>
<ic>
<par name="VTData" base_type="ctrl" dimension="1"/>
<par name="VariableNameToSearchForInVTData" base_type="ctrl" dimension="0"/>
</ic>
<oc>
<par name="SingleValue" base_type="ctrl" dimension="0"/>
</oc>
</interface>
<body>
<c>* in the vector VTData data to parse out information is given</c>
<l>gGetSubObjectVariables (VTData, VariableNameToSearchForInVTData, VTempVariable)</l>
<l>SingleValue := VTempVariable.at(0)[1]</l>
<l>return ()</l>
</body>
<docu id="gGetSubObjectVariables_SingleValue">
<parameters>
<parameter id="SingleValue"/>
<parameter id="VTData"/>
<parameter id="VariableNameToSearchForInVTData"/>
</parameters>
</docu>
</procedure>
<procedure name="gInit_MachineState">
<interface/>
<body>
<l>global def tuple dict_MachineState</l>
<l>global tuple dict_MachineTiming</l>
<c></c>
<c>* init the Machine State</c>
<c></c>
<c>* ******************************************************************************</c>
<c>* Machine states:</c>
<c>* -1 = initiliazed after programm start</c>
<c>* 0 = stopped</c>
<c>* 1 = started and running in normal speed</c>
<c>* 2 = started and running in slow speed / stepping</c>
<c>* 3 = slowing down - to stop after slowing down phase</c>
<c>* 4 = slowing down finished</c>
<c>* 5 = starting up - to have machine running after a while- not in use</c>
<c>* 6 = starting up finished - not in use</c>
<c>* 7 = wait for number of frames</c>
<c>* 8 = Eject Pipe Movement started</c>
<c>* 9 = Eject Pipe Movement busy</c>
<c>* 10 = Eject Pipe Movement finished</c>
<c>* 11 = Eject Countercheck started</c>
<c>* 12 = Eject Countercheck busy</c>
<c>* 13 = Eject Countercheck finished</c>
<c>*  e.g. starting up state -4-, maximum starting up wait frames -25- and current frame count - 7-</c>
<c>* ******************************************************************************</c>
<c>* Machine actions:</c>
<c>* 0 = stop</c>
<c>* 1 = start</c>
<c>* 2 = do nothing</c>
<c>* 3 = extend eject signal</c>
<c></c>
<l>    dict_MachineState := dict{}</l>
<l>    dict_MachineState.CurrentMachineState := [-1,-1,-1] </l>
<l>    dict_MachineState.CurrentMachineAction := [-1, -1]</l>
<l>    dict_MachineState.History_MachineStates := []</l>
<l>    dict_MachineState.History_MachineActions := []</l>
<c>    </c>
<c>    </c>
<c>    * Einlesen über Format</c>
<l>    dict_MachineState.WaitFramesAtStartUp := dict_MachineTiming.V_WaitFramesAtStartup.Value</l>
<l>    dict_MachineState.WaitFramesAtSlowDownToStopMovement_FromFullSpeed := dict_MachineTiming.WaitFramesAtSlowDownToStopMovement.V_FromFullSpeed.Value</l>
<l>    dict_MachineState.WaitFramesAtSlowDownToStopMovement_FromSmallSpeed := dict_MachineTiming.WaitFramesAtSlowDownToStopMovement.V_FromSlowSpeed.Value</l>
<l>    dict_MachineState.WaitFramesAtEjectPipeMovementGoingDownAndUp := dict_MachineTiming.V_WaitFramesAtEjectPipeMovementGoingDownAndUp.Value</l>
<l>    dict_MachineState.WaitFramesAfterPulsingForSmallSpeed := dict_MachineTiming.V_PulsingForSlowSpeed_Time.Value</l>
<c>    </c>
<c>    * feste Werte wie in Tablet Secure. todo: prüfen</c>
<c>    * 25,25,10,25,10</c>
<l>*     dict_MachineState.WaitFramesAtStartUp := 25</l>
<l>*     dict_MachineState.WaitFramesAtSlowDownToStopMovement_FromFullSpeed := 25</l>
<l>*     dict_MachineState.WaitFramesAtSlowDownToStopMovement_FromSmallSpeed := 10</l>
<l>*     dict_MachineState.WaitFramesAtEjectPipeMovementGoingDownAndUp := 25</l>
<l>*     dict_MachineState.WaitFramesAfterPulsingForSmallSpeed := 10</l>
<c>       </c>
<l>return ()</l>
</body>
<docu id="gInit_MachineState">
<parameters/>
</docu>
</procedure>
<procedure name="gInit_PLCConnection">
<interface>
<ic>
<par name="PLC_NumberOfConnectionTrials" base_type="ctrl" dimension="0"/>
</ic>
<oc>
<par name="PLC_CommunicationSocket" base_type="ctrl" dimension="0"/>
<par name="PLCWatchdogSignal" base_type="ctrl" dimension="0"/>
<par name="PLCAvailable" base_type="ctrl" dimension="0"/>
<par name="PLC_FailedToConnect" base_type="ctrl" dimension="0"/>
</oc>
</interface>
<body>
<l>global tuple dict_PLC</l>
<l>global tuple dict_Camera</l>
<l>global tuple gLocalCameraNumberUsed</l>
<c></c>
<c></c>
<c>* initialize outputs</c>
<l>PLC_CommunicationSocket := []</l>
<l>PLC_FailedToConnect := 1</l>
<l>PLCWatchdogSignal := 1</l>
<c></c>
<c>************</c>
<l>PLCAvailable := dict_PLC.General.V_WorkOnPLCEnable.Value</l>
<l>dict_LocalCamera := dict_Camera.Cameras.['Camera_' + gLocalCameraNumberUsed]</l>
<c>* get plc ip adress</c>
<l>PLC_Used := dict_LocalCamera.V_PLC.Value</l>
<c></c>
<c>* in case multiple plc´s are connected to one camera parse it out</c>
<l>tuple_split (PLC_Used, ',', PLC_Used)</l>
<c></c>
<l>PLC_IPAdress := []</l>
<l>PLC_PortToUse := []</l>
<l>for Index_PLC := 0 to |PLC_Used|-1 by 1 // get io´s and port´s ready for init</l>
<l>    get_dict_tuple (dict_PLC.PLCs, PLC_Used[Index_PLC], PLC_IPAdress_temp)</l>
<l>    PLC_IPAdress := [PLC_IPAdress, PLC_IPAdress_temp.V_IP.Value]</l>
<c>    </c>
<l>    PLC_PortToUse_temp := dict_LocalCamera.V_PLCRemotePort.Value</l>
<l>    tuple_split (PLC_PortToUse_temp, ',', PLC_PortToUse_temp)</l>
<l>    PLC_PortToUse := [PLC_PortToUse, PLC_PortToUse_temp[Index_PLC]]</l>
<l>endfor</l>
<c>* </c>
<c>* </c>
<l>if (PLCAvailable = 1)</l>
<c>    * Init PLC communication</c>
<l>    tuple_number (PLC_PortToUse, PLC_PortToUse) // may have been string from json loading</l>
<c>    * for the number of connected plc´s init them</c>
<c>    </c>
<l>    for Index_PLCs := 0 to |PLC_IPAdress| -1 by 1</l>
<l>        for Index := 0 to PLC_NumberOfConnectionTrials by 1</l>
<l>            dev_error_var (Error, 1)</l>
<l>            dev_set_check ('~give_error')</l>
<l>            open_socket_connect (PLC_IPAdress[Index_PLCs], PLC_PortToUse[Index_PLCs], ['protocol', 'timeout'], ['TCP', 0.2], SocketEstablished)</l>
<l>            ReadError := Error            </l>
<l>            dev_set_check ('give_error')</l>
<l>            if (ReadError = 2)</l>
<l>                break</l>
<l>            else</l>
<l>                wait_seconds (0.2)</l>
<l>            endif</l>
<l>        endfor</l>
<c>        * if no connection could be established set to -1, elso socket</c>
<l>        if (SocketEstablished = [])</l>
<l>            PLC_CommunicationSocket := [PLC_CommunicationSocket, -1]</l>
<l>        else</l>
<l>            PLC_CommunicationSocket := [PLC_CommunicationSocket, SocketEstablished]</l>
<l>        endif</l>
<l>    endfor  </l>
<l>    tuple_find (PLC_CommunicationSocket, -1, Indices)</l>
<l>    if (Indices = -1)</l>
<l>        PLC_FailedToConnect := 0</l>
<l>    endif</l>
<l>else // gen indicator per plc that it is not connected</l>
<l>    PLC_CommunicationSocket := []</l>
<l>    for Index_PLCs := 0 to |PLC_IPAdress| -1 by 1</l>
<l>        PLC_CommunicationSocket := [PLC_CommunicationSocket, -1]</l>
<l>    endfor</l>
<l>    PLC_FailedToConnect := 0</l>
<l>endif</l>
<c></c>
<l>return ()</l>
</body>
<docu id="gInit_PLCConnection">
<parameters>
<parameter id="PLCAvailable"/>
<parameter id="PLCWatchdogSignal"/>
<parameter id="PLC_CommunicationSocket"/>
<parameter id="PLC_FailedToConnect"/>
<parameter id="PLC_NumberOfConnectionTrials"/>
</parameters>
</docu>
</procedure>
<procedure name="gInit_Shiftregister">
<interface>
<oo>
<par name="ShiftRegisterVector_Good_Bad_ObjectsLastFrame_ThreadVector" base_type="iconic" dimension="3"/>
<par name="Shiftregister_Iconic_Threads_Lanes_Data" base_type="iconic" dimension="4"/>
<par name="Shiftregister_VThread_VLane_IImagePartsPerObject" base_type="iconic" dimension="3"/>
<par name="Shiftregister_VThread_VLane_VMeasuredFeatures_IRegionPerFeature" base_type="iconic" dimension="3"/>
</oo>
<ic>
<par name="LanesPerThreadVector" base_type="ctrl" dimension="1"/>
</ic>
<oc>
<par name="ShiftregisterVector_ObjectMovement_ThreadVector" base_type="ctrl" dimension="2"/>
<par name="Shiftregister_Tuple_Threads_Lanes_Data" base_type="ctrl" dimension="4"/>
<par name="Shiftregister_VThread_VLane_VMeasureFeature_TResult_TValue" base_type="ctrl" dimension="4"/>
<par name="Shiftregister_VThread_VLane_VImagePartsOffset_TRow_TColumn" base_type="ctrl" dimension="3"/>
</oc>
</interface>
<body>
<c></c>
<l>Length := LanesPerThreadVector.length()</l>
<c>* </c>
<c>* </c>
<c>* The data description for the ShiftRegisterVector_Good_Bad_ObjectsLastFrame_ThreadVector is as follows:</c>
<c>* First Dimenstion: camera specific- data in relation to cameras - done in loop outside this procedure</c>
<c>* Second Dimension: thread specific- data is in relation to processes that operate individual lanes</c>
<c>* Third dimension: lane specific- data is in relation to lanes that hold data for shift register</c>
<c>* Fourth dimension: shift register specific- data is in relation to good and bad objects in shift register as well as the objects that were found in the last frame,</c>
<c>* </c>
<c>* ShiftregisterVectors</c>
<l>gen_empty_obj (EmptyObject)</l>
<l>for Index := 0 to Length-1 by 1</l>
<l>    TupleInVector := LanesPerThreadVector.at(Index)</l>
<l>    tuple_length (TupleInVector, TupleInVector_Length)</l>
<l>    for Index1 := 0 to TupleInVector_Length-1 by 1</l>
<l>            Shiftregister_Iconic_Lanes_DataOut.at(Index1) := {{EmptyObject},{EmptyObject}}</l>
<l>            Shiftregister_Tuple_Lanes_DataOut.at(Index1) := {{[]},{[]}}</l>
<l>    endfor</l>
<l>    Shiftregister_Iconic_Threads_Lanes_Data.at(Index) := Shiftregister_Iconic_Lanes_DataOut</l>
<l>    Shiftregister_Tuple_Threads_Lanes_Data.at(Index) := Shiftregister_Tuple_Lanes_DataOut</l>
<l>endfor</l>
<c>* </c>
<c>* Shiftregister_VThread_VLane_VMeasureFeature_TResult_TValue</c>
<l>gen_empty_obj (EmptyObject)</l>
<l>for IndexThread := 0 to Length-1 by 1</l>
<l>    TupleInVector := LanesPerThreadVector.at(IndexThread)</l>
<l>    tuple_length (TupleInVector, TupleInVector_Length)</l>
<l>    for IndexLane := 0 to TupleInVector_Length-1 by 1</l>
<l>            ShiftRegisterVector_Good_Bad_ObjectsLastFrameOut.at(IndexLane) := {EmptyObject,EmptyObject,EmptyObject,EmptyObject}</l>
<l>            ShiftregisterVector_ObjectMovementOut.at(IndexLane) := []</l>
<l>        Shiftregister_VThread_VLane_VMeasureFeature_TResult_TValue.at(IndexThread).at(IndexLane).at(0) := {[]}</l>
<l>        Shiftregister_VThread_VLane_IImagePartsPerObject.at(IndexThread).at(IndexLane) := {EmptyObject}</l>
<l>        Shiftregister_VThread_VLane_VImagePartsOffset_TRow_TColumn.at(IndexThread).at(IndexLane) := {[]}</l>
<l>        Shiftregister_VThread_VLane_VMeasuredFeatures_IRegionPerFeature.at(IndexThread).at(IndexLane) := {EmptyObject}</l>
<l>    endfor</l>
<l>    ShiftRegisterVector_Good_Bad_ObjectsLastFrame_ThreadVector.at(IndexThread) := ShiftRegisterVector_Good_Bad_ObjectsLastFrameOut</l>
<l>    ShiftregisterVector_ObjectMovement_ThreadVector.at(IndexThread) := ShiftregisterVector_ObjectMovementOut</l>
<l>endfor</l>
<l>return ()</l>
</body>
<docu id="gInit_Shiftregister">
<parameters>
<parameter id="LanesPerThreadVector"/>
<parameter id="ShiftRegisterVector_Good_Bad_ObjectsLastFrame_ThreadVector"/>
<parameter id="ShiftregisterVector_ObjectMovement_ThreadVector"/>
<parameter id="Shiftregister_Iconic_Threads_Lanes_Data"/>
<parameter id="Shiftregister_Tuple_Threads_Lanes_Data"/>
<parameter id="Shiftregister_VThread_VLane_IImagePartsPerObject"/>
<parameter id="Shiftregister_VThread_VLane_VImagePartsOffset_TRow_TColumn"/>
<parameter id="Shiftregister_VThread_VLane_VMeasureFeature_TResult_TValue"/>
<parameter id="Shiftregister_VThread_VLane_VMeasuredFeatures_IRegionPerFeature"/>
</parameters>
</docu>
</procedure>
<procedure name="gInit_Workplace">
<interface>
<ic>
<par name="TeachInMode" base_type="ctrl" dimension="0"/>
</ic>
<oc>
<par name="WindowHandle" base_type="ctrl" dimension="0"/>
</oc>
</interface>
<body>
<l>global tuple gVisuDevWindowOrNonDevWindow</l>
<l>global tuple gDebuglevel</l>
<l>global tuple gLocalCameraNumberUsed</l>
<l>global tuple dict_WindowPositioning</l>
<l>global tuple dict_InspectionVisualization</l>
<c></c>
<c>* first set window title prior to opening Window title is used as interface to gui</c>
<l>set_window_attr ('window_title', 'Camera' + (gLocalCameraNumberUsed +1))</l>
<c>* </c>
<c>* </c>
<l>if (gDebuglevel &gt;= 1 or TeachInMode = 1)</l>
<c>    * todo muss das angepasst werden?</c>
<l>    WindowWidth := 883</l>
<l>    WindowHeight := 640</l>
<l>    WindowRow := 0</l>
<l>    WindowColumn := 0</l>
<l>    dev_update_time ('on') </l>
<l>else</l>
<l>    dev_update_time ('off')</l>
<l>    dict_LocalWindow := dict_WindowPositioning.Windows.['Window_' + gLocalCameraNumberUsed]</l>
<l>    WindowWidth := dict_LocalWindow.Width</l>
<l>    WindowHeight := dict_LocalWindow.Height</l>
<l>    WindowColumn := dict_LocalWindow.X_Offset</l>
<l>    WindowRow := dict_LocalWindow.Y_Offset</l>
<l>endif</l>
<l>dev_update_pc ('off')</l>
<l>dev_update_window ('off')</l>
<l>dev_update_var ('off')</l>
<l>dev_close_window ()</l>
<c>* set draw for debug window if necessary</c>
<l>gSet_HDevelopDebugFlag (SystemInformations, DebugInHalcon)</l>
<l>* DebugInHalcon := 0</l>
<c></c>
<l>if (DebugInHalcon = 1 and gDebuglevel = 0)</l>
<l>    dev_open_window (0, 0, 640, 480, 'black', WindowHandle)</l>
<l>    dev_set_draw ('margin')</l>
<l>    dev_set_color ('red')</l>
<l>    dev_set_line_width (2)</l>
<l>endif</l>
<c>* </c>
<l>if (gVisuDevWindowOrNonDevWindow = 0 or (gDebuglevel &gt;= 1 and gDebuglevel # 3) or TeachInMode = 1) </l>
<l>    dev_close_window ()</l>
<l>    dev_open_window (WindowRow, WindowColumn, WindowWidth, WindowHeight, 'black', WindowHandle)</l>
<l>else</l>
<l>    open_window (WindowRow, WindowColumn, WindowWidth, WindowHeight, 0, 'transparent', '', WindowHandle)</l>
<l>    WindowString := 'Camera' + (gLocalCameraNumberUsed +1)</l>
<l>    set_window_param (WindowHandle, 'window_title', WindowString)</l>
<l>endif</l>
<c>* </c>
<c></c>
<l>set_draw (WindowHandle, 'margin')</l>
<l>set_color (WindowHandle, 'red')</l>
<l>set_line_width (WindowHandle, 2)</l>
<l>dev_error_var (Error, 1)</l>
<l>set_font (WindowHandle, 'Arial-Bold-' + dict_InspectionVisualization.V_VisuFontSize.Value)</l>
<l>return ()</l>
</body>
<docu id="gInit_Workplace">
<parameters>
<parameter id="TeachInMode"/>
<parameter id="WindowHandle"/>
</parameters>
</docu>
</procedure>
<procedure name="gInit_Workplace_DisplayImageAndRegions">
<interface>
<io>
<par name="ImageOrig" base_type="iconic" dimension="0"/>
</io>
<ic>
<par name="Index" base_type="ctrl" dimension="0"/>
</ic>
</interface>
<body>
<l>global object vector(1) gRinnenROIs</l>
<l>global object vector(1) gEjectROIs</l>
<l>global tuple gVisuDevWindowOrNonDevWindow</l>
<l>global tuple vector(1) gWindowVector</l>
<c></c>
<l>RinnenROIs := gRinnenROIs.at(Index)</l>
<l>EjectROIs := gEjectROIs.at(Index)</l>
<l>WindowHandle := gWindowVector.at(Index)</l>
<l>get_image_size (ImageOrig, ImageOrig_Width, ImageOrig_Height)</l>
<c>* </c>
<l>if (gVisuDevWindowOrNonDevWindow = 0)</l>
<c>    * </c>
<l>    dev_clear_window ()</l>
<l>    dev_set_window (WindowHandle)</l>
<l>    dev_set_part (0, 0, ImageOrig_Height, ImageOrig_Width)</l>
<l>    dev_display (ImageOrig)</l>
<l>    dev_set_color ('blue')</l>
<l>    dev_display (RinnenROIs)</l>
<l>    dev_set_color ('gray')</l>
<l>    dev_display (EjectROIs)</l>
<l>else</l>
<l>    clear_window (WindowHandle)</l>
<l>    set_part (WindowHandle, 0, 0, ImageOrig_Height, ImageOrig_Width)</l>
<l>    disp_obj (ImageOrig, WindowHandle)</l>
<l>    set_color (WindowHandle, 'blue')</l>
<l>    disp_region (RinnenROIs, WindowHandle)</l>
<l>    set_color (WindowHandle, 'gray')</l>
<l>    disp_region (EjectROIs, WindowHandle)</l>
<l>endif</l>
<l>return ()</l>
</body>
<docu id="gInit_Workplace_DisplayImageAndRegions">
<parameters>
<parameter id="ImageOrig"/>
<parameter id="Index"/>
</parameters>
</docu>
</procedure>
<procedure name="gInitAndOpen_Framegrabber">
<interface>
<ic>
<par name="DebugWorkOnFirstCameraOnly" base_type="ctrl" dimension="0"/>
<par name="PathToCheckForLocalCameraUsed" base_type="ctrl" dimension="0"/>
<par name="CameraNumberToOpen" base_type="ctrl" dimension="0"/>
</ic>
<oc>
<par name="AcqHandle" base_type="ctrl" dimension="0"/>
<par name="CameraNumberUsed" base_type="ctrl" dimension="0"/>
<par name="CameraCorrectlyInitialised" base_type="ctrl" dimension="0"/>
</oc>
</interface>
<body>
<c>* init the framegrabbers if available. </c>
<c>* specials for 360 configuration: // the timeout is relevant for the machineindexreset - due to it is in relation to a framegrabber timeout</c>
<l>global tuple dict_Camera </l>
<l>global tuple gStopAtCameraStart</l>
<c></c>
<l>global def tuple gFramegrabberFirstImageToInitTaken</l>
<l>global def tuple gFramegrabberInitFrames</l>
<c></c>
<c>* </c>
<l>AcqHandle := []</l>
<l>CameraNumberUsed := 0</l>
<l>CameraCorrectlyInitialised := 0</l>
<l>gFramegrabberFirstImageToInitTaken := 0 // variable to skip first image that was grabben on SiSo interface</l>
<l>gFramegrabberInitFrames := 0 // todo: 10 // count of mono colored images to init queues and complete engine cycle</l>
<c>* </c>
<c>* general camera parameters</c>
<l>WorkOnCameraEnable := dict_Camera.General.V_Camera_WorkOnCameraEnable.Value</l>
<l>NumberOfConnectedCameras := dict_Camera.General.V_Camera_NumberOfConnectedCameras.Value</l>
<l>InternalTrigger0_External1 := dict_Camera.General.V_Camera_InternalTrigger0_External1.Value</l>
<c></c>
<c></c>
<c></c>
<c></c>
<l>        ExposureTime := dict_Camera.Cameras.['Camera_' + CameraNumberUsed].V_Exposuretime.Value</l>
<c>        * !!! todo Gain funktoniert bei Optronis anders. Rauswerfen oder anpassen</c>
<l>        Gain := dict_Camera.Cameras.['Camera_' + CameraNumberUsed].V_Gain.Value</l>
<l>        FPS := dict_Camera.Cameras.['Camera_' + CameraNumberUsed].V_FPS.Value</l>
<l>        ImageGrabResolution_Width := dict_Camera.Cameras.['Camera_' + CameraNumberUsed].V_ImageGrabResolution_Width.Value</l>
<l>        ImageGrabResolution_Height := dict_Camera.Cameras.['Camera_' + CameraNumberUsed].V_ImageGrabResolution_Height.Value</l>
<l>        ImageGrabOffset_X := dict_Camera.Cameras.['Camera_' + CameraNumberUsed].V_ImageGrabOffset_X.Value</l>
<l>        ImageGrabOffset_Y := dict_Camera.Cameras.['Camera_' + CameraNumberUsed].V_ImageGrabOffset_Y.Value</l>
<l>*         GammaEnable := dict_Camera.Cameras.['Camera_' + CameraNumberUsed].V_GammaEnable.Value</l>
<c></c>
<c></c>
<l>if (gStopAtCameraStart)</l>
<l>    gStopAtCameraStart := 0</l>
<l>    stop()</l>
<l>endif</l>
<c></c>
<c></c>
<l>if (WorkOnCameraEnable &gt;= 1)  </l>
<l>    Camera_FPGA_TopLight_MicroSec := dict_Camera.FPGA.V_Camera_FPGA_TopLight_MicroSec.Value</l>
<l>    Camera_FPGA_TopLight_SupportBackLight_MicroSec := dict_Camera.FPGA.V_Camera_FPGA_TopLight_SupportBackLight_MicroSec.Value</l>
<l>    Camera_FPGA_BackLight_MicroSec := dict_Camera.FPGA.V_Camera_FPGA_BackLight_MicroSec.Value</l>
<l>    Camera_FPGA_UVLight_Gain := dict_Camera.FPGA.V_Camera_FPGA_UVLight_Gain.Value</l>
<c></c>
<c>    * Signal length Eject </c>
<l>    Camera_FPGA_EjectPulseLength_SampleEject_MicroSec := dict_Camera.FPGA.V_Camera_FPGA_EjectPulseLength_SampleEject_MicroSec.Value</l>
<l>    Camera_FPGA_EjectPulseLength_MicroSec := dict_Camera.FPGA.V_Camera_FPGA_EjectPulseLength_MicroSec.Value</l>
<l>    Camera_FPGA_EjectPulseLength_Offset_MicroSec_Lane0 := dict_Camera.FPGA.V_Camera_FPGA_EjectPulseLength_Offset_MicroSec_Lane0.Value</l>
<l>    Camera_FPGA_EjectPulseLength_Offset_MicroSec_Lane1 := dict_Camera.FPGA.V_Camera_FPGA_EjectPulseLength_Offset_MicroSec_Lane1.Value</l>
<l>    Camera_FPGA_EjectPulseLength_Offset_MicroSec_Lane2 := dict_Camera.FPGA.V_Camera_FPGA_EjectPulseLength_Offset_MicroSec_Lane2.Value</l>
<l>    Camera_FPGA_EjectPulseLength_Offset_MicroSec_Lane3 := dict_Camera.FPGA.V_Camera_FPGA_EjectPulseLength_Offset_MicroSec_Lane3.Value</l>
<l>    Camera_FPGA_EjectPulseLength_Offset_MicroSec_Lane4 := dict_Camera.FPGA.V_Camera_FPGA_EjectPulseLength_Offset_MicroSec_Lane4.Value</l>
<c></c>
<c>    * check for framegrabber parameter and set applet</c>
<l>    info_framegrabber ('GenICamTL', 'info_boards', Information, ValueList)</l>
<l>    Device := ValueList[0]</l>
<c>    * ' | device:1210-25-178-PillInspect_V33_53_imaFlex_250926_1Cam-0 | unique_name:1210-25-178-PillInspect_V33_53_imaFlex_250926_1Cam-0 | interface:iF-CXP12-Q SN_a6280335 | producer:C:\\FramegrabberSDK\\bin\\ProducerCXP.cti | vendor:Optronis GmbH | model:CyclonePlus-25-C | tl_type:CXP | status:available'</c>
<l>*      Device := ' | device:1210-25-178-PillInspect_V33_53_imaFlex_250926_1Cam-0 | unique_name:1210-25-178-PillInspect_V33_53_imaFlex_250926_1Cam-0 | interface:iF-CXP12-Q SN_a6280335 | producer:C:\\FramegrabberSDK\\bin\\ProducerCXP.cti | vendor:Optronis GmbH | model:CyclonePlus-25-C | tl_type:CXP | status:available'</l>
<l>*     Device := ' | device:1210-25-178-PillInspect_V33_53_imaFlex_021026_1Cam-0 | unique_name:1210-25-178-PillInspect_V33_53_imaFlex_021026_1Cam-0 | interface:iF-CXP12-Q SN_a6280335 | producer:C:\\FramegrabberSDK\\bin\\ProducerCXP.cti | vendor:Optronis GmbH | model:CyclonePlus-25-C | tl_type:CXP | status:available'    </l>
<l>*     Device := ' | device:1210-25-178-PillInspect_V33_53_imaFlex_091026_1Cam_Test2-0 | unique_name:1210-25-178-PillInspect_V33_53_imaFlex_091026_1Cam_Test2-0 | interface:iF-CXP12-Q SN_a6280335 | producer:C:\\FramegrabberSDK\\bin\\ProducerCXP.cti | vendor:Optronis GmbH | model:CyclonePlus-25-C | tl_type:CXP | status:available'</l>
<l>    GrabBuffer_SizeInFrames := 50 </l>
<c></c>
<l>    gFramegrabber_OpenAndInit_FileSynchronisation_CameraNumberUsed (DebugWorkOnFirstCameraOnly, PathToCheckForLocalCameraUsed, CameraNumberUsed)</l>
<c>    ******************************</c>
<l>    write_tuple (CameraNumberUsed, '../temp/CamUsed' + CameraNumberUsed + '.tpl')</l>
<c>    * delete initialized flag if available</c>
<l>    file_exists (PathToCheckForLocalCameraUsed + 'CamInitialised_' + CameraNumberUsed + '.txt', FileExists)</l>
<l>    if (FileExists = 1)</l>
<l>        delete_file (PathToCheckForLocalCameraUsed + 'CamInitialised_' + CameraNumberUsed + '.txt')</l>
<l>    endif</l>
<c>    </c>
<c>    ***</c>
<c>    </c>
<l>    BufferString := ('num_buffers=' + GrabBuffer_SizeInFrames)</l>
<l>    GenericParameters := BufferString</l>
<l>    dev_set_check ('~give_error')</l>
<l>    open_framegrabber ('GenICamTL', 1, 1, 0, 0, 0, 0, 'default', -1, 'default', GenericParameters, 'false', 'default', Device, -1, -1, AcqHandle)</l>
<l>    dev_set_check ('give_error') </l>
<c>        </c>
<l>    if (AcqHandle = [])</l>
<l>        CameraCorrectlyInitialised := 0</l>
<l>        return()</l>
<l>    endif</l>
<c></c>
<l>    set_framegrabber_param (AcqHandle, '[Interface]UserSetFile', 'C:/Users/Meliscout/Desktop/Einstellungen_FPGA/PillInspect_1Cam_Test2.mcf')</l>
<l>    set_framegrabber_param (AcqHandle, '[Interface]UserSetLoad', 1)</l>
<c>    </c>
<c>    * set auto roi control to false. Otherwise full camera width and height will be used.</c>
<l>    set_framegrabber_param(AcqHandle, '[Device]AutomaticROIControl', 0)</l>
<l>    set_framegrabber_param (AcqHandle, 'Height', 3000)   // todo Werte aus Format lesen</l>
<l>    set_framegrabber_param (AcqHandle, 'OffsetY', 1300)</l>
<l>    set_framegrabber_param (AcqHandle, 'Width', 4416)</l>
<l>    set_framegrabber_param (AcqHandle, 'OffsetX', 128)</l>
<c>        </c>
<l>* close_framegrabber (AcqHandle)</l>
<c>    * set signal that cam master is initialised</c>
<l>    open_file (PathToCheckForLocalCameraUsed + 'CamInitialised_' + CameraNumberUsed + '.txt', 'output', FileHandle)</l>
<l>    close_file (FileHandle)</l>
<l>*     endif</l>
<c>    </c>
<c>    ***</c>
<c>    </c>
<c>    </c>
<c>    * set up light timing - bottom light        Device1Process1ParametersExposuretimelight0</c>
<l>*     set_framegrabber_param (AcqHandle, '[Device]Device1Process1ParametersExposuretimelight0', Camera_FPGA_BackLight_MicroSec)</l>
<c>    * set up light timing - top light</c>
<l>*     set_framegrabber_param (AcqHandle, '[Device]Device1Process1ParametersExposureTimeLight1', Camera_FPGA_TopLight_MicroSec) // Top light set value of first camera to all cameras            </l>
<l>*     set_framegrabber_param (AcqHandle, '[Device]Device1Process1ParametersSupportBacklight', 1) // switch on support back light for top light</l>
<l>*     set_framegrabber_param (AcqHandle, '[Device]Device1Process1ParametersSupportBacklightTime', Camera_FPGA_TopLight_SupportBackLight_MicroSec) // set length for backlight duration as support light in toplight illumination</l>
<c></c>
<c>    * set image output to rgb if needed</c>
<l>    RGB_Output := 0</l>
<l>    if(RGB_Output = 0) // this is hsl output</l>
<l>        set_framegrabber_param (AcqHandle, '[Device]Device1Process0ParametersColoroutput', 'Hsv') // external vcamera to hsl output     </l>
<l>    else</l>
<l>        set_framegrabber_param (AcqHandle, '[Device]Device1Process0ParametersColoroutput', 'Rgb') // external vcamera to rgb output</l>
<c></c>
<l>    endif</l>
<c>    </c>
<c>    * Set eject pulse length</c>
<l>*     set_framegrabber_param (AcqHandle, '[Device]Device1Process1ParametersJetcontrolJetpulsewidth', Camera_FPGA_EjectPulseLength_MicroSec) // pulse width for ejection signal</l>
<c>    </c>
<l>    FPGA_Tick_InSec :=0.0032</l>
<c>    </c>
<c>    * Set sample eject length        </c>
<l>*     Camera_FPGA_EjectPulseLength_SampleEject_FPGATicks := Camera_FPGA_EjectPulseLength_SampleEject_MicroSec / FPGA_Tick_InSec * 1000000000</l>
<l>*     tuple_int (Camera_FPGA_EjectPulseLength_SampleEject_FPGATicks, Camera_FPGA_EjectPulseLength_SampleEject_FPGATicks)</l>
<l>*     set_framegrabber_param (AcqHandle, '[Device]Device1Process1ImplementationSensorgateWidth6Width', Camera_FPGA_EjectPulseLength_SampleEject_FPGATicks)    </l>
<c>    </c>
<l>*     Camera_FPGA_EjectPulseLength_FPGATicksc := Camera_FPGA_EjectPulseLength_MicroSec / FPGA_Tick_InSec</l>
<c>    </c>
<c>    * setup FPGA Eject Lane specific IO values for board 0</c>
<l>*     tuple_int ((Camera_FPGA_EjectPulseLength_Offset_MicroSec_Lane0 / FPGA_Tick_InSec) + Camera_FPGA_EjectPulseLength_FPGATicksc, FPGATicks_Temp)</l>
<l>*     set_framegrabber_param (AcqHandle, '[Device]Device1Process1ImplementationSensorgateWidth0Width', FPGATicks_Temp)   </l>
<l>*     tuple_int ((Camera_FPGA_EjectPulseLength_Offset_MicroSec_Lane1 / FPGA_Tick_InSec) + Camera_FPGA_EjectPulseLength_FPGATicksc, FPGATicks_Temp)</l>
<l>*     set_framegrabber_param (AcqHandle, '[Device]Device1Process1ImplementationSensorgateWidth1Width', FPGATicks_Temp)</l>
<l>*     tuple_int ((Camera_FPGA_EjectPulseLength_Offset_MicroSec_Lane2 / FPGA_Tick_InSec) + Camera_FPGA_EjectPulseLength_FPGATicksc, FPGATicks_Temp)</l>
<l>*     set_framegrabber_param (AcqHandle, '[Device]Device1Process1ImplementationSensorgateWidth2Width', FPGATicks_Temp)</l>
<l>*     tuple_int ((Camera_FPGA_EjectPulseLength_Offset_MicroSec_Lane3 / FPGA_Tick_InSec) + Camera_FPGA_EjectPulseLength_FPGATicksc, FPGATicks_Temp)</l>
<l>*     set_framegrabber_param (AcqHandle, '[Device]Device1Process1ImplementationSensorgateWidth3Width', FPGATicks_Temp)</l>
<l>*     tuple_int ((Camera_FPGA_EjectPulseLength_Offset_MicroSec_Lane4 / FPGA_Tick_InSec) + Camera_FPGA_EjectPulseLength_FPGATicksc, FPGATicks_Temp)</l>
<l>*     set_framegrabber_param (AcqHandle, '[Device]Device1Process1ImplementationSensorgateWidth4Width', FPGATicks_Temp)</l>
<c></c>
<c>    </c>
<c>    * activate trigger processing 0 is off, 1 is on</c>
<l>*     set_framegrabber_param (AcqHandle, '[Device]Device1Process1ParametersEnabletriggerprocessing', 0)    </l>
<c>   </c>
<c>    </c>
<c>    * next lines were used to switch in between internal and extrnal triggering. for some reason it did not work as supposed- image channels were mixed up </c>
<l>*     if(InternalTrigger0_External1 = 0) // use internal frequency or external trigger to trigger cams - trgger mode is activated in grab just before grab procedure loop</l>
<l>*         set_framegrabber_param (AcqHandle, '[Device]Device1Process1ParametersImagetriggermode', 2) // internal via frequency generator</l>
<l>*     else // external triggering via IO</l>
<c>        * impotant to leave light switched off- otherwise parallel processes will grab e.g. slave processes</c>
<l>*         set_framegrabber_param (AcqHandle, '[Device]Device1Process1ParametersImagetriggermode', 0) // external via IO</l>
<c>        * activate trigger processing 0 is off, 1 is on - is activated just before grabbing loop</c>
<l>*         set_framegrabber_param (AcqHandle, '[Device]Device1Process1ParametersEnabletriggerprocessing', 1)</l>
<l>*     endif  </l>
<c></c>
<l>    CameraCorrectlyInitialised := 1</l>
<l>else</l>
<l>    CameraCorrectlyInitialised := 1</l>
<l>endif</l>
<c>            </c>
<l>return()</l>
<c></c>
<c></c>
<c>* init the framegrabbers if available. </c>
<c>* specials for 360 configuration: // the timeout is relevant for the machineindexreset - due to it is in relation to a framegrabber timeout</c>
<l>* global tuple gGrab_Timeout</l>
<l>* global tuple dict_Camera </l>
<l>* global tuple dict_Calibration</l>
<l>* global tuple gStopAtCameraStart</l>
<c></c>
<l>* global def tuple gFramegrabberFirstImageToInitTaken</l>
<l>* global def tuple gFramegrabberInitFrames</l>
<c></c>
<c>* </c>
<l>* AcqHandle := []</l>
<l>* CameraNumberUsed := 0</l>
<l>* CameraCorrectlyInitialised := 0</l>
<l>* gFramegrabberFirstImageToInitTaken := 0 // variable to skip first image that was grabben on SiSo interface</l>
<l>* gFramegrabberInitFrames := 1 // todo: 10 // count of mono colored images to init queues and complete engine cycle</l>
<c>* </c>
<c>* general camera parameters</c>
<l>* WorkOnCameraEnable := dict_Camera.General.V_Camera_WorkOnCameraEnable.Value</l>
<l>* NumberOfConnectedCameras := dict_Camera.General.V_Camera_NumberOfConnectedCameras.Value</l>
<l>* UseCameraIOsAsDirectEjectSignals := dict_Camera.General.V_Camera_UseCameraIOsAsDirectEjectSignals.Value</l>
<l>* InternalTrigger0_External1 := dict_Camera.General.V_Camera_InternalTrigger0_External1.Value</l>
<c></c>
<c></c>
<c></c>
<c></c>
<l>*         ExposureTime := dict_Camera.Cameras.['Camera_' + CameraNumberUsed].V_Exposuretime.Value</l>
<c>        * !!! todo Gain funktoniert bei Optronis anders. Rauswerfen oder anpassen</c>
<l>*         Gain := dict_Camera.Cameras.['Camera_' + CameraNumberUsed].V_Gain.Value</l>
<l>*         FPS := dict_Camera.Cameras.['Camera_' + CameraNumberUsed].V_FPS.Value</l>

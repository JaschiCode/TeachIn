<l>*     info_framegrabber ('GenICamTL', 'info_boards', Information, ValueList)</l>
<l>*     Device := ValueList[0]</l>
<c>    * ' | device:1210-25-178-PillInspect_V33_53_imaFlex_250926_1Cam-0 | unique_name:1210-25-178-PillInspect_V33_53_imaFlex_250926_1Cam-0 | interface:iF-CXP12-Q SN_a6280335 | producer:C:\\FramegrabberSDK\\bin\\ProducerCXP.cti | vendor:Optronis GmbH | model:CyclonePlus-25-C | tl_type:CXP | status:available'</c>
<l>*      Device := ' | device:1210-25-178-PillInspect_V33_53_imaFlex_250926_1Cam-0 | unique_name:1210-25-178-PillInspect_V33_53_imaFlex_250926_1Cam-0 | interface:iF-CXP12-Q SN_a6280335 | producer:C:\\FramegrabberSDK\\bin\\ProducerCXP.cti | vendor:Optronis GmbH | model:CyclonePlus-25-C | tl_type:CXP | status:available'</l>
<l>*     Device := ' | device:1210-25-178-PillInspect_V33_53_imaFlex_021026_1Cam-0 | unique_name:1210-25-178-PillInspect_V33_53_imaFlex_021026_1Cam-0 | interface:iF-CXP12-Q SN_a6280335 | producer:C:\\FramegrabberSDK\\bin\\ProducerCXP.cti | vendor:Optronis GmbH | model:CyclonePlus-25-C | tl_type:CXP | status:available'    </l>
<l>*     Device := ' | device:1210-25-178-PillInspect_V33_53_imaFlex_091026_1Cam_Test2-0 | unique_name:1210-25-178-PillInspect_V33_53_imaFlex_091026_1Cam_Test2-0 | interface:iF-CXP12-Q SN_a6280335 | producer:C:\\FramegrabberSDK\\bin\\ProducerCXP.cti | vendor:Optronis GmbH | model:CyclonePlus-25-C | tl_type:CXP | status:available'</l>
<l>*     GrabBuffer_SizeInFrames := 50 </l>
<l>*     stop()        </l>
<c></c>
<l>*     gFramegrabber_OpenAndInit_FileSynchronisation_CameraNumberUsed (DebugWorkOnFirstCameraOnly, PathToCheckForLocalCameraUsed, CameraNumberUsed)</l>
<c>    ******************************</c>
<l>*     write_tuple (CameraNumberUsed, '../temp/CamUsed' + CameraNumberUsed + '.tpl')</l>
<c>    </c>
<c>    *Christian: check ob MSA aktiv</c>
<l>*     if (dict_Calibration.V_FeatureActive.Value)</l>
<l>*         if (dict_Calibration.V_TeachIn_Active.Value or dict_Calibration.V_CalibrationObject_MeasureSystemAnalyses_Active.Value)</l>
<l>*             teachinactive := 1</l>
<c>*             Überschreiben der CameraNumberUsed, da nicht die eingestellte Kamera verwendet wird</c>
<l>*             CameraNumberUsed := CameraNumberToOpen</l>
<l>*         else </l>
<l>*             teachinactive := 0</l>
<l>*         endif</l>
<l>*     else</l>
<l>*         teachinactive := 0</l>
<l>*     endif</l>
<c>    ***</c>
<c>    </c>
<c>    * delete initialized flag if available</c>
<l>*     file_exists (PathToCheckForLocalCameraUsed + 'CamInitialised_' + CameraNumberUsed + '.txt', FileExists)</l>
<l>*     if (FileExists = 1)</l>
<l>*         delete_file (PathToCheckForLocalCameraUsed + 'CamInitialised_' + CameraNumberUsed + '.txt')</l>
<l>*     endif</l>
<c>    </c>
<c>    ***</c>
<c>    </c>
<c>    </c>
<c>    </c>
<c>    *Christian: Wenn TeachIn dann wird jede Kamera so behandelt wie sonst nur Master</c>
<l>*     if (teachinactive)</l>
<l>*         stop()</l>
<l>*         GenericParameters := [BufferString,SlaveString]</l>
<l>*         dev_set_check ('~give_error')</l>
<l>*         open_framegrabber ('SiliconSoftware', 1, 1, 0, 0, 0, 0, 'default', -1, 'default', GenericParameters, 'false', MyCamType, Device, Port, -1, AcqHandle)</l>
<l>*         dev_set_check ('give_error') </l>
<c>        * Get the number of allowed field parameters</c>
<l>*         get_framegrabber_param (AcqHandle, 'available_param_names', NumFieldParameterPow) // all available parameters listed</l>
<l>*         if(DebugWorkOnFirstCameraOnly # 1) // assuming there are 3 cameras per board</l>
<c>            **** init precondition for camera 1 and 4 (start count an 0)</c>
<l>*             gFramegrabber_SiSo_SetupDevice (CameraNumberUsed +1 , 0, 3, Device, Port, SlaveString)        </l>
<l>*             GenericParameters := [BufferString,SlaveString]</l>
<l>*             dev_set_check ('~give_error')</l>
<l>*             open_framegrabber ('SiliconSoftware', 1, 1, 0, 0, 0, 0, 'default', -1, 'default', GenericParameters, 'false', MyCamType, Device, Port, -1, AcqHandle1)</l>
<l>*             dev_set_check ('give_error') </l>
<c>            **** init precondition for camera 2 and 5 (start count an 0)</c>
<l>*             gFramegrabber_SiSo_SetupDevice (CameraNumberUsed +2, 0, 3, Device, Port, SlaveString)</l>
<l>*             GenericParameters := [BufferString,SlaveString]</l>
<l>*             dev_set_check ('~give_error')</l>
<l>*             open_framegrabber ('SiliconSoftware', 1, 1, 0, 0, 0, 0, 'default', -1, 'default', GenericParameters, 'false', MyCamType, Device, Port, -1, AcqHandle2)</l>
<l>*             dev_set_check ('give_error')</l>
<c>            **************************************</c>
<l>*         endif</l>
<c>        * set signal that cam master is initialised</c>
<l>*         open_file (PathToCheckForLocalCameraUsed + 'CamInitialised_' + CameraNumberUsed + '.txt', 'output', FileHandle)</l>
<l>*         close_file (FileHandle)</l>
<c>    </c>
<l>*     else</l>
<l>*     BufferString := ('num_buffers=' + GrabBuffer_SizeInFrames)</l>
<l>*     GenericParameters := BufferString</l>
<l>*     dev_set_check ('~give_error')</l>
<l>*     open_framegrabber ('GenICamTL', 1, 1, 0, 0, 0, 0, 'default', -1, 'default', GenericParameters, 'false', 'default', Device, -1, -1, AcqHandle)</l>
<l>*     dev_set_check ('give_error') </l>
<c>        </c>
<l>*     if (AcqHandle = [])</l>
<l>*         CameraCorrectlyInitialised := 0</l>
<l>*         return()</l>
<l>*     endif</l>
<c></c>
<l>*     set_framegrabber_param (AcqHandle, '[Interface]UserSetFile', 'C:/Users/Meliscout/Desktop/Einstellungen_FPGA/PillInspect_1Cam_Test2.mcf')</l>
<l>*     set_framegrabber_param (AcqHandle, '[Interface]UserSetLoad', 1)</l>
<c>    </c>
<c>    * set auto roi control to false. Otherwise full camera width and height will be used.</c>
<l>*     set_framegrabber_param(AcqHandle, '[Device]AutomaticROIControl', 0)</l>
<l>*     set_framegrabber_param (AcqHandle, 'Height', 3000)   // todo Werte aus Format lesen</l>
<l>*     set_framegrabber_param (AcqHandle, 'OffsetY', 1300)</l>
<l>*     set_framegrabber_param (AcqHandle, 'Width', 4416)</l>
<l>*     set_framegrabber_param (AcqHandle, 'OffsetX', 128)</l>
<c>        </c>
<l>* close_framegrabber (AcqHandle)</l>
<c>    * set signal that cam master is initialised</c>
<l>*     open_file (PathToCheckForLocalCameraUsed + 'CamInitialised_' + CameraNumberUsed + '.txt', 'output', FileHandle)</l>
<l>*     close_file (FileHandle)</l>
<l>*     endif</l>
<c>    </c>
<c>    ***</c>
<c>    </c>
<c>    </c>
<c></c>
<c></c>
<l>*     close_framegrabber (AcqHandle)</l>
<c>    * set up light timing - bottom light        Device1Process1ParametersExposuretimelight0</c>
<l>*     set_framegrabber_param (AcqHandle, '[Device]Device1Process1ParametersExposuretimelight0', Camera_FPGA_BackLight_MicroSec)</l>
<c>    * set up light timing - top light</c>
<l>*     set_framegrabber_param (AcqHandle, '[Device]Device1Process1ParametersExposureTimeLight1', Camera_FPGA_TopLight_MicroSec) // Top light set value of first camera to all cameras            </l>
<l>*     set_framegrabber_param (AcqHandle, '[Device]Device1Process1ParametersSupportBacklight', 1) // switch on support back light for top light</l>
<l>*     set_framegrabber_param (AcqHandle, '[Device]Device1Process1ParametersSupportBacklightTime', Camera_FPGA_TopLight_SupportBackLight_MicroSec) // set length for backlight duration as support light in toplight illumination</l>
<l>*     get_framegrabber_param (AcqHandle, '[Device]Device1Process0ParametersColoroutput', Value)</l>
<c></c>
<c>    * set image output to rgb if needed</c>
<l>*     RGB_Output := 0</l>
<l>*     if(RGB_Output = 0) // this is hsl output</l>
<l>*         set_framegrabber_param (AcqHandle, '[Device]Device1Process0ParametersColoroutput', 'Hsv') // external vcamera to hsl output     </l>
<l>*     else</l>
<l>*         set_framegrabber_param (AcqHandle, '[Device]Device1Process0ParametersColoroutput', 'Rgb') // external vcamera to rgb output</l>
<c></c>
<l>*     endif</l>
<c>    </c>
<c>    * Set eject pulse length</c>
<l>*     set_framegrabber_param (AcqHandle, '[Device]Device1Process1ParametersJetcontrolJetpulsewidth', Camera_FPGA_EjectPulseLength_MicroSec) // pulse width for ejection signal</l>
<c>    </c>
<l>*     FPGA_Tick_InSec :=0.0032</l>
<c>    </c>
<c>    * Set sample eject length        </c>
<l>*     Camera_FPGA_EjectPulseLength_SampleEject_FPGATicks := Camera_FPGA_EjectPulseLength_SampleEject_MicroSec / FPGA_Tick_InSec * 1000000000</l>
<l>*     tuple_int (Camera_FPGA_EjectPulseLength_SampleEject_FPGATicks, Camera_FPGA_EjectPulseLength_SampleEject_FPGATicks)</l>
<l>*     set_framegrabber_param (AcqHandle, '[Device]Device1Process1ImplementationSensorgateWidth6Width', Camera_FPGA_EjectPulseLength_SampleEject_FPGATicks)    </l>
<c>    </c>
<l>*     Camera_FPGA_EjectPulseLength_FPGATicksc := Camera_FPGA_EjectPulseLength_MicroSec / FPGA_Tick_InSec</l>
<c>    </c>
<c>    * setup FPGA Eject Lane specific IO values for board 0</c>
<l>*     tuple_int ((Camera_FPGA_EjectPulseLength_Offset_MicroSec_Lane0 / FPGA_Tick_InSec) + Camera_FPGA_EjectPulseLength_FPGATicksc, FPGATicks_Temp)</l>
<l>*     set_framegrabber_param (AcqHandle, '[Device]Device1Process1ImplementationSensorgateWidth0Width', FPGATicks_Temp)   </l>
<l>*     tuple_int ((Camera_FPGA_EjectPulseLength_Offset_MicroSec_Lane1 / FPGA_Tick_InSec) + Camera_FPGA_EjectPulseLength_FPGATicksc, FPGATicks_Temp)</l>
<l>*     set_framegrabber_param (AcqHandle, '[Device]Device1Process1ImplementationSensorgateWidth1Width', FPGATicks_Temp)</l>
<l>*     tuple_int ((Camera_FPGA_EjectPulseLength_Offset_MicroSec_Lane2 / FPGA_Tick_InSec) + Camera_FPGA_EjectPulseLength_FPGATicksc, FPGATicks_Temp)</l>
<l>*     set_framegrabber_param (AcqHandle, '[Device]Device1Process1ImplementationSensorgateWidth2Width', FPGATicks_Temp)</l>
<l>*     tuple_int ((Camera_FPGA_EjectPulseLength_Offset_MicroSec_Lane3 / FPGA_Tick_InSec) + Camera_FPGA_EjectPulseLength_FPGATicksc, FPGATicks_Temp)</l>
<l>*     set_framegrabber_param (AcqHandle, '[Device]Device1Process1ImplementationSensorgateWidth3Width', FPGATicks_Temp)</l>
<l>*     tuple_int ((Camera_FPGA_EjectPulseLength_Offset_MicroSec_Lane4 / FPGA_Tick_InSec) + Camera_FPGA_EjectPulseLength_FPGATicksc, FPGATicks_Temp)</l>
<l>*     set_framegrabber_param (AcqHandle, '[Device]Device1Process1ImplementationSensorgateWidth4Width', FPGATicks_Temp)</l>
<c></c>
<c>    </c>
<c>    * activate trigger processing 0 is off, 1 is on</c>
<l>*     set_framegrabber_param (AcqHandle, '[Device]Device1Process1ParametersEnabletriggerprocessing', 0)    </l>
<c>   </c>
<c>    </c>
<c>    * next lines were used to switch in between internal and extrnal triggering. for some reason it did not work as supposed- image channels were mixed up </c>
<l>*     if(InternalTrigger0_External1 = 0) // use internal frequency or external trigger to trigger cams - trgger mode is activated in grab just before grab procedure loop</l>
<l>*         set_framegrabber_param (AcqHandle, '[Device]Device1Process1ParametersImagetriggermode', 2) // internal via frequency generator</l>
<l>*     else // external triggering via IO</l>
<c>        * impotant to leave light switched off- otherwise parallel processes will grab e.g. slave processes</c>
<l>*         set_framegrabber_param (AcqHandle, '[Device]Device1Process1ParametersImagetriggermode', 0) // external via IO</l>
<c>        * activate trigger processing 0 is off, 1 is on - is activated just before grabbing loop</c>
<l>*         set_framegrabber_param (AcqHandle, '[Device]Device1Process1ParametersEnabletriggerprocessing', 1)</l>
<l>*     endif  </l>
<c></c>
<l>*     CameraCorrectlyInitialised := 1</l>
<l>* else</l>
<l>*     CameraCorrectlyInitialised := 1</l>
<l>* endif</l>
<c>            </c>
<l>* return()</l>
<c>            </c>
<c>*********************************************************************************************************************</c>
<c>*********************************************************************************************************************</c>
<c>*********************************************************************************************************************           </c>
<c>            * test grab</c>
<l>*             grab_image_start (AcqHandle, -1)</l>
<l>*             while(1)</l>
<l>*                 dev_set_check ('~give_error')</l>
<l>*                 grab_image_async (ImageOrig, AcqHandle, -1)</l>
<l>*                 dev_set_check ('give_error')</l>
<l>*                 get_image_size (ImageOrig, Width1, Height1)</l>
<l>*                 if(Width1 # [])</l>
<l>*                     count_channels (ImageOrig, ImageOrig_Channels)</l>
<l>*                     if(ImageOrig_Channels = 1)</l>
<c>                        * convert interleaved image to a 3 channel image</c>
<l>*                         get_image_pointer1 (ImageOrig, Pointer, TypeRGB, Width, Height)</l>
<l>*                         get_image_size (ImageOrig, Width1, Height1)</l>
<l>*                         gen_image_interleaved (ImageOrig, Pointer, 'bgr', Width / 3, Height, -1, 'byte', 0, 0, 0, 0, -1, 0)</l>
<l>*                         dev_display (ImageOrig)</l>
<l>*                         stop()</l>
<l>*                     endif                    </l>
<l>*                     decompose3 (ImageOrig, Image1, Image2, Image3)</l>
<l>*                     trans_to_rgb (Image1, Image3, Image2, ImageRed, ImageGreen, ImageBlue, 'hls')        </l>
<l>*                     compose3 (ImageRed, ImageGreen, ImageBlue, MultiChannelImage)</l>
<l>*                     dev_display (MultiChannelImage)</l>
<l>*                     stop()</l>
<l>*                 endif</l>
<c>                </c>
<l>*             endwhile</l>
<c>        *********************************************************************************************************************</c>
<c>        *********************************************************************************************************************</c>
<c>        *********************************************************************************************************************</c>
<c></c>
</body>
<docu id="gInitAndOpen_Framegrabber">
<parameters>
<parameter id="AcqHandle"/>
<parameter id="CameraCorrectlyInitialised"/>
<parameter id="CameraNumberToOpen"/>
<parameter id="CameraNumberUsed"/>
<parameter id="DebugWorkOnFirstCameraOnly"/>
<parameter id="PathToCheckForLocalCameraUsed"/>
</parameters>
</docu>
</procedure>
<procedure name="gLoad_Calibration_PixToMM_XY">
<interface>
<ic>
<par name="dict_CalibrationGlobal" base_type="ctrl" dimension="0"/>
<par name="ROI_Camera_NumberOfPos" base_type="ctrl" dimension="0"/>
</ic>
<oc>
<par name="Calibration_VTCamera_VTLane_VTPixToMM_XY" base_type="ctrl" dimension="3"/>
</oc>
</interface>
<body>
<c>* get xy-resolution </c>
<c></c>
<l>NumberOfConnectedCameras := |ROI_Camera_NumberOfPos|</l>
<l>Calibration_VTCamera_VTLane_VTPixToMM_XY.at(0).at(0).at(0) := []</l>
<l>for Index_Cams := 0 to NumberOfConnectedCameras-1 by 1</l>
<c>    * load number of roi positions per cam</c>
<l>    LanesCount := ROI_Camera_NumberOfPos[Index_Cams]</l>
<l>    for Index_ROINumberPos := 0 to LanesCount-1 by 1</l>
<l>*         CalibX_PixToMM := dict_CalibrationGlobal.Calibration.['Calib_Cam_' + Index_Cams].['V_CalibX_PixToMM_' + Index_ROINumberPos].Value</l>
<l>        tuple_real (dict_CalibrationGlobal.Calibration.['Calib_Cam_' + Index_Cams].['V_CalibX_PixToMM_' + Index_ROINumberPos].Value, CalibX_PixToMM)</l>
<l>        tuple_real (dict_CalibrationGlobal.Calibration.['Calib_Cam_' + Index_Cams].['V_CalibY_PixToMM_' + Index_ROINumberPos].Value, CalibY_PixToMM)</l>
<l>*         CalibY_PixToMM := dict_CalibrationGlobal.Calibration.['Calib_Cam_' + Index_Cams].['V_CalibY_PixToMM_' + Index_ROINumberPos].Value</l>
<l>        Calibration_VTCamera_VTLane_VTPixToMM_XY.at(Index_Cams).at(Index_ROINumberPos).at(0) := CalibX_PixToMM</l>
<l>        Calibration_VTCamera_VTLane_VTPixToMM_XY.at(Index_Cams).at(Index_ROINumberPos).at(1) := CalibY_PixToMM</l>
<l>    endfor</l>
<l>endfor</l>
<l>return ()</l>
</body>
<docu id="gLoad_Calibration_PixToMM_XY">
<parameters>
<parameter id="Calibration_VTCamera_VTLane_VTPixToMM_XY"/>
<parameter id="ROI_Camera_NumberOfPos"/>
<parameter id="dict_CalibrationGlobal"/>
</parameters>
</docu>
</procedure>
<procedure name="gLoad_ColourPreprocessing">
<interface>
<ic>
<par name="TeachInMode" base_type="ctrl" dimension="0"/>
</ic>
</interface>
<body>
<l>global def tuple gColourClassificationHandle</l>
<c></c>
<l>global tuple dict_Filedefinition</l>
<l>global tuple dict_TabletInspection</l>
<c>    </c>
<l>ColourClassificationFilename := dict_Filedefinition.ColourClassificationFilename</l>
<l>TabletSpot_DetectionActive := dict_TabletInspection.Measure_ProductSpot.V_FeatureActive.Value</l>
<c></c>
<c></c>
<l>get_system ('processor_num', NumberOfProcessors)</l>
<l>if(NumberOfProcessors &gt; 1)</l>
<c>    * use max amount of cpu power - but leave one cpu available for other system related things</c>
<l>    NumberOfProcessors := NumberOfProcessors -1</l>
<l>endif</l>
<l>set_system ('thread_num', NumberOfProcessors)</l>
<c></c>
<c>* use colour spot detection. if not activated in the later process phase it is identified via the empty colourhandle</c>
<l>if (TabletSpot_DetectionActive and TeachInMode = 0)</l>
<l>    read_class_mlp (ColourClassificationFilename, MLPHandle)</l>
<l>    set_system ('parallelize_operators', 'true') </l>
<c>    *** Janine - Update for Achema</c>
<c>    *** Use rejecte_threshold for images with uv-light to get better results</c>
<l>    create_class_lut_mlp (MLPHandle, [], [], gColourClassificationHandle)</l>
<l>*     create_class_lut_mlp (MLPHandle, ['rejection_threshold'], [0.1], ColourClassificationHandle)</l>
<c>    *** End Janine - Update for Achema</c>
<l>    set_system ('parallelize_operators', 'false')</l>
<l>else</l>
<l>    gColourClassificationHandle := []</l>
<l>endif</l>
<c></c>
<l>return ()</l>
</body>
<docu id="gLoad_ColourPreprocessing">
<parameters>
<parameter id="TeachInMode"/>
</parameters>
</docu>
</procedure>
<procedure name="gLoad_Filedefinitions_dict">
<interface>
<ic>
<par name="dict_Pathdefinitions" base_type="ctrl" dimension="0"/>
</ic>
<oc>
<par name="dict_Filedefinition" base_type="ctrl" dimension="0"/>
</oc>
</interface>
<body>
<c>* Define file names based on given path names    </c>
<c></c>
<l>create_dict (dict_Filedefinition)</l>
<c></c>
<l>get_dict_tuple (dict_Pathdefinitions, 'TempPath', TempPath)</l>
<l>set_dict_tuple (dict_Filedefinition, 'Window_positioningFilename', TempPath + 'window_positioning.json')</l>
<c></c>
<l>get_dict_tuple(dict_Pathdefinitions, 'ConfigPath', ConfigPath)</l>
<l>set_dict_tuple (dict_Filedefinition, 'LogoImageFilename', ConfigPath + 'logo.png')</l>
<l>set_dict_tuple (dict_Filedefinition, 'Programm settings filename', ConfigPath + 'settings.json')</l>
<c></c>
<l>get_dict_tuple (dict_Pathdefinitions, 'FormatPath', FormatPath)</l>
<l>set_dict_tuple (dict_Filedefinition, 'ProductImage Current Format', FormatPath + 'ProductImage')</l>
<c></c>
<l>set_dict_tuple (dict_Filedefinition, 'ProductImage Prefix for Loading from Disk', 'ProductImage')</l>
<l>set_dict_tuple (dict_Filedefinition, 'Button-Interface-file to GUI. Show Elements on Gui.', 'hbtn.txt')</l>
<l>set_dict_tuple (dict_Filedefinition, 'Button-Interface-file from GUI. Event from Gui.', 'btn.txt')</l>
<c></c>
<c>* now all config filenames</c>
<l>get_dict_tuple (dict_Pathdefinitions, 'FormatPath_Config', FormatPath_Config)</l>
<l>set_dict_tuple (dict_Filedefinition, 'CameraFilename', FormatPath_Config+'camera.json')</l>
<l>set_dict_tuple (dict_Filedefinition, 'ROIFilename', FormatPath_Config+'roi.json')</l>
<l>set_dict_tuple (dict_Filedefinition, 'Inspection_visualizationFilename', FormatPath_Config+'inspection_visualization.json')</l>
<l>set_dict_tuple (dict_Filedefinition, 'MiscFilename', FormatPath_Config+'misc.json')</l>
<l>set_dict_tuple (dict_Filedefinition, 'ModeFilename', FormatPath_Config+'mode.json')</l>
<l>set_dict_tuple (dict_Filedefinition, 'PLCFilename', FormatPath_Config+'plc.json')</l>
<l>set_dict_tuple (dict_Filedefinition, 'MachineTimingFilename', FormatPath_Config+'machine_timing.json')</l>
<l>set_dict_tuple (dict_Filedefinition, 'TabletInspectionFilename', FormatPath_Config+'tablet_inspection.json')</l>
<l>set_dict_tuple (dict_Filedefinition, 'ShiftregisterFilename', FormatPath_Config+'shiftregister.json')</l>
<l>* set_dict_tuple (dict_Filedefinition, 'PrintinspectionFilename', FormatPath_Config+'print_inspection.json')</l>
<l>set_dict_tuple (dict_Filedefinition, 'ColourClassificationFilename', FormatPath_Config+'colour.class')</l>
<c>* the calibration variable uses default format due to it is a kind of global parameter that interacts with all formats - only for calibration data- for switching on off etc it uses local parameter set</c>
<l>set_dict_tuple (dict_Filedefinition, 'CalibrationFilename_Local', FormatPath_Config+'calibration.json')</l>
<l>get_dict_tuple (dict_Pathdefinitions, 'FormatTemplatePath', FormatTemplatePath)</l>
<l>set_dict_tuple (dict_Filedefinition, 'CalibrationFilename_Global', FormatTemplatePath+'calibration.json')</l>
<l>return ()</l>
</body>
<docu id="gLoad_Filedefinitions_dict">
<parameters>
<parameter id="dict_Filedefinition"/>
<parameter id="dict_Pathdefinitions"/>
</parameters>
</docu>
</procedure>
<procedure name="gLoad_Language">
<interface>
<ic>
<par name="dict_Pathdefinitions" base_type="ctrl" dimension="0"/>
</ic>
<oc>
<par name="GUILanguage" base_type="ctrl" dimension="0"/>
<par name="MessagesInLocalLanguage" base_type="ctrl" dimension="0"/>
</oc>
</interface>
<body>
<l>    set_system ('filename_encoding', 'utf8')</l>
<c>    * first read the current language</c>
<l>    read_dict_from_format ('Programm settings filename', dict_ProgrammSettings)</l>
<l>    GUILanguage := dict_ProgrammSettings.Language</l>
<c>    * now load the language related strings</c>
<l>    get_dict_tuple (dict_Pathdefinitions, 'LanguageFilePath', LanguageFilePath)</l>
<l>    LanguageFilePath := dict_Pathdefinitions.LanguageFilePath + GUILanguage + '.json'</l>
<c></c>
<c>    * read dictionary with all Messages in current language</c>
<l>    read_dict (LanguageFilePath, [], [], MessagesInLocalLanguage)</l>
<l>    set_system ('filename_encoding', 'locale')</l>
<l>return ()</l>
</body>
<docu id="gLoad_Language">
<parameters>
<parameter id="GUILanguage"/>
<parameter id="MessagesInLocalLanguage"/>
<parameter id="dict_Pathdefinitions"/>
</parameters>
</docu>
</procedure>
<procedure name="gLoad_Pathdefinition_dict">
<interface>
<oc>
<par name="DictHandle_Pathdefinition" base_type="ctrl" dimension="0"/>
</oc>
</interface>
<body>
<c>* initially set environemt to utf8 instead of local</c>
<l>set_system ('filename_encoding', 'utf8')</l>
<c></c>
<c>* Load path definitions</c>
<l>get_current_dir (DirName)</l>
<l>tuple_strrchr (DirName, '\\', Position)</l>
<l>tuple_str_first_n (DirName, Position, ProgrammRootPath)</l>
<l>create_dict(DictHandle_Pathdefinition)</l>
<c></c>
<l>set_dict_tuple (DictHandle_Pathdefinition, 'ProgrammRootPath', ProgrammRootPath)</l>
<l>set_dict_tuple (DictHandle_Pathdefinition, 'FormatTemplatePath', ProgrammRootPath+ 'format_template\\config\\')</l>
<l>set_dict_tuple (DictHandle_Pathdefinition, 'ConfigPath', ProgrammRootPath + 'config\\')</l>
<l>set_dict_tuple (DictHandle_Pathdefinition, 'ErrorImagesPath', ProgrammRootPath + 'errors\\')</l>
<l>set_dict_tuple (DictHandle_Pathdefinition, 'TempPath', ProgrammRootPath + 'temp\\')</l>
<l>set_dict_tuple (DictHandle_Pathdefinition, 'ImagesToStorePath', ProgrammRootPath + 'image_files\\')</l>
<l>set_dict_tuple (DictHandle_Pathdefinition, 'LanguageFilePath', ProgrammRootPath + 'lang\\')</l>
<l>set_dict_tuple (DictHandle_Pathdefinition, 'EngineProceduresFilePath', ProgrammRootPath + 'engine\\Procedures\\')</l>
<c></c>
<c></c>
<c>* read format</c>
<l>open_file (ProgrammRootPath + 'config\\currentformat.ini', 'input', FileHandle)</l>
<l>fread_line (FileHandle, FormatPath, DictHandle_Pathdefinition_Pathdefinition)</l>
<l>close_file (FileHandle)</l>
<c></c>
<c></c>
<l>set_dict_tuple (DictHandle_Pathdefinition, 'FormatPath', FormatPath)</l>
<c></c>
<l>set_dict_tuple (DictHandle_Pathdefinition, 'FormatPath_Config',FormatPath+'config\\')</l>
<l>set_dict_tuple (DictHandle_Pathdefinition, 'FormatPath_Productimages', FormatPath+'images_ProductTeachIn\\')</l>
<l>* set_dict_tuple (DictHandle_Pathdefinition, 'FormatPath_InProcessControlimages', FormatPath+'images_InProcessControl\\')</l>
<l>set_dict_tuple (DictHandle_Pathdefinition, 'FormatPath_FormatDataFromTeachIn', FormatPath+'formatData\\')</l>
<l>return ()</l>
</body>
<docu id="gLoad_Pathdefinition_dict">
<parameters>
<parameter id="DictHandle_Pathdefinition"/>
</parameters>
</docu>
</procedure>
<procedure name="gLoad_ProductImage">
<interface>
<oo>
<par name="ImageOrig" base_type="iconic" dimension="0"/>
</oo>
</interface>
<body>
<l>global tuple dict_Filedefinition</l>
<l>global tuple dict_Camera</l>
<c></c>
<l>FilenameProductimage := dict_Filedefinition.['ProductImage Current Format']</l>
<c></c>
<c>* load an productimage that holds multiple channels</c>
<l>dev_error_var (Error, 1)</l>
<l>dev_set_check ('~give_error')</l>
<l>read_image (ImageOrig, FilenameProductimage + 'AllChannels')</l>
<l>ReadError := Error</l>
<l>dev_set_check ('give_error')</l>
<c></c>
<c>* if loading failed try to load 3-channel image (rgb or hsv)</c>
<l>if (ReadError != H_MSG_TRUE) // try to load normal product image</l>
<l>    dev_error_var (Error, 1)</l>
<l>    dev_set_check ('~give_error')</l>
<l>    read_image (ImageOrig, FilenameProductimage)</l>
<l>    ReadError := Error</l>
<l>    dev_set_check ('give_error')</l>
<c>    </c>
<c>    * if that failed, too, generate empty image for product image</c>
<l>    if (ReadError != H_MSG_TRUE)</l>
<l>        ImageGrabResolution_Width := dict_Camera.Cameras.Camera_0.V_ImageGrabResolution_Width.Value</l>
<l>        ImageGrabResolution_Height := dict_Camera.Cameras.Camera_0.V_ImageGrabResolution_Height.Value    </l>
<l>        gen_image_const (ImageOrig, 'byte', ImageGrabResolution_Width, ImageGrabResolution_Height)</l>
<l>    endif</l>
<c></c>
<l>endif</l>
<c></c>
<c></c>
<l>return ()</l>
</body>
<docu id="gLoad_ProductImage">
<parameters>
<parameter id="ImageOrig"/>
</parameters>
</docu>
</procedure>
<procedure name="gLoad_ROI">
<interface>
<oo>
<par name="RinnenROIs_Vector" base_type="iconic" dimension="1"/>
<par name="EjectROIs_Vector" base_type="iconic" dimension="1"/>
</oo>
<ic>
<par name="ROIOffset" base_type="ctrl" dimension="0"/>
</ic>
<oc>
<par name="ROI_NumberOfPos" base_type="ctrl" dimension="0"/>
</oc>
</interface>
<body>
<l>* EjectROIs_Vector := EjectROIs_Vector</l>
<l>* RinnenROIs_Vector := RinnenROIs_Vector</l>
<c>    * generate ROIs and EjectROIs</c>
<c></c>
<l>global tuple dict_ROI</l>
<l>global tuple dict_Camera</l>
<c></c>
<l>set_system ('clip_region', 'false')</l>
<c></c>
<c>* init output</c>
<l>gen_empty_obj (EmptyObject)</l>
<l>RinnenROIs_Vector.at(0) := EmptyObject</l>
<l>EjectROIs_Vector.at(0) := EmptyObject</l>
<l>ROI_NumberOfPos := []</l>
<c></c>
<c></c>
<c></c>
<l>NumberOfConnectedCameras := dict_Camera.General.V_Camera_NumberOfConnectedCameras.Value</l>
<l>for Index_ROICams := 0 to NumberOfConnectedCameras-1 by 1</l>
<l>    get_dict_tuple (dict_ROI.ROIs, 'ROI_Cam_' + Index_ROICams, dict_ROICam)</l>
<l>    ROI_OffsetImageTop_UpperROIPosition := dict_ROICam.V_Inspection_OffsetTop_UpperROIPosition.Value</l>
<l>    ROI_OffsetImageTop_LowerROIPosition := dict_ROICam.V_Inspection_OffsetTop_LowerROIPosition.Value</l>
<l>    ROI_OffsetX := dict_ROICam.V_Inspection_OffsetLeft.Value</l>
<l>    ROI_Width := dict_ROICam.V_Inspection_Width.Value</l>
<l>    ROIEject_OffsetImageTop := dict_ROICam.V_Eject_OffsetTop.Value</l>
<l>    ROIEject_Length := dict_ROICam.V_Eject_Length.Value</l>
<l>    ROIEject_Width := dict_ROICam.V_Eject_Width.Value</l>
<c>    * load roi middle position values based on column</c>
<l>    ROI_NumberOfPos_Read := dict_ROICam.V_NumberOfPos.Value</l>
<l>    ROI_NumberOfPos := [ROI_NumberOfPos,ROI_NumberOfPos_Read]</l>
<l>    ROI_StartColumnsTpl := []</l>
<c>    </c>
<l>    for Index_ROINumberPos := 0 to ROI_NumberOfPos[Index_ROICams]-1 by 1</l>
<l>        get_dict_tuple (dict_ROICam, 'V_Pos_Column_' + Index_ROINumberPos, dict_PosColumn)</l>
<l>        ROI_StartColumnTemp := dict_PosColumn.Value</l>
<l>        tuple_concat (ROI_StartColumnsTpl, ROI_StartColumnTemp, ROI_StartColumnsTpl)</l>
<l>    endfor</l>
<c>    </c>
<l>    gSetUp_ROIs (RinnenROIs, EjectROIs, ROI_StartColumnsTpl, ROI_OffsetImageTop_UpperROIPosition, ROI_OffsetImageTop_LowerROIPosition, ROI_OffsetX, ROI_Width, ROIEject_OffsetImageTop, ROIEject_Length, ROIEject_Width)</l>
<l>    RinnenROIs_Vector.at(Index_ROICams) := RinnenROIs</l>
<l>    EjectROIs_Vector.at(Index_ROICams) := EjectROIs</l>
<l>endfor</l>
<c></c>
<l>set_system ('clip_region', 'true')</l>
<l>return ()</l>
</body>
<docu id="gLoad_ROI">
<parameters>
<parameter id="EjectROIs_Vector"/>
<parameter id="ROIOffset"/>
<parameter id="ROI_NumberOfPos"/>
<parameter id="RinnenROIs_Vector"/>
</parameters>
</docu>
</procedure>
<procedure name="gLoad_ThreadManagement">
<interface>
<ic>
<par name="NumberOfProcessingThreadsPerCamera" base_type="ctrl" dimension="0"/>
<par name="ROI_NumberOfPos" base_type="ctrl" dimension="0"/>
<par name="LocalCameraNumberUsed" base_type="ctrl" dimension="0"/>
</ic>
<oc>
<par name="LanesPerThreadsVector" base_type="ctrl" dimension="1"/>
</oc>
</interface>
<body>
<l>global tuple gDebuglevel</l>
<c></c>
<l>global def tuple gThread_RGB_Threshold_Active</l>
<l>global def tuple gThread_Middle_Active</l>
<c></c>
<c></c>
<l>if (gDebuglevel = 1 or gDebuglevel = 2)</l>
<l>    gThread_Middle_Active := 0</l>
<l>    gThread_RGB_Threshold_Active := 0</l>
<l>else</l>
<l>    gThread_Middle_Active := 1</l>
<l>    gThread_RGB_Threshold_Active := 1</l>
<l>endif</l>
<c></c>
<l>tuple_gen_sequence (1, ROI_NumberOfPos[LocalCameraNumberUsed], 1, Sequence)</l>
<l>LanesPerThreadsVector := {Sequence}</l>
<c></c>
<l>if (gDebuglevel = 0) // on debug initialisation values are used, also as default</l>
<l>    switch (NumberOfProcessingThreadsPerCamera)</l>
<l>    case 1:</l>
<l>        break // done with initialisation</l>
<l>    case 2:</l>
<l>        LanesPerThreadsVector := {[1,2,3],[4,5,6]}</l>
<l>        break</l>
<l>    case 3: </l>
<l>        LanesPerThreadsVector := {[1,2],[3,4],[5,6]}</l>
<l>        break</l>
<l>    case 4:</l>
<l>        LanesPerThreadsVector := {[1,2],[3,4],[5],[6]}</l>
<l>        break</l>
<l>    case 5:</l>
<l>        LanesPerThreadsVector := {[1],[2],[3],[4],[5]}</l>
<l>        break</l>
<l>    case 6:</l>
<l>        LanesPerThreadsVector := {[1],[2],[3],[4],[5],[6]}</l>
<l>        break</l>
<l>    endswitch</l>
<l>endif</l>
<c></c>
<l>VectorLength := LanesPerThreadsVector.length()</l>
<l>for Index_Vect := VectorLength-1 to 0 by -1 // negative count is used so vector order is consistant while removing elements from it</l>
<l>    VectorPart := LanesPerThreadsVector.at(Index_Vect)</l>
<l>    tuple_greater_elem (VectorPart, ROI_NumberOfPos[LocalCameraNumberUsed], Greatereq)</l>
<l>    tuple_find (Greatereq, 1, Indices_OutOfRange)</l>
<l>    tuple_remove (VectorPart, Indices_OutOfRange, VectorPart_ROICount_Corrected)</l>
<l>    if( VectorPart_ROICount_Corrected # [])</l>
<l>        LanesPerThreadsVector.at(Index_Vect) := VectorPart_ROICount_Corrected</l>
<l>    else</l>
<l>        LanesPerThreadsVector.remove(Index_Vect)</l>
<l>    endif</l>
<l>endfor</l>
<l>return ()</l>
</body>
<docu id="gLoad_ThreadManagement">
<parameters>
<parameter id="LanesPerThreadsVector"/>
<parameter id="LocalCameraNumberUsed"/>
<parameter id="NumberOfProcessingThreadsPerCamera"/>
<parameter id="ROI_NumberOfPos"/>
</parameters>
</docu>
</procedure>
<procedure name="gLoadData_Calibration">
<interface>
<ic>
<par name="VTFiledefinitions" base_type="ctrl" dimension="1"/>
<par name="FileElementNumber" base_type="ctrl" dimension="0"/>
<par name="ROI_Camera_NumberOfPos" base_type="ctrl" dimension="0"/>
</ic>
<oc>
<par name="VTDataVector" base_type="ctrl" dimension="1"/>
<par name="Calibration_VTCamera_VTLane_VTPixToMM_XY" base_type="ctrl" dimension="3"/>
</oc>
</interface>
<body>
<l>VTDataVector.at(0) := []</l>
<c>* </c>
<c>* get single variables from json file</c>
<c></c>
<c>* Read JSON-File from local format</c>
<l>FilenameToLoad_Local := VTFiledefinitions.at(FileElementNumber[1])[1]</l>
<l>gJSON_Read_File_to_Vector (FilenameToLoad_Local, ParameterVector_Local)</l>
<c>* </c>
<c>* </c>
<l>Prefix_StaticWhileLoading := '/General/'</l>
<l>IteratingWhileLoading := ['V_FeatureActive', 'V_TeachIn_Active', 'V_CalibrationObject_Length_MM', 'V_CalibrationObject_Width_MM' \
                          ,'V_CalibrationObject_MeasureSystemAnalyses_Active','V_Calib_GlobalMeasurementOffset_Âµm_X','V_Calib_GlobalMeasurementOffset_Âµm_Y','--------- for future use']</l>
<c></c>
<l>Suffix_StaticWhileLoading := '/Value'</l>
<l>gJSON_LoadValuesFromArrayLike (ParameterVector_Local, VTDataVector, Prefix_StaticWhileLoading, Suffix_StaticWhileLoading, IteratingWhileLoading, VTDataVector)</l>
<c>* </c>
<c>*****************</c>
<c>* Read JSON-File from global format</c>
<l>FilenameToLoad_Global := VTFiledefinitions.at(FileElementNumber[0])[1]</l>
<l>gJSON_Read_File_to_Vector (FilenameToLoad_Global, ParameterVector_Global)</l>
<c></c>
<c>* get xy-resolution from from json file</c>
<c></c>
<l>NumberOfConnectedCameras := |ROI_Camera_NumberOfPos|</l>
<l>Calibration_VTCamera_VTLane_VTPixToMM_XY.at(0).at(0).at(0) := []</l>
<l>for Index_Cams := 0 to NumberOfConnectedCameras-1 by 1</l>
<c>    * load number of roi positions per cam</c>
<l>    LanesCount := ROI_Camera_NumberOfPos[Index_Cams]</l>
<l>    for Index_ROINumberPos := 0 to LanesCount-1 by 1</l>
<l>        gJSON_Get_Value_from_Vector ('/Calibration/Calib_Cam_' + Index_Cams + '/V_CalibX_PixToMM_' + Index_ROINumberPos + '/Value', ParameterVector_Global, CalibX_PixToMM)</l>
<l>        gJSON_Get_Value_from_Vector ('/Calibration/Calib_Cam_' + Index_Cams + '/V_CalibY_PixToMM_' + Index_ROINumberPos + '/Value', ParameterVector_Global, CalibY_PixToMM)</l>
<l>        Calibration_VTCamera_VTLane_VTPixToMM_XY.at(Index_Cams).at(Index_ROINumberPos).at(0) := CalibX_PixToMM</l>
<l>        Calibration_VTCamera_VTLane_VTPixToMM_XY.at(Index_Cams).at(Index_ROINumberPos).at(1) := CalibY_PixToMM</l>
<l>    endfor</l>
<l>endfor</l>
<c>* </c>
<l>if(0) // necessary to integratr. otherwise jit will create loading error for the variables / no data loaded '/General/V_Calib_GlobalMeasurementOffset_Âµm_X/Value'</l>
<l>    stop()</l>
<l>endif</l>
<c>* </c>
<l>return ()</l>
</body>
<docu id="gLoadData_Calibration">
<parameters>
<parameter id="Calibration_VTCamera_VTLane_VTPixToMM_XY"/>
<parameter id="FileElementNumber"/>
<parameter id="ROI_Camera_NumberOfPos"/>
<parameter id="VTDataVector"/>
<parameter id="VTFiledefinitions"/>
</parameters>
</docu>
</procedure>
<procedure name="gLoadData_Calibration_MsaRelevantOnly">
<interface>
<ic>
<par name="VTFiledefinitions" base_type="ctrl" dimension="1"/>
</ic>
<oc>
<par name="VTDataVector" base_type="ctrl" dimension="1"/>
</oc>
</interface>
<body>
<l>VTDataVector.at(0) := []</l>
<l>FilenameToLoad_Local := VTFiledefinitions.at(22)[1]</l>
<l>gJSON_Read_File_to_Vector (FilenameToLoad_Local, ParameterVector_Local)</l>
<l>Prefix_StaticWhileLoading := '/General/'</l>
<l>IteratingWhileLoading := ['V_FeatureActive', 'V_TeachIn_Active' ,'V_CalibrationObject_MeasureSystemAnalyses_Active']</l>
<c></c>
<l>Suffix_StaticWhileLoading := '/Value'</l>
<l>gJSON_LoadValuesFromArrayLike (ParameterVector_Local, VTDataVector, Prefix_StaticWhileLoading, Suffix_StaticWhileLoading, IteratingWhileLoading, VTDataVector)</l>
<c></c>
<l>return ()</l>
<c></c>
</body>
<docu id="gLoadData_Calibration_MsaRelevantOnly">
<short lang="de_DE">Öffnet mit Hilfe anderer Funktionen die calibration.json aus dem aktuellen Format und holt die MSA relevanten Werte ab. (V_FeatureActive, V_TeachIn_Active, V_CalibrationObject_MeasureSystemAnalyses_Active)</short>
<parameters>
<parameter id="VTDataVector">
<default_type>integer</default_type>
<description lang="de_DE">Vector that stores the MSA relevant information of the calibration.json like 
{[path inside file, value], [path, value]...} </description>
<type_list>
<item>integer</item>
<item>string</item>
</type_list>
</parameter>
<parameter id="VTFiledefinitions">
<default_type>string</default_type>
<description lang="de_DE">Vector that stores the location of config json files like 
{[name1, path1], [name2, path2]}</description>
<type_list>
<item>string</item>
</type_list>
</parameter>
</parameters>
</docu>
</procedure>
<procedure name="gLoadData_InspectionVisualization">
<interface>
<ic>
<par name="VTFiledefinitions" base_type="ctrl" dimension="1"/>
<par name="FileElementNumber" base_type="ctrl" dimension="0"/>
</ic>
<oc>
<par name="VTDataVector" base_type="ctrl" dimension="1"/>
</oc>
</interface>
<body>
<l>VTDataVector.at(0) := []</l>
<c>* Read JSON-File</c>
<l>FilenameToLoad := VTFiledefinitions.at(FileElementNumber)[1]</l>
<l>gJSON_Read_File_to_Vector (FilenameToLoad, ParameterVector)</l>
<c>* </c>
<c>* minimal loading function for teachin</c>
<l>Prefix_StaticWhileLoading := '/'</l>
<l>IteratingWhileLoading := ['V_ShowProcessingTime','V_ShowVisualisationTime','V_ShowPictureNumber','V_ShowCameraNumberUsed','V_ShowResultOK_NOK','V_ShowColour_1','V_ShowColour_2','V_ShowColour_3','V_ShowLength','V_ShowWidth','V_ShowDiameter','V_ShowArea','V_ShowProductSpeed','V_SuppressBadProductVisualisationInEjectBox','V_ShowCounterGood','V_ShowCounterBad', 'V_VisuFontSize','V_ShowProductSpeedMean']</l>
<c></c>
<l>IteratingWhileLoading := [IteratingWhileLoading, 'V_ShowMachineShiftregister_Index','V_ShowThreadQueue_Bufferlength', 'V_VisualisationFrequencyDevider_GUI', 'V_ErrorDetailImage_CounterAndIndex_Inpaint']</l>
<l>Suffix_StaticWhileLoading := '/Value'</l>
<l>gJSON_LoadValuesFromArrayLike (ParameterVector, VTDataVector, Prefix_StaticWhileLoading, Suffix_StaticWhileLoading, IteratingWhileLoading, VTDataVector)</l>
<c>* </c>
<l>return ()</l>
</body>
<docu id="gLoadData_InspectionVisualization">
<chapters lang="de_DE">
<item>Load_Data</item>
</chapters>
<short lang="de_DE">Load from Inifile Camera, Image and IO PArameter</short>
<parameters>
<parameter id="FileElementNumber"/>
<parameter id="VTDataVector"/>
<parameter id="VTFiledefinitions"/>
</parameters>
</docu>
</procedure>
<procedure name="gLoadData_Language">
<interface>
<ic>
<par name="VTFiledefinitions" base_type="ctrl" dimension="1"/>
<par name="LanguageFileOnlyPathname" base_type="ctrl" dimension="0"/>
</ic>
<oc>
<par name="GUILanguage" base_type="ctrl" dimension="0"/>
<par name="VTMessagesInLocalLanguage" base_type="ctrl" dimension="1"/>
</oc>
</interface>
<body>
<l>set_system ('filename_encoding', 'utf8')</l>
<c></c>
<l>VTDataVector.at(0) := []</l>
<c>* first read in what language is the current one</c>
<c>* Read JSON-File</c>
<l>FilenameToLoad := VTFiledefinitions.at(6)[1]</l>
<l>gJSON_Read_File_to_Vector (FilenameToLoad, ParameterVector)</l>
<c>* </c>
<l>StringToGetVariableFrom := 'Language'</l>
<l>gJSON_Get_Value_from_Vector (StringToGetVariableFrom, ParameterVector, FoundValue)</l>
<l>GUILanguage := FoundValue</l>
<c>* </c>
<c>* now load the language related strings</c>
<c>* Read JSON-File</c>
<l>FilenameToLoad := LanguageFileOnlyPathname + GUILanguage + '.json'</l>
<l>gJSON_Read_File_to_Vector (FilenameToLoad, ParameterVector)</l>
<c>* </c>
<c>* minimal loading function for teachin</c>
<l>Prefix_StaticWhileLoading := ''</l>
<l>IteratingWhileLoading := ['HDEV_Cancel','HDEV_OkNext','HDEV_PictureSelectionHelpText','HDEV_NoImagesAvailable','HDEV_PictureNumber','HDEV_FirstImage','HDEV_TeachInHelptextGeometric']</l>
<l>IteratingWhileLoading := [IteratingWhileLoading,'HDEV_PictureSelection','HDEV_LineProfile','HDEV_TeachInRectangle','HDEV_TeachInColour','HDEV_TeachInSelectRegion','HDEV_TeachInCalculationWait']</l>
<l>IteratingWhileLoading := [IteratingWhileLoading,'HDEV_TeachInColourInnerColourPainting','HDEV_TeachInColourMirrorZoomColourPainting','HDEV_TeachInColourMirrorColourPainting','HDEV_TeachInColourBackgroundColourPainting']</l>
<l>IteratingWhileLoading := [IteratingWhileLoading,'HDEV_TeachInColourReteach','HDEV_TeachInStopCalculation','HDEV_TeachInNoProductFound','HDEV_TeachInSlideToleranceBar']</l>
<l>IteratingWhileLoading := [IteratingWhileLoading,'HDEV_TeachInDiagrammHorizontalNamingColour1','HDEV_TeachInDiagrammHorizontalNamingColour2','HDEV_TeachInDiagrammHorizontalNamingColour3','HDEV_TeachInDiagrammHorizontalNamingLength']</l>
<l>IteratingWhileLoading := [IteratingWhileLoading,'HDEV_TeachInDiagrammHorizontalNamingWidth','HDEV_TeachInDiagrammHorizontalNamingDiameter','HDEV_TeachInDiagrammHorizontalNamingArea','HDEV_TeachInTeachInCompleted']</l>
<l>IteratingWhileLoading := [IteratingWhileLoading,'HDEV_TeachInTeachInCanceled','HDEV_Back','HDEV_Width','HDEV_Height','HDEV_PaintNew','HDEV_TeachInWhileCalculationHint','HDEV_TeachInWhileColourCalculationHint']</l>
<l>IteratingWhileLoading := [IteratingWhileLoading,'HDEV_Invert','HDEV_Count','HDEV_TeachInAdaptScaleHint','HDEV_Mean','HDEV_Min','HDEV_Max','HDEV_Delta','HDEV_3SigmaLeft','HDEV_3SigmaRight','HDEV_TeachInSetHorizontalLinesUserMsgToSetThreshold']</l>
<l>IteratingWhileLoading := [IteratingWhileLoading,'HDEV_Wait','HDEV_InitTime','HDEV_ThreadMiddleFinished','HDEV_ThreadAquisitionFinished','HDEV_ThreadProcessingFinished','HDEV_InspectionFinished']</l>
<l>IteratingWhileLoading := [IteratingWhileLoading,'HDEV_ShowProcessingTime', 'HDEV_ShowVisualisationTime', 'HDEV_ShowPictureNumber', 'HDEV_ShowColour_1', 'HDEV_ShowColour_2', 'HDEV_ShowColour_3', 'HDEV_ShowLength', 'HDEV_ShowWidth', 'HDEV_ShowDiameter']</l>
<l>IteratingWhileLoading := [IteratingWhileLoading,'HDEV_ShowArea', 'HDEV_ShowProductSpeed', 'HDEV_ShowCameraNumberUsed' , 'HDEV_ShowCounterGood', 'HDEV_ShowCounterBad', 'HDEV_ShowProductSpeedMean', 'HDEV_Message_ProductOverspeedDetection']</l>
<l>Suffix_StaticWhileLoading := ''</l>
<c>* </c>
<l>gJSON_LoadValuesFromArrayLike (ParameterVector, VTDataVector, Prefix_StaticWhileLoading, Suffix_StaticWhileLoading, IteratingWhileLoading, VTMessagesInLocalLanguage)</l>
<c>* </c>
<l>set_system ('filename_encoding', 'locale')</l>
<l>return ()</l>
</body>
<docu id="gLoadData_Language">
<parameters>
<parameter id="GUILanguage"/>
<parameter id="LanguageFileOnlyPathname"/>
<parameter id="VTFiledefinitions"/>
<parameter id="VTMessagesInLocalLanguage"/>
</parameters>
</docu>
</procedure>

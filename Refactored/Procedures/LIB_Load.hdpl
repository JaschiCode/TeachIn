<parameters>
<parameter id="FileElementNumber"/>
<parameter id="TeachInMode"/>
<parameter id="VTDataVector"/>
<parameter id="VTFiledefinitions"/>
</parameters>
</docu>
</procedure>
<procedure name="gLoadData_PrintInspection">
<interface>
<oo>
<par name="Print_VIRegions" base_type="iconic" dimension="1"/>
</oo>
<ic>
<par name="VTFiledefinitions" base_type="ctrl" dimension="1"/>
<par name="FileElementNumber" base_type="ctrl" dimension="0"/>
<par name="VTPathdefinitions" base_type="ctrl" dimension="1"/>
<par name="TeachInMode" base_type="ctrl" dimension="0"/>
</ic>
<oc>
<par name="VTDataVector" base_type="ctrl" dimension="1"/>
</oc>
</interface>
<body>
<c>* Init</c>
<l>gen_empty_obj (EmptyObject)</l>
<l>Print_VIRegions.at(0) := EmptyObject</l>
<c>* </c>
<l>VTDataVector.at(0) := []</l>
<c>* Read JSON-File</c>
<l>FilenameToLoad := VTFiledefinitions.at(FileElementNumber)[1]</l>
<l>gJSON_Read_File_to_Vector (FilenameToLoad, ParameterVector)</l>
<l>Prefix_StaticWhileLoading := '/'</l>
<l>IteratingWhileLoading := ['V_FeatureActive','V_PrintSegmented_ErosionFilterSize','V_AdditionalPrint_MinArea','V_MissingPrint_MinArea','V_CheckForAdditionalPrintVertical','V_CheckForAdditionalPrintHorizontal','V_Segmentation_SmallestAreaToUse','V_ExpandPrintIntoObjectHull']</l>
<l>Suffix_StaticWhileLoading := '/Value'</l>
<l>gJSON_LoadValuesFromArrayLike (ParameterVector, VTDataVector, Prefix_StaticWhileLoading, Suffix_StaticWhileLoading, IteratingWhileLoading, VTDataVector)</l>
<c>* **************************************************</c>
<l>gGetSubObjectVariables_SingleValue (VTDataVector, 'V_FeatureActive', FeatureActive)</l>
<l>if (FeatureActive = 1)</l>
<l>    gGetSubObjectVariables_SingleValue (VTPathdefinitions, 'FormatPath_Config', FormatPath_Config)</l>
<l>    gGetSubObjectVariables_SingleValue (VTDataVector, '/V_Segmentation_SmallestAreaToUse/Value', Segmentation_SmallestAreaToUse)</l>
<l>    gGetSubObjectVariables_SingleValue (VTDataVector, '/V_PrintSegmented_ErosionFilterSize/Value', PrintSegmented_ErosionFilterSize)</l>
<l>    gGetSubObjectVariables_SingleValue (VTDataVector, '/V_CheckForAdditionalPrintVertical/Value', CheckForAdditionalPrintVertical)</l>
<l>    gGetSubObjectVariables_SingleValue (VTDataVector, '/V_CheckForAdditionalPrintHorizontal/Value', CheckForAdditionalPrintHorizontal)</l>
<c>    * </c>
<c>    * </c>
<c>    * </c>
<l>    if (TeachInMode = 1)</l>
<l>        gen_empty_obj (ColourTeachIn_InnerProductRegion)</l>
<l>        gen_empty_obj (PrintSegmented)</l>
<l>    else</l>
<l>        read_region (ColourTeachIn_InnerProductRegion, FormatPath_Config + 'ColourTeachIn_InnerProductRegion.hobj')</l>
<l>        read_region (PrintSegmented, FormatPath_Config + 'TeachInPrintSegmented.hobj')</l>
<l>    endif</l>
<c>    * </c>
<c>    * filter segmented print</c>
<l>    connection (PrintSegmented, PrintSegmented)</l>
<l>    select_shape (PrintSegmented, PrintSegmented, 'area', 'and', Segmentation_SmallestAreaToUse, 99999999)</l>
<l>    union1 (PrintSegmented, PrintSegmented)</l>
<c>    * </c>
<l>    closing_circle (PrintSegmented, PrintSegmented, PrintSegmented_ErosionFilterSize)</l>
<c>    * </c>
<l>    area_center (ColourTeachIn_InnerProductRegion, Area, GoodRefereence_AreaCenter_Row, GoodRefereence_AreaCenter_Column)</l>
<l>    TupleToAddToVector := ['GoodRefereence_AreaCenter_Row',GoodRefereence_AreaCenter_Row]</l>
<l>    LengthVector := VTDataVector.length()</l>
<l>    VTDataVector.at(LengthVector) := TupleToAddToVector</l>
<c>    * </c>
<l>    TupleToAddToVector := ['GoodRefereence_AreaCenter_Column',GoodRefereence_AreaCenter_Column]</l>
<l>    LengthVector := VTDataVector.length()</l>
<l>    VTDataVector.at(LengthVector) := TupleToAddToVector</l>
<c>    * </c>
<c>    * </c>
<l>    Print_VIRegions.at(0) := ColourTeachIn_InnerProductRegion</l>
<l>    Print_VIRegions.at(1) := PrintSegmented</l>
<c>    * </c>
<l>    if (TeachInMode = 1)</l>
<l>        gen_empty_obj (ToCheckForSmearedPrint)</l>
<l>    else</l>
<l>        smallest_rectangle1 (ColourTeachIn_InnerProductRegion, Row1, Column1, Row2, Column2)</l>
<l>        gen_rectangle1 (ToCheckForSmearedPrint, Row1-CheckForAdditionalPrintVertical, Column1- CheckForAdditionalPrintHorizontal, Row2+ CheckForAdditionalPrintVertical, Column2+ CheckForAdditionalPrintHorizontal)</l>
<l>        gen_circle (CircleToAdd, (Row2-Row1)/2 + Row1, Column1-CheckForAdditionalPrintHorizontal, (Row2-Row1)/2 + CheckForAdditionalPrintVertical)</l>
<l>        union2 (ToCheckForSmearedPrint, CircleToAdd, ToCheckForSmearedPrint)</l>
<l>        gen_circle (CircleToAdd, (Row2-Row1)/2 + Row1, Column2+CheckForAdditionalPrintHorizontal, (Row2-Row1)/2 + CheckForAdditionalPrintVertical)</l>
<l>        union2 (ToCheckForSmearedPrint, CircleToAdd, ToCheckForSmearedPrint)</l>
<l>    endif</l>
<l>    Print_VIRegions.at(2) := ToCheckForSmearedPrint</l>
<l>else</l>
<c>    * </c>
<l>endif</l>
<c>* </c>
<c>* </c>
<l>return ()</l>
</body>
<docu id="gLoadData_PrintInspection">
<chapters lang="de_DE">
<item>Load_Data</item>
</chapters>
<short lang="de_DE">Load from Inifile Camera, Image and IO PArameter</short>
<parameters>
<parameter id="FileElementNumber"/>
<parameter id="Print_VIRegions"/>
<parameter id="TeachInMode"/>
<parameter id="VTDataVector"/>
<parameter id="VTFiledefinitions"/>
<parameter id="VTPathdefinitions"/>
</parameters>
</docu>
</procedure>
<procedure name="gLoadData_ProductImage">
<interface>
<oo>
<par name="ImageOrig" base_type="iconic" dimension="0"/>
</oo>
<ic>
<par name="VTFiledefinitions" base_type="ctrl" dimension="1"/>
<par name="VTCamera" base_type="ctrl" dimension="1"/>
</ic>
</interface>
<body>
<c>* get some variables</c>
<l>gGetSubObjectVariables (VTFiledefinitions, 'ProductImage Current Format', VTempVariable)</l>
<l>FilenameProductimage := VTempVariable.at(0)[1]</l>
<c>* </c>
<c>* first try to load an productimage that holds multiple channels (SiSo can have 5 channels)</c>
<l>dev_error_var (Error, 1)</l>
<l>dev_set_check ('~give_error')</l>
<l>read_image (ImageOrig, (FilenameProductimage+ 'AllChannels'))</l>
<l>ReadError := Error</l>
<l>if (ReadError != H_MSG_TRUE) // try to load normal product image</l>
<l>    dev_error_var (Error, 1)</l>
<l>    dev_set_check ('~give_error')</l>
<l>    read_image (ImageOrig, FilenameProductimage)</l>
<l>    ReadError := Error</l>
<l>    dev_set_check ('give_error')</l>
<l>endif</l>
<c></c>
<c>*** Janine - Update Achema</c>
<c>* Reste showing of exceptions to make debugging better</c>
<l>dev_set_check ('give_error')</l>
<c>*** End Janine</c>
<c></c>
<c></c>
<l>if (ReadError != H_MSG_TRUE)</l>
<l>    gGetSubObjectVariables (VTCamera, 'V_ImageGrabResolution_Width', VTempVariable)</l>
<l>    ImageGrabResolution_Width := VTempVariable.at(0)[1]</l>
<l>    gGetSubObjectVariables (VTCamera, 'V_ImageGrabResolution_Height', VTempVariable)</l>
<l>    ImageGrabResolution_Height := VTempVariable.at(0)[1]</l>
<c>    * in case there is a camera rotation rotate the empty image as well, otherwise visu will be wrong</c>
<l>    gGetSubObjectVariables (VTCamera, '/V_ImageRotation/Value', TempCameraRotationTpl)</l>
<l>    CameraRotation := TempCameraRotationTpl.at(0)[1]</l>
<l>    if (CameraRotation = '90' or CameraRotation = '270')</l>
<l>        Temp1 := ImageGrabResolution_Width</l>
<l>        Temp2 := ImageGrabResolution_Height</l>
<l>        ImageGrabResolution_Width := Temp2</l>
<l>        ImageGrabResolution_Height := Temp1</l>
<l>    endif</l>
<l>    gen_image_const (ImageOrig, 'byte', ImageGrabResolution_Width, ImageGrabResolution_Height)</l>
<l>endif</l>
<l>return ()</l>
</body>
<docu id="gLoadData_ProductImage">
<parameters>
<parameter id="ImageOrig"/>
<parameter id="VTCamera"/>
<parameter id="VTFiledefinitions"/>
</parameters>
</docu>
</procedure>
<procedure name="gLoadData_ROI">
<interface>
<oo>
<par name="RinnenROIs_Vector" base_type="iconic" dimension="1"/>
<par name="EjectROIs_Vector" base_type="iconic" dimension="1"/>
</oo>
<ic>
<par name="VTFiledefinitions" base_type="ctrl" dimension="1"/>
<par name="VTCamera" base_type="ctrl" dimension="1"/>
<par name="FileElementNumber" base_type="ctrl" dimension="0"/>
<par name="ROIOffset" base_type="ctrl" dimension="0"/>
</ic>
<oc>
<par name="ROI_NumberOfPos" base_type="ctrl" dimension="0"/>
</oc>
</interface>
<body>
<l>set_system ('clip_region', 'false')</l>
<c>* </c>
<l>gGetSubObjectVariables_SingleValue (VTCamera, '/V_Camera_NumberOfConnectedCameras/Value', NumberOfConnectedCameras)</l>
<c></c>
<c>* init output</c>
<l>gen_empty_obj (EmptyObject)</l>
<l>RinnenROIs_Vector.at(0) := EmptyObject</l>
<l>EjectROIs_Vector.at(0) := EmptyObject</l>
<l>ROI_NumberOfPos := []</l>
<c>* </c>
<c>* Read JSON-File</c>
<l>FilenameToLoad := VTFiledefinitions.at(FileElementNumber)[1]</l>
<l>gJSON_Read_File_to_Vector (FilenameToLoad, ParameterVector)</l>
<c>* </c>
<l>for Index_ROICams := 0 to NumberOfConnectedCameras-1 by 1</l>
<l>    gJSON_Get_Value_from_Vector ('/ROIs/ROI_Cam_' + Index_ROICams + '/V_Inspection_OffsetTop_UpperROIPosition/Value', ParameterVector, ROI_OffsetImageTop_UpperROIPosition)</l>
<l>    gJSON_Get_Value_from_Vector ('/ROIs/ROI_Cam_' + Index_ROICams + '/V_Inspection_OffsetTop_LowerROIPosition/Value', ParameterVector, ROI_OffsetImageTop_LowerROIPosition)</l>
<l>    gJSON_Get_Value_from_Vector ('/ROIs/ROI_Cam_' + Index_ROICams + '/V_Inspection_OffsetLeft/Value', ParameterVector, ROI_OffsetX)</l>
<l>    gJSON_Get_Value_from_Vector ('/ROIs/ROI_Cam_' + Index_ROICams + '/V_Inspection_Width/Value', ParameterVector, ROI_Width)</l>
<l>    gJSON_Get_Value_from_Vector ('/ROIs/ROI_Cam_' + Index_ROICams + '/V_Eject_OffsetTop/Value', ParameterVector, ROIEject_OffsetImageTop)</l>
<l>    gJSON_Get_Value_from_Vector ('/ROIs/ROI_Cam_' + Index_ROICams + '/V_Eject_Length/Value', ParameterVector, ROIEject_Length)</l>
<l>    gJSON_Get_Value_from_Vector ('/ROIs/ROI_Cam_' + Index_ROICams + '/V_Eject_Width/Value', ParameterVector, ROIEject_Width)</l>
<c>    * load roi middle position values based on column</c>
<l>    gJSON_Get_Value_from_Vector ('/ROIs/ROI_Cam_' + Index_ROICams + '/V_NumberOfPos/Value', ParameterVector, ROI_NumberOfPos_Read)</l>
<l>    ROI_NumberOfPos := [ROI_NumberOfPos,ROI_NumberOfPos_Read]</l>
<l>    ROI_StartColumnsTpl := []</l>
<l>    for Index_ROINumberPos := 0 to ROI_NumberOfPos[Index_ROICams]-1 by 1</l>
<l>        gJSON_Get_Value_from_Vector ('/ROIs/ROI_Cam_' + Index_ROICams + '/V_Pos_Column_' + Index_ROINumberPos + '/Value', ParameterVector, ROI_StartColumnTemp)</l>
<l>        tuple_concat (ROI_StartColumnsTpl, ROI_StartColumnTemp, ROI_StartColumnsTpl)</l>
<l>    endfor</l>
<l>    gSetupROIs (RinnenROIs, EjectROIs, ROI_StartColumnsTpl, ROI_OffsetImageTop_UpperROIPosition, ROI_OffsetImageTop_LowerROIPosition, ROI_OffsetX, ROI_Width, ROIEject_OffsetImageTop + ROIOffset, ROIEject_Length - ROIOffset, ROIEject_Width)</l>
<l>    RinnenROIs_Vector.at(Index_ROICams) := RinnenROIs</l>
<l>    EjectROIs_Vector.at(Index_ROICams) := EjectROIs</l>
<l>endfor</l>
<c>* </c>
<l>set_system ('clip_region', 'true')</l>
<c>* </c>
<l>return ()</l>
</body>
<docu id="gLoadData_ROI">
<chapters lang="de_DE">
<item>Load_Data</item>
</chapters>
<short lang="de_DE">Load from Inifile Camera, Image and IO PArameter</short>
<parameters>
<parameter id="EjectROIs_Vector"/>
<parameter id="FileElementNumber"/>
<parameter id="ROIOffset"/>
<parameter id="ROI_NumberOfPos"/>
<parameter id="RinnenROIs_Vector"/>
<parameter id="VTCamera"/>
<parameter id="VTFiledefinitions"/>
</parameters>
</docu>
</procedure>
<procedure name="gLoadData_Shiftregister">
<interface>
<ic>
<par name="VTFiledefinitions" base_type="ctrl" dimension="1"/>
<par name="FileElementNumber" base_type="ctrl" dimension="0"/>
</ic>
<oc>
<par name="VTDataVector" base_type="ctrl" dimension="1"/>
</oc>
</interface>
<body>
<l>VTDataVector.at(0) := []</l>
<c>* Read JSON-File</c>
<l>FilenameToLoad := VTFiledefinitions.at(FileElementNumber)[1]</l>
<l>gJSON_Read_File_to_Vector (FilenameToLoad, ParameterVector)</l>
<c>* </c>
<l>Prefix_StaticWhileLoading := '/MovementCompensation/'</l>
<l>IteratingWhileLoading := ['V_Active','V_UpperMax','V_LowerMax','V_SpeedMax']</l>
<l>Suffix_StaticWhileLoading := '/Value'</l>
<l>gJSON_LoadValuesFromArrayLike (ParameterVector, VTDataVector, Prefix_StaticWhileLoading, Suffix_StaticWhileLoading, IteratingWhileLoading, VTDataVector)</l>
<c>* </c>
<l>Prefix_StaticWhileLoading := '/'</l>
<l>IteratingWhileLoading := ['V_Eject_FixedEjectPosition_RelativeToROI','V_Eject_FixedStopPositionForFastProducts_RelativeToROI','V_NumberOfColourErrorsForEjectMin','V_NumberOfErrorsForEjectMin', 'V_SaveMeasureFeatureValuesAtRuntime', 'V_SaveMeasureFeatureRegionsAtRuntime', 'V_SaveMeasureFeaturePartImagesAtRuntime','V_CheckForGoodProductDetectionActive','V_ObjectsPerTrack_LimitMax','V_ObjectMovement_MinSpeedToRegisterObjects', 'V_ProductOverspeed_DetectionThresholdToStop', 'V_ProductOverspeed_CalculationCyclesToMeasureMeanSpeed']</l>
<l>Suffix_StaticWhileLoading := '/Value'</l>
<l>gJSON_LoadValuesFromArrayLike (ParameterVector, VTDataVector, Prefix_StaticWhileLoading, Suffix_StaticWhileLoading, IteratingWhileLoading, VTDataVector)</l>
<c>* </c>
<l>return ()</l>
</body>
<docu id="gLoadData_Shiftregister">
<chapters lang="de_DE">
<item>Load_Data</item>
</chapters>
<short lang="de_DE">Load from Inifile Camera, Image and IO PArameter</short>
<parameters>
<parameter id="FileElementNumber"/>
<parameter id="VTDataVector"/>
<parameter id="VTFiledefinitions"/>
</parameters>
</docu>
</procedure>
<procedure name="gLoadData_TabletInspection">
<interface>
<ic>
<par name="VTFiledefinitions" base_type="ctrl" dimension="1"/>
<par name="FileElementNumber" base_type="ctrl" dimension="0"/>
</ic>
<oc>
<par name="VTDataVector" base_type="ctrl" dimension="1"/>
</oc>
</interface>
<body>
<c>*</c>
<c>* Load the tablet_inspection.json Parameters and store them in a Vector (later referenced as VTTabletInspection)</c>
<c>*</c>
<l>VTDataVector.at(0) := []</l>
<c>* Read JSON-File</c>
<l>FilenameToLoad := VTFiledefinitions.at(FileElementNumber)[1]</l>
<l>gJSON_Read_File_to_Vector (FilenameToLoad, ParameterVector)</l>
<c>* </c>
<c>* minimal loading function for general</c>
<l>Prefix_StaticWhileLoading := '/General/'</l>
<l>IteratingWhileLoading := ['V_Inspection_360Machine_Active']</l>
<l>IteratingWhileLoading := [IteratingWhileLoading,'--------- for future use','--------- for future use','--------- for future use','--------- for future use']</l>
<l>Suffix_StaticWhileLoading := '/Value'</l>
<l>gJSON_LoadValuesFromArrayLike (ParameterVector, VTDataVector, Prefix_StaticWhileLoading, Suffix_StaticWhileLoading, IteratingWhileLoading, VTDataVector)</l>
<c>* </c>
<c>* </c>
<c>* minimal loading function for teachin</c>
<l>Prefix_StaticWhileLoading := '/TeachIn/'</l>
<l>IteratingWhileLoading := ['V_ProductLength_InMovementDirection','V_ColourLearning_Tolerance','V_ColourLearning_MaxIterations','V_ColourLearning_NumHidden','V_ColourLearning_MedianTrainImage_FilterSize']</l>
<l>IteratingWhileLoading := [IteratingWhileLoading, 'V_IgnoreObjectsInEjectboxesForTeachIn','--------- for future use']</l>
<l>Suffix_StaticWhileLoading := '/Value'</l>
<l>gJSON_LoadValuesFromArrayLike (ParameterVector, VTDataVector, Prefix_StaticWhileLoading, Suffix_StaticWhileLoading, IteratingWhileLoading, VTDataVector)</l>
<c>* </c>
<c>* minimal loading function for segmentation</c>
<l>Prefix_StaticWhileLoading := '/Segmentation/'</l>
<l>IteratingWhileLoading := ['V_SegmentationThreshold','V_AreaClassification_ColourOrMonochrome','V_PreprocessingOpeningWidth', 'V_PreprocessingOpeningHeight', 'V_PreprocessingMinAreaFilter','V_ProductSplittingMode', 'V_ProductSplittingMode1_SeperationThreshold']</l>
<l>IteratingWhileLoading := [IteratingWhileLoading, 'V_Segmentation_ColourSupport_Active','V_Segmentation_ColourSupport_Threshold_Min','V_Segmentation_ColourSupport_Threshold_Max', 'V_Segmentation_ColourSupport_OpeningAfterSegmentation_MaskSize', 'V_Segmentation_ColourSupport_AreaToSelect_MinSize', 'V_Segmentation_ColourSupport_Threshold_RedMin', 'V_Segmentation_ColourSupport_Threshold_RedMax', 'V_Segmentation_ColourSupport_Threshold_GreenMin', 'V_Segmentation_ColourSupport_Threshold_GreenMax', 'V_Segmentation_ColourSupport_Threshold_BlueMin' , 'V_Segmentation_ColourSupport_Threshold_BlueMax']</l>
<l>IteratingWhileLoading := [IteratingWhileLoading, 'V_Segmentation_SmallestSingleObjectFilter_Area_Min', 'V_Segmentation_DarkOnBright0_BrightOnDark1', 'V_Segmentation_DynThreshold_Active']</l>
<l>IteratingWhileLoading := [IteratingWhileLoading, 'V_Segmentation_SelectSegmentationImage_BottomLight0_TopLight1_UVLight2', '--------- for future use','--------- for future use', '--------- for future use','--------- for future use']</l>
<l>Suffix_StaticWhileLoading := '/Value'</l>
<c>* </c>
<l>gJSON_LoadValuesFromArrayLike (ParameterVector, VTDataVector, Prefix_StaticWhileLoading, Suffix_StaticWhileLoading, IteratingWhileLoading, VTDataVector)</l>
<c>* </c>
<c>* minimal loading function for measurement feature</c>
<c>* </c>
<l>Prefix_StaticWhileLoading := '/Measure_ProductLength/'</l>
<l>IteratingWhileLoading := ['V_FeatureActive','V_Length_Min','V_Length_Max','V_NumberOfDetectionsLeadToEject', 'V_CriticalDefectActive','--------- for future use']</l>
<l>Suffix_StaticWhileLoading := '/Value'</l>
<l>gJSON_LoadValuesFromArrayLike (ParameterVector, VTDataVector, Prefix_StaticWhileLoading, Suffix_StaticWhileLoading, IteratingWhileLoading, VTDataVector)</l>
<c>* </c>
<l>Prefix_StaticWhileLoading := '/Measure_ProductWidth/'</l>
<l>IteratingWhileLoading := ['V_FeatureActive','V_Width_Min','V_Width_Max','V_NumberOfDetectionsLeadToEject', 'V_CriticalDefectActive','--------- for future use']</l>
<l>Suffix_StaticWhileLoading := '/Value'</l>
<l>gJSON_LoadValuesFromArrayLike (ParameterVector, VTDataVector, Prefix_StaticWhileLoading, Suffix_StaticWhileLoading, IteratingWhileLoading, VTDataVector)</l>
<c>*</c>
<l>Prefix_StaticWhileLoading := '/Measure_ProductDiameter/'</l>
<l>IteratingWhileLoading := ['V_FeatureActive','V_Diameter_Min','V_Diameter_Max','V_NumberOfDetectionsLeadToEject', 'V_CriticalDefectActive','--------- for future use']</l>
<l>Suffix_StaticWhileLoading := '/Value'</l>
<l>gJSON_LoadValuesFromArrayLike (ParameterVector, VTDataVector, Prefix_StaticWhileLoading, Suffix_StaticWhileLoading, IteratingWhileLoading, VTDataVector)</l>
<c>* </c>
<l>Prefix_StaticWhileLoading := '/Measure_ProductArea/'</l>
<l>IteratingWhileLoading := ['V_FeatureActive','V_Area_Min','V_Area_Max','V_NumberOfDetectionsLeadToEject', 'V_CriticalDefectActive','--------- for future use']</l>
<l>Suffix_StaticWhileLoading := '/Value'</l>
<l>gJSON_LoadValuesFromArrayLike (ParameterVector, VTDataVector, Prefix_StaticWhileLoading, Suffix_StaticWhileLoading, IteratingWhileLoading, VTDataVector)</l>
<c>* </c>
<l>Prefix_StaticWhileLoading := '/Measure_ProductColour1/'</l>
<l>IteratingWhileLoading := ['V_FeatureActive','V_Colour1_Min','V_Colour1_Max','V_NumberOfDetectionsLeadToEject', 'V_CriticalDefectActive','--------- for future use']</l>
<l>Suffix_StaticWhileLoading := '/Value'</l>
<l>gJSON_LoadValuesFromArrayLike (ParameterVector, VTDataVector, Prefix_StaticWhileLoading, Suffix_StaticWhileLoading, IteratingWhileLoading, VTDataVector)</l>
<c>* </c>
<l>Prefix_StaticWhileLoading := '/Measure_ProductColour2/'</l>
<l>IteratingWhileLoading := ['V_FeatureActive','V_Colour2_Min','V_Colour2_Max','V_NumberOfDetectionsLeadToEject', 'V_CriticalDefectActive','--------- for future use']</l>
<l>Suffix_StaticWhileLoading := '/Value'</l>
<l>gJSON_LoadValuesFromArrayLike (ParameterVector, VTDataVector, Prefix_StaticWhileLoading, Suffix_StaticWhileLoading, IteratingWhileLoading, VTDataVector)</l>
<c>* </c>
<l>Prefix_StaticWhileLoading := '/Measure_ProductColour3/'</l>
<l>IteratingWhileLoading := ['V_FeatureActive','V_Colour3_Min','V_Colour3_Max','V_NumberOfDetectionsLeadToEject', 'V_CriticalDefectActive','--------- for future use']</l>
<l>Suffix_StaticWhileLoading := '/Value'</l>
<l>gJSON_LoadValuesFromArrayLike (ParameterVector, VTDataVector, Prefix_StaticWhileLoading, Suffix_StaticWhileLoading, IteratingWhileLoading, VTDataVector)</l>
<c>* Spot</c>
<l>Prefix_StaticWhileLoading := '/Measure_ProductSpot/'</l>
<l>IteratingWhileLoading := ['V_FeatureActive','V_ErosionFilterCircleOnDetection','V_Spot_Max','V_MirrorRemoveActive','V_DetectionOffsetFromProductSide_Horizontal', 'V_ErosionFilterSegmentedProductOuterHull', '--------- for future use', 'V_NumberOfDetectionsLeadToEject', 'V_CriticalDefectActive','--------- for future use']</l>
<l>Suffix_StaticWhileLoading := '/Value'</l>
<l>gJSON_LoadValuesFromArrayLike (ParameterVector, VTDataVector, Prefix_StaticWhileLoading, Suffix_StaticWhileLoading, IteratingWhileLoading, VTDataVector)</l>
<c>* </c>
<l>Prefix_StaticWhileLoading := '/Measure_ProductSymmetry/'</l>
<l>IteratingWhileLoading := ['V_FeatureActive','V_SymmetryMinArea','V_SymmetryMaxArea','V_NumberOfDetectionsLeadToEject', 'V_CriticalDefectActive','--------- for future use']</l>
<l>Suffix_StaticWhileLoading := '/Value'</l>
<l>gJSON_LoadValuesFromArrayLike (ParameterVector, VTDataVector, Prefix_StaticWhileLoading, Suffix_StaticWhileLoading, IteratingWhileLoading, VTDataVector)</l>
<c>* </c>
<l>Prefix_StaticWhileLoading := '/Measure_ProductPrint/'</l>
<l>IteratingWhileLoading := ['V_FeatureActive','V_PrintSegmentColorHueMin','V_PrintSegmentColorHueMax','V_PrintSegmentColorSaturationMin',\
                          'V_PrintSegmentColorSaturationMax','V_PrintMinArea','V_PrintMaxArea','V_NumberOfDetectionsLeadToEject', 'V_CriticalDefectActive','--------- for future use',\
                          'V_Print_Segmentation_MinAreaFilter','V_Print_Segmentation_Morphology_ErosionNegative_DilationPositive', 'V_Print_Segmentation_Dyn0Classification1', \
                          'V_Print_Segmentation_SkeletonActive', 'V_Print_Segmentation_DynThreshold_ContrastOffset']</l>
<l>Suffix_StaticWhileLoading := '/Value'</l>
<l>gJSON_LoadValuesFromArrayLike (ParameterVector, VTDataVector, Prefix_StaticWhileLoading, Suffix_StaticWhileLoading, IteratingWhileLoading, VTDataVector)</l>
<c>* </c>
<l>Prefix_StaticWhileLoading := '/Backgroundcheck/'</l>
<l>IteratingWhileLoading := ['V_FeatureActive','V_Segmentation_HueMin','V_Segmentation_HueMax', 'V_Segmentation_SaturationMin', 'V_Segmentation_SaturationMax']</l>
<l>Suffix_StaticWhileLoading := '/Value'</l>
<l>gJSON_LoadValuesFromArrayLike (ParameterVector, VTDataVector, Prefix_StaticWhileLoading, Suffix_StaticWhileLoading, IteratingWhileLoading, VTDataVector)</l>
<c>* </c>
<c>* </c>
<l>Prefix_StaticWhileLoading := '/CounterCheckControl/'</l>
<l>IteratingWhileLoading := ['V_TabletsInEjectPosition_ErosionCircle']</l>
<l>Suffix_StaticWhileLoading := '/Value'</l>
<l>gJSON_LoadValuesFromArrayLike (ParameterVector, VTDataVector, Prefix_StaticWhileLoading, Suffix_StaticWhileLoading, IteratingWhileLoading, VTDataVector)</l>
<c>*</c>
<c>*** PRV_CS: Load tablet_inspection file &gt;</c>
<l>Prefix_StaticWhileLoading := '/Measure_ProductPRV/'</l>
<l>IteratingWhileLoading := ['V_FeatureActive','V_PRV_RegionErosion','V_PRV_VarThresh_MaskWidth','V_PRV_VarThresh_MaskHeight','V_PRV_VarThresh_StdDevScale','V_PRV_VarThresh_AbsThreshold','V_PRV_VarThresh_LightDark',\
                          'V_PRV_OpeningRect_Width','V_PRV_OpeningRect_Height','V_PRV_DilationRect_Width','V_PRV_DilationRect_Height','V_PRV_ErosionRect_Width','V_PRV_ErosionRect_Height',\
                          'V_PRV_LineAreaFilterMin','V_PRV_LineAngleMax','V_PRV_LineLengthFactorMin','V_NumberOfDetectionsLeadToEject','V_CriticalDefectActive',\
                          '--------- for future use','--------- for future use']</l>
<l>Suffix_StaticWhileLoading := '/Value'</l>
<l>gJSON_LoadValuesFromArrayLike (ParameterVector, VTDataVector, Prefix_StaticWhileLoading, Suffix_StaticWhileLoading, IteratingWhileLoading, VTDataVector)</l>
<c>*** PRV_CS &lt;</c>
<c>*</c>
<c>*** PCC_CS: Load tablet_inspection file &gt;</c>
<l>Prefix_StaticWhileLoading := '/Measure_ProductPCC/'</l>
<l>IteratingWhileLoading := ['V_FeatureActive','V_PCC_RectFactor_Width','V_PCC_RectFactor_Height','--------- for future use','--------- for future use',\
                          '--------- for future use','--------- for future use','--------- for future use','--------- for future use','--------- for future use','--------- for future use',\
                          'V_PCC_ErosionRect_Width','V_PCC_ErosionRect_Height','V_NumberOfDetectionsLeadToEject','V_CriticalDefectActive',\
                          'V_PCC_Min','V_PCC_Max']</l>
<l>Suffix_StaticWhileLoading := '/Value'</l>
<l>gJSON_LoadValuesFromArrayLike (ParameterVector, VTDataVector, Prefix_StaticWhileLoading, Suffix_StaticWhileLoading, IteratingWhileLoading, VTDataVector)</l>
<c>*** PCC_CS &lt;</c>
<c></c>
<c>****************************************************</c>
<c>* hier Daten für neues Feature lesen - LS 5.2.25</c>
<c>* ToDo es wäre wahrscheinlich sinnvoller, wenn es ProductUpperWidth statt UpperProductWidth heißen würde - LS</c>
<l>Prefix_StaticWhileLoading := '/Measure_UpperProductWidth/'</l>
<l>IteratingWhileLoading := ['V_FeatureActive','V_UpperWidth_Min','V_UpperWidth_Max','V_NumberOfDetectionsLeadToEject', 'V_CriticalDefectActive','--------- for future use']</l>
<l>Suffix_StaticWhileLoading := '/Value'</l>
<l>gJSON_LoadValuesFromArrayLike (ParameterVector, VTDataVector, Prefix_StaticWhileLoading, Suffix_StaticWhileLoading, IteratingWhileLoading, VTDataVector)</l>
<c></c>
<c>* lower width 9.4.25</c>
<l>Prefix_StaticWhileLoading := '/Measure_LowerProductWidth/'</l>
<l>IteratingWhileLoading := ['V_FeatureActive','V_LowerWidth_Min','V_LowerWidth_Max','V_NumberOfDetectionsLeadToEject', 'V_CriticalDefectActive','--------- for future use']</l>
<l>Suffix_StaticWhileLoading := '/Value'</l>
<l>gJSON_LoadValuesFromArrayLike (ParameterVector, VTDataVector, Prefix_StaticWhileLoading, Suffix_StaticWhileLoading, IteratingWhileLoading, VTDataVector)</l>
<c></c>
<c></c>
<c>****************************************************</c>
<c></c>
<l>return ()</l>
</body>
<docu id="gLoadData_TabletInspection">
<chapters lang="de_DE">
<item>Load_Data</item>
</chapters>
<short lang="de_DE">Load from Inifile Camera, Image and IO PArameter</short>
<parameters>
<parameter id="FileElementNumber"/>
<parameter id="VTDataVector"/>
<parameter id="VTFiledefinitions"/>
</parameters>
</docu>
</procedure>
<procedure name="gLoadData_Threadmanagement">
<interface>
<ic>
<par name="NumberOfProcessingThreadsPerCamera" base_type="ctrl" dimension="0"/>
<par name="ROI_NumberOfPos" base_type="ctrl" dimension="0"/>
<par name="LocalCameraNumberUsed" base_type="ctrl" dimension="0"/>
</ic>
<oc>
<par name="LanesPerThreadsVector" base_type="ctrl" dimension="1"/>
</oc>
</interface>
<body>
<l>global tuple gDebuglevel</l>
<l>global tuple gThread_Middle_Active</l>
<l>global tuple gThread_PostGrab_Active</l>
<l>global tuple gThread_RGB_Threshold_Active</l>
<l>global tuple gThread_ImageRotation_Active</l>
<l>* global tuple gThread_Processing_Step0_Active</l>
<l>* global tuple gThread_Processing_Step1_Active </l>
<l>global tuple gDebuglevel</l>
<c></c>
<l>ThreadingActive := 0</l>
<l>if (gDebuglevel = 1 or gDebuglevel = 2)</l>
<l>    ThreadingActive := 0</l>
<l>else</l>
<l>    ThreadingActive := 1</l>
<l>endif</l>
<c></c>
<c> </c>
<l>if (ThreadingActive = 0)</l>
<l>    gThread_ImageRotation_Active := 0</l>
<l>    gThread_PostGrab_Active := 0</l>
<l>    gThread_RGB_Threshold_Active := 0</l>
<l>    gThread_Middle_Active := 0</l>
<l>*     gThread_Processing_Step0_Active := 0</l>
<l>*     gThread_Processing_Step1_Active := 0  </l>
<l>else</l>
<l>    gThread_ImageRotation_Active := 0</l>
<l>    gThread_PostGrab_Active := 0</l>
<l>    gThread_RGB_Threshold_Active := 1</l>
<l>    gThread_Middle_Active := 1</l>
<l>*     gThread_Processing_Step0_Active := 1</l>
<l>*     gThread_Processing_Step1_Active := 1  </l>
<l>endif</l>
<c></c>
<c></c>
<l>* tuple_gen_sequence (1, ROI_NumberOfPos, 1, Sequence)</l>
<l>tuple_gen_sequence (1, ROI_NumberOfPos[LocalCameraNumberUsed], 1, Sequence)</l>
<c> </c>
<l>LanesPerThreadsVector := {Sequence}</l>
<c></c>
<c>* ToDo - automatically try to set up Lanes per threads. Needed if number of lines is # 1 and # 6</c>
<c></c>
<l>if (gDebuglevel = 0) // on debug initialisation values are used, also as default</l>
<l>    switch (NumberOfProcessingThreadsPerCamera)</l>
<l>    case 1:</l>
<l>        break // done with initialisation</l>
<l>    case 2:</l>
<l>        LanesPerThreadsVector := {[1,2,3],[4,5,6]}</l>
<l>        break</l>
<l>    case 3: </l>
<l>        LanesPerThreadsVector := {[1,2],[3,4],[5,6]}</l>
<l>        break</l>
<l>    case 4:</l>
<l>        LanesPerThreadsVector := {[1,2],[3,4],[5],[6]}</l>
<l>        break</l>
<l>    case 5:</l>
<l>        LanesPerThreadsVector := {[1,2],[3],[4],[5],[6]}</l>
<l>        break</l>
<l>    case 6:</l>
<l>        LanesPerThreadsVector := {[1],[2],[3],[4],[5],[6]}</l>
<l>        break</l>
<l>    endswitch</l>
<l>endif</l>
<c>* ToDo: correct the LanesPerThreadsVector in relation to available ROI's</c>
<l>VectorLength := LanesPerThreadsVector.length()</l>
<l>for Index_Vect := VectorLength-1 to 0 by -1 // negative count is used so vector order is consistant while removing elements from it</l>
<l>    VectorPart := LanesPerThreadsVector.at(Index_Vect)</l>
<l>*     tuple_greater_elem (VectorPart, ROI_NumberOfPos[LocalCameraNumberUsed], Greatereq)</l>
<l>    tuple_greater_elem (VectorPart, ROI_NumberOfPos[LocalCameraNumberUsed], Greatereq)</l>
<l>    tuple_find (Greatereq, 1, Indices_OutOfRange)</l>
<l>    tuple_remove (VectorPart, Indices_OutOfRange, VectorPart_ROICount_Corrected)</l>
<l>    if( VectorPart_ROICount_Corrected # [])</l>
<l>        LanesPerThreadsVector.at(Index_Vect) := VectorPart_ROICount_Corrected</l>
<l>    else</l>
<l>        LanesPerThreadsVector.remove(Index_Vect)</l>
<l>    endif</l>
<l>endfor</l>
<c></c>
<c></c>
<l>return ()</l>
</body>
<docu id="gLoadData_Threadmanagement">
<parameters>
<parameter id="LanesPerThreadsVector"/>
<parameter id="LocalCameraNumberUsed"/>
<parameter id="NumberOfProcessingThreadsPerCamera"/>
<parameter id="ROI_NumberOfPos"/>
</parameters>
</docu>
</procedure>
<procedure name="gLoadData_WindowPositioning">
<interface>
<ic>
<par name="VTFiledefinitions" base_type="ctrl" dimension="1"/>
<par name="FileElementNumber" base_type="ctrl" dimension="0"/>
<par name="NumberOfConnectedCameras" base_type="ctrl" dimension="0"/>
<par name="TeachInMode" base_type="ctrl" dimension="0"/>
</ic>
<oc>
<par name="VTDataVector" base_type="ctrl" dimension="1"/>
</oc>
</interface>
<body>
<l>NumberOFConnectedCamerasValue := NumberOfConnectedCameras[1]</l>
<c>* </c>
<l>VTDataVector.at(0) := []</l>
<c>* </c>
<l>if (TeachInMode # 1)</l>
<c>    * Read JSON-File</c>
<l>    FilenameToLoad := VTFiledefinitions.at(FileElementNumber)[1]</l>
<l>    gJSON_Read_File_to_Vector (FilenameToLoad, ParameterVector)</l>
<c>    * </c>
<c>    * </c>
<l>    for IndexWindow := 0 to NumberOFConnectedCamerasValue-1 by 1</l>
<c>        * minimal loading function for teachin</c>
<l>        Prefix_StaticWhileLoading := '/Windows/Window_' +IndexWindow + '/'</l>
<l>        IteratingWhileLoading := ['Width','Height','X_Offset','Y_Offset']</l>
<l>        Suffix_StaticWhileLoading := '/Value'</l>
<l>        gJSON_LoadValuesFromArrayLike (ParameterVector, VTDataVector, Prefix_StaticWhileLoading, Suffix_StaticWhileLoading, IteratingWhileLoading, VTDataVector)</l>
<l>    endfor</l>
<l>endif</l>
<c>* </c>
<l>if( VTDataVector = {}) // filename windownpoisitioning is missing</l>
<l>    Errortext := 'VTDataVector is empty. Windowpositioning.json is missing? ' + FilenameToLoad</l>
<l>    Exception := [5200, 21000, Errortext , 'HALCON-Operatorfehler', 20, 'read_file', 1, 'gLoadData_WindowPositioning']</l>
<l>    throw (Exception)</l>
<l>endif</l>
<c>* </c>
<l>return ()</l>
</body>
<docu id="gLoadData_WindowPositioning">
<chapters lang="de_DE">
<item>Load_Data</item>
</chapters>
<parameters>
<parameter id="FileElementNumber"/>
<parameter id="NumberOfConnectedCameras"/>
<parameter id="TeachInMode"/>
<parameter id="VTDataVector"/>
<parameter id="VTFiledefinitions"/>
</parameters>
</docu>
</procedure>
<procedure name="gPLC_InitConnection">
<interface>
<ic>
<par name="VTPLC" base_type="ctrl" dimension="1"/>
<par name="VTCamera" base_type="ctrl" dimension="1"/>
<par name="CameraNumberToUse" base_type="ctrl" dimension="0"/>
<par name="PLC_NumberOfConnectionTrials" base_type="ctrl" dimension="0"/>
<par name="Is360InspectionActive" base_type="ctrl" dimension="0"/>
</ic>
<oc>
<par name="PLC_CommunicationSocket" base_type="ctrl" dimension="0"/>
<par name="PLC_AcceptingSocket" base_type="ctrl" dimension="0"/>
<par name="PLCWatchdogSignal" base_type="ctrl" dimension="0"/>
<par name="PLCAvailable" base_type="ctrl" dimension="0"/>
<par name="PLC_FailedToConnect" base_type="ctrl" dimension="0"/>
</oc>
</interface>
<body>
<c>* initialize outputs</c>
<l>PLC_CommunicationSocket := []</l>
<l>PLC_AcceptingSocket := []</l>
<l>PLCWatchdogSignal := 1</l>
<l>PLC_FailedToConnect := 1</l>
<c></c>
<l>PLC_ServerConnection := 0</l>
<c> </c>
<c>************</c>
<l>gGetSubObjectVariables_SingleValue (VTPLC, '/V_WorkOnPLCEnable/Value', PLCAvailable)</l>
<c>* get plc ip adress</c>
<l>gGetSubObjectVariables (VTCamera, '/Cameras/Camera_' + CameraNumberToUse + '/V_PLC/Value', V_PLC)</l>
<l>PLC_Used := V_PLC.at(0)[1]</l>
<c>* in case multiple plc´s are connected to one camera parse it out</c>
<l>tuple_split (PLC_Used, ',', PLC_Used)</l>
<c></c>
<l>PLC_IPAdress := []</l>
<l>PLC_PortToUse := []</l>
<l>PLC_AdressInfo := []</l>
<l>AcceptingSocket := []</l>
<l>Socket_CloseAgain_Temp := []</l>
<c> </c>
<l>for Index_PLC := 0 to |PLC_Used|-1 by 1 // get io´s and port´s ready for init</l>
<l>    if (PLCAvailable = 1 ) </l>
<l>        gGetSubObjectVariables (VTPLC, '/PLCs/' + PLC_Used[Index_PLC] + '/V_IP/Value', V_PLC_IPAdress)</l>
<l>        PLC_IPAdress := [PLC_IPAdress, V_PLC_IPAdress.at(0)[1]]</l>
<l>    endif </l>
<l>    gGetSubObjectVariables (VTCamera, '/Cameras/Camera_' + CameraNumberToUse + '/V_PLCRemotePort/Value', V_PLCRemotePort)</l>
<l>    PLC_PortToUse_temp := V_PLCRemotePort.at(0)[1]</l>
<l>    tuple_split (PLC_PortToUse_temp, ',', PLC_PortToUse_temp)</l>
<l>    PLC_PortToUse := [PLC_PortToUse, PLC_PortToUse_temp[Index_PLC]]</l>
<l>endfor</l>
<c>******************</c>
<c>* v 20190626</c>
<c>* this part checks if a port is already been used</c>
<c>* if so, the port + corresponding ip will be deleted </c>
<c>* to avoid double connecting resulting in timeout</c>
<l>* ThisIP := '192.168.188.90' // IP of this device</l>
<c>* calling command to get all tcp connections of this device</c>
<l>* system_call('netstat -ano -p tcp |find "192.168.188.90" &gt;' + 'C:/CountSecure/temp/ConnectionStatus.txt')</l>
<c>* * system_call('taskkill /pid PID /f')</c>
<l>* open_file ('C:/CountSecure/temp/ConnectionStatus.txt', 'input', FileHandle)</l>
<c>* End of file for txt parsing</c>
<l>* IsEOF := 0 </l>
<c>* Entries in .txt: 1.: Connection Protocol (TCP) | 2.: ThisIP:Port | 3.: DeviceIP:Port | 4.: Status | 5.: ProcessID</c>
<l>* while (IsEOF == 0)</l>
<l>*     fread_line (FileHandle, String, IsEOF)</l>
<l>*     if(String == '' or String == [])</l>
<l>*         break</l>
<l>*     endif</l>
<l>*     tuple_split(String, ' ', Substring)</l>
<l>*     tuple_regexp_select(Substring, ThisIP, Selection)</l>
<l>*     tuple_str_last_n (Selection, strstr(Selection, ':')+1, Port)</l>
<c>    * if port is equal to any port in usage</c>
<l>*     if(find(PLC_PortToUse, Port) != -1)</l>
<c>        * check only connected ports for status | could be redundant due to (mostly) listed established connections</c>
<l>*         if (Substring[3] == 'HERGESTELLT' or Substring [3] == 'ESTABLISHED')</l>
<c>             * skip connecting process for port</c>
<c>             * save Port, ThisIP and DeviceIP to ConnectionList for better overview</c>
<l>*              PortIdx := find(PLC_PortToUse, Port)</l>
<c>             * delete used ports or ips to avoid connecting to already connected port</c>
<c></c>
<l>*         endif</l>
<l>*     endif</l>
<l>* endwhile</l>
<l>* close_file ( FileHandle )</l>
<c>* only close ports if any port is not connected</c>
<l>* if (|PLC_PortToUse| != 0)</l>
<c>    * open file to write port to be open in (command)</c>
<l>*     open_file ('C:/CountSecure/reset_micro.bat', 'output', FileHandle)</l>
<l>*     for i := 0 to |PLC_PortToUse|-1 by 1</l>
<c>        * command from currports used to be executed in command shell as admin (IP Port ForeignIP ForeignPort)</c>
<l>*         fwrite_string(FileHandle, 'C:\\Users\\Vision\\Downloads\\cports-x64\\cports.exe /close * ' + PLC_PortToUse[i] + ' * *')</l>
<l>*         fnew_line(FileHandle)</l>
<l>*     endfor</l>
<l>*     close_file ( FileHandle )</l>
<l>*     system_call('start C:\\Windows\\System32\\schtasks.exe /run /tn "reset port"')</l>
<l>* endif</l>
<c>* ^ 20190626</c>
<c>******************</c>
<l>if (PLCAvailable = 1 ) // and |PLC_PortToUse| &gt; 0)</l>
<c>    * Init PLC communication</c>
<l>    tuple_number (PLC_PortToUse, PLC_PortToUse) // may have been string from json loading</l>
<c>    * for the number of connected plc´s init them</c>
<c></c>
<l>    for Index_PLCs := 0 to |PLC_IPAdress| -1 by 1</l>
<l>        AcceptingSocket_Established := 0</l>
<c>        * use same socket if port and ip are the same- no need to reestabish the connection</c>
<l>        if (Index_PLCs &gt; 0)</l>
<l>            if( PLC_PortToUse[Index_PLCs-1] = PLC_PortToUse[Index_PLCs] and PLC_IPAdress[Index_PLCs-1] = PLC_IPAdress[Index_PLCs])</l>
<l>                PLC_AcceptingSocket := [PLC_AcceptingSocket, PLC_AcceptingSocket[Index_PLCs-1]]</l>
<l>                PLC_CommunicationSocket := [PLC_CommunicationSocket, PLC_CommunicationSocket[Index_PLCs-1]]</l>
<l>                continue</l>
<l>            endif</l>
<l>        endif</l>
<c> </c>
<l>        for Index := 0 to PLC_NumberOfConnectionTrials by 1</l>
<l>            dev_error_var (Error, 1)</l>
<l>            dev_set_check ('~give_error')            </l>
<c>            * ■■■■■■■ Open Socket to µC - listen- or to plc - send ■■■■■■■ *</c>
<l>            if (Is360InspectionActive = 1  and PLC_ServerConnection = 1)//and gSiliconSoftwareGrabberActive = 0)</l>
<l>                Timeout := 2  // timeout of 1 sec is too little for some machines- will result in not correct socket connection established</l>
<l>                Protocol := 'TCP4'</l>
<l>                if(AcceptingSocket_Established = 0)</l>
<l>                    Port := PLC_PortToUse[Index_PLCs]</l>
<l>                    open_socket_accept (PLC_PortToUse[Index_PLCs], ['protocol','timeout'], [Protocol,Timeout], AcceptingSocket) </l>
<l>                    ReadError := Error </l>
<l>                    get_error_text (ReadError, ErrorMessage)</l>
<l>                    if (ReadError # 2)  // in case connection failed</l>
<l>                        continue</l>
<l>                    endif</l>
<l>                    AcceptingSocket_Established := 1</l>
<l>                endif</l>
<c>                *Port is fixed value in µC (micro controller)</c>
<l>                Socket_CloseAgain_Temp := []</l>
<l>                for Cnt_MaxAvailableMicroconrollersOnPort := 1 to 5 by 1</l>
<c>                    * Wait for an incoming connection, use the timeout of the AcceptingSocket</c>
<l>                    dev_error_var (Error, 1)</l>
<l>*                     OpenStatus := 5 // unused</l>
<l>*                     ConnectionRetries := 0 // unused</l>
<l>                    dev_set_check ('~give_error')                  </l>
<l>                    socket_accept_connect (AcceptingSocket, 'auto', SocketEstablished)</l>
<l>                    ReadError := Error</l>
<l>                    dev_set_check ('give_error')</l>
<l>                    get_error_text (ReadError, ErrorMessage)</l>
<l>*                     close_all_sockets()</l>
<l>*                     stop() </l>
<l>                    if (ReadError = 2)</l>
<l>*                         close_all_sockets()</l>
<c>                        * Set the same timeout on the newly created socket</c>
<l>                        set_socket_param (SocketEstablished, 'timeout', Timeout)</l>
<l>                        get_socket_param (SocketEstablished, 'address_info', Address)</l>
<l>                        IP_AdressRemoteSystem := Address[2]</l>
<l>                        PLC_AdressInfo := [PLC_AdressInfo, Address[2]] // just use IP of connected remote system</l>
<l>                        if(PLC_IPAdress[Index_PLCs] = IP_AdressRemoteSystem)</l>
<l>                            break</l>
<l>                        else</l>
<l>                            Socket_CloseAgain_Temp := [Socket_CloseAgain_Temp, SocketEstablished]</l>
<l>                        endif</l>
<l>                    endif</l>
<l>                endfor              </l>
<l>            else</l>
<c>                * loop for standard plc communication</c>
<l>                Timeout := 0.1 // 0.2 is too little timeout for plc on 360</l>
<l>                open_socket_connect (PLC_IPAdress[Index_PLCs], PLC_PortToUse[Index_PLCs], ['protocol', 'timeout'], ['TCP', Timeout], SocketEstablished)</l>
<l>                ReadError := Error     </l>
<l>                get_error_text (ReadError, ErrorMessage)</l>
<l>                dev_set_check ('give_error')</l>
<l>*                 stop()</l>
<l>*                 while (1) // for debuggin send data on onle line with takt 9 and followed 10</l>
<l>*                     SendTuple := [3, 2, 0, 2, 10]</l>
<l>*                     send_data (SocketEstablished, 'C' + |SendTuple|, SendTuple, [])</l>
<l>*                     stop()</l>
<l>*                     wait_seconds(0.1)</l>
<l>*                     SendTuple := [3, 2, 0, 2, 9]</l>
<l>*                     send_data (SocketEstablished, 'C' + |SendTuple|, SendTuple, [])</l>
<l>*                     wait_seconds(0.1)</l>
<l>*                 endwhile</l>
<l>                if(ReadError # 2)</l>
<l>                    stop()  </l>
<l>                endif</l>
<l>            endif</l>
<c>            </c>
<l>            if (ReadError = 2)</l>
<l>                break</l>
<l>            else</l>
<l>                wait_seconds (0.2)               </l>
<l>*                 close_socket (AcceptingSocket)</l>
<l>            endif</l>
<c>            </c>
<c>            *** Janine - Exception topic</c>
<c>            * Anywhere in code must be a line where this is not resetted correctly </c>
<c>            * so that there are nor error messages in HDevelop seen!!!!</c>
<l>            dev_set_check ('give_error')</l>
<l>        endfor</l>
<c>         </c>
<l>        if (AcceptingSocket = [])</l>
<l>            PLC_AcceptingSocket := [PLC_AcceptingSocket, -1]</l>
<l>        else</l>
<l>            PLC_AcceptingSocket := [PLC_AcceptingSocket, AcceptingSocket]</l>
<l>        endif</l>
<c>        * if no connection could be established set to -1, else socket</c>
<l>        if (SocketEstablished = [])</l>
<l>            PLC_CommunicationSocket := [PLC_CommunicationSocket, -1]</l>
<l>        else</l>
<l>            PLC_CommunicationSocket := [PLC_CommunicationSocket, SocketEstablished]</l>
<l>        endif</l>
<c>        * close not needed sockets</c>
<l>        for Index1 := 0 to |Socket_CloseAgain_Temp|-1 by 1</l>
<l>            close_socket (Socket_CloseAgain_Temp[Index1])</l>
<l>        endfor</l>
<l>    endfor  </l>
<l>else // gen indicator per plc that it is not connected</l>
<l>    PLC_CommunicationSocket := []</l>
<c>    * for every port set a -1. in 360 one camera can communicate to multiple ports on one plc</c>
<l>    for Index_PLCs := 0 to |PLC_PortToUse_temp| -1 by 1</l>
<l>        PLC_CommunicationSocket := [PLC_CommunicationSocket, -1]</l>
<l>    endfor</l>
<l>endif</l>
<c></c>
<c>* handle case that one socket is not established. handled for multiple sockets in parallel</c>
<l>tuple_find (PLC_CommunicationSocket, -1, Indices_MinusOneFound)</l>
<l>if((|Indices_MinusOneFound| &gt; 0) and (Indices_MinusOneFound # -1) and (PLCAvailable = 1))</l>
<l>    PLC_FailedToConnect := 1</l>
<l>    close_all_sockets()</l>
<l>else</l>
<l>    PLC_FailedToConnect := 0</l>
<l>endif</l>
<c></c>
<c>* </c>
<l>return ()</l>
</body>
<docu id="gPLC_InitConnection">
<parameters>
<parameter id="CameraNumberToUse"/>
<parameter id="Is360InspectionActive"/>
<parameter id="PLCAvailable"/>
<parameter id="PLCWatchdogSignal"/>
<parameter id="PLC_AcceptingSocket"/>
<parameter id="PLC_CommunicationSocket"/>
<parameter id="PLC_FailedToConnect"/>
<parameter id="PLC_NumberOfConnectionTrials"/>
<parameter id="VTCamera"/>
<parameter id="VTPLC"/>
</parameters>
</docu>
</procedure>
<procedure name="gSelectVariableValueFromTupleString">
<interface>
<ic>
<par name="TupleDataInput" base_type="ctrl" dimension="0"/>
<par name="VariableStringToSearchFor" base_type="ctrl" dimension="0"/>
</ic>
<oc>
<par name="VariableValueFound" base_type="ctrl" dimension="0"/>
</oc>
</interface>
<body>
<l>VariableStringToSearchFor := VariableStringToSearchFor + '='</l>
<l>tuple_regexp_select (TupleDataInput, [VariableStringToSearchFor], Selection)</l>
<l>tuple_regexp_replace (Selection, [VariableStringToSearchFor], '', VariableValueFound)</l>
<l>tuple_number (VariableValueFound, VariableValueFound)</l>
<l>return ()</l>
</body>
<docu id="gSelectVariableValueFromTupleString">
<parameters>
<parameter id="TupleDataInput"/>
<parameter id="VariableStringToSearchFor"/>
<parameter id="VariableValueFound"/>
</parameters>
</docu>
</procedure>
<procedure name="gSelectVariableValueFromTupleString_GetIndex">
<interface>
<ic>
<par name="TupleDataInput" base_type="ctrl" dimension="0"/>
<par name="VariableStringToSearchFor" base_type="ctrl" dimension="0"/>
<par name="ImageChannel_MappingTable_In" base_type="ctrl" dimension="0"/>
</ic>
<oc>
<par name="VariableValueFound" base_type="ctrl" dimension="0"/>
<par name="IndexFound" base_type="ctrl" dimension="0"/>
<par name="ImageChannel_MappingTable_Out" base_type="ctrl" dimension="0"/>
</oc>
</interface>
<body>
<l>VariableStringToSearchFor := VariableStringToSearchFor + '='</l>
<l>tuple_regexp_select (TupleDataInput, [VariableStringToSearchFor], Selection)</l>
<l>tuple_regexp_replace (Selection, [VariableStringToSearchFor], '', VariableValueFound)</l>
<l>tuple_number (VariableValueFound, VariableValueFound)</l>
<c></c>
<c>* added functionality for mapping table</c>
<l>if (VariableValueFound = [])</l>
<l>    VariableValueFound := -1</l>
<l>endif</l>
<l>ImageChannel_MappingTable_Out := [ImageChannel_MappingTable_In, VariableStringToSearchFor, VariableValueFound]</l>
<c></c>
<l>return ()</l>
</body>
<docu id="gSelectVariableValueFromTupleString_GetIndex">
<parameters>
<parameter id="ImageChannel_MappingTable_In"/>
<parameter id="ImageChannel_MappingTable_Out"/>
<parameter id="IndexFound"/>
<parameter id="TupleDataInput"/>
<parameter id="VariableStringToSearchFor"/>
<parameter id="VariableValueFound"/>
</parameters>
</docu>
</procedure>
<procedure name="gSetUp_ROIs">
<interface>
<oo>
<par name="RinnenROIs" base_type="iconic" dimension="0"/>
<par name="EjectROIs" base_type="iconic" dimension="0"/>
</oo>
<ic>
<par name="ROI_StartColumn" base_type="ctrl" dimension="0"/>
<par name="ROI_OffsetImageTop_UpperROIPosition" base_type="ctrl" dimension="0"/>
<par name="ROI_OffsetImageTop_LowerROIPosition" base_type="ctrl" dimension="0"/>
<par name="ROI_OffsetX" base_type="ctrl" dimension="0"/>
<par name="ROI_Width" base_type="ctrl" dimension="0"/>
<par name="ROIEject_OffsetImageTop" base_type="ctrl" dimension="0"/>
<par name="ROIEject_Length" base_type="ctrl" dimension="0"/>
<par name="ROIEject_Width" base_type="ctrl" dimension="0"/>
</ic>
</interface>
<body>
<c>    * </c>
<c>* Setup ROI´s</c>
<l>Row1 := []</l>
<l>Row2 := []</l>
<l>Column1 := []</l>
<l>Column2 := []</l>
<l>EjectRow1 := []</l>
<l>EjectRow2 := []</l>
<l>EjectColumn1 := []</l>
<l>EjectColumn2 := []</l>
<c>* </c>
<c>* </c>
<l>tuple_length (ROI_StartColumn, ROI_Count)</l>
<l>for Index := 0 to ROI_Count-1 by 1</l>
<l>    tuple_concat (Row1, ROI_OffsetImageTop_UpperROIPosition, Row1)</l>
<l>    tuple_concat (Row2, ROI_OffsetImageTop_LowerROIPosition, Row2)</l>
<l>    tuple_concat (Column1, (ROI_StartColumn[Index] + ROI_OffsetX) - (ROI_Width / 2), Column1)</l>
<l>    tuple_concat (Column2, (ROI_StartColumn[Index] + ROI_OffsetX) + (ROI_Width/2), Column2)</l>
<c>    * </c>
<l>    tuple_concat (EjectRow1, ROIEject_OffsetImageTop, EjectRow1)</l>
<l>    tuple_concat (EjectRow2, ROIEject_OffsetImageTop + ROIEject_Length, EjectRow2)</l>
<l>    tuple_concat (EjectColumn1, (ROI_StartColumn[Index] + ROI_OffsetX) - (ROIEject_Width / 2), EjectColumn1)</l>
<l>    tuple_concat (EjectColumn2, (ROI_StartColumn[Index] + ROI_OffsetX) + (ROIEject_Width/2), EjectColumn2)</l>
<l>endfor</l>
<l>gen_rectangle1 (RinnenROIs, Row1, Column1, Row2, Column2)</l>
<l>gen_rectangle1 (EjectROIs, EjectRow1, EjectColumn1, EjectRow2, EjectColumn2)</l>
<c>* </c>
<l>return ()</l>
</body>
<docu id="gSetUp_ROIs">
<parameters>
<parameter id="EjectROIs"/>
<parameter id="ROIEject_Length"/>
<parameter id="ROIEject_OffsetImageTop"/>
<parameter id="ROIEject_Width"/>
<parameter id="ROI_OffsetImageTop_LowerROIPosition"/>
<parameter id="ROI_OffsetImageTop_UpperROIPosition"/>
<parameter id="ROI_OffsetX"/>
<parameter id="ROI_StartColumn"/>
<parameter id="ROI_Width"/>
<parameter id="RinnenROIs"/>
</parameters>
</docu>
</procedure>
<procedure name="gSetupROIs">
<interface>
<oo>
<par name="RinnenROIs" base_type="iconic" dimension="0"/>
<par name="EjectROIs" base_type="iconic" dimension="0"/>
</oo>
<ic>
<par name="ROI_StartColumn" base_type="ctrl" dimension="0"/>
<par name="ROI_OffsetImageTop_UpperROIPosition" base_type="ctrl" dimension="0"/>
<par name="ROI_OffsetImageTop_LowerROIPosition" base_type="ctrl" dimension="0"/>
<par name="ROI_OffsetX" base_type="ctrl" dimension="0"/>
<par name="ROI_Width" base_type="ctrl" dimension="0"/>
<par name="ROIEject_OffsetImageTop" base_type="ctrl" dimension="0"/>
<par name="ROIEject_Length" base_type="ctrl" dimension="0"/>
<par name="ROIEject_Width" base_type="ctrl" dimension="0"/>
</ic>
</interface>
<body>
<c>* </c>
<c>* </c>
<l>* ROI_StartColumn := [85, 380, 685, 984, 1278, 1572]</l>
<l>* ROI_OffsetImageTop_UpperROIPosition := 5</l>
<l>* ROI_OffsetX := 0</l>
<l>* ROI_Width := 280</l>
<l>* ROI_OffsetImageTop_LowerROIPosition := 716</l>
<l>* ROIEject_OffsetImageTop := 700</l>
<l>* ROIEject_Length := 250</l>
<c>* Setup ROI´s</c>
<l>Row1 := []</l>
<l>Row2 := []</l>
<l>Column1 := []</l>
<l>Column2 := []</l>
<l>EjectRow1 := []</l>
<l>EjectRow2 := []</l>
<l>EjectColumn1 := []</l>
<l>EjectColumn2 := []</l>
<c>* </c>
<c>* </c>
<l>tuple_length (ROI_StartColumn, ROI_Count)</l>
<l>ROI_LowerRow := ROI_OffsetImageTop_LowerROIPosition</l>
<l>for Index := 0 to ROI_Count-1 by 1</l>
<l>    tuple_concat (Row1, ROI_OffsetImageTop_UpperROIPosition, Row1)</l>
<l>    tuple_concat (Row2, ROI_LowerRow, Row2)</l>
<l>    tuple_concat (Column1, (ROI_StartColumn[Index] + ROI_OffsetX) - (ROI_Width / 2), Column1)</l>
<l>    tuple_concat (Column2, (ROI_StartColumn[Index] + ROI_OffsetX) + (ROI_Width/2), Column2)</l>
<c>    * </c>
<l>    tuple_concat (EjectRow1, ROIEject_OffsetImageTop, EjectRow1)</l>
<l>    tuple_concat (EjectRow2, ROIEject_OffsetImageTop + ROIEject_Length, EjectRow2)</l>
<l>    tuple_concat (EjectColumn1, (ROI_StartColumn[Index] + ROI_OffsetX) - (ROIEject_Width / 2), EjectColumn1)</l>
<l>    tuple_concat (EjectColumn2, (ROI_StartColumn[Index] + ROI_OffsetX) + (ROIEject_Width/2), EjectColumn2)</l>
<l>endfor</l>
<l>gen_rectangle1 (RinnenROIs, Row1, Column1, Row2, Column2)</l>
<l>gen_rectangle1 (EjectROIs, EjectRow1, EjectColumn1, EjectRow2, EjectColumn2)</l>
<c>* </c>
<l>return ()</l>
</body>
<docu id="gSetupROIs">
<parameters>
<parameter id="EjectROIs"/>
<parameter id="ROIEject_Length"/>
<parameter id="ROIEject_OffsetImageTop"/>
<parameter id="ROIEject_Width"/>
<parameter id="ROI_OffsetImageTop_LowerROIPosition"/>
<parameter id="ROI_OffsetImageTop_UpperROIPosition"/>
<parameter id="ROI_OffsetX"/>
<parameter id="ROI_StartColumn"/>
<parameter id="ROI_Width"/>
<parameter id="RinnenROIs"/>
</parameters>
</docu>
</procedure>
<procedure name="gShiftregister_Init">
<interface>
<io>
<par name="ImageOrig" base_type="iconic" dimension="0"/>
</io>
<oo>
<par name="ShiftRegisterVector_Good_Bad_ObjectsLastFrame_ThreadVector" base_type="iconic" dimension="3"/>
<par name="Shiftregister_Iconic_Threads_Lanes_Data" base_type="iconic" dimension="4"/>
<par name="Shiftregister_VThread_VLane_IImagePartsPerObject" base_type="iconic" dimension="3"/>
<par name="Shiftregister_VThread_VLane_VMeasuredFeatures_IRegionPerFeature" base_type="iconic" dimension="3"/>
</oo>
<ic>
<par name="LanesPerThreadsVector" base_type="ctrl" dimension="1"/>
</ic>
<oc>
<par name="ShiftregisterVector_ObjectMovement_ThreadVector" base_type="ctrl" dimension="2"/>
<par name="Shiftregister_Tuple_Threads_Lanes_Data" base_type="ctrl" dimension="4"/>
<par name="Shiftregister_VThread_VLane_VMeasureFeature_TResult_TValue" base_type="ctrl" dimension="4"/>
<par name="Shiftregister_VThread_VLane_VImagePartsOffset_TRow_TColumn" base_type="ctrl" dimension="3"/>
</oc>
</interface>
<body>
<l>LanesPerProcessesVector_Out := LanesPerThreadsVector</l>
<l>Length := LanesPerThreadsVector.length()</l>
<c>* </c>
<c>* </c>
<c>* The data description for the ShiftRegisterVector_Good_Bad_ObjectsLastFrame_ThreadVector is as follows:</c>
<c>* First Dimenstion: camera specific- data in relation to cameras - done in loop outside this procedure</c>
<c>* Second Dimension: thread specific- data is in relation to processes that operate individual lanes</c>
<c>* Third dimension: lane specific- data is in relation to lanes that hold data for shift register</c>
<c>* Fourth dimension: shift register specific- data is in relation to good and bad objects in shift register as well as the objects that were found in the last frame,</c>
<c>* </c>
<c>* ShiftregisterVectors</c>
<l>gen_empty_obj (EmptyObject)</l>
<l>for Index := 0 to Length-1 by 1</l>
<l>    TupleInVector := LanesPerThreadsVector.at(Index)</l>
<l>    tuple_length (TupleInVector, TupleInVector_Length)</l>
<l>    for Index1 := 0 to TupleInVector_Length-1 by 1</l>
<l>        Shiftregister_Iconic_Lanes_Data.at(Index1) := {{EmptyObject},{EmptyObject}}</l>
<l>        Shiftregister_Tuple_Lanes_Data.at(Index1) := {{[]},{[]}}</l>
<l>    endfor</l>
<l>    Shiftregister_Iconic_Threads_Lanes_Data.at(Index) := Shiftregister_Iconic_Lanes_Data</l>
<l>    Shiftregister_Tuple_Threads_Lanes_Data.at(Index) := Shiftregister_Tuple_Lanes_Data</l>
<l>endfor</l>
<c>* </c>
<c>* Shiftregister_VThread_VLane_VMeasureFeature_TResult_TValue</c>
<l>gen_empty_obj (EmptyObject)</l>
<l>for IndexThread := 0 to Length-1 by 1</l>
<l>    TupleInVector := LanesPerThreadsVector.at(IndexThread)</l>
<l>    tuple_length (TupleInVector, TupleInVector_Length)</l>
<l>    for IndexLane := 0 to TupleInVector_Length-1 by 1</l>
<l>        ShiftRegisterVector_Good_Bad_ObjectsLastFrame.at(IndexLane) := {EmptyObject,EmptyObject,EmptyObject,EmptyObject} // Init for Good, Bad, LastFrame and All Objects position adapted</l>
<l>        ShiftregisterVector_ObjectMovement.at(IndexLane) := []</l>
<l>        Shiftregister_VThread_VLane_VMeasureFeature_TResult_TValue.at(IndexThread).at(IndexLane).at(0) := {[]}</l>
<l>        Shiftregister_VThread_VLane_IImagePartsPerObject.at(IndexThread).at(IndexLane) := {EmptyObject}</l>
<l>        Shiftregister_VThread_VLane_VImagePartsOffset_TRow_TColumn.at(IndexThread).at(IndexLane) := {[]}</l>
<l>        Shiftregister_VThread_VLane_VMeasuredFeatures_IRegionPerFeature.at(IndexThread).at(IndexLane) := {EmptyObject}</l>
<l>    endfor</l>
<l>    ShiftRegisterVector_Good_Bad_ObjectsLastFrame_ThreadVector.at(IndexThread) := ShiftRegisterVector_Good_Bad_ObjectsLastFrame</l>
<l>    ShiftregisterVector_ObjectMovement_ThreadVector.at(IndexThread) := ShiftregisterVector_ObjectMovement</l>
<l>endfor</l>
<c>* </c>
<l>return ()</l>
<c>* </c>
</body>
<docu id="gShiftregister_Init">
<parameters>
<parameter id="ImageOrig"/>
<parameter id="LanesPerThreadsVector"/>
<parameter id="ShiftRegisterVector_Good_Bad_ObjectsLastFrame_ThreadVector"/>
<parameter id="ShiftregisterVector_ObjectMovement_ThreadVector"/>
<parameter id="Shiftregister_Iconic_Threads_Lanes_Data"/>
<parameter id="Shiftregister_Tuple_Threads_Lanes_Data"/>
<parameter id="Shiftregister_VThread_VLane_IImagePartsPerObject"/>
<parameter id="Shiftregister_VThread_VLane_VImagePartsOffset_TRow_TColumn"/>
<parameter id="Shiftregister_VThread_VLane_VMeasureFeature_TResult_TValue"/>
<parameter id="Shiftregister_VThread_VLane_VMeasuredFeatures_IRegionPerFeature"/>
</parameters>
</docu>
</procedure>
<procedure name="gWorkplace_DisplayImageAndRegions">
<interface>
<io>
<par name="ImageOrig" base_type="iconic" dimension="0"/>
<par name="RinnenROIs" base_type="iconic" dimension="0"/>
<par name="EjectROIs" base_type="iconic" dimension="0"/>
</io>
<ic>
<par name="DevWindow0_NonDevWindow1" base_type="ctrl" dimension="0"/>
<par name="WindowHandle" base_type="ctrl" dimension="0"/>
</ic>
</interface>
<body>
<l>get_image_size (ImageOrig, ImageOrig_Width, ImageOrig_Height)</l>
<c></c>
<c>* select first rgb image in case sequencer image is used (two attached images)</c>
<l>count_channels (ImageOrig, ImageOrig_Channels)</l>
<l>if (ImageOrig_Channels &gt;3)//indicator that sequenced image is used- just select the first image for futher vizualisation</l>
<l>    decompose3 (ImageOrig, ImageOrig_RGB_R, ImageOrig_RGB_G, ImageOrig_RGB_B)</l>
<l>    compose3 (ImageOrig_RGB_R, ImageOrig_RGB_G, ImageOrig_RGB_B, ImageOrig)</l>
<l>endif</l>
<l>if(ImageOrig_Channels = 5) // indicator that SiliconSoftware Framegrabber is used</l>
<c>    * SiliconSoftware Framegrabber delivers hsl image - so channels in transformation are adapted accordingly to halcon hls</c>
<l>    trans_to_rgb (ImageOrig_RGB_R, ImageOrig_RGB_B, ImageOrig_RGB_G, ImageOrig_RGB_R_FromHSV, ImageOrig_RGB_G_FromHSV, ImageOrig_RGB_B_FromHSV, 'hls')</l>
<l>*     trans_to_rgb (ImageOrig_RGB_R, ImageOrig_RGB_G, ImageOrig_RGB_B, ImageOrig_RGB_R_FromHSV, ImageOrig_RGB_G_FromHSV, ImageOrig_RGB_B_FromHSV, 'hsv')</l>
<l>    compose3 (ImageOrig_RGB_R_FromHSV, ImageOrig_RGB_G_FromHSV, ImageOrig_RGB_B_FromHSV, ImageOrig)</l>
<l>endif</l>
<c></c>
<c>* </c>
<l>if (DevWindow0_NonDevWindow1 = 0)</l>
<c>    * </c>
<l>    dev_clear_window ()</l>
<l>    dev_set_window (WindowHandle)</l>
<l>    dev_set_part (0, 0, ImageOrig_Height, ImageOrig_Width)</l>
<l>    dev_display (ImageOrig)</l>
<l>    dev_set_color ('blue')</l>
<l>    dev_display (RinnenROIs)</l>
<l>    dev_set_color ('gray')</l>
<l>    dev_display (EjectROIs)</l>
<l>else</l>
<l>    clear_window (WindowHandle)</l>
<l>    set_part (WindowHandle, 0, 0, ImageOrig_Height, ImageOrig_Width)</l>
<l>    disp_obj (ImageOrig, WindowHandle)</l>
<l>    set_color (WindowHandle, 'blue')</l>
<l>    disp_region (RinnenROIs, WindowHandle)</l>
<l>    set_color (WindowHandle, 'gray')</l>
<l>    disp_region (EjectROIs, WindowHandle)</l>
<l>endif</l>
<c>* </c>
<l>return ()</l>
</body>
<docu id="gWorkplace_DisplayImageAndRegions">
<parameters>
<parameter id="DevWindow0_NonDevWindow1"/>
<parameter id="EjectROIs"/>
<parameter id="ImageOrig"/>
<parameter id="RinnenROIs"/>
<parameter id="WindowHandle"/>
</parameters>
</docu>
</procedure>
<procedure name="gWorkplace_Init">
<interface>
<ic>
<par name="DevWindow0_NonDevWindow1" base_type="ctrl" dimension="0"/>
<par name="Debuglevel" base_type="ctrl" dimension="0"/>
<par name="VTWindowPositioning" base_type="ctrl" dimension="1"/>
<par name="CameraNumberToUse" base_type="ctrl" dimension="0"/>
<par name="TeachInMode" base_type="ctrl" dimension="0"/>
<par name="VTInspectionVisualization" base_type="ctrl" dimension="1"/>
</ic>
<oc>
<par name="WindowHandle" base_type="ctrl" dimension="0"/>
</oc>
</interface>
<body>
<c>* first set window title prior to opening Window title is used as interface to gui</c>
<l>set_window_attr ('window_title', 'Camera' + (CameraNumberToUse +1))</l>
<c>* </c>
<c>* </c>
<l>gGetSubObjectVariables (VTInspectionVisualization,  '/V_VisuFontSize/Value', VTempVariable)</l>
<l>VisuFontSize := VTempVariable.at(0)[1]</l>
<c></c>
<l>if (Debuglevel &gt;= 1 or TeachInMode = 1)</l>
<l>    WindowWidth := 930</l>
<l>    WindowHeigth := 400</l>
<l>    WindowRow := 0</l>
<l>    WindowColumn := 0</l>
<l>    dev_update_time ('on') </l>
<l>else</l>
<l>    dev_update_time ('off')</l>
<l>    gGetSubObjectVariables (VTWindowPositioning, '/Window_' + CameraNumberToUse + '/Width/Value', VWidthVector)</l>
<l>    WindowWidth := VWidthVector.at(0)[1]</l>
<l>    gGetSubObjectVariables (VTWindowPositioning, '/Window_' + CameraNumberToUse + '/Height/Value', VHeigthVector)</l>
<l>    WindowHeigth := VHeigthVector.at(0)[1]</l>
<l>    gGetSubObjectVariables (VTWindowPositioning, '/Window_' + CameraNumberToUse + '/X_Offset/Value', VX_Offset)</l>
<l>    WindowColumn := VX_Offset.at(0)[1]</l>
<l>    gGetSubObjectVariables (VTWindowPositioning, '/Window_' + CameraNumberToUse + '/Y_Offset/Value', VY_Offset)</l>
<l>    WindowRow := VY_Offset.at(0)[1]</l>
<l>endif</l>
<l>dev_update_pc ('off')</l>
<l>dev_update_window ('off')</l>
<l>dev_update_var ('off')</l>
<l>dev_close_window ()</l>
<c>* set draw for debug window if necessary</c>
<l>gSet_HDevelopDebugFlag (SystemInformations, DebugInHalcon)</l>
<l>* DebugInHalcon := 0</l>
<c></c>
<l>if (DebugInHalcon = 1 and Debuglevel = 0)</l>
<l>    dev_open_window (0, 0, 640, 480, 'black', WindowHandle)</l>
<l>    dev_set_draw ('margin')</l>
<l>    dev_set_color ('red')</l>
<l>    dev_set_line_width (2)</l>
<l>endif</l>
<c>* </c>
<l>if (DevWindow0_NonDevWindow1 = 0 or (Debuglevel &gt;= 1 and Debuglevel # 3) or TeachInMode = 1) </l>
<l>    dev_close_window ()</l>
<l>    dev_open_window (WindowRow, WindowColumn, WindowWidth, WindowHeigth, 'black', WindowHandle)</l>
<l>else</l>
<l>    open_window (WindowRow, WindowColumn, WindowWidth, WindowHeigth, 0, 'transparent', '', WindowHandle)</l>
<l>    WindowString := 'Camera' + (CameraNumberToUse +1)</l>
<l>    set_window_param (WindowHandle, 'window_title', WindowString)</l>
<l>endif</l>
<c>* </c>
<c></c>
<l>set_draw (WindowHandle, 'margin')</l>
<l>set_color (WindowHandle, 'red')</l>
<l>set_line_width (WindowHandle, 2)</l>
<l>dev_error_var (Error, 1)</l>
<l>set_font (WindowHandle, 'Arial-Bold-' + VisuFontSize)</l>
<c>* </c>
<c>* </c>
<l>return ()</l>
</body>
<docu id="gWorkplace_Init">
<short lang="de_DE">Set Halconfeatures update pc, line width, colour and so on</short>
<parameters>
<parameter id="CameraNumberToUse"/>
<parameter id="Debuglevel"/>
<parameter id="DevWindow0_NonDevWindow1"/>
<parameter id="TeachInMode"/>
<parameter id="VTInspectionVisualization"/>
<parameter id="VTWindowPositioning"/>
<parameter id="WindowHandle"/>
</parameters>
</docu>
</procedure>
<procedure name="read_dict_from_format">
<interface>
<ic>
<par name="key" base_type="ctrl" dimension="0"/>
</ic>
<oc>
<par name="dict_Settings" base_type="ctrl" dimension="0"/>
</oc>
</interface>
<body>
<c>* read dict from a json file</c>
<c>* input:</c>
<c>* dict_Filedefinition: dictionary with path of files that contain settings</c>
<c>* key: key that defines which settings should be read</c>
<c>* output:</c>
<c>* dict_Settings: dictionary that contains the settings</c>
<c></c>
<l>global tuple dict_Filedefinition</l>
<c></c>
<l>get_dict_tuple (dict_Filedefinition, key, Filename)</l>
<l>read_dict (Filename, [], [], dict_Settings)</l>
<c></c>
<l>return ()</l>
</body>
<docu id="read_dict_from_format">
<parameters>
<parameter id="dict_Settings"/>
<parameter id="key"/>
</parameters>
</docu>
</procedure>
</hdevelop>

<procedure name="gLoadData_PLC">
<interface>
<ic>
<par name="VTFiledefinitions" base_type="ctrl" dimension="1"/>
<par name="FileElementNumber" base_type="ctrl" dimension="0"/>
<par name="TeachInMode" base_type="ctrl" dimension="0"/>
</ic>
<oc>
<par name="VTDataVector" base_type="ctrl" dimension="1"/>
</oc>
</interface>
<body>
<c></c>
<l>VTDataVector.at(0) := []</l>
<c>* Read JSON-File</c>
<l>FilenameToLoad := VTFiledefinitions.at(FileElementNumber)[1]</l>
<l>gJSON_Read_File_to_Vector (FilenameToLoad, ParameterVector)</l>
<l>* read_dict_from_format ('PLCFilename', dict_PLC)</l>
<c>* </c>
<c>* minimal loading function for teachin</c>
<l>Prefix_StaticWhileLoading := '/General/'</l>
<l>* IteratingWhileLoading := ['V_WorkOnPLCEnable','V_Num_PLCs','V_PLCDebugMode','V_PLCWatchdog_Bypass']</l>
<l>IteratingWhileLoading := ['V_WorkOnPLCEnable','V_PLCDebugMode','V_PLCWatchdog_Bypass']</l>
<l>Suffix_StaticWhileLoading := '/Value'</l>
<l>gJSON_LoadValuesFromArrayLike (ParameterVector, VTDataVector, Prefix_StaticWhileLoading, Suffix_StaticWhileLoading, IteratingWhileLoading, VTDataVector)</l>
<c>* </c>
<l>IndexPLCs := 0 // iterate through all plc´s</l>
<l>while(1)</l>
<c>    * minimal loading function for teachin</c>
<l>    Prefix_StaticWhileLoading := '/PLCs/PLC_' + IndexPLCs + '/'</l>
<l>    IteratingWhileLoading := ['V_IP'] </l>
<c></c>
<l>    Suffix_StaticWhileLoading := '/Value'</l>
<l>    gJSON_LoadValuesFromArrayLike (ParameterVector, VTDataVector, Prefix_StaticWhileLoading, Suffix_StaticWhileLoading, IteratingWhileLoading, VTDataVector)</l>
<l>    VectorLength := VTDataVector.length()</l>
<l>    if(|VTDataVector.at(VectorLength-1)|= 1) // if no more data could be read from file stop exection</l>
<l>        VTDataVector.remove(VectorLength-1)</l>
<l>        break</l>
<l>    endif</l>
<l>    IndexPLCs := IndexPLCs +1</l>
<l>endwhile</l>
<c></c>
<c>* </c>
<c>* switch cameras off in teach in mode- no need for hardware then</c>
<l>if (TeachInMode = 1)</l>
<l>    VTDataVector.at(0)[1] := 0</l>
<l>endif</l>
<c>* </c>
<l>global def tuple gPLCDebugMode</l>
<l>global def tuple gPLCWatchdogBypass</l>
<l>gGetSubObjectVariables_SingleValue (VTDataVector, 'V_PLCDebugMode', gPLCDebugMode)</l>
<l>gGetSubObjectVariables_SingleValue (VTDataVector, 'V_PLCWatchdog_Bypass', gPLCWatchdogBypass)</l>
<l>return ()</l>
</body>
<docu id="gLoadData_PLC">

<procedure name="gLoadData_Mode">
<interface>
<ic>
<par name="VTFiledefinitions" base_type="ctrl" dimension="1"/>
<par name="FileElementNumber" base_type="ctrl" dimension="0"/>
</ic>
<oc>
<par name="VTDataVector" base_type="ctrl" dimension="1"/>
</oc>
</interface>
<body>
<l>VTDataVector.at(0) := []</l>
<c>* Read JSON-File</c>
<l>FilenameToLoad := VTFiledefinitions.at(FileElementNumber)[1]</l>
<l>gJSON_Read_File_to_Vector (FilenameToLoad, ParameterVector)</l>
<c>* </c>
<c>* minimal loading function for teachin</c>
<l>Prefix_StaticWhileLoading := '/'</l>
<l>IteratingWhileLoading := ['V_EndlessLoopForTestingEngine','V_MachineEnableInspectionSignal_RunProductionDirectly','V_CriticalInspectionResultStopsSystem','V_SystemDebugEjectAndStopOverride','V_SaveAllImagesWithinOperation','V_TeachInMode','V_RealTimeMode','V_IPCMode', 'V_DebugCollectProcessimagesOnCameraOne', 'V_DebugCollectProcessimagesOnCamera_SpecifyCameraNumber']</l>
<l>Suffix_StaticWhileLoading := '/Value'</l>
<l>gJSON_LoadValuesFromArrayLike (ParameterVector, VTDataVector, Prefix_StaticWhileLoading, Suffix_StaticWhileLoading, IteratingWhileLoading, VTDataVector)</l>
<c>* </c>
<l>return ()</l>
</body>

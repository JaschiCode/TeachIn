<?xml version="1.0" encoding="UTF-8"?>
<hdevelop file_version="1.2" halcon_version="25.11.0.0">
<procedure name="SegmentationFilterRegionsRemoveTabletsOnBorderAndInEjectbox">
<interface>
<io>
<par name="Image" base_type="iconic" dimension="0"/>
<par name="RegionLanes" base_type="iconic" dimension="0"/>
<par name="RegionTablets" base_type="iconic" dimension="0"/>
</io>
<oo>
<par name="RegionTabletsOnBorder" base_type="iconic" dimension="0"/>
</oo>
<ic>
<par name="GetObjects_UpperLower0_LeftRight1_Both2_Lower3" base_type="ctrl" dimension="0"/>
</ic>
</interface>
<body>
<c>* SegmentationFilterRegionsRemoveTabletsOnBorderAndInEjectbox</c>
<c>* ------------------------------------------------------------</c>
<c>* Liefert ganze Tablet-Objekte, die den gewaehlten Lane-Rand beruehren.</c>
<c></c>
<l>gen_empty_obj (EmptyObject)</l>
<l>RegionTabletsOnBorder := EmptyObject</l>
<c></c>
<c>* Lane-ROIs auf die Bilddomain begrenzen.</c>
<l>get_domain (Image, Domain)</l>
<l>intersection (RegionLanes, Domain, RegionLanesInsideImage)</l>
<c></c>
<c>* Den zu pruefenden Randstreifen aus der Erosion der Lane-ROIs bestimmen.</c>
<l>switch (GetObjects_UpperLower0_LeftRight1_Both2_Lower3)</l>
<l>case 0:</l>
<l>    erosion_rectangle1 (RegionLanesInsideImage, LanesROIsErosion, 1, 30)</l>
<l>    break</l>
<l>case 1:</l>
<l>    erosion_rectangle1 (RegionLanesInsideImage, LanesROIsErosion, 30, 1)</l>
<l>    break</l>
<l>case 2:</l>
<l>    erosion_rectangle1 (RegionLanesInsideImage, LanesROIsErosion, 30, 30)</l>
<l>    break</l>
<l>case 3:</l>
<l>    get_image_size (Image, RegionWidth, RegionHeight)</l>
<l>    gen_rectangle1 (LowerPortionRectangle, RegionHeight - 30, 0, RegionHeight, RegionWidth)</l>
<l>    difference (RegionLanesInsideImage, LowerPortionRectangle, LanesROIsErosion)</l>
<l>    break</l>
<l>default:</l>
<l>    erosion_rectangle1 (RegionLanesInsideImage, LanesROIsErosion, 30, 1)</l>
<l>    break</l>
<l>endswitch</l>
<l>difference (RegionLanesInsideImage, LanesROIsErosion, LaneBorder)</l>
<c></c>
<c>* Schnittbereiche auf dem Rand den vollstaendigen Tablet-Objekten zuordnen.</c>
<l>intersection (RegionTablets, LaneBorder, TabletsOnBorderPartial)</l>
<l>count_obj (TabletsOnBorderPartial, NumberOfBorderParts)</l>
<l>RegionTabletsOnBorderIndices := []</l>
<l>for IndexPart := 1 to NumberOfBorderParts by 1</l>
<l>    select_obj (TabletsOnBorderPartial, TabletBorderPart, IndexPart)</l>
<l>    get_region_runs (TabletBorderPart, Row, ColumnBegin, ColumnEnd)</l>
<l>    if (Row # [])</l>
<l>        get_region_index (RegionTablets, Row[0], ColumnBegin[0], TabletIndex)</l>
<l>        tuple_equal_elem (RegionTabletsOnBorderIndices, TabletIndex, IndexAlreadyAdded)</l>
<l>        tuple_sum (IndexAlreadyAdded, NumberAlreadyAdded)</l>
<l>        if (NumberAlreadyAdded = 0)</l>
<l>            tuple_concat (RegionTabletsOnBorderIndices, TabletIndex, RegionTabletsOnBorderIndices)</l>
<l>        endif</l>
<l>    endif</l>
<l>endfor</l>
<l>if (RegionTabletsOnBorderIndices # [])</l>
<l>    select_obj (RegionTablets, RegionTabletsOnBorder, RegionTabletsOnBorderIndices)</l>
<l>endif</l>
<c></c>
<l>return ()</l>
</body>
<docu id="SegmentationFilterRegionsRemoveTabletsOnBorderAndInEjectbox">
<parameters>
<parameter id="GetObjects_UpperLower0_LeftRight1_Both2_Lower3"/>
<parameter id="Image"/>
<parameter id="RegionLanes"/>
<parameter id="RegionTablets"/>
<parameter id="RegionTabletsOnBorder"/>
</parameters>
</docu>
</procedure>
</hdevelop>

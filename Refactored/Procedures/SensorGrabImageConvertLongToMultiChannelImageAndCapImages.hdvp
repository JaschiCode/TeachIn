<?xml version="1.0" encoding="UTF-8"?>
<hdevelop file_version="1.2" halcon_version="25.11.0.0">
<procedure name="SensorGrabImageConvertLongToMultiChannelImageAndCapImages">
<interface>
<io>
<par name="Image" base_type="iconic" dimension="0"/>
</io>
<oo>
<par name="ImageMultiChannel" base_type="iconic" dimension="0"/>
<par name="ImageCap" base_type="iconic" dimension="0"/>
</oo>
</interface>
<body>
<c>* SensorGrabImageConvertLongToMultiChannelImageAncCapImages</c>
<c>* ----------------------------------------------------------------------</c>
<c></c>
<l>global tuple App</l>
<c></c>
<l>CapImage0_Height := App.Format.Camera.Cameras.SideCamera_0.V_Side_Camera_0_ImageGrabResolution_Height.Value</l>
<l>CapImage1_Height := App.Format.Camera.Cameras.SideCamera_1.V_Side_Camera_1_ImageGrabResolution_Height.Value</l>
<c></c>
<l>CapsHeight := CapImage0_Height + CapImage1_Height</l>
<c></c>
<l>get_image_size (Image, Image_Width, Image_Height)</l>
<l>Camera0_Height := Image_Height - CapsHeight</l>
<c></c>
<l>crop_part (Image, ImageCap, Image_Height-CapsHeight-1, 0, Image_Width, CapsHeight)</l>
<l>stop() // hier weiter</l>
<c></c>
<l>crop_part (Image, ImagePart, [0,(Camera0_Height/2)], [0,0], [Image_Width,Image_Width], [(Camera0_Height/2),(Camera0_Height/2)])</l>
<c>* Use image from siso framegrabber. </c>
<c>* The image is double length. </c>
<c>* Upper half is hsv image top light, lower half is monochrome bottom light. </c>
<c>* Third channel of bottom light image is with mean fiter </c>
<c></c>
<c>* First backlight, then toplight</c>
<l>select_obj (ImagePart, ImageTop, 2)</l>
<l>select_obj (ImagePart, ImageBottom, 1)</l>
<c></c>
<c></c>
<l>decompose3 (ImageTop, ImageTop_HSV_H, ImageTop_HSV_S, ImageTop_HSV_V)</l>
<l>decompose3 (ImageBottom, ImageBottom_Monochrome, ImageBottom_Monochrome_UV, ImageBottom_Monochrome_Mean)</l>
<l>compose5 (ImageTop_HSV_H, ImageTop_HSV_S, ImageTop_HSV_V, ImageBottom_Monochrome, ImageBottom_Monochrome_UV, ImageMultiChannel)</l>
<c></c>
<c></c>
<l>return ()</l>
</body>
<docu id="SensorGrabImageConvertLongToMultiChannelImageAndCapImages">
<parameters>
<parameter id="Image"/>
<parameter id="ImageCap"/>
<parameter id="ImageMultiChannel"/>
</parameters>
</docu>
</procedure>
</hdevelop>

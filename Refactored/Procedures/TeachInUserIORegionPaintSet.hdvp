<?xml version="1.0" encoding="UTF-8"?>
<hdevelop file_version="1.2" halcon_version="25.11.0.0">
<procedure name="TeachInUserIORegionPaintSet">
<interface>
<io>
<par name="Image" base_type="iconic" dimension="0"/>
</io>
<oo>
<par name="RegionOutput" base_type="iconic" dimension="0"/>
</oo>
<ic>
<par name="MessageToDisplay" base_type="ctrl" dimension="0"/>
<par name="BrushSizeFactorToWindowSize" base_type="ctrl" dimension="0"/>
<par name="ChannelSelector" base_type="ctrl" dimension="0"/>
<par name="WindowHandle" base_type="ctrl" dimension="0"/>
</ic>
<oc>
<par name="ExternalIO_BtnPressed" base_type="ctrl" dimension="0"/>
</oc>
</interface>
<body>
<c>* TeachInUserIORegionPaintSet</c>
<c>* ---------------------------------------------------------</c>
<c></c>
<l>global tuple App</l>
<c></c>
<c></c>
<l>gen_empty_obj (RegionOutput)</l>
<c></c>
<c></c>
<l>App.TeachIn.UserIO.ExternalBtnPressed   := -1</l>
<l>App.TeachIn.UserIO.StopMonitoringFileIO := 0</l>
<c></c>
<c></c>
<c>* Define relative brush size</c>
<l>get_part (WindowHandle, Row1, Col1, Row2, Col2)</l>
<l>WindowWidth  := Col2-Col1</l>
<l>WindowHeight := Row2-Row1</l>
<l>RelativeBrushWidth  := WindowWidth / BrushSizeFactorToWindowSize</l>
<l>RelativeBrushHeight := WindowHeight / BrushSizeFactorToWindowSize</l>
<l>if (RelativeBrushWidth &gt; RelativeBrushHeight)</l>
<l>    BrushSize := RelativeBrushWidth</l>
<l>else</l>
<l>    BrushSize := RelativeBrushHeight</l>
<l>endif</l>
<c></c>
<c></c>
<c>* Prepare some visu pattern</c>
<l>get_image_size (Image, ImageWidth, ImageHeight)</l>
<l>gen_checker_region (RegionChecker, ImageWidth, ImageHeight, WindowWidth/50, WindowHeight/50)</l>
<l>set_color (WindowHandle, ['dim gray', 'red'])</l>
<l>set_draw (WindowHandle, 'margin')</l>
<l>TeachInSelectAndDisplayMultiChannelImage (App.TeachIn.ImageOrig, ImageSelectedChannel, ImageDisplay, ChannelSelector, 1, 1, 0)</l>
<l>if (|MessageToDisplay| &gt; 0)</l>
<l>    disp_text (WindowHandle, MessageToDisplay, 'window', 'top', 'left', 'blue', ['box_color','box_padding'], ['#ffffff77',5])</l>
<l>endif</l>
<c></c>
<c></c>
<c>* Indicate the brush size to operator</c>
<l>set_color (WindowHandle, 'blue')</l>
<l>get_part (WindowHandle, WindowRow1, __, __, WindowCol2)</l>
<l>gen_circle (Brush_SampleVisuForOperator, WindowRow1 + 15, WindowCol2 -15, BrushSize/2)</l>
<l>disp_obj (Brush_SampleVisuForOperator, WindowHandle)</l>
<l>gen_empty_obj (RegionVizu)</l>
<c></c>
<l>while (1)</l>
<l>    dev_error_var (ErrorVar, 1)</l>
<l>    dev_set_check ('~give_error')</l>
<l>    get_mposition (WindowHandle, MouseRow, MouseColumn, MouseButton)</l>
<l>    Error := ErrorVar</l>
<l>    dev_set_check ('give_error')</l>
<l>    if (MouseButton == 1)</l>
<l>        gen_circle (Brush, MouseRow, MouseColumn, BrushSize/2)</l>
<l>        union2 (RegionOutput, Brush, RegionOutput)</l>
<c>        </c>
<l>        intersection (RegionChecker, RegionOutput, RegionVizu)</l>
<l>        concat_obj (RegionVizu, RegionOutput, RegionVizu)</l>
<c>        </c>
<l>        set_window_param (WindowHandle, 'flush', 'false')</l>
<l>        disp_obj (ImageDisplay, WindowHandle)</l>
<l>        select_obj (RegionVizu, Checker, 1)</l>
<l>        set_color (WindowHandle, 'dim gray')</l>
<l>        disp_obj (Checker, WindowHandle)</l>
<l>        set_color (WindowHandle, 'red')</l>
<l>        select_obj (RegionVizu, Surrounding, 2)</l>
<l>        disp_obj (Surrounding, WindowHandle)</l>
<l>        set_color (WindowHandle, 'blue')</l>
<l>        disp_obj (Brush_SampleVisuForOperator, WindowHandle)</l>
<c>        </c>
<l>        if (|MessageToDisplay| &gt; 0)</l>
<l>            disp_text (WindowHandle, MessageToDisplay, 'window', 'top', 'left', 'blue', ['box_color','box_padding'], ['#ffffff77',5])</l>
<l>        endif</l>
<l>        flush_buffer (WindowHandle)</l>
<l>        set_window_param (WindowHandle, 'flush', 'true')</l>
<l>    else</l>
<l>        par_start&lt;ThreadID&gt; : TeachInUserIOMonitorFileIO ()</l>
<l>        App.TeachIn.UserIO.StopMonitoringFileIO := 1</l>
<l>        par_join (ThreadID)</l>
<l>        if (MouseButton == 4)</l>
<l>            break</l>
<l>        endif</l>
<l>        if (App.TeachIn.UserIO.ExternalBtnPressed == 5 or App.TeachIn.UserIO.ExternalBtnPressed == 6)</l>
<l>            if (App.TeachIn.UserIO.ExternalBtnPressed == 5) </l>
<c>                * Brush smaller request</c>
<l>                BrushSize := BrushSize * 0.7</l>
<l>                if (BrushSize &lt; 3)</l>
<l>                    BrushSize := 3</l>
<l>                endif</l>
<l>            endif</l>
<l>            if (App.TeachIn.UserIO.ExternalBtnPressed == 6) </l>
<c>                * Brush bigger request</c>
<l>                BrushSize := BrushSize * 1.3</l>
<l>            endif</l>
<c>            </c>
<c>            * Indicate the brush size to operator</c>
<l>            set_color (WindowHandle, 'blue')</l>
<l>            gen_circle (Brush_SampleVisuForOperator, BrushSize/2 + WindowRow1 + 15, WindowCol2 - BrushSize/2 -15, BrushSize/2)</l>
<c>            </c>
<l>            set_window_param (WindowHandle, 'flush', 'false')</l>
<l>            disp_obj (ImageDisplay, WindowHandle)</l>
<l>            select_obj (RegionVizu, Checker, 1)</l>
<l>            set_color (WindowHandle, 'dim gray')</l>
<l>            disp_obj (Checker, WindowHandle)</l>
<l>            set_color (WindowHandle, 'red')</l>
<l>            select_obj (RegionVizu, Surrounding, 2)</l>
<l>            disp_obj (Surrounding, WindowHandle)</l>
<l>            set_color (WindowHandle, 'blue')</l>
<l>            disp_obj (Brush_SampleVisuForOperator, WindowHandle)</l>
<c>            </c>
<l>            if (|MessageToDisplay| &gt; 0)</l>
<l>                disp_text (WindowHandle, MessageToDisplay, 'window', 'top', 'left', 'blue', ['box_color','box_padding'], ['#ffffff77',5])</l>
<l>            endif</l>
<l>            flush_buffer (WindowHandle)</l>
<l>            set_window_param (WindowHandle, 'flush', 'true')</l>
<l>            App.TeachIn.UserIO.ExternalBtnPressed := -1</l>
<l>            continue</l>
<l>        endif</l>
<l>        if (App.TeachIn.UserIO.ExternalBtnPressed &gt; -1) </l>
<c>            * Handles other external button interactions</c>
<l>            break</l>
<l>        endif</l>
<l>    endif  </l>
<l>endwhile</l>
<c></c>
<l>ExternalIO_BtnPressed := App.TeachIn.UserIO.ExternalBtnPressed</l>
<c></c>
<l>set_color (WindowHandle, 'red')</l>
<c></c>
<c></c>
<l>return ()</l>
</body>
<docu id="TeachInUserIORegionPaintSet">
<parameters>
<parameter id="BrushSizeFactorToWindowSize"/>
<parameter id="ChannelSelector"/>
<parameter id="ExternalIO_BtnPressed"/>
<parameter id="Image"/>
<parameter id="MessageToDisplay"/>
<parameter id="RegionOutput"/>
<parameter id="WindowHandle"/>
</parameters>
</docu>
</procedure>
</hdevelop>

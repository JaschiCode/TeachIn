<?xml version="1.0" encoding="UTF-8"?>
<hdevelop file_version="1.2" halcon_version="25.11.0.0">
<procedure name="SegmentationSpotAndPrint">
<interface>
<io>
<par name="Image" base_type="iconic" dimension="0"/>
<par name="RegionTabletsMoved" base_type="iconic" dimension="0"/>
</io>
<ic>
<par name="ProcessingThreadID" base_type="ctrl" dimension="0"/>
</ic>
<oc>
<par name="TimeNeeded" base_type="ctrl" dimension="0"/>
</oc>
</interface>
<body>
<c>* SegmentationSpotAndPrint</c>
<c>* --------------------------------------</c>
<c></c>
<l>global tuple App</l>
<c></c>
<l>count_seconds (TimeStart)</l>
<c></c>
<c>* Get variables from dictionary</c>
<l>LanesROIs         := App.Inspection.Threads.[ProcessingThreadID].Regions.Lanes.ROIs</l>
<l>SpotFeatureActive := App.Format.TabletInspection.Measure_ProductSpot.V_FeatureActive.Value</l>
<c></c>
<l>SegmentationPrintDynThreshOrClassification (Image, ColorClassifiedTabletsAll, ProcessingThreadID, TimeNeeded)</l>
<c></c>
<c></c>
<c>* Get a reduced product hull - due to there may be effects from print in it</c>
<c>* if a spot is on outer areo of product it may leat to issue</c>
<l>connection (RegionTabletsMoved, RegionTabletsMoved)</l>
<l>shape_trans (RegionTabletsMoved, SegmentedTablets_Convex, 'convex')</l>
<l>union1 (SegmentedTablets_Convex, SegmentedTablets_Convex)</l>
<l>erosion_rectangle1 (SegmentedTablets_Convex, RegionErosion, 20, 30)</l>
<c></c>
<c></c>
<c>* Filter out product regions that cut roi regions</c>
<l>gen_empty_obj (ColorClassifiedTablets)</l>
<l>count_obj (LanesROIs, NumLanesROIs)</l>
<l>for IdxLane := 0 to NumLanesROIs-1 by 1    </l>
<l>    select_obj (LanesROIs, LaneROI, IdxLane+1)</l>
<c></c>
<c>    *** Update for using the spot on transparent tablets with UV-light</c>
<c>    *** Actually the classified images are not used in further workflow. Why not??? </c>
<c>    *** Classification for spot is not used here!!!</c>
<l>    if (SpotFeatureActive)</l>
<l>        intersection (LaneROI, ColorClassifiedTabletsAll, ColorClassifiedTablet)</l>
<l>    else</l>
<l>        intersection (LaneROI, RegionTabletsMoved, ColorClassifiedTablet)</l>
<l>    endif</l>
<c></c>
<l>    SegmentationFilterRegionsCuttingROI (ColorClassifiedTablet, ColorClassifiedTablet, ProcessingThreadID, 1)</l>
<l>    concat_obj (ColorClassifiedTablets, ColorClassifiedTablet, ColorClassifiedTablets)</l>
<l>endfor</l>
<c></c>
<c>* Set variables to dictionary</c>
<l>App.Inspection.Threads.[ProcessingThreadID].Regions.Tablets.Segmented := ColorClassifiedTablets</l>
<c></c>
<l>count_seconds (TimeEnd)</l>
<l>TimeNeeded := (TimeEnd-TimeStart) * 1000.0</l>
<c></c>
<l>return ()</l>
</body>
<docu id="SegmentationSpotAndPrint">
<parameters>
<parameter id="Image"/>
<parameter id="ProcessingThreadID"/>
<parameter id="RegionTabletsMoved"/>
<parameter id="TimeNeeded"/>
</parameters>
</docu>
</procedure>
</hdevelop>

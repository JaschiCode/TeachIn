<?xml version="1.0" encoding="UTF-8"?>
<hdevelop file_version="1.2" halcon_version="25.11.0.0">
<procedure name="FormatReadDict">
<interface>
<ic>
<par name="Key" base_type="ctrl" dimension="0"/>
</ic>
</interface>
<body>
<c>* FormatReadDict</c>
<c>* ------------------------------------------------------</c>
<c>* Read dictionary from a json file</c>
<c></c>
<l>global tuple App</l>
<c></c>
<l>Filename := App.Filesystem.Format.Config.Files.[Key]</l>
<l>read_dict (Filename, [], [], App.Format.[Key])</l>
<c></c>
<l>return ()</l>
</body>
<docu id="FormatReadDict">
<parameters>
<parameter id="Key"/>
</parameters>
</docu>
</procedure>
</hdevelop>

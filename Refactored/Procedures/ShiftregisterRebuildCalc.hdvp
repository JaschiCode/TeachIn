<?xml version="1.0" encoding="UTF-8"?>
<hdevelop file_version="1.2" halcon_version="25.11.0.0">
<procedure name="ShiftregisterRebuildCalc">
<interface>
<ic>
<par name="TriggerRebuild" base_type="ctrl" dimension="0"/>
<par name="TriggerKill" base_type="ctrl" dimension="0"/>
<par name="StepWidthNumberFramesToRebuild" base_type="ctrl" dimension="0"/>
</ic>
</interface>
<body>
<c>* ShiftregisterRebuildCalc</c>
<c>* --------------------------------------------</c>
<c>* Vorbereitungen zum Aufbau des Shiftregisters</c>
<c></c>
<c>* Status TriggerRebuild:</c>
<c>*   -1 = gerade initialisiert</c>
<c>*    0 = keine Änderung (Normalbetrieb)</c>
<c>*    1 = Shiftregister neu aufbauen</c>
<c>*   &gt;1 = neue Anforderung zum Neuaufbau</c>
<c></c>
<c>* TriggerKill:</c>
<c>*    0 = keine Änderung</c>
<c>*    1 = Shiftregister beenden</c>
<c></c>
<l>global tuple App</l>
<c></c>
<l>ProcessingLoopcounter := App.Status.Counter.ProductionLoopCounter</l>
<c></c>
<l>if (ProcessingLoopcounter == 0)</l>
<c>    * Initialisierung beim Start</c>
<l>    App.Shiftregister.Rebuild.Status     := 1</l>
<l>    App.Shiftregister.Rebuild.Kill       := TriggerKill</l>
<l>    App.Shiftregister.Rebuild.StartIndex := 0</l>
<l>    App.Shiftregister.Rebuild.EndIndex   := StepWidthNumberFramesToRebuild</l>
<l>else</l>
<l>    if (TriggerRebuild = 2)</l>
<c>        * Bei neuer Anforderung die Indizes aktualisieren</c>
<l>        App.Shiftregister.Rebuild.Status     := 1</l>
<l>        App.Shiftregister.Rebuild.Kill       := TriggerKill</l>
<l>        App.Shiftregister.Rebuild.StartIndex := ProcessingLoopcounter</l>
<l>        App.Shiftregister.Rebuild.EndIndex   := ProcessingLoopcounter + StepWidthNumberFramesToRebuild</l>
<l>    else</l>
<c>        * Im Normalbetrieb den laufenden Aufbau überwachen</c>
<l>        if (App.Shiftregister.Rebuild.Status == 1)</l>
<l>            if (App.Shiftregister.Rebuild.EndIndex == ProcessingLoopcounter)</l>
<c>                * Aufbau beenden und Status zurücksetzen</c>
<l>                App.Shiftregister.Rebuild.Status     := 0</l>
<l>                App.Shiftregister.Rebuild.Kill       := TriggerKill</l>
<l>                App.Shiftregister.Rebuild.StartIndex := -1</l>
<l>                App.Shiftregister.Rebuild.EndIndex   := -1</l>
<l>            endif</l>
<l>        else</l>
<l>            App.Shiftregister.Rebuild.Status     := 0</l>
<l>            App.Shiftregister.Rebuild.Kill       := TriggerKill</l>
<l>            App.Shiftregister.Rebuild.StartIndex := -1</l>
<l>            App.Shiftregister.Rebuild.EndIndex   := -1</l>
<l>        endif</l>
<l>    endif</l>
<l>endif</l>
<c></c>
<l>return ()</l>
</body>
<docu id="ShiftregisterRebuildCalc">
<parameters>
<parameter id="StepWidthNumberFramesToRebuild"/>
<parameter id="TriggerKill"/>
<parameter id="TriggerRebuild"/>
</parameters>
</docu>
</procedure>
</hdevelop>
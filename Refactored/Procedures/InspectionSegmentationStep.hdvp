<?xml version="1.0" encoding="UTF-8"?>
<hdevelop file_version="1.2" halcon_version="25.11.0.0">
<procedure name="InspectionSegmentationStep">
<interface>
<ic>
<par name="ProcessingThreadID" base_type="ctrl" dimension="0"/>
<par name="ChannelSelector" base_type="ctrl" dimension="0"/>
</ic>
</interface>
<body>
<c>* InspectionSegmentationStep</c>
<c>* ------------------------------------------------</c>
<c></c>
<l>global tuple App</l>
<c></c>
<l>count_seconds (TimeStart)</l>
<c>* Get variables from dictionary</c>
<l>UseRGBThreshold := App.Format.TabletInspection.Segmentation.V_AreaClassification_ColourOrMonochrome.Value</l>
<c>* Store the configured segmentation mode in the thread-specific App dictionary.</c>
<l>App.Inspection.Threads.[ProcessingThreadID].Segmentation.Parameters.UseRGBThreshold := UseRGBThreshold</l>
<c>* Use a zero shift when acquisition metadata does not provide the sequencer offset.</c>
<l>get_dict_param (App.Sensor.GrabImageMetaData, 'key_exists', 'Sequencer_MovedDistanceInBetweenGrabbedImages', ShiftMeanExists)</l>
<l>if (ShiftMeanExists)</l>
<l>    ShiftMean := App.Sensor.GrabImageMetaData.Sequencer_MovedDistanceInBetweenGrabbedImages</l>
<l>else</l>
<l>    ShiftMean := 0</l>
<l>endif</l>
<c>* Store the selected channel for helper procedures that read it from App.</c>
<l>App.Inspection.Threads.[ProcessingThreadID].Segmentation.Parameters.ChannelSelector := ChannelSelector</l>
<c></c>
<l>if (UseRGBThreshold)</l>
<l>    InspectionSegmentationThresholdRGB (ProcessingThreadID, ChannelSelector)</l>
<c>  </c>
<c>    * Apply preprocessing to the detected tablet regions.</c>
<l>    RegionTablets := App.Inspection.Threads.[ProcessingThreadID].Regions.Tablets.Segmented</l>
<c>    * When BackLight is used for segmentation, align the region with the TopLight position.</c>
<l>    switch (ChannelSelector)</l>
<l>    case 0:</l>
<c>        * BottomLight</c>
<l>        if(|ShiftMean| == 0)</l>
<l>            ShiftMean := 0</l>
<l>        endif</l>
<l>        move_region (RegionTablets, RegionTablets, ShiftMean, 0)</l>
<l>        break</l>
<l>    endswitch</l>
<c>    </c>
<c>    * TODO: Replace the fixed opening radius with a format value when its key is defined.</c>
<c>    * This opening is used on the 360 line to compensate for debris on the rolls.</c>
<l>    opening_circle (RegionTablets, RegionTablets, 15.5)</l>
<l>    select_shape (RegionTablets, RegionTablets, 'area', 'and', 1, 1e6)</l>
<l>    shape_trans (RegionTablets, RegionTablets, 'convex')</l>
<l>else</l>
<c>    * Recreate the legacy RGB-to-grayscale threshold path from the HSV channels stored in App.</c>
<l>    ImageHue        := App.Inspection.Threads.[ProcessingThreadID].Images.TopLight.HSV.Hue</l>
<l>    ImageSaturation := App.Inspection.Threads.[ProcessingThreadID].Images.TopLight.HSV.Saturation</l>
<l>    ImageValue      := App.Inspection.Threads.[ProcessingThreadID].Images.TopLight.HSV.Value</l>
<l>    SegmentationThreshold := App.Format.TabletInspection.Segmentation.V_SegmentationThreshold.Value</l>
<l>    gen_empty_obj (RegionTablets)</l>
<l>    get_image_size (ImageValue, ImageWidth, _)</l>
<l>    if (|ImageWidth| &gt; 0)</l>
<c>        * Reconstruct RGB before grayscale conversion to match the legacy threshold path.</c>
<l>        trans_to_rgb (ImageHue, ImageValue, ImageSaturation, ImageRed, ImageGreen, ImageBlue, 'hls')</l>
<l>        compose3 (ImageRed, ImageGreen, ImageBlue, ImageRGB)</l>
<l>        rgb1_to_gray (ImageRGB, ImageGray)</l>
<l>        threshold (ImageGray, RegionTablets, SegmentationThreshold, 255)</l>
<l>    endif</l>
<l>endif</l>
<c></c>
<c></c>
<l>union1 (RegionTablets, RegionTabletsUnion)</l>
<l>App.Inspection.Threads.[ProcessingThreadID].Regions.Tablets.Segmented      := RegionTablets</l>
<l>App.Inspection.Threads.[ProcessingThreadID].Regions.Tablets.SegmentedUnion := RegionTabletsUnion</l>
<c></c>
<l>count_seconds (TimeEnd)</l>
<l>TimeNeeded := (TimeEnd - TimeStart) * 1000.0</l>
<c></c>
<l>return ()</l>
</body>
<docu id="InspectionSegmentationStep">
<parameters>
<parameter id="ChannelSelector"/>
<parameter id="ProcessingThreadID"/>
</parameters>
</docu>
</procedure>
</hdevelop>

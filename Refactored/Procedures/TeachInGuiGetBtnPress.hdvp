<?xml version="1.0" encoding="UTF-8"?>
<hdevelop file_version="1.2" halcon_version="25.11.0.0">
<procedure name="TeachInGuiGetBtnPress">
<interface>
<oc>
<par name="BtnPressed" base_type="ctrl" dimension="0"/>
</oc>
</interface>
<body>
<c>* TeachInGuiGetBtnPress</c>
<c>* -------------------------------------------------</c>
<c></c>
<l>global tuple App</l>
<c></c>
<l>file_exists (App.Filesystem.Temp.Files.ButtonInterfaceFromGUI, FileExists)</l>
<l>if (FileExists)</l>
<l>    Error := 2</l>
<l>    open_file (App.Filesystem.Temp.Files.ButtonInterfaceFromGUI, 'input', FileHandle)</l>
<l>    fread_line (FileHandle, OutLine, IsEOF)</l>
<l>    close_file (FileHandle)</l>
<l>    dev_set_check ('~give_error')</l>
<l>    delete_file (App.Filesystem.Temp.Files.ButtonInterfaceFromGUI)</l>
<l>    dev_set_check ('give_error')</l>
<l>    Position := strrchr(OutLine, '\n')</l>
<l>    BtnPressed := number(str_firstn(OutLine, Position-1))</l>
<l>else</l>
<l>    BtnPressed := []</l>
<l>endif</l>
<c></c>
<l>return ()</l>
</body>
<docu id="TeachInGuiGetBtnPress">
<parameters>
<parameter id="BtnPressed"/>
</parameters>
</docu>
</procedure>
</hdevelop>

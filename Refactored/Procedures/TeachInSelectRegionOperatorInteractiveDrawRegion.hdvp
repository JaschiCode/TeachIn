<?xml version="1.0" encoding="UTF-8"?>
<hdevelop file_version="1.2" halcon_version="25.11.0.0">
<procedure name="TeachInSelectRegionOperatorInteractiveDrawRegion">
<interface>
<oo>
<par name="RegionOutput" base_type="iconic" dimension="0"/>
</oo>
<ic>
<par name="HelpTextString" base_type="ctrl" dimension="0"/>
<par name="ChannelSelector" base_type="ctrl" dimension="0"/>
<par name="FilenameImageDump" base_type="ctrl" dimension="0"/>
</ic>
</interface>
<body>
<c>* TeachInSelectRegionOperatorInteractiveDrawRegion</c>
<c>* -------------------------------------------------------------------------</c>
<c></c>
<l>global tuple App</l>
<c></c>
<c>* Initialize output variables</c>
<l>gen_empty_obj (RegionOutput)</l>
<c></c>
<c></c>
<l>WindowHandle := App.Visualization.Windows.[App.Status.Camera.ID]</l>
<l>Image        := App.TeachIn.ImageToLearnOn</l>
<l>get_image_size (Image, ImageWidth, ImageHeight)</l>
<c></c>
<l>Btn1 := App.Language.Keys.HDEV_Cancel</l>
<l>Btn2 := App.Language.Keys.HDEV_Back</l>
<l>Btn3 := App.Language.Keys.HDEV_PaintNew</l>
<l>Btn4 := App.Language.Keys.HDEV_OkNext</l>
<l>TeachInButtonsInterfaceViaFile (0, Btn1, Btn2, Btn3, Btn4, 1, 1, 0, 0, HelpTextString[0], 0, 0, 0, 0)</l>
<c></c>
<l>wait_seconds (0.3)</l>
<c></c>
<l>TeachInUserIORegionPaintSet (Image, RegionOutput, HelpTextString[0], 35, ChannelSelector, WindowHandle, ExternalIO_BtnPressed)</l>
<c></c>
<l>if(ExternalIO_BtnPressed == 1)</l>
<c>    * Cancel</c>
<l>    App.TeachIn.ContinueFlag    := 1</l>
<l>    App.TeachIn.SwitchCondition := 9999</l>
<l>    TeachInSelectAndDisplayMultiChannelImage (App.TeachIn.ImageOrig, ImageSelectedChannel, ImageDisplay, ChannelSelector, 1, 1, 0)</l>
<l>    wait_seconds (0.3)</l>
<l>    return()</l>
<l>endif</l>
<l>if(ExternalIO_BtnPressed= 2)</l>
<c>    * Go back to image zoom area</c>
<c>    * (Change SwitchCondition to previous and continue)</c>
<l>    App.TeachIn.SwitchCondition := App.TeachIn.SwitchCondition - 10</l>
<l>    App.TeachIn.ContinueFlag    := 1</l>
<l>    TeachInSelectAndDisplayMultiChannelImage (App.TeachIn.ImageOrig, ImageSelectedChannel, ImageDisplay, ChannelSelector, 1, 1, 0)</l>
<l>    wait_seconds (0.3)</l>
<l>    return()</l>
<l>endif</l>
<l>if(ExternalIO_BtnPressed= 3)</l>
<c>    * Repaint the region </c>
<c>    * (Stay in same SwitchCondition and continue)</c>
<l>    App.TeachIn.SwitchCondition := App.TeachIn.SwitchCondition</l>
<l>    App.TeachIn.ContinueFlag    := 1</l>
<l>    TeachInSelectAndDisplayMultiChannelImage (App.TeachIn.ImageOrig, ImageSelectedChannel, ImageDisplay, ChannelSelector, 1, 1, 0)</l>
<l>    wait_seconds (0.3)</l>
<l>    return()</l>
<l>endif</l>
<c></c>
<c></c>
<c>* Check that an input was made before process forward</c>
<l>area_center (RegionOutput, Area, _, _)</l>
<l>if (Area = [])</l>
<l>    App.TeachIn.SwitchCondition := App.TeachIn.SwitchCondition</l>
<l>    App.TeachIn.ContinueFlag    := 1</l>
<l>    TeachInSelectAndDisplayMultiChannelImage (App.TeachIn.ImageOrig, ImageSelectedChannel, ImageDisplay, ChannelSelector, 1, 1, 0)</l>
<l>    disp_text (WindowHandle, HelpTextString[1], 'window', 'top', 'left', 'blue', ['box_color','box_padding'], ['#ffffff77',5])</l>
<l>    wait_seconds (2)</l>
<l>    return()</l>
<l>endif</l>
<c></c>
<c>* Dump and save the image</c>
<l>dump_window (WindowHandle, 'jpeg 100', FilenameImageDump)</l>
<c></c>
<c></c>
<c>* Visualize image again</c>
<l>TeachInSelectAndDisplayMultiChannelImage (App.TeachIn.ImageOrig, ImageSelectedChannel, ImageDisplay, ChannelSelector, 1, 1, 0)</l>
<c></c>
<l>return ()</l>
</body>
<docu id="TeachInSelectRegionOperatorInteractiveDrawRegion">
<parameters>
<parameter id="ChannelSelector"/>
<parameter id="FilenameImageDump"/>
<parameter id="HelpTextString"/>
<parameter id="RegionOutput"/>
</parameters>
</docu>
</procedure>
</hdevelop>

<multivalue>optional</multivalue>
<sem_type>string</sem_type>
<type_list>
<item>string</item>
</type_list>
<values>
<item>'axes_color'</item>
<item>'style'</item>
<item>'clip'</item>
<item>'ticks'</item>
<item>'ticks_x'</item>
<item>'ticks_y'</item>
<item>'grid'</item>
<item>'grid_x'</item>
<item>'grid_y'</item>
<item>'grid_color'</item>
<item>'margin'</item>
<item>'margin_left'</item>
<item>'margin_right'</item>
<item>'margin_top'</item>
<item>'margin_bottom'</item>
<item>'start_x'</item>
<item>'end_x'</item>
<item>'start_y'</item>
<item>'end_y'</item>
<item>'origin_y'</item>
<item>'origin_x'</item>
</values>
</parameter>

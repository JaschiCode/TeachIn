<parameter id="Btn1Text"/>
<parameter id="Btn2Text"/>
<parameter id="DebugInHalcon"/>
<parameter id="InterfaceToGuiFileAndPath"/>
<parameter id="StringToWriteOnGUI"/>
<parameter id="WindowHandle"/>
</parameters>
</docu>
</procedure>
<procedure name="GetImageForElaboration_COPY_1">
<interface>
<oo>
<par name="ImageOrig" base_type="iconic" dimension="0"/>
</oo>
<ic>
<par name="WorkOnFramegrabberEnable" base_type="ctrl" dimension="0"/>
<par name="AcqHandle" base_type="ctrl" dimension="0"/>
<par name="ProcutionLoopCounter" base_type="ctrl" dimension="0"/>
<par name="PathnameForImageFiles" base_type="ctrl" dimension="0"/>
<par name="FilenameForImageFiles" base_type="ctrl" dimension="0"/>
</ic>
<oc>
<par name="NoImageFound" base_type="ctrl" dimension="0"/>
</oc>
</interface>
<body>
<l>global tuple gAquisitionGrabTimout</l>
<c>* </c>
<l>NoImageFound := 0</l>
<l>gAquisitionGrabTimout := 0</l>
<c>* </c>
<l>if (WorkOnFramegrabberEnable = 1)</l>
<l>    dev_error_var (ErrorVar, 1)</l>
<c>    * </c>
<l>    dev_set_check ('~give_error')</l>
<l>    grab_image_async (ImageOrig, AcqHandle, -1)</l>
<l>    Error := ErrorVar</l>
<l>    dev_set_check ('give_error')</l>
<c>    * </c>
<l>    if (Error # 2)</l>
<l>        NoImageFound := 1</l>
<l>        gAquisitionGrabTimout := 1</l>
<l>    endif</l>
<c>    * </c>
<l>else</l>
<l>    list_files (PathnameForImageFiles, 'files', Files)</l>
<l>    tuple_length (Files, Files_Length)</l>
<c>    * </c>
<l>    if (ProcutionLoopCounter &gt;= Files_Length)  </l>
<l>        gen_empty_obj (ImageOrig)</l>
<l>        NoImageFound := 1</l>
<l>    else</l>
<l>        Filename := Files[ProcutionLoopCounter]</l>
<l>        dev_error_var (ErrorVar, 1)</l>
<l>        dev_set_check ('~give_error')</l>
<l>        read_image (ImageOrig, Filename)</l>
<l>        Error := ErrorVar</l>
<l>        dev_set_check ('give_error')</l>
<l>        if (Error # 2)</l>
<l>            Filename := PathnameForImageFiles + (ProcutionLoopCounter+1)$'.4d'</l>
<l>            dev_error_var (ErrorVar, 1)</l>
<l>            dev_set_check ('~give_error')</l>
<l>            read_image (ImageOrig, Filename)</l>
<l>            Error := ErrorVar</l>
<l>            dev_set_check ('give_error')</l>
<l>            if (Error # 2)</l>
<l>                NoImageFound := 1</l>
<l>            endif</l>
<l>        endif</l>
<l>    endif</l>
<c>    * </c>
<l>endif</l>
<l>return ()</l>
</body>
<docu id="GetImageForElaboration_COPY_1">
<parameters>
<parameter id="AcqHandle"/>
<parameter id="FilenameForImageFiles"/>
<parameter id="ImageOrig"/>
<parameter id="NoImageFound"/>
<parameter id="PathnameForImageFiles"/>
<parameter id="ProcutionLoopCounter"/>
<parameter id="WorkOnFramegrabberEnable"/>
</parameters>
</docu>
</procedure>
<procedure name="TeachIn_ShowLineProfile">
<interface>
<io>
<par name="ImageToLearnOn" base_type="iconic" dimension="0"/>
</io>
<ic>
<par name="RectangleOutput_RightLower_Tpl_RowCol" base_type="ctrl" dimension="0"/>
<par name="RectangleOutput_LeftUpper_Tpl_RowCol" base_type="ctrl" dimension="0"/>
<par name="WindowHandle" base_type="ctrl" dimension="0"/>
<par name="SegmentationThreshold" base_type="ctrl" dimension="0"/>
<par name="Segmentation_ColourSupport_Active" base_type="ctrl" dimension="0"/>
<par name="Segmentation_ColourSupport_Threshold_Min" base_type="ctrl" dimension="0"/>
<par name="Segmentation_ColourSupport_Threshold_Max" base_type="ctrl" dimension="0"/>
<par name="In_Select_ImageOut_FirstChannels0_SecondChannel1_UVChannel2" base_type="ctrl" dimension="0"/>
</ic>
</interface>
<body>
<c>* Show a line profile with the monochrome segmentation threshold</c>
<c>* alternativley show the colour support segmentation via yuv</c>
<l>gen_empty_obj (ImageOrig_HSV)</l>
<c></c>
<l>switch (In_Select_ImageOut_FirstChannels0_SecondChannel1_UVChannel2)</l>
<l>case 0:</l>
<l>    access_channel (ImageToLearnOn, Monochrome_Toplight_Image, 3)</l>
<l>    compose5 (Monochrome_Toplight_Image, Monochrome_Toplight_Image, Monochrome_Toplight_Image, Monochrome_Toplight_Image, Monochrome_Toplight_Image, ImageToLearnOn)</l>
<l>    break</l>
<l>case 1:</l>
<l>    access_channel (ImageToLearnOn, Monochrome_Toplight_Image, 3)</l>
<l>    compose5 (Monochrome_Toplight_Image, Monochrome_Toplight_Image, Monochrome_Toplight_Image, Monochrome_Toplight_Image, Monochrome_Toplight_Image, ImageToLearnOn)</l>
<l>    break</l>
<l>case 2:</l>
<l>    access_channel (ImageToLearnOn, UV_Image, 5)</l>
<l>    compose5 (UV_Image, UV_Image, UV_Image, UV_Image, UV_Image, ImageToLearnOn)</l>
<l>    break</l>
<l>endswitch</l>
<c></c>
<c></c>
<l>Height := (RectangleOutput_RightLower_Tpl_RowCol[0]-RectangleOutput_LeftUpper_Tpl_RowCol[0])</l>
<l>Width := (RectangleOutput_RightLower_Tpl_RowCol[1]-RectangleOutput_LeftUpper_Tpl_RowCol[1])</l>
<l>gen_rectangle1 (LineProfile, RectangleOutput_LeftUpper_Tpl_RowCol[0] + Height/2, RectangleOutput_LeftUpper_Tpl_RowCol[1], RectangleOutput_LeftUpper_Tpl_RowCol[0] + Height/2, RectangleOutput_RightLower_Tpl_RowCol[1])</l>
<l>reduce_domain (ImageToLearnOn, LineProfile, ImageLineProfile)</l>
<c></c>
<l>count_channels (ImageLineProfile, ImageLineProfile_Channels)</l>
<l>if (ImageLineProfile_Channels = 5) // 5 channels is line profile    </l>
<l>    decompose3 (ImageLineProfile, Image_LineProfile_Hue, Image_LineProfile_Saturation, Image_LineProfile_Value)  </l>
<l>*     trans_to_rgb (Image_LineProfile_Hue, Image_LineProfile_Saturation, Image_LineProfile_Value, Image_LineProfile_Red, Image_LineProfile_Green, Image_LineProfile_Blue, 'hsv')</l>
<l>    decompose3 (ImageLineProfile, Image_LineProfile_Red, Image_LineProfile_Green, Image_LineProfile_Blue)  </l>
<l>else</l>
<l>    decompose3 (ImageLineProfile, Image_LineProfile_Red, Image_LineProfile_Green, Image_LineProfile_Blue)</l>
<l>    trans_from_rgb (Image_LineProfile_Red, Image_LineProfile_Green, Image_LineProfile_Blue, Image_LineProfile_Hue, Image_LineProfile_Saturation, Image_LineProfile_Value, 'hsv')</l>
<l>endif</l>
<c></c>
<l>compose3 (Image_LineProfile_Hue, Image_LineProfile_Saturation, Image_LineProfile_Value, Image_LineProfile_HSV)</l>
<c>* do support visu for colorsupport threshold</c>
<l>trans_from_rgb (Image_LineProfile_Red, Image_LineProfile_Green, Image_LineProfile_Blue, Image_LineProfile_YUV_Y, Image_LineProfile_YUV_U, Image_LineProfile_YUV_V, 'yuv')</l>
<l>compose3 (Image_LineProfile_YUV_Y, Image_LineProfile_YUV_U, Image_LineProfile_YUV_V, Image_LineProfile_YUV)</l>
<c></c>
<l>LineProfile_Hue := []</l>
<l>LineProfile_Saturation := []</l>
<l>LineProfile_Value := []</l>
<l>LineProfile_YUV_Y := []</l>
<l>LineProfile_YUV_U := []</l>
<l>LineProfile_YUV_V := []</l>
<c></c>
<l>for Cnt_Index_ImageWidth := RectangleOutput_LeftUpper_Tpl_RowCol[1] to RectangleOutput_LeftUpper_Tpl_RowCol[1] + Width-1 by 1</l>
<l>*     disp_cross (WindowHandle, RectangleOutput_LeftUpper_Tpl_RowCol[0] + Height/2, Cnt_Index_ImageWidth, 6, 0)</l>
<l>    get_grayval (Image_LineProfile_HSV, RectangleOutput_LeftUpper_Tpl_RowCol[0] + Height/2, Cnt_Index_ImageWidth, Grayval)</l>
<l>    tuple_concat (LineProfile_Hue, Grayval[0], LineProfile_Hue)</l>
<l>    tuple_concat (LineProfile_Saturation, Grayval[1], LineProfile_Saturation)</l>
<l>    tuple_concat (LineProfile_Value, Grayval[2], LineProfile_Value)</l>
<c>    * do support visu for colorsupport threshold</c>
<l>    get_grayval (Image_LineProfile_YUV, RectangleOutput_LeftUpper_Tpl_RowCol[0] + Height/2, Cnt_Index_ImageWidth, Grayval)</l>
<l>    tuple_concat (LineProfile_YUV_Y, Grayval[0], LineProfile_YUV_Y)</l>
<l>    tuple_concat (LineProfile_YUV_U, Grayval[1], LineProfile_YUV_U)</l>
<l>    tuple_concat (LineProfile_YUV_V, Grayval[2], LineProfile_YUV_V)</l>
<l>endfor</l>
<c></c>
<l>tuple_round ((Width-1)/2, X_HalfRounded)</l>
<l>tuple_gen_sequence (0, Width-1, 1, X)</l>
<c></c>
<c>* add values for segmentation line</c>
<l>Line_SegmentationValue := []</l>
<l>Line_ProfileValueLine := []</l>
<l>Line_Segmentation_ColourSupport_Threshold_Min := []</l>
<l>Line_Segmentation_ColourSupport_Threshold_Max := []</l>
<c></c>
<l>LineProfileRow :=  RectangleOutput_LeftUpper_Tpl_RowCol[0] + Height/2</l>
<c></c>
<l>for Index_CNT := 0 to Width-1 by 1</l>
<l>    tuple_mod (Index_CNT, 10, Mod) </l>
<l>    if (Mod = 1)</l>
<l>        Line_SegmentationValue := [Line_SegmentationValue, SegmentationThreshold]</l>
<l>        Line_ProfileValueLine := [Line_ProfileValueLine, LineProfileRow]</l>
<l>        Line_Segmentation_ColourSupport_Threshold_Min := [Line_Segmentation_ColourSupport_Threshold_Min, Segmentation_ColourSupport_Threshold_Min]</l>
<l>        Line_Segmentation_ColourSupport_Threshold_Max := [Line_Segmentation_ColourSupport_Threshold_Max, Segmentation_ColourSupport_Threshold_Max]</l>
<l>    else</l>
<l>        Line_SegmentationValue := [Line_SegmentationValue, -10]</l>
<l>        Line_ProfileValueLine := [Line_ProfileValueLine, -10]</l>
<l>        Line_Segmentation_ColourSupport_Threshold_Min := [Line_Segmentation_ColourSupport_Threshold_Min, -10]</l>
<l>        Line_Segmentation_ColourSupport_Threshold_Max := [Line_Segmentation_ColourSupport_Threshold_Max, -10]</l>
<l>    endif</l>
<l>endfor</l>
<c></c>
<c></c>
<l>Legend_Text := []</l>
<l>Legend_Color := []</l>
<c></c>
<l>XLabel := ''</l>
<c></c>
<l>YLabel := 'Gray val'</l>
<c></c>
<c>* Add tick marks and grid lines to the coordinate system</c>
<c>* </c>
<l>tuple_round (Width / 5, GridY)</l>
<c></c>
<l>tuple_round (255 / 5, GridX)</l>
<l>GridX := 25</l>
<c></c>
<l>GenParamName := ['ticks_x','ticks_y','grid_x','grid_y']</l>
<l>GenParamValue := [GridY,25,GridY,GridX]</l>
<c></c>
<l>GenParamName := [GenParamName,'start_y','end_y', 'margin','origin_x','axes_color']</l>
<l>GenParamValue := [GenParamValue,0,255,0,GridY*5-3, 'yellow']</l>
<c></c>
<l>Title := 'Add tick marks and grid'</l>
<c>* </c>
<l>dev_clear_window ()</l>
<l>dev_display (ImageToLearnOn)</l>
<c>* gray value line</c>
<l>Color := ['green']</l>
<l>plot_tuple (WindowHandle, X, [LineProfile_Value], XLabel, YLabel, Color, GenParamName, GenParamValue)</l>
<l>Legend_Text := [Legend_Text, 'Gray values / segmentation' + ' = ' + SegmentationThreshold]</l>
<l>Legend_Color := [Legend_Color,Color]</l>
<c></c>
<c>* Colour support lines</c>
<l>if(Segmentation_ColourSupport_Active = 1)  </l>
<c>    * colour support 1 value line (YUV-U)</c>
<l>    Color := 'yellow'</l>
<l>    plot_tuple (WindowHandle, X, [LineProfile_YUV_U], XLabel, YLabel, Color, GenParamName, GenParamValue)</l>
<l>    Legend_Text := [Legend_Text, 'ColourSupport1 min = ' + Segmentation_ColourSupport_Threshold_Min]</l>
<l>    Legend_Color := [Legend_Color,Color]</l>
<c>    * colour support 2 value line (YUV-V)</c>
<l>    Color := 'pink'</l>
<l>    plot_tuple (WindowHandle, X, [LineProfile_YUV_V], XLabel, YLabel, Color, GenParamName, GenParamValue)</l>
<l>    Legend_Text := [Legend_Text, 'ColourSupport2 max =' + Segmentation_ColourSupport_Threshold_Max ]</l>
<l>    Legend_Color := [Legend_Color,Color]</l>
<l>endif</l>
<c></c>
<c></c>
<l>GenParamName := ['ticks_x','ticks_y','grid_x','grid_y']</l>
<l>GenParamValue := [GridY,25,GridY,GridX]</l>
<c></c>
<l>GenParamName := [GenParamName,'start_y','end_y', 'margin','origin_x','axes_color','style']</l>
<l>GenParamValue := [GenParamValue,0,255,0,GridY*5-3, 'yellow','cross']</l>
<c></c>
<c>* Line_SegmentationValue</c>
<l>Color := ['green']</l>
<l>plot_tuple (WindowHandle, X, [Line_SegmentationValue], XLabel, YLabel, Color, GenParamName, GenParamValue)</l>
<l>tuple_gen_sequence (0, |Line_ProfileValueLine|-1, 1, Sequence)</l>
<c></c>
<l>if(Segmentation_ColourSupport_Active = 1)  </l>
<c>    * Line_Segmentation_ColourSupport_Threshold_Min</c>
<l>    Color := ['yellow']</l>
<l>    plot_tuple (WindowHandle, X, [Line_Segmentation_ColourSupport_Threshold_Min], XLabel, YLabel, Color, GenParamName, GenParamValue)</l>
<c>    * Line_Segmentation_ColourSupport_Threshold_Max</c>
<l>    Color := ['pink']</l>
<l>    plot_tuple (WindowHandle, X, [Line_Segmentation_ColourSupport_Threshold_Max], XLabel, YLabel, Color, GenParamName, GenParamValue)</l>
<l>endif</l>
<c></c>
<c>* Line profile line</c>
<l>Color := ['red']</l>
<l>dev_set_color (Color)</l>
<l>disp_cross (WindowHandle, Line_ProfileValueLine, Sequence + RectangleOutput_LeftUpper_Tpl_RowCol[1], 4, 0.785398)</l>
<l>Legend_Text := [Legend_Text, 'Line profile']</l>
<l>Legend_Color := [Legend_Color,Color]</l>
<c></c>
<c>* show segmented area</c>
<l>dev_get_window (WindowHandle)</l>
<l>get_part (WindowHandle, Row1, Column1, Row2, Column2)</l>
<l>gen_rectangle1 (WindwoVisibleRegions, Row1, Column1, Row2, Column2)</l>
<l>reduce_domain (ImageToLearnOn, WindwoVisibleRegions, ImageToLearnOn_Reduced)</l>
<l>decompose3 (ImageToLearnOn_Reduced, Image_Red, Image_Green, Image_Blue)</l>
<l>trans_from_rgb (Image_Red, Image_Green, Image_Blue, ImageResult_HSV_H, ImageResult_HSV_S, ImageResult_HSV_V, 'hsv')</l>
<l>threshold (ImageResult_HSV_V, Segmented_Region, SegmentationThreshold, 255)</l>
<c></c>
<l>Color := ['blue']</l>
<l>dev_set_color (Color)</l>
<l>Legend_Text := [Legend_Text, 'Segmented Region']</l>
<l>Legend_Color := [Legend_Color,Color]</l>
<l>dev_display (Segmented_Region)</l>
<c></c>
<c>* show segmented area through colour support</c>
<l>Color := ['cornflower blue']</l>
<l>dev_set_color (Color)</l>
<l>Legend_Text := [Legend_Text, 'Segmentation_ColourSupport_Active = ' + Segmentation_ColourSupport_Active]</l>
<l>Legend_Color := [Legend_Color,Color]</l>
<c>* display legend text</c>
<l>dev_disp_text (Legend_Text, 'window', 'top', 'left', Legend_Color, ['box_color','box_padding'], ['#ffffff77',5])</l>
<l>if(Segmentation_ColourSupport_Active = 1)  </l>
<l>    trans_from_rgb (Image_Red, Image_Green, Image_Blue, ImageResult_YUV_Y, ImageResult_YUV_U, ImageResult_YUV_V, 'yuv')</l>
<l>    compose3 (ImageResult_YUV_Y, ImageResult_YUV_U, ImageResult_YUV_V, ImageOrig_YUV)</l>
<c>    * ToDo Abbott Add To JSon</c>
<l>    Segmentation_ColourSupport_OpeningAfterSegmentation_MaskSize := 15</l>
<l>    Segmentation_ColourSupport_AreaToSelect_MinSize := 1500</l>
<l>    Segmentation_ColourSupport_Threshold_RedMin := 90</l>
<l>    Segmentation_ColourSupport_Threshold_RedMax := 155</l>
<l>    SegmentedRegion := Segmented_Region</l>
<l>    if (ImageLineProfile_Channels = 5)</l>
<l>        decompose3 (ImageToLearnOn, ImageToLearnOn_Hue, ImageToLearnOn_Saturation, ImageToLearnOn_Value)</l>
<l>        compose3 (ImageToLearnOn_Hue, ImageToLearnOn_Saturation, ImageToLearnOn_Value, ImageOrig_HSV)</l>
<l>    endif</l>
<c>    </c>
<l>    gSegmentation_ColourSupport (ImageOrig_YUV, ImageToLearnOn, WindwoVisibleRegions, SegmentedRegion, ImageOrig_HSV, SupportThreshold_V_SegmentedRegion, SupportThreshold_U_SegmentedRegion, ColourSupportSegmentation, SegmentedRegion, Segmentation_ColourSupport_Active, Segmentation_ColourSupport_Threshold_Max, Segmentation_ColourSupport_Threshold_Min, Segmentation_ColourSupport_OpeningAfterSegmentation_MaskSize, Segmentation_ColourSupport_AreaToSelect_MinSize, Segmentation_ColourSupport_Threshold_RedMin, Segmentation_ColourSupport_Threshold_RedMax)</l>
<c>    </c>
<c>    *     gSegmentation_ColourSupport (ImageOrig_YUV, ImageToLearnOn, WindwoVisibleRegions, SegmentedRegion, SupportThreshold_V_SegmentedRegion, SupportThreshold_U_SegmentedRegion, ColourSupportSegmentation, SegmentedRegion, Segmentation_ColourSupport_Active, Segmentation_ColourSupport_Threshold_Max, Segmentation_ColourSupport_Threshold_Min, 10)</c>
<l>    dev_display (ColourSupportSegmentation)</l>
<l>endif</l>
<c></c>
<c></c>
<l>return ()</l>
</body>
<docu id="TeachIn_ShowLineProfile">
<parameters>
<parameter id="ImageToLearnOn"/>
<parameter id="In_Select_ImageOut_FirstChannels0_SecondChannel1_UVChannel2"/>
<parameter id="RectangleOutput_LeftUpper_Tpl_RowCol"/>
<parameter id="RectangleOutput_RightLower_Tpl_RowCol"/>
<parameter id="SegmentationThreshold"/>
<parameter id="Segmentation_ColourSupport_Active"/>
<parameter id="Segmentation_ColourSupport_Threshold_Max"/>
<parameter id="Segmentation_ColourSupport_Threshold_Min"/>
<parameter id="WindowHandle"/>
</parameters>
</docu>
</procedure>
<procedure name="UserIO_CheckIfSigmaBoundariesAreInRange">
<interface>
<ic>
<par name="ValueToCheckForRange" base_type="ctrl" dimension="0"/>
<par name="RangeOfXValues" base_type="ctrl" dimension="0"/>
<par name="ToleranceProposal_ScaleIsMaxValue" base_type="ctrl" dimension="0"/>
</ic>
<oc>
<par name="ValueInRange" base_type="ctrl" dimension="0"/>
</oc>
</interface>
<body>
<l>ValueInRange := ValueToCheckForRange</l>
<l>if (ValueInRange &gt; RangeOfXValues)</l>
<l>    if (ToleranceProposal_ScaleIsMaxValue = 1)</l>
<l>        ValueInRange := RangeOfXValues</l>
<l>    else</l>
<l>        ValueInRange := ValueInRange-RangeOfXValues</l>
<l>    endif</l>
<l>endif</l>
<l>if (ValueInRange &lt; 0)</l>
<l>    ValueInRange := ValueInRange +RangeOfXValues</l>
<l>endif</l>
<l>return ()</l>
</body>
<docu id="UserIO_CheckIfSigmaBoundariesAreInRange">
<parameters>
<parameter id="RangeOfXValues"/>
<parameter id="ToleranceProposal_ScaleIsMaxValue"/>
<parameter id="ValueInRange"/>
<parameter id="ValueToCheckForRange"/>
</parameters>
</docu>
</procedure>
<procedure name="UserIO_SelectRectangleRegion_Visu">
<interface>
<io>
<par name="Image" base_type="iconic" dimension="0"/>
</io>
<oo>
<par name="Rectangle_HandlingMainRegion" base_type="iconic" dimension="0"/>
<par name="Rectangle_HandlingLeftUpper" base_type="iconic" dimension="0"/>
<par name="Rectangle_HandlingLeftLower" base_type="iconic" dimension="0"/>
<par name="Rectangle_HandlingRightUpper" base_type="iconic" dimension="0"/>
<par name="Rectangle_HandlingRightLower" base_type="iconic" dimension="0"/>
</oo>
<ic>
<par name="WindowHandle" base_type="ctrl" dimension="0"/>
<par name="MessageToDisplay" base_type="ctrl" dimension="0"/>
<par name="DebugInHalcon" base_type="ctrl" dimension="0"/>
<par name="InverseCrossImage" base_type="ctrl" dimension="0"/>
<par name="PositionRectangle_LeftUpper_Tpl_RowCol" base_type="ctrl" dimension="0"/>
<par name="PositionRectangle_RightLower_Tpl_RowCol" base_type="ctrl" dimension="0"/>
<par name="ScaleFactor_Horizontal" base_type="ctrl" dimension="0"/>
<par name="ScaleFactor_Vertical" base_type="ctrl" dimension="0"/>
<par name="HandlingRectangleSize" base_type="ctrl" dimension="0"/>
<par name="VizualisationImage_FirstChannel0_SecondChannel1" base_type="ctrl" dimension="0"/>
</ic>
</interface>
<body>
<l>gen_rectangle1 (Rectangle_HandlingMainRegion, PositionRectangle_LeftUpper_Tpl_RowCol[0], PositionRectangle_LeftUpper_Tpl_RowCol[1], PositionRectangle_RightLower_Tpl_RowCol[0], PositionRectangle_RightLower_Tpl_RowCol[1])</l>
<c></c>
<c>* do some calculations for a middle cross like visualisation</c>
<l>DrawRect_Middlepoint_Row := (PositionRectangle_RightLower_Tpl_RowCol[0]-PositionRectangle_LeftUpper_Tpl_RowCol[0]) / 2 </l>
<l>DrawRect_MiddlePoint_Column := (PositionRectangle_RightLower_Tpl_RowCol[1] - PositionRectangle_LeftUpper_Tpl_RowCol[1]) /2 </l>
<l>DrawRect_Dimension_Row := (PositionRectangle_RightLower_Tpl_RowCol[0]-PositionRectangle_LeftUpper_Tpl_RowCol[0]) </l>
<l>DrawRect_Dimension_Column := (PositionRectangle_RightLower_Tpl_RowCol[1]-PositionRectangle_LeftUpper_Tpl_RowCol[1]) </l>
<l>DimensionOfMiddleCross := 3</l>
<l>gen_rectangle1 (RectangleMiddle_Vertical, DrawRect_Middlepoint_Row+ PositionRectangle_LeftUpper_Tpl_RowCol[0] - DimensionOfMiddleCross, DrawRect_MiddlePoint_Column + PositionRectangle_LeftUpper_Tpl_RowCol[1] - DrawRect_Dimension_Column/5, DrawRect_Middlepoint_Row + PositionRectangle_LeftUpper_Tpl_RowCol[0] + DimensionOfMiddleCross, DrawRect_MiddlePoint_Column + PositionRectangle_LeftUpper_Tpl_RowCol[1] + DrawRect_Dimension_Column/5)</l>
<l>gen_rectangle1 (RectangleMiddle_Horizontal, DrawRect_Middlepoint_Row+ PositionRectangle_LeftUpper_Tpl_RowCol[0]  - DrawRect_Dimension_Row/5, DrawRect_MiddlePoint_Column + PositionRectangle_LeftUpper_Tpl_RowCol[1] - DimensionOfMiddleCross, DrawRect_Middlepoint_Row + PositionRectangle_LeftUpper_Tpl_RowCol[0] +DrawRect_Dimension_Row/5, DrawRect_MiddlePoint_Column + PositionRectangle_LeftUpper_Tpl_RowCol[1] + DimensionOfMiddleCross)</l>
<c></c>
<c>* switch left upper rectangle to left lower. It is more comfortable for touch screen users to see while interacting, otherwise hand will cover image </c>
<l>gen_rectangle1 (Rectangle_HandlingLeftUpper, PositionRectangle_LeftUpper_Tpl_RowCol[0]-HandlingRectangleSize * ScaleFactor_Vertical/2, PositionRectangle_LeftUpper_Tpl_RowCol[1]-HandlingRectangleSize * ScaleFactor_Horizontal/2, PositionRectangle_LeftUpper_Tpl_RowCol[0]+HandlingRectangleSize * ScaleFactor_Vertical/2, PositionRectangle_LeftUpper_Tpl_RowCol[1]+HandlingRectangleSize * ScaleFactor_Horizontal/2)</l>
<l>gen_rectangle1 (Rectangle_HandlingLeftLower, PositionRectangle_RightLower_Tpl_RowCol[0]-HandlingRectangleSize * ScaleFactor_Vertical/2, PositionRectangle_LeftUpper_Tpl_RowCol[1]-HandlingRectangleSize * ScaleFactor_Horizontal/2, PositionRectangle_RightLower_Tpl_RowCol[0]+HandlingRectangleSize * ScaleFactor_Vertical/2, PositionRectangle_LeftUpper_Tpl_RowCol[1]+HandlingRectangleSize * ScaleFactor_Horizontal/2)</l>
<l>gen_rectangle1 (Rectangle_HandlingRightUpper, PositionRectangle_LeftUpper_Tpl_RowCol[0]-HandlingRectangleSize * ScaleFactor_Vertical/2, PositionRectangle_RightLower_Tpl_RowCol[1]-HandlingRectangleSize * ScaleFactor_Horizontal/2, PositionRectangle_LeftUpper_Tpl_RowCol[0]+HandlingRectangleSize * ScaleFactor_Vertical/2, PositionRectangle_RightLower_Tpl_RowCol[1]+HandlingRectangleSize * ScaleFactor_Horizontal/2)</l>
<l>gen_rectangle1 (Rectangle_HandlingRightLower, PositionRectangle_RightLower_Tpl_RowCol[0]-HandlingRectangleSize * ScaleFactor_Vertical/2, PositionRectangle_RightLower_Tpl_RowCol[1]-HandlingRectangleSize * ScaleFactor_Horizontal/2, PositionRectangle_RightLower_Tpl_RowCol[0]+HandlingRectangleSize * ScaleFactor_Vertical/2, PositionRectangle_RightLower_Tpl_RowCol[1]+HandlingRectangleSize * ScaleFactor_Horizontal/2)</l>
<c>* edit: if ellip should be used instead of rect</c>
<c></c>
<l>* gen_ellipse(Rectangle_HandlingLeftUpper, PositionRectangle_LeftUpper_Tpl_RowCol[0], PositionRectangle_LeftUpper_Tpl_RowCol[1], 0, 25*ScaleFactor_Horizontal, 25*ScaleFactor_Vertical)</l>
<l>* gen_ellipse(Rectangle_HandlingLeftLower, PositionRectangle_RightLower_Tpl_RowCol[0], PositionRectangle_LeftUpper_Tpl_RowCol[1], 0, 25*ScaleFactor_Horizontal, 25*ScaleFactor_Vertical)</l>
<l>* gen_ellipse(Rectangle_HandlingRightUpper, PositionRectangle_LeftUpper_Tpl_RowCol[0], PositionRectangle_RightLower_Tpl_RowCol[1], 0, 25*ScaleFactor_Horizontal, 25*ScaleFactor_Vertical)</l>
<l>* gen_ellipse(Rectangle_HandlingRightLower, PositionRectangle_RightLower_Tpl_RowCol[0], PositionRectangle_RightLower_Tpl_RowCol[1], 0, 25*ScaleFactor_Horizontal, 25*ScaleFactor_Vertical)</l>
<c></c>
<l>concat_obj (Rectangle_HandlingLeftUpper, Rectangle_HandlingLeftLower, Rectangles_Handling)</l>
<l>concat_obj (Rectangles_Handling, Rectangle_HandlingRightUpper, Rectangles_Handling)</l>
<l>concat_obj (Rectangles_Handling, Rectangle_HandlingRightLower, Rectangles_Handling)</l>
<c>* if the internal rectangle pieces inside handling boxes hould not be visualized comment in</c>
<l>* difference (RectangleOutput, Rectangles_Handling, Rectangle_HandlingMainRegion)</l>
<c>            </c>
<l>set_window_param (WindowHandle, 'flush', 'false') </l>
<l>gSelectAndDisplay_MultichannelImage (Image, Image_SelectedChannels, VizualisationImage_FirstChannel0_SecondChannel1, 1, 1)</l>
<l>dev_set_color ('light gray')</l>
<l>dev_display (Rectangle_HandlingMainRegion)</l>
<l>dev_set_color ('spring green')</l>
<l>dev_display (Rectangles_Handling)</l>
<c></c>
<c></c>
<l>if ( InverseCrossImage = 1)</l>
<l>    reduce_domain (Image, RectangleMiddle_Horizontal, ImageReduced)</l>
<l>    invert_image (ImageReduced, ImageInvert)</l>
<l>    dev_display (ImageInvert)</l>
<l>    reduce_domain (Image, RectangleMiddle_Vertical, ImageReduced)</l>
<l>    invert_image (ImageReduced, ImageInvert)</l>
<l>    dev_display (ImageInvert)</l>
<l>else</l>
<l>    dev_set_color ('dim gray')</l>
<l>    dev_set_draw ('fill')</l>
<l>    dev_display (RectangleMiddle_Vertical)</l>
<l>    dev_display (RectangleMiddle_Horizontal)</l>
<l>    dev_set_draw ('margin')</l>
<l>endif</l>
<c></c>
<c></c>
<l>if ((MessageToDisplay # '' or MessageToDisplay # []) and DebugInHalcon = 1)</l>
<l>    dev_disp_text (MessageToDisplay, 'window', 'top', 'left', 'blue', ['box_color','box_padding'], ['#ffffff77',5])</l>
<l>endif</l>
<l>flush_buffer (WindowHandle)</l>
<l>set_window_param (WindowHandle, 'flush', 'true')</l>
<l>return ()</l>
</body>
<docu id="UserIO_SelectRectangleRegion_Visu">
<parameters>
<parameter id="DebugInHalcon"/>
<parameter id="HandlingRectangleSize"/>
<parameter id="Image"/>
<parameter id="InverseCrossImage"/>
<parameter id="MessageToDisplay"/>
<parameter id="PositionRectangle_LeftUpper_Tpl_RowCol"/>
<parameter id="PositionRectangle_RightLower_Tpl_RowCol"/>
<parameter id="Rectangle_HandlingLeftLower"/>
<parameter id="Rectangle_HandlingLeftUpper"/>
<parameter id="Rectangle_HandlingMainRegion"/>
<parameter id="Rectangle_HandlingRightLower"/>
<parameter id="Rectangle_HandlingRightUpper"/>
<parameter id="ScaleFactor_Horizontal"/>
<parameter id="ScaleFactor_Vertical"/>
<parameter id="VizualisationImage_FirstChannel0_SecondChannel1"/>
<parameter id="WindowHandle"/>
</parameters>
</docu>
</procedure>
<procedure name="UserIO_SelectRectangleRegion_CalculatePosition">
<interface>
<io>
<par name="Rectangle_HandlingMainRegion" base_type="iconic" dimension="0"/>
<par name="Rectangle_HandlingLeftUpper" base_type="iconic" dimension="0"/>
<par name="Rectangle_HandlingLeftLower" base_type="iconic" dimension="0"/>
<par name="Rectangle_HandlingRightUpper" base_type="iconic" dimension="0"/>
<par name="Rectangle_HandlingRightLower" base_type="iconic" dimension="0"/>
</io>
<ic>
<par name="PositionRectangle_RightLower_Tpl_RowCol" base_type="ctrl" dimension="0"/>
<par name="PositionRectangle_LeftUpper_Tpl_RowCol" base_type="ctrl" dimension="0"/>
<par name="SizeHorizontalMin" base_type="ctrl" dimension="0"/>
<par name="SizeVerticalMin" base_type="ctrl" dimension="0"/>
<par name="Mouse_Row" base_type="ctrl" dimension="0"/>
<par name="Mouse_Column" base_type="ctrl" dimension="0"/>
<par name="CurRectIn" base_type="ctrl" dimension="0"/>
</ic>
<oc>
<par name="PositionRectangle_LeftUpper_Tpl_RowColOut" base_type="ctrl" dimension="0"/>
<par name="PositionRectangle_RightLower_Tpl_RowColOut" base_type="ctrl" dimension="0"/>
<par name="IsInsideAHandlingRegion" base_type="ctrl" dimension="0"/>
<par name="CurRectOut" base_type="ctrl" dimension="0"/>
</oc>
</interface>
<body>
<c></c>
<l>PositionRectangle_LeftUpper_Tpl_RowColOut := PositionRectangle_LeftUpper_Tpl_RowCol</l>
<l>PositionRectangle_RightLower_Tpl_RowColOut := PositionRectangle_RightLower_Tpl_RowCol</l>
<l>IsInsideAHandlingRegion := 0</l>
<c>* comment in for debugging</c>
<l>Debugmode := 0</l>
<l>if(Debugmode = 1)</l>
<l>    dev_get_window (WindowHandle)  </l>
<l>    dev_set_color ('red')</l>
<l>    disp_cross (WindowHandle, Mouse_Row, Mouse_Column, 60, 0)</l>
<l>endif</l>
<c>* set flag that handling rectangle was found - needed if handling rectanlges overlap in small region szenarios</c>
<l>HandlingRectangleUsed := 0</l>
<c>********************* left upper rectangle</c>
<l>test_region_point (Rectangle_HandlingLeftUpper, Mouse_Row, Mouse_Column, IsInsideLeftUpper)</l>
<l>if (IsInsideLeftUpper = 1 and HandlingRectangleUsed = 0)</l>
<l>    PositionRectangle_LeftUpper_Tpl_RowColOut[0] := Mouse_Row</l>
<l>    PositionRectangle_LeftUpper_Tpl_RowColOut[1] := Mouse_Column</l>
<l>    HandlingRectangleUsed := 1</l>
<l>    CurRectOut := 'LU'</l>
<l>endif</l>
<c>********************* left lower rectangle</c>
<l>test_region_point (Rectangle_HandlingLeftLower, Mouse_Row, Mouse_Column, IsInsideLeftLower)</l>
<l>if (IsInsideLeftLower = 1 and HandlingRectangleUsed = 0)</l>
<l>    PositionRectangle_RightLower_Tpl_RowColOut[0] := Mouse_Row</l>
<l>    PositionRectangle_LeftUpper_Tpl_RowColOut[1] := Mouse_Column      </l>
<l>    HandlingRectangleUsed := 1</l>
<l>    CurRectOut := 'LL'</l>
<l>endif</l>
<c>********************* right upper rectangle</c>
<l>test_region_point (Rectangle_HandlingRightUpper, Mouse_Row, Mouse_Column, IsInsideRightUpper)</l>
<l>if (IsInsideRightUpper = 1 and HandlingRectangleUsed = 0)</l>
<l>    PositionRectangle_LeftUpper_Tpl_RowColOut[0] := Mouse_Row</l>
<l>    PositionRectangle_RightLower_Tpl_RowColOut[1] := Mouse_Column</l>
<l>    HandlingRectangleUsed := 1</l>
<l>    CurRectOut := 'RU'</l>
<l>endif</l>
<c>********************* right lower rectangle</c>
<l>test_region_point (Rectangle_HandlingRightLower, Mouse_Row, Mouse_Column, IsInsideRightLower)</l>
<l>if (IsInsideRightLower = 1 and HandlingRectangleUsed = 0)</l>
<l>    PositionRectangle_RightLower_Tpl_RowColOut[0] := Mouse_Row</l>
<l>    PositionRectangle_RightLower_Tpl_RowColOut[1] := Mouse_Column</l>
<l>    HandlingRectangleUsed := 1</l>
<l>    CurRectOut := 'RL'</l>
<l>endif</l>
<c>**********************</c>
<c>* move rectangles fast</c>
<c>**********************</c>
<c>* Upper Left Rectangle</c>
<l>if (CurRectIn == 'LU')</l>
<c>    * if rectangle pos is to slow, rect pos will be set to mouse pos</c>
<l>    if(IsInsideLeftUpper == 0)</l>
<l>        PositionRectangle_LeftUpper_Tpl_RowColOut[0] := Mouse_Row</l>
<l>        PositionRectangle_LeftUpper_Tpl_RowColOut[1] := Mouse_Column</l>
<l>        HandlingRectangleUsed := 1</l>
<l>        CurRectOut := 'LU'</l>
<l>    endif</l>
<c>    * POS SWITCH </c>
<l>    if (IsInsideLeftUpper == 1 and IsInsideRightUpper == 1)</l>
<l>       HandlingRectangleUsed := 1</l>
<l>       CurRectOut := 'RU'</l>
<l>    elseif (IsInsideLeftUpper == 1 and IsInsideLeftLower == 1)  </l>
<l>        HandlingRectangleUsed := 1</l>
<l>        CurRectOut := 'LL' </l>
<l>    endif</l>
<c>* Lower Left Rect</c>
<l>elseif (CurRectIn == 'LL')</l>
<l>    if(IsInsideLeftLower == 0)</l>
<l>        PositionRectangle_RightLower_Tpl_RowColOut[0] := Mouse_Row</l>
<l>        PositionRectangle_LeftUpper_Tpl_RowColOut[1] := Mouse_Column      </l>
<l>        HandlingRectangleUsed := 1</l>
<l>        CurRectOut := 'LL'        </l>
<l>    endif</l>
<c>    * POS SWITCH </c>
<l>    if(IsInsideLeftLower == 1 and IsInsideLeftUpper == 1)</l>
<l>        HandlingRectangleUsed := 1</l>
<l>        CurRectOut := 'LU'</l>
<l>    elseif(IsInsideLeftLower == 1 and IsInsideRightLower == 1)</l>
<l>        HandlingRectangleUsed := 1</l>
<l>        CurRectOut := 'RL' </l>
<l>    endif</l>
<c>* Upper Right Rect</c>
<l>elseif (CurRectIn == 'RU')</l>
<l>    if(IsInsideRightUpper == 0)</l>
<l>        PositionRectangle_LeftUpper_Tpl_RowColOut[0] := Mouse_Row</l>
<l>        PositionRectangle_RightLower_Tpl_RowColOut[1] := Mouse_Column</l>
<l>        HandlingRectangleUsed := 1</l>
<l>        CurRectOut := 'RU'</l>
<l>    endif   </l>
<c>    * POS SWITCH </c>
<l>    if(IsInsideRightUpper == 1 and IsInsideRightLower == 1)</l>
<l>        HandlingRectangleUsed := 1</l>
<l>        CurRectOut := 'RL' </l>
<l>    elseif(IsInsideRightUpper == 1 and IsInsideLeftUpper == 1)</l>
<l>        HandlingRectangleUsed := 1</l>
<l>        CurRectOut := 'LU'</l>
<l>    endif</l>
<c>    * right upper rect switch pos</c>
<c>* Lower Right Rect</c>
<l>elseif (CurRectIn == 'RL')</l>
<l>    if(IsInsideRightLower == 0)</l>
<l>        PositionRectangle_RightLower_Tpl_RowColOut[0] := Mouse_Row</l>
<l>        PositionRectangle_RightLower_Tpl_RowColOut[1] := Mouse_Column</l>
<l>        HandlingRectangleUsed := 1</l>
<l>        CurRectOut := 'RL'</l>
<l>    endif</l>
<c>    * POS SWITCH </c>
<l>    if(IsInsideRightLower == 1 and IsInsideRightUpper == 1)</l>
<l>        HandlingRectangleUsed := 1</l>
<l>        CurRectOut := 'RU'</l>
<l>    elseif(IsInsideRightLower == 1 and IsInsideLeftLower == 1)</l>
<l>        HandlingRectangleUsed := 1</l>
<l>        CurRectOut := 'LL' </l>
<l>    endif</l>
<l>endif</l>
<c>**************************************************************************</c>
<c>* main rectangle</c>
<l>concat_obj (Rectangle_HandlingRightLower, Rectangle_HandlingRightUpper, HandlingRects)</l>
<l>concat_obj (HandlingRects, Rectangle_HandlingLeftLower, HandlingRects)</l>
<l>concat_obj (HandlingRects, Rectangle_HandlingLeftUpper, HandlingRects)</l>
<l>difference (Rectangle_HandlingMainRegion, HandlingRects, Rectangle_HandlingMainRegion)</l>
<c></c>
<l>test_region_point (Rectangle_HandlingMainRegion, Mouse_Row, Mouse_Column, IsInsideRectangleMainRegion)</l>
<l>if (IsInsideRectangleMainRegion = 1 and HandlingRectangleUsed = 0)</l>
<l>    smallest_rectangle1 (Rectangle_HandlingMainRegion, Mouse_Row1, Mouse_Column1, Mouse_Row2, Mouse_Column2)</l>
<l>    Temp_Width := (Mouse_Column2-Mouse_Column1)/2</l>
<l>    Temp_Height := (Mouse_Row2- Mouse_Row1)/2</l>
<l>    PositionRectangle_LeftUpper_Tpl_RowColOut[0] := Mouse_Row - Temp_Height</l>
<l>    PositionRectangle_LeftUpper_Tpl_RowColOut[1] := Mouse_Column - Temp_Width</l>
<l>    PositionRectangle_RightLower_Tpl_RowColOut[0] := Mouse_Row + Temp_Height</l>
<l>    PositionRectangle_RightLower_Tpl_RowColOut[1] := Mouse_Column + Temp_Width</l>
<l>    HandlingRectangleUsed := 1</l>
<l>    CurRectOut := 'MAIN'</l>
<l>endif</l>
<c>* if mouse is outside of main rectangle</c>
<l>if (CurRectIn == 'MAIN')</l>
<l>    if(IsInsideRectangleMainRegion == 0)</l>
<l>        smallest_rectangle1 (Rectangle_HandlingMainRegion, Mouse_Row1, Mouse_Column1, Mouse_Row2, Mouse_Column2)</l>
<l>        Temp_Width := (Mouse_Column2-Mouse_Column1)/2</l>
<l>        Temp_Height := (Mouse_Row2- Mouse_Row1)/2</l>
<l>        PositionRectangle_LeftUpper_Tpl_RowColOut[0] := Mouse_Row - Temp_Height</l>
<l>        PositionRectangle_LeftUpper_Tpl_RowColOut[1] := Mouse_Column - Temp_Width</l>
<l>        PositionRectangle_RightLower_Tpl_RowColOut[0] := Mouse_Row + Temp_Height</l>
<l>        PositionRectangle_RightLower_Tpl_RowColOut[1] := Mouse_Column + Temp_Width</l>
<l>        HandlingRectangleUsed := 1</l>
<l>        CurRectOut := 'MAIN'</l>
<l>    endif</l>
<l>endif</l>
<c>**************************************************************************</c>
<c>* ensure minimal size of rectangle</c>
<l>if((PositionRectangle_LeftUpper_Tpl_RowColOut[0] + SizeVerticalMin) &gt; (PositionRectangle_RightLower_Tpl_RowColOut[0]))</l>
<l>    PositionRectangle_LeftUpper_Tpl_RowColOut[0] := PositionRectangle_RightLower_Tpl_RowColOut[0] -SizeVerticalMin</l>
<l>endif</l>
<l>if((PositionRectangle_LeftUpper_Tpl_RowColOut[1] + SizeHorizontalMin) &gt; (PositionRectangle_RightLower_Tpl_RowColOut[1]))</l>
<l>    PositionRectangle_LeftUpper_Tpl_RowColOut[1] := PositionRectangle_RightLower_Tpl_RowColOut[1] -SizeHorizontalMin</l>
<l>endif</l>
<c>**************************************************************************</c>
<l>IsInsideAHandlingRegion := HandlingRectangleUsed</l>
<c></c>
<c></c>
<c>****************** backup code - code is buggy on very small rectangles*******************************</c>
<l>* PositionRectangle_LeftUpper_Tpl_RowColOut := PositionRectangle_LeftUpper_Tpl_RowCol</l>
<l>* PositionRectangle_RightLower_Tpl_RowColOut := PositionRectangle_RightLower_Tpl_RowCol</l>
<l>* IsInsideAHandlingRegion := 0</l>
<c>* comment in for debugging</c>
<l>* Debugmode := 0</l>
<l>* if(Debugmode = 1)</l>
<l>*     dev_get_window (WindowHandle)  </l>
<l>*     dev_set_color ('red')</l>
<l>*     disp_cross (WindowHandle, Mouse_Row, Mouse_Column, 60, 0)</l>
<l>* endif</l>
<c>* set flag that handling rectangle was found - needed if handling rectanlges overlap in small region szenarios</c>
<l>* HandlingRectangleUsed := 0</l>
<c>********************* left upper rectangle</c>
<l>* test_region_point (Rectangle_HandlingLeftUpper, Mouse_Row, Mouse_Column, IsInsideLeftUpper)</l>
<l>* if (IsInsideLeftUpper = 1 and HandlingRectangleUsed = 0)</l>
<c>    * ensure minimal size of rectangle</c>
<l>*     if (PositionRectangle_RightLower_Tpl_RowColOut[0] - PositionRectangle_LeftUpper_Tpl_RowColOut[0] &lt; SizeHorizontalMin)</l>
<l>*         PositionRectangle_LeftUpper_Tpl_RowColOut[0] := PositionRectangle_RightLower_Tpl_RowColOut[0] - SizeHorizontalMin</l>
<l>*     else</l>
<l>*         PositionRectangle_LeftUpper_Tpl_RowColOut[0] := Mouse_Row</l>
<l>*     endif</l>
<l>*     if (PositionRectangle_RightLower_Tpl_RowColOut[1] - PositionRectangle_LeftUpper_Tpl_RowColOut[1] &lt; SizeVerticalMin)</l>
<l>*         PositionRectangle_LeftUpper_Tpl_RowColOut[1] := PositionRectangle_RightLower_Tpl_RowColOut[1] - SizeVerticalMin</l>
<l>*     else</l>
<l>*         PositionRectangle_LeftUpper_Tpl_RowColOut[1] := Mouse_Column</l>
<l>*     endif    </l>
<l>*     HandlingRectangleUsed := 1</l>
<l>* endif</l>
<c>********************* left lower rectangle</c>
<l>* test_region_point (Rectangle_HandlingLeftLower, Mouse_Row, Mouse_Column, IsInsideLeftLower)</l>
<l>* if (IsInsideLeftLower = 1 and HandlingRectangleUsed = 0)</l>
<c>    * ensure minimal size of rectangle</c>
<l>*     if (PositionRectangle_RightLower_Tpl_RowColOut[0] - PositionRectangle_LeftUpper_Tpl_RowColOut[0] &lt; SizeHorizontalMin)</l>
<l>*         PositionRectangle_RightLower_Tpl_RowColOut[0] := PositionRectangle_RightLower_Tpl_RowColOut[0] + SizeHorizontalMin</l>
<l>*     else</l>
<l>*         PositionRectangle_RightLower_Tpl_RowColOut[0] := Mouse_Row</l>
<l>*     endif</l>
<c></c>
<l>*     if (PositionRectangle_RightLower_Tpl_RowColOut[1] - PositionRectangle_LeftUpper_Tpl_RowColOut[1] &lt; SizeVerticalMin)</l>
<l>*         PositionRectangle_LeftUpper_Tpl_RowColOut[1] := PositionRectangle_RightLower_Tpl_RowColOut[1] - SizeVerticalMin</l>
<l>*     else</l>
<l>*         PositionRectangle_LeftUpper_Tpl_RowColOut[1] := Mouse_Column</l>
<l>*     endif       </l>
<l>*     HandlingRectangleUsed := 1</l>
<l>* endif</l>
<c>********************* right upper rectangle</c>
<l>* test_region_point (Rectangle_HandlingRightUpper, Mouse_Row, Mouse_Column, IsInsideRightUpper)</l>
<l>* if (IsInsideRightUpper = 1 and HandlingRectangleUsed = 0)</l>
<c>    * ensure minimal size of rectangle</c>
<l>*     if (PositionRectangle_RightLower_Tpl_RowColOut[0] - PositionRectangle_LeftUpper_Tpl_RowColOut[0] &lt; SizeHorizontalMin)</l>
<l>*         PositionRectangle_LeftUpper_Tpl_RowColOut[0] := PositionRectangle_LeftUpper_Tpl_RowColOut[0] - SizeHorizontalMin</l>
<l>*     else</l>
<l>*         PositionRectangle_LeftUpper_Tpl_RowColOut[0] := Mouse_Row</l>
<l>*     endif</l>
<c></c>
<l>*     if (PositionRectangle_RightLower_Tpl_RowColOut[1] - PositionRectangle_LeftUpper_Tpl_RowColOut[1] &lt; SizeVerticalMin)</l>
<l>*         PositionRectangle_RightLower_Tpl_RowColOut[1] := PositionRectangle_LeftUpper_Tpl_RowColOut[1] + SizeVerticalMin</l>
<l>*     else</l>
<l>*         PositionRectangle_RightLower_Tpl_RowColOut[1] := Mouse_Column</l>
<l>*     endif</l>
<l>*         HandlingRectangleUsed := 1</l>
<l>* endif</l>
<c>********************* right lower rectangle</c>
<l>* test_region_point (Rectangle_HandlingRightLower, Mouse_Row, Mouse_Column, IsInsideRightLower)</l>
<l>* if (IsInsideRightLower = 1 and HandlingRectangleUsed = 0)</l>
<c>    * ensure minimal size of rectangle</c>
<l>*     if (PositionRectangle_RightLower_Tpl_RowColOut[0] - PositionRectangle_LeftUpper_Tpl_RowColOut[0] &lt; SizeHorizontalMin)</l>
<l>*         PositionRectangle_RightLower_Tpl_RowColOut[0] := PositionRectangle_LeftUpper_Tpl_RowColOut[0] + SizeHorizontalMin</l>
<l>*     else</l>
<l>*         PositionRectangle_RightLower_Tpl_RowColOut[0] := Mouse_Row</l>
<l>*     endif</l>
<l>*     if (PositionRectangle_RightLower_Tpl_RowColOut[1] - PositionRectangle_LeftUpper_Tpl_RowColOut[1] &lt; SizeVerticalMin)</l>
<l>*         PositionRectangle_RightLower_Tpl_RowColOut[1] := PositionRectangle_LeftUpper_Tpl_RowColOut[1] + SizeVerticalMin</l>
<l>*     else</l>
<l>*         PositionRectangle_RightLower_Tpl_RowColOut[1] := Mouse_Column</l>
<l>*     endif</l>
<l>*     HandlingRectangleUsed := 1</l>
<l>* endif</l>
<c>********************* main rectangle</c>
<l>* concat_obj (Rectangle_HandlingRightLower, Rectangle_HandlingRightUpper, HandlingRects)</l>
<l>* concat_obj (HandlingRects, Rectangle_HandlingLeftLower, HandlingRects)</l>
<l>* concat_obj (HandlingRects, Rectangle_HandlingLeftUpper, HandlingRects)</l>
<l>* difference (Rectangle_HandlingMainRegion, HandlingRects, Rectangle_HandlingMainRegion)</l>
<c></c>
<l>* test_region_point (Rectangle_HandlingMainRegion, Mouse_Row, Mouse_Column, IsInsideRectangleMainRegion)</l>
<l>* if (IsInsideRectangleMainRegion = 1 and HandlingRectangleUsed = 0)</l>
<l>*     smallest_rectangle1 (Rectangle_HandlingMainRegion, Mouse_Row1, Mouse_Column1, Mouse_Row2, Mouse_Column2)</l>
<l>*     Temp_Width := (Mouse_Column2-Mouse_Column1)/2</l>
<l>*     Temp_Height := (Mouse_Row2- Mouse_Row1)/2</l>
<l>*     PositionRectangle_LeftUpper_Tpl_RowColOut[0] := Mouse_Row - Temp_Height</l>
<l>*     PositionRectangle_LeftUpper_Tpl_RowColOut[1] := Mouse_Column - Temp_Width</l>
<l>*     PositionRectangle_RightLower_Tpl_RowColOut[0] := Mouse_Row + Temp_Height</l>
<l>*     PositionRectangle_RightLower_Tpl_RowColOut[1] := Mouse_Column + Temp_Width</l>
<l>*     HandlingRectangleUsed := 1</l>
<l>* endif</l>
<c></c>
<c>***</c>
<l>* IsInsideAHandlingRegion := HandlingRectangleUsed</l>
<c></c>
<l>return ()</l>
</body>
<docu id="UserIO_SelectRectangleRegion_CalculatePosition">
<parameters>
<parameter id="CurRectIn"/>
<parameter id="CurRectOut"/>
<parameter id="IsInsideAHandlingRegion"/>
<parameter id="Mouse_Column"/>
<parameter id="Mouse_Row"/>
<parameter id="PositionRectangle_LeftUpper_Tpl_RowCol"/>
<parameter id="PositionRectangle_LeftUpper_Tpl_RowColOut"/>
<parameter id="PositionRectangle_RightLower_Tpl_RowCol"/>
<parameter id="PositionRectangle_RightLower_Tpl_RowColOut"/>
<parameter id="Rectangle_HandlingLeftLower"/>
<parameter id="Rectangle_HandlingLeftUpper"/>
<parameter id="Rectangle_HandlingMainRegion"/>
<parameter id="Rectangle_HandlingRightLower"/>
<parameter id="Rectangle_HandlingRightUpper"/>
<parameter id="SizeHorizontalMin"/>
<parameter id="SizeVerticalMin"/>
</parameters>
</docu>
</procedure>
<procedure name="PLC_CommunicationCycle">
<interface>
<ic>
<par name="WorkOnPLCEnable" base_type="ctrl" dimension="0"/>
<par name="LigghtOnOrOff" base_type="ctrl" dimension="0"/>
<par name="PLC_CommunicationSocket" base_type="ctrl" dimension="0"/>
<par name="CamReady" base_type="ctrl" dimension="0"/>
<par name="VibratorReady" base_type="ctrl" dimension="0"/>
<par name="TeachIn" base_type="ctrl" dimension="0"/>
<par name="WatchdogSignal" base_type="ctrl" dimension="0"/>
<par name="ErrorEjectCountercheck" base_type="ctrl" dimension="0"/>
<par name="ErrorCriticalWrongColour" base_type="ctrl" dimension="0"/>
<par name="Shiftregister_SpecifyEjectPort" base_type="ctrl" dimension="0"/>
<par name="Shiftregister_SpecifyGoodPort" base_type="ctrl" dimension="0"/>
<par name="PLC_CommunicationCycle_NiceToHave0_MustHave1" base_type="ctrl" dimension="0"/>
<par name="PulsingmodeForVibrator" base_type="ctrl" dimension="0"/>
<par name="OptionalTupleToSendInPLCCommunicationQueue" base_type="ctrl" dimension="0"/>
<par name="ProductionLoopCounter" base_type="ctrl" dimension="0"/>
</ic>
<oc>
<par name="WatchdogSignal_Out" base_type="ctrl" dimension="0"/>
</oc>
</interface>
<body>
<l>global tuple gPLCDebugMode</l>
<l>global tuple gPLCWatchdogBypass</l>
<l>global tuple gPLCLastCommunicationSystemTime</l>
<l>global tuple gQueuePLCResults</l>
<c>* for 360 inspection only</c>
<l>* global tuple g360InspectionActive</l>
<l>global tuple gCounterPLCCamtrigger</l>
<c></c>
<l>OptionalDataToLogg :=[]</l>
<l>PLCCommunication_FastestPossibleCycle := 12 //in ms</l>
<l>SkipPLCCommunicationCycle := 0</l>
<c></c>
<c>* important note: Siemens S-7 1200 seems to have issues with fast communication (around 5ms?)</c>
<c>*     this is while a mode for skipping or waiting some of the cycles is implemented</c>
<c>*     - skipping when nice to have (0)</c>
<c>*     - waiting when must have (1)</c>
<l>if (gPLCLastCommunicationSystemTime = []) //after init nothing is set</l>
<l>    gPLCLastCommunicationSystemTime := 0</l>
<l>endif</l>
<c></c>
<c>*  action from here on</c>
<l>if (WatchdogSignal = 1)</l>
<l>    WatchdogSignal_Out := 0</l>
<l>else</l>
<l>    WatchdogSignal_Out := 1</l>
<l>endif</l>
<l>if (ErrorEjectCountercheck=0) //invert signal for PLC</l>
<l>    ErrorEjectCountercheck:= 1</l>
<l>else</l>
<l>    ErrorEjectCountercheck:= 0</l>
<l>endif</l>
<l>if (ErrorCriticalWrongColour=0) //invert signal for PLC</l>
<l>    ErrorCriticalWrongColour:= 1</l>
<l>else</l>
<l>    ErrorCriticalWrongColour:= 0</l>
<l>endif</l>
<c></c>
<l>CommunicationFirstPart := [WatchdogSignal,LigghtOnOrOff,TeachIn,gPLCWatchdogBypass,gPLCDebugMode,PulsingmodeForVibrator,0,0,CamReady,0,VibratorReady,ErrorEjectCountercheck,0,ErrorCriticalWrongColour,0,0]</l>
<l>tuple_concat (CommunicationFirstPart, Shiftregister_SpecifyEjectPort, Communication)</l>
<l>if (Shiftregister_SpecifyGoodPort = []) // in case no result is given for a good results at eject position set to 0</l>
<l>    Shiftregister_SpecifyGoodPort := [0,0,0,0,0,0,0,0]</l>
<l>endif</l>
<l>tuple_concat (Communication, Shiftregister_SpecifyGoodPort, Communication)</l>
<l>PLC_MS_Tuple_ConvertBits2Bytes (Communication, SendTuple, Bytes, ErrorConversion)</l>
<l>if(ErrorConversion = 1)</l>
<l>    tuple_concat (OptionalDataToLogg, Communication + ' ConvertBites2Bytes failed, in result [] was send.', OptionalDataToLogg)</l>
<l>endif</l>
<c></c>
<c></c>
<c>* add byte for counter to plc communication. State 0 is not initialized so countable is from 1-254</c>
<l>* if (g360InspectionActive = 1)</l>
<l>    if (gCounterPLCCamtrigger &gt;255)</l>
<l>        gCounterPLCCamtrigger := 1</l>
<l>    endif</l>
<l>    tuple_concat (SendTuple, gCounterPLCCamtrigger, SendTuple)</l>
<l>* endif</l>
<c></c>
<c></c>
<c></c>
<c>* implement decision wether to skip plc communication or do it- based on time measure to last plc communication</c>
<l>count_seconds (Seconds_Current)</l>
<l>TimeDeltaToLastCommunication := (Seconds_Current - gPLCLastCommunicationSystemTime) * 1000.0</l>
<c>* implement wait or skip here, with optional logging</c>
<l>if (PLC_CommunicationCycle_NiceToHave0_MustHave1 = 1) // in this case wait before sending the message- to avoid too fast plc communication</l>
<l>    if(TimeDeltaToLastCommunication &lt; PLCCommunication_FastestPossibleCycle) // unit of threshold is ms</l>
<l>        WaitTimeMS := (PLCCommunication_FastestPossibleCycle- TimeDeltaToLastCommunication)</l>
<l>        tuple_concat (OptionalDataToLogg, WaitTimeMS + ' wait time before sending data to PLC(ms)', OptionalDataToLogg)</l>
<l>        wait_seconds(WaitTimeMS/1000.0)</l>
<l>    endif</l>
<l>else // in case communication is optional e.g. heartbeat (heartbeat had be done in last communication anyhow)</l>
<l>    if(TimeDeltaToLastCommunication &lt; PLCCommunication_FastestPossibleCycle)</l>
<l>        SkipPLCCommunicationCycle := 1</l>
<l>        tuple_concat (OptionalDataToLogg, TimeDeltaToLastCommunication + ' TimeDeltaToLastCommunication (in ms) too short, cycle skipped.', OptionalDataToLogg)</l>
<l>    endif</l>
<l>endif</l>
<c>* do the communication to plc here</c>
<l>if (SkipPLCCommunicationCycle = 0)</l>
<l>    if (gQueuePLCResults # []) // if there is a queue specified send data to there</l>
<l>        create_message (MessageToAquisitionThread)</l>
<l>        set_message_tuple (MessageToAquisitionThread, 'PLC_SendTuple', SendTuple)</l>
<l>        set_message_tuple (MessageToAquisitionThread, 'MetaData', OptionalTupleToSendInPLCCommunicationQueue)</l>
<l>        enqueue_message (gQueuePLCResults, MessageToAquisitionThread, [], [])</l>
<l>        clear_message (MessageToAquisitionThread)</l>
<l>    else</l>
<l>        if (PLC_CommunicationSocket[0] # -1 and |SendTuple| # 0)</l>
<l>            send_data (PLC_CommunicationSocket[0], 'C' + |SendTuple|, SendTuple, [])</l>
<l>        endif   </l>
<l>    endif</l>
<l>    count_seconds (gPLCLastCommunicationSystemTime)</l>
<l>endif</l>
<c></c>
<l>PLC_Logging (Communication, OptionalDataToLogg)</l>
<l>return ()</l>
</body>
<docu id="PLC_CommunicationCycle">
<parameters>
<parameter id="CamReady"/>
<parameter id="ErrorCriticalWrongColour"/>
<parameter id="ErrorEjectCountercheck"/>
<parameter id="LigghtOnOrOff"/>
<parameter id="OptionalTupleToSendInPLCCommunicationQueue"/>
<parameter id="PLC_CommunicationCycle_NiceToHave0_MustHave1"/>
<parameter id="PLC_CommunicationSocket"/>
<parameter id="ProductionLoopCounter"/>
<parameter id="PulsingmodeForVibrator"/>
<parameter id="Shiftregister_SpecifyEjectPort"/>
<parameter id="Shiftregister_SpecifyGoodPort"/>
<parameter id="TeachIn"/>
<parameter id="VibratorReady"/>
<parameter id="WatchdogSignal"/>
<parameter id="WatchdogSignal_Out"/>
<parameter id="WorkOnPLCEnable"/>
</parameters>
</docu>
</procedure>
<procedure name="PLC_MS_Tuple_ConvertBits2Bytes">
<interface>
<ic>
<par name="Input" base_type="ctrl" dimension="0"/>
</ic>
<oc>
<par name="Output" base_type="ctrl" dimension="0"/>
<par name="Bytes" base_type="ctrl" dimension="0"/>
<par name="Error" base_type="ctrl" dimension="0"/>
</oc>
</interface>
<body>
<c>* Kontrollvariable für Fehler</c>
<l>Error := 0</l>
<l>Output := []</l>
<c>* Übernimmt den Übergabewert und kontrolliert ihn auf seine Gültigkeit, Fehler wenn ungültig</c>
<l>ByteTuple := Input</l>
<l>tuple_length (ByteTuple, Length)</l>
<l>if (Length%8 != 0)</l>
<l>    Error := 1</l>
<l>    return ()</l>
<l>endif</l>
<l>tuple_max (ByteTuple, Max)</l>
<l>if (Max &gt; 1)</l>
<l>    Error := 1</l>
<l>    return ()</l>
<l>endif</l>
<c>* Zerlegen des Übergabewertes und selektieren der einzelnen Bytes</c>
<l>Bytes := Length/8</l>
<l>for IndexN := 1 to Bytes by 1</l>
<l>    tuple_select (ByteTuple, [(8*(IndexN-1)),(8*(IndexN-1))+1,(8*(IndexN-1))+2,(8*(IndexN-1))+3,(8*(IndexN-1))+4,(8*(IndexN-1))+5,(8*(IndexN-1))+6,(8*(IndexN-1))+7], SelectedBites)</l>
<c>    * Berechnen des Dezimalwertes</c>
<l>    SelectedByte := (SelectedBites[0]*1) + (SelectedBites[1]*2) + (SelectedBites[2]*4) + (SelectedBites[3]*8) + (SelectedBites[4]*16) + (SelectedBites[5]*32) + (SelectedBites[6]*64) + (SelectedBites[7]*128)</l>
<l>    tuple_concat (Output, SelectedByte, Output)</l>
<l>endfor</l>
<l>Error := 0</l>
<l>return ()</l>
</body>
<docu id="PLC_MS_Tuple_ConvertBits2Bytes">
<parameters>
<parameter id="Bytes">
<description lang="de_DE">Anzahl der Bytes, welche umgewandelt wurden.</description>
</parameter>
<parameter id="Error">
<description lang="de_DE">Wenn Umwandlung fehlerhaft: 1
Sonst: 0</description>
</parameter>
<parameter id="Input">
<description lang="de_DE">Tuple mit Werten 0 und/oder 1, dessen Länge durch 8 restlos teilbar ist.</description>
<mixed_type>false</mixed_type>
</parameter>
<parameter id="Output">
<description lang="de_DE">Output in Byte-Tuple als Dezimalwerte</description>
</parameter>
</parameters>
</docu>
</procedure>
<procedure name="PLC_Logging">
<interface>
<ic>
<par name="PLC_DataToLogg" base_type="ctrl" dimension="0"/>
<par name="OptionalDataToAdd" base_type="ctrl" dimension="0"/>
</ic>
</interface>
<body>
<l>global tuple gProgrammStart_Timestamp</l>
<l>global tuple vector(2) gPLCLogging</l>
<c>* </c>
<l>LoggingMaxLength := 200</l>
<l>if (gPLCLogging.at(0).at(0) # 'inactive')</l>
<l>    count_seconds (Seconds_Now)</l>
<l>    TimeDiffToProgrammstart := Seconds_Now - gProgrammStart_Timestamp</l>
<l>    VectorLength := gPLCLogging.length()</l>
<l>    if (VectorLength &gt; 200) // avoid overfilling of data- will slow down process</l>
<l>        gPLCLogging.remove(0)</l>
<l>        VectorLength := VectorLength-1</l>
<l>    endif</l>
<l>    TimeStamp := round(TimeDiffToProgrammstart*1000.0)/1000.0 // in sec with last 3 digits</l>
<l>*     TimeStamp := TimeDiffToProgrammstart $'6.3f'</l>
<c>    * calculate time delta to last log entry</c>
<l>    LastDataset := gPLCLogging.at(VectorLength-1).at(1)</l>
<l>    if (LastDataset # [])</l>
<l>        LastTimeStamp := LastDataset[0]</l>
<l>        DeltaTimeStamp := round((TimeStamp - LastTimeStamp) * 1000.0) // in sec with last 3 digits</l>
<l>    else</l>
<l>        DeltaTimeStamp := -1</l>
<l>    endif</l>
<c>    </c>
<l>    tuple_concat (TimeStamp ,DeltaTimeStamp , DataToLogg)</l>
<l>    tuple_concat (DataToLogg, OptionalDataToAdd, DataToLogg)</l>
<l>    CurrentDataCollection_VectorToStore := {PLC_DataToLogg, DataToLogg}</l>
<c>    * </c>
<l>    if (VectorLength = 1)</l>
<l>        if (gPLCLogging.at(0).at(0) = [])</l>
<l>            gPLCLogging.at(0) := CurrentDataCollection_VectorToStore</l>
<l>        else</l>
<l>            gPLCLogging.at(1) := CurrentDataCollection_VectorToStore</l>
<l>        endif</l>
<l>    else</l>
<l>        gPLCLogging.at(VectorLength) := CurrentDataCollection_VectorToStore</l>
<l>    endif</l>
<l>endif</l>
<c>* </c>
<l>return ()</l>
</body>
<docu id="PLC_Logging">
<parameters>
<parameter id="OptionalDataToAdd"/>
<parameter id="PLC_DataToLogg"/>
</parameters>
</docu>
</procedure>
<procedure name="Overpaint_TeachInImageForColourClassification">
<interface>
<io>
<par name="ImageToLearnOn" base_type="iconic" dimension="0"/>
</io>
<oo>
<par name="ImageToLearnOnOut" base_type="iconic" dimension="0"/>
</oo>
</interface>
<body>
<l>ImageToLearnOnOut := ImageToLearnOn</l>
<l>* Image_SelectedChannelsOut := Image_SelectedChannels</l>
<l>get_image_size (ImageToLearnOnOut, ImageToLearnOn_Width, ImageToLearnOn_Height)</l>
<l>SizeOfOverpaintedRectangle := 100</l>
<l>gen_rectangle1 (Rectangle_ToOverpaint, ImageToLearnOn_Height - SizeOfOverpaintedRectangle, ImageToLearnOn_Width - SizeOfOverpaintedRectangle, ImageToLearnOn_Height, ImageToLearnOn_Width)</l>
<l>GrayValue_ToSet := 20</l>
<l>count_channels (ImageToLearnOnOut, ImageToLearnOn_Channels)</l>
<l>if (ImageToLearnOn_Channels = 3)</l>
<l>    decompose3 (ImageToLearnOnOut, ImageToLearnOn_Red, ImageToLearnOn_Green, ImageToLearnOn_Blue)</l>
<l>elseif (ImageToLearnOn_Channels = 5)    </l>
<l>    decompose5 (ImageToLearnOnOut, ImageToLearnOn_Red, ImageToLearnOn_Green, ImageToLearnOn_Blue, ImageToLearnOn_SequencerMonochrome, ImageToLearnOn_SequencerMonochrome_Mean)</l>
<l>elseif (ImageToLearnOn_Channels = 6)</l>
<l>    decompose6 (ImageToLearnOnOut, Image1, Image2, Image3, ImageToLearnOn_Red, ImageToLearnOn_Green, ImageToLearnOn_Blue)</l>
<l>endif</l>
<l>overpaint_region (ImageToLearnOn_Red, Rectangle_ToOverpaint, GrayValue_ToSet, 'fill')</l>
<l>overpaint_region (ImageToLearnOn_Green, Rectangle_ToOverpaint, GrayValue_ToSet, 'fill')</l>
<l>overpaint_region (ImageToLearnOn_Blue, Rectangle_ToOverpaint, GrayValue_ToSet, 'fill')</l>
<l>gen_rectangle1 (Rectangle_ToOverpaint, ImageToLearnOn_Height - SizeOfOverpaintedRectangle, 0, ImageToLearnOn_Height, SizeOfOverpaintedRectangle)</l>
<l>GrayValue_ToSet := 235</l>
<l>overpaint_region (ImageToLearnOn_Red, Rectangle_ToOverpaint, GrayValue_ToSet, 'fill')</l>
<l>overpaint_region (ImageToLearnOn_Green, Rectangle_ToOverpaint, GrayValue_ToSet, 'fill')</l>
<l>overpaint_region (ImageToLearnOn_Blue, Rectangle_ToOverpaint, GrayValue_ToSet, 'fill')</l>
<l>if (ImageToLearnOn_Channels = 3)</l>
<l>    compose3 (ImageToLearnOn_Red, ImageToLearnOn_Green, ImageToLearnOn_Blue, ImageToLearnOnOut)</l>
<l>elseif (ImageToLearnOn_Channels = 5) </l>
<l>    compose5 (ImageToLearnOn_Red, ImageToLearnOn_Green, ImageToLearnOn_Blue, ImageToLearnOn_SequencerMonochrome, ImageToLearnOn_SequencerMonochrome_Mean, ImageToLearnOnOut)</l>
<l>elseif (ImageToLearnOn_Channels = 6) </l>
<l>    compose6 (Image1, Image2, Image3, ImageToLearnOn_Red, ImageToLearnOn_Green, ImageToLearnOn_Blue, ImageToLearnOnOut)</l>
<l>endif</l>
<l>return ()</l>
</body>
<docu id="Overpaint_TeachInImageForColourClassification">
<parameters>
<parameter id="ImageToLearnOn"/>
<parameter id="ImageToLearnOnOut"/>
</parameters>
</docu>
</procedure>
<procedure name="TeachIn_SetupVisuForHistogramm">
<interface>
<ic>
<par name="Calculation_Input_tpl" base_type="ctrl" dimension="0"/>
</ic>
<oc>
<par name="Calculation_Input_tpl_Out" base_type="ctrl" dimension="0"/>
<par name="DataValues" base_type="ctrl" dimension="1"/>
<par name="UseFloatVisu" base_type="ctrl" dimension="0"/>
</oc>
</interface>
<body>
<l>UseFloatVisu := 0</l>
<l>Ticks_X := 1000</l>
<c></c>
<l>Calculation_Input_tpl_Out := Calculation_Input_tpl</l>
<l>tuple_mean (Calculation_Input_tpl_Out, Calculation_Length_tpl_Mean)</l>
<c></c>
<l>if(Calculation_Length_tpl_Mean &lt; 40) // for small objects assume this is a metric calibrated measurement. Therefore set visualisation with in float  values</l>
<l>    Calculation_Input_tpl_Out := Calculation_Input_tpl_Out * 1000</l>
<l>    UseFloatVisu := 1   </l>
<l>endif</l>
<c></c>
<c>*</c>
<l>if (Calculation_Input_tpl_Out # [])</l>
<l>    tuple_max (Calculation_Input_tpl_Out, Max)</l>
<l>    RangeOfXValues := Max*1.5</l>
<l>    Ticks_X := RangeOfXValues/4</l>
<l>endif</l>
<l>tuple_round (Ticks_X, Ticks_X)  </l>
<c></c>
<l>DataValues := {['Colour','orange'],['RangeOfXValuesOnUserGrafic','adaptive'],['TicksXBar_OnUserGrafic', Ticks_X]}</l>
<c></c>
<l>return ()</l>
</body>
<docu id="TeachIn_SetupVisuForHistogramm">
<parameters>
<parameter id="Calculation_Input_tpl"/>
<parameter id="Calculation_Input_tpl_Out"/>
<parameter id="DataValues"/>
<parameter id="UseFloatVisu"/>
</parameters>
</docu>
</procedure>
<procedure name="ConvertTupleToDecimalStringForExport">
<interface>
<ic>
<par name="capsuleVerticalExtension" base_type="ctrl" dimension="0"/>
</ic>
<oc>
<par name="capsuleVerticalExtensionKomma" base_type="ctrl" dimension="0"/>
</oc>
</interface>
<body>
<l>tuple_string(capsuleVerticalExtension, '10.3f', capsuleVerticalExtensionString)</l>
<l>tuple_regexp_replace (capsuleVerticalExtensionString, '(.*)\\.(.*)$', '$1,$2', capsuleVerticalExtensionKomma)</l>
<l>return ()</l>
</body>
<docu id="ConvertTupleToDecimalStringForExport">
<parameters>
<parameter id="capsuleVerticalExtension"/>
<parameter id="capsuleVerticalExtensionKomma"/>
</parameters>
</docu>
</procedure>

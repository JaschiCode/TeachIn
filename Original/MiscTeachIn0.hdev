X := [-rad(180): 0.01: rad(180)]
Y1 := sin(X)
Y2 := (X * X) * 0.2 - 1
XLabel := 'x'
YLabel := 'y'
Color := ['medium slate blue', 'yellow']
GenParamNames := []
GenParamValues := []
plot_tuple (WindowHandle, X, [Y1, Y2], XLabel, YLabel, Color, GenParamNames, GenParamValues)
</example>

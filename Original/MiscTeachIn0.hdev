<item>'green'</item>
<item>'yellow'</item>
<item>'white'</item>
<item>'black'</item>
<item>'cyan'</item>
<item>'magenta'</item>
<item>'blue'</item>
<item>'orange'</item>
</values>
</parameter>
<parameter id="Function">
<description lang="en_US">Function to be plotted</description>
<mixed_type>false</mixed_type>

</ic>
<oc>
<par name="capsuleVerticalExtensionKomma" base_type="ctrl" dimension="0"/>
</oc>
</interface>
<body>
<l>tuple_string(capsuleVerticalExtension, '10.3f', capsuleVerticalExtensionString)</l>
<l>tuple_regexp_replace (capsuleVerticalExtensionString, '(.*)\\.(.*)$', '$1,$2', capsuleVerticalExtensionKomma)</l>
<l>return ()</l>
</body>
<docu id="PrepareTupleForStringExport">
<parameters>
